  "beats": [
    {
      "start": 0.08,
      "end": 4.244,
      "text": "Our closest stellar neighbor is completely invisible to the naked eye.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Orbital plot of Proxima Centauri.jpg",
        "credit": "P. Kervella (CNRS/U. of Chile/Observatoire de Paris/LESIA), ESO/Digitized Sky Survey 2, D. De Martin/M. Zamani",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Orbital_plot_of_Proxima_Centauri.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.244,
      "end": 11.364,
      "text": "Located in the southern constellation Centaurus, Proxima Centauri is a small, low-mass red dwarf star.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "A Comparison of Star Sizes.jpg",
        "credit": "NASA, ESA and A. Feild (STScI)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:A_Comparison_of_Star_Sizes.jpg"
      },
      "shots": [
        {
          "start": 4.233,
          "end": 11.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.364,
      "end": 15.534,
      "text": "It has a mass that is only about 10 percent of the Sun's mass.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Neon Abundance in Nearby Stars- Chandra Discovery Solves Solar Paradox (2005-neon - neon).tiff",
        "credit": "Spectrum: NASA/CXC/J.Drake & P.Testa; Illustration: NASA/CXC/M.Weiss",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Neon_Abundance_in_Nearby_Stars-_Chandra_Discovery_Solves_Solar_Paradox_(2005-neon_-_neon).tiff"
      },
      "shots": [
        {
          "start": 11.367,
          "end": 15.533,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.534,
      "end": 20.879,
      "text": "The star's interior is fully convective, meaning it will shine for trillions of years.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "New shot of Proxima Centauri, our nearest neighbour (10581847073).jpg",
        "credit": "Hubble ESA",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:New_shot_of_Proxima_Centauri,_our_nearest_neighbour_(10581847073).jpg"
      },
      "shots": [
        {
          "start": 15.533,
          "end": 20.867,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.879,
      "end": 27.624,
      "text": "Yet this quiet fuel burning hides a violent flare star erupting with sudden increases in brightness.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Flaring red dwarf star (artist's impression) (opo1102a).tiff",
        "credit": "Artwork Credit: NASA, ESA, and G. Bacon (STScI). Science Credit: NASA, ESA, A. Kowalski (University of Washington, USA), R. Osten and K. Sahu (STScI) and S. Hawley (University of Washington, USA)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Flaring_red_dwarf_star_(artist%27s_impression)_(opo1102a).tiff"
      },
      "shots": [
        {
          "start": 20.867,
          "end": 23.4,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 23.4,
          "end": 27.633,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 27.624,
      "end": 36.244,
      "text": "It hosts Proxima Centauri b, an Earth-sized exoplanet orbiting within the habitable zone every 11.2 Earth days.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist\u2019s impression of Proxima Centauri b shown hypothetically as an arid rocky super-earth.jpg",
        "credit": "ESO/M. Kornmesser",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%E2%80%99s_impression_of_Proxima_Centauri_b_shown_hypothetically_as_an_arid_rocky_super-earth.jpg"
      },
      "shots": [
        {
          "start": 27.633,
          "end": 36.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 36.244,
      "end": 41.914,
      "text": "Intense stellar flares threaten to strip away this nearby planet's atmosphere entirely.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Sundown on the VLT (vlt atudorica014-cc).jpg",
        "credit": "A. Tudorica/ESO",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Sundown_on_the_VLT_(vlt_atudorica014-cc).jpg"
      },
      "shots": [
        {
          "start": 36.233,
          "end": 38.433,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 38.433,
          "end": 41.9,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 41.914,
      "end": 48.432,
      "text": "Ferocious stellar activity is why our closest stellar neighbor is completely invisible to the naked eye.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Orbital plot of Proxima Centauri.jpg",
