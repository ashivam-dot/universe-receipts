{
  "id": "ep060",
  "duration": 52.554,
  "beats": [
    {
      "start": 0.08,
      "end": 4.249,
      "text": "A single blinking star once destroyed the entire known universe.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Andromeda Galaxy (with h-alpha).jpg",
        "credit": "Adam Evans",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Andromeda_Galaxy_(with_h-alpha).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 1.867,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 1.867,
          "end": 4.233,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.249,
      "end": 11.219,
      "text": "In 1920, astronomer Harlow Shapley argued the Milky Way was the only galaxy in existence.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 4.233,
          "end": 11.233,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.219,
      "end": 18.014,
      "text": "Heber Curtis countered that fuzzy spiral clouds were actually distant, independent island universes.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Heber Doust Curtis NBS 1918.jpg",
        "credit": "National Institute of Standards and Technology",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Heber_Doust_Curtis_NBS_1918.jpg"
      },
      "shots": [
        {
          "start": 11.233,
          "end": 18.0,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.014,
      "end": 26.209,
      "text": "In October 1923, Edwin Hubble used the 100-inch Hooker Telescope to photograph the Andromeda Nebula.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Telescope dome on Mt. Wilson, Pasadena, California (63805).jpg",
        "credit": "Tichnor Brothers, Publisher",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Telescope_dome_on_Mt._Wilson,_Pasadena,_California_(63805).jpg"
      },
      "shots": [
        {
          "start": 18.0,
          "end": 22.4,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 22.4,
          "end": 26.2,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 26.209,
      "end": 32.704,
      "text": "He spotted a changing star, V1, that proved Andromeda was roughly one million light-years away.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Snapshots of the star that changed the Universe (opo1115d).jpg",
        "credit": "Illustration Credit: NASA, ESA and Z. Levay (STScI). Credit: NASA, ESA and the Hubble Heritage Team (STScI/AURA)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Snapshots_of_the_star_that_changed_the_Universe_(opo1115d).jpg"
      },
      "shots": [
        {
          "start": 26.2,
          "end": 30.3,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 30.3,
          "end": 32.7,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 32.704,
      "end": 39.199,
      "text": "That distance was far outside the Milky Way, instantly making the cosmos billions of times larger.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist\u2019s impression of the Milky Way.jpg",
        "credit": "NASA/JPL-Caltech/ESO/R. Hurt",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%E2%80%99s_impression_of_the_Milky_Way.jpg"
      },
      "shots": [
        {
          "start": 32.7,
          "end": 37.2,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 37.2,
          "end": 39.2,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 39.199,
      "end": 45.249,
      "text": "Shapley read Hubble's letter and told a colleague, \"Here is the letter that destroyed my universe.\"",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 39.2,
          "end": 45.233,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 45.249,
      "end": 52.204,
      "text": "Everything we knew about our home changed because a single blinking star once destroyed the entire known universe.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Andromeda Galaxy (with h-alpha).jpg",
        "credit": "Adam Evans",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Andromeda_Galaxy_(with_h-alpha).jpg"
      },
      "shots": [
        {
          "start": 45.233,
          "end": 52.567,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
