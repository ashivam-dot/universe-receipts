        }
      ]
    },
    {
      "start": 4.537,
      "end": 12.407,
      "text": "On August 15, 1977, Ohio State University's Big Ear telescope picked up the powerful anomaly.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 4.533,
          "end": 12.4,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.407,
      "end": 18.027,
      "text": "Astronomer Jerry R. Ehman discovered the signal while reviewing computer printout data.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Wow signal.jpg",
        "credit": "Credit: Big Ear Radio Observatory and North American AstroPhysical Observatory (NAAPO).",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Wow_signal.jpg"
      },
      "shots": [
        {
          "start": 12.4,
          "end": 18.033,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.027,
      "end": 23.877,
      "text": "Ehman circled the intensity reading 6EQUJ5 and wrote Wow beside it.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Wow signal (large).jpg",
        "credit": "Credit: Big Ear Radio Observatory and North American AstroPhysical Observatory (NAAPO).",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Wow_signal_(large).jpg"
      },
      "shots": [
        {
          "start": 18.033,
          "end": 20.1,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 20.1,
          "end": 23.867,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.877,
      "end": 30.747,
      "text": "The signal frequency hit around fourteen twenty megahertz, matching the neutral hydrogen emission line.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Annotated HI line in terms of radial velocity.png",
        "credit": "IndyRishi",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Annotated_HI_line_in_terms_of_radial_velocity.png"
      },
      "shots": [
        {
          "start": 23.867,
          "end": 30.733,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 30.747,
      "end": 37.967,
      "text": "A recent twenty twenty-four study proposed a magnetar flare energized a cold hydrogen cloud to create it.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Cosmic Blasts Much More Common, Astronomers Discover (2006-xrf).tiff",
        "credit": "Illustration: NASA/CXC/M.Weiss",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Cosmic_Blasts_Much_More_Common,_Astronomers_Discover_(2006-xrf).tiff"
      },
      "shots": [
        {
          "start": 30.733,
          "end": 33.4,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 33.4,
          "end": 37.967,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 37.967,
      "end": 44.862,
      "text": "Despite decades of searches, the mysterious anomaly from the constellation Sagittarius has never recurred.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Sagittarius (sgr).tiff",
        "credit": "IAU and Sky & Telescope",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Sagittarius_(sgr).tiff"
      },
      "shots": [
        {
          "start": 37.967,
          "end": 41.533,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 41.533,
          "end": 44.867,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 44.862,
      "end": 51.005,
      "text": "That exactly matches a radio blast that lasted the exact duration the telescope could watch.",
