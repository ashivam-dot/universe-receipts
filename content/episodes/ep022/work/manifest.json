    {
      "start": 0.08,
      "end": 4.536,
      "text": "A radio blast lasted the exact duration the telescope could watch.",
      "asset": {
        "source": "Art Institute of Chicago (CC0)",
        "title": "Big River, from the Rancherie, Mendocino, California",
        "credit": "Carleton E. Watkins\nAmerican, 1829-1916",
