{
  "id": "ep398",
  "duration": 34.456,
  "beats": [
    {
      "start": 0.08,
      "end": 3.04,
      "text": "Half your body's atoms came from distant galaxies.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hubble ultra deep field high rez edit1.jpg",
        "credit": "NASA and the European Space Agency. Edited by Noodle snacks",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Hubble_ultra_deep_field_high_rez_edit1.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.033,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.04,
      "end": 7.1,
      "text": "Up to 50 percent of the Milky Way originated outside our galaxy.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Out of this whirl- The Whirlpool Galaxy (M51) and companion galaxy (heic0506a).tiff",
        "credit": "NASA, ESA, S. Beckwith (STScI), and The Hubble Heritage Team (STScI/AURA)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Out_of_this_whirl-_The_Whirlpool_Galaxy_(M51)_and_companion_galaxy_(heic0506a).tiff"
      },
      "shots": [
        {
          "start": 3.033,
          "end": 7.1,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.1,
      "end": 10.38,
      "text": "Edwin Hubble proved other galaxies existed back in the 1920s.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hubble at 100-inch (19950424 cd3 07-CC).tiff",
        "credit": "International Gemini Observatory/NOIRLab/NSF/AURA",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Hubble_at_100-inch_(19950424_cd3_07-CC).tiff"
      },
      "shots": [
        {
          "start": 7.1,
          "end": 8.733,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 8.733,
          "end": 10.367,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.38,
      "end": 14.18,
      "text": "Our Solar System takes over 200 million years to orbit the galaxy.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Solar System- EIC Display (SVS5674 - 4).jpg",
        "credit": "NASA's Scientific Visualization Studio - Science and Technology Corporation/Kel Elkins",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Solar_System-_EIC_Display_(SVS5674_-_4).jpg"
      },
      "shots": [
        {
          "start": 10.367,
          "end": 14.167,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.18,
      "end": 18.4,
      "text": "At the center sits Sagittarius A*, a supermassive black hole.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Primera imagen de Sgr A* tomada por el Event Horizon Telescope Collaboration.jpg",
        "credit": "EHT Collaboration",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Primera_imagen_de_Sgr_A*_tomada_por_el_Event_Horizon_Telescope_Collaboration.jpg"
      },
      "shots": [
        {
          "start": 14.167,
          "end": 18.4,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.4,
      "end": 23.54,
      "text": "NASA's Chandra observatory caught it unleashing a flare 400 times brighter than normal.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Sagittarius A*- Chandra Catches Milky Way Monster Snacking (2001-0204flare - 0204flare xray).tiff",
        "credit": "NASA/MIT/F.Baganoff et al.",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Sagittarius_A*-_Chandra_Catches_Milky_Way_Monster_Snacking_(2001-0204flare_-_0204flare_xray).tiff"
      },
      "shots": [
        {
          "start": 18.4,
          "end": 23.533,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.54,
      "end": 27.24,
      "text": "Powerful intergalactic winds blew massive amounts of matter between galaxies.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hubble Ultra Deep Field part d.jpg",
        "credit": "NASA, ESA, S. Beckwith (STScI) and the HUDF Team",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Hubble_Ultra_Deep_Field_part_d.jpg"
      },
      "shots": [
        {
          "start": 23.533,
          "end": 27.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 27.24,
      "end": 30.78,
      "text": "That dust built our planet, our Sun, and us.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Protoplanetary disk.jpg",
        "credit": "Unknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Protoplanetary_disk.jpg"
      },
      "shots": [
        {
          "start": 27.233,
          "end": 30.767,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 30.78,
      "end": 34.106,
      "text": "That is why half your body's atoms came from distant galaxies.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hubble ultra deep field high rez edit1.jpg",
        "credit": "NASA and the European Space Agency. Edited by Noodle snacks",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Hubble_ultra_deep_field_high_rez_edit1.jpg"
      },
      "shots": [
        {
          "start": 30.767,
          "end": 34.467,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    }
  ],
