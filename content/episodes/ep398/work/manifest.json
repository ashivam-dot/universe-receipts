  "beats": [
    {
      "start": 0.08,
      "end": 3.18,
      "text": "Half your body's atoms came from distant galaxies.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hubble ultra deep field high rez edit1.jpg",
        "credit": "NASA and the European Space Agency. Edited by Noodle snacks",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Hubble_ultra_deep_field_high_rez_edit1.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.167,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.18,
      "end": 6.42,
      "text": "Astronomers once believed our galaxy was the entire universe.",
      "asset": {
        "source": "Flickr via Openverse",
        "title": "Part of the milky way from the Trouvelot<br />astronomical drawings (1881-1882) by <a href='https://www.rawpixel.com/sea",
        "credit": "Free Public Domain Illustrations by rawpixel",
        "license": "CC BY 2.0",
        "url": "https://www.flickr.com/photos/153584064@N07/41273022724"
      },
      "shots": [
        {
          "start": 3.167,
          "end": 6.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.42,
      "end": 9.78,
      "text": "Edwin Hubble proved billions of other galaxies existed in the 1920s.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hubble at Hale Telescope (19950424 cd3 08-CC).jpg",
        "credit": "International Gemini Observatory/NOIRLab/NSF/AURA",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Hubble_at_Hale_Telescope_(19950424_cd3_08-CC).jpg"
      },
      "shots": [
        {
          "start": 6.433,
          "end": 8.1,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 8.1,
          "end": 9.767,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.78,
      "end": 12.64,
      "text": "Up to 50 percent of the Milky Way actually came from them.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Early Milky Way.jpg",
        "credit": "NASA and ESA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Early_Milky_Way.jpg"
      },
      "shots": [
        {
          "start": 9.767,
          "end": 12.633,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.64,
      "end": 15.9,
      "text": "Distant supernova explosions drove this matter across space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Keplers supernova.jpg",
        "credit": "NASA/ESA/JHU/R.Sankrit & W.Blair",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Keplers_supernova.jpg"
      },
      "shots": [
        {
          "start": 12.633,
          "end": 15.9,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.9,
      "end": 19.04,
      "text": "These intergalactic currents fed gas directly into our galaxy.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Galaxy light show (potw2445a).tiff",
        "credit": "ESA/Hubble & NASA, O. Fox, L. Jenkins, S. Van Dyk, A. Filippenko, J. Lee and the PHANGS-HST Team, D. de Martin (ESA/Hubble), M. Zamani (ESA/Hubble)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Galaxy_light_show_(potw2445a).tiff"
      },
      "shots": [
        {
          "start": 15.9,
          "end": 19.033,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.04,
      "end": 23.18,
      "text": "That cosmic dust eventually built our planet, our Sun, and us.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Protoplanetary Disk XUE 1 (Artist Concept) (2023-152).jpg",
        "credit": "ESO/L. Cal\u00e7ada",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Protoplanetary_Disk_XUE_1_(Artist_Concept)_(2023-152).jpg"
      },
      "shots": [
        {
          "start": 19.033,
          "end": 23.167,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.18,
      "end": 26.42,
      "text": "It is why half your body's atoms came from distant galaxies.",
