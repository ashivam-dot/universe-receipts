    },
    {
      "start": 5.347,
      "end": 13.417,
      "text": "Command pilot Neil Armstrong and pilot David Scott launched aboard Gemini 8 on March 16, 1966.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Launch of the Gemini 8 mission.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Launch_of_the_Gemini_8_mission.jpg"
      },
      "shots": [
        {
          "start": 5.333,
          "end": 10.467,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 10.467,
          "end": 13.433,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.417,
      "end": 19.512,
      "text": "The mission successfully achieved the world's first orbital docking with an Agena target vehicle.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Gemini VIII Mission Image - Agena (S66-25782).jpg",
        "credit": "NASA Johnson Space Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Gemini_VIII_Mission_Image_-_Agena_(S66-25782).jpg"
      },
      "shots": [
        {
          "start": 13.433,
          "end": 15.8,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 15.8,
          "end": 19.5,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.512,
      "end": 25.982,
      "text": "Minutes later, a short-circuited thruster threw the joined spacecraft into an uncontrollable roll.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Gemini VIII Mission Image - Agena (S66-25782).jpg",
        "credit": "NASA Johnson Space Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Gemini_VIII_Mission_Image_-_Agena_(S66-25782).jpg"
      },
      "shots": [
        {
          "start": 19.5,
          "end": 25.967,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.982,
      "end": 31.702,
      "text": "Believing the target vehicle was malfunctioning, the crew undocked while out of radio range.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Agena Target Docking vehicle seen from Gemini 8 spacecraft (s66-25778).jpg",
        "credit": "NASA Johnson Space Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Agena_Target_Docking_vehicle_seen_from_Gemini_8_spacecraft_(s66-25778).jpg"
      },
      "shots": [
        {
          "start": 25.967,
          "end": 29.333,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 29.333,
          "end": 31.7,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 31.702,
      "end": 37.777,
      "text": "Without the Agena's mass, the capsule accelerated to nearly one revolution per second.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "GEMINI-TITAN (GT)-8 - (EARTH SKY)(EARTH'S LIMB) - OUTER SPACE (S66-25771).jpg",
        "credit": "NASA Johnson Space Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:GEMINI-TITAN_(GT)-8_-_(EARTH_SKY)(EARTH%27S_LIMB)_-_OUTER_SPACE_(S66-25771).jpg"
      },
      "shots": [
        {
          "start": 31.7,
          "end": 35.367,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 35.367,
