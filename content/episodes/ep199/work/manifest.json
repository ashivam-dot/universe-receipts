          "motion": "camera"
        }
      ]
    },
    {
      "start": 37.777,
      "end": 45.147,
      "text": "Armstrong fired the reentry thrusters to halt the tumble, consuming seventy-five percent of their maneuvering fuel.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "S66-26037 (25537748480).jpg",
        "credit": "National Museum of the U.S. Navy",
        "license": "Public domain",
