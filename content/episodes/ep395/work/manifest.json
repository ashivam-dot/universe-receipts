  "beats": [
    {
      "start": 0.08,
      "end": 2.72,
      "text": "The Moon's first rover was built to last three days.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Lunokhod 1 moon rover (MMA 2011) (1).JPG",
        "credit": "Armael",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Lunokhod_1_moon_rover_(MMA_2011)_(1).JPG"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.733,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 2.72,
      "end": 6.48,
      "text": "Instead, it survived eleven lunar days and drove six miles.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 2.733,
          "end": 6.467,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.48,
      "end": 10.26,
      "text": "A radioactive polonium core kept it warm through freezing nights.",
      "asset": {
        "source": "Flickr via Openverse",
        "title": "Lunokhod",
        "credit": "fdecomite",
        "license": "CC BY 2.0",
        "url": "https://www.flickr.com/photos/21649179@N00/15189844354"
      },
      "shots": [
        {
          "start": 6.467,
          "end": 7.933,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 7.933,
          "end": 10.267,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.26,
      "end": 13.46,
      "text": "Contact went dark in 1971, leaving it lost for decades.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 10.267,
          "end": 13.467,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.46,
      "end": 17.02,
      "text": "An orbiter spotted the rover sitting in the dust in 2010.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Sinus Iridum, Chang'e 3 & Lunokhod 1 landing sites.png",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Sinus_Iridum,_Chang%27e_3_%26_Lunokhod_1_landing_sites.png"
      },
      "shots": [
        {
          "start": 13.467,
          "end": 14.833,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 14.833,
          "end": 17.033,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.02,
      "end": 19.74,
      "text": "Scientists fired a telescope laser at its French mirror.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Apache-0110.JPG",
        "credit": "-r.c. (talk)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Apache-0110.JPG"
      },
      "shots": [
        {
          "start": 17.033,
          "end": 19.733,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.74,
      "end": 23.14,
      "text": "On the first try, it bounced back 2,000 photons.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Lunokhod 2 in Kaluga 01.jpg",
        "credit": "Stolbovsky",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Lunokhod_2_in_Kaluga_01.jpg"
      },
      "shots": [
        {
          "start": 19.733,
          "end": 23.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.14,
      "end": 27.13,
      "text": "It outshined newer lunar reflectors, proving how it broke every record.",
      "asset": {
