          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.62,
      "end": 6.88,
      "text": "They'd track the clingy gray grit inside after every moonwalk.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "AS17-134-20471 (21668593222).jpg",
        "credit": "Project Apollo Archive",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:AS17-134-20471_(21668593222).jpg"
      },
      "shots": [
        {
          "start": 3.633,
          "end": 4.933,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 4.933,
          "end": 6.867,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.88,
      "end": 11.48,
      "text": "Robotic landers in 1968 photographed a ghostly glow on the horizon.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Surveyor 7 Fig 3-43.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Surveyor_7_Fig_3-43.jpg"
      },
      "shots": [
        {
          "start": 6.867,
          "end": 11.467,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.48,
      "end": 14.86,
      "text": "Apollo crews even sketched long rays stretching into the sky.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Apollo 17 twilight ray sketch.jpg",
        "credit": "Apollo 17 astronauts",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Apollo_17_twilight_ray_sketch.jpg"
      },
      "shots": [
        {
          "start": 11.467,
          "end": 14.867,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.86,
      "end": 17.92,
      "text": "Solar ultraviolet light charges the surface dust particles.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Psjad06aff1 hr.jpg",
        "credit": "Lianghai Xie,\u00a0Lei Li,\u00a0Huizi Wang,\u00a0Binbin Tang,\u00a0Jindong Wang,\u00a0Yiteng Zhang,\u00a0Quanqi Shi,\u00a0Bin Zhou\u00a0and\u00a0Yongyong Feng",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Psjad06aff1_hr.jpg"
      },
      "shots": [
        {
          "start": 14.867,
          "end": 17.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.92,
      "end": 21.0,
      "text": "Static forces push floating dust onto astronaut suits.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Astronaut Harrison 'Jack' Schmitt, American Flag, and Earth (Apollo 17 EVA-1).jpg",
        "credit": "NASA/Eugene Cernan",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Astronaut_Harrison_%27Jack%27_Schmitt,_American_Flag,_and_Earth_(Apollo_17_EVA-1).jpg"
      },
      "shots": [
        {
          "start": 17.933,
