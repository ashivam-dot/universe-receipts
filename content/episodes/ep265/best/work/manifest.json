        }
      ]
    },
    {
      "start": 3.68,
      "end": 6.88,
      "text": "When they removed their helmets, fine dust clung to everything.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Apollo 17 Cernan on moon.jpg",
        "credit": "NASA / Harrison H. Schmitt",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Apollo_17_Cernan_on_moon.jpg"
      },
      "shots": [
        {
          "start": 3.667,
          "end": 5.733,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 5.733,
          "end": 6.867,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.88,
      "end": 10.8,
      "text": "Years earlier, Surveyor landers photographed a strange horizon glow.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Surveyor 7 - America's Last Lunar Unmanned Lander (LROC534 - surveyortycho).png",
        "credit": "NASA/National Space Science Data Center (NSSDC)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Surveyor_7_-_America%27s_Last_Lunar_Unmanned_Lander_(LROC534_-_surveyortycho).png"
      },
      "shots": [
        {
          "start": 6.867,
          "end": 10.8,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.8,
      "end": 14.46,
      "text": "Apollo crews in orbit even sketched mysterious glowing rays.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Apollo 17 twilight ray sketch.jpg",
        "credit": "Apollo 17 astronauts",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Apollo_17_twilight_ray_sketch.jpg"
      },
      "shots": [
        {
          "start": 10.8,
          "end": 14.467,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.46,
      "end": 17.94,
      "text": "Tiny dust particles were actually levitating above the ground.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NASA Researchers Analyze a Moon Dust Simulation.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:NASA_Researchers_Analyze_a_Moon_Dust_Simulation.jpg"
      },
      "shots": [
        {
          "start": 14.467,
          "end": 16.167,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 16.167,
          "end": 17.933,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.94,
      "end": 21.8,
      "text": "Solar ultraviolet radiation strips electrons off the daylit surface.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Solar wind Speed interplanetary magnetic field.jpg",
        "credit": "NASA \u2013 Marshall Space Flight Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Solar_wind_Speed_interplanetary_magnetic_field.jpg"
      },
      "shots": [
        {
          "start": 17.933,
          "end": 21.8,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.8,
      "end": 25.88,
      "text": "Once a month, Earth's magnetic tail triggers electrical dust storms.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Psjad06aff3 hr.jpg",
        "credit": "Lianghai Xie,\u00a0Lei Li,\u00a0Huizi Wang,\u00a0Binbin Tang,\u00a0Jindong Wang,\u00a0Yiteng Zhang,\u00a0Quanqi Shi,\u00a0Bin Zhou\u00a0and\u00a0Yongyong Feng",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Psjad06aff3_hr.jpg"
      },
      "shots": [
        {
          "start": 21.8,
          "end": 25.867,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.88,
      "end": 29.277,
      "text": "Static electricity levitates the sharp dust into their lander.",
