    {
      "start": 0.08,
      "end": 4.381,
      "text": "One cosmic object is distant enough to change our night sky forever.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NASA Telescopes Create Colorful 'Craft' From Nearby Nebula (Tarantula Nebula Composite Crop).jpg",
        "credit": "X-ray: NASA/CXC/Ohio State Univ./J. Rodriguez et al; Infrared: NASA/ESA/CSA/STScI; Optical: NASA/ESA/STScI; Image Processing: NASA/CXC/SAO/P. Edmonds",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:NASA_Telescopes_Create_Colorful_%27Craft%27_From_Nearby_Nebula_(Tarantula_Nebula_Composite_Crop).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.381,
      "end": 11.076,
      "text": "Our familiar Orion Nebula is close, but jump 160,000 light-years into deep space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Orion Nebula - Hubble 2006 mosaic 18000.jpg",
        "credit": "NASA, ESA, M. Robberto (Space Telescope Science Institute/ESA) and the Hubble Space Telescope Orion Treasury Project Team",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Orion_Nebula_-_Hubble_2006_mosaic_18000.jpg"
      },
      "shots": [
        {
          "start": 4.367,
          "end": 7.733,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 7.733,
          "end": 11.067,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.076,
      "end": 17.096,
      "text": "There, inside the Large Magellanic Cloud galaxy, lies the colossal Tarantula Nebula.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Eso1021d.jpg",
        "credit": "Robert Gendler/ESO",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Eso1021d.jpg"
      },
      "shots": [
        {
          "start": 11.067,
          "end": 13.267,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 13.267,
          "end": 17.1,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.096,
      "end": 23.791,
      "text": "Spanning roughly 1,000 light-years across, it is the most energetic star factory in our Local Group.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Labelled view of the Tarantula Nebula (heic1206c).tiff",
        "credit": "NASA, ESA, D. Lennon and E. Sabbi (ESA/STScI), J. Anderson, S. E. de Mink, R. van der Marel, T. Sohn, and N. Walborn (STScI), N. Bastian (Excellence Cluster, Munich), L. Bedin (INAF, Padua), E. Bresse",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Labelled_view_of_the_Tarantula_Nebula_(heic1206c).tiff"
      },
      "shots": [
        {
          "start": 17.1,
          "end": 20.467,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 20.467,
          "end": 23.8,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.791,
      "end": 30.311,
      "text": "At its heart, cluster R136 contains some of the most massive stars ever discovered.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Grand star-forming region R136 in NGC 2070 (visible and ultraviolet, captured by the Hubble Space Telescope).jpg",
        "credit": "NASA, ESA, F. Paresce (INAF-IASF, Bologna, Italy), R. O'Connell (University of Virginia, Charlottesville), and the Wide Field Camera 3 Science Oversight Committee",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Grand_star-forming_region_R136_in_NGC_2070_(visible_and_ultraviolet,_captured_by_the_Hubble_Space_Telescope).jpg"
      },
      "shots": [
        {
          "start": 23.8,
