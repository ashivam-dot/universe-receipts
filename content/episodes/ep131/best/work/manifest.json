  "beats": [
    {
      "start": 0.08,
      "end": 4.804,
      "text": "A distant cosmic nursery shines brightly enough to cast shadows on Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "A massive cluster is born (potm2401a).tiff",
        "credit": "ESA/Webb, NASA & CSA, O. Nayak, M. Meixner",
