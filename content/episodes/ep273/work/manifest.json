{
  "id": "ep273",
  "duration": 28.993,
  "beats": [
    {
      "start": 0.08,
      "end": 3.14,
      "text": "Jupiter has a storm large enough to swallow Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Jupiter - Great Red Spot - PJ7-60 61 62 - Balanced (49803032983).png",
        "credit": "Kevin Gill from Los Angeles, CA, United States",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Jupiter_-_Great_Red_Spot_-_PJ7-60_61_62_-_Balanced_(49803032983).png"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.033,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 2.033,
          "end": 3.133,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.14,
      "end": 6.08,
      "text": "Earth's wildest hurricanes die when they hit solid land.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Katrina 2005-08-28 2115Z (EVL alternate).png",
        "credit": "NOAA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Katrina_2005-08-28_2115Z_(EVL_alternate).png"
      },
      "shots": [
        {
          "start": 3.133,
          "end": 6.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.08,
      "end": 9.08,
      "text": "But Jupiter has no surface, so this storm never stops.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 6.067,
          "end": 9.067,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.08,
      "end": 12.32,
      "text": "Its cloud tops tower five miles above surrounding clouds.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Grosser roter fleck.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Grosser_roter_fleck.jpg"
      },
      "shots": [
        {
          "start": 9.067,
          "end": 12.333,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.32,
      "end": 15.56,
      "text": "At its peak, the vortex could swallow three Earths whole.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Earth and the Great Red Spot (4078049755).jpg",
        "credit": "Lunar and Planetary Institute from Houston, TX, USA",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Earth_and_the_Great_Red_Spot_(4078049755).jpg"
      },
      "shots": [
        {
          "start": 12.333,
          "end": 14.167,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 14.167,
          "end": 15.567,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.56,
      "end": 18.42,
      "text": "Over the last century, astronomers watched it steadily shrink.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Jupiter's Great Red Spot mosaic from Voyager 1 (cropped).jpg",
        "credit": "NASA / JPL / Bj\u00f6rn J\u00f3nsson",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Jupiter%27s_Great_Red_Spot_mosaic_from_Voyager_1_(cropped).jpg"
      },
      "shots": [
        {
          "start": 15.567,
          "end": 18.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.42,
      "end": 21.58,
      "text": "Telescopes caught it shedding massive cloud flakes in 2019.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Compass Image of Jupiter (2019-36-4562).png",
        "credit": ", , A. Simon (Goddard Space Flight Center), and M.H. Wong (University of California, Berkeley)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Compass_Image_of_Jupiter_(2019-36-4562).png"
      },
      "shots": [
        {
          "start": 18.433,
          "end": 21.567,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.58,
      "end": 25.02,
      "text": "Yet it stays stable by absorbing smaller neighboring storms.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Three Red Spots Mix It Up on Jupiter.jpg",
        "credit": "NASA, ESA, A. Simon-Miller (Goddard Space Flight Center), N. Chanover (New Mexico State University), and G. Orton (Jet Propulsion Laboratory)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Three_Red_Spots_Mix_It_Up_on_Jupiter.jpg"
      },
      "shots": [
        {
          "start": 21.567,
          "end": 25.033,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.02,
      "end": 28.643,
      "text": "It remains an ancient tempest large enough to engulf worlds.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Jupiter - Great Red Spot - PJ7-60 61 62 - Balanced (49803032983).png",
        "credit": "Kevin Gill from Los Angeles, CA, United States",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Jupiter_-_Great_Red_Spot_-_PJ7-60_61_62_-_Balanced_(49803032983).png"
      },
      "shots": [
        {
          "start": 25.033,
          "end": 29.0,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
