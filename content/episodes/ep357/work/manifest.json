{
  "id": "ep357",
  "duration": 30.251,
  "beats": [
    {
      "start": 0.08,
      "end": 3.2,
      "text": "Pluto has ice mountains as tall as the Rockies.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Pluto in True Color - High-Res.jpg",
        "credit": "NASA/Johns Hopkins University Applied Physics Laboratory/Southwest Research Institute/Alex Parker",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Pluto_in_True_Color_-_High-Res.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.2,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.2,
      "end": 6.66,
      "text": "NASA's New Horizons probe found these peaks are made of frozen water.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "15-152-Pluto-NewHorizons-HighResolution-20150714-IFV.jpg",
        "credit": "NASA/JHU APL/SwRI",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:15-152-Pluto-NewHorizons-HighResolution-20150714-IFV.jpg"
      },
      "shots": [
        {
          "start": 3.2,
          "end": 4.933,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 4.933,
          "end": 6.667,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.66,
      "end": 11.0,
      "text": "They tower over a massive heart-shaped basin filled with nitrogen glaciers.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA19945-Pluto-SputnikPlanum-Detail-20150917.jpg",
        "credit": "NASA/Johns Hopkins University Applied Physics Laboratory/Southwest Research Institute",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA19945-Pluto-SputnikPlanum-Detail-20150917.jpg"
      },
      "shots": [
        {
          "start": 6.667,
          "end": 11.0,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.0,
      "end": 15.34,
      "text": "This basin, Sputnik Planitia, is so smooth it lacks impact craters.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NH-Pluto-SputnikPlanum-20150714-v1.jpg",
        "credit": "NASA/JHUAPL/SWRI",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:NH-Pluto-SputnikPlanum-20150714-v1.jpg"
      },
      "shots": [
        {
          "start": 11.0,
          "end": 15.333,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.34,
      "end": 18.42,
      "text": "The nitrogen ice churns like a lava lamp to stay fresh.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Pluto's Icy Plains Captured in Highest-Resolution Views from New Horizons.jpg",
        "credit": "NASA/Johns Hopkins University Applied Physics Laboratory/Southwest Research Institute",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Pluto%27s_Icy_Plains_Captured_in_Highest-Resolution_Views_from_New_Horizons.jpg"
      },
      "shots": [
        {
          "start": 15.333,
          "end": 18.433,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.42,
      "end": 22.64,
      "text": "While the surface stays young, Pluto's thin atmosphere is actually collapsing.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "MVIC sunset scan of Pluto.jpg",
        "credit": "NASA/JHUAPL/SwRI",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:MVIC_sunset_scan_of_Pluto.jpg"
      },
      "shots": [
        {
          "start": 18.433,
          "end": 20.6,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 20.6,
          "end": 22.633,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.64,
      "end": 26.26,
      "text": "Measurements from 2016 show the air pressure dropped by over twenty percent.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 22.633,
          "end": 26.267,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 26.26,
      "end": 29.901,
      "text": "That world is freezing its own sky into mountains of ice.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Pluto in True Color - High-Res.jpg",
        "credit": "NASA/Johns Hopkins University Applied Physics Laboratory/Southwest Research Institute/Alex Parker",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Pluto_in_True_Color_-_High-Res.jpg"
      },
      "shots": [
        {
          "start": 26.267,
          "end": 30.267,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
