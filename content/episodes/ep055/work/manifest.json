{
  "id": "ep055",
  "duration": 50.065,
  "beats": [
    {
      "start": 0.08,
      "end": 3.763,
      "text": "A cosmic Death Star was once feared to be pointed at Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Wr104 sslkeck big.jpg",
        "credit": "T\u00e9lescope Keck",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Wr104_sslkeck_big.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.767,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.763,
      "end": 12.333,
      "text": "Deep in the constellation Sagittarius lies WR 104, located about eight thousand four hundred light-years from Earth.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 3.767,
          "end": 12.333,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.333,
      "end": 18.603,
      "text": "At its heart, a massive Wolf-Rayet star and an OB companion orbit each other every eight months.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "A cosmic couple.jpg",
        "credit": "ESA/Hubble & NASA; Acknowledgement: Judy Schmidt (geckzilla.com)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:A_cosmic_couple.jpg"
      },
      "shots": [
        {
          "start": 12.333,
          "end": 18.6,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.603,
      "end": 26.698,
      "text": "Their powerful stellar winds slam together, creating a spinning pinwheel nebula over two hundred astronomical units wide.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 18.6,
          "end": 26.7,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 26.698,
      "end": 35.018,
      "text": "Early imaging suggested Earth was looking directly down the rotational axis, sparking panic over a lethal gamma-ray burst.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Gamma-rays hitting the Earth's atmosphere.tif",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Gamma-rays_hitting_the_Earth%27s_atmosphere.tif"
      },
      "shots": [
        {
          "start": 26.7,
          "end": 30.233,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 30.233,
          "end": 35.033,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 35.018,
      "end": 43.343,
      "text": "Recent Keck Observatory research revealed that the actual stellar orbit is tilted thirty to forty degrees away from us.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "KeckObservatory.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:KeckObservatory.jpg"
      },
      "shots": [
        {
          "start": 35.033,
          "end": 43.333,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 43.343,
      "end": 49.715,
      "text": "Earth is safely out of the firing line, proving why a cosmic Death Star was once feared to be pointed at Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Wr104 sslkeck big.jpg",
        "credit": "T\u00e9lescope Keck",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Wr104_sslkeck_big.jpg"
      },
      "shots": [
        {
          "start": 43.333,
          "end": 50.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
