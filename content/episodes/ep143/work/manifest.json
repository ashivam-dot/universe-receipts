  "duration": 57.351,
  "beats": [
    {
      "start": 0.08,
      "end": 4.6,
      "text": "NASA fired an 820-pound copper bullet into a speeding comet.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA07923 modest.jpg",
        "credit": "NASA/JPL-Caltech/UMD/Pat Rawlings",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA07923_modest.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.167,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 2.167,
          "end": 4.6,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.6,
      "end": 12.57,
      "text": "On July 4, 2005, the Deep Impact mission intercepted Comet Tempel 1 with a two-part spacecraft.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Deep Impact Launch.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Deep_Impact_Launch.jpg"
      },
      "shots": [
        {
          "start": 4.6,
          "end": 7.467,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 7.467,
          "end": 12.567,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.57,
      "end": 18.465,
      "text": "The mothership released a smart impactor for a collision at 23,000 miles per hour.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Deep Impact diagram.png",
        "credit": "Unknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Deep_Impact_diagram.png"
      },
      "shots": [
        {
          "start": 12.567,
          "end": 15.967,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 15.967,
          "end": 18.467,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.465,
      "end": 25.335,
      "text": "Engineers used copper to ensure the strike wouldn't contaminate scientific readings of the comet's minerals.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "04pd2176~orig.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:04pd2176~orig.jpg"
      },
      "shots": [
        {
          "start": 18.467,
          "end": 25.333,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.335,
      "end": 32.005,
      "text": "The collision released energy equal to five tons of TNT, ejecting a massive cloud of debris.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hubble captures Deep Impact's collision with a comet (view 64 minutes after impact) (heic0509d).jpg",
        "credit": "NASA, ESA, P. Feldman (Johns Hopkins University), and H. Weaver (Johns Hopkins University Applied Physics Lab)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Hubble_captures_Deep_Impact%27s_collision_with_a_comet_(view_64_minutes_after_impact)_(heic0509d).jpg"
      },
      "shots": [
        {
          "start": 25.333,
          "end": 32.0,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 32.005,
      "end": 38.755,
      "text": "Telescopes initially saw only a blur because the spacecraft's primary camera was out of focus.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "DI MRI Impactor -24hr.jpg",
        "credit": "Unknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:DI_MRI_Impactor_-24hr.jpg"
      },
      "shots": [
        {
          "start": 32.0,
          "end": 38.767,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 38.755,
      "end": 45.555,
      "text": "Scientists used complex math to sharpen the view, revealing a vault of organic ingredients for life.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Tempel1 DeepImpact.jpg",
        "credit": "NASA/JPL-Caltech/UMD",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Tempel1_DeepImpact.jpg"
      },
      "shots": [
        {
          "start": 38.767,
          "end": 45.567,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 45.555,
      "end": 52.0,
      "text": "In 2011, a second mission confirmed the strike carved a crater 150 meters wide.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA13862 Tempel 1 annotated.jpg",
        "credit": "NASA / JPL-Caltech / Cornell",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA13862_Tempel_1_annotated.jpg"
      },
      "shots": [
        {
          "start": 45.567,
          "end": 52.0,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 52.0,
      "end": 57.001,
      "text": "This is why NASA fired an 820-pound copper bullet into a speeding comet.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA07923 modest.jpg",
        "credit": "NASA/JPL-Caltech/UMD/Pat Rawlings",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA07923_modest.jpg"
      },
      "shots": [
        {
          "start": 52.0,
          "end": 57.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
