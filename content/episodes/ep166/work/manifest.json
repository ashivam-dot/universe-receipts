{
  "id": "ep166",
  "duration": 51.513,
  "beats": [
    {
      "start": 0.08,
      "end": 5.559,
      "text": "Voyager 1 would need 74,000 years to reach our nearest neighboring star.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyager spacecraft.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Voyager_spacecraft.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.4,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 2.4,
          "end": 5.567,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 5.559,
      "end": 11.704,
      "text": "We often imagine Proxima Centauri is right next door at just 4.2 light-years away.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "New shot of Proxima Centauri, our nearest neighbour.jpg",
        "credit": "ESA/Hubble & NASA",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:New_shot_of_Proxima_Centauri,_our_nearest_neighbour.jpg"
      },
      "shots": [
        {
          "start": 5.567,
          "end": 11.7,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.704,
      "end": 17.374,
      "text": "This red dwarf hides a roughly Earth-sized world orbiting within its habitable zone.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist\u2019s impression of Proxima Centauri b shown hypothetically as an arid rocky super-earth.jpg",
        "credit": "ESO/M. Kornmesser",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%E2%80%99s_impression_of_Proxima_Centauri_b_shown_hypothetically_as_an_arid_rocky_super-earth.jpg"
      },
      "shots": [
        {
          "start": 11.7,
          "end": 17.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.374,
      "end": 23.869,
      "text": "Proxima Centauri b completes its year in 11.2 days, making it a tempting destination.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 17.367,
          "end": 23.867,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.869,
      "end": 29.714,
      "text": "There is even a candidate second world, Proxima Centauri c, orbiting much further out.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist's impression - exoplanet Proxima Centauri b.tif",
        "credit": "ESO",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%27s_impression_-_exoplanet_Proxima_Centauri_b.tif"
      },
      "shots": [
        {
          "start": 23.867,
          "end": 29.7,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 29.714,
      "end": 36.759,
      "text": "To explore beyond our Sun, NASA sent Voyager 1 past Jupiter and Saturn carrying the Golden Record.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Titan 3E with Voyager 1.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Titan_3E_with_Voyager_1.jpg"
      },
      "shots": [
        {
          "start": 29.7,
          "end": 32.433,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 32.433,
          "end": 36.767,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 36.759,
      "end": 42.454,
      "text": "Yet human technology cannot shrink the terrifying vastness of interstellar space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA17036 Voyager the Explorer.jpg",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA17036_Voyager_the_Explorer.jpg"
      },
      "shots": [
        {
          "start": 36.767,
          "end": 42.467,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 42.454,
      "end": 47.749,
      "text": "Even traveling seventeen kilometers per second since 1977,",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 42.467,
          "end": 47.733,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 47.749,
      "end": 51.163,
      "text": "crossing four light-years to reach our nearest planet means",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyager spacecraft.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Voyager_spacecraft.jpg"
      },
      "shots": [
        {
          "start": 47.733,
          "end": 51.5,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
