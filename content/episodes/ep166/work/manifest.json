{
  "id": "ep166",
  "duration": 50.564,
  "beats": [
    {
      "start": 0.08,
      "end": 5.554,
      "text": "Voyager 1 would need 74,000 years to reach our nearest neighboring star.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyager spacecraft.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Voyager_spacecraft.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.4,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 2.4,
          "end": 5.567,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 5.554,
      "end": 11.699,
      "text": "We often imagine Proxima Centauri is right next door at just 4.2 light-years away.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "New shot of Proxima Centauri, our nearest neighbour.jpg",
        "credit": "ESA/Hubble & NASA",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:New_shot_of_Proxima_Centauri,_our_nearest_neighbour.jpg"
      },
      "shots": [
        {
          "start": 5.567,
          "end": 11.7,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.699,
      "end": 17.369,
      "text": "This red dwarf hides a roughly Earth-sized world orbiting within its habitable zone.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist\u2019s impression of Proxima Centauri b shown hypothetically as an arid rocky super-earth.jpg",
        "credit": "ESO/M. Kornmesser",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%E2%80%99s_impression_of_Proxima_Centauri_b_shown_hypothetically_as_an_arid_rocky_super-earth.jpg"
      },
      "shots": [
        {
          "start": 11.7,
          "end": 17.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.369,
      "end": 23.864,
      "text": "Proxima Centauri b completes its year in 11.2 days, making it a tempting destination.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 17.367,
          "end": 23.867,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.864,
      "end": 28.684,
      "text": "There is even a second candidate planet orbiting much further into the cold.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist\u2019s impression of super-Earth orbiting Barnard\u2019s Star (eso1837b).tiff",
        "credit": "ESO/M. Kornmesser",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%E2%80%99s_impression_of_super-Earth_orbiting_Barnard%E2%80%99s_Star_(eso1837b).tiff"
      },
      "shots": [
        {
          "start": 23.867,
          "end": 25.6,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 25.6,
          "end": 28.7,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 28.684,
      "end": 35.754,
      "text": "Since 1977, Voyager 1 has been racing into the void at 17 kilometers per second.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Titan 3E with Voyager 1.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Titan_3E_with_Voyager_1.jpg"
      },
      "shots": [
        {
          "start": 28.7,
          "end": 33.3,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 33.3,
          "end": 35.767,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 35.754,
      "end": 41.074,
      "text": "But even at that blistering speed, our fastest probe is essentially standing still.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyager 2 Heliopause.jpg",
        "credit": "NASA/Goddard Space Flight Center Conceptual Image Lab\nAnimator\nWalt Feimer (HTSI)\nScientist\n\nEric Christian (NASA/HQ)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Voyager_2_Heliopause.jpg"
      },
      "shots": [
        {
          "start": 35.767,
          "end": 38.4,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 38.4,
          "end": 41.067,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 41.074,
      "end": 45.949,
      "text": "The scale of the cosmos makes a human lifetime feel like a heartbeat.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Comparison of the TRAPPIST-1 system with the inner Solar System and the Galilean Moons of Jupiter.jpg",
        "credit": "ESO/O. Furtak",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Comparison_of_the_TRAPPIST-1_system_with_the_inner_Solar_System_and_the_Galilean_Moons_of_Jupiter.jpg"
      },
      "shots": [
        {
          "start": 41.067,
          "end": 45.933,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 45.949,
      "end": 50.214,
      "text": "Bridging the four light-year gap to our neighbors remains a staggering challenge.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyager spacecraft.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Voyager_spacecraft.jpg"
      },
      "shots": [
        {
          "start": 45.933,
          "end": 50.567,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
