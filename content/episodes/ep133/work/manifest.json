{
  "id": "ep133",
  "duration": 47.772,
  "beats": [
    {
      "start": 0.08,
      "end": 4.322,
      "text": "A six-sided storm wide enough to swallow two Earths spins on Saturn.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Saturn - February 27 2013 (25651816757).jpg",
        "credit": "Kevin Gill from Los Angeles, CA, United States",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Saturn_-_February_27_2013_(25651816757).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 1.7,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 1.7,
          "end": 4.333,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.322,
      "end": 10.342,
      "text": "NASA's Voyager probes first spotted this geometric jet stream at the planet's north pole.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA21053 - Saturnian Hexagon Collage.jpg",
        "credit": "NASA/JPL-Caltech/Space Science Institute",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA21053_-_Saturnian_Hexagon_Collage.jpg"
      },
      "shots": [
        {
          "start": 4.333,
          "end": 10.333,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.342,
      "end": 15.712,
      "text": "The structure spans 20,000 miles across, wider than two Earths side-by-side.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Saturn north polar hexagon 2012-11-27.jpg",
        "credit": "NASA / JPL-Caltech / Space Science Institute",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Saturn_north_polar_hexagon_2012-11-27.jpg"
      },
      "shots": [
        {
          "start": 10.333,
          "end": 13.767,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 13.767,
          "end": 15.7,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.712,
      "end": 22.132,
      "text": "Even more incredible, each single side of the hexagon is longer than Earth\u2019s entire diameter.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Saturn - January 2 2008 (25583555868).jpg",
        "credit": "Kevin Gill from Los Angeles, CA, United States",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Saturn_-_January_2_2008_(25583555868).jpg"
      },
      "shots": [
        {
          "start": 15.7,
          "end": 19.467,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 19.467,
          "end": 22.133,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.132,
      "end": 28.452,
      "text": "Winds blast at 200 miles per hour around a central hurricane as wide as a continent.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Saturn north polar vortex false color.jpg",
        "credit": "NASA/JPL-Caltech/SSI",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Saturn_north_polar_vortex_false_color.jpg"
      },
      "shots": [
        {
          "start": 22.133,
          "end": 28.467,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 28.452,
      "end": 35.072,
      "text": "Over decades, the vortex shifted from deep blue to golden yellow as sunlight reacted with methane.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA21049 Changing Colors in Saturn's North.jpg",
        "credit": "NASA/JPL-Caltech/Space Science Institute/Hampton University",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA21049_Changing_Colors_in_Saturn%27s_North.jpg"
      },
      "shots": [
        {
          "start": 28.467,
          "end": 35.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 35.072,
      "end": 42.347,
      "text": "This isn't magic\u2014scientists recreated the exact shape in simple water tanks using basic physics.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PSM V39 D664 Eddy waves or ripples.jpg",
        "credit": "Unknown authorUnknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PSM_V39_D664_Eddy_waves_or_ripples.jpg"
      },
      "shots": [
        {
          "start": 35.067,
          "end": 42.333,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 42.347,
      "end": 47.422,
      "text": "It proves nature's laws can carve perfect straight lines across an entire planet.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Saturn - February 27 2013 (25651816757).jpg",
        "credit": "Kevin Gill from Los Angeles, CA, United States",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Saturn_-_February_27_2013_(25651816757).jpg"
      },
      "shots": [
        {
          "start": 42.333,
          "end": 47.767,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
