    },
    {
      "start": 4.122,
      "end": 9.467,
      "text": "In 1906, Percival Lowell began searching for Planet X in Arizona.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 4.133,
          "end": 9.467,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.467,
      "end": 15.737,
      "text": "Though Lowell died in 1916, director V. M. Slipher hired Clyde Tombaugh to continue.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Clyde W. Tombaugh.jpeg",
        "credit": "Unknown authorUnknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Clyde_W._Tombaugh.jpeg"
      },
      "shots": [
        {
          "start": 9.467,
          "end": 13.767,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 13.767,
          "end": 15.733,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.737,
      "end": 20.832,
      "text": "Tombaugh discovered Pluto in February 1930 using a new telescope.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Pluto Blender render.png",
        "credit": "Wikideas1",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Pluto_Blender_render.png"
      },
      "shots": [
        {
          "start": 15.733,
          "end": 17.967,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 17.967,
          "end": 20.833,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.832,
      "end": 27.002,
      "text": "Decades later, astronomers found Eris in the Kuiper belt, a body more massive than Pluto.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist\u2019s impression of the dwarf planet Eris1.tif",
        "credit": "ESO/L. Cal\u00e7ada",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%E2%80%99s_impression_of_the_dwarf_planet_Eris1.tif"
      },
      "shots": [
        {
          "start": 20.833,
          "end": 23.733,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 23.733,
          "end": 27.0,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 27.002,
      "end": 34.322,
      "text": "In 2006, the International Astronomical Union required planets to clear their orbital neighborhoods.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The IAU draft definition of planet and plutons.jpg",
        "credit": "The International Astronomical Union/Martin Kornmesser",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:The_IAU_draft_definition_of_planet_and_plutons.jpg"
      },
      "shots": [
        {
          "start": 27.0,
          "end": 30.667,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 30.667,
          "end": 34.333,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 34.322,
      "end": 39.042,
      "text": "Pluto failed this criterion and was reclassified as a dwarf planet.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Earth compared to Kepler-186 f.jpg",
        "credit": "Canis987*&",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Earth_compared_to_Kepler-186_f.jpg"
      },
      "shots": [
        {
          "start": 34.333,
          "end": 39.033,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 39.042,
      "end": 45.742,
      "text": "NASA's New Horizons later revealed an active world featuring a massive nitrogen-ice basin.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NH-Pluto-SputnikPlanum-20150714.jpg",
        "credit": "NASA/JHUAPL/SWRI",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:NH-Pluto-SputnikPlanum-20150714.jpg"
      },
      "shots": [
        {
          "start": 39.033,
          "end": 45.733,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 45.742,
      "end": 52.382,
      "text": "That ongoing mystery started when a wealthy businessman spent years hunting for an unseen planet.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Percival Lowell 1900s2.jpg",
