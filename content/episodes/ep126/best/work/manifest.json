{
  "id": "ep126",
  "duration": 56.55,
  "beats": [
    {
      "start": 0.08,
      "end": 4.756,
      "text": "One sleeping black hole flared fifty times brighter than the Crab Nebula.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.767,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.756,
      "end": 12.651,
      "text": "Located about 8,000 light-years away, V404 Cygni holds a black hole nine to ten times our Sun's mass.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Photo of the constellation Cygnus produced by NOIRLab in collaboration with Eckhard Slawik, a German astrophotographer (cygnus).tiff",
        "credit": "E. Slawik/NOIRLab/NSF/AURA/M. Zamani",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Photo_of_the_constellation_Cygnus_produced_by_NOIRLab_in_collaboration_with_Eckhard_Slawik,_a_German_astrophotographer_(cygnus).tiff"
      },
      "shots": [
        {
          "start": 4.767,
          "end": 10.033,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 10.033,
          "end": 12.667,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.651,
      "end": 19.846,
      "text": "Every 6.5 days, a companion star orbits closely, feeding gas into a swelling accretion disk.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 12.667,
          "end": 19.833,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.846,
      "end": 29.441,
      "text": "After recorded outbursts in 1938 and 1956, Japan's Ginga satellite detected another awakening in 1989.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Supernova Remnant W49B in x-ray, radio, and infrared.jpg",
        "credit": "X-ray: NASA/CXC/MIT/L.Lopez et al.; Infrared: Palomar; Radio: NSF/NRAO/VLA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Supernova_Remnant_W49B_in_x-ray,_radio,_and_infrared.jpg"
      },
      "shots": [
        {
          "start": 19.833,
          "end": 25.167,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 25.167,
          "end": 29.433,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 29.441,
      "end": 36.436,
      "text": "Then, after twenty-six years of slumber, NASA's Swift satellite caught it erupting in June 2015.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Swift Observatory rendering back alpha (SVS13926).png",
        "credit": "NASA/Goddard Space Flight Center/Chris Smith (KBRwyle)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Swift_Observatory_rendering_back_alpha_(SVS13926).png"
      },
      "shots": [
        {
          "start": 29.433,
          "end": 32.933,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 32.933,
          "end": 36.433,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 36.436,
      "end": 43.536,
      "text": "Extreme gravitational frame-dragging warped space-time, forcing its inner disk to wobble like a dying top.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 36.433,
          "end": 43.533,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 43.536,
      "end": 50.956,
      "text": "Terrifyingly, relativistic plasma jets sprayed high-energy bullets in wildly changing directions within minutes.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist\u2019s illustration of galaxy with jets from a supermassive black hole.jpg",
        "credit": "ESA/Hubble, L. Cal\u00e7ada (ESO)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%E2%80%99s_illustration_of_galaxy_with_jets_from_a_supermassive_black_hole.jpg"
      },
      "shots": [
        {
          "start": 43.533,
          "end": 46.3,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 46.3,
          "end": 50.967,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 50.956,
      "end": 56.2,
      "text": "Decades of silence can shatter in seconds whenever this cosmic predator awakens.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 50.967,
          "end": 56.533,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    }
  ],
