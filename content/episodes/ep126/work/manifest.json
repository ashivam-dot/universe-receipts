{
  "id": "ep126",
  "duration": 56.775,
  "beats": [
    {
      "start": 0.08,
      "end": 4.756,
      "text": "One sleeping black hole flared fifty times brighter than the Crab Nebula.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Explosion de colores.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Explosion_de_colores.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.067,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 2.067,
          "end": 4.767,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.756,
      "end": 12.651,
      "text": "Located about 8,000 light-years away, V404 Cygni holds a black hole nine to ten times our Sun's mass.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Photo of the constellation Cygnus produced by NOIRLab in collaboration with Eckhard Slawik, a German astrophotographer (cygnus).tiff",
        "credit": "E. Slawik/NOIRLab/NSF/AURA/M. Zamani",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Photo_of_the_constellation_Cygnus_produced_by_NOIRLab_in_collaboration_with_Eckhard_Slawik,_a_German_astrophotographer_(cygnus).tiff"
      },
      "shots": [
        {
          "start": 4.767,
          "end": 10.033,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 10.033,
          "end": 12.667,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.651,
      "end": 19.846,
      "text": "Every 6.5 days, a companion star orbits closely, feeding gas into a swelling accretion disk.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 12.667,
          "end": 19.833,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.846,
      "end": 29.666,
      "text": "After recorded outbursts in 1938 and 1956, Japan's [Ginga](/\u02a4\u02c8in\u0261\u02c8\u0251/) satellite detected another awakening in 1989.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Perseus and Centaurus clusters.jpg",
        "credit": "Perseus Cluster: X-ray: NASA/CXC/SAO/V. Olivares et al.; Optical/IR: DSS; H-alpha: CFHT/SITELLE; Centaurus Cluster: X-ray: NASA/CXC/SAO/V. Olivaresi et al.; Optical/IR: NASA/ESA/STScI; H-alpha: ESO/VL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Perseus_and_Centaurus_clusters.jpg"
      },
      "shots": [
        {
          "start": 19.833,
          "end": 25.167,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 25.167,
          "end": 29.667,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 29.666,
      "end": 36.661,
      "text": "Then, after twenty-six years of slumber, NASA's Swift satellite caught it erupting in June 2015.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Swift Observatory rendering back alpha (SVS13926).png",
        "credit": "NASA/Goddard Space Flight Center/Chris Smith (KBRwyle)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Swift_Observatory_rendering_back_alpha_(SVS13926).png"
      },
      "shots": [
        {
          "start": 29.667,
          "end": 33.167,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 33.167,
          "end": 36.667,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 36.661,
      "end": 43.761,
      "text": "Extreme gravitational frame-dragging warped space-time, forcing its inner disk to wobble like a dying top.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 36.667,
          "end": 43.767,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 43.761,
      "end": 51.181,
      "text": "Terrifyingly, relativistic plasma jets sprayed high-energy bullets in wildly changing directions within minutes.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Black hole jet diagram.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Black_hole_jet_diagram.jpg"
      },
      "shots": [
        {
          "start": 43.767,
          "end": 51.167,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 51.181,
      "end": 56.425,
      "text": "Decades of silence can shatter in seconds whenever this cosmic predator awakens.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Explosion de colores.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Explosion_de_colores.jpg"
      },
      "shots": [
        {
          "start": 51.167,
          "end": 56.767,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
