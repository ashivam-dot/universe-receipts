{
  "id": "ep108",
  "duration": 51.433,
  "beats": [
    {
      "start": 0.08,
      "end": 3.966,
      "text": "Astronauts had to cut their station's power cables to survive.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "STS079-324-009 - STS-079 - Survey views of the Mir space station - DPLA - 48960355a60b8eb7bc422ebdb76d688b.jpg",
        "credit": "National Aeronautics and Space Administration. Lyndon B. Johnson Space Center. 2/17/1973",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:STS079-324-009_-_STS-079_-_Survey_views_of_the_Mir_space_station_-_DPLA_-_48960355a60b8eb7bc422ebdb76d688b.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.967,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.966,
      "end": 12.686,
      "text": "Many believe that space docking is always a safe, automated routine, like when a cargo ship docked on April 8, 1997.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Progress M1-11 cropped.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Progress_M1-11_cropped.jpg"
      },
      "shots": [
        {
          "start": 3.967,
          "end": 12.7,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.686,
      "end": 18.706,
      "text": "But on June 25, 1997, a manual docking test went horribly wrong.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mir space station 12 June 1998-cropped.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Mir_space_station_12_June_1998-cropped.jpg"
      },
      "shots": [
        {
          "start": 12.7,
          "end": 18.7,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.706,
      "end": 23.926,
      "text": "Commander Vasily Tsibliyev lost control of the heavy Progress cargo ship.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Tsibliyev.jpg",
        "credit": "NASA\n\nOriginal uploader was Tomhannen at en.wikipedia",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Tsibliyev.jpg"
      },
      "shots": [
        {
          "start": 18.7,
          "end": 20.767,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 20.767,
          "end": 23.933,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.926,
      "end": 29.721,
      "text": "The runaway vessel crashed directly into Mir's Spektr module, damaging a solar panel.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Damaged Spektr solar array.jpg",
        "credit": "NASA/Crew of STS-86",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Damaged_Spektr_solar_array.jpg"
      },
      "shots": [
        {
          "start": 23.933,
          "end": 26.667,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 26.667,
          "end": 29.733,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 29.721,
      "end": 34.671,
      "text": "The violent collision punctured Mir's hull, causing a critical air leak.",
      "asset": {
        "source": "Rawpixel via Openverse",
        "title": "Russia&rsquo;s Mir Space Station&rsquo;s Spektr Module. The backside of a solar array panel and damage incurred by the i",
        "credit": "NASA",
        "license": "CC0",
        "url": "https://www.rawpixel.com/image/441612/free-photo-image-solar-panel-space-station-aerospace"
      },
      "shots": [
        {
          "start": 29.733,
          "end": 34.667,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 34.671,
      "end": 39.691,
      "text": "To save the station, the crew sealed off Spektr by cutting its power cables.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "S86E5346 - STS-086 - Foale on middeck with tea - DPLA - ede4e2745e10ba9f96c3b088500e3c27.jpg",
        "credit": "National Aeronautics and Space Administration. Lyndon B. Johnson Space Center. 2/17/1973",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:S86E5346_-_STS-086_-_Foale_on_middeck_with_tea_-_DPLA_-_ede4e2745e10ba9f96c3b088500e3c27.jpg"
      },
      "shots": [
        {
          "start": 34.667,
          "end": 39.7,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 39.691,
      "end": 44.986,
      "text": "This desperate cut left the station at half power, tumbling in complete darkness.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "STS084-322-007 - STS-084 - Views of Mir Space Station after undocking and during separation - DPLA - 139ae60ff853c74fe0c9c5770b5d9148.jpg",
        "credit": "National Aeronautics and Space Administration. Lyndon B. Johnson Space Center. 2/17/1973",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:STS084-322-007_-_STS-084_-_Views_of_Mir_Space_Station_after_undocking_and_during_separation_-_DPLA_-_139ae60ff853c74fe0c9c5770b5d9148.jpg"
      },
      "shots": [
        {
          "start": 39.7,
          "end": 41.8,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 41.8,
          "end": 45.0,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 44.986,
      "end": 51.083,
      "text": "This harrowing near-miss proved that astronauts sometimes must cut their station's power cables to survive.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "STS079-324-009 - STS-079 - Survey views of the Mir space station - DPLA - 48960355a60b8eb7bc422ebdb76d688b.jpg",
        "credit": "National Aeronautics and Space Administration. Lyndon B. Johnson Space Center. 2/17/1973",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:STS079-324-009_-_STS-079_-_Survey_views_of_the_Mir_space_station_-_DPLA_-_48960355a60b8eb7bc422ebdb76d688b.jpg"
      },
      "shots": [
        {
          "start": 45.0,
          "end": 51.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
