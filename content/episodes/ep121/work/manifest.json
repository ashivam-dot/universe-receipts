  "beats": [
    {
      "start": 0.08,
      "end": 3.729,
      "text": "Built for twenty-one months, it flew for over thirty years.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Pioneer 10 Artwork Spacecraft shown during encounter above Jupiter's surface (used in NASA SP-349) (ARC-1972-AC72-1354).jpg",
        "credit": "NASA Ames Research Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Pioneer_10_Artwork_Spacecraft_shown_during_encounter_above_Jupiter%27s_surface_(used_in_NASA_SP-349)_(ARC-1972-AC72-1354).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.733,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.729,
      "end": 9.424,
      "text": "Most people think deep space probes fail early, but Pioneer ten shattered every limit.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Pioneer 10 Artwork Spacecraft shown during encounter above Jupiter's surface (used in NASA SP-349) (ARC-1972-AC72-1354).jpg",
        "credit": "NASA Ames Research Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Pioneer_10_Artwork_Spacecraft_shown_during_encounter_above_Jupiter%27s_surface_(used_in_NASA_SP-349)_(ARC-1972-AC72-1354).jpg"
      },
      "shots": [
        {
          "start": 3.733,
          "end": 9.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.424,
      "end": 15.569,
      "text": "In March nineteen seventy-two, an Atlas-Centaur rocket launched the historic mission from Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "08 002160 SDASM Space Image - MLV (AC69) (54035752428).jpg",
        "credit": "San Diego Air & Space Museum Archives",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:08_002160_SDASM_Space_Image_-_MLV_(AC69)_(54035752428).jpg"
      },
      "shots": [
        {
          "start": 9.433,
          "end": 15.567,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.569,
      "end": 21.114,
      "text": "The spacecraft became the first to safely navigate through the treacherous asteroid belt.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Asteroid belt positions-en.png",
        "credit": "Thunkii",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Asteroid_belt_positions-en.png"
      },
      "shots": [
        {
          "start": 15.567,
          "end": 21.1,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.114,
      "end": 27.939,
      "text": "It survived brutal Jovian radiation to capture stunning close-up views of the Great Red Spot.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Photograph take Pioneer 10 spacecraft managed by the NASA Ames Research Center, Moffett Field, California Jupiter's Red Spot and a showdow of the Moon, Io are seen in this image taken at a range of 2527063km (ARC-1973-AC73-9175).jpg",
        "credit": "NASA Ames Research Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Photograph_take_Pioneer_10_spacecraft_managed_by_the_NASA_Ames_Research_Center,_Moffett_Field,_California_Jupiter%27s_Red_Spot_and_a_showdow_of_the_Moon,_Io_are_seen_in_this_image_taken_at_a_range_of_2527063km_(ARC-1973-AC73-9175).jpg"
      },
      "shots": [
        {
          "start": 21.1,
          "end": 24.533,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 24.533,
          "end": 27.933,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 27.939,
      "end": 34.484,
      "text": "Bolted to its antenna strut was a gold-anodized plaque designed by Carl Sagan and Frank Drake.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Pioneer10-plaque.jpg",
        "credit": "Designed by Carl Sagan and Frank Drake.  Artwork prepared by Linda Salzman Sagan.\n\nPhotograph by NASA Ames Research Center (NASA-ARC)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Pioneer10-plaque.jpg"
      },
      "shots": [
        {
          "start": 27.933,
          "end": 30.267,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 30.267,
          "end": 34.5,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 34.484,
      "end": 39.434,
      "text": "The message carried drawings of nude humans and a map pointing back to Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Pioneer Plakette.png",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Pioneer_Plakette.png"
      },
      "shots": [
        {
          "start": 34.5,
          "end": 39.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 39.434,
      "end": 45.56,
      "text": "Today, this silent ghost ship drifts toward the constellation Taurus after operating for decades.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Pioneer 10 Artwork Spacecraft shown during encounter above Jupiter's surface (used in NASA SP-349) (ARC-1972-AC72-1354).jpg",
