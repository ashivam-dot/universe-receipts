{
  "id": "ep429",
  "duration": 28.716,
  "beats": [
    {
      "start": 0.08,
      "end": 3.52,
      "text": "Early spacewalking was so exhausting it nearly killed astronauts.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "S66-63536.jpg",
        "credit": "NASA/Jim Lovell",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:S66-63536.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.533,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.52,
      "end": 6.56,
      "text": "Pilots couldn't work in zero gravity without proper body restraints.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Gemini Capsule - wind tunnel model.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Gemini_Capsule_-_wind_tunnel_model.jpg"
      },
      "shots": [
        {
          "start": 3.533,
          "end": 6.567,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.56,
      "end": 10.4,
      "text": "NASA launched Gemini 12 in November 1966 to fix this crisis.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Gemini 12 Liftoff Via Titan Launch Vehicle.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Gemini_12_Liftoff_Via_Titan_Launch_Vehicle.jpg"
      },
      "shots": [
        {
          "start": 6.567,
          "end": 10.4,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.4,
      "end": 13.66,
      "text": "Command pilot James Lovell and pilot Buzz Aldrin faced radar failure.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Portrait - Gemini 12 - Prime and Backup Crews (s66-46955).jpg",
        "credit": "NASA Johnson Space Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Portrait_-_Gemini_12_-_Prime_and_Backup_Crews_(s66-46955).jpg"
      },
      "shots": [
        {
          "start": 10.4,
          "end": 13.667,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.66,
      "end": 17.38,
      "text": "Aldrin used a sextant to manually compute their orbital rendezvous maneuvers.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 13.667,
          "end": 17.367,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.38,
      "end": 20.68,
      "text": "He then tested custom foot restraints during three difficult spacewalks.",
      "asset": {
        "source": "Flickr via Openverse",
        "title": "Buzz Aldrin's EVA flashlight used on his first space walk, back in the heavy-velcro era",
        "credit": "jurvetson",
        "license": "CC BY 2.0",
        "url": "https://www.flickr.com/photos/44124348109@N01/49416029833"
      },
      "shots": [
        {
          "start": 17.367,
          "end": 20.667,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.68,
      "end": 24.18,
      "text": "Underwater pool training had finally mastered the deadly zero gravity fatigue.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Gemini 4 EVA training 2.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Gemini_4_EVA_training_2.jpg"
      },
      "shots": [
        {
          "start": 20.667,
          "end": 24.167,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.18,
      "end": 28.366,
      "text": "Space walk exhaustion nearly killed astronauts before underwater pools saved missions.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "S66-63536.jpg",
        "credit": "NASA/Jim Lovell",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:S66-63536.jpg"
      },
      "shots": [
        {
          "start": 24.167,
          "end": 28.7,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
