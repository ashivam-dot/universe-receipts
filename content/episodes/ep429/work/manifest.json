{
  "id": "ep429",
  "duration": 30.635,
  "beats": [
    {
      "start": 0.08,
      "end": 4.12,
      "text": "Early spacewalking was so exhausting it nearly killed astronauts.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Project Gemini Comes to Life (LROC404 - GT4-37149-013 G04 web).png",
        "credit": "NASA/JSC/Arizona State University",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Project_Gemini_Comes_to_Life_(LROC404_-_GT4-37149-013_G04_web).png"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.633,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 2.633,
          "end": 4.133,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.12,
      "end": 8.0,
      "text": "Pilots suffered extreme overheating without proper foot and body restraints.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Aldrin Gemini XII 5.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Aldrin_Gemini_XII_5.jpg"
      },
      "shots": [
        {
          "start": 4.133,
          "end": 8.0,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.0,
      "end": 11.72,
      "text": "NASA launched Gemini 12 in November 1966 to solve the problem.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Gemini 12 Liftoff Via Titan Launch Vehicle.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Gemini_12_Liftoff_Via_Titan_Launch_Vehicle.jpg"
      },
      "shots": [
        {
          "start": 8.0,
          "end": 11.733,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.72,
      "end": 14.72,
      "text": "Command pilot James Lovell and pilot Buzz Aldrin flew the mission.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PORTRAIT - GEMINI 12 PRIME CREW (s66-46952).jpg",
        "credit": "NASA Johnson Space Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PORTRAIT_-_GEMINI_12_PRIME_CREW_(s66-46952).jpg"
      },
      "shots": [
        {
          "start": 11.733,
          "end": 14.733,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.72,
      "end": 18.44,
      "text": "Aldrin trained for weightlessness inside an underwater neutral buoyancy pool.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "GEMINI-TITAN (GT)-12 - ASTRONAUT TRAINING - UNDERWATER - MD (s66-54934).jpg",
        "credit": "NASA Johnson Space Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:GEMINI-TITAN_(GT)-12_-_ASTRONAUT_TRAINING_-_UNDERWATER_-_MD_(s66-54934).jpg"
      },
      "shots": [
        {
          "start": 14.733,
          "end": 18.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.44,
      "end": 22.1,
      "text": "In orbit, he used custom foot restraints across three spacewalks.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Gemini 12 - Edwin Aldrin in open hatch of spacecraft during EVA.jpg",
        "credit": "NASA/Jim Lovell",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Gemini_12_-_Edwin_Aldrin_in_open_hatch_of_spacecraft_during_EVA.jpg"
      },
      "shots": [
        {
          "start": 18.433,
          "end": 22.1,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.1,
      "end": 25.98,
      "text": "His underwater pool training definitively conquered zero-gravity physical exhaustion.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Gemini XII EVA with Buzz Aldrin and the Earth in his visor's reflection.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Gemini_XII_EVA_with_Buzz_Aldrin_and_the_Earth_in_his_visor%27s_reflection.jpg"
      },
      "shots": [
        {
          "start": 22.1,
          "end": 25.967,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.98,
      "end": 30.285,
      "text": "His techniques proved human beings could safely work outside their spacecraft.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Project Gemini Comes to Life (LROC404 - GT4-37149-013 G04 web).png",
        "credit": "NASA/JSC/Arizona State University",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Project_Gemini_Comes_to_Life_(LROC404_-_GT4-37149-013_G04_web).png"
      },
      "shots": [
        {
          "start": 25.967,
          "end": 30.633,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
