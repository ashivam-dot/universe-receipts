  "beats": [
    {
      "start": 0.08,
      "end": 3.793,
      "text": "An asteroid sample was so huge it jammed its own lid.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "OSIRIS-REx Artist\u2019s conception.png",
        "credit": "NASA/GSFC",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:OSIRIS-REx_Artist%E2%80%99s_conception.png"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 1.5,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 1.5,
          "end": 3.8,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.793,
      "end": 11.338,
      "text": "In October 2020, NASA's OSIRIS-REx probe touched down on asteroid Bennu to collect a surface sample.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Significant Mission Milestones in OSIRIS-REx Journey to Bennu and Back (SVS14724 - OREX LANDING 3x3HYPERWALL 00031 print).jpg",
        "credit": "NASA's Scientific Visualization Studio - eMITS/Emme Watkins, ADNET Systems, Inc./Aaron E. Lepsch, NASA/GSFC/Rani Gran, eMITS/Jonathan North",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Significant_Mission_Milestones_in_OSIRIS-REx_Journey_to_Bennu_and_Back_(SVS14724_-_OREX_LANDING_3x3HYPERWALL_00031_print).jpg"
      },
      "shots": [
        {
          "start": 3.8,
          "end": 11.333,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.338,
      "end": 16.483,
      "text": "A burst of nitrogen gas stirred up material, but the probe scooped up way too much.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist's concept of OSIRIS-REx TAGSAM in operation.jpg",
        "credit": "NASA/Goddard Space Flight Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%27s_concept_of_OSIRIS-REx_TAGSAM_in_operation.jpg"
      },
      "shots": [
        {
          "start": 11.333,
          "end": 13.9,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 13.9,
          "end": 16.467,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.483,
      "end": 23.833,
      "text": "Large rocks jammed the collector's mylar lid open, letting precious asteroid dust drift away into space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "TAGSAM Sampler Head at Two Angles.png",
        "credit": "NASA/Goddard/University of Arizona",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:TAGSAM_Sampler_Head_at_Two_Angles.png"
      },
      "shots": [
        {
          "start": 16.467,
          "end": 23.833,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.833,
      "end": 30.603,
      "text": "Fearing more loss, mission controllers canceled a planned weighing spin and rushed to secure the harvest.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "KSC-20200119-PH-KLS01 0310 orig.jpg",
        "credit": "Kim Shiflett",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:KSC-20200119-PH-KLS01_0310_orig.jpg"
      },
      "shots": [
        {
          "start": 23.833,
          "end": 26.333,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 26.333,
          "end": 30.6,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 30.603,
      "end": 37.048,
      "text": "On October 27, they successfully stowed the leaking sampler head inside the return capsule.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Significant Mission Milestones in OSIRIS-REx Journey to Bennu and Back (SVS14724 - OREX STOWING HD 00011 print).jpg",
        "credit": "NASA's Scientific Visualization Studio - eMITS/Emme Watkins, ADNET Systems, Inc./Aaron E. Lepsch, NASA/GSFC/Rani Gran, eMITS/Jonathan North",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Significant_Mission_Milestones_in_OSIRIS-REx_Journey_to_Bennu_and_Back_(SVS14724_-_OREX_STOWING_HD_00011_print).jpg"
      },
      "shots": [
        {
          "start": 30.6,
          "end": 37.033,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 37.048,
      "end": 44.248,
      "text": "Despite the leak, they recovered 121.6 grams, over double the original mission goal.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "OSIRIS-REx Sample Trays (jsc2024e011609).tiff",
        "credit": "NASA Johnson Space Center / Erika Blumenfeld & Joseph Aebers",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:OSIRIS-REx_Sample_Trays_(jsc2024e011609).tiff"
      },
      "shots": [
        {
          "start": 37.033,
          "end": 40.667,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 40.667,
          "end": 44.233,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 44.248,
      "end": 48.077,
      "text": "This record-shattering haul nearly caused total mission failure.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "OSIRIS-REx Artist\u2019s conception.png",
        "credit": "NASA/GSFC",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:OSIRIS-REx_Artist%E2%80%99s_conception.png"
      },
      "shots": [
        {
          "start": 44.233,
          "end": 48.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
