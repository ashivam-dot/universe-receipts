    },
    {
      "start": 3.793,
      "end": 11.013,
      "text": "On October 20, 2020, the OSIRIS-REx probe touched down on asteroid Bennu to collect regolith.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist's concept of OSIRIS-REx TAGSAM in operation.jpg",
        "credit": "NASA/Goddard Space Flight Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%27s_concept_of_OSIRIS-REx_TAGSAM_in_operation.jpg"
      },
      "shots": [
        {
          "start": 3.8,
          "end": 8.533,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 8.533,
          "end": 11.0,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.013,
      "end": 16.908,
      "text": "Upon contact, a burst of nitrogen gas stirred up surface material into the sampler head.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "OsirisRexSpacecraftTripToAsteroidBennu.jpg",
        "credit": "NASA/Goddard/Chris Meaney",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:OsirisRexSpacecraftTripToAsteroidBennu.jpg"
      },
      "shots": [
        {
          "start": 11.0,
          "end": 16.9,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.908,
      "end": 23.208,
      "text": "The probe collected so much material that rocks jammed the sampler head's mylar flap open.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Significant Mission Milestones in OSIRIS-REx Journey to Bennu and Back (SVS14724 - OREX STOWING HD 00011 print).jpg",
        "credit": "NASA's Scientific Visualization Studio - eMITS/Emme Watkins, ADNET Systems, Inc./Aaron E. Lepsch, NASA/GSFC/Rani Gran, eMITS/Jonathan North",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Significant_Mission_Milestones_in_OSIRIS-REx_Journey_to_Bennu_and_Back_(SVS14724_-_OREX_STOWING_HD_00011_print).jpg"
      },
      "shots": [
        {
          "start": 16.9,
          "end": 23.2,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.208,
      "end": 28.903,
      "text": "Valuable asteroid dust began escaping and drifting away into the vacuum of space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Processing Bennu sample (53250789352).jpg",
        "credit": "NASA Goddard Photo and Video",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Processing_Bennu_sample_(53250789352).jpg"
      },
      "shots": [
        {
          "start": 23.2,
          "end": 26.267,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 26.267,
          "end": 28.9,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 28.903,
      "end": 34.698,
      "text": "Mission controllers canceled a spinning maneuver to weigh the sample and expedited stowing.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mission Control center of NASA.png",
        "credit": "SpaceX",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Mission_Control_center_of_NASA.png"
      },
      "shots": [
        {
          "start": 28.9,
          "end": 34.7,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 34.698,
      "end": 41.368,
      "text": "Despite the chaotic leak, the capsule brought home a record 121.6 grams of material.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "OSIRIS-REx Sample Trays (jsc2024e011609).tiff",
        "credit": "NASA Johnson Space Center / Erika Blumenfeld & Joseph Aebers",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:OSIRIS-REx_Sample_Trays_(jsc2024e011609).tiff"
      },
      "shots": [
        {
