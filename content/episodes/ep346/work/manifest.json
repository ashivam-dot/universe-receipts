{
  "id": "ep346",
  "duration": 25.597,
  "beats": [
    {
      "start": 0.08,
      "end": 3.4,
      "text": "A distant dying star exploded brightly enough to see.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hubble Pinpoints Record-Breaking Explosion (2008-17-2344).jpg",
        "credit": "NASA, ESA, N. Tanvir (University of Leicester), and A. Fruchter (STScI)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Hubble_Pinpoints_Record-Breaking_Explosion_(2008-17-2344).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.4,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.4,
      "end": 7.24,
      "text": "The flash came from 7.5 billion light-years away in the cosmos.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Paranal (paranal 10-nov1999).jpg",
        "credit": "ESO",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Paranal_(paranal_10-nov1999).jpg"
      },
      "shots": [
        {
          "start": 3.4,
          "end": 7.233,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.24,
      "end": 9.4,
      "text": "It beamed right from the constellation Bo\u00f6tes.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Bo\u00f6tes (Annotated) (bootes-ann).jpg",
        "credit": "E. Slawik/NOIRLab/NSF/AURA/M. Zamani",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Bo%C3%B6tes_(Annotated)_(bootes-ann).jpg"
      },
      "shots": [
        {
          "start": 7.233,
          "end": 9.4,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.4,
      "end": 13.36,
      "text": "For nearly a minute, it outshone ten million galaxies combined.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "SN 1998bw.jpg",
        "credit": "ESO",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:SN_1998bw.jpg"
      },
      "shots": [
        {
          "start": 9.4,
          "end": 13.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.36,
      "end": 18.96,
      "text": "This brightness came from a jet shooting at 99.99995 percent light speed.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "GRB artist NASA Zhang Woosley.jpg",
        "credit": "NASA/Zhang & Woosley",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:GRB_artist_NASA_Zhang_Woosley.jpg"
      },
      "shots": [
        {
          "start": 13.367,
          "end": 18.967,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.96,
      "end": 22.5,
      "text": "The cosmic blowtorch pointed directly down the barrel at Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The double firing burst (artist's impression) (eso0828a).jpg",
        "credit": "ESO",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:The_double_firing_burst_(artist%27s_impression)_(eso0828a).jpg"
      },
      "shots": [
        {
          "start": 18.967,
          "end": 22.5,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.5,
      "end": 25.247,
      "text": "That is why you could see a distant dying star explode.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hubble Pinpoints Record-Breaking Explosion (2008-17-2344).jpg",
        "credit": "NASA, ESA, N. Tanvir (University of Leicester), and A. Fruchter (STScI)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Hubble_Pinpoints_Record-Breaking_Explosion_(2008-17-2344).jpg"
      },
      "shots": [
        {
          "start": 22.5,
          "end": 25.6,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    }
  ],
