  "duration": 53.953,
  "beats": [
    {
      "start": 0.08,
      "end": 4.387,
      "text": "A cosmic giant crowned the biggest star in the universe suddenly shrank.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "New shot of UY Scuti, the former largest known star.png",
        "credit": "21.Andromedae",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:New_shot_of_UY_Scuti,_the_former_largest_known_star.png"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.933,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 2.933,
          "end": 4.4,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.387,
      "end": 11.632,
      "text": "Back in 1860, astronomers at the Bonn Observatory cataloged a faint star in the constellation Scutum.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Bad Godesberg P\u00e4dagogium Architektenzeichnung Neubau 1899.jpg",
        "credit": "Friedrich Schutte, Barmen (architect)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Bad_Godesberg_P%C3%A4dagogium_Architektenzeichnung_Neubau_1899.jpg"
      },
      "shots": [
        {
          "start": 4.4,
          "end": 11.633,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.632,
      "end": 20.077,
      "text": "Originally designated as BD-12 degrees 5055, its flickering brightness revealed a pulsating variable star.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Light curve of Cepheid variable star V1 (opo1115e).jpg",
        "credit": "Illustration Credit: NASA, ESA and Z. Levay (STScI). Science Credit: NASA, ESA, the Hubble Heritage Team (STScI/AURA) and the American Association of Variable Star Observers",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Light_curve_of_Cepheid_variable_star_V1_(opo1115e).jpg"
      },
      "shots": [
        {
          "start": 11.633,
          "end": 16.267,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 16.267,
          "end": 20.067,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.077,
      "end": 30.027,
      "text": "In 2012, Very Large Telescope interferometry in Chile calculated a staggering radius of 1,708 solar radii.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 20.067,
          "end": 30.033,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 30.027,
      "end": 36.747,
      "text": "This massive size crowned UY Scuti the largest known star, with a volume swallowing Jupiter's orbit.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "6 Hebe orbit.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:6_Hebe_orbit.jpg"
      },
      "shots": [
        {
          "start": 30.033,
          "end": 36.733,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 36.747,
      "end": 42.142,
      "text": "However, newer Gaia space telescope data revised its distance closer to Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Gaia optics.jpg",
        "credit": "Space Travel Blog / Rute Marta Jansone / Marie-Liis Aru",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Gaia_optics.jpg"
      },
      "shots": [
        {
          "start": 36.733,
          "end": 42.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 42.142,
      "end": 49.467,
      "text": "The updated measurements shrank its official radius down to approximately 909 solar radii.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Four largest known well-defined stars.png",
        "credit": "SpaceImplorerExplorerImplorer",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Four_largest_known_well-defined_stars.png"
      },
      "shots": [
        {
          "start": 42.133,
          "end": 49.467,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
