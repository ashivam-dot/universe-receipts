        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Capsule,_Stardust_-_DPLA_-_3faeac9c83571bc0354c2d838fdcf162_(page_4).jpg"
      },
      "shots": [
        {
          "start": 26.3,
          "end": 30.6,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 30.6,
