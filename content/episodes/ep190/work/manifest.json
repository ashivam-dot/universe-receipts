          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 7.967,
          "end": 10.667,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.672,
      "end": 18.192,
      "text": "To capture particles without destroying them on impact, engineers deployed a collector tray shaped like a tennis racket.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Stardust - Concepcao artistica.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Stardust_-_Concepcao_artistica.jpg"
