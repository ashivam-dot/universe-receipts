          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.192,
      "end": 26.312,
      "text": "In January 2004, the spacecraft swept past Comet Wild 2 to gently catch microscopic cosmic grains.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Wild2 3.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Wild2_3.jpg"
      },
      "shots": [
        {
          "start": 18.2,
          "end": 26.3,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 26.312,
      "end": 34.937,
      "text": "On January 15, 2006, its sample return capsule descended under parachutes directly into the Utah desert.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Capsule, Stardust - DPLA - 3faeac9c83571bc0354c2d838fdcf162 (page 4).jpg",
