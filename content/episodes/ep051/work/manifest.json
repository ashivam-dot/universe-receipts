{
  "id": "ep051",
  "duration": 51.3,
  "beats": [
    {
      "start": 0.08,
      "end": 5.229,
      "text": "A $264 million NASA spacecraft smashed into the desert.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Flying Saucer Crash Lands in Utah Desert (apod-2026-july-19-flying-saucer-crash-lands-in-utah-desert).jpg",
        "credit": "USAF 388th Range Sqd., Genesis Mission , NASA Authors & editors: Robert Nemiroff (MTU) & Jerry Bonnell (UMCP) A service of: ASD at NASA / GSFC, NASA Science Activation & Michigan Tech. U. Random APOD ",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Flying_Saucer_Crash_Lands_in_Utah_Desert_(apod-2026-july-19-flying-saucer-crash-lands-in-utah-desert).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 5.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 5.229,
      "end": 11.299,
      "text": "In 2001, Genesis launched to collect samples from 93 million miles away.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Delta II Genesis Launch.jpg",
        "credit": "NASA/KSC",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Delta_II_Genesis_Launch.jpg"
      },
      "shots": [
        {
          "start": 5.233,
          "end": 11.3,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.299,
      "end": 16.644,
      "text": "It spent three years orbiting the Sun to catch microscopic solar wind particles.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Genesis Spacecraft in Collection Phase During Solar Winds D2001 0712 S2.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Genesis_Spacecraft_in_Collection_Phase_During_Solar_Winds_D2001_0712_S2.jpg"
      },
      "shots": [
        {
          "start": 11.3,
          "end": 16.633,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.644,
      "end": 22.139,
      "text": "This was the first mission since Apollo to return physical samples from deep space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "GenSC collection2 150dpi.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:GenSC_collection2_150dpi.jpg"
      },
      "shots": [
        {
          "start": 16.633,
          "end": 22.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.139,
      "end": 29.514,
      "text": "But on September 8, 2004, the capsule hit the Utah sand at 193 miles per hour.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Genesis Capsule Reentry P50952.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Genesis_Capsule_Reentry_P50952.jpg"
      },
      "shots": [
        {
          "start": 22.133,
          "end": 29.5,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 29.514,
      "end": 34.809,
      "text": "The crash happened because four tiny gravity switches were installed upside down.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Genesis recovery 09.09.2004.jpg",
        "credit": "Unknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Genesis_recovery_09.09.2004.jpg"
      },
      "shots": [
        {
          "start": 29.5,
          "end": 34.8,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 34.809,
      "end": 40.029,
      "text": "They followed a flawed blueprint that prevented them from ever triggering the parachutes.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Genesis spacecraft.jpg",
        "credit": "NASA / JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Genesis_spacecraft.jpg"
      },
      "shots": [
        {
          "start": 34.8,
          "end": 37.4,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 37.4,
          "end": 40.033,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 40.029,
      "end": 44.799,
      "text": "Scientists still salvaged the mission, proving the Sun\u2019s chemistry is unique.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Magnificent CME Erupts on the Sun - August 31.jpg",
        "credit": "NASA Goddard Space Flight Center",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Magnificent_CME_Erupts_on_the_Sun_-_August_31.jpg"
      },
      "shots": [
        {
          "start": 40.033,
          "end": 44.8,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 44.799,
      "end": 50.95,
      "text": "That happened even though a $264 million NASA spacecraft smashed into the desert.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Flying Saucer Crash Lands in Utah Desert (apod-2026-july-19-flying-saucer-crash-lands-in-utah-desert).jpg",
