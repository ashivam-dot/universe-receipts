{
  "id": "ep254",
  "duration": 29.27,
  "beats": [
    {
      "start": 0.08,
      "end": 3.0,
      "text": "A tiny star is screaming out of our galaxy forever.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Runaway Stars Reveal Hidden Black Hole In Milky Way\u2019s Nearest Neighbor (Artist's impression).jpg",
        "credit": "CfA/Melissa Weiss",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Runaway_Stars_Reveal_Hidden_Black_Hole_In_Milky_Way%E2%80%99s_Nearest_Neighbor_(Artist%27s_impression).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 1.533,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 1.533,
          "end": 3.0,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.0,
      "end": 6.02,
      "text": "It is moving at about one million miles per hour.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hubble Observations Used to Measure Mass of Lone White Dwarf Star LAWD 37 (2023-004).tiff",
        "credit": "SCIENCE: NASA, ESA, Peter McGill (UC Santa Cruz, IoA), Kailash Sahu (STScI) IMAGE PROCESSING: Joseph DePasquale (STScI)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Hubble_Observations_Used_to_Measure_Mass_of_Lone_White_Dwarf_Star_LAWD_37_(2023-004).tiff"
      },
      "shots": [
        {
          "start": 3.0,
          "end": 6.033,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.02,
      "end": 9.54,
      "text": "Citizen scientists found this rogue object using NASA infrared data.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "WISE artist concept (PIA17254).jpg",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:WISE_artist_concept_(PIA17254).jpg"
      },
      "shots": [
        {
          "start": 6.033,
          "end": 9.533,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.54,
      "end": 12.48,
      "text": "Volunteers spotted it while hunting for a hidden ninth planet.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hypothetical Planet Nine (24420842591).png",
        "credit": "Kevin M. Gill",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Hypothetical_Planet_Nine_(24420842591).png"
      },
      "shots": [
        {
          "start": 9.533,
          "end": 11.533,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 11.533,
          "end": 12.467,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.48,
      "end": 16.22,
      "text": "This object is a rare, low-mass star called an L subdwarf.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "BrownDwarf-Illustration.jpg",
        "credit": "NOIRLab/NSF/AURA/J. da Silva",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:BrownDwarf-Illustration.jpg"
      },
      "shots": [
        {
          "start": 12.467,
          "end": 14.333,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 14.333,
          "end": 16.233,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.22,
      "end": 18.94,
      "text": "The speeder is only four hundred light-years away from Earth.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 16.233,
          "end": 18.933,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.94,
      "end": 22.02,
      "text": "One theory says an exploding white dwarf kicked it away.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Illustration of Alternate Trigger Mechanism (2010-type1a-more-2 - nolabel).jpg",
        "credit": "(Illustration: NASA/CXC/M.Weiss)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Illustration_of_Alternate_Trigger_Mechanism_(2010-type1a-more-2_-_nolabel).jpg"
      },
      "shots": [
        {
          "start": 18.933,
          "end": 20.133,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 20.133,
          "end": 22.033,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.02,
      "end": 25.36,
      "text": "Or binary black holes catapulted it like a cosmic slingshot.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "MergingBlackHoles V2.jpg",
        "credit": "NASA/Ames Research Center/C. Henze",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:MergingBlackHoles_V2.jpg"
      },
      "shots": [
        {
          "start": 22.033,
          "end": 25.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.36,
      "end": 28.92,
      "text": "This ancient relic is now on a one-way trip and it's never coming back.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Runaway Stars Reveal Hidden Black Hole In Milky Way\u2019s Nearest Neighbor (Artist's impression).jpg",
        "credit": "CfA/Melissa Weiss",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Runaway_Stars_Reveal_Hidden_Black_Hole_In_Milky_Way%E2%80%99s_Nearest_Neighbor_(Artist%27s_impression).jpg"
      },
      "shots": [
        {
          "start": 25.367,
          "end": 29.267,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
