  "beats": [
    {
      "start": 0.08,
      "end": 2.76,
      "text": "You could fall into a black hole without noticing.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Black Hole with Accretion Disk Visualization (SVS14619 - 2-Orbiting a black hole-HD 00001 print).jpg",
        "credit": "NASA's Scientific Visualization Studio - Caltech-IPAC/Robert Hurt, Caltech-IPAC/Keith Miller, NASA/JPL/Chelsea Gohd, Global Science and Technology, Inc./Ella Kaplan, NASA/GSFC/Mark SubbaRao",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Black_Hole_with_Accretion_Disk_Visualization_(SVS14619_-_2-Orbiting_a_black_hole-HD_00001_print).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.767,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 2.76,
      "end": 5.36,
      "text": "A black hole the size of a city would shred you.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Intermediate-Mass Black Hole with Torn-Apart Star (Artist\u2019s Impression).jpg",
        "credit": "ESA/Hubble, M. Kornmesser",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Intermediate-Mass_Black_Hole_with_Torn-Apart_Star_(Artist%E2%80%99s_Impression).jpg"
      },
      "shots": [
        {
          "start": 2.767,
          "end": 5.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 5.36,
      "end": 7.78,
      "text": "One with the mass of our Sun is just as deadly.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Comparison of several stellar black holes in our galaxy (eso2408b).tiff",
        "credit": "ESO/M. Kornmesser",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Comparison_of_several_stellar_black_holes_in_our_galaxy_(eso2408b).tiff"
      },
      "shots": [
        {
          "start": 5.367,
          "end": 7.767,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.78,
      "end": 10.38,
      "text": "Its point of no return is only about two miles wide.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Cosmical.Radii.png",
        "credit": "Bautsch",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Cosmical.Radii.png"
      },
      "shots": [
        {
          "start": 7.767,
          "end": 10.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.38,
      "end": 14.22,
      "text": "But supermassive black holes at galaxy centers are much gentler.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "EHT Sagittarius A black hole.tif",
        "credit": "EHT Collaboration",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:EHT_Sagittarius_A_black_hole.tif"
      },
      "shots": [
        {
          "start": 10.367,
          "end": 14.233,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.22,
      "end": 17.0,
      "text": "You'd glide across the point of no return in seconds.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Beyond the Brink- Tracking a Simulated Plunge into a Black Hole (SVS14585 - 1 BH Viz 20 rg 019c).jpg",
        "credit": "NASA's Scientific Visualization Studio - null",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Beyond_the_Brink-_Tracking_a_Simulated_Plunge_into_a_Black_Hole_(SVS14585_-_1_BH_Viz_20_rg_019c).jpg"
      },
      "shots": [
        {
          "start": 14.233,
          "end": 17.0,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.0,
      "end": 19.74,
      "text": "From the outside, your friends see you turn red and freeze.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Interstellar movie black hole with Doppler shift and gravitational redshift.jpg",
        "credit": "Oliver James, Eug\u00e9nie von Tunzelmann, Paul Franklin and Kip S Thorne",
        "license": "CC BY 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:Interstellar_movie_black_hole_with_Doppler_shift_and_gravitational_redshift.jpg"
      },
      "shots": [
        {
          "start": 17.0,
          "end": 19.733,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.74,
      "end": 24.16,
      "text": "Physicists Albert Einstein and Karl Schwarzschild solved the math in 1916.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Karl schwarzschild.portrait.jpg",
        "credit": "Not mentioned",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Karl_schwarzschild.portrait.jpg"
      },
      "shots": [
        {
          "start": 19.733,
          "end": 24.167,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.16,
      "end": 27.047,
      "text": "Gravity is so smooth there that everything seems fine.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Black Hole with Accretion Disk Visualization (SVS14619 - 2-Orbiting a black hole-HD 00001 print).jpg",
        "credit": "NASA's Scientific Visualization Studio - Caltech-IPAC/Robert Hurt, Caltech-IPAC/Keith Miller, NASA/JPL/Chelsea Gohd, Global Science and Technology, Inc./Ella Kaplan, NASA/GSFC/Mark SubbaRao",
