{
  "id": "ep148",
  "duration": 45.873,
  "beats": [
    {
      "start": 0.08,
      "end": 3.352,
      "text": "Voyager 1 was only built to last five years.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NASA\u2019s Voyager Probe Speeds Through Space (Artist\u2019s Concept) (PIA26353).tiff",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:NASA%E2%80%99s_Voyager_Probe_Speeds_Through_Space_(Artist%E2%80%99s_Concept)_(PIA26353).tiff"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.352,
      "end": 9.822,
      "text": "Launched on September 5, 1977, the probe was designed for a short tour of the planets.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Titan 3E with Voyager 1.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Titan_3E_with_Voyager_1.jpg"
      },
      "shots": [
        {
          "start": 3.367,
          "end": 6.6,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 6.6,
          "end": 9.833,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.822,
      "end": 15.742,
      "text": "Voyager 1 found active volcanoes on Io and strange spokes in Saturn\u2019s rings.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Vulcanic Explosion on Io.jpg",
        "credit": "Unknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Vulcanic_Explosion_on_Io.jpg"
      },
      "shots": [
        {
          "start": 9.833,
          "end": 15.733,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.742,
      "end": 21.962,
      "text": "Instead of shutting down, the spacecraft reached interstellar space in 2012 and kept going.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyager spacecraft.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Voyager_spacecraft.jpg"
      },
      "shots": [
        {
          "start": 15.733,
          "end": 18.567,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 18.567,
          "end": 21.967,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.962,
      "end": 28.107,
      "text": "Now 15 billion miles away, signals take over 23 hours to travel back to Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Goldstone\u2019s 70-Meter Antenna Under the Stars (PIA26716).png",
        "credit": "NASA Jet Propulsion Laboratory / NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Goldstone%E2%80%99s_70-Meter_Antenna_Under_the_Stars_(PIA26716).png"
      },
      "shots": [
        {
          "start": 21.967,
          "end": 28.1,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 28.107,
      "end": 33.682,
      "text": "By 2026, it will finally go dark as its last two instruments fail.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyager with descriptions.png",
        "credit": "Photographer: N/A",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Voyager_with_descriptions.png"
      },
      "shots": [
        {
          "start": 28.1,
          "end": 30.067,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 30.067,
          "end": 33.667,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 33.682,
      "end": 40.527,
      "text": "Engineers manage this distance using computers with a total memory of only 68 kilobytes.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The Sounds of Earth - GPN-2000-001976.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:The_Sounds_of_Earth_-_GPN-2000-001976.jpg"
      },
      "shots": [
        {
          "start": 33.667,
          "end": 37.267,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 37.267,
          "end": 40.533,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 40.527,
      "end": 45.523,
      "text": "It remains an immortal messenger that continues to defy its original design.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NASA\u2019s Voyager Probe Speeds Through Space (Artist\u2019s Concept) (PIA26353).tiff",
        "credit": "NASA/JPL-Caltech",
