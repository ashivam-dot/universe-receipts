{
  "id": "ep148",
  "duration": 51.72,
  "beats": [
    {
      "start": 0.08,
      "end": 2.463,
      "text": "It was only built to last five years.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyager spacecraft.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Voyager_spacecraft.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.467,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 2.463,
      "end": 11.308,
      "text": "Launched on September 5, 1977, the legendary metal probe quickly became the most distant human-made object from Earth.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 2.467,
          "end": 11.3,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.308,
      "end": 20.603,
      "text": "Voyager 1 discovered active volcanoes on Jupiter's moon Io and revealed astonishingly complex structures across Saturn's rings.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA01081-Color Mosaic and Active Volcanic Plumes on Io.jpg",
        "credit": "NASA's Galileo spacecraft",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA01081-Color_Mosaic_and_Active_Volcanic_Plumes_on_Io.jpg"
      },
      "shots": [
        {
          "start": 11.3,
          "end": 20.6,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.603,
      "end": 29.928,
      "text": "The durable spacecraft officially entered interstellar space in August 2012, while blazing along at 38,000 miles per hour.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA12375.jpg",
        "credit": "NASA/JPL/JHUAPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA12375.jpg"
      },
      "shots": [
        {
          "start": 20.6,
          "end": 27.067,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 27.067,
          "end": 29.933,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 29.928,
      "end": 38.848,
      "text": "Now pushing past 15 billion miles away, harried human engineers are shutting down its remaining scientific instruments one by one.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 29.933,
          "end": 38.833,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 38.848,
      "end": 47.618,
      "text": "As of 2026, only two fragile science instruments remain fully operational as it sails through the frozen cosmic void.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyager Program - High-gain antenna diagram.png",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Voyager_Program_-_High-gain_antenna_diagram.png"
      },
      "shots": [
        {
          "start": 38.833,
          "end": 47.633,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 47.618,
      "end": 51.37,
      "text": "And to think, when this probe launched back in 1977,",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyager spacecraft.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Voyager_spacecraft.jpg"
      },
      "shots": [
        {
          "start": 47.633,
          "end": 51.733,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
