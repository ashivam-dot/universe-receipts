{
  "id": "ep194",
  "duration": 60.921,
  "beats": [
    {
      "start": 0.08,
      "end": 6.285,
      "text": "A one-hundred-twenty-five-million-dollar orbiter vanished because engineers forgot to convert units.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mars Climate Orbiter 2.jpg",
        "credit": "NASA/JPL/Corby Waste",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Mars_Climate_Orbiter_2.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.133,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 3.133,
          "end": 6.3,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.285,
      "end": 13.955,
      "text": "After a nine-month journey, the Mars Climate Orbiter prepared for orbital insertion in September 1999.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mars Polar Lander - interplanetary trajectory.png",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Mars_Polar_Lander_-_interplanetary_trajectory.png"
      },
      "shots": [
        {
          "start": 6.3,
          "end": 13.967,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.955,
      "end": 19.55,
      "text": "Communication with the probe was permanently lost as navigators searched for answers.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Deep-space-op.jpg",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Deep-space-op.jpg"
      },
      "shots": [
        {
          "start": 13.967,
          "end": 15.967,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 15.967,
          "end": 19.533,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.55,
      "end": 26.095,
      "text": "An investigation revealed builder Lockheed Martin supplied impulse data in pound-force seconds.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Lockheed Martin Office, Colorado Springs (54557169938).jpg",
        "credit": "Lumen Wilde",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Lockheed_Martin_Office,_Colorado_Springs_(54557169938).jpg"
      },
      "shots": [
        {
          "start": 19.533,
          "end": 22.233,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 22.233,
          "end": 26.1,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 26.095,
      "end": 33.365,
      "text": "Meanwhile, NASA's navigation software in California expected all incoming metrics in newton-seconds.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Spacecraft Assembly Room @ JPL (19322114182).jpg",
        "credit": "Kevin Gill from Los Angeles, CA, United States",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Spacecraft_Assembly_Room_@_JPL_(19322114182).jpg"
      },
      "shots": [
        {
          "start": 26.1,
          "end": 29.733,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 29.733,
          "end": 33.367,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 33.365,
      "end": 40.985,
      "text": "One pound-force is equal to four point four five newtons, multiplying small thruster forces into a fatal error.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Juno Main Engine Firing.jpg",
        "credit": "Produced By: JPL , Image Credit: NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Juno_Main_Engine_Firing.jpg"
      },
      "shots": [
        {
          "start": 33.367,
          "end": 41.0,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 40.985,
      "end": 47.335,
      "text": "This mismatch plunged the spacecraft down to an altitude of only fifty-seven kilometers.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mars Climate Orbiter - mishap diagram.png",
        "credit": "Xession",
        "license": "CC BY 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:Mars_Climate_Orbiter_-_mishap_diagram.png"
      },
      "shots": [
        {
          "start": 41.0,
          "end": 47.333,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 47.335,
      "end": 53.955,
      "text": "Surpassing eighty kilometers was the minimum survival altitude before the orbiter was destroyed.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mars-polar-lander front.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Mars-polar-lander_front.jpg"
      },
      "shots": [
        {
          "start": 47.333,
          "end": 50.667,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 50.667,
          "end": 53.967,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 53.955,
      "end": 60.571,
      "text": "Engineers forgot simple unit conversions, meaning a one-hundred-twenty-five-million-dollar orbiter vanished.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mars Climate Orbiter 2.jpg",
        "credit": "NASA/JPL/Corby Waste",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Mars_Climate_Orbiter_2.jpg"
      },
      "shots": [
        {
          "start": 53.967,
          "end": 60.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
