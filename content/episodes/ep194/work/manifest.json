{
  "id": "ep194",
  "duration": 57.378,
  "beats": [
    {
      "start": 0.08,
      "end": 5.995,
      "text": "A 125-million-dollar NASA orbiter vanished behind Mars without a trace.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mars Climate Orbiter - artist depiction - climate-orbiter-browse.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Mars_Climate_Orbiter_-_artist_depiction_-_climate-orbiter-browse.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.3,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 3.3,
          "end": 6.0,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 5.995,
      "end": 12.89,
      "text": "In September 1999, the spacecraft fired its engine to enter orbit after a nine-month voyage.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mars Climate Orbiter - interplanetary trajectory.png",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Mars_Climate_Orbiter_-_interplanetary_trajectory.png"
      },
      "shots": [
        {
          "start": 6.0,
          "end": 12.9,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.89,
      "end": 18.26,
      "text": "It slipped behind the red planet as planned, but its radio signal never returned.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Deep-space-op.jpg",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Deep-space-op.jpg"
      },
      "shots": [
        {
          "start": 12.9,
          "end": 15.6,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 15.6,
          "end": 18.267,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.26,
      "end": 24.28,
      "text": "Tracking data revealed the probe had plunged to an altitude of just fifty-seven kilometers.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mars Climate Orbiter - mishap diagram.png",
        "credit": "Xession",
        "license": "CC BY 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:Mars_Climate_Orbiter_-_mishap_diagram.png"
      },
      "shots": [
        {
          "start": 18.267,
          "end": 24.267,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.28,
      "end": 31.175,
      "text": "Its minimum survival altitude was 80 kilometers, leaving the probe incinerated in the atmosphere.",
      "asset": {
        "source": "Flickr via Openverse",
        "title": "Mars - Over Gale Crater",
        "credit": "Kevin M. Gill",
        "license": "CC BY 2.0",
        "url": "https://www.flickr.com/photos/53460575@N03/45991611011"
      },
      "shots": [
        {
          "start": 24.267,
          "end": 31.167,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 31.175,
      "end": 37.345,
      "text": "Investigators traced the catastrophe to thruster software shared between two distant teams.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mars Climate Orbiter - spacecraft diagram.png",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Mars_Climate_Orbiter_-_spacecraft_diagram.png"
      },
      "shots": [
        {
          "start": 31.167,
          "end": 37.333,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 37.345,
      "end": 43.84,
      "text": "Lockheed Martin in Colorado calculated thruster impulse using imperial pound-force seconds.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Lockheed Martin Office, Colorado Springs (54557169938).jpg",
        "credit": "Lumen Wilde",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Lockheed_Martin_Office,_Colorado_Springs_(54557169938).jpg"
      },
      "shots": [
        {
          "start": 37.333,
          "end": 40.6,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 40.6,
          "end": 43.833,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 43.84,
      "end": 51.165,
      "text": "NASA navigators in California expected metric newtons, a difference of four point four five times.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mission Control- Floor Level (49386802568).png",
        "credit": "NASAJPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Mission_Control-_Floor_Level_(49386802568).png"
      },
      "shots": [
        {
          "start": 43.833,
          "end": 51.167,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 51.165,
      "end": 57.028,
      "text": "Two engineering teams forgot to convert basic units before sending their craft into the dark.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mars Climate Orbiter - artist depiction - climate-orbiter-browse.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Mars_Climate_Orbiter_-_artist_depiction_-_climate-orbiter-browse.jpg"
      },
      "shots": [
        {
          "start": 51.167,
          "end": 57.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
