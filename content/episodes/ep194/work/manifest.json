{
  "id": "ep194",
  "duration": 53.533,
  "beats": [
    {
      "start": 0.08,
      "end": 5.57,
      "text": "A 125-million-dollar orbiter vanished because of a simple unit error.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mars Climate Orbiter 2.jpg",
        "credit": "NASA/JPL/Corby Waste",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Mars_Climate_Orbiter_2.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.8,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 2.8,
          "end": 5.567,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 5.57,
      "end": 10.44,
      "text": "Launched in 1998, the probe spent nine months traveling to Mars.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Delta II 7425 carrying Mars Climate Orbiter (KSC-98PC-1837).jpg",
        "credit": "NASA/KSC",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Delta_II_7425_carrying_Mars_Climate_Orbiter_(KSC-98PC-1837).jpg"
      },
      "shots": [
        {
          "start": 5.567,
          "end": 10.433,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.44,
      "end": 16.56,
      "text": "In September 1999, the probe reached its destination and prepared to enter orbit.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 10.433,
          "end": 16.567,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.56,
      "end": 22.255,
      "text": "But instead of sliding into a safe path, the spacecraft went silent and never called home.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Deep-space-op.jpg",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Deep-space-op.jpg"
      },
      "shots": [
        {
          "start": 16.567,
          "end": 19.8,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 19.8,
          "end": 22.267,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.255,
      "end": 28.475,
      "text": "Investigators found a lethal software conflict between NASA and the builder, Lockheed Martin.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Lockheed Martin Office, Colorado Springs (54557169938).jpg",
        "credit": "Lumen Wilde",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Lockheed_Martin_Office,_Colorado_Springs_(54557169938).jpg"
      },
      "shots": [
        {
          "start": 22.267,
          "end": 25.367,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 25.367,
          "end": 28.467,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 28.475,
      "end": 35.645,
      "text": "One team used metric newtons while the other used imperial pounds, a four point four five times difference.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 28.467,
          "end": 35.633,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 35.645,
      "end": 42.72,
      "text": "This math error steered the probe into the Martian atmosphere at an altitude of just fifty-seven kilometers.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mars Climate Orbiter - mishap diagram.png",
        "credit": "Xession",
        "license": "CC BY 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:Mars_Climate_Orbiter_-_mishap_diagram.png"
      },
      "shots": [
        {
          "start": 35.633,
          "end": 42.733,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 42.72,
      "end": 48.265,
      "text": "Dropping below 80 kilometers destroyed the orbiter; that was the survival limit.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Impactor Debris Scattered Within Mars\u2019 Mantle (Artist\u2019s Concept) (PIA26636).tiff",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Impactor_Debris_Scattered_Within_Mars%E2%80%99_Mantle_(Artist%E2%80%99s_Concept)_(PIA26636).tiff"
      },
      "shots": [
        {
          "start": 42.733,
          "end": 45.5,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 45.5,
          "end": 48.267,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 48.265,
      "end": 53.183,
      "text": "A simple unit error meant a 125-million-dollar orbiter vanished.",
