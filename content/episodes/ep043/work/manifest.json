  "beats": [
    {
      "start": 0.08,
      "end": 3.83,
      "text": "Billions of starless rogue planets drift through total darkness.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Alone in Space - Astronomers Find New Kind of Planet.jpg",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Alone_in_Space_-_Astronomers_Find_New_Kind_of_Planet.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.833,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.83,
      "end": 10.075,
      "text": "These strange worlds roam across the vast expanse of the Milky Way galaxy entirely alone.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "ESO - Milky Way.jpg",
        "credit": "ESO/S. Brunier",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:ESO_-_Milky_Way.jpg"
      },
      "shots": [
        {
          "start": 3.833,
          "end": 6.933,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 6.933,
          "end": 10.067,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.075,
      "end": 15.245,
      "text": "Free-floating planetary masses are not bound to any star or brown dwarf.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Orion Nebula - Hubble 2006 mosaic 18000.jpg",
        "credit": "NASA, ESA, M. Robberto (Space Telescope Science Institute/ESA) and the Hubble Space Telescope Orion Treasury Project Team",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Orion_Nebula_-_Hubble_2006_mosaic_18000.jpg"
      },
      "shots": [
        {
          "start": 10.067,
          "end": 12.4,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 12.4,
          "end": 15.233,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.245,
      "end": 21.74,
      "text": "Some form on their own within stellar nurseries, while others are violently ejected from natal systems.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist Concept Planetary System.jpg",
        "credit": "NASA\n\nLater versions were uploaded by WilyD at en.wikipedia.",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Artist_Concept_Planetary_System.jpg"
      },
      "shots": [
        {
          "start": 15.233,
          "end": 19.1,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 19.1,
          "end": 21.733,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.74,
      "end": 28.165,
      "text": "In December twenty twenty-one, astronomers found a group of up to one hundred seventy rogue planets.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "VLT Laser Guide Star.jpg",
        "credit": "ESO/G. H\u00fcdepohl (www.atacamaphoto.com)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:VLT_Laser_Guide_Star.jpg"
      },
      "shots": [
        {
          "start": 21.733,
          "end": 25.6,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 25.6,
          "end": 28.167,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 28.165,
      "end": 38.04,
      "text": "In September twenty twenty, astronomers reported the detection of an Earth-mass rogue planet named OGLE-2016-BLG-1928.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Gravitational microlensing by black hole (Illustration) (opo0003f).jpg",
        "credit": "NASA/ESA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Gravitational_microlensing_by_black_hole_(Illustration)_(opo0003f).jpg"
      },
      "shots": [
        {
          "start": 28.167,
          "end": 38.033,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 38.04,
      "end": 44.235,
      "text": "NASA's Nancy Grace Roman Space Telescope will use microlensing to reveal hundreds more.",
