{
  "id": "ep381",
  "duration": 31.044,
  "beats": [
    {
      "start": 0.08,
      "end": 3.18,
      "text": "Hand-woven wire computers steered the first men to the Moon.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "CHM Artifacts Apollo Guidance Computer (4063525954).jpg",
        "credit": "Marcin Wichary from San Francisco, Calif.",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:CHM_Artifacts_Apollo_Guidance_Computer_(4063525954).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.167,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.18,
      "end": 6.52,
      "text": "This machine was built by weaving copper through magnetic rings.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "16Kb Rope Core Memory Board from Wagner WAC-40.jpg",
        "credit": "Richstraka",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:16Kb_Rope_Core_Memory_Board_from_Wagner_WAC-40.jpg"
      },
      "shots": [
        {
          "start": 3.167,
          "end": 6.533,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.52,
      "end": 8.76,
      "text": "Margaret Hamilton called this \"core rope memory.\"",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Margaret Hamilton 1989.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Margaret_Hamilton_1989.jpg"
      },
      "shots": [
        {
          "start": 6.533,
          "end": 8.767,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.76,
      "end": 12.44,
      "text": "It held just thirty-six kilowords of code, all knitted by hand.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Agc rope.jpg",
        "credit": "The original uploader was Grabert at German Wikipedia.",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Agc_rope.jpg"
      },
      "shots": [
        {
          "start": 8.767,
          "end": 12.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.44,
      "end": 15.76,
      "text": "The computer triggered emergency alarms during the 1969 landing.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Apollo DSKY from CM Simulator (6378253427).jpg",
        "credit": "Steve Jurvetson from Los Altos, USA",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Apollo_DSKY_from_CM_Simulator_(6378253427).jpg"
      },
      "shots": [
        {
          "start": 12.433,
          "end": 15.767,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.76,
      "end": 18.52,
      "text": "Spurious radar signals were flooding the tiny system with data.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Early LEM Lunar Excursion Module (LRC-1964-B701 P-11511).tiff",
        "credit": "NASA Langley Research Center / NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Early_LEM_Lunar_Excursion_Module_(LRC-1964-B701_P-11511).tiff"
      },
      "shots": [
        {
          "start": 15.767,
          "end": 18.533,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.52,
      "end": 21.2,
      "text": "But Hamilton\u2019s software knew exactly what to ignore.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 18.533,
          "end": 21.2,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.2,
      "end": 23.92,
      "text": "It dumped low-priority tasks to keep the engine firing.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "LUNAR LANDING - ART CONCEPT (S69-33765).jpg",
        "credit": "NASA Johnson Space Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:LUNAR_LANDING_-_ART_CONCEPT_(S69-33765).jpg"
      },
      "shots": [
        {
          "start": 21.2,
          "end": 23.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.92,
      "end": 26.72,
      "text": "This \"fourth astronaut\" saved the mission from crashing.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "AS11-40-5962 - Apollo 11 - Apollo 11 Mission image - Lunar Module at Tranquility Base - NARA - 16685323.jpg",
        "credit": "Unknown authorUnknown author or not provided",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:AS11-40-5962_-_Apollo_11_-_Apollo_11_Mission_image_-_Lunar_Module_at_Tranquility_Base_-_NARA_-_16685323.jpg"
      },
      "shots": [
        {
          "start": 23.933,
          "end": 26.733,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 26.72,
      "end": 30.694,
      "text": "That\u2019s how hand-woven wire computers steered the first men to the Moon.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "CHM Artifacts Apollo Guidance Computer (4063525954).jpg",
        "credit": "Marcin Wichary from San Francisco, Calif.",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:CHM_Artifacts_Apollo_Guidance_Computer_(4063525954).jpg"
      },
      "shots": [
        {
          "start": 26.733,
          "end": 31.033,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    }
