{
  "id": "ep258",
  "duration": 27.197,
  "beats": [
    {
      "start": 0.08,
      "end": 3.46,
      "text": "Galileo thought Saturn grew two giant ears.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Galileo.arp.300pix.jpg",
        "credit": "Justus Sustermans",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Galileo.arp.300pix.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.067,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 2.067,
          "end": 3.467,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.46,
      "end": 6.0,
      "text": "His weak telescope couldn't resolve the planet's rings.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Saturnuksen renkaat.jpg",
        "credit": "NASA, ESA, CSA, STScI, M. Tiscareno (SETI Institute), M. Hedman (University of Idaho), M. El Moutamid (Cornell University), M. Showalter (SETI Institute), L. Fletcher (University of Leicester), H. Ham",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Saturnuksen_renkaat.jpg"
      },
      "shots": [
        {
          "start": 3.467,
          "end": 6.0,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.0,
      "end": 9.28,
      "text": "Two years later, the strange lobes vanished completely.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Saturn's Rings Edge-on (1995-31-320).jpg",
        "credit": "Credit: Phil Nicholson (Cornell University) and NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Saturn%27s_Rings_Edge-on_(1995-31-320).jpg"
      },
      "shots": [
        {
          "start": 6.0,
          "end": 9.267,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.28,
      "end": 12.62,
      "text": "Earth had crossed the ring plane, turning them razor-thin.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Astronomy for the use of schools and academies (1882) (14764327275).jpg",
        "credit": "Internet Archive Book Images",
        "license": "No restrictions",
        "url": "https://commons.wikimedia.org/wiki/File:Astronomy_for_the_use_of_schools_and_academies_(1882)_(14764327275).jpg"
      },
      "shots": [
        {
          "start": 9.267,
          "end": 12.633,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.62,
      "end": 15.58,
      "text": "These structures are mostly tiny bits of pure water ice.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA02227~orig.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA02227~orig.jpg"
      },
      "shots": [
        {
          "start": 12.633,
          "end": 15.567,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.58,
      "end": 18.54,
      "text": "Physicists proved a solid ring would shatter into pieces.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "James Clerk Maxwell gravure.jpg",
        "credit": "Gravure of engraving by Stodart based on photograph by Fergus.",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:James_Clerk_Maxwell_gravure.jpg"
      },
      "shots": [
        {
          "start": 15.567,
          "end": 17.3,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 17.3,
          "end": 18.533,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.54,
      "end": 21.56,
      "text": "NASA's Cassini probe revealed the rings are remarkably young.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA21439 - Cassini Grand Finale Dive (Illustration).jpg",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA21439_-_Cassini_Grand_Finale_Dive_(Illustration).jpg"
      },
      "shots": [
        {
          "start": 18.533,
          "end": 21.567,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.56,
      "end": 23.98,
      "text": "They only formed up to one hundred million years ago.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA17172 Saturn eclipse mosaic bright crop (cropped).jpg",
        "credit": "NASA / JPL-Caltech / Space Science Institute",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA17172_Saturn_eclipse_mosaic_bright_crop_(cropped).jpg"
      },
      "shots": [
        {
          "start": 21.567,
          "end": 23.967,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.98,
      "end": 26.846,
      "text": "Dinosaurs walked Earth long before Saturn had ears.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Galileo.arp.300pix.jpg",
        "credit": "Justus Sustermans",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Galileo.arp.300pix.jpg"
      },
      "shots": [
        {
          "start": 23.967,
          "end": 27.2,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    }
  ],
