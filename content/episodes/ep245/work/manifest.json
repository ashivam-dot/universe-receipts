{
  "id": "ep245",
  "duration": 49.435,
  "beats": [
    {
      "start": 0.08,
      "end": 3.318,
      "text": "This planet is darker than asphalt and glows red.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist\u2019s View of Extrasolar Planet WASP-12b 01.tif",
        "credit": "NASA, ESA, and G. Bacon (STScI)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%E2%80%99s_View_of_Extrasolar_Planet_WASP-12b_01.tif"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.333,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.318,
      "end": 10.963,
      "text": "Discovered in 2008, the hot Jupiter known as WASP-12b whips around its star in roughly twenty-six hours.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Forecasting Weather on Distant Worlds.jpg",
        "credit": "NASA/JPL-Caltech/R. Hurt (SSC)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Forecasting_Weather_on_Distant_Worlds.jpg"
      },
      "shots": [
        {
          "start": 3.333,
          "end": 8.667,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 8.667,
          "end": 10.967,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.963,
      "end": 17.108,
      "text": "The exoplanet orbits just two million miles from its host, locking one side in permanent day.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Light Curve of a Planet Transiting Its Star.jpg",
        "credit": "NASA Ames",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Light_Curve_of_a_Planet_Transiting_Its_Star.jpg"
      },
      "shots": [
        {
          "start": 10.967,
          "end": 17.1,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.108,
      "end": 22.503,
      "text": "Enormous tidal forces have stretched this swollen world into a distorted egg shape.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Portrait of Jupiter from Cassini.jpg",
        "credit": "NASA/JPL/Space Science Institute",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Portrait_of_Jupiter_from_Cassini.jpg"
      },
      "shots": [
        {
          "start": 17.1,
          "end": 22.5,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.503,
      "end": 30.498,
      "text": "Dayside temperatures soar to over forty-six hundred degrees Fahrenheit, thermalizing the atmosphere so no clouds can form.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 22.5,
          "end": 30.5,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 30.498,
      "end": 36.468,
      "text": "Hubble observations revealed that its superheated gas is actively spilling onto the star.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hubble Space Telescope Grappled by Shuttle Arm (27512134324).jpg",
        "credit": "NASA Hubble Space Telescope",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Hubble_Space_Telescope_Grappled_by_Shuttle_Arm_(27512134324).jpg"
      },
      "shots": [
        {
          "start": 30.5,
          "end": 34.667,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 34.667,
          "end": 36.467,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 36.468,
      "end": 42.688,
      "text": "Tidal friction is draining its orbital energy, shrinking its year by milliseconds annually.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Roque de los Muchachos Observatory at La Palma (lapalma summit rnh1).jpg",
        "credit": "ESO/R. Hook",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Roque_de_los_Muchachos_Observatory_at_La_Palma_(lapalma_summit_rnh1).jpg"
      },
      "shots": [
        {
          "start": 36.467,
          "end": 42.7,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 42.688,
      "end": 49.085,
      "text": "Locked in an irreversible death spiral, this pitch-black world has only about three million years left.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist\u2019s View of Extrasolar Planet WASP-12b 01.tif",
        "credit": "NASA, ESA, and G. Bacon (STScI)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%E2%80%99s_View_of_Extrasolar_Planet_WASP-12b_01.tif"
      },
      "shots": [
        {
          "start": 42.7,
          "end": 49.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
