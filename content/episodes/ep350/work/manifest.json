{
  "id": "ep350",
  "duration": 34.994,
  "beats": [
    {
      "start": 0.08,
      "end": 4.8,
      "text": "Three exhausted astronauts accidentally vanished from NASA\u2019s radio.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Skylab 4 suited crew portrait.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Skylab_4_suited_crew_portrait.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.8,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 2.8,
          "end": 4.8,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.8,
      "end": 8.58,
      "text": "This all-rookie crew faced a brutal, minute-by-minute schedule.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Saturn IB Launch.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Saturn_IB_Launch.jpg"
      },
      "shots": [
        {
          "start": 4.8,
          "end": 8.567,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.58,
      "end": 11.4,
      "text": "They fell hours behind while struggling to sleep.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Gibson przy ATM.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Gibson_przy_ATM.jpg"
      },
      "shots": [
        {
          "start": 8.567,
          "end": 11.4,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.4,
      "end": 14.64,
      "text": "The tired men accidentally missed a briefing on Skylab.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Skylab (7449819).jpg",
        "credit": "NASA Marshall Space Flight Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Skylab_(7449819).jpg"
      },
      "shots": [
        {
          "start": 11.4,
          "end": 14.633,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.64,
      "end": 18.12,
      "text": "They spent 90 minutes circling Earth in total silence.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Comet Kohoutek (S73-38731).jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Comet_Kohoutek_(S73-38731).jpg"
      },
      "shots": [
        {
          "start": 14.633,
          "end": 18.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.12,
      "end": 21.44,
      "text": "Headlines soon claimed the crew had staged a space mutiny.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "20180320 Apollo 12 Virginia Air and Space Center-2.jpg",
        "credit": "Balon Greyjoy",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:20180320_Apollo_12_Virginia_Air_and_Space_Center-2.jpg"
      },
      "shots": [
        {
          "start": 18.133,
          "end": 21.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.44,
      "end": 25.3,
      "text": "In truth, no strike or intentional revolt ever happened.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "SKYLAB (SL) - ORBITAL WORKSHOP (OWS) - JSC (S73-26849).jpg",
        "credit": "NASA Johnson Space Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:SKYLAB_(SL)_-_ORBITAL_WORKSHOP_(OWS)_-_JSC_(S73-26849).jpg"
      },
      "shots": [
        {
          "start": 21.433,
          "end": 25.3,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.3,
      "end": 28.62,
      "text": "NASA relaxed the schedule for their record 84-day mission.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Skylab 4 - command service module.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Skylab_4_-_command_service_module.jpg"
      },
      "shots": [
        {
          "start": 25.3,
          "end": 28.633,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 28.62,
      "end": 31.3,
      "text": "Yet none of those three men ever flew again.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Skylab 4.tif",
        "credit": "Balon Greyjoy",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Skylab_4.tif"
      },
      "shots": [
        {
          "start": 28.633,
          "end": 31.3,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 31.3,
      "end": 34.644,
      "text": "That legend began when three astronauts vanished from the radio.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Skylab 4 suited crew portrait.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Skylab_4_suited_crew_portrait.jpg"
      },
      "shots": [
        {
          "start": 31.3,
          "end": 35.0,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
