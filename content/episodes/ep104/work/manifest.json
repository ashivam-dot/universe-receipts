  "beats": [
    {
      "start": 0.08,
      "end": 3.431,
      "text": "A pitch-black planet is being eaten alive by its star.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Star Devouring a Planet (2010-15-2725).jpg",
        "credit": "Artwork: , , and G. Bacon (); Science: , , and C. Haswell (The Open University, UK)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Star_Devouring_a_Planet_(2010-15-2725).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.431,
      "end": 10.676,
      "text": "Discovered in 2008, WASP-12b is a hot Jupiter orbiting its star every one point one days.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hot Jupiter exoplanet in the star cluster Messier 67 (eso1621a).tiff",
        "credit": "ESO/L. Cal\u00e7ada",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Hot_Jupiter_exoplanet_in_the_star_cluster_Messier_67_(eso1621a).tiff"
      },
      "shots": [
        {
          "start": 3.433,
          "end": 6.767,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 6.767,
          "end": 10.667,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.676,
      "end": 15.496,
      "text": "The planet sits just two million miles away, locked in a permanent dayside.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Illustration (Artist\u2019s Impression) of WASP-39 b and Its Star (weic2221a).jpeg",
        "credit": "NASA, ESA, CSA, J. Olmsted (STScI)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Illustration_(Artist%E2%80%99s_Impression)_of_WASP-39_b_and_Its_Star_(weic2221a).jpeg"
      },
      "shots": [
        {
          "start": 10.667,
          "end": 12.467,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 12.467,
          "end": 15.5,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.496,
      "end": 20.591,
      "text": "Extreme gravitational forces have distorted this world into an egg shape.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "RochePotential.jpg",
        "credit": "Marc van der Sluys",
        "license": "CC BY 2.5",
        "url": "https://commons.wikimedia.org/wiki/File:RochePotential.jpg"
      },
      "shots": [
        {
          "start": 15.5,
          "end": 20.6,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.591,
      "end": 25.311,
      "text": "Dayside temperatures reach up to forty-seven hundred degrees Fahrenheit.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "SIRTF and the Milky Way, an Artist's Concept.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:SIRTF_and_the_Milky_Way,_an_Artist%27s_Concept.jpg"
      },
      "shots": [
        {
          "start": 20.6,
          "end": 25.3,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.311,
      "end": 32.961,
      "text": "This intense heat allows the world to absorb ninety-four percent of starlight, making it as dark as fresh asphalt.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Kepler-10 star system.jpg",
        "credit": "NASA/Ames/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Kepler-10_star_system.jpg"
      },
      "shots": [
        {
          "start": 25.3,
          "end": 28.133,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 28.133,
          "end": 32.967,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 32.961,
      "end": 40.806,
      "text": "Its atmosphere has ballooned to nearly three times the radius of Jupiter, spilling material directly onto the host star.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Illustration of a Doomed Asteroid (2012-sgra-more-1 - sgra 1r).tiff",
        "credit": "(Credit: Illustrations: NASA/CXC/M.Weiss)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Illustration_of_a_Doomed_Asteroid_(2012-sgra-more-1_-_sgra_1r).tiff"
      },
      "shots": [
        {
          "start": 32.967,
          "end": 37.7,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 37.7,
          "end": 40.8,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 40.806,
      "end": 47.826,
      "text": "Astronomers estimate this doomed world has only a few million years left before it is completely destroyed.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hubble Space Telescope sporting new solar arrays during SM3B (s109e5705).jpg",
        "credit": "NASA/ESA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Hubble_Space_Telescope_sporting_new_solar_arrays_during_SM3B_(s109e5705).jpg"
      },
      "shots": [
        {
          "start": 40.8,
          "end": 47.833,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
