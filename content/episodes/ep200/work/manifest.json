{
  "id": "ep200",
  "duration": 50.367,
  "beats": [
    {
      "start": 0.08,
      "end": 4.896,
      "text": "Earth pulls the space station with nearly ninety percent of surface gravity.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "STS-135 final flyaround of ISS 1.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:STS-135_final_flyaround_of_ISS_1.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.467,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 2.467,
          "end": 4.9,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.896,
      "end": 10.841,
      "text": "Most people assume astronauts float weightlessly because Earth's gravity disappears in space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Iss018e014682.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Iss018e014682.jpg"
      },
      "shots": [
        {
          "start": 4.9,
          "end": 7.867,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 7.867,
          "end": 10.833,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.841,
      "end": 18.991,
      "text": "At a normal orbital altitude of four hundred kilometers, gravity still measures eight point seven meters per second squared.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "ISS055-E-102134 - View of Earth.jpg",
        "credit": "Earth Science and Remote Sensing Unit, NASA Johnson Space Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:ISS055-E-102134_-_View_of_Earth.jpg"
      },
      "shots": [
        {
          "start": 10.833,
          "end": 15.8,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 15.8,
          "end": 19.0,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.991,
      "end": 26.236,
      "text": "The sensation of weight does not come from gravity, but from contact forces like floors pushing against your body.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Normal force.jpg",
        "credit": "Bengt Nyman",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Normal_force.jpg"
      },
      "shots": [
        {
          "start": 19.0,
          "end": 26.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 26.236,
      "end": 31.431,
      "text": "Without a supporting force resisting you, apparent weight completely drops to zero.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "STS-135 Sandy Magnus in the Cupola.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:STS-135_Sandy_Magnus_in_the_Cupola.jpg"
      },
      "shots": [
        {
          "start": 26.233,
          "end": 28.833,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 28.833,
          "end": 31.433,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 31.431,
      "end": 37.776,
      "text": "Astronauts appear to float because they and the station accelerate downward at the exact same rate.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Newton's cannonball cropped.png",
        "credit": "Isaac Newton",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Newton%27s_cannonball_cropped.png"
      },
      "shots": [
        {
          "start": 31.433,
          "end": 34.6,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 34.6,
          "end": 37.767,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 37.776,
      "end": 44.801,
      "text": "Immense horizontal speed causes Earth's curved surface to drop away as fast as the spacecraft falls.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Iss071e489468 (Aug. 17, 2024) --- The Progress 89 cargo craft approaches the International Space Station.jpg",
        "credit": "NASA Johnson Space Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Iss071e489468_(Aug._17,_2024)_---_The_Progress_89_cargo_craft_approaches_the_International_Space_Station.jpg"
      },
      "shots": [
        {
          "start": 37.767,
          "end": 41.367,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 41.367,
          "end": 44.8,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 44.801,
      "end": 50.017,
      "text": "Weightlessness is never the absence of gravity, but an unending fall around the planet.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "STS-135 final flyaround of ISS 1.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:STS-135_final_flyaround_of_ISS_1.jpg"
      },
      "shots": [
        {
          "start": 44.8,
          "end": 50.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
