  "beats": [
    {
      "start": 0.08,
      "end": 3.88,
      "text": "Engineers hand-colored the first photo of Mars using art pastels.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "First TV Image of Mars (cropped).jpg",
        "credit": "NASA/JPL/Dan Goods",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:First_TV_Image_of_Mars_(cropped).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.867,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.88,
      "end": 7.92,
      "text": "JPL scientists couldn't wait hours for computers to process Mariner 4's data.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mariner 4 Launch Preparations.jpeg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Mariner_4_Launch_Preparations.jpeg"
      },
      "shots": [
        {
          "start": 3.867,
          "end": 7.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.92,
      "end": 11.84,
      "text": "People expected to see liquid canals and signs of alien civilization.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Lowell Mars channels.jpg",
        "credit": "Percival Lowell",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Lowell_Mars_channels.jpg"
      },
      "shots": [
        {
          "start": 7.933,
          "end": 11.833,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.84,
      "end": 16.12,
      "text": "So engineers pinned numerical printouts to a wall and painted each pixel.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mariner 4 print-out data.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Mariner_4_print-out_data.jpg"
      },
      "shots": [
        {
          "start": 11.833,
          "end": 16.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.12,
      "end": 19.48,
      "text": "The completed drawing didn't reveal a lush, living alien world.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "First close up image of another planet - Mars by Mariner 4.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:First_close_up_image_of_another_planet_-_Mars_by_Mariner_4.jpg"
      },
      "shots": [
        {
          "start": 16.133,
          "end": 19.467,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.48,
      "end": 23.66,
      "text": "Instead, it showed a dead, frozen surface covered in ancient craters.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 19.467,
          "end": 23.667,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.66,
      "end": 26.897,
      "text": "That simple paper image changed our vision of Mars forever.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "First TV Image of Mars (cropped).jpg",
        "credit": "NASA/JPL/Dan Goods",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:First_TV_Image_of_Mars_(cropped).jpg"
      },
      "shots": [
        {
          "start": 23.667,
