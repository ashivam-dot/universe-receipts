{
  "id": "ep360",
  "duration": 31.208,
  "beats": [
    {
      "start": 0.08,
      "end": 3.98,
      "text": "Air pressure sealed three astronauts inside a burning cabin.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Apollo 1 Prime Crew - GPN-2000-001159.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Apollo_1_Prime_Crew_-_GPN-2000-001159.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.0,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 2.0,
          "end": 3.967,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.98,
      "end": 6.52,
      "text": "Most people think the Apollo 1 crew died in space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist's concept of Apollo 14 Command-Service Modules circling Moon (S71-16574).jpg",
        "credit": "NASA Johnson Space Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%27s_concept_of_Apollo_14_Command-Service_Modules_circling_Moon_(S71-16574).jpg"
      },
      "shots": [
        {
          "start": 3.967,
          "end": 6.533,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.52,
      "end": 10.1,
      "text": "But the disaster happened during a routine test on the ground.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 6.533,
          "end": 10.1,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.1,
      "end": 12.74,
      "text": "NASA considered it safe because the rocket was unfueled.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Saturn IB launch vehicle cutaway (MSFC-0100800).jpg",
        "credit": "NASA/MSFC",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Saturn_IB_launch_vehicle_cutaway_(MSFC-0100800).jpg"
      },
      "shots": [
        {
          "start": 10.1,
          "end": 12.733,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.74,
      "end": 16.54,
      "text": "Inside, the cabin held pure oxygen at extremely high pressure.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "A full Apollo Command Module couch from 1968.png",
        "credit": "Steve Jurvetson",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:A_full_Apollo_Command_Module_couch_from_1968.png"
      },
      "shots": [
        {
          "start": 12.733,
          "end": 16.533,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.54,
      "end": 20.16,
      "text": "A single electrical arc turned the cockpit into a furnace.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "AS-204 - hatch.jpg",
        "credit": "Post-Work: User:W.wolny",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:AS-204_-_hatch.jpg"
      },
      "shots": [
        {
          "start": 16.533,
          "end": 18.333,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 18.333,
          "end": 20.167,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.16,
      "end": 23.84,
      "text": "Rising pressure forced the inward-opening hatch shut like a cork.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Apollo Spacecraft Tunnel Hatch.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Apollo_Spacecraft_Tunnel_Hatch.jpg"
      },
      "shots": [
        {
          "start": 20.167,
          "end": 23.833,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.84,
      "end": 27.04,
      "text": "This failure forced NASA to invent the outward-swinging emergency hatch.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Apollo 1 Tribute three-part hatch.JPG",
        "credit": "NASA/Kim Shiflett",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Apollo_1_Tribute_three-part_hatch.JPG"
      },
      "shots": [
        {
          "start": 23.833,
          "end": 27.033,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 27.04,
      "end": 30.858,
      "text": "Before that fix, air pressure sealed three astronauts inside.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Apollo 1 Prime Crew - GPN-2000-001159.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Apollo_1_Prime_Crew_-_GPN-2000-001159.jpg"
      },
      "shots": [
        {
          "start": 27.033,
          "end": 31.2,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
