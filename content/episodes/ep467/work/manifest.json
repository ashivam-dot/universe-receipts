{
  "id": "ep467",
  "duration": 35.539,
  "beats": [
    {
      "start": 0.08,
      "end": 4.32,
      "text": "Saturn's paper-thin rings hide icy mountains two miles tall.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA17172 Saturn eclipse mosaic bright crop.jpg",
        "credit": "NASA / JPL-Caltech / Space Science Institute",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA17172_Saturn_eclipse_mosaic_bright_crop.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.833,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 2.833,
          "end": 4.333,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.32,
      "end": 8.24,
      "text": "Astronomers long believed the rings were perfectly smooth, thin sheets of ice.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Saturn's Rings Edge-on (1995-31-320).jpg",
        "credit": "Credit: Phil Nicholson (Cornell University) and NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Saturn%27s_Rings_Edge-on_(1995-31-320).jpg"
      },
      "shots": [
        {
          "start": 4.333,
          "end": 8.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.24,
      "end": 12.92,
      "text": "NASA's Cassini spacecraft observed Saturn during a rare equinox in 2009.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Saturn - July 18 2009 (37311217562).jpg",
        "credit": "Kevin Gill from Los Angeles, CA, United States",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Saturn_-_July_18_2009_(37311217562).jpg"
      },
      "shots": [
        {
          "start": 8.233,
          "end": 12.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.92,
      "end": 17.52,
      "text": "Sunlight hit the ring plane edge-on, casting sudden, towering shadows.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Saturn - August 12 2009 (30604990692).jpg",
        "credit": "Kevin M. Gill",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Saturn_-_August_12_2009_(30604990692).jpg"
      },
      "shots": [
        {
          "start": 12.933,
          "end": 17.533,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.52,
      "end": 22.04,
      "text": "Those shadows were cast by massive vertical peaks of crushed ice.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA11668 The Tallest Peaks.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA11668_The_Tallest_Peaks.jpg"
      },
      "shots": [
        {
          "start": 17.533,
          "end": 22.033,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.04,
      "end": 25.74,
      "text": "Tiny embedded moons drag the surrounding material into giant waves.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA08319 Daphnis in Keeler Gap.jpg",
        "credit": "NASA/JPL/Space Science Institute",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA08319_Daphnis_in_Keeler_Gap.jpg"
      },
      "shots": [
        {
          "start": 22.033,
          "end": 25.733,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.74,
      "end": 30.64,
      "text": "These mountain-sized ice chunks constantly smash, pile up, and reform.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "A Ring propeller \"Santos-Dumont\" (PIA 21433).jpg",
        "credit": "NASA / Jet Propulsion Lab-Caltech / Space Science Institute",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:A_Ring_propeller_%22Santos-Dumont%22_(PIA_21433).jpg"
      },
      "shots": [
        {
          "start": 25.733,
          "end": 27.733,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 27.733,
          "end": 30.633,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 30.64,
      "end": 35.189,
      "text": "From a distance, all that violent chaos completely disappears.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA17172 Saturn eclipse mosaic bright crop.jpg",
        "credit": "NASA / JPL-Caltech / Space Science Institute",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA17172_Saturn_eclipse_mosaic_bright_crop.jpg"
      },
      "shots": [
        {
          "start": 30.633,
          "end": 35.533,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
