{
  "id": "ep231",
  "duration": 49.514,
  "beats": [
    {
      "start": 0.08,
      "end": 3.818,
      "text": "The Moon is not frozen; it is actively spinning right now.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "A VLT Unit Telescope and the Moon (eso-paranal-15).jpg",
        "credit": "ESO/G.H\u00fcdepohl\u00a0(atacamaphoto.com)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:A_VLT_Unit_Telescope_and_the_Moon_(eso-paranal-15).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 1.867,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 1.867,
          "end": 3.833,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.818,
      "end": 8.613,
      "text": "Because we always see the same face, many people assume it never rotates.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NASA Goddard Photo and Video - First Quarter (by).jpg",
        "credit": "NASA Goddard Space Flight Center from Greenbelt, MD, USA",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:NASA_Goddard_Photo_and_Video_-_First_Quarter_(by).jpg"
      },
      "shots": [
        {
          "start": 3.833,
          "end": 6.2,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 6.2,
          "end": 8.6,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.613,
      "end": 14.213,
      "text": "But to hide its far side, the Moon rotates once every twenty-seven point three days.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Earth-moon-ecliptic.png",
        "credit": "Unknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Earth-moon-ecliptic.png"
      },
      "shots": [
        {
          "start": 8.6,
          "end": 14.2,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.213,
      "end": 20.258,
      "text": "Early in solar system history, it spun much faster before Earth's gravity grabbed hold.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Giant impact.jpg",
        "credit": "H.Seldon",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Giant_impact.jpg"
      },
      "shots": [
        {
          "start": 14.2,
          "end": 20.267,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.258,
      "end": 26.028,
      "text": "Tidal friction created massive rock bulges, slowing its spin over millions of years.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PSM V74 D529 Relationship between tidal forces the moon and latitude.png",
        "credit": "Unknown authorUnknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PSM_V74_D529_Relationship_between_tidal_forces_the_moon_and_latitude.png"
      },
      "shots": [
        {
          "start": 20.267,
          "end": 26.033,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 26.028,
      "end": 32.728,
      "text": "That orbital brake is so powerful it even lengthens Earth's day by two milliseconds per century.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "AS08-16-2593 remastered.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:AS08-16-2593_remastered.jpg"
      },
      "shots": [
        {
          "start": 26.033,
          "end": 30.4,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 30.4,
          "end": 32.733,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 32.728,
      "end": 38.848,
      "text": "Meanwhile, that transferred energy pushes the Moon roughly four centimeters further away each year.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Apollo 11 Lunar Laser Ranging Experiment.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Apollo_11_Lunar_Laser_Ranging_Experiment.jpg"
      },
      "shots": [
        {
          "start": 32.733,
          "end": 36.3,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 36.3,
          "end": 38.833,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 38.848,
      "end": 44.293,
      "text": "Every large moon in our solar system is locked in this same gravitational dance.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Moons of the Solar System.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Moons_of_the_Solar_System.jpg"
      },
      "shots": [
        {
          "start": 38.833,
          "end": 41.567,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 41.567,
          "end": 44.3,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 44.293,
      "end": 49.164,
      "text": "This gravitational deadlock permanently hides a world that never stops turning.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "A VLT Unit Telescope and the Moon (eso-paranal-15).jpg",
        "credit": "ESO/G.H\u00fcdepohl\u00a0(atacamaphoto.com)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:A_VLT_Unit_Telescope_and_the_Moon_(eso-paranal-15).jpg"
      },
      "shots": [
        {
          "start": 44.3,
          "end": 49.5,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
