  "beats": [
    {
      "start": 0.08,
      "end": 4.847,
      "text": "A structure 100 times wider than the Milky Way is technically average.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "CentaurusA2.jpg",
        "credit": "The original uploader was Hurricane Devon at English Wikipedia.",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:CentaurusA2.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.2,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 3.2,
          "end": 4.833,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.847,
      "end": 13.417,
      "text": "In 2022, astronomers used the LOFAR radio network to discover [Alcyoneus](/\u02c8\u00e6ls\u02c8I\u02c8On\u02c8\u028cs/), a record-shattering giant.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "LOFAR Superterp.jpg",
        "credit": "LOFAR / ASTRON",
        "license": "CC BY 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:LOFAR_Superterp.jpg"
      },
      "shots": [
        {
          "start": 4.833,
          "end": 8.6,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 8.6,
          "end": 13.433,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.417,
      "end": 19.712,
      "text": "Over three billion light-years away, this radio galaxy spans at least 16 million light-years.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "3C 20 Radio Image.jpg",
        "credit": "Unknown authorUnknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:3C_20_Radio_Image.jpg"
      },
      "shots": [
        {
          "start": 13.433,
          "end": 19.7,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.712,
      "end": 24.082,
      "text": "That is equivalent to laying over one hundred Milky Ways end-to-end.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Milky Way Andromeda sizes and distance to scale annotated.jpg",
        "credit": "Pablo Carlos Budassi",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Milky_Way_Andromeda_sizes_and_distance_to_scale_annotated.jpg"
      },
      "shots": [
        {
          "start": 19.7,
          "end": 21.633,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 21.633,
          "end": 24.067,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.082,
      "end": 28.827,
      "text": "If our eyes saw radio waves, these lobes would look as large as the moon.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 24.067,
          "end": 28.833,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 28.827,
      "end": 34.897,
      "text": "Twin plasma jets launched from the core near light speed to inflate this gargantuan structure.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Slideshow Images For The Hubble Space Telescope (SVS14370 - hubble-explore-light-hercules-radio-3).jpg",
        "credit": "NASA's Scientific Visualization Studio - Paul Morris, Aaron E. Lepsch",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Slideshow_Images_For_The_Hubble_Space_Telescope_(SVS14370_-_hubble-explore-light-hercules-radio-3).jpg"
      },
      "shots": [
        {
          "start": 28.833,
          "end": 34.9,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 34.897,
      "end": 40.842,
      "text": "Researchers expected a monster black hole, but found an average host with no star birth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Abell S740, cropped to ESO 325-G004.jpg",
        "credit": "NASA, ESA, and The Hubble Heritage Team (STScI/AURA); J. Blakeslee (Washington State University)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Abell_S740,_cropped_to_ESO_325-G004.jpg"
      },
      "shots": [
        {
          "start": 34.9,
          "end": 37.233,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 37.233,
          "end": 40.833,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 40.842,
      "end": 46.592,
      "text": "It grew this massive because it sits in a lonely, empty pocket of the cosmic web.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Probing the cosmic web (opo0820b).jpg",
        "credit": "NASA, ESA, and E. Hallman (University of Colorado, Boulder)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Probing_the_cosmic_web_(opo0820b).jpg"
      },
      "shots": [
        {
          "start": 40.833,
          "end": 44.033,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 44.033,
          "end": 46.6,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 46.592,
      "end": 51.535,
      "text": "This cosmic titan exists only because it was blown by an ordinary galaxy.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "CentaurusA2.jpg",
        "credit": "The original uploader was Hurricane Devon at English Wikipedia.",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:CentaurusA2.jpg"
      },
      "shots": [
        {
          "start": 46.6,
          "end": 51.9,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
