{
  "id": "ep272",
  "duration": 24.299,
  "beats": [
    {
      "start": 0.08,
      "end": 2.6,
      "text": "The American flag on the Moon never actually waved.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Buzz Aldrin and the US flag on the Moon, AS11-40-5875.jpg",
        "credit": "Neil Armstrong",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Buzz_Aldrin_and_the_US_flag_on_the_Moon,_AS11-40-5875.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.6,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 2.6,
      "end": 5.5,
      "text": "Without any lunar wind, a normal banner would just hang limp.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "AS11-40-5927 (21447616643).jpg",
        "credit": "Project Apollo Archive",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:AS11-40-5927_(21447616643).jpg"
      },
      "shots": [
        {
          "start": 2.6,
          "end": 5.5,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 5.5,
      "end": 8.74,
      "text": "So NASA bought a standard five-dollar nylon flag.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "VAB Exterior Photos (KSC-20220119-PH-CSH01 0011).jpg",
        "credit": "Cory Huston",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:VAB_Exterior_Photos_(KSC-20220119-PH-CSH01_0011).jpg"
      },
      "shots": [
        {
          "start": 5.5,
          "end": 8.733,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.74,
      "end": 11.7,
      "text": "Engineers sewed a hem to slide in a telescoping top rod.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "VAB Exterior Photos (KSC-20220119-PH-CSH01 0011).jpg",
        "credit": "Cory Huston",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:VAB_Exterior_Photos_(KSC-20220119-PH-CSH01_0011).jpg"
      },
      "shots": [
        {
          "start": 8.733,
          "end": 11.7,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.7,
      "end": 14.5,
      "text": "On the surface, that horizontal metal rod jammed halfway.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "AS11-40-5886 (21473317649).jpg",
        "credit": "Project Apollo Archive",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:AS11-40-5886_(21473317649).jpg"
      },
      "shots": [
        {
          "start": 11.7,
          "end": 13.567,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 13.567,
          "end": 14.5,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.5,
      "end": 18.12,
      "text": "The stuck bar and tight packing folds trapped permanent wrinkles.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "AS11-37-5481 (21657378566).jpg",
        "credit": "Project Apollo Archive",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:AS11-37-5481_(21657378566).jpg"
      },
      "shots": [
        {
          "start": 14.5,
          "end": 18.133,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.12,
      "end": 21.28,
      "text": "During liftoff, engine exhaust blew the whole small assembly over.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "S72-35614.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:S72-35614.jpg"
      },
      "shots": [
        {
          "start": 18.133,
          "end": 19.567,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 19.567,
          "end": 21.267,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.28,
      "end": 23.949,
      "text": "That is why the famous banner only seemed to wave.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Buzz Aldrin and the US flag on the Moon, AS11-40-5875.jpg",
        "credit": "Neil Armstrong",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Buzz_Aldrin_and_the_US_flag_on_the_Moon,_AS11-40-5875.jpg"
      },
      "shots": [
        {
          "start": 21.267,
          "end": 24.3,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    }
  ],
