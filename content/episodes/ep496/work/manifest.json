  "beats": [
    {
      "start": 0.08,
      "end": 3.12,
      "text": "A giant star will explode in our galaxy every year.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NASA's Chandra Examines Milky Way at Arms' Length (Illustration Showing Updated Spiral Arm Positions).jpg",
        "credit": "NASA/CXC/SAO/M.Weiss",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:NASA%27s_Chandra_Examines_Milky_Way_at_Arms%27_Length_(Illustration_Showing_Updated_Spiral_Arm_Positions).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.12,
      "end": 6.2,
      "text": "Usually, our galaxy sees a supernova only once a century.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Crab Nebula imaged using James Webb Space Telescope.png",
        "credit": "NASA, ESA, CSA, STScI, T. Temim (Princeton University)",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Crab_Nebula_imaged_using_James_Webb_Space_Telescope.png"
      },
      "shots": [
        {
          "start": 3.133,
          "end": 6.2,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.2,
      "end": 10.32,
      "text": "But 25,000 light-years away, the Milky Way\u2019s heart is charging up.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Milky Way Center (MeerKAT and Webb), Labeled (2025-115).png",
        "credit": "Image: NASA, ESA, CSA, STScI, SARAO, Samuel Crowe (UVA), John Bally (CU), Ruben Fedriani (IAA-CSIC), Ian Heywood (Oxford)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Milky_Way_Center_(MeerKAT_and_Webb),_Labeled_(2025-115).png"
      },
      "shots": [
        {
          "start": 6.2,
          "end": 10.333,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.32,
      "end": 14.38,
      "text": "NASA\u2019s Chandra telescope caught a flare 400 times brighter than normal.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "X-RayFlare-BlackHole-MilkyWay-20140105.jpg",
        "credit": "NASA/CXC/Stanford/I. Zhuravleva et al.",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:X-RayFlare-BlackHole-MilkyWay-20140105.jpg"
      },
      "shots": [
        {
          "start": 10.333,
          "end": 14.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.38,
      "end": 17.72,
      "text": "Our central black hole has the mass of four million suns.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Illustration of the black hole Sagittarius A* at the center of the Milky Way (noirlab2130d).tiff",
        "credit": "International Gemini Observatory/NOIRLab/NSF/AURA/J. da Silva/(Spaceengine). \n\nAcknowledgement: M. Zamani (NSF's NOIRLab)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Illustration_of_the_black_hole_Sagittarius_A*_at_the_center_of_the_Milky_Way_(noirlab2130d).tiff"
      },
      "shots": [
        {
          "start": 14.367,
          "end": 17.733,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.72,
      "end": 20.78,
      "text": "A dense ring of gas is now reaching a critical density.",
      "asset": {
        "source": "Flickr via Openverse",
        "title": "NGC 6822 (MIRI image)",
        "credit": "James Webb Space Telescope",
        "license": "CC BY 2.0",
        "url": "https://www.flickr.com/photos/50785054@N03/53084246454"
      },
      "shots": [
        {
          "start": 17.733,
          "end": 20.767,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.78,
      "end": 24.34,
      "text": "A massive starburst episode begins in 200 million years.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Two views of the starburst galaxy Messier 82 (M82) ESA170 - Two views of the starburst galaxy Messier 82 M82.tiff",
        "credit": "European Space Agency",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Two_views_of_the_starburst_galaxy_Messier_82_(M82)_ESA170_-_Two_views_of_the_starburst_galaxy_Messier_82_M82.tiff"
      },
      "shots": [
        {
          "start": 20.767,
          "end": 24.333,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.34,
      "end": 27.38,
      "text": "One star will then die in a supernova every single year.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Illustration of Alternate Trigger Mechanism (2010-type1a-more-2 - label).tiff",
        "credit": "(Illustration: NASA/CXC/M.Weiss)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Illustration_of_Alternate_Trigger_Mechanism_(2010-type1a-more-2_-_label).tiff"
      },
      "shots": [
        {
          "start": 24.333,
