{
  "id": "ep228",
  "duration": 53.558,
  "beats": [
    {
      "start": 0.08,
      "end": 7.577,
      "text": "Four astronauts will fly 252,756 miles to break Apollo 13's record.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Orion LunarFLyby 4k (656314676363).jpg",
        "credit": "Uploaded by Patricia Moore",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Orion_LunarFLyby_4k_(656314676363).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.367,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 4.367,
          "end": 7.567,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.577,
      "end": 17.072,
      "text": "Slated for 2026 aboard NASA's Space Launch System, Artemis II will push farther into deep space than humans have ever traveled.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artemis I Prelaunch (NHQ202208280005).jpg",
        "credit": "Bill Ingalls",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Artemis_I_Prelaunch_(NHQ202208280005).jpg"
      },
      "shots": [
        {
          "start": 7.567,
          "end": 17.067,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.072,
      "end": 24.492,
      "text": "Commander Reid Wiseman and pilot Victor Glover will guide the Orion spacecraft Integrity on this ten-day flight.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artemis 2 Crew Portrait (cropped).jpg",
        "credit": "Josh Valcarcel",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Artemis_2_Crew_Portrait_(cropped).jpg"
      },
      "shots": [
        {
          "start": 17.067,
          "end": 20.8,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 20.8,
          "end": 24.5,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.492,
      "end": 31.037,
      "text": "ESA's European Service Module provides the power to loop the crew around the lunar far side.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Orion Service Module elements 2015.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Orion_Service_Module_elements_2015.jpg"
      },
      "shots": [
        {
          "start": 24.5,
          "end": 31.033,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 31.037,
      "end": 39.682,
      "text": "Christina Koch and Jeremy Hansen join Victor Glover as the first woman, non-American, and Black astronaut to fly around the Moon.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artemis II Crew Poster (cropped).png",
        "credit": "NASA Headquarters / NASA/Daniel O'Neal",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Artemis_II_Crew_Poster_(cropped).png"
      },
      "shots": [
        {
          "start": 31.033,
          "end": 39.667,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 39.682,
      "end": 46.652,
      "text": "While Apollo 13 reached its record during a crisis, Artemis II will reach it as a planned trial run.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Saturn Apollo Program (7010516).jpg",
        "credit": "NASA Marshall Space Flight Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Saturn_Apollo_Program_(7010516).jpg"
      },
      "shots": [
        {
          "start": 39.667,
          "end": 42.167,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 42.167,
          "end": 46.667,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 46.652,
      "end": 53.208,
      "text": "After splashing down in the Pacific, this flight will reset the record for the farthest humans have ever traveled.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Orion LunarFLyby 4k (656314676363).jpg",
        "credit": "Uploaded by Patricia Moore",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Orion_LunarFLyby_4k_(656314676363).jpg"
      },
      "shots": [
        {
          "start": 46.667,
          "end": 53.567,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
