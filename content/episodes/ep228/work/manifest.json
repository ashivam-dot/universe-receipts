{
  "id": "ep228",
  "duration": 57.684,
  "beats": [
    {
      "start": 0.08,
      "end": 7.609,
      "text": "Four astronauts flew 252,756 miles from Earth to break a historic record.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Orion LunarFLyby 4k (656314676363).jpg",
        "credit": "Uploaded by Patricia Moore",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Orion_LunarFLyby_4k_(656314676363).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.1,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 4.1,
          "end": 7.6,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.609,
      "end": 16.829,
      "text": "Launching in April 2026 aboard NASA's Space Launch System, Artemis II surpassed Apollo 13's deep-space distance.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artemis II Launch (NHQ20260401 admin 0032).jpg",
        "credit": "NASA Kennedy Space Center / NASA/John Kraus",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Artemis_II_Launch_(NHQ20260401_admin_0032).jpg"
      },
      "shots": [
        {
          "start": 7.6,
          "end": 16.833,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.829,
      "end": 24.274,
      "text": "Flying inside the Orion capsule Integrity, the crew traveled on a lunar free-return trajectory without landing.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artemis 1 - Orion and ESM approach Moon.jpg",
        "credit": "National Aeronautics and Space Administration (NASA)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Artemis_1_-_Orion_and_ESM_approach_Moon.jpg"
      },
      "shots": [
        {
          "start": 16.833,
          "end": 21.4,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 21.4,
          "end": 24.267,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.274,
      "end": 31.594,
      "text": "ESA's European Service Module propelled the ten-day test flight to validate critical spacecraft systems.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Orion Service Module elements 2015.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Orion_Service_Module_elements_2015.jpg"
      },
      "shots": [
        {
          "start": 24.267,
          "end": 31.6,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 31.594,
      "end": 40.014,
      "text": "Commander Reid Wiseman and pilot Victor Glover even completed manual proximity maneuvers using their rocket's upper stage.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artemis II Launch Crew Walkout (NHQ20260401 admin 0005).jpg",
        "credit": "NASA Kennedy Space Center / NASA/John Kraus",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Artemis_II_Launch_Crew_Walkout_(NHQ20260401_admin_0005).jpg"
      },
      "shots": [
        {
          "start": 31.6,
          "end": 35.8,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 35.8,
          "end": 40.0,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 40.014,
      "end": 49.734,
      "text": "Mission specialists Christina Koch and Jeremy Hansen flew as the first woman and non-American beyond low Earth orbit since 1972.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 40.0,
          "end": 49.733,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 49.734,
      "end": 57.334,
      "text": "After a Pacific Ocean splashdown off San Diego, their flight proved how far people can venture into the cosmic unknown.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Orion LunarFLyby 4k (656314676363).jpg",
        "credit": "Uploaded by Patricia Moore",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Orion_LunarFLyby_4k_(656314676363).jpg"
      },
      "shots": [
        {
          "start": 49.733,
          "end": 57.7,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
