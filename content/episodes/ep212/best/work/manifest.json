{
  "id": "ep212",
  "duration": 57.977,
  "beats": [
    {
      "start": 0.08,
      "end": 4.65,
      "text": "A Soviet lander sent signals from Venus long past its death sentence.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "V13 vg261 262.tif",
        "credit": "USSR/NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:V13_vg261_262.tif"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.667,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.65,
      "end": 11.645,
      "text": "On 1 March 1982, Venera 13 plunged into 89 atmospheres of crushing pressure.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Venuspioneeruv.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Venuspioneeruv.jpg"
      },
      "shots": [
        {
          "start": 4.667,
          "end": 8.8,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 8.8,
          "end": 11.633,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.645,
      "end": 19.94,
      "text": "With ground temperatures at 457 degrees Celsius, engineers designed it to last approximately 32 minutes.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Venera 4 (MMA 2011) (1).JPG",
        "credit": "Armael",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Venera_4_(MMA_2011)_(1).JPG"
      },
      "shots": [
        {
          "start": 11.633,
          "end": 19.933,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.94,
      "end": 26.285,
      "text": "Yet it kept transmitting, capturing the first acoustic sound recordings ever made on another world.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "1982 CPA 5278.jpg",
        "credit": "Post of Soviet Union",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:1982_CPA_5278.jpg"
      },
      "shots": [
        {
          "start": 19.933,
          "end": 26.3,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 26.285,
      "end": 31.98,
      "text": "Its drilling arm pulled soil into an internal chamber kept at 30 degrees Celsius.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Gula Mons 3D.jpg",
        "credit": "JPL/NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Gula_Mons_3D.jpg"
      },
      "shots": [
        {
          "start": 26.3,
          "end": 31.967,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 31.98,
      "end": 38.35,
      "text": "The lander beamed back the first color panoramas of Venus, sparking claims of alien creatures.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Asteria and Phoebe Regio.jpg",
        "credit": "NASA, Magellan spacecraft",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Asteria_and_Phoebe_Regio.jpg"
      },
      "shots": [
        {
          "start": 31.967,
          "end": 38.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 38.35,
      "end": 45.4,
      "text": "Photo analysts soon proved that mysterious moving organism was just the probe's ejected lens cap.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Surfaces of Venus, Venere 13 and Venera14.jpg",
        "credit": "Lunar and Planetary Institute from Houston, TX, USA",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Surfaces_of_Venus,_Venere_13_and_Venera14.jpg"
      },
      "shots": [
        {
          "start": 38.367,
          "end": 45.4,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 45.4,
      "end": 52.625,
      "text": "Venera 13 defied the crushing furnace, transmitting vital data for 127 minutes.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 45.4,
          "end": 52.633,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 52.625,
      "end": 57.627,
      "text": "Soviet mission control had only expected it to survive for 32 minutes.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "V13 vg261 262.tif",
        "credit": "USSR/NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:V13_vg261_262.tif"
      },
      "shots": [
        {
          "start": 52.633,
          "end": 57.967,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
