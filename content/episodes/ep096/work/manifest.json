  "beats": [
    {
      "start": 0.08,
      "end": 4.095,
      "text": "The most famous labor strike in history didn't even happen on Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Skylab4 crew.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Skylab4_crew.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.1,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.095,
      "end": 11.44,
      "text": "In November 1973, NASA launched three rookie astronauts to America's first space station, Skylab.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Skylab 4 mission launch.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Skylab_4_mission_launch.jpg"
      },
      "shots": [
        {
          "start": 4.1,
          "end": 8.867,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 8.867,
          "end": 11.433,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.44,
      "end": 19.16,
      "text": "Gerald Carr, Edward Gibson, and William Pogue soon struggled under an incredibly micromanaged eighty-four-day schedule.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist's concept of Skylab space station cluster in Earth's orbit (S71-52192).jpg",
        "credit": "NASA Johnson Space Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%27s_concept_of_Skylab_space_station_cluster_in_Earth%27s_orbit_(S71-52192).jpg"
      },
      "shots": [
        {
          "start": 11.433,
          "end": 15.067,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 15.067,
          "end": 19.167,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.16,
      "end": 27.005,
      "text": "When the astronauts tried to hide an early case of space sickness, NASA\u2019s chief astronaut Alan Shepard issued a stern reprimand.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Alan Shepard during Apollo 14 suiting up.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Alan_Shepard_during_Apollo_14_suiting_up.jpg"
      },
      "shots": [
        {
          "start": 19.167,
          "end": 21.933,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 21.933,
          "end": 27.0,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 27.005,
      "end": 34.9,
      "text": "Exhausted and overworked, the crew suffered an accidental radio error that caused them to miss a scheduled daily briefing.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Skylab4 - February 1974 astronaut Edward Gibson.jpg",
        "credit": "NASA - taken by Astronaut Gerald P. Carr, Skylab 4 commander",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Skylab4_-_February_1974_astronaut_Edward_Gibson.jpg"
      },
      "shots": [
        {
          "start": 27.0,
          "end": 30.0,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 30.0,
          "end": 34.9,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 34.9,
      "end": 43.37,
      "text": "This ninety-minute radio gap was immediately sensationalized by the media as a deliberate and unprecedented mutiny in orbit.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The Apollo Telescope Mount (ATM), designed and developed by the Marshall Space Flight Center, was one of four major components comprising the Skylab (1973-1979) (7022294).jpg",
        "credit": "NASA Marshall Space Flight Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:The_Apollo_Telescope_Mount_(ATM),_designed_and_developed_by_the_Marshall_Space_Flight_Center,_was_one_of_four_major_components_comprising_the_Skylab_(1973-1979)_(7022294).jpg"
      },
      "shots": [
        {
          "start": 34.9,
          "end": 37.867,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 37.867,
          "end": 43.367,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 43.37,
      "end": 50.615,
      "text": "After the schedule was lightened, the crew became more productive than ever, yet none of them ever flew in space again.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Skylab4-Patch.png",
        "credit": "Unknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Skylab4-Patch.png"
      },
      "shots": [
        {
          "start": 43.367,
          "end": 50.6,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 50.615,
      "end": 52.926,
