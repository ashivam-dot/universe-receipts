{
  "id": "ep382",
  "duration": 28.218,
  "beats": [
    {
      "start": 0.08,
      "end": 2.98,
      "text": "A Soviet space shuttle flew into orbit with no crew.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Buran on An-225 (Le Bourget 1989).JPEG",
        "credit": "MASTER SGT. DAVE CASEY",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Buran_on_An-225_(Le_Bourget_1989).JPEG"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.967,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 2.98,
      "end": 5.76,
      "text": "Most people thought NASA built the only orbital shuttle.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Space Shuttle Columbia launching.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Space_Shuttle_Columbia_launching.jpg"
      },
      "shots": [
        {
          "start": 2.967,
          "end": 4.6,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 4.6,
          "end": 5.767,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 5.76,
      "end": 8.46,
      "text": "Soviet leaders feared American shuttles could drop nuclear bombs.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "\"Buran\" docked to \"Mir\" space station.jpg",
        "credit": "Brian W. McMullin",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:%22Buran%22_docked_to_%22Mir%22_space_station.jpg"
      },
      "shots": [
        {
          "start": 5.767,
          "end": 8.467,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.46,
      "end": 11.06,
      "text": "So the Soviets built their own shuttle named Buran.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "OK-GLI Buran Space Shuttle at the Technik Museum Speyer.jpg",
        "credit": "Pascal (Flickr user: pasukaru76)",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:OK-GLI_Buran_Space_Shuttle_at_the_Technik_Museum_Speyer.jpg"
      },
      "shots": [
        {
          "start": 8.467,
          "end": 11.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.06,
      "end": 14.08,
      "text": "Unlike America's orbiter, Buran carried no main launch engines.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Buran partial rear view (Le Bourget 1989).JPEG",
        "credit": "MASTER SGT. DAVE CASEY",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Buran_partial_rear_view_(Le_Bourget_1989).JPEG"
      },
      "shots": [
        {
          "start": 11.067,
          "end": 12.967,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 12.967,
          "end": 14.067,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.08,
      "end": 16.92,
      "text": "The super-heavy Energia rocket pushed it into orbit.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The Soviet Union 1991 CPA 6300 stamp (14th standard issue of Soviet Union. 3rd issue. Space Exploration. 'Energia' rocket and 'Buran' spacecraft on launch pad) 1200dpi.jpg",
        "credit": "USSR Post (\u0440\u0438\u0441\u0443\u043d\u043e\u043a \u0412. \u042d. \u041a\u043e\u0432\u0430\u043b\u044f.",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:The_Soviet_Union_1991_CPA_6300_stamp_(14th_standard_issue_of_Soviet_Union._3rd_issue._Space_Exploration._%27Energia%27_rocket_and_%27Buran%27_spacecraft_on_launch_pad)_1200dpi.jpg"
      },
      "shots": [
        {
          "start": 14.067,
          "end": 15.367,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 15.367,
          "end": 16.933,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.92,
      "end": 19.38,
      "text": "Buran circled Earth twice with an empty cockpit.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Buran on An-225 (Le Bourget 1989) (cropped).JPEG",
        "credit": "MASTER SGT. DAVE CASEY",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Buran_on_An-225_(Le_Bourget_1989)_(cropped).JPEG"
      },
      "shots": [
        {
          "start": 16.933,
          "end": 19.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.38,
      "end": 21.66,
      "text": "Onboard computers guided landing through heavy crosswinds.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Baikonur Cosmodrome IMG 2590 Baikonur (36910000060).jpg",
        "credit": "Ninara from Helsinki, Finland",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Baikonur_Cosmodrome_IMG_2590_Baikonur_(36910000060).jpg"
      },
      "shots": [
        {
          "start": 19.367,
          "end": 21.667,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.66,
      "end": 24.6,
      "text": "It executed a fully automated touchdown on the runway.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Buran on An-225 (Le Bourget 1989) 1.JPEG",
        "credit": "MASTER SGT. DAVE CASEY",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Buran_on_An-225_(Le_Bourget_1989)_1.JPEG"
      },
      "shots": [
        {
          "start": 21.667,
          "end": 24.6,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.6,
      "end": 27.868,
      "text": "No pilot touched controls when a Soviet space shuttle flew into orbit.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Buran on An-225 (Le Bourget 1989).JPEG",
        "credit": "MASTER SGT. DAVE CASEY",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Buran_on_An-225_(Le_Bourget_1989).JPEG"
      },
      "shots": [
