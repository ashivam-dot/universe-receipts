  "beats": [
    {
      "start": 0.08,
      "end": 3.953,
      "text": "One star emits a year of solar energy in twenty seconds.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist\u2019s impression of the disappearing star (eso2010a).tiff",
        "credit": "ESO/L. Cal\u00e7ada",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%E2%80%99s_impression_of_the_disappearing_star_(eso2010a).tiff"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.967,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.953,
      "end": 9.848,
      "text": "This is the Pistol Star, a blue hypergiant located 25,000 light-years away.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The Pistol Star- A Brilliant Star in Milky Way's Core (1997-33-524).jpg",
        "credit": "Credit: Don F. Figer (UCLA) and NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:The_Pistol_Star-_A_Brilliant_Star_in_Milky_Way%27s_Core_(1997-33-524).jpg"
      },
      "shots": [
        {
          "start": 3.967,
          "end": 6.3,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 6.3,
          "end": 9.833,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.848,
      "end": 17.468,
      "text": "Astronomer Don Figer identified the record-breaker in the early 1990s using the Hubble Space Telescope.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Thornton Prepares to Release Hubble Array - GPN-2000-001155.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Thornton_Prepares_to_Release_Hubble_Array_-_GPN-2000-001155.jpg"
      },
      "shots": [
        {
          "start": 9.833,
          "end": 17.467,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.468,
      "end": 22.938,
      "text": "The hypergiant produces at least 1.6 million times more light than our Sun.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 17.467,
          "end": 22.933,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.938,
      "end": 28.558,
      "text": "If the Pistol Star replaced the Sun, its surface would extend past the orbit of Mars.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Quasi-star size comparison.png",
        "credit": "Sauropodomorph",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Quasi-star_size_comparison.png"
      },
      "shots": [
        {
          "start": 22.933,
          "end": 25.733,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 25.733,
          "end": 28.567,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 28.558,
      "end": 34.483,
      "text": "This giant's stellar winds are 10 billion times stronger than the breeze from our own star.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NASA-JAXA XRISM Mission Sees Pulsar Accreting Companion's 'Wind' (SVS15099 - Still2).jpg",
        "credit": "NASA's Scientific Visualization Studio - NASA\u2019s Goddard Space Flight Center Conceptual Image LaboratoryAlt text: Animation of the BP Crucis system0:00 A wide view, showing the giant star, its gas stre",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:NASA-JAXA_XRISM_Mission_Sees_Pulsar_Accreting_Companion%27s_%27Wind%27_(SVS15099_-_Still2).jpg"
      },
      "shots": [
        {
          "start": 28.567,
          "end": 30.9,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 30.9,
          "end": 34.467,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 34.483,
      "end": 40.228,
      "text": "However, thick cosmic dust blocks our view, absorbing almost all of its visible light.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Views of the Galactic Center region from NASA's Great Observatories (opo0928h).tiff",
        "credit": "NASA, ESA, SSC, CXC, and STScI",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Views_of_the_Galactic_Center_region_from_NASA%27s_Great_Observatories_(opo0928h).tiff"
      },
      "shots": [
        {
          "start": 34.467,
          "end": 40.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 40.228,
      "end": 45.398,
      "text": "Without that dust, the hypergiant would be easily visible to the naked eye at night.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 40.233,
          "end": 45.4,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 45.398,
      "end": 50.515,
      "text": "A massive hypernova will eventually end the short life of this radiant monster.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist\u2019s impression of the disappearing star (eso2010a).tiff",
        "credit": "ESO/L. Cal\u00e7ada",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%E2%80%99s_impression_of_the_disappearing_star_(eso2010a).tiff"
      },
      "shots": [
        {
          "start": 45.4,
          "end": 50.867,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
