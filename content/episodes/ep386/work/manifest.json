{
  "id": "ep386",
  "duration": 33.254,
  "beats": [
    {
      "start": 0.08,
      "end": 2.4,
      "text": "The space station is wider than a football field.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "STS-135 final flyaround of ISS 1.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:STS-135_final_flyaround_of_ISS_1.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.4,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 2.4,
      "end": 7.38,
      "text": "It weighs over 900,000 pounds across 356 feet of solar arrays.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "S118E09821 - STS-118 - Exterior view of the ISS taken from the Space Shuttle Endeavour during STS-118 - DPLA - 7464e13e9e63ce181f97c9f5381eb70e.jpg",
        "credit": "National Aeronautics and Space Administration. Lyndon B. Johnson Space Center. 2/17/1973",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:S118E09821_-_STS-118_-_Exterior_view_of_the_ISS_taken_from_the_Space_Shuttle_Endeavour_during_STS-118_-_DPLA_-_7464e13e9e63ce181f97c9f5381eb70e.jpg"
      },
      "shots": [
        {
          "start": 2.4,
          "end": 4.2,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 4.2,
          "end": 7.367,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.38,
      "end": 11.52,
      "text": "More than 40 delivery flights assembled this giant 250 miles above Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "STS 134 Endeavour Docked At The ISS.jpg",
        "credit": "Ron Garan",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:STS_134_Endeavour_Docked_At_The_ISS.jpg"
      },
      "shots": [
        {
          "start": 7.367,
          "end": 11.533,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.52,
      "end": 16.62,
      "text": "Yet inside, its entire pressurized living space equals just one Boeing 747.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "ISS STS-130 Terry Virts and Jeffrey Williams in the Cupola.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:ISS_STS-130_Terry_Virts_and_Jeffrey_Williams_in_the_Cupola.jpg"
      },
      "shots": [
        {
          "start": 11.533,
          "end": 14.067,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 14.067,
          "end": 16.633,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.62,
      "end": 20.72,
      "text": "Seven astronauts orbit the planet inside it at five miles per second.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Four Expedition 74 flight engineers pose for a fun portrait inside their crew quarters (iss074e0812254).jpg",
        "credit": "NASA Johnson Space Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Four_Expedition_74_flight_engineers_pose_for_a_fun_portrait_inside_their_crew_quarters_(iss074e0812254).jpg"
      },
      "shots": [
        {
          "start": 16.633,
          "end": 20.733,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.72,
      "end": 24.28,
      "text": "That speed carries them around the entire globe every 90 minutes.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "ISS-65 Northwest America at night, city lights.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:ISS-65_Northwest_America_at_night,_city_lights.jpg"
      },
      "shots": [
        {
          "start": 20.733,
          "end": 24.267,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.28,
      "end": 28.1,
      "text": "NASA plans to crash this 400-ton titan into the Pacific Ocean around 2030.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "ISS057-E-21316 - View of Earth.jpg",
        "credit": "Earth Science and Remote Sensing Unit, NASA Johnson Space Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:ISS057-E-21316_-_View_of_Earth.jpg"
      },
      "shots": [
        {
          "start": 24.267,
          "end": 28.1,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 28.1,
      "end": 32.904,
      "text": "It is a dramatic end for an outpost wider than a football field.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "STS-135 final flyaround of ISS 1.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:STS-135_final_flyaround_of_ISS_1.jpg"
      },
      "shots": [
        {
          "start": 28.1,
          "end": 33.267,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
