  "beats": [
    {
      "start": 0.08,
      "end": 4.721,
      "text": "A new asteroid held a terrifying 3.1 percent chance of hitting Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Asteroid 2024 YR4 Flyby Still (noirlab2514c).jpg",
        "credit": "NOIRLab/NSF/AURA/R. Proctor",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Asteroid_2024_YR4_Flyby_Still_(noirlab2514c).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 1.967,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 1.967,
          "end": 4.733,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.721,
      "end": 15.191,
      "text": "On December 27, 2024, the ATLAS telescope in Chile spotted asteroid 2024 YR4 sneaking past a solar blind spot.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 4.733,
          "end": 15.2,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.191,
      "end": 22.136,
      "text": "This city-killer reached Level 3 on the Torino Scale, the highest impact hazard ever measured for its size.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 15.2,
          "end": 22.133,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.136,
      "end": 29.481,
      "text": "Roughly 53 to 67 meters wide, it packed the explosive punch of 8 megatons of TNT.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "2024 YR4 size comparison.png",
        "credit": "Sinucep",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:2024_YR4_size_comparison.png"
      },
      "shots": [
        {
          "start": 22.133,
          "end": 29.467,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 29.481,
      "end": 36.301,
      "text": "A potential impact corridor stretched across Nigeria and South America, threatening millions for several weeks.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Blue Marble 2002.png",
        "credit": "NASA\u2019s Terra satellite for the MODIS imageries, combined by Meow. Credit: NASA Goddard Space Flight Center Image by Reto St\u00f6ckli (land surface, shallow water, clouds). Enhancements by Robert Simmon (o",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Blue_Marble_2002.png"
      },
      "shots": [
        {
          "start": 29.467,
          "end": 33.933,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 33.933,
          "end": 36.3,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 36.301,
      "end": 44.021,
      "text": "Many feared a December 22, 2032 collision with an energy equivalent to 500 Hiroshima bombs.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Atomic bombing of Japan.jpg",
        "credit": "George R. Caron / Charles Levy",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Atomic_bombing_of_Japan.jpg"
      },
      "shots": [
        {
          "start": 36.3,
          "end": 40.167,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 40.167,
          "end": 44.033,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 44.021,
      "end": 52.671,
      "text": "Refined ground-based observatory and radar data cleared Earth, shifted the danger briefly to the Moon, and finally cleared both.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Vitino, RT-70 deep space radio telescope (planetary radar), Antenna, Crimea.jpg",
        "credit": "Vyacheslav Argenberg",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Vitino,_RT-70_deep_space_radio_telescope_(planetary_radar),_Antenna,_Crimea.jpg"
      },
      "shots": [
        {
          "start": 44.033,
          "end": 47.333,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 47.333,
          "end": 52.667,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 52.671,
      "end": 60.014,
      "text": "Now, astronomers only remember the panic when a new asteroid held a terrifying 3.1 percent chance of hitting Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Asteroid 2024 YR4 Flyby Still (noirlab2514c).jpg",
        "credit": "NOIRLab/NSF/AURA/R. Proctor",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Asteroid_2024_YR4_Flyby_Still_(noirlab2514c).jpg"
      },
      "shots": [
        {
          "start": 52.667,
