{
  "id": "ep266",
  "duration": 29.26,
  "beats": [
    {
      "start": 0.08,
      "end": 2.84,
      "text": "That faint white cloud in our night sky isn't vapor.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Ramsau bei Berchtesgaden (DE), Milchstra\u00dfe \u00fcber Hochkalter & Hintersee -- 2024 -- 1018-50.jpg",
        "credit": "Anil \u00d6ztas",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Ramsau_bei_Berchtesgaden_(DE),_Milchstra%C3%9Fe_%C3%BCber_Hochkalter_%26_Hintersee_--_2024_--_1018-50.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.833,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 2.84,
      "end": 6.06,
      "text": "For centuries, humans believed it was a hazy celestial fog.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Lehna Singh Majithia looking through telescope with pundit.jpg",
        "credit": "Unknown painter, scribed by Durgashankar Pathak",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Lehna_Singh_Majithia_looking_through_telescope_with_pundit.jpg"
      },
      "shots": [
        {
          "start": 2.833,
          "end": 6.067,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.06,
      "end": 8.96,
      "text": "Greek myth even claimed a goddess spilled her milk there.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Jacopo Tintoretto - The Origin of the Milky Way - Google Art Project.jpg",
        "credit": "Jacopo Tintoretto",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Jacopo_Tintoretto_-_The_Origin_of_the_Milky_Way_-_Google_Art_Project.jpg"
      },
      "shots": [
        {
          "start": 6.067,
          "end": 8.967,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.96,
      "end": 12.2,
      "text": "Then in 1610, Galileo aimed his telescope at the band.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Justus Sustermans - Portrait of Galileo Galilei, 1636.jpg",
        "credit": "Justus Sustermans",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Justus_Sustermans_-_Portrait_of_Galileo_Galilei,_1636.jpg"
      },
      "shots": [
        {
          "start": 8.967,
          "end": 10.9,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 10.9,
          "end": 12.2,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.2,
      "end": 15.92,
      "text": "The milky fog instantly vanished into countless individual stars.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "MapCam images the Milky Way galaxy.png",
        "credit": "NASA/Goddard/University of Arizona",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:MapCam_images_the_Milky_Way_galaxy.png"
      },
      "shots": [
        {
          "start": 12.2,
          "end": 15.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.92,
      "end": 18.9,
      "text": "They are so distant our naked eyes blur them together.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Galactic Cntr full cropped.jpg",
        "credit": "2MASS/G. Kopan, R. Hurt",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Galactic_Cntr_full_cropped.jpg"
      },
      "shots": [
        {
          "start": 15.933,
          "end": 18.9,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.9,
      "end": 22.22,
      "text": "Our disk actually holds up to 400 billion stars.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Milky Way galaxy1.jpg",
        "credit": "National Aeronautics and Space Administration",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Milky_Way_galaxy1.jpg"
      },
      "shots": [
        {
          "start": 18.9,
          "end": 22.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.22,
      "end": 25.04,
      "text": "They all orbit a black hole of four million suns.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Sagittarius A*.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Sagittarius_A*.jpg"
      },
      "shots": [
        {
          "start": 22.233,
          "end": 23.7,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 23.7,
          "end": 25.033,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.04,
      "end": 28.91,
      "text": "Yet to the unaided eye, our massive galaxy still looks like vapor.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Ramsau bei Berchtesgaden (DE), Milchstra\u00dfe \u00fcber Hochkalter & Hintersee -- 2024 -- 1018-50.jpg",
        "credit": "Anil \u00d6ztas",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Ramsau_bei_Berchtesgaden_(DE),_Milchstra%C3%9Fe_%C3%BCber_Hochkalter_%26_Hintersee_--_2024_--_1018-50.jpg"
      },
      "shots": [
        {
          "start": 25.033,
          "end": 29.267,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    }
  ],
