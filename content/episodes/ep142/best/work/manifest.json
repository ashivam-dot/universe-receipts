  "beats": [
    {
      "start": 0.08,
      "end": 5.448,
      "text": "A massive canyon system on Mars stretches nearly four thousand kilometers long.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Valles Marineris NASA World Wind map Mars.jpg",
        "credit": "Original uploader was Mk at pl.wikipedia",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Valles_Marineris_NASA_World_Wind_map_Mars.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 5.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 5.448,
      "end": 12.718,
      "text": "The historic Mariner 9 orbiter first revealed this colossal scar across the planet in nineteen seventy-one.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mariner09.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Mariner09.jpg"
      },
      "shots": [
        {
          "start": 5.433,
          "end": 9.067,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 9.067,
          "end": 12.733,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.718,
      "end": 18.938,
      "text": "Its staggering length matches the entire distance from New York City all the way to Los Angeles.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Tharsis Viking orbiter.jpg",
        "credit": "NASA/JPL/USGS",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Tharsis_Viking_orbiter.jpg"
      },
      "shots": [
        {
          "start": 12.733,
          "end": 15.833,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 15.833,
          "end": 18.933,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.938,
      "end": 25.883,
      "text": "This solar system record breaker plunges down to eleven kilometers deep in certain vast regions.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Melas Chasma THEMIS mosaic.jpg",
        "credit": "NASA / JPL-Caltech / Arizona State University",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Melas_Chasma_THEMIS_mosaic.jpg"
      },
      "shots": [
        {
          "start": 18.933,
          "end": 22.267,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 22.267,
          "end": 25.867,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.883,
      "end": 32.653,
      "text": "Ancient volcanic activity from the Tharsis bulge stressed the planetary crust until it split wide open.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Noctis Labyrinthus Viking 1 1980.png",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Noctis_Labyrinthus_Viking_1_1980.png"
      },
      "shots": [
        {
          "start": 25.867,
          "end": 32.667,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 32.653,
      "end": 40.773,
      "text": "Colossal gravitational landslides then widened the gorge, sending debris rushing over a hundred kilometers across the floor.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Candor Chasma THEMIS mosaic.jpg",
        "credit": "NASA / JPL-Caltech / Arizona State University",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Candor_Chasma_THEMIS_mosaic.jpg"
      },
      "shots": [
        {
          "start": 32.667,
          "end": 37.967,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 37.967,
          "end": 40.767,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 40.773,
      "end": 47.323,
      "text": "Hydrated minerals preserved inside prove ancient water once helped shape this record breaker.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Fresh Crater North of Coprates Chasma.jpg",
        "credit": "NASA HiRISE camera, Mars Reconnaissance Orbiter.",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Fresh_Crater_North_of_Coprates_Chasma.jpg"
      },
      "shots": [
        {
          "start": 40.767,
