  "beats": [
    {
      "start": 0.08,
      "end": 5.447,
      "text": "A massive canyon system on Mars stretches nearly four thousand kilometers long.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Valles Marineris NASA World Wind map Mars.jpg",
        "credit": "Original uploader was Mk at pl.wikipedia",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Valles_Marineris_NASA_World_Wind_map_Mars.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 5.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 5.447,
      "end": 12.042,
      "text": "The historic Mariner 9 mission first revealed this breathtaking Martian scar in nineteen seventy-one.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mariner09.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Mariner09.jpg"
      },
      "shots": [
        {
          "start": 5.433,
          "end": 8.733,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 8.733,
          "end": 12.033,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.042,
      "end": 17.937,
      "text": "Its total length is directly comparable to the distance from New York City to Los Angeles.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "USGS-Mars-MC-17-PhoenicisRegion-mola.png",
        "credit": "USGS (United States Geological Survey)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:USGS-Mars-MC-17-PhoenicisRegion-mola.png"
      },
      "shots": [
        {
          "start": 12.033,
          "end": 15.367,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 15.367,
          "end": 17.933,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.937,
      "end": 23.632,
      "text": "The colossal trench plunges up to eleven kilometers deep in certain prominent regions.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Melas Chasma THEMIS mosaic.jpg",
        "credit": "NASA / JPL-Caltech / Arizona State University",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Melas_Chasma_THEMIS_mosaic.jpg"
      },
      "shots": [
        {
          "start": 17.933,
          "end": 20.1,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 20.1,
          "end": 23.633,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.632,
      "end": 30.177,
      "text": "Ancient volcanic activity from the Tharsis bulge stressed the planetary crust until it cracked open.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Noctis Labyrinthus Zoom.jpg",
        "credit": "NASA/JPL/USGS",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Noctis_Labyrinthus_Zoom.jpg"
      },
      "shots": [
        {
          "start": 23.633,
          "end": 26.233,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 26.233,
          "end": 30.167,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 30.177,
      "end": 37.747,
      "text": "Colossal gravitational landslides then widened the scar, sending debris rushing over a hundred kilometers across.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "ESP 012018 1750 (23804865246).jpg",
        "credit": "UAHiRISE (NASA)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:ESP_012018_1750_(23804865246).jpg"
      },
      "shots": [
        {
          "start": 30.167,
          "end": 35.367,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 35.367,
          "end": 37.733,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 37.747,
      "end": 45.047,
      "text": "Hydrated sulfate minerals like jarosite hide inside this remarkable solar system record breaker.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Coprates Chasma based on THEMIS Day IR.png",
        "credit": "NASA, modified by Chmee2",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Coprates_Chasma_based_on_THEMIS_Day_IR.png"
      },
