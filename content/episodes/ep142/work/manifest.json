  "beats": [
    {
      "start": 0.08,
      "end": 3.786,
      "text": "This Martian canyon stretches from New York to Los Angeles.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Valles Marineris NASA World Wind map Mars.jpg",
        "credit": "Original uploader was Mk at pl.wikipedia",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Valles_Marineris_NASA_World_Wind_map_Mars.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.8,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.786,
      "end": 11.181,
      "text": "In nineteen seventy-one, the Mariner 9 orbiter discovered this massive scar slashed across the Martian equator.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mariner09.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Mariner09.jpg"
      },
      "shots": [
        {
          "start": 3.8,
          "end": 7.467,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 7.467,
          "end": 11.167,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.181,
      "end": 16.226,
      "text": "Spanning four thousand kilometers, it makes the Grand Canyon look like a crack.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "GrandCanyon.NASA.2014.jpg",
        "credit": "Astronaut photograph ISS039-E-5258; taken by the Expedition 39 crew of the International Space Station;",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:GrandCanyon.NASA.2014.jpg"
      },
      "shots": [
        {
          "start": 11.167,
          "end": 16.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.226,
      "end": 21.971,
      "text": "This system plunges eleven kilometers deep, four times the depth of any gorge on Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Melas Chasma THEMIS mosaic.jpg",
        "credit": "NASA / JPL-Caltech / Arizona State University",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Melas_Chasma_THEMIS_mosaic.jpg"
      },
      "shots": [
        {
          "start": 16.233,
          "end": 18.6,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 18.6,
          "end": 21.967,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.971,
      "end": 28.566,
      "text": "It didn't form from a slow river, but from the planet literally tearing itself apart three billion years ago.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Noctis Labyrinthus based on day THEMIS.png",
        "credit": "NASA, modified by Chmee2",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Noctis_Labyrinthus_based_on_day_THEMIS.png"
      },
      "shots": [
        {
          "start": 21.967,
          "end": 25.5,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 25.5,
          "end": 28.567,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 28.566,
      "end": 35.786,
      "text": "The immense weight of the Tharsis volcanic bulge cracked the crust, and colossal landslides widened the jagged gap.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Tharsis Bulge Cross-Sections -2 (4081335424).jpg",
        "credit": "Lunar and Planetary Institute from Houston, TX, USA",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Tharsis_Bulge_Cross-Sections_-2_(4081335424).jpg"
      },
      "shots": [
        {
          "start": 28.567,
          "end": 33.333,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 33.333,
          "end": 35.8,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 35.786,
      "end": 41.386,
      "text": "Preserved minerals prove that ancient, rushing water once helped carve this giant.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Layered Deposits in Southwest Candor Chasma - Mars Reconnaissance Orbiter (50525238001).png",
        "credit": "Justin Cowart",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Layered_Deposits_in_Southwest_Candor_Chasma_-_Mars_Reconnaissance_Orbiter_(50525238001).png"
      },
      "shots": [
        {
          "start": 35.8,
          "end": 38.3,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 38.3,
          "end": 41.4,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 41.386,
      "end": 43.796,
      "text": "These cataclysms are exactly why",
      "asset": {
