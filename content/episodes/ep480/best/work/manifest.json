{
  "id": "ep480",
  "duration": 31.505,
  "beats": [
    {
      "start": 0.08,
      "end": 3.6,
      "text": "Our solar system is drifting through a massive hollow cavity.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Local bubble.jpg",
        "credit": "NASA; modified from original version by User:Geni",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Local_bubble.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.6,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.6,
      "end": 8.86,
      "text": "Roughly 15 ancient supernovas blasted this hole 1,000 light-years wide.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The Supernova scenario (eso0509d).tiff",
        "credit": "ESO",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:The_Supernova_scenario_(eso0509d).tiff"
      },
      "shots": [
        {
          "start": 3.6,
          "end": 5.7,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 5.7,
          "end": 8.867,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.86,
      "end": 12.64,
      "text": "It's filled with thin plasma heated to a million degrees.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "XRISM Clocks Hot Wind of Galaxy M82 (SVS14968 - M82 Chandra 1kpc Inset labels).jpg",
        "credit": "NASA's Scientific Visualization Studio - eMITS/Scott Wiessinger, University of Maryland College Park/Jeanette Kazmierczak, University of Maryland College Park/Francis Reddy",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:XRISM_Clocks_Hot_Wind_of_Galaxy_M82_(SVS14968_-_M82_Chandra_1kpc_Inset_labels).jpg"
      },
      "shots": [
        {
          "start": 8.867,
          "end": 12.633,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.64,
      "end": 17.4,
      "text": "Deep-sea crust on Earth still holds radioactive iron from those explosions.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Seafloor Crust USGS.jpg",
        "credit": "Amy West, USGS Science Communications Contractor",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Seafloor_Crust_USGS.jpg"
      },
      "shots": [
        {
          "start": 12.633,
          "end": 17.4,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.4,
      "end": 21.0,
      "text": "This giant bubble triggered the birth of every nearby star.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The young stars of Taurus (potw2526a).jpg",
        "credit": "ESA/Hubble & NASA, G. Duch\u00eane",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:The_young_stars_of_Taurus_(potw2526a).jpg"
      },
      "shots": [
        {
          "start": 17.4,
          "end": 21.0,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.0,
      "end": 25.42,
      "text": "Newborn star nurseries like Taurus sit on its shell, expanding outward.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Rho Ophiuchi (NIRCam Compass Image) (2023-128).png",
        "credit": "Image",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Rho_Ophiuchi_(NIRCam_Compass_Image)_(2023-128).png"
      },
      "shots": [
        {
          "start": 21.0,
          "end": 25.433,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.42,
      "end": 28.4,
      "text": "We didn't grow up here; we just wandered into the void.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Young \u2018Sun\u2019 Caught Blowing Bubbles by NASA\u2019s Chandra (astrosphere-illus).jpg",
        "credit": "NASA/Goddard Space Flight Center, Conceptual Image Lab",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Young_%E2%80%98Sun%E2%80%99_Caught_Blowing_Bubbles_by_NASA%E2%80%99s_Chandra_(astrosphere-illus).jpg"
      },
      "shots": [
        {
          "start": 25.433,
          "end": 28.4,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 28.4,
      "end": 31.155,
      "text": "The Sun is currently drifting through its very center.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Local bubble.jpg",
        "credit": "NASA; modified from original version by User:Geni",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Local_bubble.jpg"
      },
      "shots": [
        {
          "start": 28.4,
          "end": 31.5,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
