{
  "id": "ep480",
  "duration": 32.52,
  "beats": [
    {
      "start": 0.08,
      "end": 3.66,
      "text": "Our solar system is drifting through a massive hollow cavity.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Local bubble.jpg",
        "credit": "NASA; modified from original version by User:Geni",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Local_bubble.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.667,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.66,
      "end": 8.42,
      "text": "Roughly 15 ancient supernovas blasted this hole 1,000 light-years wide.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The Supernova scenario (eso0509d).tiff",
        "credit": "ESO",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:The_Supernova_scenario_(eso0509d).tiff"
      },
      "shots": [
        {
          "start": 3.667,
          "end": 5.933,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 5.933,
          "end": 8.433,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.42,
      "end": 12.08,
      "text": "This void is filled with plasma heated to a million degrees.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NGC 7635HSTFull.jpg",
        "credit": "NASA, Donald Walter (South Carolina State University), Paul Scowen and Brian Moore (Arizona State University)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:NGC_7635HSTFull.jpg"
      },
      "shots": [
        {
          "start": 8.433,
          "end": 12.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.08,
      "end": 16.64,
      "text": "Deep-sea crust on Earth still holds radioactive iron from those explosions.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Seafloor Crust USGS.jpg",
        "credit": "Amy West, USGS Science Communications Contractor",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Seafloor_Crust_USGS.jpg"
      },
      "shots": [
        {
          "start": 12.067,
          "end": 16.633,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.64,
      "end": 20.62,
      "text": "The shockwaves triggered the birth of every star within 500 light-years.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The young stars of Taurus (potw2526a).jpg",
        "credit": "ESA/Hubble & NASA, G. Duch\u00eane",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:The_young_stars_of_Taurus_(potw2526a).jpg"
      },
      "shots": [
        {
          "start": 16.633,
          "end": 20.633,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.62,
      "end": 24.7,
      "text": "Newborn nurseries like the Taurus cloud sit on the bubble's expanding edge.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Rho Ophiuchi (NIRCam Compass Image) (2023-128).png",
        "credit": "Image",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Rho_Ophiuchi_(NIRCam_Compass_Image)_(2023-128).png"
      },
      "shots": [
        {
          "start": 20.633,
          "end": 24.7,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.7,
      "end": 28.88,
      "text": "Surprisingly, our Sun didn't carve this void; we just drifted into it recently.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Solar System- EIC Display (SVS5674 - 4).jpg",
        "credit": "NASA's Scientific Visualization Studio - Science and Technology Corporation/Kel Elkins",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Solar_System-_EIC_Display_(SVS5674_-_4).jpg"
      },
      "shots": [
        {
          "start": 24.7,
          "end": 28.867,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 28.88,
      "end": 32.17,
      "text": "Leaving us passing directly through a massive hollow cavity.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Local bubble.jpg",
        "credit": "NASA; modified from original version by User:Geni",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Local_bubble.jpg"
      },
      "shots": [
        {
          "start": 28.867,
          "end": 32.533,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
