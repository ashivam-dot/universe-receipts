  "beats": [
    {
      "start": 0.08,
      "end": 4.13,
      "text": "A giant shadow blocked up to twenty-two percent of a star's light.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Swarm of Comets (Artist's Concept).tif",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Swarm_of_Comets_(Artist%27s_Concept).tif"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 1.7,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 1.7,
          "end": 4.133,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.13,
      "end": 11.225,
      "text": "In 2015, citizen scientists using NASA's Kepler telescope found a weirdly behaving star.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Telescope Kepler-NASA.jpeg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Telescope_Kepler-NASA.jpeg"
      },
      "shots": [
        {
          "start": 4.133,
          "end": 11.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.225,
      "end": 16.745,
      "text": "This star, later named Tabby's Star, dimmed erratically by up to 22 percent.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Cygnus (cyg).jpg",
        "credit": "IAU and Sky & Telescope",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Cygnus_(cyg).jpg"
      },
      "shots": [
        {
          "start": 11.233,
          "end": 13.2,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 13.2,
          "end": 16.733,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.745,
      "end": 21.94,
      "text": "A normal planet like Jupiter blocks only about 1 percent of a star's light.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist\u2019s impression of an ultra-hot Jupiter transiting its star (eso2213a).tiff",
        "credit": "ESO/M. Kornmesser",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%E2%80%99s_impression_of_an_ultra-hot_Jupiter_transiting_its_star_(eso2213a).tiff"
      },
      "shots": [
        {
          "start": 16.733,
          "end": 19.2,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 19.2,
          "end": 21.933,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.94,
      "end": 28.06,
      "text": "To explain the massive dip, some researchers speculated we were seeing an alien megastructure.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Dyson Swarm.png",
        "credit": "Original uploader was Vedexent at en.wikipedia, converted to png by Falcorian",
        "license": "CC BY 2.5",
        "url": "https://commons.wikimedia.org/wiki/File:Dyson_Swarm.png"
      },
      "shots": [
        {
          "start": 21.933,
          "end": 28.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 28.06,
      "end": 34.835,
      "text": "But telescopes showed the light dims differently depending on its wavelength, ruling out solid structures.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Kathycsus - Hat Creek Radio Observatory (by).jpg",
        "credit": "Kathleen Franklin from Marysville, CA, USA",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Kathycsus_-_Hat_Creek_Radio_Observatory_(by).jpg"
      },
      "shots": [
        {
          "start": 28.067,
          "end": 31.333,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 31.333,
          "end": 34.833,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 34.835,
      "end": 41.605,
      "text": "Instead, a massive cloud of space dust, possibly from an evaporating exomoon, is blocking the light.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "WASP-49b-Exomoon Wide-view-artists-concept.jpg",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:WASP-49b-Exomoon_Wide-view-artists-concept.jpg"
      },
      "shots": [
        {
          "start": 34.833,
          "end": 38.467,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 38.467,
          "end": 41.6,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 41.605,
      "end": 46.448,
      "text": "This swirling dust is the true cosmic culprit casting that giant shadow.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Swarm of Comets (Artist's Concept).tif",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Swarm_of_Comets_(Artist%27s_Concept).tif"
      },
      "shots": [
        {
          "start": 41.6,
          "end": 46.8,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
