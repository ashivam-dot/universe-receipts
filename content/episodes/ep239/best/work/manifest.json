{
  "id": "ep239",
  "duration": 52.844,
  "beats": [
    {
      "start": 0.08,
      "end": 4.481,
      "text": "Deep beyond Neptune, a giant frozen world is stretched into an egg.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Transneptunianobjects-truecolour.png",
        "credit": "UnderTheVoid",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Transneptunianobjects-truecolour.png"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.933,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 2.933,
          "end": 4.467,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.481,
      "end": 11.501,
      "text": "In 2004, astronomers tracking the Kuiper Belt noticed a distant point of light flashing wildly.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 4.467,
          "end": 11.5,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.501,
      "end": 19.096,
      "text": "That rapidly flickering brightness revealed a dwarf planet completing a full rotation every 3.9 hours.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Recurring Planetary Debris Transits and Circumstellar Gas around White Dwarf ZTF J0328\u22121219 (Figure 2).png",
        "credit": "Vanderbosch et al., published in the Astrophysical Journal",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Recurring_Planetary_Debris_Transits_and_Circumstellar_Gas_around_White_Dwarf_ZTF_J0328%E2%88%921219_(Figure_2).png"
      },
      "shots": [
        {
          "start": 11.5,
          "end": 19.1,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.096,
      "end": 26.671,
      "text": "Massive centrifugal force from the fastest spin in the solar system stretched its rocky body completely out of round.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Ellipsoid quadric.png",
        "credit": "Rectas",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Ellipsoid_quadric.png"
      },
      "shots": [
        {
          "start": 19.1,
          "end": 26.667,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 26.671,
      "end": 31.941,
      "text": "An ancient catastrophic collision likely kicked off this extreme rotation rate.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist's concept of collision at HD 172555.jpg",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%27s_concept_of_collision_at_HD_172555.jpg"
      },
      "shots": [
        {
          "start": 26.667,
          "end": 29.967,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 29.967,
          "end": 31.933,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 31.941,
      "end": 38.736,
      "text": "In 2017, as the world passed before a distant star, starlight blinked twice unexpectedly.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Light curve of binary star Kepler-16.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Light_curve_of_binary_star_Kepler-16.jpg"
      },
      "shots": [
        {
          "start": 31.933,
          "end": 38.733,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 38.736,
      "end": 46.561,
      "text": "That subtle shadow exposed a dark ring system approximately 70 kilometers wide encircling the object.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "TNOAni2.png",
        "credit": "Sillybillyreally ugh",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:TNOAni2.png"
      },
      "shots": [
        {
          "start": 38.733,
          "end": 46.567,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 46.561,
      "end": 52.494,
      "text": "Designated Haumea, an ancient cosmic collision created a world that defies normal physics.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Transneptunianobjects-truecolour.png",
        "credit": "UnderTheVoid",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Transneptunianobjects-truecolour.png"
      },
      "shots": [
        {
          "start": 46.567,
          "end": 52.833,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
