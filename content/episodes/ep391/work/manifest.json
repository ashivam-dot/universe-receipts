{
  "id": "ep391",
  "duration": 32.566,
  "beats": [
    {
      "start": 0.08,
      "end": 3.76,
      "text": "Astronomers beamed a cosmic greeting to an empty target.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Arecibo Observatory Aerial View.jpg",
        "credit": "H. Schweiker/WIYN and NOAO/AURA/NSF",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Arecibo_Observatory_Aerial_View.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.767,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.76,
      "end": 7.94,
      "text": "Astronomer Frank Drake broadcast a three-minute transmission from Puerto Rico in 1974.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Dr. Frank Drake.jpg",
        "credit": "Raphael Perrino",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Dr._Frank_Drake.jpg"
      },
      "shots": [
        {
          "start": 3.767,
          "end": 7.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.94,
      "end": 11.98,
      "text": "Carl Sagan helped encode 1,679 radio pulses into a grid.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Planetary society.jpg",
        "credit": "credit NASA JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Planetary_society.jpg"
      },
      "shots": [
        {
          "start": 7.933,
          "end": 11.967,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.98,
      "end": 16.14,
      "text": "Decoded, the pixels showed numbers, human DNA, and our Solar System.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Solar System PIA00545.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Solar_System_PIA00545.jpg"
      },
      "shots": [
        {
          "start": 11.967,
          "end": 16.133,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.14,
      "end": 20.04,
      "text": "The signal targeted a massive cluster 25,000 light-years away.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hubble image of globular cluster M13 (opo0840a).jpg",
        "credit": "NASA, ESA, and the Hubble Heritage Team (STScI/AURA)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Hubble_image_of_globular_cluster_M13_(opo0840a).jpg"
      },
      "shots": [
        {
          "start": 16.133,
          "end": 20.033,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.04,
      "end": 22.96,
      "text": "Any alien answer would take 50,000 years to return.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 20.033,
          "end": 22.967,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.96,
      "end": 26.22,
      "text": "But that star cluster orbits the center of our galaxy.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Milky Way Anatomy (SVS14935).jpg",
        "credit": "NASA's Scientific Visualization Studio - eMITS/Scott Wiessinger, eMITS/Adriana Manrique Gutierrez, eMITS/Ashley Balzer",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Milky_Way_Anatomy_(SVS14935).jpg"
      },
      "shots": [
        {
          "start": 22.967,
          "end": 26.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 26.22,
      "end": 28.78,
      "text": "When the broadcast arrives, those stars will have moved away.",
      "asset": {
        "source": "Flickr via Openverse",
        "title": "Messier 13, the great Globular Cluster in Hercules. DSLR Image",
        "credit": "kees scherer",
        "license": "CC0",
        "url": "https://www.flickr.com/photos/50769593@N00/26577255860"
      },
      "shots": [
        {
          "start": 26.233,
          "end": 28.767,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 28.78,
      "end": 32.216,
      "text": "We really did beam a greeting to an empty target.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Arecibo Observatory Aerial View.jpg",
        "credit": "H. Schweiker/WIYN and NOAO/AURA/NSF",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Arecibo_Observatory_Aerial_View.jpg"
      },
      "shots": [
        {
          "start": 28.767,
          "end": 32.567,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
