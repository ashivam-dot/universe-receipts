{
  "id": "ep373",
  "duration": 31.22,
  "beats": [
    {
      "start": 0.08,
      "end": 3.38,
      "text": "A Saturn V rocket generated the lightning that struck it.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Apollo 12 space vehicle is launched from Pad A.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Apollo_12_space_vehicle_is_launched_from_Pad_A.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.367,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.38,
      "end": 5.56,
      "text": "Many assume Apollo 12 hit a random storm.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PAD 39A - SKYLAB (SL)-I - KSC (S73-26911).jpg",
        "credit": "NASA Johnson Space Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PAD_39A_-_SKYLAB_(SL)-I_-_KSC_(S73-26911).jpg"
      },
      "shots": [
        {
          "start": 3.367,
          "end": 5.567,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 5.56,
      "end": 8.56,
      "text": "In reality, its metal body and exhaust triggered the bolts.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Saturn V cutaway.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Saturn_V_cutaway.jpg"
      },
      "shots": [
        {
          "start": 5.567,
          "end": 8.567,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.56,
      "end": 11.54,
      "text": "Thirty-six seconds after liftoff, the first bolt struck.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "AS07-08-1934 - Apollo 7 - Apollo 7 Mission, Florida - NARA - 16666733.jpg",
        "credit": "Unknown authorUnknown author or not provided",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:AS07-08-1934_-_Apollo_7_-_Apollo_7_Mission,_Florida_-_NARA_-_16666733.jpg"
      },
      "shots": [
        {
          "start": 8.567,
          "end": 11.533,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.54,
      "end": 15.28,
      "text": "All three fuel cells disconnected, flooding the cockpit with warning lights.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Apollo Command Module Panel (5386054271).jpg",
        "credit": "Steve Jurvetson from Los Altos, USA",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Apollo_Command_Module_Panel_(5386054271).jpg"
      },
      "shots": [
        {
          "start": 11.533,
          "end": 15.267,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.28,
      "end": 19.02,
      "text": "A second strike at 52 seconds turned telemetry into gibberish.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 15.267,
          "end": 19.033,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.02,
      "end": 22.3,
      "text": "Fortunately, the rocket's independent guidance system kept flying true.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Saturn V Instrument Unit.jpg",
        "credit": "NASA/MSFC",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Saturn_V_Instrument_Unit.jpg"
      },
      "shots": [
        {
          "start": 19.033,
          "end": 22.3,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.3,
      "end": 25.18,
      "text": "Flight controller John Aaron called out a switch from an earlier test.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "John Aaron EECOM.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:John_Aaron_EECOM.jpg"
      },
      "shots": [
        {
          "start": 22.3,
          "end": 25.167,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.18,
      "end": 28.0,
      "text": "Astronaut Alan Bean flipped it, restoring telemetry instantly.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Bean Samples The Ocean of Storms - GPN-2000-001103.jpg",
        "credit": "NASA Charles Conrad Jr",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Bean_Samples_The_Ocean_of_Storms_-_GPN-2000-001103.jpg"
      },
      "shots": [
        {
          "start": 25.167,
          "end": 28.0,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 28.0,
      "end": 30.869,
      "text": "The mission survived lightning of its own making.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Apollo 12 space vehicle is launched from Pad A.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Apollo_12_space_vehicle_is_launched_from_Pad_A.jpg"
      },
      "shots": [
        {
          "start": 28.0,
          "end": 31.233,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    }
  ],
