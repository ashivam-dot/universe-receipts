{
  "id": "ep373",
  "duration": 29.254,
  "beats": [
    {
      "start": 0.08,
      "end": 3.04,
      "text": "A Saturn V rocket generated the lightning that struck it.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Apollo-12-Lancering.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Apollo-12-Lancering.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.033,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.04,
      "end": 6.24,
      "text": "Most assume Apollo 12 hit a random Florida storm.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Apollo 12 launches from Kennedy Space Center.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Apollo_12_launches_from_Kennedy_Space_Center.jpg"
      },
      "shots": [
        {
          "start": 3.033,
          "end": 6.233,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.24,
      "end": 9.74,
      "text": "Actually, the massive rocket and its exhaust triggered the bolts.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Saturn V cutaway.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Saturn_V_cutaway.jpg"
      },
      "shots": [
        {
          "start": 6.233,
          "end": 9.733,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.74,
      "end": 12.74,
      "text": "The first strike hit 36 seconds in, killing the power.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Guidance and Navigation Indicator Control Panel.jpg",
        "credit": "Steve Jurvetson",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Guidance_and_Navigation_Indicator_Control_Panel.jpg"
      },
      "shots": [
        {
          "start": 9.733,
          "end": 12.733,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.74,
      "end": 15.94,
      "text": "A second strike turned mission data into total gibberish.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 12.733,
          "end": 15.933,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.94,
      "end": 19.12,
      "text": "Controller John Aaron recognized the failure from an obscure test.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "John Aaron EECOM.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:John_Aaron_EECOM.jpg"
      },
      "shots": [
        {
          "start": 15.933,
          "end": 19.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.12,
      "end": 22.04,
      "text": "He ordered the crew to flip the SCE switch to auxiliary.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 19.133,
          "end": 22.033,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.04,
      "end": 24.98,
      "text": "Alan Bean did, restoring data and saving the mission.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Alan Bean NASA portrait (S69-38859).jpg",
        "credit": "NASA / Johnson Space Center (NASA-JSC)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Alan_Bean_NASA_portrait_(S69-38859).jpg"
      },
      "shots": [
        {
          "start": 22.033,
          "end": 24.0,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 24.0,
          "end": 24.967,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.98,
      "end": 28.904,
      "text": "The crew survived because a Saturn V rocket generated the lightning that struck it.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Apollo-12-Lancering.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Apollo-12-Lancering.jpg"
      },
      "shots": [
        {
          "start": 24.967,
          "end": 29.267,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
