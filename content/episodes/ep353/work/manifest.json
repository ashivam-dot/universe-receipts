{
  "id": "ep353",
  "duration": 26.827,
  "beats": [
    {
      "start": 0.08,
      "end": 3.9,
      "text": "NASA's first communications satellite was a giant silver balloon.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Echo - A Passive Communications Satellite - GPN-2002-000122.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Echo_-_A_Passive_Communications_Satellite_-_GPN-2002-000122.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.9,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.9,
      "end": 7.08,
      "text": "It stretched a massive one hundred feet across in space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Inflation Tests of the Echo 1 Satellite in Weeksville, N C (LRC-1958-B701 P-03600).tiff",
        "credit": "NASA Langley Research Center / NACA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Inflation_Tests_of_the_Echo_1_Satellite_in_Weeksville,_N_C_(LRC-1958-B701_P-03600).tiff"
      },
      "shots": [
        {
          "start": 3.9,
          "end": 7.067,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.08,
      "end": 10.18,
      "text": "Engineers built it from thin plastic film coated with aluminum.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "DRAWING OF ALUMINIZED MYLAR - NARA - 17468019.jpg",
        "credit": "Unknown authorUnknown author or not provided",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:DRAWING_OF_ALUMINIZED_MYLAR_-_NARA_-_17468019.jpg"
      },
      "shots": [
        {
          "start": 7.067,
          "end": 10.167,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.18,
      "end": 13.12,
      "text": "Workers packed the massive sphere into a tiny canister.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Echo 1 payload mounted at top of third-stage Thor-Delta launch vehicle.png",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Echo_1_payload_mounted_at_top_of_third-stage_Thor-Delta_launch_vehicle.png"
      },
      "shots": [
        {
          "start": 10.167,
          "end": 12.033,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 12.033,
          "end": 13.133,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.12,
      "end": 16.4,
      "text": "Once in orbit, it inflated into a gleaming sky mirror.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Echo I 1960 Issue-4c.jpg",
        "credit": "US Post office",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Echo_I_1960_Issue-4c.jpg"
      },
      "shots": [
        {
          "start": 13.133,
          "end": 16.4,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.4,
      "end": 19.3,
      "text": "This mirror bounced the first satellite phone calls across Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PioneerDeepSpaceStation2.jpg",
        "credit": "unknown NASA employee",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PioneerDeepSpaceStation2.jpg"
      },
      "shots": [
        {
          "start": 16.4,
          "end": 19.3,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.3,
      "end": 23.22,
      "text": "But its tracking antenna also accidentally heard the Big Bang.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Horn Antenna-in Holmdel, New Jersey.jpeg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Horn_Antenna-in_Holmdel,_New_Jersey.jpeg"
      },
      "shots": [
        {
          "start": 19.3,
          "end": 23.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.22,
      "end": 26.477,
      "text": "And to think, it all started as a giant silver balloon.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Echo - A Passive Communications Satellite - GPN-2002-000122.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Echo_-_A_Passive_Communications_Satellite_-_GPN-2002-000122.jpg"
      },
      "shots": [
        {
          "start": 23.233,
          "end": 26.833,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
