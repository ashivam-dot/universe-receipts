{
  "id": "ep353",
  "duration": 27.252,
  "beats": [
    {
      "start": 0.08,
      "end": 4.08,
      "text": "NASA's first communications satellite was a giant silver balloon.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Echo II.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Echo_II.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.08,
      "end": 6.68,
      "text": "It stretched a massive one hundred feet across.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Thor Delta with Explorer 10 Mar 25 1961.jpg",
        "credit": "Unknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Thor_Delta_with_Explorer_10_Mar_25_1961.jpg"
      },
      "shots": [
        {
          "start": 4.067,
          "end": 6.667,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.68,
      "end": 9.58,
      "text": "Engineers built it from thin Mylar coated with aluminum.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "DRAWING OF ALUMINIZED MYLAR - NARA - 17468019.jpg",
        "credit": "Unknown authorUnknown author or not provided",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:DRAWING_OF_ALUMINIZED_MYLAR_-_NARA_-_17468019.jpg"
      },
      "shots": [
        {
          "start": 6.667,
          "end": 9.567,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.58,
      "end": 12.6,
      "text": "Workers packed the massive sphere into a tiny canister for launch.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Echo 1 payload mounted at top of third-stage Thor-Delta launch vehicle.png",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Echo_1_payload_mounted_at_top_of_third-stage_Thor-Delta_launch_vehicle.png"
      },
      "shots": [
        {
          "start": 9.567,
          "end": 12.6,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.6,
      "end": 16.18,
      "text": "Once in orbit, it inflated into a gleaming mirror in the sky.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Echo I 1960 Issue-4c.jpg",
        "credit": "US Post office",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Echo_I_1960_Issue-4c.jpg"
      },
      "shots": [
        {
          "start": 12.6,
          "end": 16.167,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.18,
      "end": 19.84,
      "text": "The bright orb bounced the very first satellite phone calls across Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Goldstone DSN antenna.jpg",
        "credit": "Unknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Goldstone_DSN_antenna.jpg"
      },
      "shots": [
        {
          "start": 16.167,
          "end": 19.833,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.84,
      "end": 24.32,
      "text": "Even wilder, its tracking antenna accidentally discovered the echoes of the Big Bang.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Horn Antenna-in Holmdel, New Jersey.jpeg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Horn_Antenna-in_Holmdel,_New_Jersey.jpeg"
      },
      "shots": [
        {
          "start": 19.833,
          "end": 22.967,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 22.967,
          "end": 24.333,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.32,
      "end": 26.902,
      "text": "It all started as a giant silver balloon.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Echo II.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Echo_II.jpg"
      },
      "shots": [
        {
          "start": 24.333,
          "end": 27.267,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
