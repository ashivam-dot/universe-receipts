{
  "id": "ep457",
  "duration": 31.46,
  "beats": [
    {
      "start": 0.08,
      "end": 2.64,
      "text": "Alan Shepard never hit a golf ball for miles.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Apollo 14 Shepard.jpg",
        "credit": "Edgar D. Mitchell / NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Apollo_14_Shepard.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.633,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 2.64,
      "end": 6.48,
      "text": "During Apollo 14, he dropped two golf balls into lunar dust.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Apollo 14 Shepard.jpg",
        "credit": "Edgar D. Mitchell / NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Apollo_14_Shepard.jpg"
      },
      "shots": [
        {
          "start": 2.633,
          "end": 6.467,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.48,
      "end": 9.82,
      "text": "Shepard attached a Wilson six-iron head to a rock collection tool.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Alan Shepard and his golf club - Apollo 14 (46953937601).jpg",
        "credit": "Kevin M. Gill",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Alan_Shepard_and_his_golf_club_-_Apollo_14_(46953937601).jpg"
      },
      "shots": [
        {
          "start": 6.467,
          "end": 8.033,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 8.033,
          "end": 9.833,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.82,
      "end": 13.48,
      "text": "His bulky, rigid spacesuit forced him to swing with one hand.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Apollo 14 - Station B2 Up-Sun View.jpg",
        "credit": "NASA/Alan Shepherd/Edgar Mitchell",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Apollo_14_-_Station_B2_Up-Sun_View.jpg"
      },
      "shots": [
        {
          "start": 9.833,
          "end": 13.467,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.48,
      "end": 17.3,
      "text": "On camera, Shepard exclaimed that his second shot flew miles and miles.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Television transmission at end of second extravehicular activity (s71-20784).jpg",
        "credit": "NASA Johnson Space Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Television_transmission_at_end_of_second_extravehicular_activity_(s71-20784).jpg"
      },
      "shots": [
        {
          "start": 13.467,
          "end": 16.133,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 16.133,
          "end": 17.3,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.3,
      "end": 21.72,
      "text": "Experts checked the drive using digitally enhanced photo analysis in 2021.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "LROC\u2019s First Look at the Apollo Landing Sites (LROC157 - A16LEMa 1000).png",
        "credit": "NASA/GSFC/Arizona State University",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:LROC%E2%80%99s_First_Look_at_the_Apollo_Landing_Sites_(LROC157_-_A16LEMa_1000).png"
      },
      "shots": [
        {
          "start": 17.3,
          "end": 21.733,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.72,
      "end": 25.2,
      "text": "His first golf ball traveled approximately 24 yards.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "AS14-68-9406 - Apollo 14 - Apollo 14 Mission image - View of MET tracks and footprints on the lunar surface. - NARA - 16697985.jpg",
        "credit": "Unknown authorUnknown author or not provided",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:AS14-68-9406_-_Apollo_14_-_Apollo_14_Mission_image_-_View_of_MET_tracks_and_footprints_on_the_lunar_surface._-_NARA_-_16697985.jpg"
      },
      "shots": [
        {
          "start": 21.733,
          "end": 25.2,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.2,
      "end": 27.58,
      "text": "His second shot reached only about 40 yards.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 25.2,
          "end": 27.567,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 27.58,
      "end": 31.11,
      "text": "That legendary swing never launched anything for miles.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Apollo 14 Shepard.jpg",
        "credit": "Edgar D. Mitchell / NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Apollo_14_Shepard.jpg"
      },
      "shots": [
        {
          "start": 27.567,
          "end": 31.467,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    }
  ],
