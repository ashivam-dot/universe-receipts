{
  "id": "ep114",
  "duration": 48.08,
  "beats": [
    {
      "start": 0.08,
      "end": 3.934,
      "text": "A cosmic signal reached Earth fainter than a lunar cell phone.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist\u2019s impression of a record-breaking fast radio burst (eso2317a).jpg",
        "credit": "ESO/M. Kornmesser",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%E2%80%99s_impression_of_a_record-breaking_fast_radio_burst_(eso2317a).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.934,
      "end": 12.104,
      "text": "In 2007, astrophysicist Duncan Lorimer discovered this weak whisper in archival data from 2001.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "CSIRO ScienceImage 4350 CSIROs Parkes Radio Telescope with moon in the background.jpg",
        "credit": "division, CSIRO",
        "license": "CC BY 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:CSIRO_ScienceImage_4350_CSIROs_Parkes_Radio_Telescope_with_moon_in_the_background.jpg"
      },
      "shots": [
        {
          "start": 3.933,
          "end": 7.1,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 7.1,
          "end": 12.1,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.104,
      "end": 18.224,
      "text": "The signal, a fast radio burst, traveled billions of light-years from outside our galaxy.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Colourful clouds of a nearby neighbour (potw2511a).tiff",
        "credit": "ESA/Hubble & NASA, C. Murray",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Colourful_clouds_of_a_nearby_neighbour_(potw2511a).tiff"
      },
      "shots": [
        {
          "start": 12.1,
          "end": 15.233,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 15.233,
          "end": 18.233,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.224,
      "end": 24.069,
      "text": "Although the blast lasted only a few milliseconds, its physical scale is truly staggering.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Pulsar model.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Pulsar_model.jpg"
      },
      "shots": [
        {
          "start": 18.233,
          "end": 24.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.069,
      "end": 30.194,
      "text": "In that single instant, it released more energy than our Sun radiates in several days.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NASA Captures Images of a Late Summer Flare.jpg",
        "credit": "NASA/Goddard/SDO",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:NASA_Captures_Images_of_a_Late_Summer_Flare.jpg"
      },
      "shots": [
        {
          "start": 24.067,
          "end": 26.5,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 26.5,
          "end": 30.2,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 30.194,
      "end": 37.069,
      "text": "Even wilder, researchers recently detected repeating bursts that last just millionths of a second.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist\u2019s impression of the magnetar in the star cluster Westerlund 1.jpg",
        "credit": "ESO/L. Cal\u00e7ada",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%E2%80%99s_impression_of_the_magnetar_in_the_star_cluster_Westerlund_1.jpg"
      },
      "shots": [
        {
          "start": 30.2,
          "end": 33.1,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 33.1,
          "end": 37.067,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 37.069,
      "end": 43.389,
      "text": "Astronomers estimate that up to ten thousand of these titanic blasts occur every single day.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 37.067,
          "end": 43.4,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 43.389,
      "end": 47.73,
      "text": "They bombard our planet constantly, arriving almost completely silent.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist\u2019s impression of a record-breaking fast radio burst (eso2317a).jpg",
        "credit": "ESO/M. Kornmesser",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%E2%80%99s_impression_of_a_record-breaking_fast_radio_burst_(eso2317a).jpg"
      },
      "shots": [
        {
          "start": 43.4,
          "end": 48.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
