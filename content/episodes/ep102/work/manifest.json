{
  "id": "ep102",
  "duration": 54.436,
  "beats": [
    {
      "start": 0.08,
      "end": 4.129,
      "text": "A truck-sized space rock skipped off Earth's atmosphere like a stone.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Frederic Church Meteor of 1860.jpg",
        "credit": "Frederic Edwin Church",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Frederic_Church_Meteor_of_1860.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.129,
      "end": 12.499,
      "text": "On August 10, 1972, the Great Daylight Fireball entered the sky over Utah at thirty-three thousand miles per hour.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 4.133,
          "end": 12.5,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.499,
      "end": 20.794,
      "text": "The object streaked fifteen hundred kilometers northward, visible in broad daylight across the western United States and Canada.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "United States of North America, and part of Canada. Western sheet. (with) Sections of Central Pacific Railway (IA dr united-states-of-north-america-and-part-of-canada-western-sheet-with-s-5371116).jpg",
        "credit": "Letts, Son & Co.",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:United_States_of_North_America,_and_part_of_Canada._Western_sheet._(with)_Sections_of_Central_Pacific_Railway_(IA_dr_united-states-of-north-america-and-part-of-canada-western-sheet-with-s-5371116).jpg"
      },
      "shots": [
        {
          "start": 12.5,
          "end": 16.733,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 16.733,
          "end": 20.8,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.794,
      "end": 26.514,
      "text": "During its pass, the meteoroid dipped to a minimum altitude of just fifty-eight kilometers.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "1000px-Atmosphere layers-en.PNG",
        "credit": "Kelvin Case",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:1000px-Atmosphere_layers-en.PNG"
      },
      "shots": [
        {
          "start": 20.8,
          "end": 26.5,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 26.514,
      "end": 33.259,
      "text": "Witnesses in Montana reported hearing a startling double sonic boom as the rock rushed overhead.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "110925-N-DC018-068 (6192572646).jpg",
        "credit": "U.S. Department of Defense Current Photos",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:110925-N-DC018-068_(6192572646).jpg"
      },
      "shots": [
        {
          "start": 26.5,
          "end": 29.9,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 29.9,
          "end": 33.267,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 33.259,
      "end": 38.179,
      "text": "The entire frantic encounter lasted approximately one hundred seconds.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 33.267,
          "end": 38.167,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 38.179,
      "end": 47.729,
      "text": "The dense atmosphere acted like a cosmic ramp, stripping away half the object's mass and warping its orbital tilt from fifteen degrees to seven.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Colure.png",
        "credit": "AxialTiltObliquity.png: Dna-webmaster\nderivative work: Basilicofresco (msg)",
        "license": "CC BY 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:Colure.png"
      },
      "shots": [
        {
          "start": 38.167,
          "end": 47.733,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 47.729,
      "end": 54.086,
      "text": "Having bounced off our sky and escaped back into space, the Great Daylight Fireball was never seen again.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Frederic Church Meteor of 1860.jpg",
        "credit": "Frederic Edwin Church",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Frederic_Church_Meteor_of_1860.jpg"
      },
      "shots": [
        {
          "start": 47.733,
          "end": 54.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
