{
  "id": "ep155",
  "duration": 49.835,
  "beats": [
    {
      "start": 0.08,
      "end": 4.146,
      "text": "The first photo from Venus showed daylight bright enough to read by.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Foto de Venera 9.png",
        "credit": "Ted Stryk",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Foto_de_Venera_9.png"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.146,
      "end": 12.416,
      "text": "On October 22, 1975, a Soviet lander touched down in the upland volcanic region of Beta Regio.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Beta Regio on Venus.jpg",
        "credit": "JPL/NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Beta_Regio_on_Venus.jpg"
      },
      "shots": [
        {
          "start": 4.133,
          "end": 12.4,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.416,
      "end": 18.587,
      "text": "Scientists anticipated a pitch-black wasteland crushed under ninety atmospheres of pressure.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 12.4,
          "end": 18.6,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.587,
      "end": 25.332,
      "text": "Instead, the 660-kilogram armored sphere came to rest on a twenty-degree volcanic slope.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Venera 9 Space Probe 01.jpg",
        "credit": "Stolbovsky",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Venera_9_Space_Probe_01.jpg"
      },
      "shots": [
        {
          "start": 18.6,
          "end": 21.967,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 21.967,
          "end": 25.333,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.332,
      "end": 32.077,
      "text": "Sunlight filtered through dense clouds, illuminating flat, sharp-edged rocks never worn smooth by wind.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "V13 vg261 262.tif",
        "credit": "USSR/NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:V13_vg261_262.tif"
      },
      "shots": [
        {
          "start": 25.333,
          "end": 32.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 32.077,
      "end": 38.096,
      "text": "Although a protective lens cover failed to separate, the lander operated for fifty-three minutes.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Venera 1 (a) (Memorial Museum of Astronautics).JPG",
        "credit": "Armael",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Venera_1_(a)_(Memorial_Museum_of_Astronautics).JPG"
      },
      "shots": [
        {
          "start": 32.067,
          "end": 38.1,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 38.096,
      "end": 44.671,
      "text": "Transmissions ended only when the relay orbiter drifted out of radio range below the horizon.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Stamps of Germany (DDR) 1962, MiNr 0932.jpg",
        "credit": "hochgeladen von --Nightflyer (talk) 20:29, 25 March 2013 (UTC)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Stamps_of_Germany_(DDR)_1962,_MiNr_0932.jpg"
      },
      "shots": [
        {
          "start": 38.1,
          "end": 44.667,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 44.671,
      "end": 49.485,
      "text": "That shocking view proved that daylight bright enough to read by existed on Venus.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Foto de Venera 9.png",
        "credit": "Ted Stryk",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Foto_de_Venera_9.png"
      },
      "shots": [
        {
          "start": 44.667,
          "end": 49.833,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
