{
  "id": "ep165",
  "duration": 49.501,
  "beats": [
    {
      "start": 0.08,
      "end": 3.851,
      "text": "Pluto has not finished a single orbit since its discovery.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Pluto in True Color - High-Res.jpg",
        "credit": "NASA/Johns Hopkins University Applied Physics Laboratory/Southwest Research Institute/Alex Parker",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Pluto_in_True_Color_-_High-Res.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.867,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.851,
      "end": 11.271,
      "text": "In February 1930, Clyde Tombaugh used a blink comparator to find the icy world at Lowell Observatory.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Clyde W. Tombaugh.jpeg",
        "credit": "Unknown authorUnknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Clyde_W._Tombaugh.jpeg"
      },
      "shots": [
        {
          "start": 3.867,
          "end": 11.267,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.271,
      "end": 17.366,
      "text": "Most people believe Pluto was a major planet for 76 years before its demotion.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Pluto discovery plates.png",
        "credit": "Clyde Tombaugh",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Pluto_discovery_plates.png"
      },
      "shots": [
        {
          "start": 11.267,
          "end": 17.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.366,
      "end": 23.841,
      "text": "But this icy world is actually smaller than seven solar system moons, including Earth's Moon.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Pluto compared2.jpg",
        "credit": "Unknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Pluto_compared2.jpg"
      },
      "shots": [
        {
          "start": 17.367,
          "end": 23.833,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.841,
      "end": 31.436,
      "text": "The International Astronomical Union demoted it in 2006 for failing to clear its orbital neighborhood.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Discussions - IAU General Assembly 2006 (DSC 5200).jpg",
        "credit": "IAU/Lars Holm Nielsen",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Discussions_-_IAU_General_Assembly_2006_(DSC_5200).jpg"
      },
      "shots": [
        {
          "start": 23.833,
          "end": 31.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 31.436,
      "end": 39.281,
      "text": "Pluto's path is so extreme that between 1979 and 1999, it was closer to the Sun than Neptune.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Uranus, Neptune, and their moons (2MASS) - cropped.jpg",
        "credit": "Two Micron All Sky Survey (2MASS), a joint project of the University of Massachusetts and the Infrared Processing and Analysis Center/California Institute of Technology, funded by the National Aeronau",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Uranus,_Neptune,_and_their_moons_(2MASS)_-_cropped.jpg"
      },
      "shots": [
        {
          "start": 31.433,
          "end": 39.267,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 39.281,
      "end": 44.876,
      "text": "A single trip around the Sun takes this world roughly 248 Earth years.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA19682-Pluto-Charon-Sun-ArtistConcept-20150608.jpg",
        "credit": "NASA/Southwest Research Institute/Alex Parker",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA19682-Pluto-Charon-Sun-ArtistConcept-20150608.jpg"
      },
      "shots": [
        {
          "start": 39.267,
          "end": 44.867,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 44.876,
      "end": 49.151,
      "text": "Pluto will finally finish that journey in the year 2178.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Pluto in True Color - High-Res.jpg",
        "credit": "NASA/Johns Hopkins University Applied Physics Laboratory/Southwest Research Institute/Alex Parker",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Pluto_in_True_Color_-_High-Res.jpg"
      },
      "shots": [
        {
          "start": 44.867,
          "end": 49.5,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
