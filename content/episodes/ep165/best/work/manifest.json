{
  "id": "ep165",
  "duration": 51.142,
  "beats": [
    {
      "start": 0.08,
      "end": 3.852,
      "text": "Pluto has not finished a single orbit since its discovery.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Pluto in True Color - High-Res.jpg",
        "credit": "NASA/Johns Hopkins University Applied Physics Laboratory/Southwest Research Institute/Alex Parker",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Pluto_in_True_Color_-_High-Res.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.867,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.852,
      "end": 11.272,
      "text": "In February 1930, Clyde Tombaugh used a blink comparator to find the icy world at Lowell Observatory.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Clyde W. Tombaugh.jpeg",
        "credit": "Unknown authorUnknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Clyde_W._Tombaugh.jpeg"
      },
      "shots": [
        {
          "start": 3.867,
          "end": 11.267,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.272,
      "end": 17.367,
      "text": "Most people believe Pluto was a major planet for 76 years before its demotion.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Pluto discovery plates.png",
        "credit": "Clyde Tombaugh",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Pluto_discovery_plates.png"
      },
      "shots": [
        {
          "start": 11.267,
          "end": 17.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.367,
      "end": 23.842,
      "text": "But this icy world is actually smaller than seven solar system moons, including Earth\u2019s Moon.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Pluto compared.jpg",
        "credit": "Unknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Pluto_compared.jpg"
      },
      "shots": [
        {
          "start": 17.367,
          "end": 23.833,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.842,
      "end": 31.437,
      "text": "The International Astronomical Union demoted it in 2006 for failing to clear its orbital neighborhood.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Discussions - IAU General Assembly 2006 (DSC 5200).jpg",
        "credit": "IAU/Lars Holm Nielsen",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Discussions_-_IAU_General_Assembly_2006_(DSC_5200).jpg"
      },
      "shots": [
        {
          "start": 23.833,
          "end": 31.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 31.437,
      "end": 39.282,
      "text": "Pluto\u2019s path is so extreme that between 1979 and 1999, it was closer to the Sun than Neptune.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 31.433,
          "end": 39.267,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 39.282,
      "end": 44.877,
      "text": "A single trip around the Sun takes this world roughly 248 Earth years.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA19682-Pluto-Charon-Sun-ArtistConcept-20150608.jpg",
        "credit": "NASA/Southwest Research Institute/Alex Parker",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA19682-Pluto-Charon-Sun-ArtistConcept-20150608.jpg"
      },
      "shots": [
        {
          "start": 39.267,
          "end": 44.867,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 44.877,
      "end": 50.792,
      "text": "Pluto will finally complete its very first orbit since discovery in the year 2178.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Pluto in True Color - High-Res.jpg",
        "credit": "NASA/Johns Hopkins University Applied Physics Laboratory/Southwest Research Institute/Alex Parker",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Pluto_in_True_Color_-_High-Res.jpg"
      },
      "shots": [
        {
          "start": 44.867,
          "end": 51.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
