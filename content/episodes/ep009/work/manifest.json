  "beats": [
    {
      "start": 0.15,
      "end": 6.106,
      "text": "In 1859, telegraphs sent messages while completely unplugged from their batteries.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Morse electromagnetic telegraph.jpg",
        "credit": "Fil22plm",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Morse_electromagnetic_telegraph.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.067,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 4.067,
          "end": 6.1,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.106,
      "end": 12.301,
      "text": "On September 1, astronomer Richard Carrington saw two blinding white flashes on the Sun.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Maull & Polyblank photograph of Richard C. Carrington.jpg",
        "credit": "Maull & Polyblank",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Maull_%26_Polyblank_photograph_of_Richard_C._Carrington.jpg"
      },
      "shots": [
        {
          "start": 6.1,
          "end": 8.367,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 8.367,
          "end": 12.3,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.301,
      "end": 18.346,
      "text": "Only 17.6 hours later, a massive cloud of solar plasma slammed into Earth.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 12.3,
          "end": 18.333,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.346,
      "end": 23.266,
      "text": "Auroras glowed so bright that miners in the Rockies woke up to cook breakfast.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Lofoten, Norway (Unsplash).jpg",
        "credit": "Johannes Groll followhansi",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Lofoten,_Norway_(Unsplash).jpg"
      },
      "shots": [
        {
          "start": 18.333,
          "end": 20.8,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 20.8,
          "end": 23.267,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.266,
      "end": 29.086,
      "text": "Across the world, the magnetic storm induced high-voltage currents into the telegraph grid.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Magnetosphere rendition.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Magnetosphere_rendition.jpg"
      },
      "shots": [
        {
          "start": 23.267,
          "end": 29.1,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 29.086,
      "end": 34.906,
      "text": "Equipment sparked and set offices on fire as operators received electric shocks.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Telegraf\u00eda morse-2009.jpg",
        "credit": "Tamorlan",
        "license": "CC BY 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:Telegraf%C3%ADa_morse-2009.jpg"
      },
      "shots": [
        {
          "start": 29.1,
          "end": 31.167,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 31.167,
          "end": 34.9,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 34.906,
      "end": 40.526,
      "text": "Between Boston and Portland, operators realized they did not need their own batteries.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Map Of The States Of Maine, New Hampshire, Vermont, Massachusetts, Connecticut & Rhode Island By H.S. Tanner. (with) North Part (IA dr map-of-the-states-of-maine-new-hampshire-vermont-massachusetts-connecti-00104132).jpg",
        "credit": "Tanner, Henry S.",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Map_Of_The_States_Of_Maine,_New_Hampshire,_Vermont,_Massachusetts,_Connecticut_%26_Rhode_Island_By_H.S._Tanner._(with)_North_Part_(IA_dr_map-of-the-states-of-maine-new-hampshire-vermont-massachusetts-connecti-00104132).jpg"
      },
      "shots": [
        {
          "start": 34.9,
          "end": 37.733,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 37.733,
          "end": 40.533,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 40.526,
      "end": 48.726,
      "text": "They disconnected their equipment and successfully sent messages for about two hours using only the induced auroral current.",
      "asset": {
        "source": "Wellcome Collection",
        "title": "Telegraphy: four different inventors' telegraph machines [on exhibition in Paris?]. Wood engraving, (1889?) by Poyet.",
        "credit": "Wellcome Collection",
        "license": "Public domain",
        "url": "https://wellcomecollection.org/works/xsdpk9w4"
      },
      "shots": [
        {
          "start": 40.533,
          "end": 44.333,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 44.333,
          "end": 48.733,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 48.726,
      "end": 53.427,
      "text": "That is how a solar storm kept the telegraphs talking without any batteries.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Morse electromagnetic telegraph.jpg",
        "credit": "Fil22plm",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Morse_electromagnetic_telegraph.jpg"
      },
      "shots": [
        {
          "start": 48.733,
