{
  "id": "ep029",
  "duration": 51.079,
  "beats": [
    {
      "start": 0.08,
      "end": 3.63,
      "text": "A tiny moon is the whitest world in the Solar System.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Enceladus - June 28 2007 (54211737180).png",
        "credit": "Kevin M. Gill",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Enceladus_-_June_28_2007_(54211737180).png"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 1.367,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 1.367,
          "end": 3.633,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.63,
      "end": 9.225,
      "text": "Enceladus reflects nearly 100 percent of the sunlight hitting its frozen shell.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA17202 - Approaching Enceladus.jpg",
        "credit": "National Aeronautics and Space Administration (NASA) / Jet Propulsion Laboratory (JPL)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA17202_-_Approaching_Enceladus.jpg"
      },
      "shots": [
        {
          "start": 3.633,
          "end": 6.1,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 6.1,
          "end": 9.233,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.225,
      "end": 16.145,
      "text": "Astronomer William Herschel first spotted this 500-kilometer ice ball back in 1789.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "William Herschel01.jpg",
        "credit": "Lemuel Francis Abbott",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:William_Herschel01.jpg"
      },
      "shots": [
        {
          "start": 9.233,
          "end": 12.667,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 12.667,
          "end": 16.133,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.145,
      "end": 22.215,
      "text": "Its extreme brightness comes from a gravitational tug-of-war with Saturn and the moon Dione.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Saturnmoonsdiagram.png",
        "credit": "Exoplanetaryscience",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Saturnmoonsdiagram.png"
      },
      "shots": [
        {
          "start": 16.133,
          "end": 18.933,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 18.933,
          "end": 22.2,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.215,
      "end": 28.41,
      "text": "This tidal flexing generates enough internal heat to melt a global ocean beneath the ice.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Moons- Active Worlds.png",
        "credit": "James Webb Space Telescope",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Moons-_Active_Worlds.png"
      },
      "shots": [
        {
          "start": 22.2,
          "end": 24.733,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 24.733,
          "end": 28.4,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 28.41,
      "end": 36.51,
      "text": "In 2005, the Cassini spacecraft discovered massive geysers erupting from fractures called tiger stripes.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA17184 rot180 inset PIA14658 rot38.jpg",
        "credit": "NASA / JPL-Caltech / Space Science Institute",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA17184_rot180_inset_PIA14658_rot38.jpg"
      },
      "shots": [
        {
          "start": 28.4,
          "end": 36.5,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 36.51,
      "end": 42.905,
      "text": "These plumes spray ice and organic molecules directly into space to build Saturn\u2019s E ring.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Enceladus in Saturn's E Ring - July 19 2013 (26279868840).png",
        "credit": "Kevin Gill from Los Angeles, CA, United States",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Enceladus_in_Saturn%27s_E_Ring_-_July_19_2013_(26279868840).png"
      },
      "shots": [
        {
          "start": 36.5,
          "end": 42.9,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 42.905,
      "end": 46.7,
      "text": "Most of that material eventually falls back as fresh snow.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Enceladus Tiger Stripes Up Close PIA06247.jpg",
        "credit": "NASA/JPL/Space Science Institute",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Enceladus_Tiger_Stripes_Up_Close_PIA06247.jpg"
      },
      "shots": [
        {
          "start": 42.9,
          "end": 46.7,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 46.7,
      "end": 50.729,
      "text": "That is why a tiny moon is the whitest world in the Solar System.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Enceladus - June 28 2007 (54211737180).png",
        "credit": "Kevin M. Gill",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Enceladus_-_June_28_2007_(54211737180).png"
      },
      "shots": [
        {
          "start": 46.7,
          "end": 51.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
