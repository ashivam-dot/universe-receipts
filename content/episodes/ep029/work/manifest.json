{
  "id": "ep029",
  "duration": 50.065,
  "beats": [
    {
      "start": 0.08,
      "end": 4.146,
      "text": "The [whitest](/w\u0288\u0264t\u0288\u0264st/) world in our solar system is a giant snow machine.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA17202 - Approaching Enceladus.jpg",
        "credit": "National Aeronautics and Space Administration (NASA) / Jet Propulsion Laboratory (JPL)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA17202_-_Approaching_Enceladus.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.146,
      "end": 10.741,
      "text": "This moon, Enceladus, is just 500 kilometers across and reflects nearly all sunlight.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Enceladus Tiger Stripes Up Close PIA06247.jpg",
        "credit": "NASA/JPL/Space Science Institute",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Enceladus_Tiger_Stripes_Up_Close_PIA06247.jpg"
      },
      "shots": [
        {
          "start": 4.133,
          "end": 10.733,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.741,
      "end": 17.511,
      "text": "In 2005, the Cassini spacecraft discovered massive geysers erupting from its south pole.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "False color Cassini image of jets in the southern hemisphere of Enceladus.jpg",
        "credit": "NASA/JPL/Space Science Institute",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:False_color_Cassini_image_of_jets_in_the_southern_hemisphere_of_Enceladus.jpg"
      },
      "shots": [
        {
          "start": 10.733,
          "end": 17.5,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.511,
      "end": 23.831,
      "text": "These jets of water and organic molecules blast through warm fractures nicknamed tiger stripes.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Jet Spots in Tiger Stripes PIA10361.jpg",
        "credit": "NASA/JPL/GSFC/SwRI/SSI",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Jet_Spots_in_Tiger_Stripes_PIA10361.jpg"
      },
      "shots": [
        {
          "start": 17.5,
          "end": 20.667,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 20.667,
          "end": 23.833,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.831,
      "end": 29.301,
      "text": "Tidal flexing from Saturn and the moon Dione melts a global ocean under the ice.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Moons- Active Worlds.png",
        "credit": "James Webb Space Telescope",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Moons-_Active_Worlds.png"
      },
      "shots": [
        {
          "start": 23.833,
          "end": 27.233,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 27.233,
          "end": 29.3,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 29.301,
      "end": 33.971,
      "text": "Most of the erupting water ice falls back to the surface as fresh snow.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Fictional moon system 4.png",
        "credit": "Merikanto",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Fictional_moon_system_4.png"
      },
      "shots": [
        {
          "start": 29.3,
          "end": 33.967,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 33.971,
      "end": 39.446,
      "text": "The rest escapes into orbit to supply most of the material in Saturn's E ring.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA08321 - Ghostly Fingers of Enceladus.tif",
        "credit": "NASA/JPL/Space Science Institute",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA08321_-_Ghostly_Fingers_of_Enceladus.tif"
      },
      "shots": [
        {
          "start": 33.967,
          "end": 39.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 39.446,
      "end": 45.016,
      "text": "This process continually recoats the moon in a fresh layer of blindingly white ice.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Color hemisphere maps of Enceladus PIA18435 Nov. 2014 full size.jpg",
        "credit": "NASA / JPL-Caltech / Space Science Institute / Lunar and Planetary Institute",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Color_hemisphere_maps_of_Enceladus_PIA18435_Nov._2014_full_size.jpg"
      },
      "shots": [
        {
          "start": 39.433,
          "end": 42.2,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 42.2,
          "end": 45.0,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 45.016,
      "end": 49.715,
      "text": "That is why the [whitest](/w\u0288\u0264t\u0288\u0264st/) world in the solar system is a giant snow machine.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA17202 - Approaching Enceladus.jpg",
        "credit": "National Aeronautics and Space Administration (NASA) / Jet Propulsion Laboratory (JPL)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA17202_-_Approaching_Enceladus.jpg"
      },
      "shots": [
        {
          "start": 45.0,
          "end": 50.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
