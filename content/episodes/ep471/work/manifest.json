{
  "id": "ep471",
  "duration": 24.158,
  "beats": [
    {
      "start": 0.08,
      "end": 3.74,
      "text": "An asteroid zipped closer than the Moon without anyone noticing.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "A New View of the Moon.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:A_New_View_of_the_Moon.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.733,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.74,
      "end": 6.44,
      "text": "It stretched roughly 100 to 190 meters across.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 3.733,
          "end": 6.433,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.44,
      "end": 9.34,
      "text": "That made it comparable in size to the Washington Monument.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA21259 - Celestial Object 2016 WF9, a NEOWISE Discovery (Artist Concept).jpg",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA21259_-_Celestial_Object_2016_WF9,_a_NEOWISE_Discovery_(Artist_Concept).jpg"
      },
      "shots": [
        {
          "start": 6.433,
          "end": 9.333,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.34,
      "end": 12.8,
      "text": "It was the largest asteroid to pass that close since 1971.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 9.333,
          "end": 12.8,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.8,
      "end": 16.64,
      "text": "The rock approached blindly from the blinding glare of the Sun.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Magnificent CME Erupts on the Sun - August 31.jpg",
        "credit": "NASA Goddard Space Flight Center",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Magnificent_CME_Erupts_on_the_Sun_-_August_31.jpg"
      },
      "shots": [
        {
          "start": 12.8,
          "end": 16.633,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.64,
      "end": 20.42,
      "text": "Astronomers only spotted it two days after it already rushed past.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mauna Loa Observatory.png",
        "credit": "NOAA Research cover image",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Mauna_Loa_Observatory.png"
      },
      "shots": [
        {
          "start": 16.633,
          "end": 20.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.42,
      "end": 23.808,
      "text": "Nobody noticed when the giant rock nearly clipped us.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "A New View of the Moon.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:A_New_View_of_the_Moon.jpg"
      },
      "shots": [
        {
          "start": 20.433,
          "end": 24.167,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
