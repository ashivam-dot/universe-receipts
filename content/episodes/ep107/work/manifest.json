{
  "id": "ep107",
  "duration": 54.332,
  "beats": [
    {
      "start": 0.08,
      "end": 3.552,
      "text": "We have been drawing the Sun the wrong color our entire lives.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "ISS-47 Earth Sunset From the International Space Station.jpg",
        "credit": "NASA/Jeff Williams",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:ISS-47_Earth_Sunset_From_the_International_Space_Station.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.567,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.552,
      "end": 11.047,
      "text": "For generations, children's drawings and even professional astronomers have classified our star as a yellow dwarf.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Crab by Anna Frodesiak derived from Drawing of Cafe Anna back room 2012 05 04.jpg",
        "credit": "Anna Frodesiak",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Crab_by_Anna_Frodesiak_derived_from_Drawing_of_Cafe_Anna_back_room_2012_05_04.jpg"
      },
      "shots": [
        {
          "start": 3.567,
          "end": 11.033,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.047,
      "end": 18.867,
      "text": "But astronauts aboard the International Space Station observe a brilliant, blindingly white disk set against black space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Full disk of the Sun (eso1703e-comparisona).tiff",
        "credit": "NASA/SDO, ALMA (ESO/NAOJ/NRAO)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Full_disk_of_the_Sun_(eso1703e-comparisona).tiff"
      },
      "shots": [
        {
          "start": 11.033,
          "end": 15.4,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 15.4,
          "end": 18.867,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.867,
      "end": 24.887,
      "text": "Surprisingly, the Sun\u2019s actual peak emission is in the green portion of the visible spectrum.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "McCree-Kurve 1 DE demo.png",
        "credit": "Mrmw",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:McCree-Kurve_1_DE_demo.png"
      },
      "shots": [
        {
          "start": 18.867,
          "end": 24.9,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.887,
      "end": 33.232,
      "text": "Human eyes perceive this broad mixture of wavelengths as white because it stimulates all our color receptors simultaneously.",
      "asset": {
        "source": "Flickr via Openverse",
        "title": "Untitled",
        "credit": "Han Cheng Yeh",
        "license": "CC BY 2.0",
        "url": "https://www.flickr.com/photos/26719227@N00/9543521907"
      },
      "shots": [
        {
          "start": 24.9,
          "end": 33.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 33.232,
      "end": 39.782,
      "text": "This yellow star we see from Earth is actually an atmospheric illusion called Rayleigh scattering.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Baron Rayleigh, PB00682.jpg",
        "credit": "Walker (artist) (graphic artist)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Baron_Rayleigh,_PB00682.jpg"
      },
      "shots": [
        {
          "start": 33.233,
          "end": 39.767,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 39.782,
      "end": 47.852,
      "text": "Nitrogen and oxygen molecules deflect blue light away, leaving the remaining direct sunlight appearing yellow to our eyes.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "ISS066-E-25494 - View of Earth.jpg",
        "credit": "Earth Science and Remote Sensing Unit, Lyndon B. Johnson Space Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:ISS066-E-25494_-_View_of_Earth.jpg"
      },
      "shots": [
        {
          "start": 39.767,
          "end": 42.833,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 42.833,
          "end": 47.867,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 47.852,
      "end": 53.982,
      "text": "This stolen blue light paints our sky, while the leftover rays make us believe our white star is golden.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "ISS-47 Earth Sunset From the International Space Station.jpg",
        "credit": "NASA/Jeff Williams",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:ISS-47_Earth_Sunset_From_the_International_Space_Station.jpg"
      },
      "shots": [
        {
          "start": 47.867,
          "end": 54.333,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
