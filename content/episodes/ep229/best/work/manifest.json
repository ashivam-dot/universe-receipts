{
  "id": "ep229",
  "duration": 46.719,
  "beats": [
    {
      "start": 0.08,
      "end": 3.955,
      "text": "A truck-sized space rock bounced right off Earth's atmosphere.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Superbolide relative sizes.png",
        "credit": "Exoplanetaryscience",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Superbolide_relative_sizes.png"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.967,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.955,
      "end": 11.175,
      "text": "On August 10, 1972, the massive object entered the upper sky over Utah in broad daylight.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 3.967,
          "end": 11.167,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.175,
      "end": 18.12,
      "text": "It moved at an incredible blazing speed of about 15 kilometers per second across the western states.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Soyuz TMA-05M capsule reentry.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Soyuz_TMA-05M_capsule_reentry.jpg"
      },
      "shots": [
        {
          "start": 11.167,
          "end": 14.367,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 14.367,
          "end": 18.133,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.12,
      "end": 26.365,
      "text": "Cameras in Wyoming captured the glowing fireball as startled witnesses heard tremendous double sonic booms echo below.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Adams The Tetons and the Snake River.jpg",
        "credit": "Ansel Adams",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Adams_The_Tetons_and_the_Snake_River.jpg"
      },
      "shots": [
        {
          "start": 18.133,
          "end": 23.8,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 23.8,
          "end": 26.367,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 26.365,
      "end": 33.11,
      "text": "The entire dramatic atmospheric passage lasted approximately 100 seconds from start to finish.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 26.367,
          "end": 33.1,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 33.11,
      "end": 39.78,
      "text": "Instead of crashing into the terrain, the heavy rock climbed right back out into space over Alberta, Canada.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "2001 SG286 orbit.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:2001_SG286_orbit.jpg"
      },
      "shots": [
        {
          "start": 33.1,
          "end": 39.767,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 39.78,
      "end": 46.369,
      "text": "No fragments ever landed because a colossal truck-sized space rock bounced right off Earth's atmosphere.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Superbolide relative sizes.png",
        "credit": "Exoplanetaryscience",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Superbolide_relative_sizes.png"
      },
      "shots": [
        {
          "start": 39.767,
          "end": 46.733,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
