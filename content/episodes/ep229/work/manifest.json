{
  "id": "ep229",
  "duration": 47.972,
  "beats": [
    {
      "start": 0.08,
      "end": 5.987,
      "text": "In 1972, a blinding fireball streaked across the sky, never hitting ground.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Meteoroiden.jpg",
        "credit": "Herbert Bolz",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Meteoroiden.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 6.0,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 5.987,
      "end": 11.532,
      "text": "On August 10, a truck-sized space rock entered the atmosphere over the state of Utah.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 6.0,
          "end": 11.533,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.532,
      "end": 17.402,
      "text": "Moving at 15 kilometers per second, the object glowed bright enough for people to film.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 11.533,
          "end": 17.4,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.402,
      "end": 21.697,
      "text": "Tourists in Wyoming watched the trail while a sonic boom shook the air.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Adams The Tetons and the Snake River.jpg",
        "credit": "Ansel Adams",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Adams_The_Tetons_and_the_Snake_River.jpg"
      },
      "shots": [
        {
          "start": 17.4,
          "end": 19.767,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 19.767,
          "end": 21.7,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.697,
      "end": 27.967,
      "text": "Military surveillance satellites tracked the object spending 100 seconds skipping like a stone.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "North America from low orbiting satellite Suomi NPP.jpg",
        "credit": "NASA/NOAA/GSFC/Suomi NPP/VIIRS/Norman Kuring",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:North_America_from_low_orbiting_satellite_Suomi_NPP.jpg"
      },
      "shots": [
        {
          "start": 21.7,
          "end": 25.4,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 25.4,
          "end": 27.967,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 27.967,
      "end": 35.012,
      "text": "Instead of crashing, the meteoroid merely grazed the atmosphere and rebounded back into interplanetary space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Atmosphere Diagram (Atmosfera EN-CC).tiff",
        "credit": "P. Hor\u00e1lek /NOIRLab/NSF/AURA",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Atmosphere_Diagram_(Atmosfera_EN-CC).tiff"
      },
      "shots": [
        {
          "start": 27.967,
          "end": 30.533,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 30.533,
          "end": 35.0,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 35.012,
      "end": 42.682,
      "text": "Czech astronomer Zdenek Ceplecha determined this brief encounter permanently shifted the rock's entire orbit.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "2427(Kobzar) asteroid orbit.png",
        "credit": "This is a screenshot taken from Jet Propulsion Laboratory site.",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:2427(Kobzar)_asteroid_orbit.png"
      },
      "shots": [
        {
          "start": 35.0,
          "end": 42.667,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 42.682,
      "end": 47.622,
      "text": "Not a single solid fragment reached the ground because the world only watched.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Meteoroiden.jpg",
        "credit": "Herbert Bolz",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Meteoroiden.jpg"
      },
      "shots": [
        {
          "start": 42.667,
          "end": 47.967,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
