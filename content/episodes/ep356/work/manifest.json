{
  "id": "ep356",
  "duration": 23.688,
  "beats": [
    {
      "start": 0.08,
      "end": 3.86,
      "text": "Earth appears as a tiny, invisible speck from deep space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PaleBlueDot.jpg",
        "credit": "Unknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PaleBlueDot.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.867,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.86,
      "end": 7.6,
      "text": "Astronomer Carl Sagan pushed for a portrait from six billion kilometers away.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Planetary society2.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Planetary_society2.jpg"
      },
      "shots": [
        {
          "start": 3.867,
          "end": 7.6,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.6,
      "end": 10.9,
      "text": "Engineers feared the sun's glare would destroy the spacecraft's sensitive cameras.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyager instruments boom.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Voyager_instruments_boom.jpg"
      },
      "shots": [
        {
          "start": 7.6,
          "end": 10.9,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.9,
      "end": 13.88,
      "text": "They finally relented, letting the probe look back at our home.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyager Portrait Family diagram.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Voyager_Portrait_Family_diagram.jpg"
      },
      "shots": [
        {
          "start": 10.9,
          "end": 13.867,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.88,
      "end": 16.96,
      "text": "Our world is just 0.12 of a pixel in the frame.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Pale Blue Dot.png",
        "credit": "Voyager 1",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Pale_Blue_Dot.png"
      },
      "shots": [
        {
          "start": 13.867,
          "end": 16.967,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.96,
      "end": 19.64,
      "text": "Light from the shot took over five hours to reach us.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Goldstone Deep Space Network.jpg",
        "credit": "Unknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Goldstone_Deep_Space_Network.jpg"
      },
      "shots": [
        {
          "start": 16.967,
          "end": 19.633,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.64,
      "end": 23.338,
      "text": "The entire solar system is invisible without special optics from deep space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PaleBlueDot.jpg",
        "credit": "Unknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PaleBlueDot.jpg"
      },
      "shots": [
        {
          "start": 19.633,
          "end": 23.7,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
