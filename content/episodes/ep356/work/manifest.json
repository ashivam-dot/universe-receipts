{
  "id": "ep356",
  "duration": 29.237,
  "beats": [
    {
      "start": 0.08,
      "end": 4.16,
      "text": "Voyager traveled four billion miles to look back at us.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyager 1's view of Solar System (artist's impression).jpg",
        "credit": "NASA, ESA, and G. Bacon (STScI)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Voyager_1%27s_view_of_Solar_System_(artist%27s_impression).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 1.533,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 1.533,
          "end": 4.167,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.16,
      "end": 7.52,
      "text": "Astronomer Carl Sagan first proposed the photo in 1981.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Planetary society2.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Planetary_society2.jpg"
      },
      "shots": [
        {
          "start": 4.167,
          "end": 6.467,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 6.467,
          "end": 7.533,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.52,
      "end": 11.24,
      "text": "NASA rejected it for years, fearing the Sun would blind the cameras.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyager Portrait Family diagram.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Voyager_Portrait_Family_diagram.jpg"
      },
      "shots": [
        {
          "start": 7.533,
          "end": 11.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.24,
      "end": 14.5,
      "text": "NASA finally took the shot in 1990 from deep space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Solar System Group.jpg",
        "credit": "NASA / Voyager 1 probe",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Solar_System_Group.jpg"
      },
      "shots": [
        {
          "start": 11.233,
          "end": 14.5,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.5,
      "end": 17.22,
      "text": "Then, Voyager shut down its cameras for the last time.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyager in space (PIA17049).jpg",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Voyager_in_space_(PIA17049).jpg"
      },
      "shots": [
        {
          "start": 14.5,
          "end": 17.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.22,
      "end": 21.02,
      "text": "Our entire world appeared as 0.12 pixels.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Pale Blue Dot from Voyager 1 - PIA23645.png",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Pale_Blue_Dot_from_Voyager_1_-_PIA23645.png"
      },
      "shots": [
        {
          "start": 17.233,
          "end": 21.033,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.02,
      "end": 24.36,
      "text": "Without a lucky sunbeam, the planet would be totally invisible.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Pale Blue Dot.png",
        "credit": "Voyager 1",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Pale_Blue_Dot.png"
      },
      "shots": [
        {
          "start": 21.033,
          "end": 24.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.36,
      "end": 28.887,
      "text": "The photo explains why Voyager traveled four billion miles to look back at us.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyager 1's view of Solar System (artist's impression).jpg",
        "credit": "NASA, ESA, and G. Bacon (STScI)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Voyager_1%27s_view_of_Solar_System_(artist%27s_impression).jpg"
      },
      "shots": [
        {
          "start": 24.367,
          "end": 29.233,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    }
  ],
