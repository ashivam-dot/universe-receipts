{
  "id": "ep461",
  "duration": 30.756,
  "beats": [
    {
      "start": 0.08,
      "end": 3.42,
      "text": "Jupiter's giant storm once swallowed three Earths side-by-side.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Earth and the Great Red Spot (4078049755).jpg",
        "credit": "Lunar and Planetary Institute from Houston, TX, USA",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Earth_and_the_Great_Red_Spot_(4078049755).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.42,
      "end": 6.38,
      "text": "Even after shrinking for a century, it still swallows Earth whole.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Jupiter\u2019s Colourful Palette.tif",
        "credit": "NASA, ESA, A. Simon (Goddard Space Flight Center), and M.H. Wong (University of California, Berkeley)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Jupiter%E2%80%99s_Colourful_Palette.tif"
      },
      "shots": [
        {
          "start": 3.433,
          "end": 4.9,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 4.9,
          "end": 6.367,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.38,
      "end": 9.2,
      "text": "Winds around the edge roar past 200 miles per hour.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Jupiter's Great Red Spot - Juno Perijove 7 - July 11 2017 (38606452501).jpg",
        "credit": "Kevin Gill from Los Angeles, CA, United States",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Jupiter%27s_Great_Red_Spot_-_Juno_Perijove_7_-_July_11_2017_(38606452501).jpg"
      },
      "shots": [
        {
          "start": 6.367,
          "end": 9.2,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.2,
      "end": 13.46,
      "text": "It plunges 250 kilometers deep into Jupiter's dense atmosphere.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NASA\u2019s Webb Discovers New Feature in Jupiter\u2019s Atmosphere (53270123023).jpg",
        "credit": "NASA's James Webb Space Telescope from Greenbelt, MD, USA",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:NASA%E2%80%99s_Webb_Discovers_New_Feature_in_Jupiter%E2%80%99s_Atmosphere_(53270123023).jpg"
      },
      "shots": [
        {
          "start": 9.2,
          "end": 13.467,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.46,
      "end": 16.26,
      "text": "Without a solid surface below, nothing creates friction to stop it.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Grosser roter fleck.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Grosser_roter_fleck.jpg"
      },
      "shots": [
        {
          "start": 13.467,
          "end": 16.267,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.26,
      "end": 20.36,
      "text": "It survives by cannibalizing smaller passing storms like atmospheric prey.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Three Red Spots Mix It Up on Jupiter.jpg",
        "credit": "NASA, ESA, A. Simon-Miller (Goddard Space Flight Center), N. Chanover (New Mexico State University), and G. Orton (Jet Propulsion Laboratory)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Three_Red_Spots_Mix_It_Up_on_Jupiter.jpg"
      },
      "shots": [
        {
          "start": 16.267,
          "end": 20.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.36,
      "end": 23.66,
      "text": "When those smaller storms thin out, this monster begins to starve.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Jupiter\u2019s storms- temperatures and cloud colours (eso1010a).tiff",
        "credit": "ESO/NASA/JPL/ESA/L. Fletcher",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Jupiter%E2%80%99s_storms-_temperatures_and_cloud_colours_(eso1010a).tiff"
      },
      "shots": [
        {
          "start": 20.367,
          "end": 23.667,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.66,
      "end": 26.34,
      "text": "Massive red fragments peeled away from its perimeter in 2019.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Jupiter - Perijove 18 - GRS Map Projected (48062525062).jpg",
        "credit": "Kevin M. Gill",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Jupiter_-_Perijove_18_-_GRS_Map_Projected_(48062525062).jpg"
      },
      "shots": [
        {
          "start": 23.667,
          "end": 26.333,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 26.34,
      "end": 30.406,
      "text": "Yet deep inside, the solar system's largest storm keeps churning.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Earth and the Great Red Spot (4078049755).jpg",
        "credit": "Lunar and Planetary Institute from Houston, TX, USA",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Earth_and_the_Great_Red_Spot_(4078049755).jpg"
      },
      "shots": [
        {
          "start": 26.333,
          "end": 30.767,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
