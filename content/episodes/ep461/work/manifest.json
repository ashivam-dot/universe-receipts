{
  "id": "ep461",
  "duration": 30.175,
  "beats": [
    {
      "start": 0.08,
      "end": 1.98,
      "text": "Three Earths at the same time.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Earth and the Great Red Spot (4078049755).jpg",
        "credit": "Lunar and Planetary Institute from Houston, TX, USA",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Earth_and_the_Great_Red_Spot_(4078049755).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 1.967,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 1.98,
      "end": 5.02,
      "text": "Jupiter's Great Red Spot once fit them all side-by-side.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyager 1 Image of Jupiter's Great Red Spot in False Color.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Voyager_1_Image_of_Jupiter%27s_Great_Red_Spot_in_False_Color.jpg"
      },
      "shots": [
        {
          "start": 1.967,
          "end": 5.033,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 5.02,
      "end": 8.48,
      "text": "Even after shrinking for a century, it still swallows Earth whole.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Jupiter\u2019s Colourful Palette.tif",
        "credit": "NASA, ESA, A. Simon (Goddard Space Flight Center), and M.H. Wong (University of California, Berkeley)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Jupiter%E2%80%99s_Colourful_Palette.tif"
      },
      "shots": [
        {
          "start": 5.033,
          "end": 6.867,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 6.867,
          "end": 8.467,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.48,
      "end": 11.7,
      "text": "Internal winds around the edge roar past 200 miles per hour.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Great red spot juno 20170712.jpg",
        "credit": "NASA / SwRI / MSSS / Gerald Eichst\u00e4dt / Se\u00e1n Doran",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Great_red_spot_juno_20170712.jpg"
      },
      "shots": [
        {
          "start": 8.467,
          "end": 11.7,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.7,
      "end": 15.92,
      "text": "This vortex plunges 250 kilometers deep into the Jovian atmosphere.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NASA\u2019s Webb Discovers New Feature in Jupiter\u2019s Atmosphere (53270123023).jpg",
        "credit": "NASA's James Webb Space Telescope from Greenbelt, MD, USA",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:NASA%E2%80%99s_Webb_Discovers_New_Feature_in_Jupiter%E2%80%99s_Atmosphere_(53270123023).jpg"
      },
      "shots": [
        {
          "start": 11.7,
          "end": 15.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.92,
      "end": 18.74,
      "text": "Without a solid surface, nothing creates friction to stop it.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Grosser roter fleck.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Grosser_roter_fleck.jpg"
      },
      "shots": [
        {
          "start": 15.933,
          "end": 18.733,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.74,
      "end": 21.46,
      "text": "It survives by eating smaller passing storms.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Three Red Spots Mix It Up on Jupiter.jpg",
        "credit": "NASA, ESA, A. Simon-Miller (Goddard Space Flight Center), N. Chanover (New Mexico State University), and G. Orton (Jet Propulsion Laboratory)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Three_Red_Spots_Mix_It_Up_on_Jupiter.jpg"
      },
      "shots": [
        {
          "start": 18.733,
          "end": 21.467,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.46,
      "end": 23.84,
      "text": "When those storms thin out, this red monster starves.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Jupiter\u2019s storms- temperatures and cloud colours (eso1010a).tiff",
        "credit": "ESO/NASA/JPL/ESA/L. Fletcher",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Jupiter%E2%80%99s_storms-_temperatures_and_cloud_colours_(eso1010a).tiff"
      },
      "shots": [
        {
          "start": 21.467,
          "end": 23.833,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.84,
      "end": 27.36,
      "text": "Red fragments peeled away in 2019, fueling fears of its death.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "It\u2019s Time to Change Hubble\u2019s Clock (SVS14578).jpg",
        "credit": "NASA's Scientific Visualization Studio - null",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:It%E2%80%99s_Time_to_Change_Hubble%E2%80%99s_Clock_(SVS14578).jpg"
      },
      "shots": [
        {
          "start": 23.833,
          "end": 27.367,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 27.36,
      "end": 29.825,
      "text": "Which is how this giant storm once swallowed...",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Earth and the Great Red Spot (4078049755).jpg",
        "credit": "Lunar and Planetary Institute from Houston, TX, USA",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Earth_and_the_Great_Red_Spot_(4078049755).jpg"
      },
      "shots": [
        {
          "start": 27.367,
          "end": 30.167,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
