{
  "id": "ep105",
  "duration": 47.26,
  "beats": [
    {
      "start": 0.08,
      "end": 4.072,
      "text": "A single storm on Saturn can wrap around the entire planet.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Saturn Storm December 2010.jpg",
        "credit": "NASA/JPL-Caltech/SSI",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Saturn_Storm_December_2010.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.072,
      "end": 10.342,
      "text": "Most people think Jupiter has the solar system's only megastorms, but Saturn hides a secret.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Jupiter - Great Red Spot - PJ7-60 61 62 - Balanced (49803032983).png",
        "credit": "Kevin Gill from Los Angeles, CA, United States",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Jupiter_-_Great_Red_Spot_-_PJ7-60_61_62_-_Balanced_(49803032983).png"
      },
      "shots": [
        {
          "start": 4.067,
          "end": 7.2,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 7.2,
          "end": 10.333,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.342,
      "end": 15.262,
      "text": "Every thirty years, the gas giant erupts with a colossal Great White Spot.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The great white spot on Saturn (eso9014a).jpg",
        "credit": "ESO",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:The_great_white_spot_on_Saturn_(eso9014a).jpg"
      },
      "shots": [
        {
          "start": 10.333,
          "end": 15.267,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.262,
      "end": 20.207,
      "text": "Six of these planetary tempests have been recorded since eighteen seventy-six.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Professor Asaph Hall.jpg",
        "credit": "Unknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Professor_Asaph_Hall.jpg"
      },
      "shots": [
        {
          "start": 15.267,
          "end": 18.4,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 18.4,
          "end": 20.2,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.207,
      "end": 26.102,
      "text": "In twenty-ten, NASA's Cassini spacecraft watched a storm head grow as wide as Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Saturn Storm.jpg",
        "credit": "NASA/JPL-Caltech/SSI",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Saturn_Storm.jpg"
      },
      "shots": [
        {
          "start": 20.2,
          "end": 26.1,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 26.102,
      "end": 31.672,
      "text": "This monster generated ten lightning flashes per second while whipping out a massive tail.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 26.1,
          "end": 31.667,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 31.672,
      "end": 36.797,
      "text": "Within six months, that tail stretched around the world until it hit its own head.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Saturn Storm Panoramas.jpg",
        "credit": "NASA/JPL-Caltech/SSI",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Saturn_Storm_Panoramas.jpg"
      },
      "shots": [
        {
          "start": 31.667,
          "end": 35.133,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 35.133,
          "end": 36.8,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 36.797,
      "end": 42.097,
      "text": "These massive chemical remnants linger in the upper atmosphere for centuries.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 36.8,
          "end": 42.1,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 42.097,
      "end": 46.91,
      "text": "Leaving permanent scars until Saturn unleashes its next planetary monster.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Saturn Storm December 2010.jpg",
        "credit": "NASA/JPL-Caltech/SSI",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Saturn_Storm_December_2010.jpg"
      },
      "shots": [
        {
          "start": 42.1,
          "end": 47.267,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
