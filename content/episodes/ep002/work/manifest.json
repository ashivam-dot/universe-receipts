  "beats": [
    {
      "start": 0.15,
      "end": 3.971,
      "text": "NASA was already 43 years old before its first launch.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NACA seal (cropped).png",
        "credit": "NASA Headquarters - Greatest Images of NASA (NASA-HQ-GRIN), edited by Blue Sonic (talk\u00a0\u00b7 contribs)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:NACA_seal_(cropped).png"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.967,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.971,
      "end": 10.741,
      "text": "In 1957, the Soviet Union launched Sputnik 1, triggering a wave of American panic.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Sputnik-1.jpg",
        "credit": "Korolev",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Sputnik-1.jpg"
      },
      "shots": [
        {
          "start": 3.967,
          "end": 10.733,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.741,
      "end": 16.991,
      "text": "The U.S. response was a disaster; the Vanguard rocket exploded on live television.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Vanguard rocket explodes.jpg",
        "credit": "U.S. Navy",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Vanguard_rocket_explodes.jpg"
      },
      "shots": [
        {
          "start": 10.733,
          "end": 17.0,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.991,
      "end": 24.011,
      "text": "To fix the mess, President Eisenhower signed the 1958 Space Act to create a civilian agency.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Foto dedicada a LAEE por Dwight Eisenhower.jpg",
        "credit": "From: Luis A. Eguiguren. Taken by:Leguicall",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Foto_dedicada_a_LAEE_por_Dwight_Eisenhower.jpg"
      },
      "shots": [
        {
          "start": 17.0,
          "end": 24.0,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.011,
      "end": 30.781,
      "text": "He rebranded the National Advisory Committee for Aeronautics, a research group founded in 1915.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NASA Lewis Research Center replaces the NACA Lewis Flight Propulsion Laboratory (GRC-1958-C-48852).jpg",
        "credit": "NASA Glenn Research Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:NASA_Lewis_Research_Center_replaces_the_NACA_Lewis_Flight_Propulsion_Laboratory_(GRC-1958-C-48852).jpg"
      },
      "shots": [
        {
          "start": 24.0,
          "end": 28.7,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 28.7,
          "end": 30.767,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 30.781,
      "end": 37.176,
      "text": "NASA opened that October with 8,000 inherited employees and three massive laboratories.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Origin of Marshall Space Flight Center (MSFC) (9248169).jpg",
        "credit": "NASA Marshall Space Flight Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Origin_of_Marshall_Space_Flight_Center_(MSFC)_(9248169).jpg"
      },
      "shots": [
        {
          "start": 30.767,
          "end": 33.5,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 33.5,
          "end": 37.167,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 37.176,
      "end": 43.796,
      "text": "Early success relied on former Nazi scientist Wernher von Braun, who developed the V-2 rocket.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Wernher von Braun.jpg",
        "credit": "NASA/MSFC",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Wernher_von_Braun.jpg"
      },
      "shots": [
        {
          "start": 37.167,
          "end": 40.233,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 40.233,
          "end": 43.8,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 43.796,
      "end": 51.121,
      "text": "His team launched Explorer 1 in 1958, turning a 43-year-old committee into a space titan.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Wernher von Braun (5663627).jpg",
        "credit": "NASA Marshall Space Flight Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Wernher_von_Braun_(5663627).jpg"
      },
      "shots": [
        {
          "start": 43.8,
          "end": 47.467,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 47.467,
          "end": 51.133,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 51.121,
      "end": 55.782,
      "text": "This transformation saved the American space program, which began because...",
      "asset": {
        "source": "Wikimedia Commons",
