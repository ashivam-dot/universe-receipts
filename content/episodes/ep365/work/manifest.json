{
  "id": "ep365",
  "duration": 28.436,
  "beats": [
    {
      "start": 0.08,
      "end": 3.4,
      "text": "The first probe orbiting Mars found it swallowed by dust.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mariner09.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Mariner09.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.4,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.4,
      "end": 5.8,
      "text": "Mariner 9 beat its twin, which crashed in the ocean.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "08 002160 SDASM Space Image - MLV (AC69) (54035752428).jpg",
        "credit": "San Diego Air & Space Museum Archives",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:08_002160_SDASM_Space_Image_-_MLV_(AC69)_(54035752428).jpg"
      },
      "shots": [
        {
          "start": 3.4,
          "end": 5.8,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 5.8,
      "end": 9.48,
      "text": "A planet-wide storm had blinded the entire Red Planet.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA02985 Dust storm in the Thaumasia region of Mars.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA02985_Dust_storm_in_the_Thaumasia_region_of_Mars.jpg"
      },
      "shots": [
        {
          "start": 5.8,
          "end": 9.467,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.48,
      "end": 12.72,
      "text": "Two Soviet probes arrived and blindly took photos of dust.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mars 1 (Memorial Museum of Astronautics).JPG",
        "credit": "Armael",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Mars_1_(Memorial_Museum_of_Astronautics).JPG"
      },
      "shots": [
        {
          "start": 9.467,
          "end": 12.733,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.72,
      "end": 15.16,
      "text": "Their fixed programming could not adapt to the storm.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mars Polar Lander - landing diagram.png",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Mars_Polar_Lander_-_landing_diagram.png"
      },
      "shots": [
        {
          "start": 12.733,
          "end": 15.167,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.16,
      "end": 18.16,
      "text": "NASA engineers reprogrammed Mariner 9 from Earth to wait.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Overall view of Mission Control Center during Apollo 14 (S71-16879).jpg",
        "credit": "NASA Johnson Space Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Overall_view_of_Mission_Control_Center_during_Apollo_14_(S71-16879).jpg"
      },
      "shots": [
        {
          "start": 15.167,
          "end": 18.167,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.16,
      "end": 21.6,
      "text": "When dust cleared, Mariner 9 mapped massive extinct volcanoes.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Olympus Mons alt.jpg",
        "credit": "Image by NASA, modifications by Seddon",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Olympus_Mons_alt.jpg"
      },
      "shots": [
        {
          "start": 18.167,
          "end": 21.6,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.6,
      "end": 25.02,
      "text": "It discovered a canyon system spanning 2,500 miles.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Valles Marineris - Mars - July 19 2015 (49204861137).jpg",
        "credit": "Kevin M. Gill",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Valles_Marineris_-_Mars_-_July_19_2015_(49204861137).jpg"
      },
      "shots": [
        {
          "start": 21.6,
          "end": 25.033,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.02,
      "end": 28.086,
      "text": "Smart reprogramming turned a blinded mission into history.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mariner09.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Mariner09.jpg"
      },
      "shots": [
        {
          "start": 25.033,
          "end": 28.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
