{
  "id": "ep365",
  "duration": 32.365,
  "beats": [
    {
      "start": 0.08,
      "end": 2.9,
      "text": "Mariner 9 was the first probe to orbit another planet.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mariner09.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Mariner09.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.9,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 2.9,
      "end": 5.14,
      "text": "It beat its twin, which crashed in the Atlantic.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 2.9,
          "end": 5.133,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 5.14,
      "end": 8.4,
      "text": "But on arrival, it found only a wall of dust.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA02985 Dust storm in the Thaumasia region of Mars.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA02985_Dust_storm_in_the_Thaumasia_region_of_Mars.jpg"
      },
      "shots": [
        {
          "start": 5.133,
          "end": 8.4,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.4,
      "end": 12.1,
      "text": "A global storm had swallowed the entire Red Planet.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Comparison of atmospheric activity (blue 410 nm) from 1997 and 2001 (opo0131e).jpg",
        "credit": "J. Bell (Cornell University)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Comparison_of_atmospheric_activity_(blue_410_nm)_from_1997_and_2001_(opo0131e).jpg"
      },
      "shots": [
        {
          "start": 8.4,
          "end": 12.1,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.1,
      "end": 15.02,
      "text": "Two Soviet probes arrived but couldn't adapt to the storm.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mars 3 Space Probe 1.jpg",
        "credit": "Stolbovsky",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Mars_3_Space_Probe_1.jpg"
      },
      "shots": [
        {
          "start": 12.1,
          "end": 15.033,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.02,
      "end": 18.42,
      "text": "They blindly snapped thousands of photos of pure dust.",
      "asset": {
        "source": "Flickr via Openverse",
        "title": "Stratigraphy of the North Polar Deposits",
        "credit": "UAHiRISE (NASA)",
        "license": "CC0",
        "url": "https://www.flickr.com/photos/71688597@N05/55432325774"
      },
      "shots": [
        {
          "start": 15.033,
          "end": 18.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.42,
      "end": 21.92,
      "text": "NASA engineers reprogrammed the ship from Earth in 1971.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 18.433,
          "end": 21.933,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.92,
      "end": 24.8,
      "text": "Mariner 9 waited months for the Martian sky to clear.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mars atmosphere by Hubble.jpg",
        "credit": "Philip James (University of Toledo), Steven Lee (University of Colorado), NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Mars_atmosphere_by_Hubble.jpg"
      },
      "shots": [
        {
          "start": 21.933,
          "end": 24.8,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.8,
      "end": 28.82,
      "text": "It finally mapped massive volcanoes and 2,500-mile canyons.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Valles Marineris PIA00178.jpg",
        "credit": "NASA/JPL/USGS",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Valles_Marineris_PIA00178.jpg"
      },
      "shots": [
        {
          "start": 24.8,
          "end": 28.833,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 28.82,
      "end": 32.015,
      "text": "It succeeded even when the planet was hidden by dust.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mariner09.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Mariner09.jpg"
      },
      "shots": [
        {
          "start": 28.833,
          "end": 32.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
