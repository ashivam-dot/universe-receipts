{
  "id": "ep047",
  "duration": 43.0,
  "beats": [
    {
      "start": 0.08,
      "end": 2.74,
      "text": "There is no permanent dark side of the Moon.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Keeler crater AS10-32-4823.jpg",
        "credit": "James Stuby based on NASA image",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Keeler_crater_AS10-32-4823.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.733,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 2.74,
      "end": 6.91,
      "text": "Pop culture claims one hemisphere is shrouded in endless shadow.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Lunar Near and Far Side Phases (SVS14992 - Moon-Phases-Near-Far-VERT-Thumbnail).jpg",
        "credit": "NASA's Scientific Visualization Studio - eMITS/Dan Gallagher, USRA/Ernie Wright, Tuomas Kankola",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Lunar_Near_and_Far_Side_Phases_(SVS14992_-_Moon-Phases-Near-Far-VERT-Thumbnail).jpg"
      },
      "shots": [
        {
          "start": 2.733,
          "end": 6.9,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.91,
      "end": 14.955,
      "text": "In October 1959, the Soviet Luna 3 probe beamed back the first grainy photographs of the unseen hemisphere.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Luna 3 moon.jpg",
        "credit": "OKB-1",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Luna_3_moon.jpg"
      },
      "shots": [
        {
          "start": 6.9,
          "end": 14.967,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.955,
      "end": 20.2,
      "text": "Direct radio contact with Earth is completely blocked behind the lunar globe.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "QueqiaoDFH.jpg",
        "credit": "Zhang Lihua/Dong Fang Hong Satelliten GmbH",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:QueqiaoDFH.jpg"
      },
      "shots": [
        {
          "start": 14.967,
          "end": 20.2,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.2,
      "end": 27.695,
      "text": "On January 3, 2019, China's Chang'e 4 mission achieved the first soft landing on this rugged terrain.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "ChangE-4 - PCAM.png",
        "credit": "CSNA/Siyu Zhang/Kevin M. Gill",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:ChangE-4_-_PCAM.png"
      },
      "shots": [
        {
          "start": 20.2,
          "end": 23.233,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 23.233,
          "end": 27.7,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 27.695,
      "end": 32.465,
      "text": "When Earth sees a full Moon, the far side is cast in complete darkness.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Lunar Near and Far Side Phases (SVS14992 - Moon Phases Waning Thumbnail V2).jpg",
        "credit": "NASA's Scientific Visualization Studio - eMITS/Dan Gallagher, USRA/Ernie Wright, Tuomas Kankola",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Lunar_Near_and_Far_Side_Phases_(SVS14992_-_Moon_Phases_Waning_Thumbnail_V2).jpg"
      },
      "shots": [
        {
          "start": 27.7,
          "end": 30.933,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 30.933,
          "end": 32.467,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 32.465,
      "end": 37.265,
      "text": "Yet during a new Moon, the far side is bathed in blazing daylight.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Tsiolkovskiy Central Peak Oblique (LROC447 - M198059280LR thumb).png",
        "credit": "NASA/GSFC/Arizona State University",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Tsiolkovskiy_Central_Peak_Oblique_(LROC447_-_M198059280LR_thumb).png"
      },
      "shots": [
        {
          "start": 32.467,
          "end": 37.267,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 37.265,
      "end": 42.65,
      "text": "Both halves cycle through sunlight equally, proving there is no permanent dark side of the Moon.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Keeler crater AS10-32-4823.jpg",
        "credit": "James Stuby based on NASA image",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Keeler_crater_AS10-32-4823.jpg"
      },
      "shots": [
        {
          "start": 37.267,
          "end": 43.0,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
