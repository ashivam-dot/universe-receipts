  "beats": [
    {
      "start": 0.08,
      "end": 4.634,
      "text": "Four astronauts will soon travel farther from Earth than any humans ever.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artemis 2 Crew Portrait.jpg",
        "credit": "Josh Valcarcel",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Artemis_2_Crew_Portrait.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 1.833,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 1.833,
          "end": 4.633,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.634,
      "end": 9.904,
      "text": "Artemis II is NASA\u2019s first crewed mission to the Moon in over 50 years.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NASA\u2019s Space Launch System (SLS) rocket with the Orion spacecraft aboard is seen atop a mobile launcher at Launch Complex 39B.jpg",
        "credit": "Joel Kowsky",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:NASA%E2%80%99s_Space_Launch_System_(SLS)_rocket_with_the_Orion_spacecraft_aboard_is_seen_atop_a_mobile_launcher_at_Launch_Complex_39B.jpg"
      },
      "shots": [
        {
          "start": 4.633,
          "end": 9.9,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.904,
      "end": 16.074,
      "text": "Since 1972, every human spaceflight has remained confined to low Earth orbit.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "ISS042-E-283295 - View of Earth.jpg",
        "credit": "Earth Science and Remote Sensing Unit, Lyndon B. Johnson Space Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:ISS042-E-283295_-_View_of_Earth.jpg"
      },
      "shots": [
        {
          "start": 9.9,
          "end": 13.0,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 13.0,
          "end": 16.067,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.074,
      "end": 21.069,
      "text": "But commander Reid Wiseman and his crew will first climb into high Earth orbit.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Orion LunarFLyby 4k (656314676363).jpg",
        "credit": "Uploaded by Patricia Moore",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Orion_LunarFLyby_4k_(656314676363).jpg"
      },
      "shots": [
        {
          "start": 16.067,
          "end": 19.5,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 19.5,
          "end": 21.067,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.069,
      "end": 29.964,
      "text": "Powered by a European Service Module, their spacecraft, named Integrity, will reach between 44,000 and 46,000 miles.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Orion Service Module elements 2015.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Orion_Service_Module_elements_2015.jpg"
      },
      "shots": [
        {
          "start": 21.067,
          "end": 29.967,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 29.964,
      "end": 35.434,
      "text": "Pilot Victor Glover will then guide them on a slingshot around the lunar far side.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Far side of the Moon close up for Lunar Crater Radio Telescope.png",
        "credit": "Wikideas1",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Far_side_of_the_Moon_close_up_for_Lunar_Crater_Radio_Telescope.png"
      },
      "shots": [
        {
          "start": 29.967,
          "end": 32.667,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 32.667,
          "end": 35.433,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 35.434,
      "end": 40.979,
      "text": "Mission specialist Jeremy Hansen will be the first non-American to leave Earth orbit.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Jeremy Hansen official portrait.jpg",
        "credit": "Robert Markowitz",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Jeremy_Hansen_official_portrait.jpg"
      },
      "shots": [
        {
          "start": 35.433,
          "end": 40.967,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 40.979,
      "end": 47.654,
      "text": "This 10-day flight into deep space finally shatters the distance record held by Apollo 13.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "AS13-60-8593 (22044738711).jpg",
        "credit": "Project Apollo Archive",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:AS13-60-8593_(22044738711).jpg"
      },
      "shots": [
        {
          "start": 40.967,
          "end": 44.467,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 44.467,
          "end": 47.667,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 47.654,
      "end": 52.54,
      "text": "By 2026, these four will travel farther from Earth than any humans ever.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artemis 2 Crew Portrait.jpg",
        "credit": "Josh Valcarcel",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Artemis_2_Crew_Portrait.jpg"
      },
      "shots": [
        {
          "start": 47.667,
          "end": 52.9,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
