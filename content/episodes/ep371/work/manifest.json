{
  "id": "ep371",
  "duration": 31.123,
  "beats": [
    {
      "start": 0.08,
      "end": 4.08,
      "text": "NASA fired a sleeping engine 13 billion miles away.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyager spacecraft.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Voyager_spacecraft.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.08,
      "end": 7.08,
      "text": "Voyager 1's steering jets were dying in the interstellar cold.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyager spacecraft structure.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Voyager_spacecraft_structure.jpg"
      },
      "shots": [
        {
          "start": 4.067,
          "end": 7.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.08,
      "end": 9.96,
      "text": "Losing them meant the probe would drift into silence forever.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Solar Rays Hit Space Age High (3967680978).jpg",
        "credit": "NASA Goddard Photo and Video",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Solar_Rays_Hit_Space_Age_High_(3967680978).jpg"
      },
      "shots": [
        {
          "start": 7.067,
          "end": 9.967,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.96,
      "end": 14.38,
      "text": "Engineers found backup thrusters dormant since a 1980 Saturn flyby.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Saturn's Rings Close Up from Voyager 1.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Saturn%27s_Rings_Close_Up_from_Voyager_1.jpg"
      },
      "shots": [
        {
          "start": 9.967,
          "end": 14.367,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.38,
      "end": 17.92,
      "text": "They spent weeks decoding software written in an obsolete language.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mission Control- Floor Level (49386802568).png",
        "credit": "NASAJPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Mission_Control-_Floor_Level_(49386802568).png"
      },
      "shots": [
        {
          "start": 14.367,
          "end": 17.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.92,
      "end": 20.54,
      "text": "NASA beamed a command into the dark and waited.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Webb and the Deep Space Network (01HE5JBMEVP7EJKJD12XE590VQ).jpg",
        "credit": "Illustration NASA, ESA, CSA, Pam Jeffries (STScI)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Webb_and_the_Deep_Space_Network_(01HE5JBMEVP7EJKJD12XE590VQ).jpg"
      },
      "shots": [
        {
          "start": 17.933,
          "end": 20.533,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.54,
      "end": 24.32,
      "text": "A signal reached California after 19 hours of travel time.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Deep Space Antenna 210' at Goldstone, CA (JPL ref- P-116594AC) (ARC-1972-A72-2699).jpg",
        "credit": "NASA Ames Research Center / JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Deep_Space_Antenna_210%27_at_Goldstone,_CA_(JPL_ref-_P-116594AC)_(ARC-1972-A72-2699).jpg"
      },
      "shots": [
        {
          "start": 20.533,
          "end": 24.333,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.32,
      "end": 28.12,
      "text": "The engines worked perfectly after 37 years of frozen sleep.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "RS-68 rocket engine test.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:RS-68_rocket_engine_test.jpg"
      },
      "shots": [
        {
          "start": 24.333,
          "end": 28.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 28.12,
      "end": 30.773,
      "text": "This keeps our most distant messenger talking to home.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyager spacecraft.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Voyager_spacecraft.jpg"
      },
      "shots": [
        {
          "start": 28.133,
          "end": 31.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
