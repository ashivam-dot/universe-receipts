  "beats": [
    {
      "start": 0.08,
      "end": 4.743,
      "text": "The full moon does not actually cause crime or emergency room chaos.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Near Full Moon in High Resolution.jpg",
        "credit": "Msadler13",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Near_Full_Moon_in_High_Resolution.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.9,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 2.9,
          "end": 4.733,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.743,
      "end": 11.038,
      "text": "For centuries, people blamed the lunar cycle for spikes in hospital admissions and police calls.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "MarkhamStouffvilleHospital23.jpg",
        "credit": "Raysonho @ Open Grid Scheduler / Grid Engine",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:MarkhamStouffvilleHospital23.jpg"
      },
      "shots": [
        {
          "start": 4.733,
          "end": 7.233,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 7.233,
          "end": 11.033,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.038,
      "end": 17.608,
      "text": "Meta-analyses of over one hundred studies show absolutely no correlation with human behavior.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Scientific Method.jpg",
        "credit": "Rodneyeast at English Wikibooks",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Scientific_Method.jpg"
      },
      "shots": [
        {
          "start": 11.033,
          "end": 17.6,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.608,
      "end": 25.908,
      "text": "Even the popular twenty-eight day human menstrual cycle is actually a mismatch for the twenty-nine point five day lunar month.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Figure 28 02 07 zh.jpg",
        "credit": "File:Figure 28 02 07.jpg: OpenStax College\nderivative work: GnolizX",
        "license": "CC BY 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:Figure_28_02_07_zh.jpg"
      },
      "shots": [
        {
          "start": 17.6,
          "end": 25.9,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.908,
      "end": 32.578,
      "text": "While the moon pulls on entire oceans, its gravity is far too weak to impact human physiology.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "King tides and big waves, Shore Acres, Oregon coast - Flickr - Bonnie Moreland (free images).jpg",
        "credit": "Bonnie Moreland from Oregon, United States",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:King_tides_and_big_waves,_Shore_Acres,_Oregon_coast_-_Flickr_-_Bonnie_Moreland_(free_images).jpg"
      },
      "shots": [
        {
          "start": 25.9,
          "end": 29.933,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 29.933,
          "end": 32.567,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 32.578,
      "end": 37.898,
      "text": "Higher tides occur because the Sun, Earth, and Moon align their forces together.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Rhythms and Clocks in Marine Organisms Figure 1 Solar and Lunar Cycles ma150509.f1.jpg",
        "credit": "Image in panel a created by Reto Stockli with the help of Alan Nelson, under the leadership of Fritz Hasler, and reproduced from NASA's Visible Earth catalog (https://visibleearth.nasa.gov/images/5438",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Rhythms_and_Clocks_in_Marine_Organisms_Figure_1_Solar_and_Lunar_Cycles_ma150509.f1.jpg"
      },
      "shots": [
        {
          "start": 32.567,
          "end": 36.0,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 36.0,
          "end": 37.9,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 37.898,
      "end": 44.868,
      "text": "Coral species sync their spawning with moonlight, but human behavior remains entirely grounded by science.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Elkhorn coral Horseshoe Reef with diver.png",
        "credit": "Ananda Ellis/NOAA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Elkhorn_coral_Horseshoe_Reef_with_diver.png"
      },
      "shots": [
        {
          "start": 37.9,
          "end": 44.867,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 44.868,
      "end": 48.645,
      "text": "Myths about the full moon persist despite the lack of evidence.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Near Full Moon in High Resolution.jpg",
        "credit": "Msadler13",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Near_Full_Moon_in_High_Resolution.jpg"
      },
      "shots": [
        {
          "start": 44.867,
          "end": 49.0,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
