{
  "id": "ep366",
  "duration": 26.079,
  "beats": [
    {
      "start": 0.08,
      "end": 2.9,
      "text": "An asteroid flew closer to Earth than the space station.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "14-281-KuiperBeltObject-ArtistsConcept-20141015.jpg",
        "credit": "ASA, ESA, and G. Bacon (STScI)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:14-281-KuiperBeltObject-ArtistsConcept-20141015.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.9,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 2.9,
      "end": 5.84,
      "text": "It skimmed just 230 miles above the South Pacific.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "12 00 az (5367501395).jpg",
        "credit": "Alan Myers from London Town, United Kingdom",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:12_00_az_(5367501395).jpg"
      },
      "shots": [
        {
          "start": 2.9,
          "end": 5.833,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 5.84,
      "end": 8.42,
      "text": "This is the closest near-miss ever documented.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "STS-134 International Space Station after undocking.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:STS-134_International_Space_Station_after_undocking.jpg"
      },
      "shots": [
        {
          "start": 5.833,
          "end": 8.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.42,
      "end": 11.2,
      "text": "It beat the previous record by over 1,500 miles.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA24038-Asteroid2020QG-20200816.jpg",
        "credit": "ZTF/Caltech Optical Observatories (funded by NASA and the National Science Foundation-NSF)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA24038-Asteroid2020QG-20200816.jpg"
      },
      "shots": [
        {
          "start": 8.433,
          "end": 11.2,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.2,
      "end": 14.22,
      "text": "But every telescope on Earth was completely blind to it.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mauna Loa Observatory.png",
        "credit": "NOAA Research cover image",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Mauna_Loa_Observatory.png"
      },
      "shots": [
        {
          "start": 11.2,
          "end": 14.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.22,
      "end": 17.14,
      "text": "The rock approached from the Sun, hiding in the glare.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "SDO's Ultra-high Definition View of 2012 Venus Transit -- Path Sequence.jpg",
        "credit": "NASA/SDO, AIA",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:SDO%27s_Ultra-high_Definition_View_of_2012_Venus_Transit_--_Path_Sequence.jpg"
      },
      "shots": [
        {
          "start": 14.233,
          "end": 15.4,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 15.4,
          "end": 17.133,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.14,
      "end": 20.12,
      "text": "Astronomers only spotted it 15 hours after it passed.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "2001 SG286 orbit.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:2001_SG286_orbit.jpg"
      },
      "shots": [
        {
          "start": 17.133,
          "end": 20.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.12,
      "end": 22.8,
      "text": "Earth\u2019s gravity hijacked the rock and shrank its orbit.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Lunar perturbation.jpg",
        "credit": "Geologician, Homunculus 2",
        "license": "CC BY 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:Lunar_perturbation.jpg"
      },
      "shots": [
        {
          "start": 20.133,
          "end": 22.8,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.8,
      "end": 25.729,
      "text": "On that Friday the 13th, the world never saw it coming.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "14-281-KuiperBeltObject-ArtistsConcept-20141015.jpg",
        "credit": "ASA, ESA, and G. Bacon (STScI)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:14-281-KuiperBeltObject-ArtistsConcept-20141015.jpg"
      },
      "shots": [
        {
          "start": 22.8,
          "end": 26.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
