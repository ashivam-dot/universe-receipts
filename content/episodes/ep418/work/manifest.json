{
  "id": "ep418",
  "duration": 31.725,
  "beats": [
    {
      "start": 0.08,
      "end": 3.54,
      "text": "NASA fixed a jammed spacecraft millions of miles from Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artwork Galileo-Io-Jupiter.JPG",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Artwork_Galileo-Io-Jupiter.JPG"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.533,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.54,
      "end": 7.68,
      "text": "In deep space, Galileo's primary main antenna jammed shut.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Detailed Drawing of the Galileo Spacecraft.png",
        "credit": "Unknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Detailed_Drawing_of_the_Galileo_Spacecraft.png"
      },
      "shots": [
        {
          "start": 3.533,
          "end": 5.833,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 5.833,
          "end": 7.667,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.68,
      "end": 10.88,
      "text": "Without that dish, beaming photos from Jupiter seemed impossible.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Galileo Gaspra Mosaic.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Galileo_Gaspra_Mosaic.jpg"
      },
      "shots": [
        {
          "start": 7.667,
          "end": 10.867,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.88,
      "end": 13.82,
      "text": "Engineers at mission control tried every trick to unlock it.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "VP Quayle Attends TCDT.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:VP_Quayle_Attends_TCDT.jpg"
      },
      "shots": [
        {
          "start": 10.867,
          "end": 13.833,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.82,
      "end": 17.66,
      "text": "When physical fixes failed, they completely rewrote the probe's software.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 13.833,
          "end": 17.667,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.66,
      "end": 21.46,
      "text": "They beamed the new code across hundreds of millions of miles.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Deep Space Antenna 210' at Goldstone, CA (JPL ref- P-116594AC) (ARC-1972-A72-2699).jpg",
        "credit": "NASA Ames Research Center / JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Deep_Space_Antenna_210%27_at_Goldstone,_CA_(JPL_ref-_P-116594AC)_(ARC-1972-A72-2699).jpg"
      },
      "shots": [
        {
          "start": 17.667,
          "end": 21.467,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.46,
      "end": 24.82,
      "text": "The software compressed data so the weak backup antenna worked.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Galileo Jupiter probe leaves the Orbiter (ACD95-0229).jpg",
        "credit": "Don Davis",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Galileo_Jupiter_probe_leaves_the_Orbiter_(ACD95-0229).jpg"
      },
      "shots": [
        {
          "start": 21.467,
          "end": 22.667,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 22.667,
          "end": 24.833,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.82,
      "end": 28.54,
      "text": "That code saved the mission, revealing ocean worlds around Jupiter.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Europa-moon.jpg",
        "credit": "NASA/JPL/DLR",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Europa-moon.jpg"
      },
      "shots": [
        {
          "start": 24.833,
          "end": 28.533,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 28.54,
      "end": 31.375,
      "text": "No human could ever reach the broken dish in deep space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artwork Galileo-Io-Jupiter.JPG",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Artwork_Galileo-Io-Jupiter.JPG"
      },
      "shots": [
        {
          "start": 28.533,
          "end": 31.733,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
