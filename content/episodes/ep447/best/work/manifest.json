{
  "id": "ep447",
  "duration": 32.135,
  "beats": [
    {
      "start": 0.08,
      "end": 4.24,
      "text": "Tiny dwarf galaxies are leaking oxygen into deep space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hubble Reveals Stellar Fireworks in \u2018Skyrocket\u2019 Galaxy (27946907106).jpg",
        "credit": "NASA Goddard Space Flight Center from Greenbelt, MD, USA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Hubble_Reveals_Stellar_Fireworks_in_%E2%80%98Skyrocket%E2%80%99_Galaxy_(27946907106).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 1.733,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 1.733,
          "end": 4.233,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.24,
      "end": 6.98,
      "text": "Every breath we take was forged inside a star.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Massive star cutaway pre-collapse (pinned, 8M+).png",
        "credit": "FT2",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Massive_star_cutaway_pre-collapse_(pinned,_8M%2B).png"
      },
      "shots": [
        {
          "start": 4.233,
          "end": 6.967,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.98,
      "end": 10.36,
      "text": "When stars explode as supernovae, they expel that oxygen.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The Crab Nebula (opo9622a2).jpg",
        "credit": "Jeff Hester and Paul Scowen (Arizona State University), and NASA/ESA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:The_Crab_Nebula_(opo9622a2).jpg"
      },
      "shots": [
        {
          "start": 6.967,
          "end": 10.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.36,
      "end": 12.92,
      "text": "Most massive galaxies have enough gravity to trap it.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Perfect Spiral M74 (gemini0607a).jpg",
        "credit": "International Gemini Observatory/GMOS Commissioning Team",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Perfect_Spiral_M74_(gemini0607a).jpg"
      },
      "shots": [
        {
          "start": 10.367,
          "end": 12.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.92,
      "end": 16.64,
      "text": "But NASA's Hubble found these tiny star systems are empty.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hubble Space Telescope (27946391011).jpg",
        "credit": "NASA Hubble Space Telescope",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Hubble_Space_Telescope_(27946391011).jpg"
      },
      "shots": [
        {
          "start": 12.933,
          "end": 14.8,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 14.8,
          "end": 16.633,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.64,
      "end": 20.28,
      "text": "Violent galactic winds act like a massive cosmic purge.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "M82 (11524877534).png",
        "credit": "geckzilla",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:M82_(11524877534).png"
      },
      "shots": [
        {
          "start": 16.633,
          "end": 20.267,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.28,
      "end": 23.8,
      "text": "These gales blast oxygen entirely out of the galaxy's reach.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist\u2019s Impression of Milky Way Inflows and Outflows (2019-46-4570).tif",
        "credit": "NASA, ESA, and D. Player (STScI)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%E2%80%99s_Impression_of_Milky_Way_Inflows_and_Outflows_(2019-46-4570).tif"
      },
      "shots": [
        {
          "start": 20.267,
          "end": 23.8,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.8,
      "end": 27.14,
      "text": "These tiny systems are the universe's primary chemical polluters.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "SMC - Noirlab2030b.jpg",
        "credit": "Credit: CTIO/NOIRLab/NSF/AURA/SMASH/D. Nidever (Montana State University)\n\nAcknowledgment: Image processing: Travis Rector (University of Alaska Anchorage), Mahdi Zamani & Davide de Martin",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:SMC_-_Noirlab2030b.jpg"
      },
      "shots": [
        {
          "start": 23.8,
          "end": 27.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 27.14,
      "end": 31.785,
      "text": "That's why tiny dwarf galaxies are leaking oxygen into deep space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hubble Reveals Stellar Fireworks in \u2018Skyrocket\u2019 Galaxy (27946907106).jpg",
        "credit": "NASA Goddard Space Flight Center from Greenbelt, MD, USA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Hubble_Reveals_Stellar_Fireworks_in_%E2%80%98Skyrocket%E2%80%99_Galaxy_(27946907106).jpg"
      },
      "shots": [
        {
          "start": 27.133,
          "end": 32.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
