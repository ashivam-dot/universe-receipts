{
  "id": "ep447",
  "duration": 29.206,
  "beats": [
    {
      "start": 0.08,
      "end": 3.22,
      "text": "Tiny dwarf galaxies are leaking oxygen into deep space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hubble Reveals Stellar Fireworks in \u2018Skyrocket\u2019 Galaxy (27946907106).jpg",
        "credit": "NASA Goddard Space Flight Center from Greenbelt, MD, USA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Hubble_Reveals_Stellar_Fireworks_in_%E2%80%98Skyrocket%E2%80%99_Galaxy_(27946907106).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.22,
      "end": 5.78,
      "text": "Every breath we take was forged inside a star.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Massive star cutaway pre-collapse (pinned).png",
        "credit": "FT2",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Massive_star_cutaway_pre-collapse_(pinned).png"
      },
      "shots": [
        {
          "start": 3.233,
          "end": 5.767,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 5.78,
      "end": 8.86,
      "text": "When stars explode as supernovae, they expel that oxygen.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The Crab Nebula (opo9622a2).jpg",
        "credit": "Jeff Hester and Paul Scowen (Arizona State University), and NASA/ESA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:The_Crab_Nebula_(opo9622a2).jpg"
      },
      "shots": [
        {
          "start": 5.767,
          "end": 8.867,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.86,
      "end": 11.34,
      "text": "Most massive galaxies have enough gravity to trap it.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Perfect Spiral M74 (gemini0607a).jpg",
        "credit": "International Gemini Observatory/GMOS Commissioning Team",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Perfect_Spiral_M74_(gemini0607a).jpg"
      },
      "shots": [
        {
          "start": 8.867,
          "end": 11.333,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.34,
      "end": 15.38,
      "text": "But NASA\u2019s Hubble found these tiny systems have lost nearly all their oxygen.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hubble Space Telescope (27946391011).jpg",
        "credit": "NASA Hubble Space Telescope",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Hubble_Space_Telescope_(27946391011).jpg"
      },
      "shots": [
        {
          "start": 11.333,
          "end": 15.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.38,
      "end": 18.92,
      "text": "Violent galactic winds act like a massive cosmic purge.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "M82 (11524877534).png",
        "credit": "geckzilla",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:M82_(11524877534).png"
      },
      "shots": [
        {
          "start": 15.367,
          "end": 18.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.92,
      "end": 22.02,
      "text": "These gales blast oxygen entirely out of the galaxy's reach.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Seyfert Flare Illustration (2020-33-4669).tif",
        "credit": ", , and L. Hustak ()",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Seyfert_Flare_Illustration_(2020-33-4669).tif"
      },
      "shots": [
        {
          "start": 18.933,
          "end": 22.033,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.02,
      "end": 25.48,
      "text": "These tiny systems are the universe\u2019s most efficient chemical polluters.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Small Magellanic Cloud (ground-based image) (heic0603d).jpg",
        "credit": "ESA/Hubble and Digitized Sky Survey 2. Acknowledgements: Davide De Martin",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Small_Magellanic_Cloud_(ground-based_image)_(heic0603d).jpg"
      },
      "shots": [
        {
          "start": 22.033,
          "end": 25.467,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.48,
      "end": 28.856,
      "text": "That's why tiny dwarf galaxies are leaking oxygen into deep space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hubble Reveals Stellar Fireworks in \u2018Skyrocket\u2019 Galaxy (27946907106).jpg",
        "credit": "NASA Goddard Space Flight Center from Greenbelt, MD, USA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Hubble_Reveals_Stellar_Fireworks_in_%E2%80%98Skyrocket%E2%80%99_Galaxy_(27946907106).jpg"
      },
      "shots": [
        {
          "start": 25.467,
          "end": 29.2,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
