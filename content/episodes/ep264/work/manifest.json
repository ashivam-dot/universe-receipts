{
  "id": "ep264",
  "duration": 29.415,
  "beats": [
    {
      "start": 0.08,
      "end": 2.94,
      "text": "Mars is currently devouring its largest moon.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Phobos over Mars - Peridier Crater, Syrtis Major quadrangle - ESA Mars Express (52568167027).png",
        "credit": "Andrea Luck",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Phobos_over_Mars_-_Peridier_Crater,_Syrtis_Major_quadrangle_-_ESA_Mars_Express_(52568167027).png"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 1.067,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 1.067,
          "end": 2.933,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 2.94,
      "end": 6.12,
      "text": "It skims just 6,000 kilometers above the Martian dust.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 2.933,
          "end": 6.133,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.12,
      "end": 9.64,
      "text": "Named for the god of fear, this orbit is a death sentence.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Stickney PIA01333.jpg",
        "credit": "NASA/JPL/Malin Space Science Systems",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Stickney_PIA01333.jpg"
      },
      "shots": [
        {
          "start": 6.133,
          "end": 9.633,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.64,
      "end": 13.44,
      "text": "The planet drags the moon inward by two centimeters every year.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Phobos over Mars.png",
        "credit": "NASA, Viking 2 Orbiter",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Phobos_over_Mars.png"
      },
      "shots": [
        {
          "start": 9.633,
          "end": 13.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.44,
      "end": 17.48,
      "text": "Tidal forces are relentlessly stretching the moon\u2019s fragile interior.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Heaven is coming,Mars system.png",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Heaven_is_coming,Mars_system.png"
      },
      "shots": [
        {
          "start": 13.433,
          "end": 17.467,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.48,
      "end": 20.44,
      "text": "Within fifty million years, the Red Planet will win.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mars Valles Marineris.jpeg",
        "credit": "NASA / USGS (see PIA04304 catalog page)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Mars_Valles_Marineris.jpeg"
      },
      "shots": [
        {
          "start": 17.467,
          "end": 20.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.44,
      "end": 24.48,
      "text": "This destruction is inevitable because the moon will shatter into a dusty ring.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Extreme debris disc (artist\u2019s concept) (weic2618a).jpg",
        "credit": "NASA, ESA, CSA, J. Olmsted (STScI)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Extreme_debris_disc_(artist%E2%80%99s_concept)_(weic2618a).jpg"
      },
      "shots": [
        {
          "start": 20.433,
          "end": 24.467,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.48,
      "end": 29.065,
      "text": "Because every single year, Mars is steadily dragging its moon to its doom.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Phobos over Mars - Peridier Crater, Syrtis Major quadrangle - ESA Mars Express (52568167027).png",
        "credit": "Andrea Luck",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Phobos_over_Mars_-_Peridier_Crater,_Syrtis_Major_quadrangle_-_ESA_Mars_Express_(52568167027).png"
      },
      "shots": [
        {
          "start": 24.467,
          "end": 29.4,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    }
  ],
