        "url": "https://commons.wikimedia.org/wiki/File:Phobos_over_Mars_-_Peridier_Crater,_Syrtis_Major_quadrangle_-_ESA_Mars_Express_(52568167027).png"
      },
      "shots": [
        {
          "start": 22.733,
          "end": 26.6,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    }
  ],
