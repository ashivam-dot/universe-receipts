  "beats": [
    {
      "start": 0.08,
      "end": 2.86,
      "text": "Mars is currently devouring its largest moon.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Phobos over Mars - Peridier Crater, Syrtis Major quadrangle - ESA Mars Express (52568167027).png",
        "credit": "Andrea Luck",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Phobos_over_Mars_-_Peridier_Crater,_Syrtis_Major_quadrangle_-_ESA_Mars_Express_(52568167027).png"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 1.033,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 1.033,
          "end": 2.867,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 2.86,
      "end": 6.24,
      "text": "It skims just 6,000 kilometers above the Martian dust.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "US Navy 030826-N-9593R-043 Personnel at the U.S. Naval Observatory in Washington, D.C., prepare the facility's historic 26-inch refractor telescope for optical viewing of Mars.jpg",
        "credit": "U.S. Navy photo by Chief Warrant Officer 4 Seth Rossman",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:US_Navy_030826-N-9593R-043_Personnel_at_the_U.S._Naval_Observatory_in_Washington,_D.C.,_prepare_the_facility%27s_historic_26-inch_refractor_telescope_for_optical_viewing_of_Mars.jpg"
      },
      "shots": [
        {
          "start": 2.867,
          "end": 6.233,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.24,
      "end": 9.58,
      "text": "Named for the god of fear, this orbit is a death sentence.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Stickney PIA01333.jpg",
        "credit": "NASA/JPL/Malin Space Science Systems",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Stickney_PIA01333.jpg"
      },
      "shots": [
        {
          "start": 6.233,
          "end": 9.567,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.58,
      "end": 13.34,
      "text": "The planet drags the moon inward by two centimeters every year.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Phobos over Mars.png",
        "credit": "NASA, Viking 2 Orbiter",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Phobos_over_Mars.png"
      },
      "shots": [
        {
          "start": 9.567,
          "end": 13.333,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.34,
      "end": 17.12,
      "text": "Tidal forces are relentlessly stretching the moon\u2019s fragile interior.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Phobos over Mars.png",
        "credit": "NASA, Viking 2 Orbiter",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Phobos_over_Mars.png"
      },
      "shots": [
        {
          "start": 13.333,
          "end": 17.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.12,
      "end": 19.8,
      "text": "Within fifty million years, the Red Planet will win.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Stickney PIA01333.jpg",
        "credit": "NASA/JPL/Malin Space Science Systems",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Stickney_PIA01333.jpg"
      },
      "shots": [
        {
          "start": 17.133,
          "end": 19.8,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.8,
      "end": 24.04,
      "text": "This destruction is inevitable because the moon will shatter into a dusty ring.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Extreme debris disc (artist\u2019s concept) (weic2618a).jpg",
        "credit": "NASA, ESA, CSA, J. Olmsted (STScI)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Extreme_debris_disc_(artist%E2%80%99s_concept)_(weic2618a).jpg"
      },
      "shots": [
        {
          "start": 19.8,
          "end": 21.933,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 21.933,
          "end": 24.033,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.04,
      "end": 26.814,
      "text": "Mars is steadily dragging its moon to its doom.",
