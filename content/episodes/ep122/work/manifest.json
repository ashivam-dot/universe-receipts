  "beats": [
    {
      "start": 0.08,
      "end": 4.838,
      "text": "This deep blue world sixty-four light-years away holds no peaceful oceans.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist\u2019s impression of the deep blue planet HD 189733b.jpg",
        "credit": "NASA, ESA, M. Kornmesser",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%E2%80%99s_impression_of_the_deep_blue_planet_HD_189733b.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.167,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 3.167,
          "end": 4.833,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.838,
      "end": 15.258,
      "text": "When French astronomers discovered HD 189733 b in October 2005, its azure shade seemed familiar.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 4.833,
          "end": 15.267,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.258,
      "end": 21.508,
      "text": "Most people imagine water, but this planet is a scorching gas giant larger than Jupiter.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "HD 189733 b comparison.png",
        "credit": "SevenSpheres",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:HD_189733_b_comparison.png"
      },
      "shots": [
        {
          "start": 15.267,
          "end": 18.167,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 18.167,
          "end": 21.5,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.508,
      "end": 27.753,
      "text": "[Tidally](/t\u02c8Id\u02c8\u028cl\u02c8i/) locked to its parent star, atmospheric temperatures reach roughly twelve hundred Kelvin.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Global Temperature Map for Exoplanet HD 189733b.jpg",
        "credit": "NASA/JPL-Caltech/H. Knutson (Harvard-Smithsonian CfA)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Global_Temperature_Map_for_Exoplanet_HD_189733b.jpg"
      },
      "shots": [
        {
          "start": 21.5,
          "end": 24.633,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 24.633,
          "end": 27.767,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 27.753,
      "end": 32.598,
      "text": "The cobalt color is actually caused by high-altitude haze scattering light.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "ISS053-E-216793 - View of Earth.jpg",
        "credit": "Earth Science and Remote Sensing Unit, Lyndon B. Johnson Space Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:ISS053-E-216793_-_View_of_Earth.jpg"
      },
      "shots": [
        {
          "start": 27.767,
          "end": 32.6,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 32.598,
      "end": 38.318,
      "text": "Those clouds are composed of silicates, the exact mineral family of glass and sand.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist\u2019s impression of the deep blue planet HD 189733b (cropped).jpg",
        "credit": "NASA, ESA, M. Kornmesser",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%E2%80%99s_impression_of_the_deep_blue_planet_HD_189733b_(cropped).jpg"
      },
      "shots": [
        {
          "start": 32.6,
          "end": 38.333,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 38.318,
      "end": 43.988,
      "text": "Powerful jet streams blow these tiny silicate particles sideways across the planet.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Stellar flare hits HD 189733 b (artist's impression).jpg",
        "credit": "NASA, ESA, L. Cal\u00e7ada",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Stellar_flare_hits_HD_189733_b_(artist%27s_impression).jpg"
      },
      "shots": [
        {
          "start": 38.333,
          "end": 41.167,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 41.167,
          "end": 44.0,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 43.988,
      "end": 50.263,
      "text": "To make matters worse, the lethal atmosphere reeks like rotten eggs from hydrogen sulfide.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist's Concept of the James Webb Space Telescope (JWST) (2003-27-1413).jpg",
        "credit": "Northrop Grumman",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%27s_Concept_of_the_James_Webb_Space_Telescope_(JWST)_(2003-27-1413).jpg"
      },
      "shots": [
        {
          "start": 44.0,
          "end": 50.267,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 50.263,
      "end": 55.351,
      "text": "Nature disguised a terrifying storm of flying glass inside a serene blue marble.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist\u2019s impression of the deep blue planet HD 189733b.jpg",
        "credit": "NASA, ESA, M. Kornmesser",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%E2%80%99s_impression_of_the_deep_blue_planet_HD_189733b.jpg"
      },
      "shots": [
        {
          "start": 50.267,
          "end": 55.7,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
