  "duration": 55.501,
  "beats": [
    {
      "start": 0.08,
      "end": 4.838,
      "text": "This deep blue world sixty-four light-years away holds no peaceful oceans.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist\u2019s impression of the deep blue planet HD 189733b.jpg",
        "credit": "NASA, ESA, M. Kornmesser",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%E2%80%99s_impression_of_the_deep_blue_planet_HD_189733b.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.167,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 3.167,
          "end": 4.833,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.838,
      "end": 15.258,
      "text": "When French astronomers discovered HD 189733 b in October 2005, its azure shade seemed familiar.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 4.833,
          "end": 15.267,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.258,
      "end": 21.508,
      "text": "Most people imagine water, but this planet is a scorching gas giant larger than Jupiter.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "HD 189733 b comparison.png",
        "credit": "SevenSpheres",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:HD_189733_b_comparison.png"
      },
      "shots": [
        {
          "start": 15.267,
          "end": 18.167,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 18.167,
          "end": 21.5,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.508,
      "end": 27.553,
      "text": "Tidally locked to its parent star, atmospheric temperatures reach roughly twelve hundred Kelvin.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Global Temperature Map for Exoplanet HD 189733b.jpg",
        "credit": "NASA/JPL-Caltech/H. Knutson (Harvard-Smithsonian CfA)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Global_Temperature_Map_for_Exoplanet_HD_189733b.jpg"
      },
      "shots": [
        {
          "start": 21.5,
          "end": 24.533,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 24.533,
          "end": 27.567,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 27.553,
      "end": 32.398,
      "text": "The cobalt color is actually caused by high-altitude haze scattering light.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Top of Atmosphere.jpg",
        "credit": "NASA Earth Observatory",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Top_of_Atmosphere.jpg"
      },
      "shots": [
        {
          "start": 27.567,
          "end": 30.0,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 30.0,
          "end": 32.4,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 32.398,
      "end": 38.118,
      "text": "Those clouds are composed of silicates, the exact mineral family of glass and sand.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist\u2019s impression of the deep blue planet HD 189733b (cropped).jpg",
        "credit": "NASA, ESA, M. Kornmesser",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%E2%80%99s_impression_of_the_deep_blue_planet_HD_189733b_(cropped).jpg"
      },
      "shots": [
        {
          "start": 32.4,
          "end": 38.133,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 38.118,
      "end": 43.788,
      "text": "Powerful jet streams blow these tiny silicate particles sideways across the planet.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Exotic Atmospheres.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Exotic_Atmospheres.jpg"
      },
      "shots": [
        {
          "start": 38.133,
          "end": 40.967,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 40.967,
          "end": 43.8,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 43.788,
      "end": 50.063,
      "text": "To make matters worse, the lethal atmosphere reeks like rotten eggs from hydrogen sulfide.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist concept of JWST (50489833002 107cb9e661 o).jpg",
        "credit": "Adriana Manrique Gutierrez, NASA Animator",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist_concept_of_JWST_(50489833002_107cb9e661_o).jpg"
      },
      "shots": [
        {
          "start": 43.8,
          "end": 47.067,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 47.067,
          "end": 50.067,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 50.063,
      "end": 55.151,
      "text": "Nature disguised a terrifying storm of flying glass inside a serene blue marble.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist\u2019s impression of the deep blue planet HD 189733b.jpg",
        "credit": "NASA, ESA, M. Kornmesser",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%E2%80%99s_impression_of_the_deep_blue_planet_HD_189733b.jpg"
      },
      "shots": [
        {
          "start": 50.067,
          "end": 55.5,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
