{
  "id": "ep011",
  "duration": 45.952,
  "beats": [
    {
      "start": 0.15,
      "end": 4.479,
      "text": "A massive star is rocketing through space as a celestial fugitive.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Location of the binary system of Betelgeuse in constellation Orion.png",
        "credit": "Aaron McKinnon, E. Slawik/NOIRLab/NSF/AURA/M. Zamani",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Location_of_the_binary_system_of_Betelgeuse_in_constellation_Orion.png"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.833,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 2.833,
          "end": 4.467,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.479,
      "end": 10.074,
      "text": "Betelgeuse is a red supergiant star located in the constellation of Orion.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Betelgeuse captured by ALMA (potw1726a).tiff",
        "credit": "ALMA (ESO/NAOJ/NRAO)/E. O\u2019Gorman/P. Kervella",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Betelgeuse_captured_by_ALMA_(potw1726a).tiff"
      },
      "shots": [
        {
          "start": 4.467,
          "end": 6.733,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 6.733,
          "end": 10.067,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.074,
      "end": 16.744,
      "text": "If placed at the center of the solar system, it would engulf the orbits of Mercury, Venus, Earth, and Mars.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Betelgeuse Plume eso0927d.jpg",
        "credit": "ESO/L. Cal\u00e7ada",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Betelgeuse_Plume_eso0927d.jpg"
      },
      "shots": [
        {
          "start": 10.067,
          "end": 12.733,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 12.733,
          "end": 16.733,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.744,
      "end": 23.814,
      "text": "This ancient giant is a runaway star that was ejected from its birthplace near the stars in Orion's Belt.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Orion's Belt (eso1219d).jpg",
        "credit": "ESO",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Orion%27s_Belt_(eso1219d).jpg"
      },
      "shots": [
        {
          "start": 16.733,
          "end": 23.8,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.814,
      "end": 28.634,
      "text": "The star is moving through space at a speed of thirty kilometers per second.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 23.8,
          "end": 28.633,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 28.634,
      "end": 35.029,
      "text": "Its movement creates a massive bow shock where its stellar wind crashes into the interstellar medium.",
      "asset": {
        "source": "Flickr via Openverse",
        "title": "Red supergiant Betelgeuse (\u03b1 Orionis) and nearby structures",
        "credit": "gjdonatiello",
        "license": "CC0",
        "url": "https://www.flickr.com/photos/133259498@N05/54353336125"
      },
      "shots": [
        {
          "start": 28.633,
          "end": 35.033,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 35.029,
      "end": 40.854,
      "text": "This shockwave stretches roughly three to four light-years wide in front of the fleeing giant.",
      "asset": {
        "source": "Flickr via Openverse",
        "title": "Red supergiant Betelgeuse (\u03b1 Orionis) and nearby structures",
        "credit": "gjdonatiello",
        "license": "CC0",
        "url": "https://www.flickr.com/photos/133259498@N05/54353336125"
      },
      "shots": [
        {
          "start": 35.033,
          "end": 40.867,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 40.854,
      "end": 45.602,
      "text": "That is why a massive star is rocketing through space as a celestial fugitive.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Location of the binary system of Betelgeuse in constellation Orion.png",
        "credit": "Aaron McKinnon, E. Slawik/NOIRLab/NSF/AURA/M. Zamani",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Location_of_the_binary_system_of_Betelgeuse_in_constellation_Orion.png"
      },
      "shots": [
        {
          "start": 40.867,
          "end": 45.967,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
