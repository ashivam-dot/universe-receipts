          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 38.735,
      "end": 44.755,
      "text": "He logged 134 orbits and remains the oldest person ever to reach Earth orbit.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "KSC-98EC-1565.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:KSC-98EC-1565.jpg"
      },
      "shots": [
