  "beats": [
    {
      "start": 0.08,
      "end": 5.213,
      "text": "Most people thought NASA sent a seventy-seven-year-old into orbit for publicity.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "JohnGlenn.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:JohnGlenn.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.133,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 2.133,
          "end": 5.2,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 5.213,
      "end": 13.208,
      "text": "In 1998, thirty-six years after flying Friendship 7, sitting senator John Glenn boarded shuttle Discovery.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "STS-31 Discovery, OV-103, liftoff from KSC.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:STS-31_Discovery,_OV-103,_liftoff_from_KSC.jpg"
      },
      "shots": [
        {
          "start": 5.2,
          "end": 8.5,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 8.5,
          "end": 13.2,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.208,
      "end": 19.983,
      "text": "With President Bill Clinton watching the launch, drama struck at ignition when a drag chute door fell off.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "President Bill Clinton and First Lady Hillary Rodham Clinton stand with Eileen Collins.jpg",
        "credit": "White House Photograph Office",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:President_Bill_Clinton_and_First_Lady_Hillary_Rodham_Clinton_stand_with_Eileen_Collins.jpg"
      },
      "shots": [
        {
          "start": 13.2,
          "end": 19.967,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.983,
      "end": 26.403,
      "text": "Critics dismissed the mission as political hype, but Discovery carried over eighty science experiments.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "STS095-324-031 - STS-095 - BRIC - Mukai prepares to water seeds in Spacehab - DPLA - 0e4c39ed7133e65dbb11007be7602e1b.jpg",
        "credit": "National Aeronautics and Space Administration. Lyndon B. Johnson Space Center. 2/17/1973",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:STS095-324-031_-_STS-095_-_BRIC_-_Mukai_prepares_to_water_seeds_in_Spacehab_-_DPLA_-_0e4c39ed7133e65dbb11007be7602e1b.jpg"
      },
      "shots": [
        {
          "start": 19.967,
          "end": 22.367,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 22.367,
          "end": 26.4,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 26.403,
      "end": 32.623,
      "text": "Researchers specifically designed tests to study how spaceflight mimics the human aging process.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "John Glenn 1998 Shuttle.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:John_Glenn_1998_Shuttle.jpg"
      },
      "shots": [
        {
          "start": 26.4,
          "end": 30.3,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 30.3,
          "end": 32.633,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 32.623,
      "end": 39.348,
      "text": "Glenn served as a test subject, providing seventeen blood and forty-eight urine samples during flight.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "STS095-316-029 - STS-095 - BRIC - close-up of samples - DPLA - cc844594c9abd33d3f1b88cfef23c4d1.jpg",
        "credit": "National Aeronautics and Space Administration. Lyndon B. Johnson Space Center. 2/17/1973",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:STS095-316-029_-_STS-095_-_BRIC_-_close-up_of_samples_-_DPLA_-_cc844594c9abd33d3f1b88cfef23c4d1.jpg"
      },
      "shots": [
        {
          "start": 32.633,
          "end": 35.367,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 35.367,
          "end": 39.333,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 39.348,
      "end": 45.368,
      "text": "He logged 134 orbits and remains the oldest person ever to reach Earth orbit.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "KSC-98EC-1565.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:KSC-98EC-1565.jpg"
      },
      "shots": [
        {
          "start": 39.333,
          "end": 42.633,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 42.633,
          "end": 45.367,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 45.368,
      "end": 51.26,
      "text": "His flight delivered rigorous research on aging, even though skeptics still spread a very different story.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "JohnGlenn.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:JohnGlenn.jpg"
      },
      "shots": [
        {
          "start": 45.367,
          "end": 51.6,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    }
  ],
