{
  "id": "ep460",
  "duration": 30.193,
  "beats": [
    {
      "start": 0.08,
      "end": 2.94,
      "text": "The first human craft on Mars carried skis.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.933,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 2.94,
      "end": 6.42,
      "text": "Its tiny robotic rover was designed to waddle on a tether.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 2.933,
          "end": 6.433,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.42,
      "end": 10.9,
      "text": "Soviet probe Mars 2 arrived in 1971 during a planet-wide dust storm.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Nix Olympica Identified by Mariner 9 on Mars Approach (7651156590).jpg",
        "credit": "NASA on The Commons",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Nix_Olympica_Identified_by_Mariner_9_on_Mars_Approach_(7651156590).jpg"
      },
      "shots": [
        {
          "start": 6.433,
          "end": 10.9,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.9,
      "end": 15.38,
      "text": "The lander slammed into the Martian atmosphere at six kilometers per second.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Entry.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Entry.jpg"
      },
      "shots": [
        {
          "start": 10.9,
          "end": 13.3,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 13.3,
          "end": 15.367,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.38,
      "end": 19.2,
      "text": "Blinded by the raging dust, the descent sequence failed completely.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Entry.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Entry.jpg"
      },
      "shots": [
        {
          "start": 15.367,
          "end": 19.2,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.2,
      "end": 22.92,
      "text": "The craft smashed into the dirt, destroying the rover on impact.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hellas Planitia G19 025635 1396 XN 40S307W.png",
        "credit": "image:NASA/JPL-Caltech/UArizona - modified by Mariagat1959",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Hellas_Planitia_G19_025635_1396_XN_40S307W.png"
      },
      "shots": [
        {
          "start": 19.2,
          "end": 22.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.92,
      "end": 26.5,
      "text": "Yet that violent crash made it the first human object on Mars.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "State Coat of Arms of the USSR (1946-1956 version)..png",
        "credit": "Unknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:State_Coat_of_Arms_of_the_USSR_(1946-1956_version)..png"
      },
      "shots": [
        {
          "start": 22.933,
          "end": 26.5,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 26.5,
      "end": 29.843,
      "text": "Nothing made by human hands had ever reached Mars.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 26.5,
          "end": 30.2,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    }
  ],
