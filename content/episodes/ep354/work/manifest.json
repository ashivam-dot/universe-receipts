{
  "id": "ep354",
  "duration": 27.196,
  "beats": [
    {
      "start": 0.08,
      "end": 2.8,
      "text": "A space probe bounced off a comet like a ball.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Philae over a comet.jpg",
        "credit": "DLR, CC-BY 3.0",
        "license": "CC BY 3.0 de",
        "url": "https://commons.wikimedia.org/wiki/File:Philae_over_a_comet.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.8,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 2.8,
      "end": 6.08,
      "text": "The lander Philae tried to stick humanity's first-ever comet landing.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Rosetta and philae.jpg",
        "credit": "DLR, CC-BY 3.0",
        "license": "CC BY 3.0 de",
        "url": "https://commons.wikimedia.org/wiki/File:Rosetta_and_philae.jpg"
      },
      "shots": [
        {
          "start": 2.8,
          "end": 6.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.08,
      "end": 9.34,
      "text": "Both its anchoring harpoons and its downward thrusters failed.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Ein Modell von Philae - A model of Philae (14225938481).jpg",
        "credit": "DLR German Aerospace Center",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Ein_Modell_von_Philae_-_A_model_of_Philae_(14225938481).jpg"
      },
      "shots": [
        {
          "start": 6.067,
          "end": 9.333,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.34,
      "end": 12.8,
      "text": "Instead of grabbing the ice, the craft shot 1 kilometer high.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 9.333,
          "end": 12.8,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.8,
      "end": 16.18,
      "text": "It tumbled for two hours before hitting the comet a second time.",
      "asset": {
        "source": "Flickr via Openverse",
        "title": "67P/Churyumov-Gerasimenko - Rosetta",
        "credit": "jccwrt",
        "license": "CC BY 2.0",
        "url": "https://www.flickr.com/photos/132160802@N06/32755885495"
      },
      "shots": [
        {
          "start": 12.8,
          "end": 16.167,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.18,
      "end": 20.12,
      "text": "Philae finally wedged itself sideways inside a freezing cliff shadow.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA21565 - Rosetta's Moving Cometary Boulder.jpg",
        "credit": "ESA/Rosetta/MPS for OSIRIS Team MPS/UPD/LAM/IAA/SSO/INTA/UPM/DASP/IDA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA21565_-_Rosetta%27s_Moving_Cometary_Boulder.jpg"
      },
      "shots": [
        {
          "start": 16.167,
          "end": 20.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.12,
      "end": 23.48,
      "text": "Cut off from the sun, the probe worked for only 64 hours.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Rosetta's Philae on Comet 67P Churyumov-Gerasimenko.jpg",
        "credit": "DLR, CC-BY 3.0",
        "license": "CC BY 3.0 de",
        "url": "https://commons.wikimedia.org/wiki/File:Rosetta%27s_Philae_on_Comet_67P_Churyumov-Gerasimenko.jpg"
      },
      "shots": [
        {
          "start": 20.133,
          "end": 23.467,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.48,
      "end": 26.846,
      "text": "The billion-dollar robot was a lab that bounced like a ball.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Philae over a comet.jpg",
        "credit": "DLR, CC-BY 3.0",
        "license": "CC BY 3.0 de",
        "url": "https://commons.wikimedia.org/wiki/File:Philae_over_a_comet.jpg"
      },
      "shots": [
        {
          "start": 23.467,
          "end": 27.2,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
