{
  "id": "ep177",
  "duration": 57.048,
  "beats": [
    {
      "start": 0.08,
      "end": 4.296,
      "text": "The fastest object ever launched from Earth carried a postage stamp.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "New Horizons 1.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:New_Horizons_1.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.8,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 2.8,
          "end": 4.3,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.296,
      "end": 11.566,
      "text": "On January 19, 2006, NASA launched New Horizons directly into an escape trajectory.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Boeing Orbital Flight Test-2 Launch (NHQ202205190025).jpg",
        "credit": "Joel Kowsky",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Boeing_Orbital_Flight_Test-2_Launch_(NHQ202205190025).jpg"
      },
      "shots": [
        {
          "start": 4.3,
          "end": 11.567,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.566,
      "end": 18.162,
      "text": "It reached an Earth-relative speed of 16.26 kilometers per second, setting the launch record.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "New Horizons (from Launch Press Kit).jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:New_Horizons_(from_Launch_Press_Kit).jpg"
      },
      "shots": [
        {
          "start": 11.567,
          "end": 18.167,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.162,
      "end": 24.732,
      "text": "In 2007, a Jupiter gravity assist added roughly four kilometers per second of speed.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Iosurface.jpg",
        "credit": "NASA/Johns Hopkins University Applied Physics Laboratory/Southwest Research Institute",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Iosurface.jpg"
      },
      "shots": [
        {
          "start": 18.167,
          "end": 20.6,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 20.6,
          "end": 24.733,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.732,
      "end": 31.777,
      "text": "Astronomers used the ALMA radio telescope array in Chile to precisely measure Pluto's orbit.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Nineteen ALMA antennas on the Chajnantor plateau (eso1137g).tiff",
        "credit": "ALMA (ESO/NAOJ/NRAO)/W. Garnier (ALMA)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Nineteen_ALMA_antennas_on_the_Chajnantor_plateau_(eso1137g).tiff"
      },
      "shots": [
        {
          "start": 24.733,
          "end": 27.967,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 27.967,
          "end": 31.767,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 31.777,
      "end": 38.646,
      "text": "On July 14, 2015, New Horizons became the first spacecraft to study Pluto up close.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Pluto in True Color - High-Res.jpg",
        "credit": "NASA/Johns Hopkins University Applied Physics Laboratory/Southwest Research Institute/Alex Parker",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Pluto_in_True_Color_-_High-Res.jpg"
      },
      "shots": [
        {
          "start": 31.767,
          "end": 35.2,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 35.2,
          "end": 38.633,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 38.646,
      "end": 45.066,
      "text": "The probe flew past at over 52,000 miles per hour carrying nine cultural mementos.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hydra, Charon and Pluto (19540320858).jpg",
        "credit": "Camille G\u00e9vaudan from Paris, France",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Hydra,_Charon_and_Pluto_(19540320858).jpg"
      },
      "shots": [
        {
          "start": 38.633,
          "end": 45.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 45.066,
      "end": 51.166,
      "text": "Among them was a 1991 postage stamp printed with 'Pluto: Not Yet Explored.'",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 45.067,
          "end": 51.167,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 51.166,
      "end": 56.698,
      "text": "After roughly 9.5 years, that probe finally delivered the stamp to its destination.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "New Horizons 1.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:New_Horizons_1.jpg"
      },
      "shots": [
        {
          "start": 51.167,
          "end": 57.033,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
