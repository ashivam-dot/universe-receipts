{
  "id": "ep215",
  "duration": 46.007,
  "beats": [
    {
      "start": 0.08,
      "end": 3.67,
      "text": "Earth's shadow does not cause the changing phases of the Moon.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "LRO WAC Nearside Mosaic.jpg",
        "credit": "NASA/GSFC/Arizona State University",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:LRO_WAC_Nearside_Mosaic.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.667,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.67,
      "end": 11.34,
      "text": "For centuries, a persistent historical myth erroneously blamed our planet for blocking the Sun entirely from our view.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Total Lunar Eclipse & Blood Moon 2025 (GRC-2025-C-01613).jpg",
        "credit": "NASA Glenn Research Center / NASA/Jordan Cochran",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Total_Lunar_Eclipse_%26_Blood_Moon_2025_(GRC-2025-C-01613).jpg"
      },
      "shots": [
        {
          "start": 3.667,
          "end": 8.633,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 8.633,
          "end": 11.333,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.34,
      "end": 18.91,
      "text": "In physical reality, the Sun continuously illuminates exactly half of the lunar globe at all times without fail.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The Sun by the Atmospheric Imaging Assembly of NASA's Solar Dynamics Observatory - 20100819.jpg",
        "credit": "NASA/SDO (AIA)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:The_Sun_by_the_Atmospheric_Imaging_Assembly_of_NASA%27s_Solar_Dynamics_Observatory_-_20100819.jpg"
      },
      "shots": [
        {
          "start": 11.333,
          "end": 14.467,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 14.467,
          "end": 18.9,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.91,
      "end": 26.655,
      "text": "As the Moon travels along its orbital path around our world, our observing viewpoint shifts constantly every single night.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Waxing crescent (5836481331).jpg",
        "credit": "NASA Goddard Space Flight Center from Greenbelt, MD, USA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Waxing_crescent_(5836481331).jpg"
      },
      "shots": [
        {
          "start": 18.9,
          "end": 23.3,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 23.3,
          "end": 26.667,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 26.655,
      "end": 34.13,
      "text": "This changing perspective creates everything from a delicate crescent phase to a brilliant full moon high overhead.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "First Quarter (15982765351).jpg",
        "credit": "NASA Goddard Space Flight Center from Greenbelt, MD, USA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:First_Quarter_(15982765351).jpg"
      },
      "shots": [
        {
          "start": 26.667,
          "end": 34.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 34.13,
      "end": 42.875,
      "text": "Earth's actual physical shadow only touches the lunar surface during rare lunar eclipses occurring roughly twice per calendar year.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 34.133,
          "end": 42.867,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 42.875,
      "end": 45.657,
      "text": "Earth's shadow never causes the phases.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "LRO WAC Nearside Mosaic.jpg",
        "credit": "NASA/GSFC/Arizona State University",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:LRO_WAC_Nearside_Mosaic.jpg"
      },
      "shots": [
        {
          "start": 42.867,
          "end": 46.0,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
