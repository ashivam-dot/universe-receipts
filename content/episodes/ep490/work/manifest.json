{
  "id": "ep490",
  "duration": 28.827,
  "beats": [
    {
      "start": 0.08,
      "end": 2.82,
      "text": "The Sun is the most perfect sphere in nature.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "2017 Total Solar Eclipse (35909952653).jpg",
        "credit": "Aubrey Gemignani",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:2017_Total_Solar_Eclipse_(35909952653).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 1.233,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 1.233,
          "end": 2.833,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 2.82,
      "end": 6.24,
      "text": "Even violent eleven-year magnetic storms cannot bulge its disk.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Looping Hot (6192052215).jpg",
        "credit": "NASA Goddard Space Flight Center from Greenbelt, MD, USA",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Looping_Hot_(6192052215).jpg"
      },
      "shots": [
        {
          "start": 2.833,
          "end": 6.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.24,
      "end": 9.74,
      "text": "NASA's Solar Dynamics Observatory measured this roundness from space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Solar Dynamics Observatory -Artist's Concept- (3797161573).jpg",
        "credit": "NASA Goddard Photo and Video",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Solar_Dynamics_Observatory_-Artist%27s_Concept-_(3797161573).jpg"
      },
      "shots": [
        {
          "start": 6.233,
          "end": 9.733,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.74,
      "end": 12.66,
      "text": "Deep inside, fusion converts hydrogen into helium.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "BBSO full-disk H-alpha 2002-07-26 153931 color.png",
        "credit": "BBSO/NJIT",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:BBSO_full-disk_H-alpha_2002-07-26_153931_color.png"
      },
      "shots": [
        {
          "start": 9.733,
          "end": 12.667,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.66,
      "end": 15.64,
      "text": "The proton-proton chain generates ninety-nine percent of that power.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Proton\u2013proton chain reaction.png",
        "credit": "Nagendra Nath Mondal",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Proton%E2%80%93proton_chain_reaction.png"
      },
      "shots": [
        {
          "start": 12.667,
          "end": 15.633,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.64,
      "end": 17.7,
      "text": "The CNO cycle adds around one percent more.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "CNO (corrected).png",
        "credit": "Ariel Provost",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:CNO_(corrected).png"
      },
      "shots": [
        {
          "start": 15.633,
          "end": 17.7,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.7,
      "end": 20.36,
      "text": "This energy drives a magnetized solar wind.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Solar maximum coronal streamers from SOHO LASCO C2.jpg",
        "credit": "SOHO (ESA & NASA)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Solar_maximum_coronal_streamers_from_SOHO_LASCO_C2.jpg"
      },
      "shots": [
        {
          "start": 17.7,
          "end": 20.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.36,
      "end": 23.26,
      "text": "That wind inflates a giant shield called the heliosphere.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Ibexheliosphererevised.jpg",
        "credit": "Credits: NASA/IBEX/Adler Planetarium",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Ibexheliosphererevised.jpg"
      },
      "shots": [
        {
          "start": 20.367,
          "end": 23.267,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.26,
      "end": 25.42,
      "text": "Voyager 1 crossed it into interstellar space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyager 1's view of Solar System (artist's impression).jpg",
        "credit": "NASA, ESA, and G. Bacon (STScI)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Voyager_1%27s_view_of_Solar_System_(artist%27s_impression).jpg"
      },
      "shots": [
        {
          "start": 23.267,
          "end": 25.433,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.42,
      "end": 28.477,
      "text": "Yet across all scales, the Sun remains a perfect sphere.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "2017 Total Solar Eclipse (35909952653).jpg",
        "credit": "Aubrey Gemignani",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:2017_Total_Solar_Eclipse_(35909952653).jpg"
      },
      "shots": [
        {
          "start": 25.433,
          "end": 28.833,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
