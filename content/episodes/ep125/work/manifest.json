{
  "id": "ep125",
  "duration": 52.675,
  "beats": [
    {
      "start": 0.08,
      "end": 5.025,
      "text": "Engineers designed a spaceship propelled by one nuclear bomb every second.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NASA-project-orion-artist.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:NASA-project-orion-artist.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.767,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 2.767,
          "end": 5.033,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 5.025,
      "end": 12.07,
      "text": "In 1958, physicists Ted Taylor and Freeman Dyson led Project Orion at General Atomics.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Freeman Dyson at Harvard.jpg",
        "credit": "Lumidek at English Wikipedia",
        "license": "CC BY 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:Freeman_Dyson_at_Harvard.jpg"
      },
      "shots": [
        {
          "start": 5.033,
          "end": 12.067,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.07,
      "end": 19.04,
      "text": "Their analyzed design delivered an estimated specific impulse of approximately 2,000 seconds.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "ProjectOrionConfiguration.png",
        "credit": "Uploaded by Georgewilliamherbert 10:59, 10 January 2007 (UTC)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:ProjectOrionConfiguration.png"
      },
      "shots": [
        {
          "start": 12.067,
          "end": 19.033,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.04,
      "end": 25.06,
      "text": "Shaped nuclear charges blasted hot plasma directly against a heavy steel pusher plate.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Project-Orion propulsion-module section.png",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Project-Orion_propulsion-module_section.png"
      },
      "shots": [
        {
          "start": 19.033,
          "end": 25.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.06,
      "end": 31.905,
      "text": "Giant shock absorbers reduced extreme blast accelerations to just a few g's for the crew compartment.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Project Orion Model.jpg",
        "credit": "Air Force Research Laboratory",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Project_Orion_Model.jpg"
      },
      "shots": [
        {
          "start": 25.067,
          "end": 31.9,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 31.905,
      "end": 38.3,
      "text": "To keep atomic fireballs from vaporizing the plate, researchers discovered an unexpected fix.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Ivy Mike (Eniwetok-Atoll - 31. Oktober 1952).jpg",
        "credit": "Unknown authorUnknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Ivy_Mike_(Eniwetok-Atoll_-_31._Oktober_1952).jpg"
      },
      "shots": [
        {
          "start": 31.9,
          "end": 35.1,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 35.1,
          "end": 38.3,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 38.3,
      "end": 44.475,
      "text": "Spraying a thin film of oil between detonations prevented surface ablation entirely.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 38.3,
          "end": 44.467,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 44.475,
      "end": 52.325,
      "text": "The 1963 Test Ban Treaty canceled the program in 1964, ending the dream before a single launch.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NASA-project-orion-artist.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:NASA-project-orion-artist.jpg"
      },
      "shots": [
        {
          "start": 44.467,
          "end": 52.667,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
