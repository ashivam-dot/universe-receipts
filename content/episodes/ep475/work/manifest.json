{
  "id": "ep475",
  "duration": 31.488,
  "beats": [
    {
      "start": 0.08,
      "end": 4.54,
      "text": "NASA fired backup thrusters on a probe in interstellar space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyager 1's view of Solar System (artist's impression).jpg",
        "credit": "NASA, ESA, and G. Bacon (STScI)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Voyager_1%27s_view_of_Solar_System_(artist%27s_impression).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.967,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 2.967,
          "end": 4.533,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.54,
      "end": 8.28,
      "text": "These backup engines had stayed completely silent since 1980.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 4.533,
          "end": 8.267,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.28,
      "end": 12.02,
      "text": "Voyager 1 was drifting over 11 billion miles from home.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA17046 - Voyager 1 Goes Interstellar.jpg",
        "credit": "NASA / JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA17046_-_Voyager_1_Goes_Interstellar.jpg"
      },
      "shots": [
        {
          "start": 8.267,
          "end": 12.033,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.02,
      "end": 14.7,
      "text": "These components stayed cold and unused in the void.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA17036 Voyager the Explorer.jpg",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA17036_Voyager_the_Explorer.jpg"
      },
      "shots": [
        {
          "start": 12.033,
          "end": 14.7,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.7,
      "end": 17.44,
      "text": "Its primary steering jets were finally starting to fail.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyager diagram.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Voyager_diagram.jpg"
      },
      "shots": [
        {
          "start": 14.7,
          "end": 17.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.44,
      "end": 21.24,
      "text": "Engineers sent a signal during late 2017 to wake the backups.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mission control on flight day 14.jpg",
        "credit": "Robert Markowitz",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Mission_control_on_flight_day_14.jpg"
      },
      "shots": [
        {
          "start": 17.433,
          "end": 21.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.24,
      "end": 25.06,
      "text": "Those 37-year-old thrusters fired perfectly on the first try.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Stone Voyager 4c.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Stone_Voyager_4c.jpg"
      },
      "shots": [
        {
          "start": 21.233,
          "end": 25.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.06,
      "end": 27.66,
      "text": "The ancient probe can now keep calling home for years.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The Sounds of Earth Record Cover - GPN-2000-001978.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:The_Sounds_of_Earth_Record_Cover_-_GPN-2000-001978.jpg"
      },
      "shots": [
        {
          "start": 25.067,
          "end": 27.667,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 27.66,
      "end": 31.138,
      "text": "We still depend on backup thrusters in interstellar space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyager 1's view of Solar System (artist's impression).jpg",
        "credit": "NASA, ESA, and G. Bacon (STScI)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Voyager_1%27s_view_of_Solar_System_(artist%27s_impression).jpg"
      },
      "shots": [
        {
          "start": 27.667,
          "end": 31.5,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
