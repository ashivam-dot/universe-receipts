{
  "id": "ep421",
  "duration": 33.42,
  "beats": [
    {
      "start": 0.08,
      "end": 3.12,
      "text": "NASA threw Voyager 1 out of our solar system.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NASA\u2019s Voyager Probe Speeds Through Space (Artist\u2019s Concept) (PIA26353).tiff",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:NASA%E2%80%99s_Voyager_Probe_Speeds_Through_Space_(Artist%E2%80%99s_Concept)_(PIA26353).tiff"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.12,
      "end": 5.46,
      "text": "Most think the probe just drifted away by accident.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyager trajectories.jpg",
        "credit": "Stauriko",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Voyager_trajectories.jpg"
      },
      "shots": [
        {
          "start": 3.133,
          "end": 5.467,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 5.46,
      "end": 7.94,
      "text": "Engineers launched it from Florida on a Titan rocket.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Titan 3E with Voyager 1.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Titan_3E_with_Voyager_1.jpg"
      },
      "shots": [
        {
          "start": 5.467,
          "end": 7.933,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.94,
      "end": 10.64,
      "text": "Built by JPL, the craft reached Jupiter first.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyager 1 - Jupiter Mosaic - 1979-03-11 (19069026659).png",
        "credit": "Justin Cowart",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Voyager_1_-_Jupiter_Mosaic_-_1979-03-11_(19069026659).png"
      },
      "shots": [
        {
          "start": 7.933,
          "end": 10.633,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.64,
      "end": 14.6,
      "text": "The craft swept within 124,000 kilometers of Saturn's clouds.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Saturn's ring system - Voyager 1.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Saturn%27s_ring_system_-_Voyager_1.jpg"
      },
      "shots": [
        {
          "start": 10.633,
          "end": 14.6,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.6,
      "end": 17.76,
      "text": "Planners then deliberately targeted Titan, Saturn's largest moon.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Titan in true color by Kevin M. Gill.jpg",
        "credit": "NASA/JPL-Caltech/SSI/Kevin M. Gill",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Titan_in_true_color_by_Kevin_M._Gill.jpg"
      },
      "shots": [
        {
          "start": 14.6,
          "end": 17.767,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.76,
      "end": 20.9,
      "text": "They prioritized studying its dense, nitrogen-rich atmosphere.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Simultaneous views of Titan's surface and atmosphere (eso0412c).tiff",
        "credit": "ESO",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Simultaneous_views_of_Titan%27s_surface_and_atmosphere_(eso0412c).tiff"
      },
      "shots": [
        {
          "start": 17.767,
          "end": 20.9,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.9,
      "end": 26.22,
      "text": "Sacrificing further planet flybys, Titan's gravity hurled Voyager permanently out of the solar system.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 20.9,
          "end": 26.233,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 26.22,
      "end": 28.98,
      "text": "The slingshot bent its path right off the planetary plane.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Interstellar probes (cropped).jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Interstellar_probes_(cropped).jpg"
      },
      "shots": [
        {
          "start": 26.233,
          "end": 28.967,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 28.98,
      "end": 33.07,
      "text": "NASA's plan actually threw Voyager 1 out of our solar system.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NASA\u2019s Voyager Probe Speeds Through Space (Artist\u2019s Concept) (PIA26353).tiff",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:NASA%E2%80%99s_Voyager_Probe_Speeds_Through_Space_(Artist%E2%80%99s_Concept)_(PIA26353).tiff"
      },
      "shots": [
        {
          "start": 28.967,
          "end": 33.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
