  "beats": [
    {
      "start": 0.08,
      "end": 4.16,
      "text": "NASA etched 'water' in 103 languages on a spacecraft.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Europa-clipper-phone-backgrounds-01.png",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
