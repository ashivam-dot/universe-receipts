      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.167,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.16,
      "end": 6.5,
      "text": "Those sounds live on a small metal plate inside.",
      "asset": {
        "source": "Flickr via Openverse",
        "title": "20241013SM254",
        "credit": "Library of Congress Life",
        "license": "CC0",
        "url": "https://www.flickr.com/photos/162991176@N03/54069876298"
      },
      "shots": [
        {
          "start": 4.167,
          "end": 6.5,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.5,
      "end": 9.52,
      "text": "A poem by poet laureate Ada Lim\u00f3n shares the space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Ada Lim\u00f3n (2022) (cropped).jpg",
        "credit": "Library of Congress Life",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Ada_Lim%C3%B3n_(2022)_(cropped).jpg"
      },
      "shots": [
        {
          "start": 6.5,
          "end": 9.533,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.52,
      "end": 12.72,
      "text": "Over 2.6 million names ride on a microchip too.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 9.533,
          "end": 12.733,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.72,
      "end": 15.22,
      "text": "The whole ship is NASA's largest ever built.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Europa Clipper.jpg",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Europa_Clipper.jpg"
      },
      "shots": [
        {
          "start": 12.733,
          "end": 15.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.22,
      "end": 18.14,
      "text": "Nine instruments can sniff a single bacterium in ice.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Dust Analyzer in the Clean Room.jpg",
        "credit": "NASA/LASP-CU Boulder",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Dust_Analyzer_in_the_Clean_Room.jpg"
      },
      "shots": [
        {
          "start": 15.233,
          "end": 18.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.14,
      "end": 21.2,
      "text": "49 flybys of Europa arrive in April 2030.",
      "asset": {
        "source": "Wikimedia Commons",
