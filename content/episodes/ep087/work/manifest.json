    {
      "start": 4.475,
      "end": 13.37,
      "text": "On January 1, 1801, astronomer Giuseppe Piazzi discovered the first fragment, Ceres, while hunting for a missing planet.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Costanzo Angelini, L'astronomo Piazzi 1825 ca.jpg",
        "credit": "Costanzo Angelini",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Costanzo_Angelini,_L%27astronomo_Piazzi_1825_ca.jpg"
      },
      "shots": [
        {
          "start": 4.467,
          "end": 13.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.37,
      "end": 19.24,
      "text": "An informal group called the Celestial Police formed to search for this predicted missing world.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The elements of astronomy; a textbook (1919) (14595597958).jpg",
        "credit": "Internet Archive Book Images",
        "license": "No restrictions",
        "url": "https://commons.wikimedia.org/wiki/File:The_elements_of_astronomy;_a_textbook_(1919)_(14595597958).jpg"
      },
      "shots": [
        {
          "start": 13.367,
          "end": 15.7,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 15.7,
          "end": 19.233,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.24,
      "end": 27.385,
      "text": "Instead of a single planet, they found a vast graveyard of planetesimals prevented from merging by Jupiter's massive gravity.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Solar System graphic by NASA.png",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Solar_System_graphic_by_NASA.png"
      },
      "shots": [
        {
          "start": 19.233,
          "end": 27.4,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 27.385,
      "end": 35.685,
      "text": "The average distance between these space rocks is about 600,000 miles, making the belt an extreme cosmic desert.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist\u2019s view of bright spots on Ceres imaged by the Dawn spacecraft.jpg",
        "credit": "ESO/L.Cal\u00e7ada/NASA/JPL-Caltech/UCLA/MPS/DLR/IDA/Steve Albers/N. Risinger (skysurvey.org)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%E2%80%99s_view_of_bright_spots_on_Ceres_imaged_by_the_Dawn_spacecraft.jpg"
      },
      "shots": [
        {
          "start": 27.4,
          "end": 30.6,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 30.6,
          "end": 35.7,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 35.685,
      "end": 42.63,
      "text": "Spacecraft safely cruise through because the probability of hitting an asteroid is less than one in a billion.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Pioneer 10-11 spacecraft.jpg",
        "credit": "Don Davis for NASA",
        "license": "Public domain",
