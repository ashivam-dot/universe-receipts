  "beats": [
    {
      "start": 0.08,
      "end": 2.6,
      "text": "A new star once cast shadows across the Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Tycho's Supernova Remnant- Exploding Stars and Stripes (2011-tycho - tycho 1680).jpg",
        "credit": "X-ray: NASA/CXC/Rutgers/K.Eriksen et al.; Optical: DSS",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Tycho%27s_Supernova_Remnant-_Exploding_Stars_and_Stripes_(2011-tycho_-_tycho_1680).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.6,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 2.6,
      "end": 5.1,
      "text": "It appeared in the sky brighter than the planet Venus.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mercury, Venus and the Moon Align.jpg",
        "credit": "ESO/Y. Beletsky",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Mercury,_Venus_and_the_Moon_Align.jpg"
      },
      "shots": [
        {
          "start": 2.6,
          "end": 5.1,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 5.1,
      "end": 8.82,
      "text": "This celestial fire was so intense people saw it during midday.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Illustration Explaining the Arc in Tycho (2011-tycho2-more-1 - labeled).jpg",
        "credit": "(Credit: NASA/CXC/M.Weiss)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Illustration_Explaining_the_Arc_in_Tycho_(2011-tycho2-more-1_-_labeled).jpg"
      },
      "shots": [
        {
          "start": 5.1,
          "end": 8.833,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.82,
      "end": 12.04,
      "text": "Astronomer Tycho Brahe proved it sat far beyond our Moon.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Portr\u00e4tt av Tycho Brahe - Skoklosters slott - 90153.tif",
        "credit": "Unknown authorUnknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Portr%C3%A4tt_av_Tycho_Brahe_-_Skoklosters_slott_-_90153.tif"
      },
      "shots": [
        {
          "start": 8.833,
          "end": 10.8,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 10.8,
          "end": 12.033,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.04,
      "end": 15.06,
      "text": "That discovery shattered the myth that the heavens never change.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Tycho Cas SN1572.jpg",
        "credit": "Tycho Brahe",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Tycho_Cas_SN1572.jpg"
      },
      "shots": [
        {
          "start": 12.033,
          "end": 13.933,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 13.933,
          "end": 15.067,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.06,
      "end": 18.58,
      "text": "Space dust reflected its original light back to us in 2008.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 15.067,
          "end": 18.567,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.58,
      "end": 22.4,
      "text": "This light echo proved a white dwarf star had completely exploded.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Tycho's Supernova Remnant- A New View of Tycho's Supernova Remnant (2009-tycho - tycho 1280).jpg",
        "credit": "X-ray: NASA/CXC/SAO, Infrared: NASA/JPL-Caltech; Optical: MPIA, Calar Alto, O.Krause et al.",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Tycho%27s_Supernova_Remnant-_A_New_View_of_Tycho%27s_Supernova_Remnant_(2009-tycho_-_tycho_1280).jpg"
      },
      "shots": [
        {
          "start": 18.567,
          "end": 22.4,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.4,
      "end": 25.8,
      "text": "A young William Shakespeare likely watched the blast according to research.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Shakespeare Droeshout 1623 From the First Folio Edition.jpg",
        "credit": "Martin Droeshout",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Shakespeare_Droeshout_1623_From_the_First_Folio_Edition.jpg"
      },
      "shots": [
        {
          "start": 22.4,
          "end": 24.1,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 24.1,
          "end": 25.8,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.8,
      "end": 29.383,
      "text": "It remains the ghost star that cast shadows across the Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Tycho's Supernova Remnant- Exploding Stars and Stripes (2011-tycho - tycho 1680).jpg",
