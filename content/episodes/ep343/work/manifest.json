  "duration": 31.782,
  "beats": [
    {
      "start": 0.08,
      "end": 3.24,
      "text": "A new star once cast shadows across the Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Tycho's Supernova Remnant- Exploding Stars and Stripes (2011-tycho - tycho 1680).jpg",
        "credit": "X-ray: NASA/CXC/Rutgers/K.Eriksen et al.; Optical: DSS",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Tycho%27s_Supernova_Remnant-_Exploding_Stars_and_Stripes_(2011-tycho_-_tycho_1680).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.24,
      "end": 5.72,
      "text": "It appeared in the sky brighter than the planet Venus.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mercury, Venus and the Moon Align.jpg",
        "credit": "ESO/Y. Beletsky",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Mercury,_Venus_and_the_Moon_Align.jpg"
      },
      "shots": [
        {
          "start": 3.233,
          "end": 5.733,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 5.72,
      "end": 10.08,
      "text": "This celestial fire was so intense people saw it during midday.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Tycho-supernova-xray.jpg",
        "credit": "NASA/CXC/Rutgers/J.Warren & J.Hughes et al.",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Tycho-supernova-xray.jpg"
      },
      "shots": [
        {
          "start": 5.733,
          "end": 10.067,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.08,
      "end": 13.08,
      "text": "Astronomer Tycho Brahe proved it sat far beyond our Moon.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Portr\u00e4tt av Tycho Brahe - Skoklosters slott - 90153.tif",
        "credit": "Unknown authorUnknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Portr%C3%A4tt_av_Tycho_Brahe_-_Skoklosters_slott_-_90153.tif"
      },
      "shots": [
        {
          "start": 10.067,
          "end": 11.933,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 11.933,
          "end": 13.067,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.08,
      "end": 16.34,
      "text": "That discovery shattered the myth that the heavens never change.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Tycho Cas SN1572.jpg",
        "credit": "Tycho Brahe",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Tycho_Cas_SN1572.jpg"
      },
      "shots": [
        {
          "start": 13.067,
          "end": 14.867,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 14.867,
          "end": 16.333,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.34,
      "end": 19.94,
      "text": "Space dust reflected its original light back to us in 2008.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 16.333,
          "end": 19.933,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.94,
      "end": 24.4,
      "text": "This light echo proved a white dwarf\u2014a dead star's core\u2014had exploded.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Tycho's Supernova Remnant- A New View of Tycho's Supernova Remnant (2009-tycho - tycho 1680).jpg",
        "credit": "X-ray: NASA/CXC/SAO, Infrared: NASA/JPL-Caltech; Optical: MPIA, Calar Alto, O.Krause et al.",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Tycho%27s_Supernova_Remnant-_A_New_View_of_Tycho%27s_Supernova_Remnant_(2009-tycho_-_tycho_1680).jpg"
      },
      "shots": [
        {
          "start": 19.933,
          "end": 22.167,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 22.167,
          "end": 24.4,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.4,
      "end": 28.1,
      "text": "Research suggests the blast inspired a young William Shakespeare.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Shakespeare Droeshout 1623 From the First Folio Edition.jpg",
        "credit": "Martin Droeshout",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Shakespeare_Droeshout_1623_From_the_First_Folio_Edition.jpg"
      },
      "shots": [
        {
          "start": 24.4,
          "end": 26.767,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 26.767,
          "end": 28.1,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 28.1,
      "end": 31.432,
      "text": "He saw the same ghost star that cast shadows across the Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Tycho's Supernova Remnant- Exploding Stars and Stripes (2011-tycho - tycho 1680).jpg",
