  "beats": [
    {
      "start": 0.08,
      "end": 3.46,
      "text": "A new star once cast shadows across the Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "X-ray Images of Tycho's Supernova Remnant (2011-tycho2-more-3 - label).tiff",
        "credit": "(Credit: NASA/CXC/Chinese Academy of Sciences/F. Lu et al)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:X-ray_Images_of_Tycho%27s_Supernova_Remnant_(2011-tycho2-more-3_-_label).tiff"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.467,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.46,
      "end": 6.0,
      "text": "It appeared in the sky brighter than the planet Venus.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mercury, Venus and the Moon Align.jpg",
        "credit": "ESO/Y. Beletsky",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Mercury,_Venus_and_the_Moon_Align.jpg"
      },
      "shots": [
        {
          "start": 3.467,
          "end": 6.0,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.0,
      "end": 10.1,
      "text": "This celestial fire was so intense people saw it during midday.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Tycho-supernova-xray.jpg",
        "credit": "NASA/CXC/Rutgers/J.Warren & J.Hughes et al.",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Tycho-supernova-xray.jpg"
      },
      "shots": [
        {
          "start": 6.0,
          "end": 10.1,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.1,
      "end": 13.44,
      "text": "Astronomer Tycho Brahe proved it sat far beyond our Moon.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Portr\u00e4tt av Tycho Brahe - Skoklosters slott - 90153.tif",
        "credit": "Unknown authorUnknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Portr%C3%A4tt_av_Tycho_Brahe_-_Skoklosters_slott_-_90153.tif"
      },
      "shots": [
        {
          "start": 10.1,
          "end": 12.033,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 12.033,
          "end": 13.433,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.44,
      "end": 16.64,
      "text": "That discovery shattered the myth that the heavens never change.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Tycho Cas SN1572.jpg",
        "credit": "Tycho Brahe",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Tycho_Cas_SN1572.jpg"
      },
      "shots": [
        {
          "start": 13.433,
          "end": 15.4,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 15.4,
          "end": 16.633,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.64,
      "end": 20.14,
      "text": "Space dust reflected its original light back to us in 2008.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 16.633,
          "end": 20.133,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.14,
      "end": 24.48,
      "text": "This light echo proved a white dwarf\u2014a dead star's core\u2014had exploded.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Tycho's Supernova Remnant- A New View of Tycho's Supernova Remnant (2009-tycho - tycho 1280).jpg",
        "credit": "X-ray: NASA/CXC/SAO, Infrared: NASA/JPL-Caltech; Optical: MPIA, Calar Alto, O.Krause et al.",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Tycho%27s_Supernova_Remnant-_A_New_View_of_Tycho%27s_Supernova_Remnant_(2009-tycho_-_tycho_1280).jpg"
      },
      "shots": [
        {
          "start": 20.133,
          "end": 24.467,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.48,
      "end": 27.9,
      "text": "Research suggests the blast inspired a young William Shakespeare.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Shakespeare Droeshout 1623.jpg",
        "credit": "Martin Droeshout",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Shakespeare_Droeshout_1623.jpg"
      },
      "shots": [
        {
          "start": 24.467,
          "end": 27.9,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 27.9,
      "end": 31.854,
      "text": "He saw the same ghost star that cast shadows across the Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "X-ray Images of Tycho's Supernova Remnant (2011-tycho2-more-3 - label).tiff",
