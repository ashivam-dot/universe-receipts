{
  "id": "ep388",
  "duration": 35.014,
  "beats": [
    {
      "start": 0.08,
      "end": 4.18,
      "text": "A moon of Saturn zaps passing spacecraft with static electricity.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hyperion false color.jpg",
        "credit": "The original uploader was Tablizer at English Wikipedia.\n\nLater versions were uploaded by Clh288 at en.wikipedia.",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Hyperion_false_color.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.167,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.18,
      "end": 6.56,
      "text": "Most moons are just solid spheres of ice.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Four Saturnian moons PIA07644.png",
        "credit": "Unknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Four_Saturnian_moons_PIA07644.png"
      },
      "shots": [
        {
          "start": 4.167,
          "end": 6.567,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.56,
      "end": 10.74,
      "text": "Saturn's moon Hyperion is a sponge, half as dense as water.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hyperion (captured by Cassini).tif",
        "credit": "NASA/JPL/Space Science Institute",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Hyperion_(captured_by_Cassini).tif"
      },
      "shots": [
        {
          "start": 6.567,
          "end": 10.733,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.74,
      "end": 13.6,
      "text": "Over 40 percent of its interior is totally empty space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hyperion - May 31 2015 (37908801791).png",
        "credit": "Kevin Gill from Los Angeles, CA, United States",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Hyperion_-_May_31_2015_(37908801791).png"
      },
      "shots": [
        {
          "start": 10.733,
          "end": 13.6,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.6,
      "end": 17.76,
      "text": "When meteorites hit, they punch inward, crushing the icy foam.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hyperion surface.jpg",
        "credit": "NASA/JPL/Space Science Institute",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Hyperion_surface.jpg"
      },
      "shots": [
        {
          "start": 13.6,
          "end": 17.767,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.76,
      "end": 21.88,
      "text": "Gravitational tugs from Titan make Hyperion tumble through space uncontrollably.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Saturnmoonsdiagram.png",
        "credit": "Exoplanetaryscience",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Saturnmoonsdiagram.png"
      },
      "shots": [
        {
          "start": 17.767,
          "end": 20.033,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 20.033,
          "end": 21.867,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.88,
      "end": 25.92,
      "text": "As it tumbles, Hyperion builds up a negative 200-volt charge.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 21.867,
          "end": 25.933,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.92,
      "end": 30.48,
      "text": "When NASA's Cassini probe flew past, Hyperion fired a beam of electrons.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Cassini Saturn Orbit Insertion.tif",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Cassini_Saturn_Orbit_Insertion.tif"
      },
      "shots": [
        {
          "start": 25.933,
          "end": 28.2,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 28.2,
          "end": 30.467,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 30.48,
      "end": 34.664,
      "text": "It proves a moon of Saturn zaps passing spacecraft with static electricity.",
