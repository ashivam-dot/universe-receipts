        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Stephan%27s_Quintet_(NIRCam_and_MIRI_Composite_Compass_Image)_(2022-034-01G7DBYV6PTE37PEB5TZ19TMV2).tiff"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.867,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 2.867,
