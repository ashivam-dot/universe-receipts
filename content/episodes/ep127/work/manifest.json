          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.399,
      "end": 24.994,
      "text": "It sits just thirty-nine million light-years away, while the other four are parked much further out.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 19.4,
          "end": 25.0,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.994,
      "end": 31.364,
      "text": "Another intruder named NGC 7318B is currently plowing straight into the group.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NGC 7318.jpg",
        "credit": "NASA, ESA, and the Hubble SM4 ERO Team",
        "license": "Public domain",
