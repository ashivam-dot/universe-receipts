        "url": "https://commons.wikimedia.org/wiki/File:Stephan%E2%80%99s_Quintet_(NIRCam_%2B_MIRI_Imaging)_(weic2208a).tiff"
      },
      "shots": [
        {
          "start": 49.067,
          "end": 53.2,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
