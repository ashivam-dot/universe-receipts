        }
      ]
    },
    {
      "start": 11.529,
      "end": 19.399,
      "text": "Modern telescopes revealed that the brightest member, NGC 7320, is actually a foreground interloper.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NGC 7320.jpg",
        "credit": "NASA, ESA, and the Hubble SM4 ERO Team",
        "license": "Public domain",
