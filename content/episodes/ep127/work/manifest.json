    {
      "start": 0.08,
      "end": 4.784,
      "text": "Four interacting galaxies share the sky with a supersonic impostor.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Stephan's Quintet (NIRCam and MIRI Composite Compass Image) (2022-034-01G7DBYV6PTE37PEB5TZ19TMV2).tiff",
