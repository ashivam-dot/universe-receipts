  "beats": [
    {
      "start": 0.08,
      "end": 2.88,
      "text": "Venus can look like a glowing halo in the sky.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "SDO's Ultra-high Definition View of 2012 Venus Transit (171 Angstrom Close Up).jpg",
        "credit": "NASA/SDO, AIA",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:SDO%27s_Ultra-high_Definition_View_of_2012_Venus_Transit_(171_Angstrom_Close_Up).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.867,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 2.88,
      "end": 6.04,
      "text": "This happens when the planet passes directly in front of the Sun.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PSM V06 D230 Orbits of venus and the earth.jpg",
        "credit": "Unknown authorUnknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PSM_V06_D230_Orbits_of_venus_and_the_earth.jpg"
      },
      "shots": [
        {
          "start": 2.867,
          "end": 6.033,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.04,
      "end": 9.66,
      "text": "Galileo first saw the planet change shape like our Moon in 1610.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Fases de Venus - Galileo Galilei.png",
        "credit": "Galileo Galilei",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Fases_de_Venus_-_Galileo_Galilei.png"
      },
      "shots": [
        {
          "start": 6.033,
          "end": 9.667,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.66,
      "end": 12.02,
      "text": "He hid this secret in a scrambled Latin code.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 9.667,
          "end": 12.033,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.02,
      "end": 16.08,
      "text": "A brilliant fire ring appeared during a rare crossing in 1761.",
      "asset": {
        "source": "Wellcome Collection",
        "title": "Astronomy explained upon Sir Isaac Newton's principles. And made easy to those who have not studied mathematics / To whi",
        "credit": "Wellcome Collection",
        "license": "Public domain",
        "url": "https://wellcomecollection.org/works/q2mqs2qb"
      },
      "shots": [
        {
          "start": 12.033,
          "end": 16.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.08,
      "end": 19.26,
      "text": "Sunlight was bending through a massive, thick atmosphere.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Twilight zones.jpg",
        "credit": "Dominic Alves",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Twilight_zones.jpg"
      },
      "shots": [
        {
          "start": 16.067,
          "end": 19.267,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.26,
      "end": 23.3,
      "text": "Russian scientist Mikhail Lomonosov realized another world had air.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mikhail Lomonosov (1757).jpg",
        "credit": "Wortmann Christian-Albert, Fessard Etienne",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Mikhail_Lomonosov_(1757).jpg"
      },
      "shots": [
        {
          "start": 19.267,
          "end": 21.467,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 21.467,
          "end": 23.3,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.3,
      "end": 26.58,
      "text": "That air is actually a toxic, crushing pressure cooker.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "V\u00e9nus par Hubble.jpg",
        "credit": "L. Esposito (University of Colorado, Boulder), and NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:V%C3%A9nus_par_Hubble.jpg"
      },
      "shots": [
        {
          "start": 23.3,
          "end": 26.567,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 26.58,
      "end": 29.803,
      "text": "But from Earth, it looks like a glowing halo in the sky.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "SDO's Ultra-high Definition View of 2012 Venus Transit (171 Angstrom Close Up).jpg",
        "credit": "NASA/SDO, AIA",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:SDO%27s_Ultra-high_Definition_View_of_2012_Venus_Transit_(171_Angstrom_Close_Up).jpg"
      },
      "shots": [
        {
          "start": 26.567,
          "end": 30.167,
