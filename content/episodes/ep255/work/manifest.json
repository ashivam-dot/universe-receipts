  "beats": [
    {
      "start": 0.08,
      "end": 3.9,
      "text": "For centuries, the most toxic planet hid a secret halo.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "SDO's Ultra-high Definition View of 2012 Venus Transit (171 Angstrom Close Up).jpg",
        "credit": "NASA/SDO, AIA",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:SDO%27s_Ultra-high_Definition_View_of_2012_Venus_Transit_(171_Angstrom_Close_Up).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.9,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.9,
      "end": 7.34,
      "text": "It only appears when Venus passes directly across the Sun.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PSM V06 D230 Orbits of venus and the earth.jpg",
        "credit": "Unknown authorUnknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PSM_V06_D230_Orbits_of_venus_and_the_earth.jpg"
      },
      "shots": [
        {
          "start": 3.9,
          "end": 7.333,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.34,
      "end": 11.3,
      "text": "Observers first spotted this hair-thin ring of light in 1761.",
      "asset": {
        "source": "Wellcome Collection",
        "title": "Astronomy explained upon Sir Isaac Newton's principles. And made easy to those who have not studied mathematics / To whi",
        "credit": "Wellcome Collection",
        "license": "Public domain",
        "url": "https://wellcomecollection.org/works/q2mqs2qb"
      },
      "shots": [
        {
          "start": 7.333,
          "end": 11.3,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.3,
      "end": 14.34,
      "text": "They watched a dark silhouette touch the solar edge.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The Rare Transit of Venus - 2004 (7296491948).jpg",
        "credit": "NASA Goddard Space Flight Center from Greenbelt, MD, USA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:The_Rare_Transit_of_Venus_-_2004_(7296491948).jpg"
      },
      "shots": [
        {
          "start": 11.3,
          "end": 12.8,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 12.8,
          "end": 14.333,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.34,
      "end": 18.86,
      "text": "Mikhail Lomonosov realized this fire ring was actually refracted sunlight.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "M.V. Lomonosov by L.Miropolskiy after G.C.Prenner (1787, RAN).jpg",
        "credit": "After Georg Caspar Prenner",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:M.V._Lomonosov_by_L.Miropolskiy_after_G.C.Prenner_(1787,_RAN).jpg"
      },
      "shots": [
        {
          "start": 14.333,
          "end": 17.467,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 17.467,
          "end": 18.867,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.86,
      "end": 21.82,
      "text": "The light was bending through a massive, thick atmosphere.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Posn Setting Sun.jpg",
        "credit": "Robert P. O'Shea",
        "license": "CC BY 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:Posn_Setting_Sun.jpg"
      },
      "shots": [
        {
          "start": 18.867,
          "end": 21.833,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.82,
      "end": 25.12,
      "text": "This was our first proof that another world had air.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA23791-Venus-NewlyProcessedView-20200608 (cropped).jpg",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA23791-Venus-NewlyProcessedView-20200608_(cropped).jpg"
      },
      "shots": [
        {
          "start": 21.833,
          "end": 25.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.12,
      "end": 29.28,
      "text": "This halo proved Venus is a hellscape of acid clouds and crushing pressure.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Tall plumes of white vapor rise from the rocky Venusian surface in this April 19, 1977, artist\u2019s concept (venus-blows-off-some-steam).jpg",
        "credit": "NASA/Rick Guidice",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Tall_plumes_of_white_vapor_rise_from_the_rocky_Venusian_surface_in_this_April_19,_1977,_artist%E2%80%99s_concept_(venus-blows-off-some-steam).jpg"
      },
      "shots": [
        {
          "start": 25.133,
          "end": 29.267,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
