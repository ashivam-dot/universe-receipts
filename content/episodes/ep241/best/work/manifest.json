{
  "id": "ep241",
  "duration": 49.369,
  "beats": [
    {
      "start": 0.08,
      "end": 4.13,
      "text": "A giant human skull once flew past Earth on Halloween night.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Skull2015-TB145.jpg",
        "credit": "NAIC-Arecibo/NSF",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Skull2015-TB145.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.13,
      "end": 10.575,
      "text": "On October 10, 2015, astronomers in Hawaii spotted a massive object inbound.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Pan-STARRS Observatory (2019-12-4315).jpg",
        "credit": "R. Ratkowski",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Pan-STARRS_Observatory_(2019-12-4315).jpg"
      },
      "shots": [
        {
          "start": 4.133,
          "end": 8.533,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 8.533,
          "end": 10.567,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.575,
      "end": 15.92,
      "text": "It was moving at 78,000 miles per hour, closing the gap in three weeks.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Halloween asteroid.jpg",
        "credit": "ESA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Halloween_asteroid.jpg"
      },
      "shots": [
        {
          "start": 10.567,
          "end": 15.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.92,
      "end": 21.915,
      "text": "On Halloween day, it missed us by only 300,000 miles, just beyond the Moon.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Asteroid20151021.jpg",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Asteroid20151021.jpg"
      },
      "shots": [
        {
          "start": 15.933,
          "end": 21.9,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.915,
      "end": 27.96,
      "text": "Scientists at the Arecibo Observatory bounced radar off the surface to reveal its shape.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Arecibo radio telescope observatory Puerto Rico - panoramio (5).jpg",
        "credit": "David Broad",
        "license": "CC BY 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:Arecibo_radio_telescope_observatory_Puerto_Rico_-_panoramio_(5).jpg"
      },
      "shots": [
        {
          "start": 21.9,
          "end": 24.933,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 24.933,
          "end": 27.967,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 27.96,
      "end": 32.68,
      "text": "The returning image showed two hollow eye sockets and a nose above a chin.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "1991VH Arecibo radar Aug9.png",
        "credit": "Shantanu Naidu et al.; Arecibo/NSF/NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:1991VH_Arecibo_radar_Aug9.png"
      },
      "shots": [
        {
          "start": 27.967,
          "end": 32.667,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 32.68,
      "end": 38.025,
      "text": "Astronomers realized this was actually a dead comet that had lost all its ice.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Comet Lemmon Oct 30.png",
        "credit": "Chuck Ayoub",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Comet_Lemmon_Oct_30.png"
      },
      "shots": [
        {
          "start": 32.667,
          "end": 35.133,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 35.133,
          "end": 38.033,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 38.025,
      "end": 44.1,
      "text": "It was a 2,000-foot-wide cosmic corpse reflecting light like fresh black asphalt.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Radar Observations of Elongated Near-Earth Asteroid 2011 AG5 (PIA25259).jpg",
        "credit": "NASA Jet Propulsion Laboratory",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Radar_Observations_of_Elongated_Near-Earth_Asteroid_2011_AG5_(PIA25259).jpg"
      },
      "shots": [
        {
          "start": 38.033,
          "end": 44.1,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 44.1,
      "end": 49.019,
      "text": "Nature spent eons stripping this comet until it looked like a giant human skull.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Skull2015-TB145.jpg",
        "credit": "NAIC-Arecibo/NSF",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Skull2015-TB145.jpg"
      },
      "shots": [
        {
          "start": 44.1,
          "end": 49.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
