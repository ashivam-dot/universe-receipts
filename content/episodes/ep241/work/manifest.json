{
  "id": "ep241",
  "duration": 45.356,
  "beats": [
    {
      "start": 0.08,
      "end": 4.13,
      "text": "A giant human skull once flew past Earth on Halloween night.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Skull2015-TB145.jpg",
        "credit": "NAIC-Arecibo/NSF",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Skull2015-TB145.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.13,
      "end": 10.575,
      "text": "On October 10, 2015, astronomers in Hawaii spotted a massive object inbound.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Pan-STARRS Observatory (2019-12-4315).jpg",
        "credit": "R. Ratkowski",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Pan-STARRS_Observatory_(2019-12-4315).jpg"
      },
      "shots": [
        {
          "start": 4.133,
          "end": 8.533,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 8.533,
          "end": 10.567,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.575,
      "end": 15.92,
      "text": "It was moving at 78,000 miles per hour, closing the gap in three weeks.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Halloween asteroid.jpg",
        "credit": "ESA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Halloween_asteroid.jpg"
      },
      "shots": [
        {
          "start": 10.567,
          "end": 15.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.92,
      "end": 21.915,
      "text": "On Halloween day, it missed us by only 300,000 miles, just beyond the Moon.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Asteroid20151021.jpg",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Asteroid20151021.jpg"
      },
      "shots": [
        {
          "start": 15.933,
          "end": 21.9,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.915,
      "end": 27.96,
      "text": "Scientists at the Arecibo Observatory bounced radar off the surface to reveal its shape.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Arecibo radio telescope observatory Puerto Rico - panoramio (5).jpg",
        "credit": "David Broad",
        "license": "CC BY 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:Arecibo_radio_telescope_observatory_Puerto_Rico_-_panoramio_(5).jpg"
      },
      "shots": [
        {
          "start": 21.9,
          "end": 24.933,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 24.933,
          "end": 27.967,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 27.96,
      "end": 32.68,
      "text": "The returning image showed two hollow eye sockets and a nose above a chin.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "2012LZ1 Radar Jun19.png",
        "credit": "Arecibo Observatory/NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:2012LZ1_Radar_Jun19.png"
      },
      "shots": [
        {
          "start": 27.967,
          "end": 32.667,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 32.68,
      "end": 36.875,
      "text": "Astronomers discovered it was a dead comet, not an asteroid.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "C2020F3 (NEOWISE) from Estonia 2.jpg",
        "credit": "Taavi Niittee",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:C2020F3_(NEOWISE)_from_Estonia_2.jpg"
      },
      "shots": [
        {
          "start": 32.667,
          "end": 34.433,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 34.433,
          "end": 36.867,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 36.875,
      "end": 41.3,
      "text": "This 2,000-foot corpse reflects light like dark asphalt.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Asteroidsscale.jpg",
        "credit": "NASA/JPL-Caltech/JAXA/ESA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Asteroidsscale.jpg"
      },
      "shots": [
        {
          "start": 36.867,
          "end": 41.3,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 41.3,
      "end": 45.006,
      "text": "Nature spent eons stripping this comet until it looked like",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Skull2015-TB145.jpg",
        "credit": "NAIC-Arecibo/NSF",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Skull2015-TB145.jpg"
      },
      "shots": [
        {
          "start": 41.3,
          "end": 45.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
