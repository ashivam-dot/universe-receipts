          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.824,
      "end": 18.819,
      "text": "In 2012, astronomers analyzed an extreme giant nicknamed El Gordo, Spanish for 'The Fat One'.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Phoenix (Annotated) (phoenix-ann).jpg",
        "credit": "E. Slawik/NOIRLab/NSF/AURA/M. Zamani",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Phoenix_(Annotated)_(phoenix-ann).jpg"
      },
      "shots": [
        {
          "start": 11.833,
          "end": 16.0,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 16.0,
          "end": 18.833,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.819,
      "end": 25.264,
      "text": "This titan in the Phoenix constellation produces the most X-rays of any known distant cluster.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "El Gordo- NASA's Chandra Finds Largest Galaxy Cluster in Early Universe (2012-elgordo - 1680).jpg",
        "credit": "X-ray: NASA/CXC/Rutgers/J.Hughes et al, Optical: ESO/VLT/Pontificia Universidad. Catolica de Chile/L.Infante & SOAR (MSU/NOAO/UNC/CNPq-Brazil)/Rutgers/F.Menanteau, IR: NASA/JPL/Rutgers/F.Menanteau",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:El_Gordo-_NASA%27s_Chandra_Finds_Largest_Galaxy_Cluster_in_Early_Universe_(2012-elgordo_-_1680).jpg"
      },
      "shots": [
        {
          "start": 18.833,
          "end": 22.033,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 22.033,
          "end": 25.267,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.264,
      "end": 32.409,
      "text": "But data reveals El Gordo is actually two separate subclusters colliding at millions of kilometers per hour.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Galaxy Cluster 'El Gordo' with Mass Map.jpg",
        "credit": "NASA Hubble",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Galaxy_Cluster_%27El_Gordo%27_with_Mass_Map.jpg"
      },
      "shots": [
        {
          "start": 25.267,
