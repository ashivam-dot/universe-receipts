          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 27.8,
          "end": 32.4,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 32.409,
      "end": 38.004,
      "text": "The impact is so violent that hot gas was wrenched away from unseen dark matter.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "1e0657 scale.jpg",
