    },
    {
      "start": 4.904,
      "end": 11.824,
      "text": "Many people imagine the universe's heaviest distant galaxy cluster is a single, peaceful object.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Cosmic Lens Flare.jpg",
        "credit": "ESA/Hubble & NASA, A. Newman, M. Akhshik, K. Whitaker",
