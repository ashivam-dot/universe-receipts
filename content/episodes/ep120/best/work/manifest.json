          "motion": "camera"
        }
      ]
    },
    {
      "start": 31.509,
      "end": 37.579,
      "text": "The violent crash mirrors the Bullet Cluster, wrenching normal hot gas away from dark matter.",
      "asset": {
        "source": "Wikimedia Commons",
