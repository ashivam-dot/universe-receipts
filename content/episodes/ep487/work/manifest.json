  "duration": 29.989,
  "beats": [
    {
      "start": 0.08,
      "end": 3.76,
      "text": "NASA fixed a broken Mars drill using its robotic arm.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Curiosity rover self portrait at John Klein site (PIA16764, cropped).jpg",
        "credit": "NASA/JPL-Caltech/MSSS",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Curiosity_rover_self_portrait_at_John_Klein_site_(PIA16764,_cropped).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 1.433,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 1.433,
          "end": 3.767,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.76,
      "end": 6.54,
      "text": "Most people think a mechanical failure ends a deep space mission.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Curiosity Touching Down, Artist's Concept.jpg",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Curiosity_Touching_Down,_Artist%27s_Concept.jpg"
      },
      "shots": [
        {
          "start": 3.767,
          "end": 6.533,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.54,
      "end": 10.58,
      "text": "A motor failure in December 2016 left Curiosity's drill stuck.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Curiosity Self-Portrait at 'Big Sky' Drilling Site.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Curiosity_Self-Portrait_at_%27Big_Sky%27_Drilling_Site.jpg"
      },
      "shots": [
        {
          "start": 6.533,
          "end": 8.533,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 8.533,
          "end": 10.567,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.58,
      "end": 13.38,
      "text": "The car-sized rover could no longer push drill bits into rock.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Curiosity rover selfie at Murray Buttes (54234893719).jpg",
        "credit": "semeion.photo",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Curiosity_rover_selfie_at_Murray_Buttes_(54234893719).jpg"
      },
      "shots": [
        {
          "start": 10.567,
          "end": 13.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.38,
      "end": 16.48,
      "text": "Radio signals took fourteen minutes to travel across deep space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mars oppositions Solar System diagram (opo0322b).jpg",
        "credit": "Credit: NASA/ESA and Z. Levay (STScI)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Mars_oppositions_Solar_System_diagram_(opo0322b).jpg"
      },
      "shots": [
        {
          "start": 13.367,
          "end": 16.467,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.48,
      "end": 20.12,
      "text": "So NASA engineers programmed a radical software workaround.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mission Control- Floor Level (49386802568).png",
        "credit": "NASAJPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Mission_Control-_Floor_Level_(49386802568).png"
      },
      "shots": [
        {
          "start": 16.467,
          "end": 20.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.12,
      "end": 23.9,
      "text": "Curiosity used its entire seven-foot arm like a human drill press.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "MSL Sol 1943 - MAHLI (39867647381).jpg",
        "credit": "Kevin M. Gill",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:MSL_Sol_1943_-_MAHLI_(39867647381).jpg"
      },
      "shots": [
        {
          "start": 20.133,
          "end": 23.9,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.9,
      "end": 26.76,
      "text": "The rover successfully resumed rock drilling in May 2018.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 23.9,
          "end": 26.767,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 26.76,
      "end": 29.639,
      "text": "No physical repair crew ever landed on Mars.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Curiosity rover self portrait at John Klein site (PIA16764, cropped).jpg",
        "credit": "NASA/JPL-Caltech/MSSS",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Curiosity_rover_self_portrait_at_John_Klein_site_(PIA16764,_cropped).jpg"
      },
      "shots": [
        {
          "start": 26.767,
          "end": 30.0,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
