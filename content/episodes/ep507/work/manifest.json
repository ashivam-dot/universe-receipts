{
  "id": "ep507",
  "duration": 30.887,
  "beats": [
    {
      "start": 0.08,
      "end": 3.4,
      "text": "A solar observatory became history's greatest comet hunter.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NASA SOHO spacecraft.png",
        "credit": "Cgruda",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:NASA_SOHO_spacecraft.png"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.4,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.4,
      "end": 6.12,
      "text": "It was launched in 1995 for just a two-year mission.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Atlas IIAS launch with SOHO.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Atlas_IIAS_launch_with_SOHO.jpg"
      },
      "shots": [
        {
          "start": 3.4,
          "end": 6.133,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.12,
      "end": 11.12,
      "text": "Then a command error sent it spinning into a silent, frozen deep-space blackout.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Lagrange points.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Lagrange_points.jpg"
      },
      "shots": [
        {
          "start": 6.133,
          "end": 9.567,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 9.567,
          "end": 11.133,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.12,
      "end": 15.84,
      "text": "Engineers pulled off a miracle recovery using reaction wheels as virtual gyroscopes.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Soho schema.png",
        "credit": "Unknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Soho_schema.png"
      },
      "shots": [
        {
          "start": 11.133,
          "end": 15.833,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.84,
      "end": 19.5,
      "text": "Its LASCO instrument blocks the solar glare with an artificial eclipse.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Halloween Storm -Intense Solar Activity- (3442090793).jpg",
        "credit": "NASA Goddard Space Flight Center from Greenbelt, MD, USA",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Halloween_Storm_-Intense_Solar_Activity-_(3442090793).jpg"
      },
      "shots": [
        {
          "start": 15.833,
          "end": 19.5,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.5,
      "end": 22.84,
      "text": "That sun-blocking trick unlocked a staggering scale of discoveries.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "What is a Sungrazing Comet? -hd video- (11090096633).jpg",
        "credit": "NASA Goddard Space Flight Center from Greenbelt, MD, USA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:What_is_a_Sungrazing_Comet%3F_-hd_video-_(11090096633).jpg"
      },
      "shots": [
        {
          "start": 19.5,
          "end": 22.833,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.84,
      "end": 26.86,
      "text": "Citizen scientists combing through public data found over 5,000 comets.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 22.833,
          "end": 26.867,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 26.86,
      "end": 30.537,
      "text": "More than half of all known comets were found by a solar observatory.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NASA SOHO spacecraft.png",
        "credit": "Cgruda",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:NASA_SOHO_spacecraft.png"
      },
      "shots": [
        {
          "start": 26.867,
          "end": 30.9,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    }
  ],
