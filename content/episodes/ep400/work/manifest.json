  "beats": [
    {
      "start": 0.08,
      "end": 2.84,
      "text": "Every star and planet you see is just 5%.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Universe content pie chart.jpg",
        "credit": "Credit: NASA / WMAP Science Team",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Universe_content_pie_chart.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.833,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 2.84,
      "end": 6.3,
      "text": "Most people think deep space is only empty, cold nothingness.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Structure of the Universe.jpg",
        "credit": "NASA, ESA, and E. Hallman (University of Colorado, Boulder)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Structure_of_the_Universe.jpg"
      },
      "shots": [
        {
          "start": 2.833,
          "end": 6.3,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.3,
      "end": 9.48,
      "text": "But the rest is invisible dark matter and dark energy.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Bullet Cluster (Webb and Chandra Compass Image) (2025-128).png",
        "credit": "Image: NASA, ESA, CSA, STScI, CXC Science James Jee (Yonsei University, UC Davis), Sangjun Cha (Yonsei University), Kyle Finner (Caltech/IPAC)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Bullet_Cluster_(Webb_and_Chandra_Compass_Image)_(2025-128).png"
      },
      "shots": [
        {
          "start": 6.3,
          "end": 9.467,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.48,
      "end": 12.8,
      "text": "Dark matter acts as a glue, holding massive galaxies together.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "M31, the Andromeda Galaxy, Killarney Provincial Park Observatory.jpg",
        "credit": "Brucewaters",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:M31,_the_Andromeda_Galaxy,_Killarney_Provincial_Park_Observatory.jpg"
      },
      "shots": [
        {
          "start": 9.467,
          "end": 12.8,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.8,
      "end": 16.14,
      "text": "Meanwhile, dark energy pushes everything away even faster today.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "CMB universe expansion.png",
        "credit": "NASA/WMAP Science Team/ Art by Dana Berry",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:CMB_universe_expansion.png"
      },
      "shots": [
        {
          "start": 12.8,
          "end": 16.133,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.14,
      "end": 19.8,
      "text": "That hidden 95% is the actual backbone of our reality.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 16.133,
          "end": 19.8,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.8,
      "end": 22.814,
      "text": "Everything else is clearly just a tiny fragment of 5%.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Universe content pie chart.jpg",
        "credit": "Credit: NASA / WMAP Science Team",
        "license": "Public domain",
