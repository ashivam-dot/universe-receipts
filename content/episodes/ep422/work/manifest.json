{
  "id": "ep422",
  "duration": 29.466,
  "beats": [
    {
      "start": 0.08,
      "end": 3.38,
      "text": "Saturn radiates 2.5 times more energy than it receives.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The Day the Earth Smiled - PIA17172.jpg",
        "credit": "NASA/JPL-Caltech/SSI",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:The_Day_the_Earth_Smiled_-_PIA17172.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.38,
      "end": 6.0,
      "text": "Most people think distant planets are warmed only by sunlight.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Solar System graphic by NASA.png",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Solar_System_graphic_by_NASA.png"
      },
      "shots": [
        {
          "start": 3.367,
          "end": 6.0,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.0,
      "end": 10.6,
      "text": "Deep inside, Saturn's core burns at 11,700 degrees Celsius.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Gas Giant Interiors.jpg",
        "credit": "Lunar and Planetary Institute",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Gas_Giant_Interiors.jpg"
      },
      "shots": [
        {
          "start": 6.0,
          "end": 8.233,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 8.233,
          "end": 10.6,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.6,
      "end": 14.16,
      "text": "Helium condenses high in the hydrogen atmosphere and rains downward.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA20528 - Watercolor World.jpg",
        "credit": "NASA/JPL-Caltech/Space Science Institute",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA20528_-_Watercolor_World.jpg"
      },
      "shots": [
        {
          "start": 10.6,
          "end": 14.167,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.16,
      "end": 17.62,
      "text": "Friction from falling liquid helium creates massive internal heat.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Saturn Storm.jpg",
        "credit": "NASA/JPL-Caltech/SSI",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Saturn_Storm.jpg"
      },
      "shots": [
        {
          "start": 14.167,
          "end": 17.633,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.62,
      "end": 21.42,
      "text": "This heat engine powers winds reaching 1,800 kilometers per hour.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Saturn HST 2004-03-22.jpg",
        "credit": "NASA, ESA and E. Karkoschka (University of Arizona)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Saturn_HST_2004-03-22.jpg"
      },
      "shots": [
        {
          "start": 17.633,
          "end": 21.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.42,
      "end": 24.96,
      "text": "The heat even drives a giant hexagonal storm at its north pole.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA20513 - Basking in Light.jpg",
        "credit": "NASA/JPL-Caltech/Space Science Institute",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA20513_-_Basking_in_Light.jpg"
      },
      "shots": [
        {
          "start": 21.433,
          "end": 22.967,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 22.967,
          "end": 24.967,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.96,
      "end": 29.116,
      "text": "That internal engine is why Saturn radiates 2.5 times more energy than it receives.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The Day the Earth Smiled - PIA17172.jpg",
        "credit": "NASA/JPL-Caltech/SSI",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:The_Day_the_Earth_Smiled_-_PIA17172.jpg"
      },
      "shots": [
        {
          "start": 24.967,
          "end": 29.467,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
