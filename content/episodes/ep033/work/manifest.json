{
  "id": "ep033",
  "duration": 45.932,
  "beats": [
    {
      "start": 0.08,
      "end": 2.274,
      "text": "No nation can ever own the Moon.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Aldrin Apollo 11 (3x5 crop).jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Aldrin_Apollo_11_(3x5_crop).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.267,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 2.274,
      "end": 8.994,
      "text": "During the height of the Cold War, the United States and the Soviet Union faced a dangerous new frontier.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Atlas-B ICBM.jpg",
        "credit": "USAF",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Atlas-B_ICBM.jpg"
      },
      "shots": [
        {
          "start": 2.267,
          "end": 9.0,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.994,
      "end": 17.239,
      "text": "In 1967, rivals signed this treaty across three global capitals to prevent the space race from turning nuclear.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Signing Outer Space Treaty.jpg",
        "credit": "ITU",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Signing_Outer_Space_Treaty.jpg"
      },
      "shots": [
        {
          "start": 9.0,
          "end": 17.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.239,
      "end": 24.659,
      "text": "This agreement strictly bans countries from placing nuclear weapons or weapons of mass destruction in Earth orbit.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Sputnik 1.jpg",
        "credit": "U.S. Air Force photo",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Sputnik_1.jpg"
      },
      "shots": [
        {
          "start": 17.233,
          "end": 24.667,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.659,
      "end": 30.829,
      "text": "It explicitly forbids nations from claiming sovereignty over the Moon or other celestial bodies.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Buzz Aldrin and the U.S. Flag on the Moon (9460188482).jpg",
        "credit": "NASA/Apollo 11",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Buzz_Aldrin_and_the_U.S._Flag_on_the_Moon_(9460188482).jpg"
      },
      "shots": [
        {
          "start": 24.667,
          "end": 27.733,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 27.733,
          "end": 30.833,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 30.829,
      "end": 35.004,
      "text": "The treaty only bans nukes, not conventional weapons.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 30.833,
          "end": 35.0,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 35.004,
      "end": 42.049,
      "text": "While the Moon remains a zone of peace, the legality of commercial asteroid mining is still fiercely debated.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "S78 27139.2.jpg",
        "credit": "NASA/ Denise Watt",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:S78_27139.2.jpg"
      },
      "shots": [
        {
          "start": 35.0,
          "end": 38.833,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 38.833,
          "end": 42.033,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 42.049,
      "end": 45.582,
      "text": "This international treaty remains a permanent guarantee.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Aldrin Apollo 11 (3x5 crop).jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Aldrin_Apollo_11_(3x5_crop).jpg"
      },
      "shots": [
        {
          "start": 42.033,
          "end": 45.933,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    }
  ],
