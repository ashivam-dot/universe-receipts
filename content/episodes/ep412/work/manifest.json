{
  "id": "ep412",
  "duration": 32.488,
  "beats": [
    {
      "start": 0.08,
      "end": 3.46,
      "text": "Astronomers once believed our single galaxy was the entire universe.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Studio portrait photograph of Edwin Powell Hubble.JPG",
        "credit": "Johan Hagemeyer",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Studio_portrait_photograph_of_Edwin_Powell_Hubble.JPG"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.333,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 2.333,
          "end": 3.467,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.46,
      "end": 6.52,
      "text": "Faint misty patches in space seemed to be simple gas clouds.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The Creighton Chronicle (1917) (14775984344).jpg",
        "credit": "Internet Archive Book Images",
        "license": "No restrictions",
        "url": "https://commons.wikimedia.org/wiki/File:The_Creighton_Chronicle_(1917)_(14775984344).jpg"
      },
      "shots": [
        {
          "start": 3.467,
          "end": 6.533,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.52,
      "end": 10.36,
      "text": "Former high school Spanish teacher Edwin Hubble decided to inspect them.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Studio portrait photograph of Edwin Powell Hubble (cropped).JPG",
        "credit": "Johan Hagemeyer",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Studio_portrait_photograph_of_Edwin_Powell_Hubble_(cropped).JPG"
      },
      "shots": [
        {
          "start": 6.533,
          "end": 10.367,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.36,
      "end": 14.82,
      "text": "Using California's 100-inch Hooker Telescope, he measured distant pulsing stars.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hubble at 100-inch (19950424 cd3 07-CC).tiff",
        "credit": "International Gemini Observatory/NOIRLab/NSF/AURA",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Hubble_at_100-inch_(19950424_cd3_07-CC).tiff"
      },
      "shots": [
        {
          "start": 10.367,
          "end": 11.967,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 11.967,
          "end": 14.833,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.82,
      "end": 18.04,
      "text": "Hubble proved Andromeda was a separate galaxy far outside our own.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hubble views the star that changed the Universe (opo1115a).jpg",
        "credit": "NASA, ESA and the Hubble Heritage Team (STScI/AURA)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Hubble_views_the_star_that_changed_the_Universe_(opo1115a).jpg"
      },
      "shots": [
        {
          "start": 14.833,
          "end": 18.033,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.04,
      "end": 21.46,
      "text": "He then tracked light from far galaxies shifting toward red wavelengths.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Rednadblueshift.png",
        "credit": "Public Domain Image, source: Christopher S. Baird.",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Rednadblueshift.png"
      },
      "shots": [
        {
          "start": 18.033,
          "end": 21.467,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.46,
      "end": 25.58,
      "text": "Farther galaxies receded faster, proving the universe is actively expanding.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "CMB universe expansion.png",
        "credit": "NASA/WMAP Science Team/ Art by Dana Berry",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:CMB_universe_expansion.png"
      },
      "shots": [
        {
          "start": 21.467,
          "end": 25.567,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.58,
      "end": 29.1,
      "text": "Albert Einstein visited Mount Wilson and called static space his biggest blunder.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Einstein 1921 by F Schmutzer - restoration.jpg",
        "credit": "Ferdinand Schmutzer / Adam Cuerden",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Einstein_1921_by_F_Schmutzer_-_restoration.jpg"
      },
      "shots": [
        {
          "start": 25.567,
          "end": 27.333,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 27.333,
          "end": 29.1,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 29.1,
      "end": 32.138,
      "text": "Until then, no one knew other galaxies even existed.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Studio portrait photograph of Edwin Powell Hubble.JPG",
        "credit": "Johan Hagemeyer",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Studio_portrait_photograph_of_Edwin_Powell_Hubble.JPG"
      },
      "shots": [
        {
          "start": 29.1,
          "end": 32.5,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    }
  ],
