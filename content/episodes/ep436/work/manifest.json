  "beats": [
    {
      "start": 0.08,
      "end": 2.48,
      "text": "A giant tennis court protects Webb from the Sun.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist concept of JWST (50489833002 107cb9e661 o).jpg",
        "credit": "Adriana Manrique Gutierrez, NASA Animator",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist_concept_of_JWST_(50489833002_107cb9e661_o).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.467,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 2.48,
      "end": 5.78,
      "text": "NASA had to fold this massive shield inside a rocket.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Webb is encapsulated in its rocket fairing (51760302044).jpg",
        "credit": "NASA's James Webb Space Telescope from Greenbelt, MD, USA",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Webb_is_encapsulated_in_its_rocket_fairing_(51760302044).jpg"
      },
      "shots": [
        {
          "start": 2.467,
          "end": 4.133,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 4.133,
          "end": 5.767,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 5.78,
      "end": 8.86,
      "text": "It's made of five purple sheets thinner than human hair.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Webb Sunshield Test Unfolds Seamlessly (15391400656).jpg",
        "credit": "NASA's James Webb Space Telescope from Greenbelt, MD, USA",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Webb_Sunshield_Test_Unfolds_Seamlessly_(15391400656).jpg"
      },
      "shots": [
        {
          "start": 5.767,
          "end": 8.867,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.86,
      "end": 12.06,
      "text": "Unfurling it required four hundred pulleys and ninety cables.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Webb Sunshield Test Unfolds Seamlessly (15411265761).jpg",
        "credit": "NASA's James Webb Space Telescope from Greenbelt, MD, USA",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Webb_Sunshield_Test_Unfolds_Seamlessly_(15411265761).jpg"
      },
      "shots": [
        {
          "start": 8.867,
          "end": 10.1,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 10.1,
          "end": 12.067,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.06,
      "end": 13.86,
      "text": "One snag could've killed the whole mission.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "STScI-unfolding-sequence.jpg",
        "credit": "STSci",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:STScI-unfolding-sequence.jpg"
      },
      "shots": [
        {
          "start": 12.067,
          "end": 13.867,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.86,
      "end": 16.62,
      "text": "It creates a wall with a six-hundred-degree temperature gap.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Webb Telescope Spacecraft Diagram (4194-Image).jpeg",
        "credit": "IMAGE: STScI",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Webb_Telescope_Spacecraft_Diagram_(4194-Image).jpeg"
      },
      "shots": [
        {
          "start": 13.867,
          "end": 16.633,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.62,
      "end": 19.22,
      "text": "The sunny side cooks at 230 degrees Fahrenheit.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "James Webb Space Telescope 2009 bottom.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:James_Webb_Space_Telescope_2009_bottom.jpg"
      },
      "shots": [
        {
          "start": 16.633,
          "end": 19.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.22,
      "end": 22.74,
      "text": "But the telescope side stays at minus 390 degrees.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "James Webb Space Telescope Mirror Seen in Full Bloom (33433274343).jpg",
        "credit": "NASA's James Webb Space Telescope from Greenbelt, MD, USA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:James_Webb_Space_Telescope_Mirror_Seen_in_Full_Bloom_(33433274343).jpg"
      },
      "shots": [
        {
          "start": 19.233,
          "end": 21.033,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 21.033,
