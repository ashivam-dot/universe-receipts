  "beats": [
    {
      "start": 0.08,
      "end": 3.984,
      "text": "A piece of the Moon's blinding face is sitting in Madagascar.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Satellite image of Madagascar in September 2003.jpg",
        "credit": "Unknown authorUnknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Satellite_image_of_Madagascar_in_September_2003.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.0,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.984,
      "end": 10.154,
      "text": "Looking up from Earth, the bright lunar highlands visible without a telescope are made of anorthosite.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Moon - August 26 2026 (55490769959).jpg",
        "credit": "Kevin M. Gill",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Moon_-_August_26_2026_(55490769959).jpg"
      },
      "shots": [
        {
          "start": 4.0,
          "end": 6.3,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 6.3,
          "end": 10.167,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.154,
      "end": 17.049,
      "text": "Over four billion years ago, lightweight minerals floated atop a lunar magma ocean to freeze into crust.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 10.167,
          "end": 17.033,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.049,
      "end": 24.069,
      "text": "Apollo astronauts hauled back tiny fragments, forcing researchers to hunt for larger rock analogues on Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "AS15-82-11145 (21683646195).jpg",
        "credit": "Project Apollo Archive",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:AS15-82-11145_(21683646195).jpg"
      },
      "shots": [
        {
          "start": 17.033,
          "end": 20.533,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 20.533,
          "end": 24.067,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.069,
      "end": 31.064,
      "text": "While smaller deposits sit in Montana, southern Madagascar holds an exposure of unprecedented scale.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Stillwater Complex (Neoarchean, 2.71 Ga; near the Stillwater Mine, Beartooth Mountains, Montana, USA) 49.jpg",
        "credit": "James St. John",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Stillwater_Complex_(Neoarchean,_2.71_Ga;_near_the_Stillwater_Mine,_Beartooth_Mountains,_Montana,_USA)_49.jpg"
      },
      "shots": [
        {
          "start": 24.067,
          "end": 27.567,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 27.567,
          "end": 31.067,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 31.064,
      "end": 38.659,
      "text": "Astronauts aboard the Space Station photographed a brilliant, forty-square-mile white circle blazing against the landscape.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "ISS012-E-19709 - View of Sudan.jpg",
        "credit": "Earth Science and Remote Sensing Unit, Lyndon B. Johnson Space Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:ISS012-E-19709_-_View_of_Sudan.jpg"
      },
      "shots": [
        {
          "start": 31.067,
          "end": 38.667,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 38.659,
      "end": 46.709,
      "text": "Formed at least 600 million years ago, this massive lunar-like dome survived the collision that assembled Gondwana.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Kuunga2.png",
        "credit": "Kuunga2.jpg: Jmeert\nderivative work: Mikhail Ryazanov (talk)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Kuunga2.png"
      },
      "shots": [
        {
          "start": 38.667,
          "end": 46.7,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 46.709,
      "end": 52.21,
      "text": "No spacecraft is required to see the ancient geology that illuminates our night sky.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Satellite image of Madagascar in September 2003.jpg",
        "credit": "Unknown authorUnknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Satellite_image_of_Madagascar_in_September_2003.jpg"
      },
      "shots": [
        {
          "start": 46.7,
          "end": 52.567,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    }
  ],
