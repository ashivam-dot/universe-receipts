{
  "id": "ep084",
  "duration": 48.165,
  "beats": [
    {
      "start": 0.08,
      "end": 4.922,
      "text": "A space lander bounced a kilometer high after its anchoring harpoons failed.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Philae over a comet.jpg",
        "credit": "DLR, CC-BY 3.0",
        "license": "CC BY 3.0 de",
        "url": "https://commons.wikimedia.org/wiki/File:Philae_over_a_comet.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.922,
      "end": 12.517,
      "text": "In November 2014, the European Space Agency reached comet 67P after a ten-year journey.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 4.933,
          "end": 12.5,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.517,
      "end": 17.037,
      "text": "Philae attempted the first-ever soft landing on a comet nucleus.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Lander Philae - Philae lander (14064329980).jpg",
        "credit": "DLR German Aerospace Center",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Lander_Philae_-_Philae_lander_(14064329980).jpg"
      },
      "shots": [
        {
          "start": 12.5,
          "end": 14.233,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 14.233,
          "end": 17.033,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.037,
      "end": 23.557,
      "text": "Both the anchoring harpoons and the downward-pushing gas thruster failed to fire during touchdown.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Rosetta and Philae (crop).jpg",
        "credit": "DLR, CC-BY 3.0",
        "license": "CC BY 3.0 de",
        "url": "https://commons.wikimedia.org/wiki/File:Rosetta_and_Philae_(crop).jpg"
      },
      "shots": [
        {
          "start": 17.033,
          "end": 23.567,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.557,
      "end": 28.027,
      "text": "The lander rebounded at a speed of thirty-eight centimeters per second.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 23.567,
          "end": 28.033,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 28.027,
      "end": 31.747,
      "text": "That bounce sent the spacecraft soaring for nearly two hours.",
      "asset": {
        "source": "Flickr via Openverse",
        "title": "67P/Churyumov-Gerasimenko - Rosetta",
        "credit": "jccwrt",
        "license": "CC BY 2.0",
        "url": "https://www.flickr.com/photos/132160802@N06/32393838120"
      },
      "shots": [
        {
          "start": 28.033,
          "end": 31.733,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 31.747,
      "end": 35.967,
      "text": "Philae touched down three times before wedging in a dark cliff shadow.",
      "asset": {
        "source": "Flickr via Openverse",
        "title": "67P/Churyumov-Gerasimenko - Rosetta",
        "credit": "jccwrt",
        "license": "CC BY 2.0",
        "url": "https://www.flickr.com/photos/132160802@N06/32755885495"
      },
      "shots": [
        {
          "start": 31.733,
          "end": 33.867,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 33.867,
          "end": 35.967,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 35.967,
      "end": 42.167,
      "text": "Despite the power crisis, all ten onboard instruments returned valuable science data.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "ESA-ESOC Main Control Room.jpg",
        "credit": "ESA/J.Mai",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:ESA-ESOC_Main_Control_Room.jpg"
      },
      "shots": [
        {
          "start": 35.967,
          "end": 38.167,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 38.167,
          "end": 42.167,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 42.167,
      "end": 47.815,
      "text": "A landing gone completely wild still left the intrepid lander bouncing a kilometer high.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Philae over a comet.jpg",
        "credit": "DLR, CC-BY 3.0",
        "license": "CC BY 3.0 de",
        "url": "https://commons.wikimedia.org/wiki/File:Philae_over_a_comet.jpg"
      },
      "shots": [
        {
          "start": 42.167,
          "end": 48.167,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
