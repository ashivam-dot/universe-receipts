  "duration": 51.201,
  "beats": [
    {
      "start": 0.08,
      "end": 3.497,
      "text": "A structure three billion light-years long should not exist.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "SDSS2020.png",
        "credit": "Sloan Digital Sky Survey",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:SDSS2020.png"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.5,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.497,
      "end": 10.117,
      "text": "In 2021, student Alexia Lopez was mapping distant light in the constellation Bo\u00f6tes.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Bo\u00f6tes (boo).tif",
        "credit": "IAU and Sky & Telescope",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Bo%C3%B6tes_(boo).tif"
      },
      "shots": [
        {
          "start": 3.5,
          "end": 6.1,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 6.1,
          "end": 10.1,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.117,
      "end": 16.887,
      "text": "She used the light from ultra-bright quasars like giant flashlights to map out hidden matter in deep space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist's rendering ULAS J1120+0641.jpg",
        "credit": "ESO/M. Kornmesser",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%27s_rendering_ULAS_J1120%2B0641.jpg"
      },
      "shots": [
        {
          "start": 10.1,
          "end": 12.833,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 12.833,
          "end": 16.9,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.887,
      "end": 25.432,
      "text": "Using the Sloan Digital Sky Survey, Lopez found a colossal crescent of galaxies stretching 3.3 billion light-years across.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 16.9,
          "end": 25.433,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.432,
      "end": 32.252,
      "text": "This Giant Arc is so massive it spans one-fifteenth the radius of the entire observable universe.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 25.433,
          "end": 32.267,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 32.252,
      "end": 38.996,
      "text": "Standard cosmology says gravity cannot form structures larger than 1.2 billion light-years.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Full sky maps of the thermal Sunyaev\u2013Zel'dovich effect as quantified by the Compton y parameter (equation 8) for different redshift intervals.jpg",
        "credit": "Authors of the study: Schaye, Joop\u00a0; Kugel, Roi\u00a0; Schaller, Matthieu\u00a0; Helly, John C.\u00a0; Braspenning, Joey\u00a0; Elbers, Willem\u00a0; McCarthy, Ian G.\u00a0; van Daalen, Marcel P.\u00a0; Vandenbroucke, Bert\u00a0; Frenk, Car",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Full_sky_maps_of_the_thermal_Sunyaev%E2%80%93Zel%27dovich_effect_as_quantified_by_the_Compton_y_parameter_(equation_8)_for_different_redshift_intervals.jpg"
      },
      "shots": [
        {
          "start": 32.267,
          "end": 36.567,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 36.567,
          "end": 39.0,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 38.996,
      "end": 44.896,
      "text": "There simply hasn't been enough time since the Big Bang for something this big to clump together.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "CMB Timeline300 no WMAP.jpg",
        "credit": "NASA/WMAP Science Team",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:CMB_Timeline300_no_WMAP.jpg"
      },
      "shots": [
        {
          "start": 39.0,
          "end": 41.433,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 41.433,
          "end": 44.9,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 44.896,
      "end": 50.851,
      "text": "This gargantuan structure suggests that our basic understanding of the universe is actually broken.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "SDSS2020.png",
        "credit": "Sloan Digital Sky Survey",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:SDSS2020.png"
      },
      "shots": [
        {
          "start": 44.9,
          "end": 51.2,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
