{
  "id": "ep111",
  "duration": 52.999,
  "beats": [
    {
      "start": 0.08,
      "end": 3.497,
      "text": "A structure three billion light-years long should not exist.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "SDSS2020.png",
        "credit": "Sloan Digital Sky Survey",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:SDSS2020.png"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.5,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.497,
      "end": 10.117,
      "text": "In 2021, student Alexia Lopez was mapping distant light in the constellation Bo\u00f6tes.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Johann Bayer - Bootes.jpg",
        "credit": "Johann Bayer",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Johann_Bayer_-_Bootes.jpg"
      },
      "shots": [
        {
          "start": 3.5,
          "end": 6.1,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 6.1,
          "end": 10.1,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.117,
      "end": 18.112,
      "text": "She analyzed magnesium two absorption lines, using ultra-bright quasars as giant lamps to illuminate hidden matter.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "QuasarStarburst.jpg",
        "credit": "Unknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:QuasarStarburst.jpg"
      },
      "shots": [
        {
          "start": 10.1,
          "end": 18.1,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.112,
      "end": 26.657,
      "text": "Using the Sloan Digital Sky Survey, Lopez found a colossal crescent of galaxies stretching 3.3 billion light-years across.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Region around the cluster MACS J0717 5+3745 (geminiann04007b).jpg",
        "credit": "International Gemini Observatory/NOIRLab/NSF/AURA",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Region_around_the_cluster_MACS_J0717_5%2B3745_(geminiann04007b).jpg"
      },
      "shots": [
        {
          "start": 18.1,
          "end": 26.667,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 26.657,
      "end": 33.477,
      "text": "This Giant Arc is so massive it spans one-fifteenth the radius of the entire observable universe.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 26.667,
          "end": 33.467,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 33.477,
      "end": 40.222,
      "text": "Standard cosmology says gravity cannot form structures larger than 1.2 billion light-years.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 33.467,
          "end": 40.233,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 40.222,
      "end": 46.122,
      "text": "There simply hasn't been enough time since the Big Bang for something this big to clump together.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "CMB Timeline300 no WMAP.jpg",
        "credit": "NASA/WMAP Science Team",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:CMB_Timeline300_no_WMAP.jpg"
      },
      "shots": [
        {
          "start": 40.233,
          "end": 42.633,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 42.633,
          "end": 46.133,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 46.122,
      "end": 52.649,
      "text": "This gargantuan galaxy cluster suggests that our basic understanding of the universe is actually broken.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "SDSS2020.png",
        "credit": "Sloan Digital Sky Survey",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:SDSS2020.png"
      },
      "shots": [
        {
          "start": 46.133,
          "end": 53.0,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
