  "duration": 55.708,
  "beats": [
    {
      "start": 0.08,
      "end": 5.461,
      "text": "A postage stamp declaring Pluto unexploded inspired a spacecraft to visit it.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Pluto-01 Stern 03 Pluto Color TXT.jpg",
        "credit": "NASA / Johns Hopkins University Applied Physics Laboratory / Southwest Research Institute",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Pluto-01_Stern_03_Pluto_Color_TXT.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 1.933,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 1.933,
          "end": 5.467,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 5.461,
      "end": 13.006,
      "text": "In nineteen ninety-one, the postal service released a set showing every planet alongside its visitor except the ninth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Pluto-01 Stern 03 Pluto Color TXT.jpg",
        "credit": "NASA / Johns Hopkins University Applied Physics Laboratory / Southwest Research Institute",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Pluto-01_Stern_03_Pluto_Color_TXT.jpg"
      },
      "shots": [
        {
          "start": 5.467,
          "end": 13.0,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.006,
      "end": 16.776,
      "text": "Pluto's stamp simply read, Pluto: Not Yet Explored.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 13.0,
          "end": 16.767,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.776,
      "end": 21.996,
      "text": "The phrase irked researchers so much that it became a call to arms for a new mission.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "La NASA en la Embajada (34142640202).jpg",
        "credit": "Embajada de los Estados Unidos en Uruguay from Montevideo, Uruguay",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:La_NASA_en_la_Embajada_(34142640202).jpg"
      },
      "shots": [
        {
          "start": 16.767,
          "end": 22.0,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.996,
      "end": 29.341,
      "text": "On January nineteen, two thousand six, New Horizons launched as the fastest object ever sent from Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Atlas V 551 launches with New Horizons.jpg",
        "credit": "NASA/Ken Thornsley",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Atlas_V_551_launches_with_New_Horizons.jpg"
      },
      "shots": [
        {
          "start": 22.0,
          "end": 26.6,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 26.6,
          "end": 29.333,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 29.341,
      "end": 36.086,
      "text": "A Jupiter gravity assist shaved three years off the voyage, sending the probe speeding toward the solar system.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Portrait of Jupiter from Cassini.jpg",
        "credit": "NASA/JPL/Space Science Institute",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Portrait_of_Jupiter_from_Cassini.jpg"
      },
      "shots": [
        {
          "start": 29.333,
          "end": 36.1,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 36.086,
      "end": 43.081,
      "text": "On July fourteen, twenty fifteen, the spacecraft finally completed its historic close flyby of Pluto.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Flowing nitrogen ice on Pluto - unannotated.jpg",
        "credit": "NASA / Johns Hopkins University Applied Physics Laboratory / Southwest Research Institute",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Flowing_nitrogen_ice_on_Pluto_-_unannotated.jpg"
      },
      "shots": [
        {
          "start": 36.1,
          "end": 43.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 43.081,
      "end": 50.231,
      "text": "Hidden onboard all along was that exact nineteen ninety-one stamp, delivered right to its destination.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA19703-PlutoFlyby-NewHorizons-ArtistConcept-20150709.jpg",
        "credit": "NASA/Johns Hopkins University Applied Physics Laboratory/Southwest Research Institute",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA19703-PlutoFlyby-NewHorizons-ArtistConcept-20150709.jpg"
      },
      "shots": [
        {
          "start": 43.067,
          "end": 50.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
