{
  "id": "ep385",
  "duration": 26.166,
  "beats": [
    {
      "start": 0.08,
      "end": 2.86,
      "text": "One star could soon shine as bright as the Moon.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "HST SN 1987A 20th anniversary.jpg",
        "credit": "NASA, ESA, P. Challis, and R. Kirshner (Harvard-Smithsonian Center for Astrophysics)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:HST_SN_1987A_20th_anniversary.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.867,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 2.86,
      "end": 6.1,
      "text": "It's Betelgeuse, the red supergiant in Orion's shoulder.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Orion tjt.jpg",
        "credit": "TheStarmon",
        "license": "CC BY 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:Orion_tjt.jpg"
      },
      "shots": [
        {
          "start": 2.867,
          "end": 6.1,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.1,
      "end": 8.98,
      "text": "If it replaced our Sun, it'd swallow Earth and Mars.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Size comparison- Betelgeuse and the Sun (potw1726b).jpg",
        "credit": "ALMA (ESO/NAOJ/NRAO)/E. O\u2019Gorman/P. Kervella",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Size_comparison-_Betelgeuse_and_the_Sun_(potw1726b).jpg"
      },
      "shots": [
        {
          "start": 6.1,
          "end": 8.967,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.98,
      "end": 11.88,
      "text": "It is a runaway giant speeding through the galaxy.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Betelgeuse Plume eso0927d.jpg",
        "credit": "ESO/L. Cal\u00e7ada",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Betelgeuse_Plume_eso0927d.jpg"
      },
      "shots": [
        {
          "start": 8.967,
          "end": 11.867,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.88,
      "end": 15.04,
      "text": "It dimmed enough in 2019 to trigger explosion fears.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Betelgeuse\u2019s surface before and during its 2019\u20132020 Great Dimming (with annotations) (eso2109b).jpg",
        "credit": "ESO/M. Montarg\u00e8s et al.",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Betelgeuse%E2%80%99s_surface_before_and_during_its_2019%E2%80%932020_Great_Dimming_(with_annotations)_(eso2109b).jpg"
      },
      "shots": [
        {
          "start": 11.867,
          "end": 15.033,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.04,
      "end": 17.62,
      "text": "Hubble found it just burped a massive, cooling dust cloud.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Disruption of the Red Supergiant Star Betelgeuse (2022-037).tiff",
        "credit": "ILLUSTRATION: NASA, ESA, Elizabeth Wheatley (STScI)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Disruption_of_the_Red_Supergiant_Star_Betelgeuse_(2022-037).tiff"
      },
      "shots": [
        {
          "start": 15.033,
          "end": 17.633,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.62,
      "end": 20.58,
      "text": "We're safe since it's five hundred light-years away.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Orion Constellation Star Field (2001-12-1042).jpg",
        "credit": "Akira Fujii",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Orion_Constellation_Star_Field_(2001-12-1042).jpg"
      },
      "shots": [
        {
          "start": 17.633,
          "end": 20.567,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.58,
      "end": 23.46,
      "text": "At detonation, it will shine through broad daylight.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Tycho's Supernova Remnant- Exploding Stars and Stripes (2011-tycho - tycho 1680).jpg",
        "credit": "X-ray: NASA/CXC/Rutgers/K.Eriksen et al.; Optical: DSS",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Tycho%27s_Supernova_Remnant-_Exploding_Stars_and_Stripes_(2011-tycho_-_tycho_1680).jpg"
      },
      "shots": [
        {
          "start": 20.567,
          "end": 23.467,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.46,
      "end": 25.816,
      "text": "For months, it will glow like a half-moon.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "HST SN 1987A 20th anniversary.jpg",
        "credit": "NASA, ESA, P. Challis, and R. Kirshner (Harvard-Smithsonian Center for Astrophysics)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:HST_SN_1987A_20th_anniversary.jpg"
      },
      "shots": [
        {
          "start": 23.467,
          "end": 26.167,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
