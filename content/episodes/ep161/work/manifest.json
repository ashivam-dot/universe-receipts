  "beats": [
    {
      "start": 0.08,
      "end": 5.854,
      "text": "At 430,000 miles per hour, NASA's fastest craft dives into the Sun.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Parker Solar Probe.jpg",
        "credit": "NASA/Johns Hopkins APL/Steve Gribben",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Parker_Solar_Probe.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.3,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 3.3,
          "end": 5.867,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 5.854,
      "end": 12.424,
      "text": "Launched in 2018, this mission honors the pioneering astrophysicist Eugene Newman Parker.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Dr. Eugene PKSC-20180809-PH KLS02 0003arker Speaks to Media (30123740568) (cropped).jpg",
        "credit": "Kim Shiflett",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Dr._Eugene_PKSC-20180809-PH_KLS02_0003arker_Speaks_to_Media_(30123740568)_(cropped).jpg"
      },
      "shots": [
        {
          "start": 5.867,
          "end": 9.133,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 9.133,
          "end": 12.433,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.424,
      "end": 19.894,
      "text": "The project cost approximately 1.5 billion dollars and required extreme engineering to complete the journey.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Delta IV launch 2013-08-28.jpg",
        "credit": "U.S. Air Force/Joe Davila",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Delta_IV_launch_2013-08-28.jpg"
      },
      "shots": [
        {
          "start": 12.433,
          "end": 19.9,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.894,
      "end": 26.914,
      "text": "To reach the blistering outer atmosphere, the probe executes seven Venus gravity assists over seven long years.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Venus globe.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Venus_globe.jpg"
      },
      "shots": [
        {
          "start": 19.9,
          "end": 23.367,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 23.367,
          "end": 26.9,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 26.914,
      "end": 35.234,
      "text": "A massive 4.5-inch-thick carbon-composite heat shield protects the four sensitive instrument suites tucked deep inside.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "KSC-20180627-PH GEB01 0043 (41411525810).jpg",
        "credit": "NASA Kennedy from United States\n\nNASA/Glenn Benson",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:KSC-20180627-PH_GEB01_0043_(41411525810).jpg"
      },
      "shots": [
        {
          "start": 26.9,
          "end": 35.233,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 35.234,
      "end": 46.209,
      "text": "While the exterior withstands temperatures reaching nearly 2,500 degrees Fahrenheit, sensitive internal electronics stay at a constant 85 degrees.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Gigantic Rolling Wave Captured on the Sun (hd video) (8699397600).jpg",
        "credit": "NASA Goddard Space Flight Center from Greenbelt, MD, USA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Gigantic_Rolling_Wave_Captured_on_the_Sun_(hd_video)_(8699397600).jpg"
      },
      "shots": [
        {
          "start": 35.233,
          "end": 46.2,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 46.209,
      "end": 53.797,
      "text": "That brilliant engineering finally lets humanity directly touch our star at 430,000 miles per hour.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Parker Solar Probe.jpg",
        "credit": "NASA/Johns Hopkins APL/Steve Gribben",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Parker_Solar_Probe.jpg"
      },
      "shots": [
        {
          "start": 46.2,
          "end": 54.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
