{
  "id": "ep080",
  "duration": 48.145,
  "beats": [
    {
      "start": 0.08,
      "end": 4.929,
      "text": "On one asteroid, the sun rises and sets in completely random locations.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "4179 Toutatis.png",
        "credit": "Yun Jiang, Jianghui Ji, Jiangchuan Huang, Simone Marchi, Yuan Li & Wing-Huen Ip",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:4179_Toutatis.png"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.929,
      "end": 12.974,
      "text": "Discovered on January 4, 1989, 4179 Toutatis is nearly five kilometers long.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 4.933,
          "end": 12.967,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.974,
      "end": 20.644,
      "text": "On September 29, 2004, this massive space rock passed within four lunar distances of our planet.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 12.967,
          "end": 20.633,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.644,
      "end": 26.894,
      "text": "Internet rumors at the time falsely claimed the asteroid carried a high chance of hitting Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PioneerDeepSpaceStation.jpg",
        "credit": "Unknown NASA employee",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PioneerDeepSpaceStation.jpg"
      },
      "shots": [
        {
          "start": 20.633,
          "end": 26.9,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 26.894,
      "end": 33.914,
      "text": "Later observations by the Chinese probe Chang'e 2 revealed it is a ginger-root shaped contact binary.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PioneerDeepSpaceStation.jpg",
        "credit": "Unknown NASA employee",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PioneerDeepSpaceStation.jpg"
      },
      "shots": [
        {
          "start": 26.9,
          "end": 33.9,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 33.914,
      "end": 39.859,
      "text": "Instead of a stable spin, Toutatis tumbles through space like a football after a botched pass.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Asteroid 4179 Toutatis.faces model.jpg",
        "credit": "Rendered by Eric DeJong and Shigeru Suzuki",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Asteroid_4179_Toutatis.faces_model.jpg"
      },
      "shots": [
        {
          "start": 33.9,
          "end": 39.867,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 39.859,
      "end": 47.795,
      "text": "This chaotic rotation explains precisely why on one asteroid, the sun rises and sets in completely random locations.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "4179 Toutatis.png",
        "credit": "Yun Jiang, Jianghui Ji, Jiangchuan Huang, Simone Marchi, Yuan Li & Wing-Huen Ip",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:4179_Toutatis.png"
      },
      "shots": [
        {
          "start": 39.867,
          "end": 48.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
