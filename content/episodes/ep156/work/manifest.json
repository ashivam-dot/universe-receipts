{
  "id": "ep156",
  "duration": 46.592,
  "beats": [
    {
      "start": 0.08,
      "end": 4.1,
      "text": "A secret radioactive clock is bolted to the side of Voyager.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyager spacecraft.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Voyager_spacecraft.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.1,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.1,
      "end": 14.595,
      "text": "In 1977, two robotic spacecraft launched into the great void carrying golden phonograph records designed to tell Earth's complete story to the stars.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The Sounds of Earth Record Cover - GPN-2000-001978.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:The_Sounds_of_Earth_Record_Cover_-_GPN-2000-001978.jpg"
      },
      "shots": [
        {
          "start": 4.1,
          "end": 9.567,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 9.567,
          "end": 14.6,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.595,
      "end": 25.24,
      "text": "Inside are spoken greetings in 55 different human languages, whale songs, and human brainwaves recorded during a deeply emotional moment of falling in love.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Ann Druyan 1.jpg",
        "credit": "Bob Lee",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Ann_Druyan_1.jpg"
      },
      "shots": [
        {
          "start": 14.6,
          "end": 25.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.24,
      "end": 32.035,
      "text": "But the protective aluminum cover itself holds an ultra-pure sample of heavy uranium-238.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Uranium (Element - 92) 1.jpg",
        "credit": "James St. John",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Uranium_(Element_-_92)_1.jpg"
      },
      "shots": [
        {
          "start": 25.233,
          "end": 29.9,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 29.9,
          "end": 32.033,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 32.035,
      "end": 42.06,
      "text": "Because this exact isotope decays with a half-life of approximately 4.5 billion years, any finder can calculate the exact time since launch.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "OSC Astro 07 03 Decay (1).jpg",
        "credit": "Andrew Fraknoi, David Morrison, and Sidney Wolff. \u00a9 1999-2018, Rice University. Except where otherwise noted, content created on this site is licensed under a Creative Commons Attribution 4.0 License.",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:OSC_Astro_07_03_Decay_(1).jpg"
      },
      "shots": [
        {
          "start": 32.033,
          "end": 42.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 42.06,
      "end": 46.242,
      "text": "That brilliant atomic clock is built right into the side of Voyager.",
      "asset": {
