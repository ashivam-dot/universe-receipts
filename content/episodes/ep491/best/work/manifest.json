{
  "id": "ep491",
  "duration": 29.788,
  "beats": [
    {
      "start": 0.08,
      "end": 4.14,
      "text": "Astronauts aboard the space station watch 16 sunrises every day.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Iss066e008177.jpg",
        "credit": "NASA Johnson Space Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Iss066e008177.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 1.867,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 1.867,
          "end": 4.133,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.14,
      "end": 6.9,
      "text": "Picture living inside a Boeing 747 jumbo jetliner.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Thai Airways International Boeing 747-4D7 HS-TGP MUC 2015 04.jpg",
        "credit": "Julian Herzog (Website)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Thai_Airways_International_Boeing_747-4D7_HS-TGP_MUC_2015_04.jpg"
      },
      "shots": [
        {
          "start": 4.133,
          "end": 6.9,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.9,
      "end": 10.34,
      "text": "Now stretch its exterior across a full American football field.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "International Space Station after undocking of STS-132.jpg",
        "credit": "NASA/Crew of STS-132",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:International_Space_Station_after_undocking_of_STS-132.jpg"
      },
      "shots": [
        {
          "start": 6.9,
          "end": 10.333,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.34,
      "end": 14.2,
      "text": "Place that massive station 250 miles above Earth's surface.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Iss064e002941 (Nov 1, 2020) --- The Earth's limb, or horizon, is pictured as the International Space Station orbited above the north Pacific near Alaska's Aleutian Islands.jpg",
        "credit": "NASA Johnson Space Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Iss064e002941_(Nov_1,_2020)_---_The_Earth%27s_limb,_or_horizon,_is_pictured_as_the_International_Space_Station_orbited_above_the_north_Pacific_near_Alaska%27s_Aleutian_Islands.jpg"
      },
      "shots": [
        {
          "start": 10.333,
          "end": 14.2,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.2,
      "end": 18.34,
      "text": "Now fling it across orbit at 17,500 miles per hour.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Sunset from the ISS.JPG",
        "credit": "ISS Expedition 23 crew",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Sunset_from_the_ISS.JPG"
      },
      "shots": [
        {
          "start": 14.2,
          "end": 16.033,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 16.033,
          "end": 18.333,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.34,
      "end": 21.78,
      "text": "At that speed, it circles the entire planet every 90 minutes.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "An orbital sunrise bursts above Earth's horizon (iss073e1068530).jpg",
        "credit": "NASA Johnson Space Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:An_orbital_sunrise_bursts_above_Earth%27s_horizon_(iss073e1068530).jpg"
      },
      "shots": [
        {
          "start": 18.333,
          "end": 20.067,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 20.067,
          "end": 21.767,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.78,
      "end": 25.9,
      "text": "Yet after decades in orbit, agencies plan to deorbit it around 2030.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Re-entry of Progress Spacecraft 42P - NASA Earth Observatory.jpg",
        "credit": "NASA's Earth Observatory",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Re-entry_of_Progress_Spacecraft_42P_-_NASA_Earth_Observatory.jpg"
      },
      "shots": [
        {
          "start": 21.767,
          "end": 25.9,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.9,
      "end": 29.438,
      "text": "That is why astronauts in orbit watch 16 sunsets every day.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Iss066e008177.jpg",
        "credit": "NASA Johnson Space Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Iss066e008177.jpg"
      },
      "shots": [
        {
          "start": 25.9,
          "end": 29.8,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    }
  ],
