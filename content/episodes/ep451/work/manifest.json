{
  "id": "ep451",
  "duration": 29.182,
  "beats": [
    {
      "start": 0.08,
      "end": 3.44,
      "text": "One of the brightest stars in our sky went dark.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.433,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.44,
      "end": 7.22,
      "text": "Orion's red shoulder, the supergiant Betelgeuse, suddenly lost its brilliance.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "A bubbling Betelgeuse (potw2634a).jpg",
        "credit": "ESO/W. Dent et al.",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:A_bubbling_Betelgeuse_(potw2634a).jpg"
      },
      "shots": [
        {
          "start": 3.433,
          "end": 7.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.22,
      "end": 10.04,
      "text": "It plummeted from the top ten brightest night objects.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Betelgeuse\u2019s surface before and during its 2019\u20132020 Great Dimming (with annotations) (eso2109b).jpg",
        "credit": "ESO/M. Montarg\u00e8s et al.",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Betelgeuse%E2%80%99s_surface_before_and_during_its_2019%E2%80%932020_Great_Dimming_(with_annotations)_(eso2109b).jpg"
      },
      "shots": [
        {
          "start": 7.233,
          "end": 10.033,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.04,
      "end": 12.78,
      "text": "If it replaced our Sun, it would swallow Jupiter.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Size comparison- Betelgeuse and the Sun (potw1726b).jpg",
        "credit": "ALMA (ESO/NAOJ/NRAO)/E. O\u2019Gorman/P. Kervella",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Size_comparison-_Betelgeuse_and_the_Sun_(potw1726b).jpg"
      },
      "shots": [
        {
          "start": 10.033,
          "end": 12.767,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.78,
      "end": 15.08,
      "text": "Many feared the massive star was about to explode.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Size comparison- Betelgeuse and the Sun (potw1726b).jpg",
        "credit": "ALMA (ESO/NAOJ/NRAO)/E. O\u2019Gorman/P. Kervella",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Size_comparison-_Betelgeuse_and_the_Sun_(potw1726b).jpg"
      },
      "shots": [
        {
          "start": 12.767,
          "end": 15.067,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.08,
      "end": 18.54,
      "text": "But the star wasn't dying; it was actually burping.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Betelgeuse\u2019s surface before and during its 2019\u20132020 Great Dimming (with annotations) (eso2109b).jpg",
        "credit": "ESO/M. Montarg\u00e8s et al.",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Betelgeuse%E2%80%99s_surface_before_and_during_its_2019%E2%80%932020_Great_Dimming_(with_annotations)_(eso2109b).jpg"
      },
      "shots": [
        {
          "start": 15.067,
          "end": 18.533,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.54,
      "end": 21.24,
      "text": "A massive bubble of plasma erupted from its surface.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 18.533,
          "end": 21.233,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.24,
      "end": 23.78,
      "text": "It cooled into dust and blocked its own light.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Illustration of Outburst from Betelgeuse (2020-44-4724).tif",
        "credit": "NASA, ESA, and E. Wheatley (STScI)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Illustration_of_Outburst_from_Betelgeuse_(2020-44-4724).tif"
      },
      "shots": [
        {
          "start": 21.233,
          "end": 23.767,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.78,
      "end": 26.3,
      "text": "The giant had hidden itself behind its own outburst.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Illustration of Outburst from Betelgeuse (2020-44-4724).tif",
        "credit": "NASA, ESA, and E. Wheatley (STScI)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Illustration_of_Outburst_from_Betelgeuse_(2020-44-4724).tif"
      },
      "shots": [
        {
          "start": 23.767,
          "end": 26.3,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 26.3,
      "end": 28.832,
      "text": "Even the brightest stars in our sky can go dark.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 26.3,
          "end": 29.167,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    }
  ],
