{
  "id": "ep451",
  "duration": 30.317,
  "beats": [
    {
      "start": 0.08,
      "end": 2.82,
      "text": "One of the brightest stars in our sky went dark.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Orionis Constellation (1 Minute Exposure).jpg",
        "credit": "Justin Quintal",
        "license": "CC BY 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:Orionis_Constellation_(1_Minute_Exposure).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 1.767,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 1.767,
          "end": 2.833,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 2.82,
      "end": 7.14,
      "text": "Orion's red shoulder, the supergiant Betelgeuse, suddenly lost its brilliance.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "A bubbling Betelgeuse (potw2634a).jpg",
        "credit": "ESO/W. Dent et al.",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:A_bubbling_Betelgeuse_(potw2634a).jpg"
      },
      "shots": [
        {
          "start": 2.833,
          "end": 7.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.14,
      "end": 9.86,
      "text": "It plummeted from the top ten brightest night objects.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Betelgeuse\u2019s surface before and during its 2019\u20132020 Great Dimming (with annotations) (eso2109b).jpg",
        "credit": "ESO/M. Montarg\u00e8s et al.",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Betelgeuse%E2%80%99s_surface_before_and_during_its_2019%E2%80%932020_Great_Dimming_(with_annotations)_(eso2109b).jpg"
      },
      "shots": [
        {
          "start": 7.133,
          "end": 9.867,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.86,
      "end": 12.62,
      "text": "If it replaced our Sun, it would swallow Jupiter.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Size comparison- Betelgeuse and the Sun (potw1726b).jpg",
        "credit": "ALMA (ESO/NAOJ/NRAO)/E. O\u2019Gorman/P. Kervella",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Size_comparison-_Betelgeuse_and_the_Sun_(potw1726b).jpg"
      },
      "shots": [
        {
          "start": 9.867,
          "end": 12.633,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.62,
      "end": 15.86,
      "text": "Many feared the massive star was about to explode.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Tycho's Supernova Remnant- Exploding Stars and Stripes (2011-tycho - tycho 1024).jpg",
        "credit": "X-ray: NASA/CXC/Rutgers/K.Eriksen et al.; Optical: DSS",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Tycho%27s_Supernova_Remnant-_Exploding_Stars_and_Stripes_(2011-tycho_-_tycho_1024).jpg"
      },
      "shots": [
        {
          "start": 12.633,
          "end": 15.867,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.86,
      "end": 18.86,
      "text": "But the star wasn't dying; it was actually burping.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Tycho's Supernova Remnant- Exploding Stars and Stripes (2011-tycho - tycho 1024).jpg",
        "credit": "X-ray: NASA/CXC/Rutgers/K.Eriksen et al.; Optical: DSS",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Tycho%27s_Supernova_Remnant-_Exploding_Stars_and_Stripes_(2011-tycho_-_tycho_1024).jpg"
      },
      "shots": [
        {
          "start": 15.867,
          "end": 18.867,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.86,
      "end": 21.8,
      "text": "A massive bubble of plasma erupted from its surface.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 18.867,
          "end": 21.8,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.8,
      "end": 24.1,
      "text": "It cooled into dust and blocked its own light.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Illustration of Outburst from Betelgeuse (2020-44-4724).tif",
        "credit": "NASA, ESA, and E. Wheatley (STScI)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Illustration_of_Outburst_from_Betelgeuse_(2020-44-4724).tif"
      },
      "shots": [
        {
          "start": 21.8,
          "end": 24.1,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.1,
      "end": 27.2,
      "text": "The giant had hidden itself behind its own outburst.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Betelgeuse\u2019s surface before and during its 2019\u20132020 Great Dimming (eso2109a).jpg",
        "credit": "ESO/M. Montarg\u00e8s et al.",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Betelgeuse%E2%80%99s_surface_before_and_during_its_2019%E2%80%932020_Great_Dimming_(eso2109a).jpg"
      },
      "shots": [
        {
          "start": 24.1,
          "end": 27.2,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 27.2,
      "end": 29.967,
      "text": "Even the brightest stars in our sky can go dark.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Orionis Constellation (1 Minute Exposure).jpg",
        "credit": "Justin Quintal",
        "license": "CC BY 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:Orionis_Constellation_(1_Minute_Exposure).jpg"
      },
      "shots": [
        {
          "start": 27.2,
          "end": 30.333,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    }
  ],
