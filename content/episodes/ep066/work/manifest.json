  "beats": [
    {
      "start": 0.08,
      "end": 4.147,
      "text": "A nearby planet completes its entire year in 18 hours.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Super-Earth Exoplanet 55 Cancri e (Artist\u2019s Concept) (2024-102).png",
        "credit": "Illustration NASA, ESA, CSA, Ralf Crawford (STScI)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Super-Earth_Exoplanet_55_Cancri_e_(Artist%E2%80%99s_Concept)_(2024-102).png"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 1.9,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 1.9,
          "end": 4.133,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.147,
      "end": 11.242,
      "text": "Discovered in 2004, 55 Cancri e is a rocky super-Earth twice the size of our home world.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Earth and Super-Earth.jpg",
        "credit": "NASA/JPL-Caltech/R. Hurt (SSC)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Earth_and_Super-Earth.jpg"
      },
      "shots": [
        {
          "start": 4.133,
          "end": 8.333,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 8.333,
          "end": 11.233,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.242,
      "end": 17.737,
      "text": "It orbits its sun-like star so closely that the planet is tidally locked in a permanent death spiral.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "55 Cancri e - PIA20068.jpg",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:55_Cancri_e_-_PIA20068.jpg"
      },
      "shots": [
        {
          "start": 11.233,
          "end": 15.033,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 15.033,
          "end": 17.733,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.737,
      "end": 24.082,
      "text": "The star-facing dayside roasts at over 2,000 Kelvin, a temperature hot enough to melt iron.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist\u2019s impression of 55 Cancri e (close-up).tif",
        "credit": "ESA/Hubble, M. Kornmesser",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%E2%80%99s_impression_of_55_Cancri_e_(close-up).tif"
      },
      "shots": [
        {
          "start": 17.733,
          "end": 20.1,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 20.1,
          "end": 24.067,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.082,
      "end": 32.427,
      "text": "In 2012, one controversial hypothesis suggested this carbon-rich world might have an interior of solid diamond.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "A Tale of Two Worlds - Silicate Versus Carbon Planets.jpg",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:A_Tale_of_Two_Worlds_-_Silicate_Versus_Carbon_Planets.jpg"
      },
      "shots": [
        {
          "start": 24.067,
          "end": 28.467,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 28.467,
          "end": 32.433,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 32.427,
      "end": 39.672,
      "text": "But in 2024, the James Webb Space Telescope detected a thick, volatile atmosphere on this hellscape.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "James Webb Space Telescope Testing Progress Continues.jpg",
        "credit": "Chris Gunn",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:James_Webb_Space_Telescope_Testing_Progress_Continues.jpg"
      },
      "shots": [
        {
          "start": 32.433,
          "end": 35.067,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 35.067,
          "end": 39.667,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 39.672,
      "end": 45.997,
      "text": "This atmosphere is likely outgassed from and sustained by a bubbling ocean of liquid magma.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Erta-ale lac-de-lave 2001.jpg",
        "credit": "Herv\u00e9 Sthioul",
        "license": "CC BY 2.5",
        "url": "https://commons.wikimedia.org/wiki/File:Erta-ale_lac-de-lave_2001.jpg"
      },
      "shots": [
        {
          "start": 39.667,
          "end": 42.167,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 42.167,
          "end": 46.0,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 45.997,
      "end": 50.546,
      "text": "That molten surface races around its host star in just 18 hours.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Super-Earth Exoplanet 55 Cancri e (Artist\u2019s Concept) (2024-102).png",
        "credit": "Illustration NASA, ESA, CSA, Ralf Crawford (STScI)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Super-Earth_Exoplanet_55_Cancri_e_(Artist%E2%80%99s_Concept)_(2024-102).png"
      },
      "shots": [
        {
          "start": 46.0,
