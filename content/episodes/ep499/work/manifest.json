      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.1,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.1,
      "end": 7.1,
      "text": "It's 73 quasars, the glowing cores of early-universe galaxies.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist\u2019s rendering of quasar P172+18 (eso2103a).jpg",
        "credit": "ESO/M. Kornmesser",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%E2%80%99s_rendering_of_quasar_P172%2B18_(eso2103a).jpg"
      },
      "shots": [
        {
          "start": 3.1,
          "end": 7.1,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.1,
      "end": 10.34,
      "text": "The nearest big galaxy, Andromeda, is a dot beside it.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hubble\u2019s panoramic view of the Andromeda Galaxy (heic2501a).tiff",
        "credit": "NASA, ESA, B. Williams (University of Washington)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Hubble%E2%80%99s_panoramic_view_of_the_Andromeda_Galaxy_(heic2501a).tiff"
      },
      "shots": [
        {
          "start": 7.1,
          "end": 10.333,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.34,
      "end": 13.22,
      "text": "This structure is 1600 times that distance.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "DESI Uses Distant Quasars to Map the Cosmic Web (noirlab2408d).tiff",
        "credit": "NOIRLab/NSF/AURA/P. Marenfeld",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:DESI_Uses_Distant_Quasars_to_Map_the_Cosmic_Web_(noirlab2408d).tiff"
      },
      "shots": [
        {
          "start": 10.333,
          "end": 13.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.22,
      "end": 16.6,
      "text": "Cosmic theory says nothing should be bigger than 370 megaparsecs.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 13.233,
          "end": 16.6,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.6,
      "end": 18.14,
      "text": "This one stretches to 1200.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "CosmoDistanceMeasures z to onehalf.png",
        "credit": "Wesino at English Wikipedia",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:CosmoDistanceMeasures_z_to_onehalf.png"
      },
      "shots": [
        {
          "start": 16.6,
          "end": 18.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.14,
      "end": 21.0,
      "text": "But it might just be random noise, not a real wall.",
      "asset": {
        "source": "Wikimedia Commons",
