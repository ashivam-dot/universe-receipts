  "beats": [
    {
      "start": 0.08,
      "end": 2.58,
      "text": "Light takes 4 billion years to cross this.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist's impression of quasar1.jpg",
        "credit": "NASA/ESA/ESO/Wolfram Freudling et al",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%27s_impression_of_quasar1.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.567,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 2.58,
      "end": 6.04,
      "text": "It's 73 quasars, the glowing cores of early-universe galaxies.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist\u2019s rendering of quasar P172+18 (eso2103a).jpg",
        "credit": "ESO/M. Kornmesser",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%E2%80%99s_rendering_of_quasar_P172%2B18_(eso2103a).jpg"
      },
      "shots": [
        {
          "start": 2.567,
          "end": 6.033,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.04,
      "end": 9.16,
      "text": "The nearest big galaxy, Andromeda, is a dot beside it.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Optical Image of Andromeda Galaxy (M31) (2007-m31-more-2).tiff",
        "credit": "(Credit: NOAO/AURA/NSF/T.Rector & B.A.Wolpa)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Optical_Image_of_Andromeda_Galaxy_(M31)_(2007-m31-more-2).tiff"
      },
      "shots": [
        {
          "start": 6.033,
          "end": 9.167,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.16,
      "end": 12.604,
      "text": "This quasar wall spans four billion light-years across.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist\u2019s impression of mysterious alignment of quasar rotation axes (eso1438a).tiff",
        "credit": "ESO/M. Kornmesser",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%E2%80%99s_impression_of_mysterious_alignment_of_quasar_rotation_axes_(eso1438a).tiff"
      },
      "shots": [
        {
          "start": 9.167,
          "end": 12.6,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.604,
      "end": 15.92,
      "text": "Cosmic theory says no structure should exceed 1.2 billion light-years.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 12.6,
          "end": 15.933,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.92,
      "end": 19.0,
      "text": "Yet this structure appears to be three times that limit.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The FLAMINGO project \u2013 cosmological hydrodynamical simulations for large-scale structure and galaxy cluster surveys.jpg",
        "credit": "Authors of the study: Schaye, Joop\u00a0; Kugel, Roi\u00a0; Schaller, Matthieu\u00a0; Helly, John C.\u00a0; Braspenning, Joey\u00a0; Elbers, Willem\u00a0; McCarthy, Ian G.\u00a0; van Daalen, Marcel P.\u00a0; Vandenbroucke, Bert\u00a0; Frenk, Car",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:The_FLAMINGO_project_%E2%80%93_cosmological_hydrodynamical_simulations_for_large-scale_structure_and_galaxy_cluster_surveys.jpg"
      },
      "shots": [
        {
          "start": 15.933,
          "end": 17.5,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 17.5,
          "end": 19.0,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.0,
      "end": 22.02,
      "text": "But it might just be random noise, not a real wall.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Structure of the Universe.jpg",
        "credit": "NASA, ESA, and E. Hallman (University of Colorado, Boulder)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Structure_of_the_Universe.jpg"
      },
      "shots": [
        {
          "start": 19.0,
