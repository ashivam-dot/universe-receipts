  "beats": [
    {
      "start": 0.08,
      "end": 3.1,
      "text": "Light takes 4 billion years to cross this.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist's impression of quasar1.jpg",
        "credit": "NASA/ESA/ESO/Wolfram Freudling et al",
        "license": "Public domain",
