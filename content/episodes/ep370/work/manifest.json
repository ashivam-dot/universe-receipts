{
  "id": "ep370",
  "duration": 33.939,
  "beats": [
    {
      "start": 0.08,
      "end": 4.02,
      "text": "Saturn\u2019s rings are wider than twenty Earths but razor-thin.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA17172 Saturn eclipse mosaic bright crop.jpg",
        "credit": "NASA / JPL-Caltech / Space Science Institute",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA17172_Saturn_eclipse_mosaic_bright_crop.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.033,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.02,
      "end": 8.5,
      "text": "They span 170,000 miles while averaging just 30 feet thick.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA11668 The Tallest Peaks.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA11668_The_Tallest_Peaks.jpg"
      },
      "shots": [
        {
          "start": 4.033,
          "end": 8.5,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.5,
      "end": 12.22,
      "text": "This disk is like a city-sized circle thinner than cardboard.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Planetary Rings and California (4078771106).jpg",
        "credit": "Lunar and Planetary Institute from Houston, TX, USA",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Planetary_Rings_and_California_(4078771106).jpg"
      },
      "shots": [
        {
          "start": 8.5,
          "end": 12.233,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.22,
      "end": 15.5,
      "text": "Galileo first saw them in 1610 and thought they were ears.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 12.233,
          "end": 15.5,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.5,
      "end": 18.28,
      "text": "Two years later they vanished because Earth passed through their plane.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Edge-On View of Saturn's Rings (1996-16-415).jpg",
        "credit": "Credit: Erich Karkoschka (University of Arizona Lunar & Planetary Lab) and NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Edge-On_View_of_Saturn%27s_Rings_(1996-16-415).jpg"
      },
      "shots": [
        {
          "start": 15.5,
          "end": 18.267,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.28,
      "end": 22.44,
      "text": "Christiaan Huygens finally revealed their true shape as detached rings in 1659.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The celestial worlds discover'd- or, conjectures concerning the inhabitants, plants and productions of the worlds in the planets Fleuron T053996-5.png",
        "credit": "Huygens, Christiaan",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:The_celestial_worlds_discover%27d-_or,_conjectures_concerning_the_inhabitants,_plants_and_productions_of_the_worlds_in_the_planets_Fleuron_T053996-5.png"
      },
      "shots": [
        {
          "start": 18.267,
          "end": 22.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.44,
      "end": 26.92,
      "text": "These massive bands are actually 99.9 percent pure water ice.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Saturn Ring Particles (32004738971).png",
        "credit": "geckzilla",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Saturn_Ring_Particles_(32004738971).png"
      },
      "shots": [
        {
          "start": 22.433,
          "end": 26.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 26.92,
      "end": 30.66,
      "text": "They are likely temporary, appearing only 100 million years ago.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 26.933,
          "end": 30.667,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 30.66,
      "end": 33.589,
      "text": "Nothing in the solar system matches this massive scale.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA17172 Saturn eclipse mosaic bright crop.jpg",
        "credit": "NASA / JPL-Caltech / Space Science Institute",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA17172_Saturn_eclipse_mosaic_bright_crop.jpg"
      },
      "shots": [
        {
          "start": 30.667,
          "end": 33.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
