{
  "id": "ep071",
  "duration": 47.623,
  "beats": [
    {
      "start": 0.08,
      "end": 4.088,
      "text": "The inevitable crash of our galaxy is actually a coin flip.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Andromeda Collides Milky Way.jpg",
        "credit": "NASA; ESA; Z. Levay and R. van der Marel, STScI; T. Hallas; and A. Mellinger",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Andromeda_Collides_Milky_Way.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.1,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.088,
      "end": 10.808,
      "text": "For over a century, astronomers warned the Milky Way would inevitably smash into the Andromeda Galaxy.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "M31, the Andromeda Galaxy, Killarney Provincial Park Observatory.jpg",
        "credit": "Brucewaters",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:M31,_the_Andromeda_Galaxy,_Killarney_Provincial_Park_Observatory.jpg"
      },
      "shots": [
        {
          "start": 4.1,
          "end": 7.667,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 7.667,
          "end": 10.8,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.808,
      "end": 16.428,
      "text": "Andromeda is currently hurtling toward us at one hundred and ten kilometers per second.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist\u2019s impression of the Milky Way.jpg",
        "credit": "NASA/JPL-Caltech/ESO/R. Hurt",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%E2%80%99s_impression_of_the_Milky_Way.jpg"
      },
      "shots": [
        {
          "start": 10.8,
          "end": 13.7,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 13.7,
          "end": 16.433,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.428,
      "end": 23.748,
      "text": "A 2025 study led by Till Sawala used up to one hundred thousand simulations to test this fate.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 16.433,
          "end": 23.733,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.748,
      "end": 30.418,
      "text": "It turns out the Large Magellanic Cloud acts like a cosmic bodyguard, pulling us off the impact course.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "LMC full color (Large Magellanic Cloud).jpg",
        "credit": "Harel Boren",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:LMC_full_color_(Large_Magellanic_Cloud).jpg"
      },
      "shots": [
        {
          "start": 23.733,
          "end": 26.767,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 26.767,
          "end": 30.433,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 30.418,
      "end": 36.418,
      "text": "Data from the Hubble and Gaia telescopes now show only a fifty percent chance of merging.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist's impression of the Gaia-ESO Survey (mpa-eso).tiff",
        "credit": "ESA/ESO",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%27s_impression_of_the_Gaia-ESO_Survey_(mpa-eso).tiff"
      },
      "shots": [
        {
          "start": 30.433,
          "end": 34.033,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 34.033,
          "end": 36.433,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 36.418,
      "end": 42.513,
      "text": "The chance of a head-on collision in five billion years is now estimated at just two percent.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 36.433,
          "end": 42.5,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 42.513,
      "end": 47.273,
      "text": "New calculations suggest the famous galactic crash is far from certain.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Andromeda Collides Milky Way.jpg",
        "credit": "NASA; ESA; Z. Levay and R. van der Marel, STScI; T. Hallas; and A. Mellinger",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Andromeda_Collides_Milky_Way.jpg"
      },
      "shots": [
        {
          "start": 42.5,
          "end": 47.633,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
