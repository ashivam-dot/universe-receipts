{
  "id": "ep351",
  "duration": 30.626,
  "beats": [
    {
      "start": 0.08,
      "end": 3.32,
      "text": "A blind space probe navigated millions of miles alone.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Deep Space 1 using its ion engine.jpg",
        "credit": "Unknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Deep_Space_1_using_its_ion_engine.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.333,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.32,
      "end": 7.16,
      "text": "NASA launched the experimental $150 million mission to test new tech.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 3.333,
          "end": 7.167,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.16,
      "end": 10.78,
      "text": "It became the first spacecraft powered entirely by an ion engine.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Ion Engine Test Firing - GPN-2000-000482.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Ion_Engine_Test_Firing_-_GPN-2000-000482.jpg"
      },
      "shots": [
        {
          "start": 7.167,
          "end": 10.767,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.78,
      "end": 14.72,
      "text": "Then its primary star tracker navigation system failed completely.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 10.767,
          "end": 14.733,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.72,
      "end": 18.36,
      "text": "Engineers urgently reprogrammed the science camera to act as its eye.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Small Asteroids and Comets Visited by Spacecraft.jpg",
        "credit": "Montage by Emily Lakdawalla for The Planetary Society. Data from NASA / JPL / JHUAPL / SwRI / UMD / JAXA / ESA / OSIRIS team / Russian Academy of Sciences / China National Space Agency. Processed by E",
        "license": "CC BY 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:Small_Asteroids_and_Comets_Visited_by_Spacecraft.jpg"
      },
      "shots": [
        {
          "start": 14.733,
          "end": 18.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.36,
      "end": 21.78,
      "text": "This makeshift eye guided it to a comet flyby years later.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "DeepSpace1encounter9969Braille.png",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:DeepSpace1encounter9969Braille.png"
      },
      "shots": [
        {
          "start": 18.367,
          "end": 21.767,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.78,
      "end": 26.6,
      "text": "Its ion engine ran for 16,265 hours in space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Deep Space 1 lifted.jpg",
        "credit": "Unknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Deep_Space_1_lifted.jpg"
      },
      "shots": [
        {
          "start": 21.767,
          "end": 23.467,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 23.467,
          "end": 26.6,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
