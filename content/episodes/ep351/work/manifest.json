  "beats": [
    {
      "start": 0.08,
      "end": 4.02,
      "text": "A blind space probe navigated millions of miles alone.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Deep Space 1 using its ion engine.jpg",
        "credit": "Unknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Deep_Space_1_using_its_ion_engine.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.033,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.02,
      "end": 7.1,
      "text": "NASA launched Deep Space 1 to test risky new technology.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Deep Space 1 Launch.png",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Deep_Space_1_Launch.png"
      },
      "shots": [
        {
          "start": 4.033,
          "end": 5.333,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 5.333,
          "end": 7.1,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.1,
      "end": 10.12,
      "text": "It used the first AI to control a ship without humans.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 7.1,
          "end": 10.133,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.12,
      "end": 13.82,
      "text": "A glowing ion engine pushed the craft using xenon gas.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Ion Engine Test Firing - GPN-2000-000482.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Ion_Engine_Test_Firing_-_GPN-2000-000482.jpg"
      },
      "shots": [
        {
          "start": 10.133,
          "end": 12.0,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 12.0,
          "end": 13.833,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.82,
      "end": 17.86,
      "text": "Suddenly its navigation system failed, leaving the probe totally blind.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Deep Space 1 98pc1190.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Deep_Space_1_98pc1190.jpg"
      },
      "shots": [
        {
          "start": 13.833,
          "end": 17.867,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.86,
      "end": 21.26,
      "text": "Engineers reprogrammed the science camera to act as a new eye.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Deep Space 1 lifted.jpg",
        "credit": "Unknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Deep_Space_1_lifted.jpg"
      },
      "shots": [
        {
          "start": 17.867,
          "end": 19.567,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 19.567,
          "end": 21.267,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.26,
      "end": 25.12,
      "text": "The hack worked, letting it capture the clearest comet photos in history.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "JpegPIA13576.jpg",
        "credit": "NASA/JPL-Caltech/UMD",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:JpegPIA13576.jpg"
      },
      "shots": [
        {
          "start": 21.267,
          "end": 23.1,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 23.1,
          "end": 25.133,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.12,
      "end": 28.82,
      "text": "Its engine fired for a record 16,000 hours in deep space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Deep Space 1 98pc1188.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
