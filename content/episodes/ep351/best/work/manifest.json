{
  "id": "ep351",
  "duration": 29.316,
  "beats": [
    {
      "start": 0.08,
      "end": 3.52,
      "text": "A blind space probe navigated millions of miles alone.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Deep Space 1 using its ion engine.jpg",
        "credit": "Unknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Deep_Space_1_using_its_ion_engine.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.533,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.52,
      "end": 7.48,
      "text": "NASA launched the experimental $150 million mission to test new tech.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 3.533,
          "end": 7.467,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.48,
      "end": 11.26,
      "text": "It became the first spacecraft powered entirely by an ion engine.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Ion Engine Test Firing - GPN-2000-000482.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Ion_Engine_Test_Firing_-_GPN-2000-000482.jpg"
      },
      "shots": [
        {
          "start": 7.467,
          "end": 11.267,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.26,
      "end": 15.48,
      "text": "Then its primary star tracker navigation system failed completely.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 11.267,
          "end": 15.467,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.48,
      "end": 18.98,
      "text": "Engineers urgently reprogrammed the science camera to act as its eye.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Small Bodies (15416177797).png",
        "credit": "geckzilla",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Small_Bodies_(15416177797).png"
      },
      "shots": [
        {
          "start": 15.467,
          "end": 18.967,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.98,
      "end": 21.46,
      "text": "The clever hack worked to keep the craft on course.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA01344.jpg",
        "credit": "NASA/JPL-Caltech/UMD",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA01344.jpg"
      },
      "shots": [
        {
          "start": 18.967,
          "end": 21.467,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.46,
      "end": 25.76,
      "text": "Its ion engine ran for 16,265 hours in space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA01344.jpg",
        "credit": "NASA/JPL-Caltech/UMD",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA01344.jpg"
      },
      "shots": [
        {
          "start": 21.467,
          "end": 25.767,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.76,
      "end": 28.966,
      "text": "A blinded machine navigated millions of miles alone.",
