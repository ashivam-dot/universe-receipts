{
  "id": "ep513",
  "duration": 32.378,
  "beats": [
    {
      "start": 0.08,
      "end": 4.04,
      "text": "Astronauts spotted a giant eye staring back from the Sahara.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Eye of the Sahara (49141999011).png",
        "credit": "SentinelHub",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Eye_of_the_Sahara_(49141999011).png"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.033,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.04,
      "end": 8.34,
      "text": "Gemini crews used the 25-mile circular rings as a navigation landmark.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Richat Structure from Gemini IV.jpg",
        "credit": "NASA/Gemini 4",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Richat_Structure_from_Gemini_IV.jpg"
      },
      "shots": [
        {
          "start": 4.033,
          "end": 6.867,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 6.867,
          "end": 8.333,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.34,
      "end": 11.72,
      "text": "Scientists first thought a giant meteor smashed the African desert.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 8.333,
          "end": 11.733,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.72,
      "end": 15.14,
      "text": "But geological surveys found zero evidence of a cosmic impact.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 11.733,
          "end": 15.133,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.14,
      "end": 18.98,
      "text": "Instead, underground magma pushed Earth's crust upward into a dome.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Richat structure cropped.png",
        "credit": "Liu, X.-Y.; Li, A.-B.; Chen, H.; Men, Y.-Q.; Huang, Y.-L",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Richat_structure_cropped.png"
      },
      "shots": [
        {
          "start": 15.133,
          "end": 18.967,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.98,
      "end": 22.1,
      "text": "Wind and water carved away softer rock over millions of years.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Upper Antelope Canyon - Page, AZ (9645592494).jpg",
        "credit": "Gregory \"Slobirdr\" Smith",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Upper_Antelope_Canyon_-_Page,_AZ_(9645592494).jpg"
      },
      "shots": [
        {
          "start": 18.967,
          "end": 22.1,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.1,
      "end": 25.34,
      "text": "Leaving high concentric ridges of hard rock behind.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Richat Structure - SRTM.jpg",
        "credit": "NASA/JPL/NIMA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Richat_Structure_-_SRTM.jpg"
      },
      "shots": [
        {
          "start": 22.1,
          "end": 23.567,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 23.567,
          "end": 25.333,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.34,
      "end": 28.66,
      "text": "Fringe theories claimed the matching rings were Plato's lost Atlantis.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Plato Silanio Louvre Ma3654.jpg",
        "credit": "Copy of Silanion (?)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Plato_Silanio_Louvre_Ma3654.jpg"
      },
      "shots": [
        {
          "start": 25.333,
          "end": 28.667,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 28.66,
      "end": 32.028,
      "text": "But no ancient city ever built what astronauts saw from space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Eye of the Sahara (49141999011).png",
        "credit": "SentinelHub",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Eye_of_the_Sahara_(49141999011).png"
      },
      "shots": [
        {
          "start": 28.667,
          "end": 32.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
