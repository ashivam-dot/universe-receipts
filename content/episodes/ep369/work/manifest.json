{
  "id": "ep369",
  "duration": 29.592,
  "beats": [
    {
      "start": 0.08,
      "end": 3.8,
      "text": "Three astronauts were suffocating inside a dying moon lander.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Apollo 13 Lunar Module.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Apollo_13_Lunar_Module.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.8,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.8,
      "end": 6.9,
      "text": "It was like their spacecraft's lungs were slowly clogging up.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Apollo 13 crew inside lunar module.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Apollo_13_crew_inside_lunar_module.jpg"
      },
      "shots": [
        {
          "start": 3.8,
          "end": 6.9,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.9,
      "end": 11.3,
      "text": "Poison gas spiked because Jim Lovell's crew crowded a two-man ship.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Fred Haise (left), Jack Swigert, and Jim Lovell pose on the day before launch.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Fred_Haise_(left),_Jack_Swigert,_and_Jim_Lovell_pose_on_the_day_before_launch.jpg"
      },
      "shots": [
        {
          "start": 6.9,
          "end": 9.1,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 9.1,
          "end": 11.3,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.3,
      "end": 14.78,
      "text": "The Command Module had square filters, but the Lander's holes were round.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Apollo Command Module CO2 Scrubber (49772097492).jpg",
        "credit": "jurvetson",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Apollo_Command_Module_CO2_Scrubber_(49772097492).jpg"
      },
      "shots": [
        {
          "start": 11.3,
          "end": 14.767,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.78,
      "end": 19.44,
      "text": "They were stranded 200,000 miles from Earth with zero spare parts.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 14.767,
          "end": 19.433,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.44,
      "end": 23.26,
      "text": "Mission Control engineers built a fix using manuals and duct tape.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Apollo 13 Mailbox at Mission Control.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Apollo_13_Mailbox_at_Mission_Control.jpg"
      },
      "shots": [
        {
          "start": 19.433,
          "end": 21.533,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 21.533,
          "end": 23.267,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.26,
      "end": 26.4,
      "text": "This 'mailbox' made of manuals and plastic saved their lives.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Interior view of \"mail box\" for purging carbon dioxide from Lunar Module (as13-62-8929).jpg",
        "credit": "NASA Johnson Space Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Interior_view_of_%22mail_box%22_for_purging_carbon_dioxide_from_Lunar_Module_(as13-62-8929).jpg"
      },
      "shots": [
        {
          "start": 23.267,
          "end": 24.833,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 24.833,
          "end": 26.4,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 26.4,
      "end": 29.242,
      "text": "It's the only reason those three astronauts didn't end up suffocating.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Apollo 13 Lunar Module.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Apollo_13_Lunar_Module.jpg"
      },
      "shots": [
        {
          "start": 26.4,
          "end": 29.6,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
