{
  "id": "ep372",
  "duration": 31.893,
  "beats": [
    {
      "start": 0.08,
      "end": 3.42,
      "text": "A frozen world takes 11,000 years to orbit our Sun.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist's conception of Sedna.jpg",
        "credit": "NASA/JPL-Caltech/R. Hurt (SSC-Caltech)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%27s_conception_of_Sedna.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.42,
      "end": 6.88,
      "text": "Most astronomers assumed Neptune's gravity controlled everything out there.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Solar System- EIC Display (SVS5674 - 4).jpg",
        "credit": "NASA's Scientific Visualization Studio - Science and Technology Corporation/Kel Elkins",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Solar_System-_EIC_Display_(SVS5674_-_4).jpg"
      },
      "shots": [
        {
          "start": 3.433,
          "end": 6.867,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.88,
      "end": 10.02,
      "text": "But dwarf planet Sedna never comes close to Neptune.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "\u201cFar Out\u201d Dwarf Planet Discovered (noaoann18024a).jpg",
        "credit": "R. M. Candanosa &Carnegie Institution for Science",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:%E2%80%9CFar_Out%E2%80%9D_Dwarf_Planet_Discovered_(noaoann18024a).jpg"
      },
      "shots": [
        {
          "start": 6.867,
          "end": 10.033,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.02,
      "end": 13.64,
      "text": "At its farthest point, it swings 900 astronomical units away.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Sedna-PIA05569-crop.jpg",
        "credit": "NASA/Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Sedna-PIA05569-crop.jpg"
      },
      "shots": [
        {
          "start": 10.033,
          "end": 13.633,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.64,
      "end": 18.18,
      "text": "Tholin hydrocarbon sludge gives its thousand-kilometer surface a deep red glow.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Sedna mystery deepens as Hubble offers best look at farthest planetoid (artist's impression) (opo0414e).jpg",
        "credit": "NASA, ESA and Adolf Schaller",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Sedna_mystery_deepens_as_Hubble_offers_best_look_at_farthest_planetoid_(artist%27s_impression)_(opo0414e).jpg"
      },
      "shots": [
        {
          "start": 13.633,
          "end": 15.9,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 15.9,
          "end": 18.167,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.18,
      "end": 21.2,
      "text": "Hubble proved it rotates every 10 hours with no moon nearby.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Sedna mystery deepens as Hubble offers best look at farthest planetoid (opo0414a).jpg",
        "credit": "NASA, ESA and M. Brown (Caltech)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Sedna_mystery_deepens_as_Hubble_offers_best_look_at_farthest_planetoid_(opo0414a).jpg"
      },
      "shots": [
        {
          "start": 18.167,
          "end": 20.067,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 20.067,
          "end": 21.2,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.2,
      "end": 24.26,
      "text": "Neptune couldn't drag it into this extreme, oval path.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Sedna Discovery (geminiann05005c).tiff",
        "credit": "International Gemini Observatory/NOIRLab/NSF/AURA",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Sedna_Discovery_(geminiann05005c).tiff"
      },
      "shots": [
        {
          "start": 21.2,
          "end": 24.267,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.26,
      "end": 27.44,
      "text": "A passing star or an unseen Planet Nine pulled it away.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Planet Nine - transparent background.png",
        "credit": "nagualdesign",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Planet_Nine_-_transparent_background.png"
      },
      "shots": [
        {
          "start": 24.267,
          "end": 27.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 27.44,
      "end": 31.543,
      "text": "That left this red world on an 11,000-year journey around our Sun.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist's conception of Sedna.jpg",
        "credit": "NASA/JPL-Caltech/R. Hurt (SSC-Caltech)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%27s_conception_of_Sedna.jpg"
      },
      "shots": [
        {
          "start": 27.433,
          "end": 31.9,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
