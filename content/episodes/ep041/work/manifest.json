{
  "id": "ep041",
  "duration": 48.063,
  "beats": [
    {
      "start": 0.08,
      "end": 3.977,
      "text": "Exposed to the vacuum of space, your body does not explode.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Vacuum chamber-being opened by engineer.jpeg",
        "credit": "NASA JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Vacuum_chamber-being_opened_by_engineer.jpeg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.967,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.977,
      "end": 11.297,
      "text": "Popular movies love to show astronauts bursting like fragile balloons when their pressurized suits fail completely.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Extravehicular Mobility Unit (EMU) spacesuit at National Air and Space Museum.jpg",
        "credit": "Chrismofer",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Extravehicular_Mobility_Unit_(EMU)_spacesuit_at_National_Air_and_Space_Museum.jpg"
      },
      "shots": [
        {
          "start": 3.967,
          "end": 6.6,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 6.6,
          "end": 11.3,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.297,
      "end": 17.842,
      "text": "In December nineteen sixty-six, NASA test subject Jim LeBlanc tested this terrifying theory.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 11.3,
          "end": 17.833,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.842,
      "end": 23.812,
      "text": "His spacesuit hose accidentally detached inside a massive altitude vacuum chamber.",
      "asset": {
        "source": "Flickr via Openverse",
        "title": "Vacuum chamber",
        "credit": "AstroSamantha",
        "license": "CC BY 2.0",
        "url": "https://www.flickr.com/photos/65541944@N07/13759689764"
      },
      "shots": [
        {
          "start": 17.833,
          "end": 23.8,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.812,
      "end": 30.482,
      "text": "LeBlanc remained conscious for about fourteen seconds before severe hypoxia completely set in.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 23.8,
          "end": 30.467,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 30.482,
      "end": 36.607,
      "text": "His very last conscious memory was feeling the warm saliva on his tongue start to bubble.",
      "asset": {
        "source": "Flickr via Openverse",
        "title": "Vacuum chamber",
        "credit": "AstroSamantha",
        "license": "CC BY 2.0",
        "url": "https://www.flickr.com/photos/65541944@N07/13759689764"
      },
      "shots": [
        {
          "start": 30.467,
          "end": 36.6,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 36.607,
      "end": 42.477,
      "text": "A quick colleague entered the chamber within twenty-five seconds to provide emergency oxygen.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Extravehicular Mobility Unit (EMU) spacesuit at National Air and Space Museum.jpg",
        "credit": "Chrismofer",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Extravehicular_Mobility_Unit_(EMU)_spacesuit_at_National_Air_and_Space_Museum.jpg"
      },
      "shots": [
        {
          "start": 36.6,
          "end": 42.467,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 42.477,
      "end": 47.713,
      "text": "Human skin is remarkably elastic enough to prove that your body does not explode.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Vacuum chamber-being opened by engineer.jpeg",
        "credit": "NASA JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Vacuum_chamber-being_opened_by_engineer.jpeg"
      },
      "shots": [
        {
          "start": 42.467,
          "end": 48.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
