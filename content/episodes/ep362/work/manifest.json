{
  "id": "ep362",
  "duration": 30.02,
  "beats": [
    {
      "start": 0.08,
      "end": 3.94,
      "text": "A dead star struck Earth from 20,000 light-years away.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist\u2019s impression of the magnetar in the star cluster Westerlund 1.jpg",
        "credit": "ESO/L. Cal\u00e7ada",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%E2%80%99s_impression_of_the_magnetar_in_the_star_cluster_Westerlund_1.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.94,
      "end": 8.64,
      "text": "Spacecraft detectors across our solar system were suddenly blinded in August 1998.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "GPS Satellite NASA art-iif.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:GPS_Satellite_NASA_art-iif.jpg"
      },
      "shots": [
        {
          "start": 3.933,
          "end": 8.633,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.64,
      "end": 13.26,
      "text": "NASA's Rossi satellite was flooded by an invisible, pulsating gamma-ray wave.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "RXTE preparations.jpg",
        "credit": "Unknown authorUnknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:RXTE_preparations.jpg"
      },
      "shots": [
        {
          "start": 8.633,
          "end": 10.367,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 10.367,
          "end": 13.267,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.26,
      "end": 18.82,
      "text": "The signal flashed every 5.16 seconds from a magnetar called SGR 1900+14.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Nuclear explosions on pulsar surface help determine spin rate.jpg",
        "credit": "Dana Berry/NASA Goddard Space Flight Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Nuclear_explosions_on_pulsar_surface_help_determine_spin_rate.jpg"
      },
      "shots": [
        {
          "start": 13.267,
          "end": 18.833,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.82,
      "end": 23.04,
      "text": "Its magnetic field is trillions of times stronger than Earth's entire field.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "SGR 1806-20 108536main NeutronStar-Print1.jpg",
        "credit": "NASA/Goddard Space Flight Center Conceptual Image Lab",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:SGR_1806-20_108536main_NeutronStar-Print1.jpg"
      },
      "shots": [
        {
          "start": 18.833,
          "end": 20.733,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 20.733,
          "end": 23.033,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.04,
      "end": 26.32,
      "text": "Spitzer captured a seven light-year ring of glowing dust left behind.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "SIRTF and the Milky Way, an Artist's Concept.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:SIRTF_and_the_Milky_Way,_an_Artist%27s_Concept.jpg"
      },
      "shots": [
        {
          "start": 23.033,
          "end": 26.333,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 26.32,
      "end": 29.67,
      "text": "The blast was powerful enough to physically alter Earth's atmosphere.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist\u2019s impression of the magnetar in the star cluster Westerlund 1.jpg",
        "credit": "ESO/L. Cal\u00e7ada",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%E2%80%99s_impression_of_the_magnetar_in_the_star_cluster_Westerlund_1.jpg"
      },
      "shots": [
        {
          "start": 26.333,
          "end": 30.033,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
