{
  "id": "ep362",
  "duration": 28.283,
  "beats": [
    {
      "start": 0.08,
      "end": 3.72,
      "text": "A dead star 20,000 light-years away just screamed at us.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Magnetar (artist\u2019s impression) (heic2504a).tiff",
        "credit": "ESA",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Magnetar_(artist%E2%80%99s_impression)_(heic2504a).tiff"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.733,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.72,
      "end": 7.56,
      "text": "This magnetar has a magnetic field trillions of times stronger than Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The Hibernating Stellar Magnet (artist's impression).jpg",
        "credit": "ESO/L.Cal\u00e7ada",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:The_Hibernating_Stellar_Magnet_(artist%27s_impression).jpg"
      },
      "shots": [
        {
          "start": 3.733,
          "end": 7.567,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.56,
      "end": 11.74,
      "text": "The star's crust shattered in a massive explosion during August 1998.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Moving heart of the Crab Nebula.jpg",
        "credit": "NASA, ESA",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Moving_heart_of_the_Crab_Nebula.jpg"
      },
      "shots": [
        {
          "start": 7.567,
          "end": 11.733,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.74,
      "end": 16.18,
      "text": "The blast was so violent it overwhelmed satellite detectors across our solar system.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Soyuz TMA-16 approaching ISS.jpg",
        "credit": "Expedition 20 Crew, NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Soyuz_TMA-16_approaching_ISS.jpg"
      },
      "shots": [
        {
          "start": 11.733,
          "end": 13.433,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 13.433,
          "end": 16.167,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.18,
      "end": 20.28,
      "text": "This eruption created a pulsating tail, spinning every 5.16 seconds.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NASA-JAXA XRISM Mission Sees Pulsar Accreting Companion's 'Wind' (SVS15099 - GX 301-2 spectrum large).jpg",
        "credit": "NASA's Scientific Visualization Studio - NASA\u2019s Goddard Space Flight Center, JAXA/NASA, Rahin et al. 2026Alt text: XRISM Resolve absorption spectrum of BP Crucis Image description: A light-blue line w",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:NASA-JAXA_XRISM_Mission_Sees_Pulsar_Accreting_Companion%27s_%27Wind%27_(SVS15099_-_GX_301-2_spectrum_large).jpg"
      },
      "shots": [
        {
          "start": 16.167,
          "end": 20.267,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.28,
      "end": 23.84,
      "text": "Years later, Spitzer captured a mysterious seven light-year ring of fire.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The (Almost) Invisible Aftermath of a Massive Star's Death.jpg",
        "credit": "NASA/JPL-Caltech/P. Morris (Caltech/NASA Herschel Science Center)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:The_(Almost)_Invisible_Aftermath_of_a_Massive_Star%27s_Death.jpg"
      },
      "shots": [
        {
          "start": 20.267,
          "end": 22.067,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 22.067,
          "end": 23.833,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.84,
      "end": 27.933,
      "text": "The entire galaxy heard that dead star scream from 20,000 light-years away.",
