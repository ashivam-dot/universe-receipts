{
  "id": "ep271",
  "duration": 32.424,
  "beats": [
    {
      "start": 0.08,
      "end": 3.8,
      "text": "A giant asteroid once snuck inside the Moon's orbit.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NASA's Swift Satellite Captures Asteroid 2005 YU55 Flyby.jpg",
        "credit": "NASA/Swift/Stefan Immler and DSS",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:NASA%27s_Swift_Satellite_Captures_Asteroid_2005_YU55_Flyby.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.8,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.8,
      "end": 7.12,
      "text": "This massive rock was originally flagged as a threat to Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Asteroidsscale.jpg",
        "credit": "NASA/JPL-Caltech/JAXA/ESA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Asteroidsscale.jpg"
      },
      "shots": [
        {
          "start": 3.8,
          "end": 7.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.12,
      "end": 10.5,
      "text": "Astronomers fired radar beams from Puerto Rico to calculate its path.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Arecibo Observatory Aerial View.jpg",
        "credit": "H. Schweiker/WIYN and NOAO/AURA/NSF",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Arecibo_Observatory_Aerial_View.jpg"
      },
      "shots": [
        {
          "start": 7.133,
          "end": 10.5,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.5,
      "end": 13.68,
      "text": "Those signals removed the asteroid from NASA's impact list.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NASA HQ Building.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:NASA_HQ_Building.jpg"
      },
      "shots": [
        {
          "start": 10.5,
          "end": 13.667,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.68,
      "end": 17.08,
      "text": "But the radar data revealed a bigger surprise.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "ASTEROIDE 2013 TV135.jpg",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:ASTEROIDE_2013_TV135.jpg"
      },
      "shots": [
        {
          "start": 13.667,
          "end": 17.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.08,
      "end": 19.84,
      "text": "The rock was actually twice as large as everyone thought.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Asteroid20100429-full.jpg",
        "credit": "NASA/Cornell/Arecibo",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Asteroid20100429-full.jpg"
      },
      "shots": [
        {
          "start": 17.067,
          "end": 19.833,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.84,
      "end": 23.86,
      "text": "It stretched 1,300 feet across, larger than an aircraft carrier.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Asteroid20100429-full.jpg",
        "credit": "NASA/Cornell/Arecibo",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Asteroid20100429-full.jpg"
      },
      "shots": [
        {
          "start": 19.833,
          "end": 23.867,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.86,
      "end": 27.12,
      "text": "This dark visitor reached its closest point in November 2011.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Released to Public Earth by NASA (NASA, GPN-2000-001437) (241635550).jpg",
        "credit": "pingnews.com",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Released_to_Public_Earth_by_NASA_(NASA,_GPN-2000-001437)_(241635550).jpg"
      },
      "shots": [
        {
          "start": 23.867,
          "end": 27.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 27.12,
      "end": 30.38,
      "text": "It was the nearest pass by a giant in decades.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Released to Public Earth by NASA (NASA, GPN-2000-001437) (241635550).jpg",
        "credit": "pingnews.com",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Released_to_Public_Earth_by_NASA_(NASA,_GPN-2000-001437)_(241635550).jpg"
      },
      "shots": [
        {
          "start": 27.133,
          "end": 30.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 30.38,
      "end": 32.074,
      "text": "It was a massive near miss.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NASA's Swift Satellite Captures Asteroid 2005 YU55 Flyby.jpg",
        "credit": "NASA/Swift/Stefan Immler and DSS",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:NASA%27s_Swift_Satellite_Captures_Asteroid_2005_YU55_Flyby.jpg"
      },
      "shots": [
        {
          "start": 30.367,
          "end": 32.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
