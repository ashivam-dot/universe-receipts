  "beats": [
    {
      "start": 0.08,
      "end": 4.048,
      "text": "You can see one impossible galaxy through the gap of another.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hoag's object.jpg",
        "credit": "NASA and The Hubble Heritage Team (STScI/AURA); Acknowledgment: Ray A. Lucas (STScI/AURA)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Hoag%27s_object.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.033,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.048,
      "end": 11.068,
      "text": "In 1950, Arthur Hoag found a blue smoke ring around a golden core in the [Serpens](/s\u02cc\u025c\u0279p\u02c8\u025bnts/) constellation.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Serpens Caput (Annotated) (serpens-caput-ann).jpg",
        "credit": "E. Slawik/NOIRLab/NSF/AURA/M. Zamani",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Serpens_Caput_(Annotated)_(serpens-caput-ann).jpg"
      },
      "shots": [
        {
          "start": 4.033,
          "end": 6.767,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 6.767,
          "end": 11.067,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.068,
      "end": 16.988,
      "text": "Hoag first thought this bizarre structure was a simple planetary nebula or a gas cloud.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Ring Nebula.jpg",
        "credit": "The Hubble Heritage Team (AURA/STScI/NASA)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Ring_Nebula.jpg"
      },
      "shots": [
        {
          "start": 11.067,
          "end": 17.0,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.988,
      "end": 22.533,
      "text": "He even guessed it was an optical illusion caused by gravity bending distant light.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Gravitational Lensing (heic9910c).tiff",
        "credit": "NASA, ESA, Andrew Fruchter (STScI), and the ERO team (STScI + ST-ECF \n\n)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Gravitational_Lensing_(heic9910c).tiff"
      },
      "shots": [
        {
          "start": 17.0,
          "end": 20.267,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 20.267,
          "end": 22.533,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.533,
      "end": 29.328,
      "text": "But Hoag's Object is a real galaxy, six hundred million light-years away and wider than the Milky Way.",
      "asset": {
        "source": "Flickr via Openverse",
        "title": "Galaxy - Irregular (Hoag's object)",
        "credit": "Marc Van Norden",
        "license": "CC BY 2.0",
        "url": "https://www.flickr.com/photos/74903905@N00/8275040365"
      },
      "shots": [
        {
          "start": 22.533,
          "end": 29.333,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 29.328,
      "end": 34.823,
      "text": "Most ring galaxies form from violent collisions, yet no crash site exists here.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 29.333,
          "end": 34.833,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 34.823,
      "end": 40.543,
      "text": "Peering through the dark gap at the one o\u2019clock position reveals a one-in-a-million photobomb.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hoags Object.jpg",
        "credit": "R. Lucas (STScI/AURA), Hubble Heritage Team, NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Hoags_Object.jpg"
      },
      "shots": [
        {
          "start": 34.833,
          "end": 40.533,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 40.543,
      "end": 46.143,
      "text": "Deep in the background sits another ring galaxy perfectly aligned with the first.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hoags Object.jpg",
        "credit": "R. Lucas (STScI/AURA), Hubble Heritage Team, NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Hoags_Object.jpg"
      },
      "shots": [
        {
          "start": 40.533,
          "end": 46.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 46.143,
      "end": 51.274,
      "text": "It is the only place where you can see one impossible galaxy through the gap of another.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hoag's object.jpg",
        "credit": "NASA and The Hubble Heritage Team (STScI/AURA); Acknowledgment: Ray A. Lucas (STScI/AURA)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Hoag%27s_object.jpg"
      },
      "shots": [
        {
          "start": 46.133,
          "end": 51.633,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
