    {
      "start": 23.205,
      "end": 29.625,
      "text": "Night skies across Europe and Asia glowed for days due to high-altitude dust and ice particles.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Noctilucent clouds in Tuntorp, Brastad.jpg",
        "credit": "W.carter",
        "license": "CC BY 4.0",
