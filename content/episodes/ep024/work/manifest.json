    },
    {
      "start": 5.045,
      "end": 11.565,
      "text": "On the morning of June thirty, nineteen hundred and eight, a blinding flash lit the skies over Siberia.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 5.033,
          "end": 11.567,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.565,
      "end": 16.735,
      "text": "The cataclysm destroyed forest across two thousand one hundred square kilometers.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 11.567,
          "end": 16.733,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.735,
      "end": 23.205,
      "text": "Seismic stations across Eurasia detected air waves far away in Europe and the United States.",
      "asset": {
        "source": "Wikimedia Commons",
