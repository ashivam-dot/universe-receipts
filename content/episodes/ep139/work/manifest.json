  "beats": [
    {
      "start": 0.08,
      "end": 5.018,
      "text": "An explosion shone twenty times brighter than our entire Milky Way galaxy.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist's illustration of Supernova 1987A (eso1401b).jpg",
        "credit": "ALMA (ESO/NAOJ/NRAO)/Alexandra Angelich (NRAO/AUI/NSF)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%27s_illustration_of_Supernova_1987A_(eso1401b).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 1.833,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 1.833,
          "end": 5.033,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 5.018,
      "end": 15.013,
      "text": "In June 2015, twin automated telescopes located in Chile discovered ASASSN-15lh blazing brilliantly across the dark night sky.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 5.033,
          "end": 15.0,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.013,
      "end": 21.608,
      "text": "The incredible event reached a peak brightness 570 billion times greater than our Sun.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "SN 2006gy, NASA illustration.jpg",
        "credit": "Credit: NASA/CXC/M.Weiss",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:SN_2006gy,_NASA_illustration.jpg"
      },
      "shots": [
        {
          "start": 15.0,
          "end": 18.067,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 18.067,
          "end": 21.6,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.608,
      "end": 29.378,
      "text": "Located roughly 3.8 billion light-years away, its strange spectrum completely lacked hydrogen and helium lines.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Sutherland observatory, Sutherland, Northern Cape, South Africa (20351441429).jpg",
        "credit": "South African Tourism from South Africa",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Sutherland_observatory,_Sutherland,_Northern_Cape,_South_Africa_(20351441429).jpg"
      },
      "shots": [
        {
          "start": 21.6,
          "end": 26.7,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 26.7,
          "end": 29.367,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 29.378,
      "end": 37.073,
      "text": "Unlike typical blasts in small dwarf galaxies, this mysterious explosion erupted inside a massive galaxy.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hubble NGC1792.jpg",
        "credit": "ESA/Hubble & NASA, D. Thilker, F. Belfiore, J. Lee and the PHANGS-HST Team",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Hubble_NGC1792.jpg"
      },
      "shots": [
        {
          "start": 29.367,
          "end": 33.2,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 33.2,
          "end": 37.067,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 37.073,
      "end": 44.323,
      "text": "Astronomers actively debate whether it was powered by a fast-spinning magnetar or a supermassive black hole.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist\u2019s impression of the magnetar in the star cluster Westerlund 1.jpg",
        "credit": "ESO/L. Cal\u00e7ada",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%E2%80%99s_impression_of_the_magnetar_in_the_star_cluster_Westerlund_1.jpg"
      },
      "shots": [
        {
          "start": 37.067,
          "end": 40.2,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 40.2,
          "end": 44.333,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 44.323,
      "end": 49.791,
      "text": "That is why an explosion shone twenty times brighter than our entire Milky Way galaxy.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist's illustration of Supernova 1987A (eso1401b).jpg",
        "credit": "ALMA (ESO/NAOJ/NRAO)/Alexandra Angelich (NRAO/AUI/NSF)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%27s_illustration_of_Supernova_1987A_(eso1401b).jpg"
      },
      "shots": [
        {
