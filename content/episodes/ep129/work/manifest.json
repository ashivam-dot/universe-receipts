{
  "id": "ep129",
  "duration": 54.236,
  "beats": [
    {
      "start": 0.08,
      "end": 5.178,
      "text": "Astronomers built a massive deep-space telescope pointed straight down through Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Amundsen-Scott marsstation ray h edit.jpg",
        "credit": "Photo by Chris Danals, National Science Foundation",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Amundsen-Scott_marsstation_ray_h_edit.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.167,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 2.167,
          "end": 5.167,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 5.178,
      "end": 11.573,
      "text": "Beneath the South Pole, researchers turned a cubic kilometer of ice into the IceCube observatory.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Icecube-architecture-diagram2009.PNG",
        "credit": "Nasa-verve",
        "license": "CC BY 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:Icecube-architecture-diagram2009.PNG"
      },
      "shots": [
        {
          "start": 5.167,
          "end": 11.567,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.573,
      "end": 19.343,
      "text": "Hot-water drills melted holes 2,500 meters deep, freezing 5,000 optical sensors into the ice.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 11.567,
          "end": 19.333,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.343,
      "end": 25.988,
      "text": "Completed in 2010, the array captures neutrinos traveling in straight lines across the cosmos.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The ICL at Night.jpg",
        "credit": "John Hardin",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:The_ICL_at_Night.jpg"
      },
      "shots": [
        {
          "start": 19.333,
          "end": 23.433,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 23.433,
          "end": 26.0,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.988,
      "end": 31.633,
      "text": "Atmospheric cosmic rays swamp neutrino signals by roughly one million to one.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The ICL at Night.jpg",
        "credit": "John Hardin",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:The_ICL_at_Night.jpg"
      },
      "shots": [
        {
          "start": 26.0,
          "end": 31.633,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 31.633,
      "end": 36.553,
      "text": "To block that noise, IceCube uses the solid Earth as a physical shield.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Icecube-architecture-diagram2009.PNG",
        "credit": "Nasa-verve",
        "license": "CC BY 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:Icecube-architecture-diagram2009.PNG"
      },
      "shots": [
        {
          "start": 31.633,
          "end": 36.567,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 36.553,
      "end": 42.348,
      "text": "The detector tracks upward-traveling particles from neutrinos that passed entirely through Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Amundsen-Scott marsstation ray h edit.jpg",
        "credit": "Photo by Chris Danals, National Science Foundation",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Amundsen-Scott_marsstation_ray_h_edit.jpg"
      },
      "shots": [
        {
          "start": 36.567,
          "end": 42.333,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 42.348,
      "end": 49.873,
      "text": "In September 2017, it pinpointed a neutrino from a blazar 3.7 billion light-years away.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 42.333,
          "end": 49.867,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 49.873,
      "end": 53.886,
      "text": "To look into deep space, scientists had to aim straight through our planet.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Amundsen-Scott marsstation ray h edit.jpg",
        "credit": "Photo by Chris Danals, National Science Foundation",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Amundsen-Scott_marsstation_ray_h_edit.jpg"
      },
      "shots": [
        {
          "start": 49.867,
          "end": 54.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
