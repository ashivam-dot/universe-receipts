  "beats": [
    {
      "start": 0.08,
      "end": 4.546,
      "text": "President Bill Clinton went on television to announce a rock from Mars.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "WHPO-P00080 - DPLA - 5e17986b8be2cb45d5c8da877f26e91d (page 25).jpg",
        "credit": "President (1993-2001\u00a0: Clinton). White House Photograph Office. 1/20/1993-1/20/2001",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:WHPO-P00080_-_DPLA_-_5e17986b8be2cb45d5c8da877f26e91d_(page_25).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.033,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 3.033,
          "end": 4.533,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.546,
      "end": 14.141,
      "text": "In December 1984, meteorite hunters exploring the Allan Hills region of Antarctica discovered an unusual four-pound specimen.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 4.533,
          "end": 14.133,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.141,
      "end": 22.086,
      "text": "A colossal asteroid impact had blasted this ancient stone off the Martian surface around sixteen million years ago.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "White dwarf star system GD 61.jpg",
        "credit": "NASA, ESA, M.A. Garlick (space-art.co.uk), University of Warwick, and University of Cambridge.",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:White_dwarf_star_system_GD_61.jpg"
      },
      "shots": [
        {
          "start": 14.133,
          "end": 18.133,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 18.133,
          "end": 22.1,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.086,
      "end": 30.856,
      "text": "After drifting through the freezing vacuum of the solar system, the meteorite finally landed on Earth approximately thirteen thousand years ago.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 22.1,
          "end": 30.867,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 30.856,
      "end": 41.181,
      "text": "In 1996, NASA scientists announced the specimen contained microscopic structures measuring twenty to one hundred nanometers in diameter.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "ALH84001 structures.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:ALH84001_structures.jpg"
      },
      "shots": [
        {
          "start": 30.867,
          "end": 35.733,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 35.733,
          "end": 41.167,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 41.181,
      "end": 50.831,
      "text": "Though most researchers eventually rejected a biological origin, this remarkable Martian rock inspired that historic television address by the President.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "WHPO-P00080 - DPLA - 5e17986b8be2cb45d5c8da877f26e91d (page 25).jpg",
        "credit": "President (1993-2001\u00a0: Clinton). White House Photograph Office. 1/20/1993-1/20/2001",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:WHPO-P00080_-_DPLA_-_5e17986b8be2cb45d5c8da877f26e91d_(page_25).jpg"
      },
      "shots": [
        {
          "start": 41.167,
          "end": 51.167,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
