  "beats": [
    {
      "start": 0.08,
      "end": 4.379,
      "text": "A car-sized robot is climbing a mountain taller than Mount Everest.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "MSL Sol 3070 - MAHLI.jpg",
        "credit": "Kevin Gill",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:MSL_Sol_3070_-_MAHLI.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.2,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 2.2,
          "end": 4.367,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.379,
      "end": 10.299,
      "text": "This is [Aeolis](/\u02c8I\u02c8Ol\u02c8\u026as/) Mons, an enormous central peak rising inside Mars's Gale Crater.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Gale crater with Curiosity landing ellipse (PIA15687).jpg",
        "credit": "NASA/JPL-Caltech/ESA/DLR/FU Berlin/MSSS",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Gale_crater_with_Curiosity_landing_ellipse_(PIA15687).jpg"
      },
      "shots": [
        {
          "start": 4.367,
          "end": 7.333,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 7.333,
          "end": 10.3,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.299,
      "end": 16.394,
      "text": "At five point five kilometers tall, this Martian giant easily dwarfs Seattle's Mount Rainier.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mount Rainier at dawn from Seattle.png",
        "credit": "Ganesha811",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Mount_Rainier_at_dawn_from_Seattle.png"
      },
      "shots": [
        {
          "start": 10.3,
          "end": 13.333,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 13.333,
          "end": 16.4,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.394,
      "end": 21.589,
      "text": "In fact, its vertical rise from base to peak is greater than Mount Everest's.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mount Everest, Nepal, Himalayas.jpg",
        "credit": "Vyacheslav Argenberg",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Mount_Everest,_Nepal,_Himalayas.jpg"
      },
      "shots": [
        {
          "start": 16.4,
          "end": 19.0,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 19.0,
          "end": 21.6,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.589,
      "end": 28.484,
      "text": "This mountain consists of ancient sedimentary layers, eroded over billions of years by Martian winds.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Sol 1429 - Murray Butte (29011250842).png",
        "credit": "Justin Cowart",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Sol_1429_-_Murray_Butte_(29011250842).png"
      },
      "shots": [
        {
          "start": 21.6,
          "end": 24.333,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 24.333,
          "end": 28.5,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 28.484,
      "end": 35.404,
      "text": "In August 2012, NASA's car-sized Curiosity rover landed inside the wide crater basin.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Curiosity Touching Down, Artist's Concept.jpg",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Curiosity_Touching_Down,_Artist%27s_Concept.jpg"
      },
      "shots": [
        {
          "start": 28.5,
          "end": 31.5,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 31.5,
          "end": 35.4,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 35.404,
      "end": 43.049,
      "text": "Using its robotic drill, Curiosity discovered organic chemicals locked inside these ancient lakebed layers.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Camera on Curiosity's Robotic Arm.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Camera_on_Curiosity%27s_Robotic_Arm.jpg"
      },
      "shots": [
        {
          "start": 35.4,
          "end": 38.867,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 38.867,
          "end": 43.033,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 43.049,
      "end": 49.408,
      "text": "To investigate if Mars once supported life, this tireless, car-sized robot is still climbing.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "MSL Sol 3070 - MAHLI.jpg",
        "credit": "Kevin Gill",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:MSL_Sol_3070_-_MAHLI.jpg"
      },
      "shots": [
        {
          "start": 43.033,
          "end": 49.767,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
