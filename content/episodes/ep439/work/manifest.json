{
  "id": "ep439",
  "duration": 26.02,
  "beats": [
    {
      "start": 0.08,
      "end": 3.5,
      "text": "Voyager 2 found an Earth-sized storm on distant Neptune.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA01142.jpg",
        "credit": "NASA/Voyager 2 Team",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA01142.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 1.367,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 1.367,
          "end": 3.5,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.5,
      "end": 7.2,
      "text": "It was a massive anticyclone swirling in freezing darkness.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Neptune clouds.jpg",
        "credit": "NASA / Jet Propulsion Lab",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Neptune_clouds.jpg"
      },
      "shots": [
        {
          "start": 3.5,
          "end": 7.2,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.2,
      "end": 10.1,
      "text": "Neptune gets only three percent of the sunlight Jupiter receives.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA00046.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA00046.jpg"
      },
      "shots": [
        {
          "start": 7.2,
          "end": 10.1,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.1,
      "end": 13.26,
      "text": "Yet Voyager 2 imaged dark rings and unknown moons.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Neptune ring arcs.jpg",
        "credit": "NASA/Voyager 2 Team",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Neptune_ring_arcs.jpg"
      },
      "shots": [
        {
          "start": 10.1,
          "end": 13.267,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.26,
      "end": 16.6,
      "text": "It even caught active ice geysers erupting on Triton.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyager 2 Triton 14bg.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Voyager_2_Triton_14bg.jpg"
      },
      "shots": [
        {
          "start": 13.267,
          "end": 16.6,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.6,
      "end": 19.92,
      "text": "Astronomers pointed the Hubble Space Telescope at Neptune in 1994.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Deployment of the Hubble Space Telescope (28248653761).jpg",
        "credit": "NASA Hubble Space Telescope",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Deployment_of_the_Hubble_Space_Telescope_(28248653761).jpg"
      },
      "shots": [
        {
          "start": 16.6,
          "end": 17.767,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 17.767,
          "end": 19.933,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.92,
      "end": 22.4,
      "text": "The Great Dark Spot had completely vanished.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Neptune cloud cover over three decades (opo2319a).jpg",
        "credit": "NASA, ESA, E. Chavez (UC Berkeley), I. de Pater (UC Berkeley)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Neptune_cloud_cover_over_three_decades_(opo2319a).jpg"
      },
      "shots": [
        {
          "start": 19.933,
          "end": 22.4,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.4,
      "end": 25.67,
      "text": "Nobody expected a mega-storm on distant Neptune to just vanish.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA01142.jpg",
        "credit": "NASA/Voyager 2 Team",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA01142.jpg"
      },
      "shots": [
        {
          "start": 22.4,
          "end": 26.033,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
