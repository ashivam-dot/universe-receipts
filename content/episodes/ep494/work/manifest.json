      "shots": [
        {
          "start": 3.833,
          "end": 8.0,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.0,
      "end": 11.74,
      "text": "NASA's Fermi telescope captures only sparse photons across the sky.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Fermi Gamma-ray Space Telescope spacecraft model.png",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Fermi_Gamma-ray_Space_Telescope_spacecraft_model.png"
      },
      "shots": [
        {
          "start": 8.0,
          "end": 11.733,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.74,
      "end": 15.5,
      "text": "Sifting through noise used to swallow whole volunteer computing networks.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Fermi's 12-year View of the Gamma-ray Sky (SVS14090 - Fermi 144-month Fermi all-sky hammer 4000x2000).png",
