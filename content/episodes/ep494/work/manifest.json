          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.5,
      "end": 18.8,
      "text": "So researchers borrowed math designed to test quantum encryption.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 15.5,
          "end": 18.8,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.8,
      "end": 21.96,
      "text": "They mapped the search as geometry in a high-dimensional lattice.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Fermi's 12-year View of the Gamma-ray Sky (SVS14090 - Fermi 144-month Fermi all-sky hammer 4000x2000).png",
        "credit": "NASA's Scientific Visualization Studio - University of Maryland College Park/Francis Reddy",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Fermi%27s_12-year_View_of_the_Gamma-ray_Sky_(SVS14090_-_Fermi_144-month_Fermi_all-sky_hammer_4000x2000).png"
