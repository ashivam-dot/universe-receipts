          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.96,
      "end": 24.94,
      "text": "A standard computer processor found the target in ten hours.",
      "asset": {
        "source": "Flickr via Openverse",
        "title": "ULSI_AMC_DX_DLC_40MHz_2015-03-14-11.56.50_-_ZS-DMap_-_Stack-DSC09781-DSC09831",
