          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.84,
      "end": 8.0,
      "text": "Standard methods burned six hundred years of computing and found nothing.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Einstein@home working.jpg",
