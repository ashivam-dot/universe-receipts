{
  "id": "ep260",
  "duration": 28.893,
  "beats": [
    {
      "start": 0.08,
      "end": 3.16,
      "text": "Voyager 1 will die long before it reaches our border.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyager spacecraft.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Voyager_spacecraft.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 1.6,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 1.6,
          "end": 3.167,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.16,
      "end": 6.02,
      "text": "The ship is screaming away at a million miles a day.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyagers and Pioneers Trajectory.png",
        "credit": "NASA / JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Voyagers_and_Pioneers_Trajectory.png"
      },
      "shots": [
        {
          "start": 3.167,
          "end": 6.033,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.02,
      "end": 9.66,
      "text": "Yet it won't touch the inner Oort cloud for three centuries.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Oort cloud Sedna and Planet Nine orbits.jpg",
        "credit": "M. Brown/Caltech/R. Hurt/C. Powell",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Oort_cloud_Sedna_and_Planet_Nine_orbits.jpg"
      },
      "shots": [
        {
          "start": 6.033,
          "end": 9.667,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.66,
      "end": 12.96,
      "text": "Jan Oort proposed this giant icy shell in 1950.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "JanOort.jpg",
        "credit": "Joop van Bilsen",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:JanOort.jpg"
      },
      "shots": [
        {
          "start": 9.667,
          "end": 11.3,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 11.3,
          "end": 12.967,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.96,
      "end": 15.48,
      "text": "It stretches halfway to the next star system.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Best image of Alpha Centauri A and B.jpg",
        "credit": "ESA/Hubble & NASA",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Best_image_of_Alpha_Centauri_A_and_B.jpg"
      },
      "shots": [
        {
          "start": 12.967,
          "end": 15.467,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.48,
      "end": 18.22,
      "text": "Sunlight takes over a year to reach the outer edge.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The Sun by the Atmospheric Imaging Assembly of NASA's Solar Dynamics Observatory - 20100819.jpg",
        "credit": "NASA/SDO (AIA)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:The_Sun_by_the_Atmospheric_Imaging_Assembly_of_NASA%27s_Solar_Dynamics_Observatory_-_20100819.jpg"
      },
      "shots": [
        {
          "start": 15.467,
          "end": 18.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.22,
      "end": 21.92,
      "text": "No telescope has ever actually seen this massive structure.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist's Concept of the James Webb Space Telescope (JWST) (2003-27-1413).jpg",
        "credit": "Northrop Grumman",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%27s_Concept_of_the_James_Webb_Space_Telescope_(JWST)_(2003-27-1413).jpg"
      },
      "shots": [
        {
          "start": 18.233,
          "end": 21.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.92,
      "end": 25.26,
      "text": "Voyager needs thirty thousand years to finally drift through it.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA17046 - Voyager 1 Goes Interstellar.jpg",
        "credit": "NASA / JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA17046_-_Voyager_1_Goes_Interstellar.jpg"
      },
      "shots": [
        {
          "start": 21.933,
          "end": 25.267,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.26,
      "end": 28.543,
      "text": "The probe will be a cold, silent rock before it ever leaves.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyager spacecraft.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Voyager_spacecraft.jpg"
      },
      "shots": [
        {
          "start": 25.267,
          "end": 28.9,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
