  "beats": [
    {
      "start": 0.08,
      "end": 3.421,
      "text": "A structure ten billion light-years long shouldn't exist.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Three-dimensional distribution of dark matter in the Universe (artist's impression) (heic0701a).tiff",
        "credit": "NASA, ESA and R. Massey (California Institute of Technology)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Three-dimensional_distribution_of_dark_matter_in_the_Universe_(artist%27s_impression)_(heic0701a).tiff"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.167,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 2.167,
          "end": 3.433,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.421,
      "end": 11.291,
      "text": "In twenty-thirteen, a team of researchers discovered this colossal object spanning ten percent of the observable universe.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Swift Observatory rendering back alpha (SVS13926).png",
        "credit": "NASA/Goddard Space Flight Center/Chris Smith (KBRwyle)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Swift_Observatory_rendering_back_alpha_(SVS13926).png"
      },
      "shots": [
        {
          "start": 3.433,
          "end": 8.633,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 8.633,
          "end": 11.3,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.291,
      "end": 19.011,
      "text": "They mapped its incredible scale using bright gamma-ray bursts as reliable markers across distant constellations.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "GRB artist NASA Zhang Woosley.jpg",
        "credit": "NASA/Zhang & Woosley",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:GRB_artist_NASA_Zhang_Woosley.jpg"
      },
      "shots": [
        {
          "start": 11.3,
          "end": 19.0,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.011,
      "end": 25.881,
      "text": "Astronomer Jon Hakkila openly admitted he would have thought something this massive was completely impossible.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hercules (Annotated) (hercules-ann).jpg",
        "credit": "E. Slawik/NOIRLab/NSF/AURA/M. Zamani",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Hercules_(Annotated)_(hercules-ann).jpg"
      },
      "shots": [
        {
          "start": 19.0,
          "end": 22.433,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 22.433,
          "end": 25.867,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.881,
      "end": 33.426,
      "text": "Our standard models require the universe to be smooth, directly challenging the foundational cosmological principle.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The effects of weak gravitational lensing on galaxy shapes (noirlab2327a).jpg",
        "credit": "RubinObs/NOIRLab/NSF/AURA/J. Pinto",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:The_effects_of_weak_gravitational_lensing_on_galaxy_shapes_(noirlab2327a).jpg"
      },
      "shots": [
        {
          "start": 25.867,
          "end": 33.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 33.426,
      "end": 38.751,
      "text": "If real, this giant cluster shatters our most fundamental cosmic laws.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Simulation of large scale structure (eso1438b).tiff",
        "credit": "Illustris Collaboration",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Simulation_of_large_scale_structure_(eso1438b).tiff"
      },
      "shots": [
        {
          "start": 33.433,
          "end": 35.5,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 35.5,
          "end": 38.767,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 38.751,
      "end": 44.846,
      "text": "Some researchers suspect this wall is just a statistical illusion hidden inside our data.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The FLAMINGO project \u2013 cosmological hydrodynamical simulations for large-scale structure and galaxy cluster surveys.jpg",
        "credit": "Authors of the study: Schaye, Joop\u00a0; Kugel, Roi\u00a0; Schaller, Matthieu\u00a0; Helly, John C.\u00a0; Braspenning, Joey\u00a0; Elbers, Willem\u00a0; McCarthy, Ian G.\u00a0; van Daalen, Marcel P.\u00a0; Vandenbroucke, Bert\u00a0; Frenk, Car",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:The_FLAMINGO_project_%E2%80%93_cosmological_hydrodynamical_simulations_for_large-scale_structure_and_galaxy_cluster_surveys.jpg"
      },
      "shots": [
        {
          "start": 38.767,
          "end": 41.567,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 41.567,
          "end": 44.833,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 44.846,
      "end": 48.274,
      "text": "Until we know for sure, the cosmos holds a giant secret.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Three-dimensional distribution of dark matter in the Universe (artist's impression) (heic0701a).tiff",
        "credit": "NASA, ESA and R. Massey (California Institute of Technology)",
