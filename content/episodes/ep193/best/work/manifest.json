  "beats": [
    {
      "start": 0.08,
      "end": 4.436,
      "text": "Ten billion light-years across, a cosmic wall exists that shouldn't.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Three-dimensional distribution of dark matter in the Universe (artist's impression) (heic0701a).tiff",
        "credit": "NASA, ESA and R. Massey (California Institute of Technology)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Three-dimensional_distribution_of_dark_matter_in_the_Universe_(artist%27s_impression)_(heic0701a).tiff"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.2,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 2.2,
          "end": 4.433,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.436,
      "end": 14.356,
      "text": "In November twenty-thirteen, astronomers Istv\u00e1n Horv\u00e1th, Jon Hakkila, and Zsolt Bagoly analyzed gamma-ray bursts using data from space telescopes.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Swift Observatory rendering back alpha (SVS13926).png",
        "credit": "NASA/Goddard Space Flight Center/Chris Smith (KBRwyle)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Swift_Observatory_rendering_back_alpha_(SVS13926).png"
      },
      "shots": [
        {
          "start": 4.433,
          "end": 10.9,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 10.9,
          "end": 14.367,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.356,
      "end": 22.551,
      "text": "Because these explosions are extremely luminous and track massive star formations, researchers used them to map unseen matter.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "GRB artist NASA Zhang Woosley.jpg",
        "credit": "NASA/Zhang & Woosley",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:GRB_artist_NASA_Zhang_Woosley.jpg"
      },
      "shots": [
        {
          "start": 14.367,
          "end": 22.567,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.551,
      "end": 29.896,
      "text": "They mapped the Hercules-Corona Borealis Great Wall spanning about ten percent of the entire observable universe.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 22.567,
          "end": 29.9,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 29.896,
      "end": 37.146,
      "text": "This structure shatters the cosmological principle, which states the universe should be uniform on large scales.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Large-scale structures (eso0804a).tiff",
        "credit": "Klaus Dolag and equipment VIMOS-VLT Deep Survey",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Large-scale_structures_(eso0804a).tiff"
      },
      "shots": [
        {
          "start": 29.9,
          "end": 37.133,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 37.146,
      "end": 42.116,
      "text": "Jon Hakkila admitted that he would have thought this structure was too big to exist.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hercules (her).jpg",
        "credit": "IAU and Sky & Telescope",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Hercules_(her).jpg"
      },
      "shots": [
        {
          "start": 37.133,
          "end": 40.4,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 40.4,
          "end": 42.1,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 42.116,
      "end": 47.711,
      "text": "Some studies argue it could simply be a statistical illusion in incomplete datasets.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The FLAMINGO project \u2013 cosmological hydrodynamical simulations for large-scale structure and galaxy cluster surveys.jpg",
        "credit": "Authors of the study: Schaye, Joop\u00a0; Kugel, Roi\u00a0; Schaller, Matthieu\u00a0; Helly, John C.\u00a0; Braspenning, Joey\u00a0; Elbers, Willem\u00a0; McCarthy, Ian G.\u00a0; van Daalen, Marcel P.\u00a0; Vandenbroucke, Bert\u00a0; Frenk, Car",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:The_FLAMINGO_project_%E2%80%93_cosmological_hydrodynamical_simulations_for_large-scale_structure_and_galaxy_cluster_surveys.jpg"
      },
      "shots": [
        {
          "start": 42.1,
          "end": 44.3,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 44.3,
          "end": 47.7,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 47.711,
      "end": 54.556,
      "text": "Until future missions decide the debate, ten billion light-years of galaxies remain an impossible anomaly.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Three-dimensional distribution of dark matter in the Universe (artist's impression) (heic0701a).tiff",
        "credit": "NASA, ESA and R. Massey (California Institute of Technology)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Three-dimensional_distribution_of_dark_matter_in_the_Universe_(artist%27s_impression)_(heic0701a).tiff"
      },
      "shots": [
        {
          "start": 47.7,
          "end": 54.9,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
