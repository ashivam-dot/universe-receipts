{
  "id": "ep428",
  "duration": 29.872,
  "beats": [
    {
      "start": 0.08,
      "end": 3.86,
      "text": "Sunlight bending through Venus's atmosphere creates a glowing halo.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The Rare Transit of Venus - 2004 (7296491948).jpg",
        "credit": "NASA Goddard Space Flight Center from Greenbelt, MD, USA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:The_Rare_Transit_of_Venus_-_2004_(7296491948).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.7,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 2.7,
          "end": 3.867,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.86,
      "end": 6.48,
      "text": "We all recognize the Moon's cycle from crescent to full.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Astronomy; a translucent diagram of the phases of the Moon. Wellcome V0025021.jpg",
        "credit": "John Emslie",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Astronomy;_a_translucent_diagram_of_the_phases_of_the_Moon._Wellcome_V0025021.jpg"
      },
      "shots": [
        {
          "start": 3.867,
          "end": 6.467,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.48,
      "end": 10.96,
      "text": "Galileo Galilei discovered Venus mimics those same phases in 1610.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Fases de Venus - Galileo Galilei.png",
        "credit": "Galileo Galilei",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Fases_de_Venus_-_Galileo_Galilei.png"
      },
      "shots": [
        {
          "start": 6.467,
          "end": 10.967,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.96,
      "end": 13.26,
      "text": "At full phase, it looks like a tiny, distant dot.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Venus - November 20 2016 (42926275871).jpg",
        "credit": "Kevin Gill from Los Angeles, CA, United States",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Venus_-_November_20_2016_(42926275871).jpg"
      },
      "shots": [
        {
          "start": 10.967,
          "end": 13.267,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.26,
      "end": 16.52,
      "text": "When closer, it swells into a crescent six times larger.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Riccioli-Venus.jpg",
        "credit": "G. B. Riccioli",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Riccioli-Venus.jpg"
      },
      "shots": [
        {
          "start": 13.267,
          "end": 15.233,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 15.233,
          "end": 16.533,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.52,
      "end": 19.6,
      "text": "But its most mysterious phase happens against the Sun.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Venus' transit across the Sun.jpg",
        "credit": "NASA/SDO/HMI",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Venus%27_transit_across_the_Sun.jpg"
      },
      "shots": [
        {
          "start": 16.533,
          "end": 19.6,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.6,
      "end": 23.18,
      "text": "Astronomers saw a ring of fire during the 1761 transit.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Halley 1716 proposal of determining the parallax of the sun.jpg",
        "credit": "Edmond Halley",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Halley_1716_proposal_of_determining_the_parallax_of_the_sun.jpg"
      },
      "shots": [
        {
          "start": 19.6,
          "end": 23.167,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.18,
      "end": 26.16,
      "text": "Thick clouds wrap sunlight all the way around the planet.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Global view uvi Venus (Akatsuki).jpg",
        "credit": "Meli thev",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Global_view_uvi_Venus_(Akatsuki).jpg"
      },
      "shots": [
        {
          "start": 23.167,
          "end": 26.167,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 26.16,
      "end": 29.522,
      "text": "Because even before its transit, light bends around the planet's edge.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The Rare Transit of Venus - 2004 (7296491948).jpg",
        "credit": "NASA Goddard Space Flight Center from Greenbelt, MD, USA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:The_Rare_Transit_of_Venus_-_2004_(7296491948).jpg"
      },
      "shots": [
        {
          "start": 26.167,
          "end": 29.867,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
