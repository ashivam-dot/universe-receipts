  "beats": [
    {
      "start": 0.08,
      "end": 3.86,
      "text": "Sunlight bending through Venus's atmosphere creates a glowing halo.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The Rare Transit of Venus - 2004 (7296491948).jpg",
        "credit": "NASA Goddard Space Flight Center from Greenbelt, MD, USA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:The_Rare_Transit_of_Venus_-_2004_(7296491948).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 1.933,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 1.933,
          "end": 3.867,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.86,
      "end": 6.72,
      "text": "We all know the Moon shifts from full disk to thin crescent.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Phases of the Moon. (By Asa Smith. New York- Cady & Burgess, 60 John Street. 1850) (IA dr phases-of-the-moon-by-asa-smith-new-york-cady-burgess-60-john-street-0903013).jpg",
        "credit": "Smith, Asa",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Phases_of_the_Moon._(By_Asa_Smith._New_York-_Cady_%26_Burgess,_60_John_Street._1850)_(IA_dr_phases-of-the-moon-by-asa-smith-new-york-cady-burgess-60-john-street-0903013).jpg"
      },
      "shots": [
        {
          "start": 3.867,
          "end": 5.167,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 5.167,
          "end": 6.733,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.72,
      "end": 11.3,
      "text": "Galileo Galilei proved in 1610 that Venus undergoes identical phases.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Justus Sustermans - Portrait of Galileo Galilei, 1636.jpg",
        "credit": "Justus Sustermans",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Justus_Sustermans_-_Portrait_of_Galileo_Galilei,_1636.jpg"
      },
      "shots": [
        {
          "start": 6.733,
          "end": 9.0,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 9.0,
          "end": 11.3,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.3,
      "end": 14.82,
      "text": "At full phase, Venus spans under 10 arcseconds from Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PSM V75 D531 The planet venus on three different dates.png",
        "credit": "Unknown authorUnknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PSM_V75_D531_The_planet_venus_on_three_different_dates.png"
      },
      "shots": [
        {
          "start": 11.3,
          "end": 14.833,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.82,
      "end": 18.32,
      "text": "Near Earth, its crescent swells to over 60 arcseconds.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Riccioli-Venus.jpg",
        "credit": "G. B. Riccioli",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Riccioli-Venus.jpg"
      },
      "shots": [
        {
          "start": 14.833,
          "end": 16.833,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 16.833,
          "end": 18.333,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.32,
      "end": 21.5,
      "text": "Galileo even hid his discovery in a scrambled Latin anagram.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 18.333,
          "end": 21.5,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.5,
      "end": 25.42,
      "text": "Astronomers caught another jaw-dropping effect during the 1761 transit.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Halley 1716 proposal of determining the parallax of the sun.jpg",
        "credit": "Edmond Halley",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Halley_1716_proposal_of_determining_the_parallax_of_the_sun.jpg"
      },
      "shots": [
        {
          "start": 21.5,
          "end": 25.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.42,
      "end": 28.42,
      "text": "Thick atmosphere refracts sunlight straight around the planet's edge.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Global view uvi Venus (Akatsuki).jpg",
        "credit": "Meli thev",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Global_view_uvi_Venus_(Akatsuki).jpg"
      },
      "shots": [
        {
          "start": 25.433,
          "end": 28.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 28.42,
      "end": 32.079,
      "text": "Before entering the Sun's disk, light encircles the entire world.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The Rare Transit of Venus - 2004 (7296491948).jpg",
        "credit": "NASA Goddard Space Flight Center from Greenbelt, MD, USA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:The_Rare_Transit_of_Venus_-_2004_(7296491948).jpg"
      },
      "shots": [
        {
          "start": 28.433,
          "end": 32.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
