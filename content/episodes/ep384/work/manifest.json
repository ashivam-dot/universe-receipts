  "beats": [
    {
      "start": 0.08,
      "end": 2.8,
      "text": "There are more planets than stars in the night sky.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The Milky Way and Sagittarius Constellation (opo9930e).jpg",
        "credit": "Terrence Dickinson",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:The_Milky_Way_and_Sagittarius_Constellation_(opo9930e).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.8,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 2.8,
      "end": 5.84,
      "text": "We once thought our galaxy was a collection of lonely suns.",
      "asset": {
        "source": "Flickr via Openverse",
        "title": "Light Echo Illuminates Dust Around Supergiant Star V838 Monocerotis (V838 Mon)",
        "credit": "NASA Hubble",
        "license": "CC BY 2.0",
        "url": "https://www.flickr.com/photos/144614754@N02/27747557010"
      },
      "shots": [
        {
          "start": 2.8,
          "end": 4.767,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 4.767,
          "end": 5.833,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 5.84,
      "end": 9.24,
      "text": "Edwin Hubble proved we're one galaxy among billions in the 1920s.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hubble at Hale Telescope (19950424 cd3 08-CC).jpg",
        "credit": "International Gemini Observatory/NOIRLab/NSF/AURA",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Hubble_at_Hale_Telescope_(19950424_cd3_08-CC).jpg"
      },
      "shots": [
        {
          "start": 5.833,
          "end": 7.033,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 7.033,
          "end": 9.233,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.24,
      "end": 12.78,
      "text": "This barred spiral home holds up to 400 billion stars.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "A top-down view of the Milky Way galaxy (SVS14930 - Westerlund 1 illustration Plan Unlabeled).jpg",
        "credit": "NASA\u2019s Goddard Space Flight Center/Conceptual Image Lab",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:A_top-down_view_of_the_Milky_Way_galaxy_(SVS14930_-_Westerlund_1_illustration_Plan_Unlabeled).jpg"
      },
      "shots": [
        {
          "start": 9.233,
          "end": 12.767,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.78,
      "end": 15.44,
      "text": "It hides a black hole four million times heavier than the Sun.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Sag A*.jpg",
        "credit": "EHT Collaboration",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Sag_A*.jpg"
      },
      "shots": [
        {
          "start": 12.767,
          "end": 15.433,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.44,
      "end": 18.28,
      "text": "But scientists realize the stars aren't the main event.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Exoplanet 29 Cygni b (Artist's Concept) (weic2607a).jpg",
        "credit": "NASA, ESA, CSA, J. Olmsted (STScI)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Exoplanet_29_Cygni_b_(Artist%27s_Concept)_(weic2607a).jpg"
      },
      "shots": [
        {
          "start": 15.433,
          "end": 16.867,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 16.867,
          "end": 18.267,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.28,
      "end": 22.26,
      "text": "The Milky Way actually contains at least 100 billion planets.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA23690-Exoplanet-Kepler1649c-20200415.jpg",
        "credit": "NASA/Ames Research Center/Daniel Rutter",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA23690-Exoplanet-Kepler1649c-20200415.jpg"
      },
      "shots": [
        {
          "start": 18.267,
          "end": 20.4,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 20.4,
          "end": 22.267,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.26,
      "end": 24.8,
      "text": "That's an average of one world for every single star.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Rocky exoplanet TRAPPIST-1 b (illustration) (weic2309a).jpg",
        "credit": "NASA, ESA, CSA, J. Olmsted (STScI), T. P. Greene (NASA Ames), T. Bell (BAERI), E. Ducrot (CEA), P. Lagage (CEA)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Rocky_exoplanet_TRAPPIST-1_b_(illustration)_(weic2309a).jpg"
      },
      "shots": [
        {
          "start": 22.267,
          "end": 24.8,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.8,
      "end": 28.291,
      "text": "It means there are more planets than stars in the night sky.",
