  "duration": 28.217,
  "beats": [
    {
      "start": 0.08,
      "end": 2.86,
      "text": "There are more planets than stars in the night sky.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The Milky Way and Sagittarius Constellation (opo9930e).jpg",
        "credit": "Terrence Dickinson",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:The_Milky_Way_and_Sagittarius_Constellation_(opo9930e).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.867,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 2.86,
      "end": 6.14,
      "text": "We once believed our home galaxy held the entire universe.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "View of the Milky Way from the Taganay National Park.jpg",
        "credit": "Vasily Iakovlev",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:View_of_the_Milky_Way_from_the_Taganay_National_Park.jpg"
      },
      "shots": [
        {
          "start": 2.867,
          "end": 6.133,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.14,
      "end": 9.54,
      "text": "Edwin Hubble proved we're one galaxy among billions in the 1920s.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hubble at Hale Telescope (19950424 cd3 08-CC).jpg",
        "credit": "International Gemini Observatory/NOIRLab/NSF/AURA",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Hubble_at_Hale_Telescope_(19950424_cd3_08-CC).jpg"
      },
      "shots": [
        {
          "start": 6.133,
          "end": 9.533,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.54,
      "end": 13.42,
      "text": "Our barred spiral home holds over 100 billion stars.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "A top-down view of the Milky Way galaxy (SVS14930 - Westerlund 1 illustration Plan Unlabeled).jpg",
        "credit": "NASA\u2019s Goddard Space Flight Center/Conceptual Image Lab",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:A_top-down_view_of_the_Milky_Way_galaxy_(SVS14930_-_Westerlund_1_illustration_Plan_Unlabeled).jpg"
      },
      "shots": [
        {
          "start": 9.533,
          "end": 13.433,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.42,
      "end": 16.64,
      "text": "But our galaxy isn't a quiet collection of lonely suns.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Center of the Milky Way Galaxy IV \u2013 Composite.jpg",
        "credit": "NASA/JPL-Caltech/ESA/CXC/STScI",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Center_of_the_Milky_Way_Galaxy_IV_%E2%80%93_Composite.jpg"
      },
      "shots": [
        {
          "start": 13.433,
          "end": 16.633,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.64,
      "end": 19.8,
      "text": "The Milky Way contains at least 100 billion planets.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "First Potentially Habitable Earth-Sized Planet Confirmed By Gemini And Keck Observatories (gemini1403c).tiff",
        "credit": "Danielle Futselaar.",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:First_Potentially_Habitable_Earth-Sized_Planet_Confirmed_By_Gemini_And_Keck_Observatories_(gemini1403c).tiff"
      },
      "shots": [
        {
          "start": 16.633,
          "end": 19.8,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.8,
      "end": 22.64,
      "text": "That means an average of at least one planet per star.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Rocky exoplanet TRAPPIST-1 b (illustration) (weic2309a).jpg",
        "credit": "NASA, ESA, CSA, J. Olmsted (STScI), T. P. Greene (NASA Ames), T. Bell (BAERI), E. Ducrot (CEA), P. Lagage (CEA)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Rocky_exoplanet_TRAPPIST-1_b_(illustration)_(weic2309a).jpg"
      },
      "shots": [
        {
          "start": 19.8,
          "end": 21.467,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 21.467,
          "end": 22.633,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.64,
      "end": 26.12,
      "text": "That average across every single sun adds up fast.",
      "asset": {
        "source": "Flickr via Openverse",
        "title": "Giant World Orbiting Red Dwarf Star Gliese 876 (Illustration)",
        "credit": "NASA Hubble",
        "license": "CC BY 2.0",
        "url": "https://www.flickr.com/photos/144614754@N02/48805110243"
      },
      "shots": [
        {
          "start": 22.633,
          "end": 26.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 26.12,
      "end": 27.867,
      "text": "Proving that when you look up at the Milky Way,",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The Milky Way and Sagittarius Constellation (opo9930e).jpg",
        "credit": "Terrence Dickinson",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:The_Milky_Way_and_Sagittarius_Constellation_(opo9930e).jpg"
      },
      "shots": [
        {
          "start": 26.133,
          "end": 28.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
