  "beats": [
    {
      "start": 0.08,
      "end": 4.328,
      "text": "Reviewers called this groundbreaking space discovery utter nonsense.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Dr. Eugene PKSC-20180809-PH KLS02 0003arker Speaks to Media (30123740568) (cropped).jpg",
        "credit": "Kim Shiflett",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Dr._Eugene_PKSC-20180809-PH_KLS02_0003arker_Speaks_to_Media_(30123740568)_(cropped).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.833,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 2.833,
          "end": 4.333,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.328,
      "end": 16.248,
      "text": "In 1958, astrophysicist Eugene Parker used just four lines of algebra to prove the million-degree solar corona must rapidly expand outward into the solar system.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The total solar eclipse of 21 August 2017 (eso1822i).tiff",
        "credit": "ESO/P. Hor\u00e1lek/Solar Wind Sherpas project",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:The_total_solar_eclipse_of_21_August_2017_(eso1822i).tiff"
      },
      "shots": [
        {
          "start": 4.333,
          "end": 8.9,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 8.9,
          "end": 16.233,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.248,
      "end": 24.043,
      "text": "When Parker submitted his bold paper to The Astrophysical Journal, two expert reviewers firmly recommended rejection.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The Astrophysical journal (1895) (14597869027).jpg",
        "credit": "Internet Archive Book Images",
        "license": "No restrictions",
        "url": "https://commons.wikimedia.org/wiki/File:The_Astrophysical_journal_(1895)_(14597869027).jpg"
      },
      "shots": [
        {
          "start": 16.233,
          "end": 20.133,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 20.133,
          "end": 24.033,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.043,
      "end": 32.818,
      "text": "However, fearless journal editor Subrahmanyan Chandrasekhar bravely overruled them and published the historic manuscript anyway.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "S. N. Bose, FRS, addressing a gathering during the visit of S. Chandrasekhar, Sept 18, 1961.jpg",
        "credit": "Unknown authorUnknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:S._N._Bose,_FRS,_addressing_a_gathering_during_the_visit_of_S._Chandrasekhar,_Sept_18,_1961.jpg"
      },
      "shots": [
        {
          "start": 24.033,
          "end": 32.833,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 32.818,
      "end": 40.288,
      "text": "Just months later, Soviet spacecraft Luna 1 directly detected this invisible stream tearing through the void.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Luna 1 - 2 Spacecraft.png",
        "credit": "NASA/NSSDCA (public domain)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Luna_1_-_2_Spacecraft.png"
      },
      "shots": [
        {
          "start": 32.833,
          "end": 40.3,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 40.288,
      "end": 47.308,
      "text": "Today, we know this supersonic plasma torrent races across the solar system at a million miles per hour.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Magnetic reconnection zones in the earth's magnetosphere Science 1 th-jpg.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Magnetic_reconnection_zones_in_the_earth%27s_magnetosphere_Science_1_th-jpg.jpg"
      },
      "shots": [
        {
          "start": 40.3,
          "end": 47.3,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 47.308,
      "end": 51.437,
      "text": "Reviewers called this groundbreaking space discovery utter nonsense.",
