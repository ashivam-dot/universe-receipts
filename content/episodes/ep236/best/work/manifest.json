          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.731,
      "end": 12.976,
      "text": "In 2012, the National Reconnaissance Office surprised NASA by donating two 2.4-meter surveillance mirrors.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "National Reconnaissance Office, 2013.jpg",
        "credit": "Trevor Paglen",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:National_Reconnaissance_Office,_2013.jpg"
      },
      "shots": [
        {
          "start": 4.733,
          "end": 8.867,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 8.867,
          "end": 12.967,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.976,
      "end": 19.521,
      "text": "NASA's first chief of astronomy, Nancy Grace Roman, inspired the team to use this hardware.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Dr. Nancy Roman - GPN-2002-000212 edited.jpg",
        "credit": "NASA, edited by SMasonGarrison",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Dr._Nancy_Roman_-_GPN-2002-000212_edited.jpg"
      },
      "shots": [
        {
          "start": 12.967,
          "end": 15.4,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 15.4,
          "end": 19.533,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.521,
      "end": 26.441,
      "text": "Engineers adapted the reconnaissance optics into a massive flagship observatory for the 2020s.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Roman Primary Mirror Completed at L3Harris (SVS14461 - Primary).jpg",
        "credit": "NASA's Scientific Visualization Studio - Jonathan North, Scott Wiessinger",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Roman_Primary_Mirror_Completed_at_L3Harris_(SVS14461_-_Primary).jpg"
      },
      "shots": [
        {
          "start": 19.533,
          "end": 23.367,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 23.367,
          "end": 26.433,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 26.441,
      "end": 36.036,
      "text": "On August 30, 2026, a SpaceX Falcon Heavy carried this former spy tool to a point 1.5 million kilometers from Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NASA's Nancy Grace Roman Space Telescope Launch (KSC-20260830-PH-SPX01 0006).jpg",
        "credit": "SpaceX",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:NASA%27s_Nancy_Grace_Roman_Space_Telescope_Launch_(KSC-20260830-PH-SPX01_0006).jpg"
      },
      "shots": [
        {
          "start": 26.433,
          "end": 33.067,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 33.067,
          "end": 36.033,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 36.036,
      "end": 43.911,
      "text": "The Nancy Grace Roman Space Telescope matches Hubble's resolution but captures an area 100 times larger.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Roman phatSIM clean smaller.jpg",
        "credit": "NASA's Goddard Space Flight Center\nProducer Scott Wiessinger (KBRwyle) [Lead]\n\nNarrator Scott Wiessinger (KBRwyle)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Roman_phatSIM_clean_smaller.jpg"
      },
      "shots": [
        {
          "start": 36.033,
          "end": 39.967,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 39.967,
          "end": 43.9,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 43.911,
      "end": 48.856,
      "text": "It will scan more of the sky in five years than Hubble did in over thirty.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hubble-ultra-deep-field-20091208-WFC3-IR-full.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Hubble-ultra-deep-field-20091208-WFC3-IR-full.jpg"
