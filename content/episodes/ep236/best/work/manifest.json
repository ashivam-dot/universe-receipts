    {
      "start": 0.08,
      "end": 4.731,
      "text": "A classified military mirror is about to outscan the Hubble telescope.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Nancy Grace Roman Space Telescope (2020-35-4665).png",
        "credit": "IMAGE: NASA, NASA-GSFC",
