          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.731,
      "end": 12.976,
      "text": "In 2012, the National Reconnaissance Office surprised NASA by donating two 2.4-meter surveillance mirrors.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Underwater Ice Station Zebra, 16 - Flickr - The Central Intelligence Agency.jpg",
        "credit": "The Central Intelligence Agency",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Underwater_Ice_Station_Zebra,_16_-_Flickr_-_The_Central_Intelligence_Agency.jpg"
      },
      "shots": [
        {
          "start": 4.733,
          "end": 8.867,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 8.867,
          "end": 12.967,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.976,
      "end": 20.396,
      "text": "NASA's first chief of astronomy, Nancy Grace Roman, inspired the agency to repurpose one for a new mission.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Dr. Nancy Roman - GPN-2002-000212 edited.jpg",
        "credit": "NASA, edited by SMasonGarrison",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Dr._Nancy_Roman_-_GPN-2002-000212_edited.jpg"
      },
      "shots": [
        {
          "start": 12.967,
          "end": 15.867,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 15.867,
          "end": 20.4,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.396,
      "end": 28.066,
      "text": "Engineers adapted this reconnaissance hardware into a flagship observatory to solve the mysteries of dark energy.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Optical Telescope Assembly for the Roman Space Telescope.jpg",
        "credit": "NASA/Chris Gunn",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Optical_Telescope_Assembly_for_the_Roman_Space_Telescope.jpg"
      },
      "shots": [
        {
          "start": 20.4,
          "end": 23.867,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 23.867,
          "end": 28.067,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 28.066,
      "end": 37.836,
      "text": "On August 30, 2026, a SpaceX Falcon Heavy will carry this former spy tool to a point 1.5 million kilometers from Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NASA's SpaceX Europa Clipper Launch (KSC-20241014-PH-AJN01 0022) (cropped).jpg",
        "credit": "NASA Kennedy Space Center / NASA/Amber Jean Notvest",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:NASA%27s_SpaceX_Europa_Clipper_Launch_(KSC-20241014-PH-AJN01_0022)_(cropped).jpg"
      },
      "shots": [
        {
          "start": 28.067,
          "end": 34.867,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 34.867,
          "end": 37.833,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 37.836,
      "end": 45.711,
      "text": "The Nancy Grace Roman Space Telescope matches Hubble's resolution but captures an area 100 times larger.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 37.833,
          "end": 45.7,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 45.711,
      "end": 51.406,
      "text": "It is expected to scan more of the sky in five years than Hubble did in over thirty.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Roman Ultra Deep Field Annotated (2021-003).tif",
        "credit": "IMAGE: NASA, ESA, Anton M. Koekemoer (STScI) ACKNOWLEDGMENT: DSS",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Roman_Ultra_Deep_Field_Annotated_(2021-003).tif"
      },
      "shots": [
        {
          "start": 45.7,
          "end": 51.4,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 51.406,
      "end": 57.235,
      "text": "That incredible survey power stems entirely from recycling top-secret military hardware.",
