  "beats": [
    {
      "start": 0.08,
      "end": 4.513,
      "text": "A massive asteroid once reached the highest hazard rating in history.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NASA\u2019s OSIRIS-APEX Mission Will Explore Asteroid Apophis (SVS15101 - Asteroid Apophis Beauty Shot Thumbnail).jpg",
        "credit": "NASA's Scientific Visualization Studio - eMITS/Dan Gallagher, Science and Technology Corporation/Kel Elkins, eMITS/Adriana Manrique Gutierrez, eMITS/Wes D. Buchanan, eMITS/Jonathan North, NASA/JPL/Lis",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:NASA%E2%80%99s_OSIRIS-APEX_Mission_Will_Explore_Asteroid_Apophis_(SVS15101_-_Asteroid_Apophis_Beauty_Shot_Thumbnail).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.133,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 2.133,
          "end": 4.5,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.513,
      "end": 12.233,
      "text": "In 2004, astronomers calculated that asteroid Apophis had a 2.7 percent chance of hitting Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Kitt Peak National Observatory in the Quinlan Mountains, 2023.jpg",
        "credit": "KPNO/NOIRLab/NSF/AURA/T. Slovinsk\u00fd",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Kitt_Peak_National_Observatory_in_the_Quinlan_Mountains,_2023.jpg"
      },
      "shots": [
        {
          "start": 4.5,
          "end": 9.367,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 9.367,
          "end": 12.233,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.233,
      "end": 16.528,
      "text": "It was the first object to ever hit Level 4 on the Torino scale.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Updated Torino scale 041505.jpg",
        "credit": "Unknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Updated_Torino_scale_041505.jpg"
      },
      "shots": [
        {
          "start": 12.233,
          "end": 16.533,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.528,
      "end": 22.373,
      "text": "Radar data from 2021 eventually ruled out an impact for at least a century.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Goldstone Deep Space Network - Deep Space Station 14.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Goldstone_Deep_Space_Network_-_Deep_Space_Station_14.jpg"
      },
      "shots": [
        {
          "start": 16.533,
          "end": 22.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.373,
      "end": 30.068,
      "text": "But on Friday, April 13, 2029, the 450-meter rock will still sweep incredibly close.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 22.367,
          "end": 30.067,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 30.068,
      "end": 37.288,
      "text": "Apophis will pass within 31,600 kilometers, flying lower than many of our own satellites.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Space sustainability urgency in earth orbits white.png",
        "credit": "Pablo Carlos Budassi",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Space_sustainability_urgency_in_earth_orbits_white.png"
      },
      "shots": [
        {
          "start": 30.067,
          "end": 34.767,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 34.767,
          "end": 37.3,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 37.288,
      "end": 42.158,
      "text": "Billions of people across Europe and Africa can watch it with the naked eye.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Asteroid Apophis 2029 Earth Flyby \u2013 Orbit Visualizations (SVS5651 - apophis 2029 flyby pov 01625).jpg",
        "credit": "NASA's Scientific Visualization Studio - Science and Technology Corporation/Kel Elkins, eMITS/Dan Gallagher, NASA/GSFC/Michael Moreau",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Asteroid_Apophis_2029_Earth_Flyby_%E2%80%93_Orbit_Visualizations_(SVS5651_-_apophis_2029_flyby_pov_01625).jpg"
      },
      "shots": [
        {
          "start": 37.3,
          "end": 39.733,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 39.733,
          "end": 42.167,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 42.158,
      "end": 47.908,
      "text": "Earth\u2019s gravity will even stretch the asteroid\u2019s surface and trigger minor landslides.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Tidal Forces Destroying a Planet (helix-illus-labeled).jpg",
        "credit": "NASA/CXC/SAO/M.Weiss",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Tidal_Forces_Destroying_a_Planet_(helix-illus-labeled).jpg"
      },
      "shots": [
        {
          "start": 42.167,
          "end": 45.033,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 45.033,
          "end": 47.9,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 47.908,
      "end": 53.366,
      "text": "This intense cosmic encounter will forever alter the orbit of this massive asteroid.",
      "asset": {
        "source": "Wikimedia Commons",
