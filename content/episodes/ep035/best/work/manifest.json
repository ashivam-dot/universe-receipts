    {
      "start": 0.08,
      "end": 4.513,
      "text": "A massive asteroid once reached the highest hazard rating in history.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Asteroid Apophis 2029 Earth Flyby \u2013 Orbit Visualizations (SVS5651 - apophis 2029 flyby ride-along 01895).jpg",
        "credit": "NASA's Scientific Visualization Studio - Science and Technology Corporation/Kel Elkins, eMITS/Dan Gallagher, NASA/GSFC/Michael Moreau",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Asteroid_Apophis_2029_Earth_Flyby_%E2%80%93_Orbit_Visualizations_(SVS5651_-_apophis_2029_flyby_ride-along_01895).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.133,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 2.133,
          "end": 4.5,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.513,
      "end": 11.958,
      "text": "Discovered in 2004, asteroid Apophis was given a 2.7 percent chance of slamming into Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Kitt Peak National Observatory in the Quinlan Mountains, 2023.jpg",
        "credit": "KPNO/NOIRLab/NSF/AURA/T. Slovinsk\u00fd",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Kitt_Peak_National_Observatory_in_the_Quinlan_Mountains,_2023.jpg"
      },
      "shots": [
        {
          "start": 4.5,
          "end": 8.367,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 8.367,
          "end": 11.967,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.958,
      "end": 19.153,
      "text": "But radar observations in March 2021 definitively ruled out any collision for at least a century.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Goldstone Deep Space Network - Deep Space Station 14.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Goldstone_Deep_Space_Network_-_Deep_Space_Station_14.jpg"
      },
      "shots": [
        {
          "start": 11.967,
          "end": 19.167,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.153,
      "end": 26.298,
      "text": "Yet, on Friday, April 13, 2029, the 450-meter rock will still make history.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 19.167,
          "end": 26.3,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 26.298,
      "end": 33.493,
      "text": "It will sweep less than 32,000 kilometers above us, passing closer than our geostationary satellites.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Space sustainability urgency in earth orbits black.png",
        "credit": "Pablo Carlos Budassi",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Space_sustainability_urgency_in_earth_orbits_black.png"
      },
      "shots": [
        {
          "start": 26.3,
          "end": 30.667,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 30.667,
          "end": 33.5,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 33.493,
      "end": 38.563,
      "text": "Billions of people in Europe, Africa, and Asia can watch it with the naked eye.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Asteroid Apophis 2029 Earth Flyby \u2013 Orbit Visualizations (SVS5651 - apophis 2029 flyby pov 01625).jpg",
        "credit": "NASA's Scientific Visualization Studio - Science and Technology Corporation/Kel Elkins, eMITS/Dan Gallagher, NASA/GSFC/Michael Moreau",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Asteroid_Apophis_2029_Earth_Flyby_%E2%80%93_Orbit_Visualizations_(SVS5651_-_apophis_2029_flyby_pov_01625).jpg"
      },
      "shots": [
        {
          "start": 33.5,
          "end": 36.033,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 36.033,
          "end": 38.567,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 38.563,
      "end": 45.938,
      "text": "During this flyby, Earth's gravitational tidal forces will twist the asteroid and trigger surface movements.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Tidal Forces Destroying a Planet (helix-illus-labeled).jpg",
        "credit": "NASA/CXC/SAO/M.Weiss",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Tidal_Forces_Destroying_a_Planet_(helix-illus-labeled).jpg"
      },
      "shots": [
        {
          "start": 38.567,
          "end": 41.233,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 41.233,
          "end": 45.933,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 45.938,
      "end": 51.448,
      "text": "This intense cosmic encounter will forever alter the orbit of the massive asteroid.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Asteroid Apophis 2029 Earth Flyby \u2013 Orbit Visualizations (SVS5651 - apophis 2029 flyby ride-along 01895).jpg",
