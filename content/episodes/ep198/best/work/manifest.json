  "beats": [
    {
      "start": 0.08,
      "end": 4.2,
      "text": "A glowing beam of energy shoots five thousand light-years across space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "A cosmic searchlight (opo0020a).tiff",
        "credit": "The Hubble Heritage Team (STScI/AURA) and NASA/ESA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:A_cosmic_searchlight_(opo0020a).tiff"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 1.633,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 1.633,
          "end": 4.2,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.2,
      "end": 8.87,
      "text": "Messier 87 is a massive galaxy with trillions of stars.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The halo of galaxy Messier 87.jpg",
        "credit": "Chris Mihos (Case Western Reserve University)/ESO",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:The_halo_of_galaxy_Messier_87.jpg"
      },
      "shots": [
        {
          "start": 4.2,
          "end": 6.033,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 6.033,
          "end": 8.867,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.87,
      "end": 15.415,
      "text": "Fifty-five million light-years away, it dwarfs our Milky Way with fifteen thousand globular clusters.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 8.867,
          "end": 15.4,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.415,
      "end": 23.335,
      "text": "In 1918, astronomer Heber Curtis of Lick Observatory spotted a bizarre straight ray erupting from the core.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 15.4,
          "end": 23.333,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.335,
      "end": 27.18,
      "text": "The jet creates a trick, appearing to move faster than light.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "M87 VLA VLBA radio astronomy.jpg",
        "credit": "Emesee",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:M87_VLA_VLBA_radio_astronomy.jpg"
      },
      "shots": [
        {
          "start": 23.333,
          "end": 27.167,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 27.18,
      "end": 32.775,
      "text": "This optical illusion occurs as matter blasts toward Earth at nearly the speed of light.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "M87 VLA VLBA radio astronomy.jpg",
        "credit": "Emesee",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:M87_VLA_VLBA_radio_astronomy.jpg"
      },
      "shots": [
        {
          "start": 27.167,
          "end": 32.767,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 32.775,
      "end": 38.3,
      "text": "It is powered by a black hole 6.5 billion times heavier than our sun.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Central black hole of M87.tif",
        "credit": "Event Horizon Telescope",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Central_black_hole_of_M87.tif"
      },
      "shots": [
        {
          "start": 32.767,
          "end": 35.6,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 35.6,
          "end": 38.3,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 38.3,
      "end": 46.095,
      "text": "In 2019, the Event Horizon Telescope revealed the first direct image of this gravitational monster's shadow.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "View of the M87 supermassive black hole and jet in polarised light (eso2105b).tiff",
        "credit": "EHT Collaboration; ALMA (ESO/NAOJ/NRAO), Goddi et al.; VLBA (NRAO), Kravchenko et al.; J. C. Algaba, I. Mart\u00ed-Vidal",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:View_of_the_M87_supermassive_black_hole_and_jet_in_polarised_light_(eso2105b).tiff"
      },
      "shots": [
        {
          "start": 38.3,
          "end": 42.567,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 42.567,
