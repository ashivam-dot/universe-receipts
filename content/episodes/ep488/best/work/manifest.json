{
  "id": "ep488",
  "duration": 32.92,
  "beats": [
    {
      "start": 0.08,
      "end": 3.76,
      "text": "NASA caught a star swallowing a Jupiter-sized planet.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Illustration of the rogue planet Cha 1107-7626 (eso2516a).jpg",
        "credit": "ESO/L. Cal\u00e7ada/M. Kornmesser",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Illustration_of_the_rogue_planet_Cha_1107-7626_(eso2516a).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.767,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.76,
      "end": 7.16,
      "text": "Everyone assumed an aging star expanded and ate its neighbor.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Betelgeuse and wake of its companion star (artist's concept) (opo2602).tiff",
        "credit": "NASA, ESA, E. Wheatley (STScI), Science: A. Dupree (CfA)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Betelgeuse_and_wake_of_its_companion_star_(artist%27s_concept)_(opo2602).tiff"
      },
      "shots": [
        {
          "start": 3.767,
          "end": 7.167,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.16,
      "end": 10.52,
      "text": "Infrared surveys first spotted the flash across our galaxy.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "WISE artist concept (PIA17254).jpg",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:WISE_artist_concept_(PIA17254).jpg"
      },
      "shots": [
        {
          "start": 7.167,
          "end": 10.533,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.52,
      "end": 13.5,
      "text": "Astronomers expected to find a swollen red giant.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "WISE artist concept (PIA17254).jpg",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:WISE_artist_concept_(PIA17254).jpg"
      },
      "shots": [
        {
          "start": 10.533,
          "end": 13.5,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.5,
      "end": 16.48,
      "text": "NASA pointed the James Webb Space Telescope at the star.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist concept of JWST (50489833002 107cb9e661 o).jpg",
        "credit": "Adriana Manrique Gutierrez, NASA Animator",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist_concept_of_JWST_(50489833002_107cb9e661_o).jpg"
      },
      "shots": [
        {
          "start": 13.5,
          "end": 16.467,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.48,
      "end": 19.48,
      "text": "Spectra proved the host star had not swollen up.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Acoustic Testing of a Webb Telescope Space-bound Instrument.jpg",
        "credit": "NASA's James Webb Space Telescope from Greenbelt, MD, USA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Acoustic_Testing_of_a_Webb_Telescope_Space-bound_Instrument.jpg"
      },
      "shots": [
        {
          "start": 16.467,
          "end": 19.467,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.48,
      "end": 23.26,
      "text": "Gravitational drag caused the planet's orbit to slowly decay.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Save LEO roadmap.jpg",
        "credit": "Space Travel Blog / Rute Marta Jansone / Pekka Janhunen",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Save_LEO_roadmap.jpg"
      },
      "shots": [
        {
          "start": 19.467,
          "end": 23.267,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.26,
      "end": 26.58,
      "text": "The planet plunged to its death into an unexpanded star.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "WASP-12b (NASA).jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:WASP-12b_(NASA).jpg"
      },
      "shots": [
        {
          "start": 23.267,
          "end": 26.567,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 26.58,
      "end": 29.92,
      "text": "Webb even detected carbon monoxide gas from the wreckage.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Early Stages of the FU Orionis Outburst (Artist's Concept) (2024-037).tiff",
        "credit": "Artwork NASA-JPL, Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Early_Stages_of_the_FU_Orionis_Outburst_(Artist%27s_Concept)_(2024-037).tiff"
      },
      "shots": [
        {
          "start": 26.567,
          "end": 29.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 29.92,
      "end": 32.57,
      "text": "It proved how a world spirals directly into its sun.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Illustration of the rogue planet Cha 1107-7626 (eso2516a).jpg",
        "credit": "ESO/L. Cal\u00e7ada/M. Kornmesser",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Illustration_of_the_rogue_planet_Cha_1107-7626_(eso2516a).jpg"
      },
      "shots": [
        {
          "start": 29.933,
          "end": 32.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
