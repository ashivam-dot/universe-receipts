{
  "id": "ep465",
  "duration": 32.695,
  "beats": [
    {
      "start": 0.08,
      "end": 4.48,
      "text": "The iconic Horsehead Nebula is slowly erasing itself into nothing.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The Horsehead Nebula (eso0202b).jpg",
        "credit": "ESO",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:The_Horsehead_Nebula_(eso0202b).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.467,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.48,
      "end": 8.92,
      "text": "This massive tower of dust sits roughly fourteen hundred light-years away in Orion.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Alnitak & Orion's Sword (53514488047).jpg",
        "credit": "gjdonatiello",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Alnitak_%26_Orion%27s_Sword_(53514488047).jpg"
      },
      "shots": [
        {
          "start": 4.467,
          "end": 6.4,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 6.4,
          "end": 8.933,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.92,
      "end": 13.28,
      "text": "It stretches three light-years across, blocking the glowing hydrogen gas behind it.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "IC 434 (50982686502).jpg",
        "credit": "Carsten Frenzl from Deutschland",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:IC_434_(50982686502).jpg"
      },
      "shots": [
        {
          "start": 8.933,
          "end": 13.267,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.28,
      "end": 18.12,
      "text": "A former Harvard maid named Williamina Fleming first spotted the silhouette in eighteen eighty-eight.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Williamina Paton Stevens Fleming circa 1890s.jpg",
        "credit": "Unknown authorUnknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Williamina_Paton_Stevens_Fleming_circa_1890s.jpg"
      },
      "shots": [
        {
          "start": 13.267,
          "end": 18.133,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.12,
      "end": 22.16,
      "text": "Ultraviolet radiation from nearby stars is relentlessly carving into the dust.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Horsehead Nebula (NIRCam image) (weic2411d).jpg",
        "credit": "ESA/Webb, NASA, CSA, K. Misselt (University of Arizona) and A. Abergel (IAS/University Paris-Saclay, CNRS)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Horsehead_Nebula_(NIRCam_image)_(weic2411d).jpg"
      },
      "shots": [
        {
          "start": 18.133,
          "end": 22.167,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.16,
      "end": 28.1,
      "text": "Astronomers estimate this photo-evaporation will completely erase the pillar within five million years.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Webb Space Telescope View of the Horsehead Nebula (SVS31283).jpg",
        "credit": "NASA's Scientific Visualization Studio - Global Science and Technology, Inc./Amy Moran",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Webb_Space_Telescope_View_of_the_Horsehead_Nebula_(SVS31283).jpg"
      },
      "shots": [
        {
          "start": 22.167,
          "end": 28.1,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 28.1,
      "end": 32.345,
      "text": "That is how the iconic Horsehead Nebula erases itself into nothing.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The Horsehead Nebula (eso0202b).jpg",
        "credit": "ESO",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:The_Horsehead_Nebula_(eso0202b).jpg"
      },
      "shots": [
        {
          "start": 28.1,
          "end": 32.7,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    }
  ],
