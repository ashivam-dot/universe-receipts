{
  "id": "ep462",
  "duration": 27.713,
  "beats": [
    {
      "start": 0.08,
      "end": 3.78,
      "text": "The Milky Way's black hole erupted 350 years ago.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Flaring Disk Around Milky Way's Black Hole (Artist's Concept) (2025-110).tiff",
        "credit": "Illustration NASA, ESA, CSA, Ralf Crawford (STScI)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Flaring_Disk_Around_Milky_Way%27s_Black_Hole_(Artist%27s_Concept)_(2025-110).tiff"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.767,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.78,
      "end": 7.42,
      "text": "It usually sits quiet, four million times heavier than our Sun.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Centre of the Milky Way.jpg",
        "credit": "Stefan Gillessen, Reinhard Genzel, Frank Eisenhauer",
        "license": "CC BY 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:Centre_of_the_Milky_Way.jpg"
      },
      "shots": [
        {
          "start": 3.767,
          "end": 7.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.42,
      "end": 10.16,
      "text": "Gas whips around its edge near the speed of light.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "M87* and Sgr A* side-by-side in polarised light (eso2406b).jpg",
        "credit": "EHT Collaboration",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:M87*_and_Sgr_A*_side-by-side_in_polarised_light_(eso2406b).jpg"
      },
      "shots": [
        {
          "start": 7.433,
          "end": 10.167,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.16,
      "end": 13.92,
      "text": "Orbits take mere minutes, making the disk change constantly.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "EHT Sagittarius A black hole.tif",
        "credit": "EHT Collaboration",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:EHT_Sagittarius_A_black_hole.tif"
      },
      "shots": [
        {
          "start": 10.167,
          "end": 13.933,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.92,
      "end": 17.18,
      "text": "Supercomputers needed five full years to build its first image.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "ALMA Antennas on Chajnantor.jpg",
        "credit": "Iztok Bon\u010dina/ESO",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:ALMA_Antennas_on_Chajnantor.jpg"
      },
      "shots": [
        {
          "start": 13.933,
          "end": 15.267,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 15.267,
          "end": 17.167,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.18,
      "end": 20.8,
      "text": "Then astronomers found X-rays echoing off a nearby gas cloud.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Sagittarius B2 (MIRI image) ESA512824.tiff",
        "credit": "European Space Agency",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Sagittarius_B2_(MIRI_image)_ESA512824.tiff"
      },
      "shots": [
        {
          "start": 17.167,
          "end": 20.8,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.8,
      "end": 24.46,
      "text": "The echo revealed a blast one million times brighter than now.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Sagittarius B2 (MIRI image) ESA512824.tiff",
        "credit": "European Space Agency",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Sagittarius_B2_(MIRI_image)_ESA512824.tiff"
      },
      "shots": [
        {
          "start": 20.8,
          "end": 24.467,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.46,
      "end": 27.363,
      "text": "That sleeping monster can wake up at any moment.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Flaring Disk Around Milky Way's Black Hole (Artist's Concept) (2025-110).tiff",
        "credit": "Illustration NASA, ESA, CSA, Ralf Crawford (STScI)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Flaring_Disk_Around_Milky_Way%27s_Black_Hole_(Artist%27s_Concept)_(2025-110).tiff"
      },
      "shots": [
        {
          "start": 24.467,
          "end": 27.7,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
