{
  "id": "ep505",
  "duration": 28.32,
  "beats": [
    {
      "start": 0.08,
      "end": 3.1,
      "text": "Old stars here suck life from neighbors to survive.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Messier 30 Hubble WikiSky.jpg",
        "credit": "en:NASA, en:STScI, en:WikiSky",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Messier_30_Hubble_WikiSky.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.1,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.1,
      "end": 6.54,
      "text": "Messier 30 is a thirteen-billion-year-old dense star cluster.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Portret van Charles Messier, RP-P-1910-6776.jpg",
        "credit": "Rijksmuseum",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Portret_van_Charles_Messier,_RP-P-1910-6776.jpg"
      },
      "shots": [
        {
          "start": 3.1,
          "end": 6.533,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.54,
      "end": 9.54,
      "text": "Its core collapsed into a dense stellar traffic jam.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Portret van Charles Messier, RP-P-1910-6776.jpg",
        "credit": "Rijksmuseum",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Portret_van_Charles_Messier,_RP-P-1910-6776.jpg"
      },
      "shots": [
        {
          "start": 6.533,
          "end": 9.533,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.54,
      "end": 12.22,
      "text": "Half the cluster's mass squeezed into a tiny sphere.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 9.533,
          "end": 12.233,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.22,
      "end": 15.14,
      "text": "Stars collided or entered tight binary loops together.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Messier 30 Hubble WikiSky.jpg",
        "credit": "en:NASA, en:STScI, en:WikiSky",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Messier_30_Hubble_WikiSky.jpg"
      },
      "shots": [
        {
          "start": 12.233,
          "end": 15.133,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.14,
      "end": 19.12,
      "text": "Some became cosmic vampires stealing hydrogen fuel from partners.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Illustration of Mira System (2005-mira-more-3).tiff",
        "credit": "(Credit: NASA/CXC/M.Weiss)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Illustration_of_Mira_System_(2005-mira-more-3).tiff"
      },
      "shots": [
        {
          "start": 15.133,
          "end": 19.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.12,
      "end": 22.1,
      "text": "This fresh mass reversed their aging process completely.",
      "asset": {
        "source": "Flickr via Openverse",
        "title": "Blue Straggler Formation (Illustration)",
        "credit": "NASA Hubble",
        "license": "CC BY 2.0",
        "url": "https://www.flickr.com/photos/144614754@N02/48546281011"
      },
      "shots": [
        {
          "start": 19.133,
          "end": 22.1,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.1,
      "end": 25.34,
      "text": "Hubble images prove these vampires defy cosmic aging rules.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Messier 30 (captured by the Hubble Space Telescope).jpg",
        "credit": "NASA/ESA",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Messier_30_(captured_by_the_Hubble_Space_Telescope).jpg"
      },
      "shots": [
        {
          "start": 22.1,
          "end": 25.333,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.34,
      "end": 27.97,
      "text": "They burn blue again by draining their friends dry.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Messier 30 Hubble WikiSky.jpg",
        "credit": "en:NASA, en:STScI, en:WikiSky",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Messier_30_Hubble_WikiSky.jpg"
      },
      "shots": [
        {
          "start": 25.333,
          "end": 28.333,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    }
