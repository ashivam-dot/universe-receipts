{
  "id": "ep093",
  "duration": 45.508,
  "beats": [
    {
      "start": 0.08,
      "end": 3.083,
      "text": "Think the Moon doesn't spin? That is a total myth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NASA-Apollo8-Dec24-Earthrise.jpg",
        "credit": "NASA/Bill Anders",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:NASA-Apollo8-Dec24-Earthrise.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.083,
      "end": 8.478,
      "text": "Our Moon actually rotates on its axis at the exact same speed it orbits Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Moon phases fr.jpg",
        "credit": "Original work\u00a0: Orion 8\n\nFrench translation\u00a0: Charlestpt",
        "license": "CC BY 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:Moon_phases_fr.jpg"
      },
      "shots": [
        {
          "start": 3.067,
          "end": 8.467,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.478,
      "end": 15.323,
      "text": "This synchronous tidal locking is caused by Earth's gravity stretching the lunar body into physical bulges.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Tidal bulge.png",
        "credit": "Orion 8",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Tidal_bulge.png"
      },
      "shots": [
        {
          "start": 8.467,
          "end": 15.333,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.323,
      "end": 20.493,
      "text": "Gravity pulls on these bulges like a brake, forcing the spin to match the orbit.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Naiad-Thalassa 73-69 orbital resonance.jpg",
        "credit": "NASA / JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Naiad-Thalassa_73-69_orbital_resonance.jpg"
      },
      "shots": [
        {
          "start": 15.333,
          "end": 20.5,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.493,
      "end": 27.138,
      "text": "This constant friction slows the rotation and pushes the Moon away by four centimeters every year.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 20.5,
          "end": 27.133,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 27.138,
      "end": 33.538,
      "text": "We finally saw the far side when the Soviet Luna 3 photographed it in 1959.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Luna-3 (Memorial Museum of Astronautics).JPG",
        "credit": "Armael",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Luna-3_(Memorial_Museum_of_Astronautics).JPG"
      },
      "shots": [
        {
          "start": 27.133,
          "end": 29.533,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 29.533,
          "end": 33.533,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 33.538,
      "end": 38.983,
      "text": "Even Pluto and its moon Charon are mutually caught in this same gravitational grip.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Pluto-Charon-v2-10-1-15.jpg",
        "credit": "NASA / Johns Hopkins University Applied Physics Laboratory / Southwest Research Institute",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Pluto-Charon-v2-10-1-15.jpg"
      },
      "shots": [
        {
          "start": 33.533,
          "end": 36.267,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 36.267,
          "end": 38.967,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 38.983,
      "end": 45.158,
      "text": "This synchronization hides the far side forever, which is why people still believe the Moon doesn't spin.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NASA-Apollo8-Dec24-Earthrise.jpg",
        "credit": "NASA/Bill Anders",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:NASA-Apollo8-Dec24-Earthrise.jpg"
      },
      "shots": [
        {
          "start": 38.967,
          "end": 45.5,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
