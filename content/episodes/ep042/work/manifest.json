{
  "id": "ep042",
  "duration": 48.088,
  "beats": [
    {
      "start": 0.08,
      "end": 3.696,
      "text": "Earth fills just 0.12 of a single pixel.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Pale Blue Dot.png",
        "credit": "Voyager 1",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Pale_Blue_Dot.png"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.7,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.696,
      "end": 11.241,
      "text": "Astronomer Carl Sagan persistently urged the mission team to look back from approximately 4 billion miles away.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Sagan large.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Sagan_large.jpg"
      },
      "shots": [
        {
          "start": 3.7,
          "end": 7.467,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 7.467,
          "end": 11.233,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.241,
      "end": 19.011,
      "text": "NASA officials originally resisted taking the photo, fearing camera damage and noting it lacked scientific value.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyager spacecraft (cropped).jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Voyager_spacecraft_(cropped).jpg"
      },
      "shots": [
        {
          "start": 11.233,
          "end": 13.967,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 13.967,
          "end": 19.0,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.011,
      "end": 25.931,
      "text": "The historic shot was part of a massive sixty-frame Family Portrait sequence capturing six major planets.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyager Portrait Family diagram.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Voyager_Portrait_Family_diagram.jpg"
      },
      "shots": [
        {
          "start": 19.0,
          "end": 25.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.931,
      "end": 32.851,
      "text": "While Earth appears to comfortably sit in a dramatic beam of light, that beam is actually an optical artifact.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "View of the Sun, Earth and Venus from Voyager 1.png",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:View_of_the_Sun,_Earth_and_Venus_from_Voyager_1.png"
      },
      "shots": [
        {
          "start": 25.933,
          "end": 28.8,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 28.8,
          "end": 32.867,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 32.851,
      "end": 38.776,
      "text": "Sunlight reflecting directly off the camera hardware created the famous sunbeam.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyager trajectories.jpg",
        "credit": "Stauriko",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Voyager_trajectories.jpg"
      },
      "shots": [
        {
          "start": 32.867,
          "end": 38.767,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 38.776,
      "end": 47.738,
      "text": "Mission control then permanently powered down the cameras, ensuring that our home planet permanently fills just 0.12 of a single pixel.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Pale Blue Dot.png",
        "credit": "Voyager 1",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Pale_Blue_Dot.png"
      },
      "shots": [
        {
          "start": 38.767,
          "end": 48.1,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
