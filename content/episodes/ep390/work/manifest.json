{
  "id": "ep390",
  "duration": 38.287,
  "beats": [
    {
      "start": 0.08,
      "end": 4.6,
      "text": "An invisible dead star is devouring a fast-spinning giant star.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist\u2019s impression of the WDJ0914+1914 system.tif",
        "credit": "ESO/M. Kornmesser",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%E2%80%99s_impression_of_the_WDJ0914%2B1914_system.tif"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.3,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 2.3,
          "end": 4.6,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.6,
      "end": 9.16,
      "text": "Astronomers long believed Gamma Cassiopeiae was just a solitary giant.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Cassiopeia (Annotated) (cassiopeia-ann).jpg",
        "credit": "E. Slawik/NOIRLab/NSF/AURA/M. Zamani",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Cassiopeia_(Annotated)_(cassiopeia-ann).jpg"
      },
      "shots": [
        {
          "start": 4.6,
          "end": 9.167,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.16,
      "end": 13.12,
      "text": "This massive star spins so fast it flings out gas.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA21418 - The Rapid Burster, Figure 1.jpg",
        "credit": "ESA/ATG medialab",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA21418_-_The_Rapid_Burster,_Figure_1.jpg"
      },
      "shots": [
        {
          "start": 9.167,
          "end": 13.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.12,
      "end": 16.68,
      "text": "For decades, powerful X-rays from the system defied explanation.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "M33 X-7- Heaviest Stellar Black Hole Discovered in Nearby Galaxy (2007-m33x7 - m33x7).tiff",
        "credit": "Illustration: NASA/CXC/M.Weiss; X-ray: NASA/CXC/CfA/P.Plucinsky et al.; Optical: NASA/STScI/SDSU/J.Orosz et al.",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:M33_X-7-_Heaviest_Stellar_Black_Hole_Discovered_in_Nearby_Galaxy_(2007-m33x7_-_m33x7).tiff"
      },
      "shots": [
        {
          "start": 13.133,
          "end": 15.3,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 15.3,
          "end": 16.667,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.68,
      "end": 21.02,
      "text": "Observations by the XRISM space telescope finally solved the mystery.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "XRISM Reveals Its First Look at X-ray Cosmos (SVS14492 - XRISM Spacecraft).png",
        "credit": "NASA's Scientific Visualization Studio - Francis Reddy, Jeanette Kazmierczak, Scott Wiessinger, Sophia Roberts",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:XRISM_Reveals_Its_First_Look_at_X-ray_Cosmos_(SVS14492_-_XRISM_Spacecraft).png"
      },
      "shots": [
        {
          "start": 16.667,
          "end": 18.267,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 18.267,
          "end": 21.033,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.02,
      "end": 25.36,
      "text": "An Earth-sized white dwarf companion orbits inside that gas disk.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 21.033,
          "end": 25.367,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.36,
      "end": 29.36,
      "text": "The X-rays flare as the white dwarf consumes the stellar material.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Accretion Disk Binary System.jpg",
        "credit": "Unknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Accretion_Disk_Binary_System.jpg"
      },
      "shots": [
        {
          "start": 25.367,
          "end": 29.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 29.36,
      "end": 33.48,
      "text": "Apollo astronauts nicknamed this star Navi for Gus Grissom in 1967.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Virgil I. (Gus) Grissom portrait.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Virgil_I._(Gus)_Grissom_portrait.jpg"
      },
      "shots": [
        {
          "start": 29.367,
          "end": 31.933,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 31.933,
          "end": 33.467,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 33.48,
      "end": 37.937,
      "text": "In the constellation Cassiopeia, this hidden companion consumes its neighbor.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist\u2019s impression of the WDJ0914+1914 system.tif",
        "credit": "ESO/M. Kornmesser",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%E2%80%99s_impression_of_the_WDJ0914%2B1914_system.tif"
      },
      "shots": [
        {
          "start": 33.467,
