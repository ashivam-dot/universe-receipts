  "duration": 56.682,
  "beats": [
    {
      "start": 0.08,
      "end": 4.846,
      "text": "The first lunar soft landing shattered fears of a swallowing dust ocean.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "First Photo from the Surface of the Moon.jpg",
        "credit": "\"Image Credit: National Space Science Data Center\" (NASA, USA); original image from Luna 9 (USSR)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:First_Photo_from_the_Surface_of_the_Moon.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.833,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.846,
      "end": 10.541,
      "text": "Early scientists theorized deep dust would cause incoming landers to sink out of sight.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "LUNAR LANDING - ART CONCEPT (S69-33765).jpg",
        "credit": "NASA Johnson Space Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:LUNAR_LANDING_-_ART_CONCEPT_(S69-33765).jpg"
      },
      "shots": [
        {
          "start": 4.833,
          "end": 6.833,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 6.833,
          "end": 10.533,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.541,
      "end": 16.361,
      "text": "NASA launched Surveyor probes directly on impact trajectories toward the lunar surface.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Atlas Centaur launch.jpg",
        "credit": "Unknown authorUnknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Atlas_Centaur_launch.jpg"
      },
      "shots": [
        {
          "start": 10.533,
          "end": 16.367,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.361,
      "end": 23.161,
      "text": "On June 2, 1966, Surveyor 1 touched down, resting solidly on its footpads.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "AS12-48-7119 (21631269876).jpg",
        "credit": "Project Apollo Archive",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:AS12-48-7119_(21631269876).jpg"
      },
      "shots": [
        {
          "start": 16.367,
          "end": 18.9,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 18.9,
          "end": 23.167,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.161,
      "end": 29.931,
      "text": "Robotic sampler scoops excavated trenches, proving the regolith easily supported heavy spacecraft.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Apollo 12 - Surveyor Scoop Arm.webp",
        "credit": "NASA/Al Bean/Dave Byrne (Panorama assembly)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Apollo_12_-_Surveyor_Scoop_Arm.webp"
      },
      "shots": [
        {
          "start": 23.167,
          "end": 29.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 29.931,
      "end": 36.501,
      "text": "Then after sunset, Surveyor 7 photographed an unexpected twilight glow along the horizon.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 29.933,
          "end": 36.5,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 36.501,
      "end": 44.626,
      "text": "Sunlight was scattering off levitating dust grains, electrostatically charged as the Moon crossed Earth's magnetotail.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Psjad06aff3 hr.jpg",
        "credit": "Lianghai Xie,\u00a0Lei Li,\u00a0Huizi Wang,\u00a0Binbin Tang,\u00a0Jindong Wang,\u00a0Yiteng Zhang,\u00a0Quanqi Shi,\u00a0Bin Zhou\u00a0and\u00a0Yongyong Feng",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Psjad06aff3_hr.jpg"
      },
      "shots": [
        {
          "start": 36.5,
          "end": 44.633,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 44.626,
      "end": 51.346,
      "text": "In November 1969, Apollo 12 astronauts found Surveyor 3 completely coated in this grit.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "AS12-48-7134 (21469496838).jpg",
        "credit": "Project Apollo Archive",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:AS12-48-7134_(21469496838).jpg"
      },
      "shots": [
        {
          "start": 44.633,
          "end": 47.267,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 47.267,
          "end": 51.333,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 51.346,
      "end": 56.332,
      "text": "The real lunar hazard was floating above the ground, not waiting to swallow ships whole.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "First Photo from the Surface of the Moon.jpg",
        "credit": "\"Image Credit: National Space Science Data Center\" (NASA, USA); original image from Luna 9 (USSR)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:First_Photo_from_the_Surface_of_the_Moon.jpg"
      },
      "shots": [
        {
          "start": 51.333,
          "end": 56.667,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
