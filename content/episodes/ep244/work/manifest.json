{
  "id": "ep244",
  "duration": 50.436,
  "beats": [
    {
      "start": 0.08,
      "end": 4.668,
      "text": "Early space scientists feared the Moon was a deep, swallowing dust ocean.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Buzz Aldrin's bootprint on the Moon, AS11-40-5877.jpg",
        "credit": "Buzz Aldrin",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Buzz_Aldrin%27s_bootprint_on_the_Moon,_AS11-40-5877.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.867,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 2.867,
          "end": 4.667,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.668,
      "end": 10.063,
      "text": "This theory suggested heavy landers would sink completely out of sight upon touchdown.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 4.667,
          "end": 10.067,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.063,
      "end": 16.258,
      "text": "In 1966, the Soviet Union's Luna 9 probe achieved the first soft landing.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "First Photo from the Surface of the Moon.jpg",
        "credit": "\"Image Credit: National Space Science Data Center\" (NASA, USA); original image from Luna 9 (USSR)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:First_Photo_from_the_Surface_of_the_Moon.jpg"
      },
      "shots": [
        {
          "start": 10.067,
          "end": 16.267,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.258,
      "end": 22.028,
      "text": "NASA's Surveyor 1 followed months later, resting solidly on the firm lunar surface.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Surveyor NASA lunar lander.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Surveyor_NASA_lunar_lander.jpg"
      },
      "shots": [
        {
          "start": 16.267,
          "end": 22.033,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.028,
      "end": 28.098,
      "text": "Robotic scoops excavated trenches, proving the regolith could easily support a crewed lander.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Apollo 12 Mission image - View of the Surveyor III craft,which landed April 19,1967 (as12-48-7110).jpg",
        "credit": "NASA Johnson Space Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Apollo_12_Mission_image_-_View_of_the_Surveyor_III_craft,which_landed_April_19,1967_(as12-48-7110).jpg"
      },
      "shots": [
        {
          "start": 22.033,
          "end": 25.067,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 25.067,
          "end": 28.1,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 28.098,
      "end": 34.393,
      "text": "But after sunset, Surveyor 7 captured a strange, unexpected glow along the horizon.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "AS15-95-12997 contast enhanced.jpg",
        "credit": "James Stuby based on NASA image",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:AS15-95-12997_contast_enhanced.jpg"
      },
      "shots": [
        {
          "start": 28.1,
          "end": 34.4,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 34.393,
      "end": 40.893,
      "text": "Sunlight was scattering off razor-sharp dust grains levitating miles above the airless ground.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Apollo 17 orange soil at Shorty Crater AS17-137-20990HR.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Apollo_17_orange_soil_at_Shorty_Crater_AS17-137-20990HR.jpg"
      },
      "shots": [
        {
          "start": 34.4,
          "end": 37.733,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 37.733,
          "end": 40.9,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 40.893,
      "end": 46.638,
      "text": "This grit is electrostatically charged as the Moon passes through Earth's magnetic tail.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Psjad06aff3 hr.jpg",
        "credit": "Lianghai Xie,\u00a0Lei Li,\u00a0Huizi Wang,\u00a0Binbin Tang,\u00a0Jindong Wang,\u00a0Yiteng Zhang,\u00a0Quanqi Shi,\u00a0Bin Zhou\u00a0and\u00a0Yongyong Feng",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Psjad06aff3_hr.jpg"
      },
      "shots": [
        {
          "start": 40.9,
          "end": 46.633,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 46.638,
      "end": 50.086,
      "text": "The real lunar hazard was actually floating in the sky.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Buzz Aldrin's bootprint on the Moon, AS11-40-5877.jpg",
        "credit": "Buzz Aldrin",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Buzz_Aldrin%27s_bootprint_on_the_Moon,_AS11-40-5877.jpg"
      },
      "shots": [
        {
          "start": 46.633,
          "end": 50.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
