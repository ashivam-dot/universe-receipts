{
  "id": "ep396",
  "duration": 30.654,
  "beats": [
    {
      "start": 0.08,
      "end": 3.82,
      "text": "Meteors fell across North America for nine hours straight.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Leonids-1833.jpg",
        "credit": "Adolf Vollmy",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Leonids-1833.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.833,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.82,
      "end": 7.96,
      "text": "Eyewitnesses watched thousands of stars fall just like snow in 1833.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Trouvelot - The November Meteors.jpg",
        "credit": "\u00c9tienne L\u00e9opold Trouvelot",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Trouvelot_-_The_November_Meteors.jpg"
      },
      "shots": [
        {
          "start": 3.833,
          "end": 7.967,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.96,
      "end": 11.78,
      "text": "Scientists then believed shooting stars were just weird atmospheric weather.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Leonid Meteor.jpg",
        "credit": "Navicore",
        "license": "CC BY 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:Leonid_Meteor.jpg"
      },
      "shots": [
        {
          "start": 7.967,
          "end": 9.867,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 9.867,
          "end": 11.767,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.78,
      "end": 16.04,
      "text": "But Yale professor Denison Olmsted noticed something revolutionary about the storm.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Nathaniel Jocelyn - Denison Olmsted (1791-1859), B. A. 1813, M. A. 1816 - 1833.3 - Yale University Art Gallery.jpg",
        "credit": "Nathaniel Jocelyn",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Nathaniel_Jocelyn_-_Denison_Olmsted_(1791-1859),_B._A._1813,_M._A._1816_-_1833.3_-_Yale_University_Art_Gallery.jpg"
      },
      "shots": [
        {
          "start": 11.767,
          "end": 16.033,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.04,
      "end": 20.0,
      "text": "Every single meteor appeared to radiate from one specific point in Leo.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Leo constellation 83.png",
        "credit": "Roberto Mura - ru:User:Dionys",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Leo_constellation_83.png"
      },
      "shots": [
        {
          "start": 16.033,
          "end": 20.0,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.0,
      "end": 23.16,
      "text": "Olmsted proved they're actually pieces of space rock, not weather.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Comet Temple-Tuttle u4jm0404r.fits.gz sci.jpg",
        "credit": "Hubble Space Telescope",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Comet_Temple-Tuttle_u4jm0404r.fits.gz_sci.jpg"
      },
      "shots": [
        {
          "start": 20.0,
          "end": 23.167,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.16,
      "end": 26.68,
      "text": "This one night proved Earth was flying through a cosmic debris field.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The story of the comets - Orbit of the leonids on nov. 13 and of the comet of 1866 (i.) relatively to the orbits of certain planets.jpg",
        "credit": "George Frederick Chambers",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:The_story_of_the_comets_-_Orbit_of_the_leonids_on_nov._13_and_of_the_comet_of_1866_(i.)_relatively_to_the_orbits_of_certain_planets.jpg"
      },
      "shots": [
        {
          "start": 23.167,
          "end": 26.667,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 26.68,
      "end": 30.304,
      "text": "Modern meteor science exists today all because of that historic night.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Leonids-1833.jpg",
        "credit": "Adolf Vollmy",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Leonids-1833.jpg"
      },
      "shots": [
        {
          "start": 26.667,
          "end": 30.667,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    }
  ],
