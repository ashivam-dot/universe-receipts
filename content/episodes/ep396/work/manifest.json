{
  "id": "ep396",
  "duration": 26.366,
  "beats": [
    {
      "start": 0.08,
      "end": 3.92,
      "text": "Meteors fell across North America for nine hours straight.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Leonids-1833.jpg",
        "credit": "Adolf Vollmy",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Leonids-1833.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.933,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.92,
      "end": 8.08,
      "text": "Terrified onlookers feared the end of the world as stars fell like rain.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Leonid Meteor.jpg",
        "credit": "Navicore",
        "license": "CC BY 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:Leonid_Meteor.jpg"
      },
      "shots": [
        {
          "start": 3.933,
          "end": 8.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.08,
      "end": 11.52,
      "text": "At the time, scientists believed shooting stars were just atmospheric weather.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Meteoroiden.jpg",
        "credit": "Herbert Bolz",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Meteoroiden.jpg"
      },
      "shots": [
        {
          "start": 8.067,
          "end": 11.533,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.52,
      "end": 15.92,
      "text": "Yale professor Denison Olmsted noticed every meteor radiated from a single point.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Nathaniel Jocelyn - Denison Olmsted (1791-1859), B. A. 1813, M. A. 1816 - 1833.3 - Yale University Art Gallery.jpg",
        "credit": "Nathaniel Jocelyn",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Nathaniel_Jocelyn_-_Denison_Olmsted_(1791-1859),_B._A._1813,_M._A._1816_-_1833.3_-_Yale_University_Art_Gallery.jpg"
      },
      "shots": [
        {
          "start": 11.533,
          "end": 15.933,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.92,
      "end": 20.18,
      "text": "He proved meteors originated from a debris cloud in outer space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Leo constellation 83.png",
        "credit": "Roberto Mura - ru:User:Dionys",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Leo_constellation_83.png"
      },
      "shots": [
        {
          "start": 15.933,
          "end": 20.167,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.18,
      "end": 23.94,
      "text": "That terrifying storm launched the modern science of meteors.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Four views of the Leonid meteor shower of 1966 Noao-4127A.jpg",
        "credit": "NOIRLab/NSF/AURA",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Four_views_of_the_Leonid_meteor_shower_of_1966_Noao-4127A.jpg"
      },
      "shots": [
        {
          "start": 20.167,
          "end": 23.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.94,
      "end": 26.016,
      "text": "Meteors fell across North America.",
