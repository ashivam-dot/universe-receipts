{
  "id": "ep446",
  "duration": 34.594,
  "beats": [
    {
      "start": 0.08,
      "end": 2.88,
      "text": "The Sun is not actually on fire.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Image of Sun From NASA\u2019s Solar Dynamics Observatory (PIA26681).tiff",
        "credit": "NASA/GSFC/Solar Dynamics Observatory",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Image_of_Sun_From_NASA%E2%80%99s_Solar_Dynamics_Observatory_(PIA26681).tiff"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.867,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 2.88,
      "end": 6.36,
      "text": "Picture a campfire, then a forest fire the size of Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Campfire at Bramble Bield.jpg",
        "credit": "Alasdair",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Campfire_at_Bramble_Bield.jpg"
      },
      "shots": [
        {
          "start": 2.867,
          "end": 6.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.36,
      "end": 8.88,
      "text": "Neither could burn in space without any oxygen.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Lick Fire on the Umatilla National Forest burning at night.jpg",
        "credit": "U.S. Forest Service- Pacific Northwest Region",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Lick_Fire_on_the_Umatilla_National_Forest_burning_at_night.jpg"
      },
      "shots": [
        {
          "start": 6.367,
          "end": 8.867,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.88,
      "end": 12.62,
      "text": "Arthur Eddington proposed in 1920 that stars run on fusion.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Prof. Arthur S. Eddington LCCN2014718210.jpg",
        "credit": "Bain News Service, publisher",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Prof._Arthur_S._Eddington_LCCN2014718210.jpg"
      },
      "shots": [
        {
          "start": 8.867,
          "end": 12.633,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.62,
      "end": 16.68,
      "text": "It crushes hydrogen into helium at 15 million kelvin.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Pict--proton-proton-chain-reaction-diagram-proton-proton-chain-reaction-diagram.png",
        "credit": "CS Odessa",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Pict--proton-proton-chain-reaction-diagram-proton-proton-chain-reaction-diagram.png"
      },
      "shots": [
        {
          "start": 12.633,
          "end": 16.667,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.68,
      "end": 20.88,
      "text": "But the reaction in the solar core is surprisingly sluggish.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Released to Public Arist's Concept of the Layers of the Sun (NASA) (450837342).jpg",
        "credit": "pingnews.com",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Released_to_Public_Arist%27s_Concept_of_the_Layers_of_the_Sun_(NASA)_(450837342).jpg"
      },
      "shots": [
        {
          "start": 16.667,
          "end": 20.867,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.88,
      "end": 24.6,
      "text": "One cubic meter of that core generates just 276 watts.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Sun parts.jpg",
        "credit": "Project leader: Dr. Jim Lochner; Curator: Meredith Gibb; Responsible NASA Official:Phil Newman\nderivative work: Hic et nunc",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Sun_parts.jpg"
      },
      "shots": [
        {
          "start": 20.867,
          "end": 24.6,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.6,
      "end": 28.26,
      "text": "That's less volumetric heat than a resting human body.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Termoim\u00e1genes 4 (2784767950).jpg",
        "credit": "Ana Yacobi",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Termoim%C3%A1genes_4_(2784767950).jpg"
      },
      "shots": [
        {
          "start": 24.6,
          "end": 28.267,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 28.26,
      "end": 31.34,
      "text": "You\u2019re technically a more efficient heater than the Sun.",
      "asset": {
        "source": "Wellcome Collection",
        "title": "Apollo riding the chariot of the Sun across the heavens. Engraving by J. Sadeler after M. de Vos.",
        "credit": "Wellcome Collection",
        "license": "Public domain",
        "url": "https://wellcomecollection.org/works/by597d3r"
      },
      "shots": [
        {
          "start": 28.267,
          "end": 31.333,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 31.34,
      "end": 34.244,
      "text": "Our star is simply too big to be on fire.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Image of Sun From NASA\u2019s Solar Dynamics Observatory (PIA26681).tiff",
        "credit": "NASA/GSFC/Solar Dynamics Observatory",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Image_of_Sun_From_NASA%E2%80%99s_Solar_Dynamics_Observatory_(PIA26681).tiff"
      },
      "shots": [
        {
          "start": 31.333,
          "end": 34.6,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
