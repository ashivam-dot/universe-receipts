{
  "id": "ep237",
  "duration": 53.264,
  "beats": [
    {
      "start": 0.08,
      "end": 3.497,
      "text": "A city-killer asteroid missed Earth by just six hours.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA21259 - Celestial Object 2016 WF9, a NEOWISE Discovery (Artist Concept).jpg",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA21259_-_Celestial_Object_2016_WF9,_a_NEOWISE_Discovery_(Artist_Concept).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.167,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 2.167,
          "end": 3.5,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.497,
      "end": 11.842,
      "text": "Most people naturally assume our global detection networks would spot such a terrifying space hazard approaching days in advance.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "California - Palomar Observator through Parker Dam - NARA - 23934813.jpg",
        "credit": "Unknown authorUnknown author or not provided",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:California_-_Palomar_Observator_through_Parker_Dam_-_NARA_-_23934813.jpg"
      },
      "shots": [
        {
          "start": 3.5,
          "end": 7.667,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 7.667,
          "end": 11.833,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.842,
      "end": 22.187,
      "text": "On March 22, 1989, the 300-meter space rock named 4581 Asclepius crossed our orbital path completely unseen.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "California - Palomar Observator through Parker Dam - NARA - 23934813.jpg",
        "credit": "Unknown authorUnknown author or not provided",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:California_-_Palomar_Observator_through_Parker_Dam_-_NARA_-_23934813.jpg"
      },
      "shots": [
        {
          "start": 11.833,
          "end": 22.2,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.187,
      "end": 29.962,
      "text": "Astronomers Henry Holt and Norman Thomas only discovered the asteroid nine days after it had already swept past.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 22.2,
          "end": 29.967,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 29.962,
      "end": 36.607,
      "text": "The massive object swept past us at a distance of roughly 684,000 kilometers.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 29.967,
          "end": 36.6,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 36.607,
      "end": 44.227,
      "text": "Geophysicists estimated a direct impact would have unleashed a devastating 600-megaton atomic blast.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 36.6,
          "end": 44.233,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 44.227,
      "end": 52.914,
      "text": "This terrifying blind spot drove the creation of modern planetary defense programs to ensure we catch every single city-killer asteroid.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA21259 - Celestial Object 2016 WF9, a NEOWISE Discovery (Artist Concept).jpg",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA21259_-_Celestial_Object_2016_WF9,_a_NEOWISE_Discovery_(Artist_Concept).jpg"
      },
      "shots": [
        {
          "start": 44.233,
          "end": 53.267,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
