          "start": 0.0,
          "end": 4.667,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.651,
      "end": 12.246,
      "text": "Discovered by Dutch schoolteacher Hanny van Arkel, this phantom sits near the galaxy IC 2497.",
      "asset": {
        "source": "Flickr via Openverse",
        "title": "2012_02_110014 Hanny van Arkel, discoverer of the Voorwerp",
        "credit": "Gwydion M. Williams",
        "license": "CC BY 2.0",
        "url": "https://www.flickr.com/photos/45909111@N00/6864356515"
      },
      "shots": [
        {
          "start": 4.667,
          "end": 9.9,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 9.9,
          "end": 12.233,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.246,
      "end": 19.191,
      "text": "Located 650 million light-years away in Leo Minor, the structure shines with a striking green glow.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Leo Minor (Annotated) (leo-minor-ann).jpg",
        "credit": "E. Slawik/NOIRLab/NSF/AURA/M. Zamani",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Leo_Minor_(Annotated)_(leo-minor-ann).jpg"
      },
      "shots": [
        {
          "start": 12.233,
          "end": 15.233,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 15.233,
          "end": 19.2,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.191,
      "end": 26.386,
      "text": "Astronomers investigated with the Hubble Space Telescope and found an apparent hole 20,000 light-years wide.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hanny's Voorwerp (34659054093).png",
        "credit": "geckzilla",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Hanny%27s_Voorwerp_(34659054093).png"
      },
      "shots": [
        {
          "start": 19.2,
          "end": 21.867,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 21.867,
          "end": 26.4,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 26.386,
      "end": 31.981,
      "text": "Yet, nothing inside the massive structure was producing enough energy to light it up.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Heic1507h.jpg",
        "credit": "Hubble Space Telescope",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Heic1507h.jpg"
      },
      "shots": [
        {
          "start": 26.4,
          "end": 29.4,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 29.4,
          "end": 31.967,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 31.981,
      "end": 37.181,
      "text": "The explanation is terrifying: we are looking at the ghost of a dead quasar.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Light Echoes (Artist's impression).jpg",
        "credit": "ESO",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Light_Echoes_(Artist%27s_impression).jpg"
      },
      "shots": [
        {
          "start": 31.967,
          "end": 35.033,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 35.033,
          "end": 37.167,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 37.181,
      "end": 45.201,
      "text": "Over 100,000 years ago, a supermassive black hole in IC 2497 blasted a monstrous beam.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Scenario for Mysterious Light Beams from Active Galaxy (2020-58-4781).jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Scenario_for_Mysterious_Light_Beams_from_Active_Galaxy_(2020-58-4781).jpg"
      },
      "shots": [
        {
          "start": 37.167,
          "end": 45.2,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 45.201,
      "end": 51.171,
      "text": "That powerhouse has since faded dramatically, but its light is still traveling across deep space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist\u2019s impression of quasar J0313-1806.jpg",
        "credit": "NOIRLab/NSF/AURA/J. da Silva",
