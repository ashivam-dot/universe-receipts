  "beats": [
    {
      "start": 0.08,
      "end": 3.64,
      "text": "An astronaut threw a 350-pound solar panel into space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "STS-61 Cast-off- Releasing a Solar Array.jpg",
        "credit": "NASA or National Aeronautics and Space Administration",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:STS-61_Cast-off-_Releasing_a_Solar_Array.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 1.8,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 1.8,
          "end": 3.633,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.64,
      "end": 6.5,
      "text": "High over Somalia, she simply released it into the dark.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "STS-61 Cast-off- Releasing a Solar Array.jpg",
        "credit": "NASA or National Aeronautics and Space Administration",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:STS-61_Cast-off-_Releasing_a_Solar_Array.jpg"
      },
      "shots": [
        {
          "start": 3.633,
          "end": 6.5,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.5,
      "end": 9.22,
      "text": "Shuttle Endeavour had grappled Hubble to fix its blurry mirror.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hubble Space Telescope Berthed in Endeavour's Payload Bay after Capture (28051108701).jpg",
        "credit": "NASA Hubble Space Telescope",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Hubble_Space_Telescope_Berthed_in_Endeavour%27s_Payload_Bay_after_Capture_(28051108701).jpg"
      },
      "shots": [
        {
          "start": 6.5,
          "end": 9.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.22,
      "end": 12.44,
      "text": "Astronaut Jeffrey Hoffman spotted a solar array bent ninety degrees.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "STS-51-D Griggs and Hoffman attach tools to RMS.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:STS-51-D_Griggs_and_Hoffman_attach_tools_to_RMS.jpg"
      },
      "shots": [
        {
          "start": 9.233,
          "end": 12.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.44,
      "end": 15.5,
      "text": "The damaged wing wobbled sixteen times every day in orbit.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 12.433,
          "end": 15.5,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.5,
      "end": 18.44,
      "text": "Astronauts unmounted the array at night to avoid electrical shocks.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Installation of COSTAR on Hubble Space Telescope during STS-61 (27514165734).jpg",
        "credit": "NASA Hubble Space Telescope",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Installation_of_COSTAR_on_Hubble_Space_Telescope_during_STS-61_(27514165734).jpg"
      },
      "shots": [
        {
          "start": 15.5,
          "end": 17.4,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 17.4,
          "end": 18.433,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.44,
      "end": 21.94,
      "text": "Stowing that twisted panel in Endeavour's payload bay was impossible.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hubble Space Telescope Being Surveyed by Cameras on Space Shuttle Endeavour's Arm (28051110831).jpg",
        "credit": "NASA Hubble Space Telescope",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Hubble_Space_Telescope_Being_Surveyed_by_Cameras_on_Space_Shuttle_Endeavour%27s_Arm_(28051110831).jpg"
      },
      "shots": [
        {
          "start": 18.433,
          "end": 20.2,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 20.2,
          "end": 21.933,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.94,
      "end": 25.22,
      "text": "So astronaut Kathy Thornton shoved the solar array into orbit.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "STS061-96-052 - Story Musgrave on RMS during STS-61 (Raw scan).tif",
        "credit": "Earth Science and Remote Sensing Unit, NASA Johnson Space Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:STS061-96-052_-_Story_Musgrave_on_RMS_during_STS-61_(Raw_scan).tif"
      },
      "shots": [
        {
          "start": 21.933,
          "end": 25.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.22,
      "end": 27.261,
      "text": "It safely burned up in Earth's atmosphere.",
