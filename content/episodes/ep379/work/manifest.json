{
  "id": "ep379",
  "duration": 29.423,
  "beats": [
    {
      "start": 0.08,
      "end": 3.06,
      "text": "The coldest atmosphere isn't on the planet farthest away.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Uranus - January 22 1986 (26534993078).jpg",
        "credit": "Kevin Gill from Los Angeles, CA, United States",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Uranus_-_January_22_1986_(26534993078).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.06,
      "end": 8.16,
      "text": "Uranus hits minus 371 degrees Fahrenheit even though Neptune is farther.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Solar sys8 numbered.jpg",
        "credit": "Harman Smith and Laura Generosa (nee Berwin), graphic artists and contractors to NASA's Jet Propulsion Laboratory, with Pluto removed by User:Frokor and nubers added by User:HenkvD",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Solar_sys8_numbered.jpg"
      },
      "shots": [
        {
          "start": 3.067,
          "end": 5.567,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 5.567,
          "end": 8.167,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.16,
      "end": 11.42,
      "text": "Methane gas absorbs red light, turning the world blue-green.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA00032 Uranus in True and False Color.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA00032_Uranus_in_True_and_False_Color.jpg"
      },
      "shots": [
        {
          "start": 8.167,
          "end": 11.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.42,
      "end": 14.52,
      "text": "A giant collision likely knocked the entire planet sideways.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist's concept of collision at HD 172555.jpg",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%27s_concept_of_collision_at_HD_172555.jpg"
      },
      "shots": [
        {
          "start": 11.433,
          "end": 14.533,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.52,
      "end": 18.4,
      "text": "This ice giant orbits on its side every 84 years.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA01278 Hubble Tracks Clouds on Uranus.jpg",
        "credit": "NASA/JPL/STScI",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA01278_Hubble_Tracks_Clouds_on_Uranus.jpg"
      },
      "shots": [
        {
          "start": 14.533,
          "end": 18.4,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.4,
      "end": 22.12,
      "text": "NASA's Voyager 2 swept past this frozen giant in 1986.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyager testing at JPL.jpg",
        "credit": "JOHN GREGOIRE, NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Voyager_testing_at_JPL.jpg"
      },
      "shots": [
        {
          "start": 18.4,
          "end": 22.133,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.12,
      "end": 25.8,
      "text": "Voyager found its magnetic center offset by a third of its radius.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Alien aurorae on Uranus (remastered).jpg",
        "credit": "ESA/Hubble & NASA, L. Lam",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Alien_aurorae_on_Uranus_(remastered).jpg"
      },
      "shots": [
        {
          "start": 22.133,
          "end": 25.8,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.8,
      "end": 29.073,
      "text": "It holds the record for the solar system's coldest atmosphere.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Uranus - January 22 1986 (26534993078).jpg",
        "credit": "Kevin Gill from Los Angeles, CA, United States",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Uranus_-_January_22_1986_(26534993078).jpg"
      },
      "shots": [
        {
          "start": 25.8,
          "end": 29.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
