{
  "id": "ep379",
  "duration": 33.385,
  "beats": [
    {
      "start": 0.08,
      "end": 2.72,
      "text": "Uranus has the coldest atmosphere of any planet.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Uranus - January 22 1986 (26534993078).jpg",
        "credit": "Kevin Gill from Los Angeles, CA, United States",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Uranus_-_January_22_1986_(26534993078).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.733,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 2.72,
      "end": 7.16,
      "text": "Its atmospheric temperature plunges to minus 371 degrees Fahrenheit.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Bright Clouds on Uranus (1998-35-719).jpg",
        "credit": "Erich Karkoschka (University of Arizona) and NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Bright_Clouds_on_Uranus_(1998-35-719).jpg"
      },
      "shots": [
        {
          "start": 2.733,
          "end": 4.567,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 4.567,
          "end": 7.167,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.16,
      "end": 10.2,
      "text": "It holds that record despite being only seventh from the Sun.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Solar System graphic by NASA.png",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Solar_System_graphic_by_NASA.png"
      },
      "shots": [
        {
          "start": 7.167,
          "end": 10.2,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.2,
      "end": 13.82,
      "text": "Methane gas absorbs red light, turning this freezing world blue-green.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Visible Uranus 1986-01-15 (39162858512).png",
        "credit": "geckzilla",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Visible_Uranus_1986-01-15_(39162858512).png"
      },
      "shots": [
        {
          "start": 10.2,
          "end": 13.833,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.82,
      "end": 17.74,
      "text": "An Earth-sized object likely smashed Uranus sideways long ago.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist's concept of collision at HD 172555.jpg",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%27s_concept_of_collision_at_HD_172555.jpg"
      },
      "shots": [
        {
          "start": 13.833,
          "end": 17.733,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.74,
      "end": 21.62,
      "text": "Its extreme tilt subjects the poles to decades of continuous darkness.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Uranus by Hubble Two Decades.png",
        "credit": "NASA/Hubble S.T.A.R.S./ Erich Karkoschka (LPL)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Uranus_by_Hubble_Two_Decades.png"
      },
      "shots": [
        {
          "start": 17.733,
          "end": 21.633,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.62,
      "end": 25.26,
      "text": "Voyager 2 discovered another bizarre planet secret during its 1986 flyby.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyager Development Test Model PIA21731.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Voyager_Development_Test_Model_PIA21731.jpg"
      },
      "shots": [
        {
          "start": 21.633,
          "end": 25.267,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.26,
      "end": 29.04,
      "text": "Its magnetic center is offset by one-third of the planet's radius.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Alien aurorae on Uranus (remastered).jpg",
        "credit": "ESA/Hubble & NASA, L. Lam",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Alien_aurorae_on_Uranus_(remastered).jpg"
      },
      "shots": [
        {
          "start": 25.267,
          "end": 29.033,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 29.04,
      "end": 33.035,
      "text": "Yet no other world in our solar system freezes quite like this.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Uranus - January 22 1986 (26534993078).jpg",
        "credit": "Kevin Gill from Los Angeles, CA, United States",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Uranus_-_January_22_1986_(26534993078).jpg"
      },
      "shots": [
        {
          "start": 29.033,
          "end": 33.4,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
