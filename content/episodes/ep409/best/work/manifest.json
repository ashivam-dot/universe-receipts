  "beats": [
    {
      "start": 0.08,
      "end": 3.72,
      "text": "Three spacecraft will form a triangle wider than the Sun.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "LISA Pathfinder spacecraft model.png",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:LISA_Pathfinder_spacecraft_model.png"
      },
      "shots": [
