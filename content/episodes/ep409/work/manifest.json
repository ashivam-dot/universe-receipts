        }
      ]
    },
    {
      "start": 3.78,
      "end": 6.94,
      "text": "This is LISA, a planned European Space Agency mission.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "LISA Pathfinder spacecraft model.png",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:LISA_Pathfinder_spacecraft_model.png"
      },
      "shots": [
        {
          "start": 3.767,
          "end": 6.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.94,
      "end": 11.36,
      "text": "Each side of the floating constellation stretches 1.6 million miles.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NASA Reveals LISA Engineering Development Unit Telescope (SVS14698 - GSFC 20240520 LISA 000533).jpg",
        "credit": "NASA's Scientific Visualization Studio - University of Maryland College Park/Francis Reddy, eMITS/Scott Wiessinger, ASRC/Dennis J. Henry",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:NASA_Reveals_LISA_Engineering_Development_Unit_Telescope_(SVS14698_-_GSFC_20240520_LISA_000533).jpg"
      },
      "shots": [
        {
          "start": 6.933,
          "end": 9.067,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 9.067,
          "end": 11.367,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.36,
      "end": 15.16,
      "text": "The trio will trail Earth in a heliocentric orbit around the Sun.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Ariane 5 with James Webb Space Telescope Prelaunch (NHQ202112230012).jpg",
        "credit": "Bill Ingalls",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Ariane_5_with_James_Webb_Space_Telescope_Prelaunch_(NHQ202112230012).jpg"
      },
      "shots": [
        {
          "start": 11.367,
          "end": 15.167,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.16,
      "end": 18.66,
      "text": "Gold-platinum cubes will float freely inside every single craft.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "New Simulation Sheds Light on Spiraling Supermassive Black Holes - 31209212018.png",
        "credit": "NASA Goddard Photo and Video",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:New_Simulation_Sheds_Light_on_Spiraling_Supermassive_Black_Holes_-_31209212018.png"
      },
      "shots": [
        {
          "start": 15.167,
          "end": 18.667,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.66,
      "end": 21.82,
      "text": "Lasers will measure spacetime ripples smaller than an atom.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 18.667,
          "end": 21.833,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.82,
      "end": 25.724,
      "text": "That is how a triangle wider than the Sun listens to spacetime.",
