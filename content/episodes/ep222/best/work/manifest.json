  "beats": [
    {
      "start": 0.08,
      "end": 3.722,
      "text": "A massive star is spinning so fast it flings off its surface.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Gamma Cassiopeiae by Kees Scherer.jpg",
        "credit": "Kees Scherer",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Gamma_Cassiopeiae_by_Kees_Scherer.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.733,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.722,
      "end": 12.117,
      "text": "Located 550 light-years away, Gamma Cassiopeiae marks the central point of the celestial W in Cassiopeia.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Cassiopeia (Annotated) (cassiopeia-ann).jpg",
        "credit": "E. Slawik/NOIRLab/NSF/AURA/M. Zamani",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Cassiopeia_(Annotated)_(cassiopeia-ann).jpg"
      },
      "shots": [
        {
          "start": 3.733,
          "end": 9.533,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 9.533,
          "end": 12.133,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.117,
      "end": 19.587,
      "text": "Rotating at roughly 450 kilometers per second, this bulged star is on the brink of structural breakup.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "GPI Circumstellar Disks A Sampling (noirlab2014a).jpg",
        "credit": "International Gemini Observatory/NOIRLab/NSF/AURA/T. Esposito (UC Berkeley). \n\nImage processing: Travis Rector (University of Alaska Anchorage), Mahdi Zamani & Davide de Martin",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:GPI_Circumstellar_Disks_A_Sampling_(noirlab2014a).jpg"
      },
      "shots": [
        {
          "start": 12.133,
          "end": 15.133,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 15.133,
          "end": 19.6,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.587,
      "end": 27.932,
      "text": "Radiating 19,000 times more energy than the Sun, its intense radiation is actively vaporizing nearby nebulae.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "IC 63 Ghost Nebula in Infrared (2018-42-4244).png",
        "credit": "NASA, ESA, and STScI\nAcknowledgment: H. Arab (University of Strasbourg)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:IC_63_Ghost_Nebula_in_Infrared_(2018-42-4244).png"
      },
      "shots": [
        {
          "start": 19.6,
          "end": 25.133,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 25.133,
          "end": 27.933,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 27.932,
      "end": 36.527,
      "text": "For five decades, astronomers faced an unsolved puzzle: the star blazed with X-rays reaching 150 million degrees.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Chandra X-ray Image of TWA 5A & 5B (2003-twa5b-more-3).tiff",
        "credit": "(Credit: NASA/CXC/Chuo U./Y.Tsuboi et al.)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Chandra_X-ray_Image_of_TWA_5A_%26_5B_(2003-twa5b-more-3).tiff"
      },
      "shots": [
        {
          "start": 27.933,
          "end": 31.267,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 31.267,
          "end": 36.533,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 36.527,
      "end": 45.027,
      "text": "In 2026, the XRISM space telescope unmasked the culprit by tracking Doppler shifts in the hot plasma.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "XRISM Reveals Its First Look at X-ray Cosmos (SVS14492 - XRISM Spacecraft).png",
        "credit": "NASA's Scientific Visualization Studio - Francis Reddy, Jeanette Kazmierczak, Scott Wiessinger, Sophia Roberts",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:XRISM_Reveals_Its_First_Look_at_X-ray_Cosmos_(SVS14492_-_XRISM_Spacecraft).png"
      },
      "shots": [
        {
          "start": 36.533,
          "end": 39.733,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 39.733,
          "end": 45.033,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 45.027,
      "end": 51.222,
      "text": "The radiation doesn't come from the giant, but from a hidden, Earth-sized white dwarf companion.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 45.033,
          "end": 51.233,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 51.222,
      "end": 57.204,
      "text": "Every 203 days, this dense corpse feeds on material shed by an unraveling giant.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Gamma Cassiopeiae by Kees Scherer.jpg",
        "credit": "Kees Scherer",
        "license": "CC0",
