{
  "id": "ep512",
  "duration": 28.451,
  "beats": [
    {
      "start": 0.08,
      "end": 3.44,
      "text": "A federal law banned Chinese astronauts from the ISS.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "STS-134 International Space Station after undocking.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:STS-134_International_Space_Station_after_undocking.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.44,
      "end": 6.78,
      "text": "That exclusion only forced a rival laboratory into the sky.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Wang Yaping plays guzheng 01.png",
        "credit": "\u4e2d\u56fd\u65b0\u95fb\u793e",
        "license": "CC BY 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:Wang_Yaping_plays_guzheng_01.png"
      },
      "shots": [
        {
          "start": 3.433,
          "end": 6.767,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.78,
      "end": 10.14,
      "text": "China launched the massive Tianhe core module in 2021.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Launch of Tianhe Core Module 2 (Cropped).jpg",
        "credit": "China News Service",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Launch_of_Tianhe_Core_Module_2_(Cropped).jpg"
      },
      "shots": [
        {
          "start": 6.767,
          "end": 10.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.14,
      "end": 13.08,
      "text": "They docked two giant experiment modules to complete the station.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Wentian solar array.jpg",
        "credit": "China Manned Space Engineering Office",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Wentian_solar_array.jpg"
      },
      "shots": [
        {
          "start": 10.133,
          "end": 13.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.08,
      "end": 17.14,
      "text": "Seventeen different countries now conduct research on this forbidden outpost.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "\u201c\u68a6\u5929\u201d\u6765\u5566\uff01\u9664\u4e86\u5b9e\u9a8c\u67dc\u8fd8\u5e26\u4e86\u201c\u5212\u8239\u673a\u201d1.png",
        "credit": "\u4e2d\u56fd\u65b0\u95fb\u793e",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:%E2%80%9C%E6%A2%A6%E5%A4%A9%E2%80%9D%E6%9D%A5%E5%95%A6%EF%BC%81%E9%99%A4%E4%BA%86%E5%AE%9E%E9%AA%8C%E6%9F%9C%E8%BF%98%E5%B8%A6%E4%BA%86%E2%80%9C%E5%88%92%E8%88%B9%E6%9C%BA%E2%80%9D1.png"
      },
      "shots": [
        {
          "start": 13.067,
          "end": 17.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.14,
      "end": 20.8,
      "text": "European astronauts even joined their crew for deep-sea survival training.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Samantha Cristoforetti - Neutral Buoyancy Laboratory 2.jpg",
        "credit": "James Blair",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Samantha_Cristoforetti_-_Neutral_Buoyancy_Laboratory_2.jpg"
      },
      "shots": [
        {
          "start": 17.133,
          "end": 20.8,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.8,
      "end": 24.96,
      "text": "Their new telescope dwarfs Hubble with a field of view 300 times wider.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "CSST\u60f3\u8c61\u56fe.jpg",
        "credit": "\u4e2d\u56fd\u79d1\u5b66\u9662\u957f\u6625\u5149\u5b66\u7cbe\u5bc6\u673a\u68b0\u4e0e\u7269\u7406\u7814\u7a76\u6240",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:CSST%E6%83%B3%E8%B1%A1%E5%9B%BE.jpg"
      },
      "shots": [
        {
          "start": 20.8,
          "end": 24.967,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.96,
      "end": 28.101,
      "text": "This rival program was born because of that federal law.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "STS-134 International Space Station after undocking.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:STS-134_International_Space_Station_after_undocking.jpg"
      },
      "shots": [
        {
          "start": 24.967,
          "end": 28.467,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
