{
  "id": "ep065",
  "duration": 40.538,
  "beats": [
    {
      "start": 0.08,
      "end": 3.745,
      "text": "Astronauts don't float in space because gravity is gone.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Iss017e011910.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Iss017e011910.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.133,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 2.133,
          "end": 3.733,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.745,
      "end": 11.54,
      "text": "At the altitude of the International Space Station, Earth's gravity is roughly ninety percent as strong as it is at the surface.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Earth-Slip.png",
        "credit": "Email4mobile (talk)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Earth-Slip.png"
      },
      "shots": [
        {
          "start": 3.733,
          "end": 11.533,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.54,
      "end": 14.835,
      "text": "So why does the crew experience total weightlessness?",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "ISS-53 Aleksandr Misurkin and Sergey Ryazansky inside the Harmony module.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:ISS-53_Aleksandr_Misurkin_and_Sergey_Ryazansky_inside_the_Harmony_module.jpg"
      },
      "shots": [
        {
          "start": 11.533,
          "end": 13.233,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 13.233,
          "end": 14.833,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.835,
      "end": 20.26,
      "text": "The answer is that they and their spacecraft are in a continuous state of free fall.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "ISS-53 Aleksandr Misurkin and Sergey Ryazansky inside the Harmony module.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:ISS-53_Aleksandr_Misurkin_and_Sergey_Ryazansky_inside_the_Harmony_module.jpg"
      },
      "shots": [
        {
          "start": 14.833,
          "end": 20.267,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.26,
      "end": 26.78,
      "text": "The station moves sideways so fast that as it falls toward the planet, the surface curves away beneath it.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NISAR satellite orbit (SVS5615 - 2415).jpg",
        "credit": "NASA's Scientific Visualization Studio - Science and Technology Corporation/Kel Elkins",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:NISAR_satellite_orbit_(SVS5615_-_2415).jpg"
      },
      "shots": [
        {
          "start": 20.267,
          "end": 23.533,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 23.533,
          "end": 26.767,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 26.78,
      "end": 32.725,
      "text": "This means the crew completes one full orbit around Earth approximately every ninety minutes.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "ISS062-E-41544 - View of Earth.jpg",
        "credit": "Earth Science and Remote Sensing Unit, NASA Johnson Space Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:ISS062-E-41544_-_View_of_Earth.jpg"
      },
      "shots": [
        {
          "start": 26.767,
          "end": 28.867,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 28.867,
          "end": 32.733,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 32.725,
      "end": 40.188,
      "text": "Because everything falls together, there is no floor pushing back, proving astronauts don't float because gravity is gone.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Iss017e011910.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Iss017e011910.jpg"
      },
      "shots": [
        {
          "start": 32.733,
          "end": 40.533,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
