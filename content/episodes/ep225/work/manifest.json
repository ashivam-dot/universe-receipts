  "duration": 47.322,
  "beats": [
    {
      "start": 0.08,
      "end": 4.643,
      "text": "An entire exoplanet is made almost entirely of pure diamond.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NASA Missions Spy First Possible \u2018Survivor\u2019 Planet Hugging White Dwarf Star (51145167501).png",
        "credit": "NASA's James Webb Space Telescope from Greenbelt, MD, USA",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:NASA_Missions_Spy_First_Possible_%E2%80%98Survivor%E2%80%99_Planet_Hugging_White_Dwarf_Star_(51145167501).png"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.233,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 3.233,
          "end": 4.633,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.643,
      "end": 12.813,
      "text": "In 2011, astronomers using the Parkes radio telescope detected something very strange four thousand light-years away.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "CSIRO ScienceImage 4350 CSIROs Parkes Radio Telescope with moon in the background.jpg",
        "credit": "division, CSIRO",
        "license": "CC BY 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:CSIRO_ScienceImage_4350_CSIROs_Parkes_Radio_Telescope_with_moon_in_the_background.jpg"
      },
      "shots": [
        {
          "start": 4.633,
          "end": 7.6,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 7.6,
          "end": 12.8,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.813,
      "end": 18.458,
      "text": "The signal came from a millisecond pulsar rotating ten thousand times every minute.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Wind-Accreting Pulsar Visualization (SVS20417 - END 4k).png",
        "credit": "NASA's Scientific Visualization Studio - eMITS/Adriana Manrique Gutierrez, ADNET Systems, Inc./Aaron E. Lepsch, University of Maryland College Park/Francis Reddy, eMITS/Swarupa Nune",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Wind-Accreting_Pulsar_Visualization_(SVS20417_-_END_4k).png"
      },
      "shots": [
        {
          "start": 12.8,
          "end": 16.067,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 16.067,
          "end": 18.467,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.458,
      "end": 23.303,
      "text": "This tiny stellar corpse has a mass one point four times that of the Sun.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PSR J0348+0432.jpg",
        "credit": "ESO/L. Cal\u00e7ada",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:PSR_J0348%2B0432.jpg"
      },
      "shots": [
        {
          "start": 18.467,
          "end": 20.833,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 20.833,
          "end": 23.3,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.303,
      "end": 28.823,
      "text": "Circling that pulsar is a planet completing an orbit every two hours and ten minutes.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 23.3,
          "end": 28.833,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 28.823,
      "end": 34.168,
      "text": "The entire system is so compact it would fit entirely inside our Sun.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Star Size Comparison 2024 Update.jpg",
        "credit": "Stanley Joseph \"Stan\"",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Star_Size_Comparison_2024_Update.jpg"
      },
      "shots": [
        {
          "start": 28.833,
          "end": 31.667,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 31.667,
          "end": 34.167,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 34.168,
      "end": 40.443,
      "text": "This world is actually the remnant of a star that lost over ninety-nine percent of its mass.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist\u2019s Illustration of Extragalactic Recurrent Nova (noirlab2509a).jpg",
        "credit": "International Gemini Observatory/NOIRLab/NSF/AURA/M. Garlick, M. Zamani",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%E2%80%99s_Illustration_of_Extragalactic_Recurrent_Nova_(noirlab2509a).jpg"
      },
      "shots": [
        {
          "start": 34.167,
          "end": 37.967,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 37.967,
          "end": 40.433,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 40.443,
      "end": 46.972,
      "text": "That stolen core is twenty times denser than Jupiter, compressed into crystalline carbon, which means\u2014",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NASA Missions Spy First Possible \u2018Survivor\u2019 Planet Hugging White Dwarf Star (51145167501).png",
        "credit": "NASA's James Webb Space Telescope from Greenbelt, MD, USA",
