{
  "id": "ep380",
  "duration": 32.227,
  "beats": [
    {
      "start": 0.08,
      "end": 2.82,
      "text": "Jupiter creates the largest structure in the Solar System.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Jupiter's Magnetosphere animation.png",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Jupiter%27s_Magnetosphere_animation.png"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.833,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 2.82,
      "end": 6.28,
      "text": "Its invisible magnetic tail stretches all the way to Saturn.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Jupiter's Magnetosphere.png",
        "credit": "NASA/JPL/JHUAPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Jupiter%27s_Magnetosphere.png"
      },
      "shots": [
        {
          "start": 2.833,
          "end": 6.267,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.28,
      "end": 10.14,
      "text": "Deep inside, churning metallic hydrogen drives this giant magnetic bubble.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Jupiter's Interior.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Jupiter%27s_Interior.jpg"
      },
      "shots": [
        {
          "start": 6.267,
          "end": 10.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.14,
      "end": 14.3,
      "text": "Volcanic eruptions on its moon Io feed it charged particles continuously.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA01081-Color Mosaic and Active Volcanic Plumes on Io.jpg",
        "credit": "NASA's Galileo spacecraft",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA01081-Color_Mosaic_and_Active_Volcanic_Plumes_on_Io.jpg"
      },
      "shots": [
        {
          "start": 10.133,
          "end": 12.2,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 12.2,
          "end": 14.3,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.3,
      "end": 17.8,
      "text": "Jupiter spins in ten hours, driving permanent polar auroras.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hubble Captures Vivid Auroras in Jupiter's Atmosphere.jpg",
        "credit": "NASA, ESA, and J. Nichols (University of Leicester)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Hubble_Captures_Vivid_Auroras_in_Jupiter%27s_Atmosphere.jpg"
      },
      "shots": [
        {
          "start": 14.3,
          "end": 17.8,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.8,
      "end": 20.84,
      "text": "These glowing lights are 100 times more powerful than Earth's.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Close-up Observations of Auroras on Jupiter (2025-108).png",
        "credit": "Image: NASA, ESA, CSA, Jonathan Nichols (University of Leicester), Mahdi Zamani (ESA/Webb)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Close-up_Observations_of_Auroras_on_Jupiter_(2025-108).png"
      },
      "shots": [
        {
          "start": 17.8,
          "end": 20.833,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.84,
      "end": 24.92,
      "text": "Magnetic lines even etch moon footprint spots into Jupiter's atmosphere.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Aurora Crowns Jupiter's North Pole.jpg",
        "credit": "NASA Hubble",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Aurora_Crowns_Jupiter%27s_North_Pole.jpg"
      },
      "shots": [
        {
          "start": 20.833,
          "end": 24.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.92,
      "end": 28.34,
      "text": "NASA's Juno spacecraft dives through polar orbits to avoid dangerous radiation.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Juno above Jupiter's pole.jpg",
        "credit": "Image credit: NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Juno_above_Jupiter%27s_pole.jpg"
      },
      "shots": [
        {
          "start": 24.933,
          "end": 26.633,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 26.633,
          "end": 28.333,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 28.34,
      "end": 31.877,
      "text": "That is how we mapped the largest structure in the Solar System.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Jupiter's Magnetosphere animation.png",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Jupiter%27s_Magnetosphere_animation.png"
      },
      "shots": [
        {
          "start": 28.333,
          "end": 32.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
