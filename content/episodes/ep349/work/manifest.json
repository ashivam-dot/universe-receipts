{
  "id": "ep349",
  "duration": 26.707,
  "beats": [
    {
      "start": 0.08,
      "end": 4.56,
      "text": "This colossal galaxy spans sixteen million light-years across.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "RAD J131346.9+500320.png",
        "credit": "Ananda Hota et al. (2025)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:RAD_J131346.9%2B500320.png"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.567,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.56,
      "end": 5.54,
      "text": "It is huge.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Simulation of large scale structure (eso1438b).tiff",
        "credit": "Illustris Collaboration",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Simulation_of_large_scale_structure_(eso1438b).tiff"
      },
      "shots": [
        {
          "start": 4.567,
          "end": 5.533,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 5.54,
      "end": 9.28,
      "text": "One hundred Milky Ways laid end to end barely match it.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Milky Way Anatomy (SVS14935).jpg",
        "credit": "NASA's Scientific Visualization Studio - eMITS/Scott Wiessinger, eMITS/Adriana Manrique Gutierrez, eMITS/Ashley Balzer",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Milky_Way_Anatomy_(SVS14935).jpg"
      },
      "shots": [
        {
          "start": 5.533,
          "end": 9.267,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.28,
      "end": 12.82,
      "text": "Astronomers found the titan hidden in the northern constellation of Lynx.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Lynx (lyn).jpg",
        "credit": "IAU and Sky & Telescope",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Lynx_(lyn).jpg"
      },
      "shots": [
        {
          "start": 9.267,
          "end": 12.833,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.82,
      "end": 16.56,
      "text": "Twin jet streams power its lobes from a central supermassive black hole.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Anatomy of a Black Hole.jpg",
        "credit": "European Southern Observatory - ESO",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Anatomy_of_a_Black_Hole.jpg"
      },
      "shots": [
        {
          "start": 12.833,
          "end": 16.567,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.56,
      "end": 21.46,
      "text": "Yet despite its record-breaking plumes, the central galaxy is completely ordinary.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Abell S740, cropped to ESO 325-G004.jpg",
        "credit": "NASA, ESA, and The Hubble Heritage Team (STScI/AURA); J. Blakeslee (Washington State University)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Abell_S740,_cropped_to_ESO_325-G004.jpg"
      },
      "shots": [
        {
          "start": 16.567,
          "end": 21.467,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.46,
      "end": 26.357,
      "text": "That is why sixteen million light-years of space can hide such an ordinary heart.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "RAD J131346.9+500320.png",
        "credit": "Ananda Hota et al. (2025)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:RAD_J131346.9%2B500320.png"
      },
      "shots": [
        {
          "start": 21.467,
          "end": 26.7,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
