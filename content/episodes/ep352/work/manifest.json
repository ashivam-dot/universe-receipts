{
  "id": "ep352",
  "duration": 27.882,
  "beats": [
    {
      "start": 0.08,
      "end": 3.16,
      "text": "A space probe slammed into the crushing skies of Venus.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Venus - May 18 2016 (39575655862).jpg",
        "credit": "Kevin Gill from Los Angeles, CA, United States",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Venus_-_May_18_2016_(39575655862).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.167,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.16,
      "end": 7.36,
      "text": "During atmospheric entry, cabin deceleration reached 300 Gs.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Venera 4 (MMA 2011) (1).JPG",
        "credit": "Armael",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Venera_4_(MMA_2011)_(1).JPG"
      },
      "shots": [
        {
          "start": 3.167,
          "end": 7.367,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.36,
      "end": 11.9,
      "text": "Its heat shield endured temperatures soaring up to 11,000 degrees Celsius.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artemis I Orion heat shield.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Artemis_I_Orion_heat_shield.jpg"
      },
      "shots": [
        {
          "start": 7.367,
          "end": 9.667,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 9.667,
          "end": 11.9,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.9,
      "end": 15.44,
      "text": "The probe deployed its parachute at an altitude of about 52 kilometers.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 11.9,
          "end": 15.433,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.44,
      "end": 21.04,
      "text": "It became the first successful spacecraft to transmit data from inside another planet's atmosphere.",
      "asset": {
        "source": "Flickr via Openverse",
        "title": "Lovell Radio Telescope, Jodrell Bank",
        "credit": "tom_bullock",
        "license": "CC BY 2.0",
        "url": "https://www.flickr.com/photos/22206162@N03/3614254573"
      },
      "shots": [
        {
          "start": 15.433,
          "end": 21.033,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.04,
      "end": 24.12,
      "text": "Subsequent analysis proved the hull was crushed before reaching the surface.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Venus globe.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Venus_globe.jpg"
      },
      "shots": [
        {
          "start": 21.033,
          "end": 24.133,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.12,
      "end": 27.532,
      "text": "And that is what happened when a probe slammed into Venus.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Venus - May 18 2016 (39575655862).jpg",
        "credit": "Kevin Gill from Los Angeles, CA, United States",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Venus_-_May_18_2016_(39575655862).jpg"
      },
      "shots": [
        {
          "start": 24.133,
          "end": 27.867,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
