{
  "id": "ep116",
  "duration": 51.936,
  "beats": [
    {
      "start": 0.08,
      "end": 4.977,
      "text": "NASA assembled a premier planetary explorer from leftover spare parts.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Documentary view of the Magellan spacecraft during checkout at Martin Marietta Denver (S88-50418).jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Documentary_view_of_the_Magellan_spacecraft_during_checkout_at_Martin_Marietta_Denver_(S88-50418).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.967,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.977,
      "end": 10.872,
      "text": "Launched in 1989, Magellan was built cheap but sent on a monumental task.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "STS-41-D launch August 30, 1984.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:STS-41-D_launch_August_30,_1984.jpg"
      },
      "shots": [
        {
          "start": 4.967,
          "end": 10.867,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.872,
      "end": 16.767,
      "text": "Engineers constructed its main antenna from a Voyager spare, saving millions of dollars.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA21730.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA21730.jpg"
      },
      "shots": [
        {
          "start": 10.867,
          "end": 13.6,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 13.6,
          "end": 16.767,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.767,
      "end": 23.712,
      "text": "Arriving in 1990, it faced a crushing atmosphere and 475-degree-Celsius heat.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 16.767,
          "end": 23.7,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.712,
      "end": 28.982,
      "text": "Thick, opaque clouds blocked all normal optical views of the alien surface.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Venuspioneeruv.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Venuspioneeruv.jpg"
      },
      "shots": [
        {
          "start": 23.7,
          "end": 26.333,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 26.333,
          "end": 28.967,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 28.982,
      "end": 34.202,
      "text": "Instead of cameras, Magellan used radar to pierce the deep, toxic haze.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Bolotnitsa Fluctus (Magellan).png",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Bolotnitsa_Fluctus_(Magellan).png"
      },
      "shots": [
        {
          "start": 28.967,
          "end": 34.2,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 34.202,
      "end": 39.772,
      "text": "Shockingly, this budget spacecraft mapped 98 percent of the volcanic world.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Venus globe crop.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Venus_globe_crop.jpg"
      },
      "shots": [
        {
          "start": 34.2,
          "end": 36.667,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 36.667,
          "end": 39.767,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 39.772,
      "end": 46.597,
      "text": "In October 1994, engineers commanded it to dive directly into the crushing atmosphere.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 39.767,
          "end": 46.6,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 46.597,
      "end": 51.586,
      "text": "Its fiery demise destroyed one of NASA's most brilliant recycled creations.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Documentary view of the Magellan spacecraft during checkout at Martin Marietta Denver (S88-50418).jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Documentary_view_of_the_Magellan_spacecraft_during_checkout_at_Martin_Marietta_Denver_(S88-50418).jpg"
      },
      "shots": [
        {
          "start": 46.6,
          "end": 51.933,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    }
  ],
