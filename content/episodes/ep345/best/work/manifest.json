{
  "id": "ep345",
  "duration": 26.768,
  "beats": [
    {
      "start": 0.08,
      "end": 3.06,
      "text": "Asteroid Phaethon orbits closer to the Sun than Mercury.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA22185.tif",
        "credit": "Arecibo Observatory/NASA/NSF",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA22185.tif"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.06,
      "end": 6.96,
      "text": "Its barren rocky surface bakes up to 750 degrees Celsius.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Privately owned meteorite - NWA 13887.jpg",
        "credit": "Ahmad Fairuz",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Privately_owned_meteorite_-_NWA_13887.jpg"
      },
      "shots": [
        {
          "start": 3.067,
          "end": 6.967,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.96,
      "end": 10.72,
      "text": "That intense extreme heat physically cracks the rock apart.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Asteroid2014DX110-NEO-NearEarthFlyby-20140305.png",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Asteroid2014DX110-NEO-NearEarthFlyby-20140305.png"
      },
      "shots": [
        {
          "start": 6.967,
          "end": 10.733,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.72,
      "end": 13.9,
      "text": "Scientists long thought solar dust created the annual Geminids.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Gemenids (53402544230).png",
        "credit": "\u0160ime Bare\u0161i\u0107 from Drage, Croatia",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Gemenids_(53402544230).png"
      },
      "shots": [
        {
          "start": 10.733,
          "end": 13.9,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.9,
      "end": 17.82,
      "text": "Then NASA observatories revealed the tail is actually sodium gas.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "STEREO spacecraft model 2.png",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:STEREO_spacecraft_model_2.png"
      },
      "shots": [
        {
          "start": 13.9,
          "end": 17.833,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.82,
      "end": 22.62,
      "text": "Since gas cannot form meteors, the true origin remains a complete mystery.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "STEREO spacecraft model 2.png",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:STEREO_spacecraft_model_2.png"
      },
      "shots": [
        {
          "start": 17.833,
          "end": 22.633,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.62,
      "end": 26.418,
      "text": "This amazing baking rock is what created the Geminids.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA22185.tif",
        "credit": "Arecibo Observatory/NASA/NSF",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA22185.tif"
      },
      "shots": [
        {
          "start": 22.633,
          "end": 26.767,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
