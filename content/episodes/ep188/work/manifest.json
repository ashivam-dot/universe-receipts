          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 44.046,
      "end": 51.439,
      "text": "Because the nebula sits 7,000 light-years away, telescopes must wait 1,000 years to see if we are still watching them.",
