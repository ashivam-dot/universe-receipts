  "beats": [
    {
      "start": 0.08,
      "end": 4.721,
      "text": "The four-light-year Pillars of Creation may have already been completely destroyed.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Pillars of Creation (NIRCam Image).png",
        "credit": "NASA, ESA, CSA, STScI; Joseph DePasquale (STScI), Anton M. Koekemoer (STScI), Alyssa Pagan (STScI)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Pillars_of_Creation_(NIRCam_Image).png"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.733,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.721,
      "end": 13.341,
      "text": "Hubble captured these towers in 1995, revealing embryonic stars forming inside dense hydrogen pockets called EGGs.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Eagle nebula pillars.jpg",
        "credit": "Credit: NASA, Jeff Hester, and Paul Scowen (Arizona State University)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Eagle_nebula_pillars.jpg"
      },
      "shots": [
        {
          "start": 4.733,
          "end": 9.033,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 9.033,
          "end": 13.333,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.341,
      "end": 19.936,
      "text": "Nearby massive stars blast intense ultraviolet radiation and stellar winds across the gas.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Wide-Field Image of the Eagle Nebula (2005-12-1673).tiff",
        "credit": "T.A.Rector (University of Alaska Anchorage, NRAO/AUI/NSF and NOAO//NSF) and B.A.Wolpa (NOAO//NSF)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Wide-Field_Image_of_the_Eagle_Nebula_(2005-12-1673).tiff"
      },
      "shots": [
        {
          "start": 13.333,
          "end": 15.967,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 15.967,
          "end": 19.933,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.936,
      "end": 25.581,
      "text": "This photoevaporation slowly strips the gas away from each developing protostar.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Stellar \"Eggs\" Emerge from Molecular Cloud- Closeup of Evaporating Globules in M16 (1995-44-352).jpg",
        "credit": "Credit: NASA, ESA, STScI, J. Hester and P. Scowen (Arizona State University)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Stellar_%22Eggs%22_Emerge_from_Molecular_Cloud-_Closeup_of_Evaporating_Globules_in_M16_(1995-44-352).jpg"
      },
      "shots": [
        {
          "start": 19.933,
          "end": 25.567,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.581,
      "end": 30.306,
      "text": "When an EGG is uncovered, its forming star abruptly stops growing.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Festive and Free-Floating (potw2251a).jpg",
        "credit": "ESA/Hubble & NASA, R. Sahai",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Festive_and_Free-Floating_(potw2251a).jpg"
      },
      "shots": [
        {
          "start": 25.567,
          "end": 28.667,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 28.667,
          "end": 30.3,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 30.306,
      "end": 36.876,
      "text": "Spitzer observations suggest a supernova shockwave wiped out the pillars 6,000 years ago.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "A Great Observatories Perspective of the Eagle Nebula (M16) (2007-m16-more-5).tiff",
        "credit": "(Credit: X-ray: NASA/CXC/U.Colorado/Linsky et al.; Optical: NASA/ESA/STScI/ASU/J.Hester & P.Scowen; Infrared: NASA/JPL-Caltech/SSC/N.Flagey & A.Noriega-Crespo)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:A_Great_Observatories_Perspective_of_the_Eagle_Nebula_(M16)_(2007-m16-more-5).tiff"
      },
      "shots": [
        {
