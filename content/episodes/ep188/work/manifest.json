          "motion": "camera"
        }
      ]
    },
    {
      "start": 36.876,
      "end": 44.046,
      "text": "Astronomer Stephen Reynolds disputed the blast, arguing stellar winds heat the dust and erode it gradually.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hubble's Pillars of Creation 2014 (16223013872).png",
        "credit": "geckzilla",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Hubble%27s_Pillars_of_Creation_2014_(16223013872).png"
      },
      "shots": [
        {
