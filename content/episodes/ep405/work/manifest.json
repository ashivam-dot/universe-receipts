{
  "id": "ep405",
  "duration": 29.975,
  "beats": [
    {
      "start": 0.08,
      "end": 3.64,
      "text": "NASA is currently shouting into a twenty-four-hour void.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Titan 3E with Voyager 1.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Titan_3E_with_Voyager_1.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 1.8,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 1.8,
          "end": 3.633,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.64,
      "end": 5.86,
      "text": "Most think our furthest spacecraft is still close to home.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Solar System graphic by NASA.png",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Solar_System_graphic_by_NASA.png"
      },
      "shots": [
        {
          "start": 3.633,
          "end": 5.867,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 5.86,
      "end": 10.02,
      "text": "But Voyager 1 actually crossed into interstellar space in 2012.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyagers in the Heliosheath.jpg",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Voyagers_in_the_Heliosheath.jpg"
      },
      "shots": [
        {
          "start": 5.867,
          "end": 10.033,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.02,
      "end": 13.46,
      "text": "It is now sixteen billion miles away from the sun.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyager probe.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Voyager_probe.jpg"
      },
      "shots": [
        {
          "start": 10.033,
          "end": 13.467,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.46,
      "end": 17.02,
      "text": "NASA's Jet Propulsion Laboratory launched the probe back in 1977.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Titan IIIE Centaur 1977.jpg",
        "credit": "United States Air Force",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Titan_IIIE_Centaur_1977.jpg"
      },
      "shots": [
        {
          "start": 13.467,
          "end": 17.033,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.02,
      "end": 20.12,
      "text": "To keep it talking, engineers recently fired backup thrusters.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mission Control- Floor Level (49386802568).png",
        "credit": "NASAJPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Mission_Control-_Floor_Level_(49386802568).png"
      },
      "shots": [
        {
          "start": 17.033,
          "end": 20.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.12,
      "end": 23.3,
      "text": "These engines had slept unused for over thirty-seven years.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyager Program - spacecraft diagram.png",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Voyager_Program_-_spacecraft_diagram.png"
      },
      "shots": [
        {
          "start": 20.133,
          "end": 23.3,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.3,
      "end": 26.44,
      "text": "It is now a lonely time capsule carrying our golden record.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The Sounds of Earth Record Cover - GPN-2000-001978.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:The_Sounds_of_Earth_Record_Cover_-_GPN-2000-001978.jpg"
      },
      "shots": [
        {
          "start": 23.3,
          "end": 26.433,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 26.44,
      "end": 29.625,
      "text": "Every radio message must cross that endless twenty-four-hour void.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Titan 3E with Voyager 1.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Titan_3E_with_Voyager_1.jpg"
      },
      "shots": [
        {
          "start": 26.433,
          "end": 29.967,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    }
  ],
