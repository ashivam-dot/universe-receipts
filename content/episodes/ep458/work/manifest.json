  "beats": [
    {
      "start": 0.08,
      "end": 3.8,
      "text": "Jupiter's famous storm plunges 200 miles deep into its atmosphere.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Jupiter - Great Red Spot - PJ7-60 61 62 - Balanced (49803032983).png",
        "credit": "Kevin Gill from Los Angeles, CA, United States",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Jupiter_-_Great_Red_Spot_-_PJ7-60_61_62_-_Balanced_(49803032983).png"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.8,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.8,
      "end": 6.16,
      "text": "Most people assume it's just a thin surface cloud.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hubble Visible View of Jupiter.jpg",
        "credit": "NASA/ESA/NOIRLab/NSF/AURA/M.H. Wong and I. de Pater (UC Berkeley) et al.\n\nAcknowledgments: M. Zamani",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Hubble_Visible_View_of_Jupiter.jpg"
      },
      "shots": [
        {
          "start": 3.8,
          "end": 6.167,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.16,
      "end": 9.78,
      "text": "NASA's Juno spacecraft measured the planet's gravity to look inside.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "JUNO - PIA13746.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:JUNO_-_PIA13746.jpg"
      },
      "shots": [
        {
          "start": 6.167,
          "end": 9.767,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.78,
      "end": 13.38,
      "text": "It revealed a vertical vortex reaching far below the cloud tops.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Jupiter's Atmosphere (Illustration) (2023-147).jpg",
        "credit": "Image: NASA, ESA, CSA, STScI, Ricardo Hueso (UPV), Imke de Pater (UC Berkeley), Thierry Fouchet (Observatory of Paris), Leigh Fletcher (University of Leicester), Michael H. Wong (UC Berkeley) Illustra",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Jupiter%27s_Atmosphere_(Illustration)_(2023-147).jpg"
      },
      "shots": [
        {
          "start": 9.767,
          "end": 13.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.38,
      "end": 16.26,
      "text": "These storm roots stretch past where solar light can reach.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA01638 Jovian Lightning and the Daytime Storm.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA01638_Jovian_Lightning_and_the_Daytime_Storm.jpg"
      },
      "shots": [
        {
          "start": 13.367,
          "end": 16.267,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.26,
      "end": 19.48,
      "text": "Since Jupiter lacks a solid surface, there's no friction to stop it.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Jupiter 's Swirling Storms - Northern Hemisphere - Nasa\u2019s Juno PJ 41 (52040118029).png",
        "credit": "Andrea Luck",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Jupiter_%27s_Swirling_Storms_-_Northern_Hemisphere_-_Nasa%E2%80%99s_Juno_PJ_41_(52040118029).png"
      },
      "shots": [
        {
          "start": 16.267,
          "end": 19.467,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.48,
      "end": 23.143,
      "text": "That lack of surface friction is why the storm plunges 200 miles deep.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Jupiter - Great Red Spot - PJ7-60 61 62 - Balanced (49803032983).png",
        "credit": "Kevin Gill from Los Angeles, CA, United States",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Jupiter_-_Great_Red_Spot_-_PJ7-60_61_62_-_Balanced_(49803032983).png"
      },
      "shots": [
        {
          "start": 19.467,
          "end": 23.5,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
