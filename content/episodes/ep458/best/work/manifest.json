  "beats": [
    {
      "start": 0.08,
      "end": 3.9,
      "text": "Jupiter's famous storm plunges over 200 miles deep into space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Jupiter - Great Red Spot - PJ7-60 61 62 - Balanced (49803032983).png",
        "credit": "Kevin Gill from Los Angeles, CA, United States",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Jupiter_-_Great_Red_Spot_-_PJ7-60_61_62_-_Balanced_(49803032983).png"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.9,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.9,
      "end": 7.18,
      "text": "Many people assume it is just a wide cloud feature.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Jupiter from Voyager 1.jpg",
        "credit": "NASA, Caltech/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Jupiter_from_Voyager_1.jpg"
      },
      "shots": [
        {
          "start": 3.9,
          "end": 7.167,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.18,
      "end": 10.4,
      "text": "New gravity data from NASA's Juno mission reveals the reality.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "JUNO - PIA13746.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:JUNO_-_PIA13746.jpg"
      },
      "shots": [
        {
          "start": 7.167,
          "end": 10.4,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.4,
      "end": 13.68,
      "text": "The storm is actually a vertical monster in the atmosphere.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Jupiter's Layered Swirls.jpg",
        "credit": "NASA/JPL-Caltech/SwRI/MSSS",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Jupiter%27s_Layered_Swirls.jpg"
      },
      "shots": [
        {
          "start": 10.4,
          "end": 13.667,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.68,
      "end": 16.36,
      "text": "It extends far below where any ordinary clouds could form.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Giove struttura.png",
        "credit": "Henrykus",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Giove_struttura.png"
      },
      "shots": [
        {
          "start": 13.667,
          "end": 16.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.36,
      "end": 20.14,
      "text": "Since Jupiter lacks a solid surface, storms stay truly resilient.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hubble shows winds in Jupiter\u2019s great red spot are speeding up (51565147214).jpg",
        "credit": "European Space Agency",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Hubble_shows_winds_in_Jupiter%E2%80%99s_great_red_spot_are_speeding_up_(51565147214).jpg"
      },
      "shots": [
        {
          "start": 16.367,
          "end": 20.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.14,
      "end": 23.383,
      "text": "That depth is why this storm plunges 200 miles deep.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Jupiter - Great Red Spot - PJ7-60 61 62 - Balanced (49803032983).png",
        "credit": "Kevin Gill from Los Angeles, CA, United States",
