  "beats": [
    {
      "start": 0.08,
      "end": 3.581,
      "text": "A dead star is building a new planet from its own ashes.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist\u2019s impression of the WDJ0914+1914 system.tif",
        "credit": "ESO/M. Kornmesser",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%E2%80%99s_impression_of_the_WDJ0914%2B1914_system.tif"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.567,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.581,
      "end": 11.576,
      "text": "In 1999, the Hubble Space Telescope recorded one hundred mystery spectral lines around a cooling white dwarf.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hubble Space Telescope sporting new solar arrays during SM3B (s109e5705).jpg",
        "credit": "NASA/ESA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Hubble_Space_Telescope_sporting_new_solar_arrays_during_SM3B_(s109e5705).jpg"
      },
      "shots": [
        {
          "start": 3.567,
          "end": 11.567,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.576,
      "end": 18.596,
      "text": "For twenty-five years, these chemical fingerprints remained a total mystery that scientists could not decipher.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hubble Spectrum of White Dwarf HS 0209+0832 (heic2613b).jpg",
        "credit": "NASA, ESA, L. Hustak (STScI)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Hubble_Spectrum_of_White_Dwarf_HS_0209%2B0832_(heic2613b).jpg"
      },
      "shots": [
        {
          "start": 11.567,
          "end": 14.967,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 14.967,
          "end": 18.6,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.596,
      "end": 26.971,
      "text": "Using modern databases, University of Warwick researchers recently identified the mystery element as niobium.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Prime Minister Rishi Sunak visits University of Warwick (53170457846).jpg",
        "credit": "Number 10",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Prime_Minister_Rishi_Sunak_visits_University_of_Warwick_(53170457846).jpg"
      },
      "shots": [
        {
          "start": 18.6,
          "end": 21.6,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 21.6,
          "end": 26.967,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 26.971,
      "end": 32.641,
      "text": "Niobium is a heavy metal forged only during the violent death throes of a dying star.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Anodized niobium cube.jpg",
        "credit": "\u8303\u7693\u7a0b",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Anodized_niobium_cube.jpg"
      },
      "shots": [
        {
          "start": 26.967,
          "end": 30.5,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 30.5,
          "end": 32.633,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 32.641,
      "end": 39.816,
      "text": "The metal is being stripped from a Jupiter-sized planet orbiting just 3.7 million miles from the star.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Osirisplanet.jpg",
        "credit": "ESA/Hubble",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Osirisplanet.jpg"
      },
      "shots": [
        {
          "start": 32.633,
          "end": 39.8,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 39.816,
      "end": 46.761,
      "text": "This gas giant is a rare second-generation world, born from the ruins of a destroyed solar system.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hubble image of the Ring Nebula (Messier 57).jpg",
        "credit": "NASA, ESA, and C. Robert O\u2019Dell (Vanderbilt University)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Hubble_image_of_the_Ring_Nebula_(Messier_57).jpg"
      },
      "shots": [
        {
          "start": 39.8,
          "end": 42.833,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 42.833,
          "end": 46.767,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 46.761,
      "end": 51.74,
      "text": "It orbits through a comet-like trail of dust, reclaiming the ashes of its past life.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist\u2019s impression of the WDJ0914+1914 system.tif",
        "credit": "ESO/M. Kornmesser",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%E2%80%99s_impression_of_the_WDJ0914%2B1914_system.tif"
      },
      "shots": [
        {
          "start": 46.767,
          "end": 52.1,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
