{
  "id": "ep469",
  "duration": 32.14,
  "beats": [
    {
      "start": 0.08,
      "end": 3.18,
      "text": "A rocket exploded right under two sitting cosmonauts.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Soyuz T-10-1 abort.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Soyuz_T-10-1_abort.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.167,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.18,
      "end": 6.38,
      "text": "It holds the record for the only crewed launchpad escape.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Soyuz launch pad abort sequence with keys.png",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Soyuz_launch_pad_abort_sequence_with_keys.png"
      },
      "shots": [
        {
          "start": 3.167,
          "end": 6.367,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.38,
      "end": 9.86,
      "text": "A fuel leak during countdown turned their booster into a torch.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Soyuz TMA-5 at the Gagarin's Start.jpg",
        "credit": "Bill Ingalls",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Soyuz_TMA-5_at_the_Gagarin%27s_Start.jpg"
      },
      "shots": [
        {
          "start": 6.367,
          "end": 9.867,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.86,
      "end": 12.14,
      "text": "Flames destroyed the wires for the escape tower.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Soyuz MS-12 spacecraft in the integration facility (2).jpg",
        "credit": "NASA/Victor Zelentsov",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Soyuz_MS-12_spacecraft_in_the_integration_facility_(2).jpg"
      },
      "shots": [
        {
          "start": 9.867,
          "end": 12.133,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.14,
      "end": 14.88,
      "text": "Controllers sent a backup radio signal to trigger it.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Expedition 55 Soyuz Docking (NHQ201803230003).jpg",
        "credit": "Joel Kowsky",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Expedition_55_Soyuz_Docking_(NHQ201803230003).jpg"
      },
      "shots": [
        {
          "start": 12.133,
          "end": 14.867,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.88,
      "end": 18.64,
      "text": "The capsule yanked away at seventeen times gravity's force.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Soyuz-T-10-1.JPG",
        "credit": "Wiki-uk",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Soyuz-T-10-1.JPG"
      },
      "shots": [
        {
          "start": 14.867,
          "end": 16.433,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 16.433,
          "end": 18.633,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.64,
      "end": 22.6,
      "text": "Six seconds later, the pad became a massive fireball.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Peenemunde-165515.jpg",
        "credit": "No. 540 Squadron RAF Flight Sergeant E. P. H. Peek in a de Havilland Mosquito PR4[7] returned to Leuchars airfield on June 23, 1943 with Peenem\u00fcnde photos showing a pair of low-loader vehicles[8] hold",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Peenemunde-165515.jpg"
      },
      "shots": [
        {
          "start": 18.633,
          "end": 22.6,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.6,
      "end": 25.6,
      "text": "Shaken, the crew immediately disabled their voice recorder.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Sts-63 crew.jpg",
        "credit": "NASA, Image ID: MSFC-9414225",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Sts-63_crew.jpg"
      },
      "shots": [
        {
          "start": 22.6,
          "end": 25.6,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.6,
      "end": 28.64,
      "text": "They didn't want anyone hearing their swearing before ignition.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Expedition 23 Landing.jpg",
        "credit": "Bill Ingalls",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Expedition_23_Landing.jpg"
      },
      "shots": [
        {
          "start": 25.6,
          "end": 28.633,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 28.64,
      "end": 31.79,
      "text": "That is how surviving destruction sounds.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Soyuz T-10-1 abort.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Soyuz_T-10-1_abort.jpg"
      },
      "shots": [
        {
          "start": 28.633,
          "end": 32.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
