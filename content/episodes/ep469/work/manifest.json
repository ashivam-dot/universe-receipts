{
  "id": "ep469",
  "duration": 28.242,
  "beats": [
    {
      "start": 0.08,
      "end": 2.92,
      "text": "A rocket exploded right under two sitting cosmonauts.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Soyuz T-10-1 abort.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Soyuz_T-10-1_abort.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 2.92,
      "end": 5.82,
      "text": "It holds the record for the only crewed launchpad escape.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "AA-2 artist's impression.png",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:AA-2_artist%27s_impression.png"
      },
      "shots": [
        {
          "start": 2.933,
          "end": 5.833,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 5.82,
      "end": 8.82,
      "text": "A fuel leak during countdown turned their booster into a torch.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Soyuz TMA-5 at the Gagarin's Start.jpg",
        "credit": "Bill Ingalls",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Soyuz_TMA-5_at_the_Gagarin%27s_Start.jpg"
      },
      "shots": [
        {
          "start": 5.833,
          "end": 8.833,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.82,
      "end": 11.3,
      "text": "Flames destroyed the wires for the escape tower.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Soyuz MS-12 spacecraft in the integration facility (2).jpg",
        "credit": "NASA/Victor Zelentsov",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Soyuz_MS-12_spacecraft_in_the_integration_facility_(2).jpg"
      },
      "shots": [
        {
          "start": 8.833,
          "end": 11.3,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.3,
      "end": 13.6,
      "text": "Controllers sent a backup radio signal to trigger it.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Expedition 55 Soyuz Docking (NHQ201803230003).jpg",
        "credit": "Joel Kowsky",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Expedition_55_Soyuz_Docking_(NHQ201803230003).jpg"
      },
      "shots": [
        {
          "start": 11.3,
          "end": 13.6,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.6,
      "end": 17.08,
      "text": "The capsule yanked away at seventeen times gravity's force.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Soyuz-T-10-1.JPG",
        "credit": "Wiki-uk",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Soyuz-T-10-1.JPG"
      },
      "shots": [
        {
          "start": 13.6,
          "end": 14.9,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 14.9,
          "end": 17.067,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.08,
      "end": 20.02,
      "text": "Six seconds later, the pad became a massive fireball.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Soyuz-T-10-1.JPG",
        "credit": "Wiki-uk",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Soyuz-T-10-1.JPG"
      },
      "shots": [
        {
          "start": 17.067,
          "end": 20.033,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.02,
      "end": 22.64,
      "text": "Shaken, the crew immediately disabled their voice recorder.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "STS071-102-002 - STS-071 - Crew portrait of STS-71,Mir 18 and Mir 19 crewmembers - DPLA - 274477beecd384c4d37781f6d58872a6.jpg",
        "credit": "National Aeronautics and Space Administration. Lyndon B. Johnson Space Center. 2/17/1973",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:STS071-102-002_-_STS-071_-_Crew_portrait_of_STS-71,Mir_18_and_Mir_19_crewmembers_-_DPLA_-_274477beecd384c4d37781f6d58872a6.jpg"
      },
      "shots": [
        {
          "start": 20.033,
          "end": 22.633,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.64,
      "end": 25.24,
      "text": "They didn't want anyone hearing their swearing before ignition.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Expedition 23 Landing.jpg",
        "credit": "Bill Ingalls",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Expedition_23_Landing.jpg"
      },
      "shots": [
        {
          "start": 22.633,
          "end": 25.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.24,
      "end": 27.892,
      "text": "That is how surviving destruction sounds.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Soyuz T-10-1 abort.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Soyuz_T-10-1_abort.jpg"
      },
      "shots": [
        {
          "start": 25.233,
          "end": 28.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
