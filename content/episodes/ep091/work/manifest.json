  "beats": [
    {
      "start": 0.08,
      "end": 4.18,
      "text": "A tiny particle hit Earth with the force of a fast-pitched baseball.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Cosmic ray event. Photograph taken July 1, 1960. Bubble Chamber-924 - DPLA - 191460725238ea887116556a03df3aba.jpg",
        "credit": "Department of Energy. Lawrence Berkeley National Laboratory. Public Affairs Department. Strategic Resources Office. Photography Services. 2012",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Cosmic_ray_event._Photograph_taken_July_1,_1960._Bubble_Chamber-924_-_DPLA_-_191460725238ea887116556a03df3aba.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.167,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.18,
      "end": 11.275,
      "text": "In October 1991, the Fly\u2019s Eye detector in Utah caught a visitor traveling at nearly light speed.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 4.167,
          "end": 11.267,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.275,
      "end": 17.775,
      "text": "Dubbed the Oh-My-God particle, it packed 320 exaelectronvolts of kinetic energy.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Protonshower.jpg",
        "credit": "Original uploader was Dinoj at en.wikipedia",
        "license": "CC BY 2.5",
        "url": "https://commons.wikimedia.org/wiki/File:Protonshower.jpg"
      },
      "shots": [
        {
          "start": 11.267,
          "end": 17.767,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.775,
      "end": 23.52,
      "text": "That is 47,000,000 times more energy than any machine humans have ever built.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Ten-meter-long plasma cell.png",
        "credit": "Maximilien Brice",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Ten-meter-long_plasma_cell.png"
      },
      "shots": [
        {
          "start": 17.767,
          "end": 23.533,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.52,
      "end": 29.59,
      "text": "Most assume such power requires a massive engine, like the jets of a supermassive black hole.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Illustration of Active Galactic Nucleus (2007-agns - accretiondisk torus).tiff",
        "credit": "NASA/CXC/Ohio State Univ./J.Eastman et al",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Illustration_of_Active_Galactic_Nucleus_(2007-agns_-_accretiondisk_torus).tiff"
      },
      "shots": [
        {
          "start": 23.533,
          "end": 29.6,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 29.59,
      "end": 35.51,
      "text": "But tracing its arrival path back reveals absolutely nothing in the darkness where it began.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hubble\u2019s colourful view of the Universe.jpg",
        "credit": "NASA, ESA, H. Teplitz and M. Rafelski (IPAC/Caltech), A. Koekemoer (STScI), R. Windhorst (Arizona State University), and Z. Levay (STScI)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Hubble%E2%80%99s_colourful_view_of_the_Universe.jpg"
      },
      "shots": [
        {
          "start": 29.6,
          "end": 32.5,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 32.5,
          "end": 35.5,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 35.51,
      "end": 41.755,
      "text": "In 2021, the Amaterasu particle arrived from an even emptier cosmic void.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 35.5,
          "end": 41.767,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 41.755,
      "end": 45.423,
      "text": "These cosmic voids keep firing mysteries just like this:",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Cosmic ray event. Photograph taken July 1, 1960. Bubble Chamber-924 - DPLA - 191460725238ea887116556a03df3aba.jpg",
