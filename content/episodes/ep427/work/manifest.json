  "beats": [
    {
      "start": 0.08,
      "end": 3.62,
      "text": "After millions of miles, this shuttle faced a traffic jam.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Endeavour escorts 1255.jpg",
        "credit": "Pedro Xing",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Endeavour_escorts_1255.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 1.8,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 1.8,
          "end": 3.633,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.62,
      "end": 6.48,
      "text": "It was built from spare structural parts left over from other orbiters.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Platforms Around Endeavour In Orbiter Processing Facility-2.jpg",
        "credit": "Kim Shiflett",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Platforms_Around_Endeavour_In_Orbiter_Processing_Facility-2.jpg"
      },
      "shots": [
        {
          "start": 3.633,
          "end": 6.467,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.48,
      "end": 10.56,
      "text": "The massive journey across the city took 68 hours.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 6.467,
          "end": 10.567,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.56,
      "end": 13.52,
      "text": "Crews cut down over 400 trees to clear the wide wings.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 10.567,
          "end": 13.533,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.52,
      "end": 16.86,
      "text": "Workers pulled down traffic lights and shut off high-voltage power lines.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Platforms Around Endeavour In Orbiter Processing Facility-2.jpg",
        "credit": "Kim Shiflett",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Platforms_Around_Endeavour_In_Orbiter_Processing_Facility-2.jpg"
      },
      "shots": [
        {
          "start": 13.533,
          "end": 16.867,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.86,
      "end": 20.58,
      "text": "The shuttle squeezed past apartment buildings with only inches of clearance.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Endeavour rollout ceremony.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Endeavour_rollout_ceremony.jpg"
      },
      "shots": [
        {
          "start": 16.867,
          "end": 19.433,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 19.433,
          "end": 20.567,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.58,
      "end": 24.918,
      "text": "The spacecraft survived orbit, but city streets were its slowest mission yet.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Endeavour escorts 1255.jpg",
        "credit": "Pedro Xing",
        "license": "CC0",
