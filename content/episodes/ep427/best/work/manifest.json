  "duration": 26.444,
  "beats": [
    {
      "start": 0.08,
      "end": 3.08,
      "text": "NASA hauled a space shuttle through city streets.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "STS-134 Endeavour approaches the VAB.jpg",
        "credit": "NASA/Jack Pfaller",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:STS-134_Endeavour_approaches_the_VAB.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 1.8,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 1.8,
          "end": 3.067,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.08,
      "end": 6.66,
      "text": "Endeavour had already flown nearly 123 million space miles.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Endeavour from ISS before docking.jpg",
        "credit": "NASA Expedition 20 crew",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Endeavour_from_ISS_before_docking.jpg"
      },
      "shots": [
        {
          "start": 3.067,
          "end": 4.967,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 4.967,
          "end": 6.667,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.66,
      "end": 9.2,
      "text": "It was built from spare parts left behind by other orbiters.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Platforms Around Endeavour In Orbiter Processing Facility-2.jpg",
        "credit": "Kim Shiflett",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Platforms_Around_Endeavour_In_Orbiter_Processing_Facility-2.jpg"
      },
      "shots": [
        {
          "start": 6.667,
          "end": 9.2,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.2,
      "end": 13.24,
      "text": "But its 12-mile journey through Los Angeles took 68 hours.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NASA's Boeing 747 SCA with the Space Shuttle Endeavour on top climbs out after takeoff from Edwards Air Force Base (EC01-0129-18).jpg",
        "credit": "NASA Armstrong Flight Research Center / NASA/Tony Landis",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:NASA%27s_Boeing_747_SCA_with_the_Space_Shuttle_Endeavour_on_top_climbs_out_after_takeoff_from_Edwards_Air_Force_Base_(EC01-0129-18).jpg"
      },
      "shots": [
        {
          "start": 9.2,
          "end": 13.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.24,
      "end": 16.06,
      "text": "Crews cut down over 400 trees to clear the wide wings.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 13.233,
          "end": 16.067,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.06,
      "end": 18.92,
      "text": "Workers shut off power lines and pulled down traffic lights.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NASA's Boeing 747 SCA with the Space Shuttle Endeavour on top climbs out after takeoff from Edwards Air Force Base (EC01-0129-18).jpg",
        "credit": "NASA Armstrong Flight Research Center / NASA/Tony Landis",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:NASA%27s_Boeing_747_SCA_with_the_Space_Shuttle_Endeavour_on_top_climbs_out_after_takeoff_from_Edwards_Air_Force_Base_(EC01-0129-18).jpg"
      },
      "shots": [
        {
          "start": 16.067,
          "end": 18.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.92,
      "end": 22.76,
      "text": "The spacecraft squeezed past apartment buildings with inches of clearance.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 18.933,
          "end": 22.767,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.76,
      "end": 26.094,
      "text": "Top speed for the entire trip was just two miles per hour.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "STS-134 Endeavour approaches the VAB.jpg",
        "credit": "NASA/Jack Pfaller",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:STS-134_Endeavour_approaches_the_VAB.jpg"
      },
      "shots": [
        {
          "start": 22.767,
          "end": 26.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
