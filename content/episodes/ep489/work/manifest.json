{
  "id": "ep489",
  "duration": 25.502,
  "beats": [
    {
      "start": 0.08,
      "end": 3.52,
      "text": "One battered spacecraft has been mapping Mars for twenty-three years.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "2001 mars odyssey wizja.jpg",
        "credit": "NASA/JPL/Corby Waste",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:2001_mars_odyssey_wizja.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.533,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.52,
      "end": 5.68,
      "text": "Most people think Mars missions die young.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PlanetMars-SyrtisMajor-VikingOrbiter-1980.jpg",
        "credit": "NASA/USGS",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PlanetMars-SyrtisMajor-VikingOrbiter-1980.jpg"
      },
      "shots": [
        {
          "start": 3.533,
          "end": 5.667,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 5.68,
      "end": 9.52,
      "text": "Arthur C. Clarke personally approved the name for this historic mission.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Arthur C. Clarke (1982).jpg",
        "credit": "Rob Croes for Anefo",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Arthur_C._Clarke_(1982).jpg"
      },
      "shots": [
        {
          "start": 5.667,
          "end": 7.6,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 7.6,
          "end": 9.533,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.52,
      "end": 12.74,
      "text": "To reach orbit without wasting fuel, it surfed the Martian atmosphere.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "MRO Aerobrake.jpg",
        "credit": "NASA/JPL/Corby Waste",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:MRO_Aerobrake.jpg"
      },
      "shots": [
        {
          "start": 9.533,
          "end": 12.733,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.74,
      "end": 15.0,
      "text": "A solar storm fried its radiation sensor.",
      "asset": {
        "source": "Flickr via Openverse",
        "title": "2021 - My Space Odyssey (180 MP)",
        "credit": "Andrea Luck",
        "license": "CC BY 2.0",
        "url": "https://www.flickr.com/photos/192271236@N03/51789033514"
      },
      "shots": [
        {
          "start": 12.733,
          "end": 15.0,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.0,
      "end": 17.56,
      "text": "Yet the resilient spacecraft survived the blow.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mars Odyssey illustration - \"On a Trip to Cirrus Minor\".jpg",
        "credit": "NASA/JPL/Corby Waste",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Mars_Odyssey_illustration_-_%22On_a_Trip_to_Cirrus_Minor%22.jpg"
      },
      "shots": [
        {
          "start": 15.0,
          "end": 17.567,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.56,
      "end": 21.04,
      "text": "It relayed eighty-five percent of data from surface rovers like Spirit.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Spirit Rover's First Colour Photograph of Mars - uncropped.png",
        "credit": "NASA/JPL/Cornell: Spirit (MER-A) Mars Exploration Rover",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Spirit_Rover%27s_First_Colour_Photograph_of_Mars_-_uncropped.png"
      },
      "shots": [
        {
          "start": 17.567,
          "end": 21.033,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.04,
      "end": 25.152,
      "text": "That is why one battered spacecraft has been mapping Mars for twenty-three years.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "2001 mars odyssey wizja.jpg",
        "credit": "NASA/JPL/Corby Waste",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:2001_mars_odyssey_wizja.jpg"
      },
      "shots": [
        {
          "start": 21.033,
          "end": 25.5,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
