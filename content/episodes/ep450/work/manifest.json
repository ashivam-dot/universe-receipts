  "beats": [
    {
      "start": 0.08,
      "end": 3.88,
      "text": "Scientists turned planet Earth into one giant radio dish.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Event Horizon Telescope Collaboration (testing-general-relativity-with-the-event-horizon).jpg",
        "credit": "D. Marrone/UofA",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Event_Horizon_Telescope_Collaboration_(testing-general-relativity-with-the-event-horizon).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.867,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.88,
      "end": 8.04,
      "text": "Eight observatories targeted a galaxy 55 million light-years away.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Nineteen ALMA antennas on the Chajnantor plateau (eso1137g).tiff",
        "credit": "ALMA (ESO/NAOJ/NRAO)/W. Garnier (ALMA)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Nineteen_ALMA_antennas_on_the_Chajnantor_plateau_(eso1137g).tiff"
      },
      "shots": [
        {
          "start": 3.867,
          "end": 8.033,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.04,
      "end": 10.84,
      "text": "Every dish synchronized its recordings using atomic clocks.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hydrogen maser atomic clock installed at the ALMA AOS (140604 almamaser 05).tiff",
        "credit": "ALMA (ESO/NAOJ/NRAO), C. Padilla",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Hydrogen_maser_atomic_clock_installed_at_the_ALMA_AOS_(140604_almamaser_05).tiff"
      },
      "shots": [
        {
          "start": 8.033,
          "end": 10.833,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.84,
      "end": 13.76,
      "text": "But the raw data was way too massive for the internet.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 10.833,
          "end": 13.767,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.76,
      "end": 17.16,
      "text": "Engineers had to fly petabytes of hard drives on airplanes.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "South Pole Telescope with Joaquin Vieira.jpg",
        "credit": "Joaquin Vieira",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:South_Pole_Telescope_with_Joaquin_Vieira.jpg"
      },
      "shots": [
        {
          "start": 13.767,
          "end": 17.167,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.16,
      "end": 20.92,
      "text": "Supercomputers processed the data into humanity's first black hole image.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Side by side of the first two images of black holes (eso2208-eht-mwd).jpg",
        "credit": "EHT Collaboration",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Side_by_side_of_the_first_two_images_of_black_holes_(eso2208-eht-mwd).jpg"
      },
      "shots": [
        {
          "start": 17.167,
          "end": 20.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.92,
      "end": 24.38,
      "text": "The shadow spans nearly forty billion kilometers across.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "M87* and Sgr A* side-by-side in polarised light (eso2406b).tiff",
        "credit": "EHT Collaboration",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:M87*_and_Sgr_A*_side-by-side_in_polarised_light_(eso2406b).tiff"
      },
      "shots": [
        {
          "start": 20.933,
          "end": 24.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.38,
      "end": 27.28,
      "text": "Its ring of light could swallow our entire solar system.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Simulated black hole with thick accretion disk.png",
        "credit": "Shocksingularity",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Simulated_black_hole_with_thick_accretion_disk.png"
      },
      "shots": [
        {
          "start": 24.367,
          "end": 27.267,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 27.28,
      "end": 29.176,
      "text": "No single telescope on Earth was big enough.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Event Horizon Telescope Collaboration (testing-general-relativity-with-the-event-horizon).jpg",
        "credit": "D. Marrone/UofA",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Event_Horizon_Telescope_Collaboration_(testing-general-relativity-with-the-event-horizon).jpg"
      },
      "shots": [
        {
          "start": 27.267,
          "end": 29.533,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
