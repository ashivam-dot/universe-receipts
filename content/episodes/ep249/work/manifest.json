{
  "id": "ep249",
  "duration": 41.077,
  "beats": [
    {
      "start": 0.08,
      "end": 3.16,
      "text": "Earth spent two months of 2024 with a second moon.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Earthrise over Compton crater -LRO full res.jpg",
        "credit": "NASA / Goddard Space Flight Center / Arizona State University",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Earthrise_over_Compton_crater_-LRO_full_res.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 1.6,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 1.6,
          "end": 3.167,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.16,
      "end": 8.64,
      "text": "On September 29, our gravity captured a bus-sized visitor named 2024 PT5.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Webb Detects Extremely Small Main Belt Asteroid (52672254127).jpg",
        "credit": "NASA's James Webb Space Telescope from Greenbelt, MD, USA",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Webb_Detects_Extremely_Small_Main_Belt_Asteroid_(52672254127).jpg"
      },
      "shots": [
        {
          "start": 3.167,
          "end": 8.633,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.64,
      "end": 13.1,
      "text": "It stayed for 57 days, but the rock never managed to complete a full orbit.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 8.633,
          "end": 13.1,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.1,
      "end": 16.7,
      "text": "Telescopes in Hawaii analyzed the object's light to see what it was made of.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Afshin Darian - NASA Infrared Telescope Facility.jpg",
        "credit": "Afshin Darian",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Afshin_Darian_-_NASA_Infrared_Telescope_Facility.jpg"
      },
      "shots": [
        {
          "start": 13.1,
          "end": 14.9,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 14.9,
          "end": 16.7,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.7,
      "end": 21.44,
      "text": "Here is the part I can\u2019t get past: its chemical signature perfectly matches lunar rock.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Lunar Sample 61016 - Big Muley.jpg",
        "credit": "National Aeronautics and Space Administration",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Lunar_Sample_61016_-_Big_Muley.jpg"
      },
      "shots": [
        {
          "start": 16.7,
          "end": 19.067,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 19.067,
          "end": 21.433,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.44,
      "end": 26.81,
      "text": "The object wasn't a random asteroid, but a piece of the Moon blasted off by a massive impact.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Asteroid falling to Earth.jpg",
        "credit": "State Farm",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Asteroid_falling_to_Earth.jpg"
      },
      "shots": [
        {
          "start": 21.433,
          "end": 26.8,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 26.81,
      "end": 31.68,
      "text": "Solar radiation pressure analysis proved this was a natural object and not human-made debris.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 26.8,
          "end": 31.667,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 31.68,
      "end": 36.4,
      "text": "This long-lost chunk of home will return to visit us again in the year 2084.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Asteroid falling to Earth.jpg",
        "credit": "State Farm",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Asteroid_falling_to_Earth.jpg"
      },
      "shots": [
        {
          "start": 31.667,
          "end": 36.4,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 36.4,
      "end": 40.727,
      "text": "It is the reason Earth spent two months of 2024 with a second moon.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Earthrise over Compton crater -LRO full res.jpg",
        "credit": "NASA / Goddard Space Flight Center / Arizona State University",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Earthrise_over_Compton_crater_-LRO_full_res.jpg"
      },
      "shots": [
        {
          "start": 36.4,
          "end": 41.067,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    }
  ],
