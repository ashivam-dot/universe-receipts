{
  "id": "ep095",
  "duration": 49.611,
  "beats": [
    {
      "start": 0.08,
      "end": 3.675,
      "text": "One bizarre nebula is colder than the Big Bang itself.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Boomerang nebula.jpg",
        "credit": "ESA/NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Boomerang_nebula.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.667,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.675,
      "end": 10.245,
      "text": "Located five thousand light-years away in Centaurus, this object reaches a bone-chilling one Kelvin.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Johannes Hevelius - Centaurus.jpg",
        "credit": "Johannes Hevelius",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Johannes_Hevelius_-_Centaurus.jpg"
      },
      "shots": [
        {
          "start": 3.667,
          "end": 6.933,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 6.933,
          "end": 10.233,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.245,
      "end": 15.965,
      "text": "While the Big Bang's afterglow is three Kelvin, this nebula is a freezing one Kelvin.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "WMAP 2012.png",
        "credit": "NASA / WMAP Science Team",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:WMAP_2012.png"
      },
      "shots": [
        {
          "start": 10.233,
          "end": 12.3,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 12.3,
          "end": 15.967,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.965,
      "end": 24.26,
      "text": "Astronomers Keith Taylor and Mike Scarrott named it around nineteen eighty after telescopes revealed a curved, asymmetrical shape.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Anglo-Australian Observatory.JPG",
        "credit": "Astro690",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Anglo-Australian_Observatory.JPG"
      },
      "shots": [
        {
          "start": 15.967,
          "end": 20.133,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 20.133,
          "end": 24.267,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.26,
      "end": 30.18,
      "text": "Later Hubble images exposed its true bow-tie form as a young planetary nebula.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "View of Hubble after Being Released from the Shuttle Atlantis (28223588012).jpg",
        "credit": "NASA Hubble Space Telescope",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:View_of_Hubble_after_Being_Released_from_the_Shuttle_Atlantis_(28223588012).jpg"
      },
      "shots": [
        {
          "start": 24.267,
          "end": 26.833,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 26.833,
          "end": 30.167,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 30.18,
      "end": 36.125,
      "text": "A dying central star is shedding mass up to one hundred times faster than similar stars.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Structure of stars (artist\u2019s impression) (eso0729a).tiff",
        "credit": "ESO",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Structure_of_stars_(artist%E2%80%99s_impression)_(eso0729a).tiff"
      },
      "shots": [
        {
          "start": 30.167,
          "end": 33.167,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 33.167,
          "end": 36.133,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 36.125,
      "end": 43.55,
      "text": "Blasting gas outward at hundreds of thousands of kilometers per hour causes extreme adiabatic cooling.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "A lonely little telescope.jpg",
        "credit": "Petr Hor\u00e1lek",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:A_lonely_little_telescope.jpg"
      },
      "shots": [
        {
          "start": 36.133,
          "end": 43.567,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 43.55,
      "end": 49.261,
      "text": "That rapid expansion drops temperatures below cosmic microwave radiation, explaining why.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Boomerang nebula.jpg",
        "credit": "ESA/NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Boomerang_nebula.jpg"
      },
      "shots": [
        {
          "start": 43.567,
          "end": 49.6,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
