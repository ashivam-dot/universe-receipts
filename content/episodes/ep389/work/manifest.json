          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.4,
      "end": 11.38,
      "text": "Alvan Clark finally saw the dim spark in 1862.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Alvan Clark - Portrait of a Man - 1977.303 - Fogg Museum.jpg",
        "credit": "Attributed to Alvan Clark",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Alvan_Clark_-_Portrait_of_a_Man_-_1977.303_-_Fogg_Museum.jpg"
      },
      "shots": [
        {
          "start": 8.4,
          "end": 11.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.38,
      "end": 14.48,
      "text": "It was a white dwarf, a tiny, cooling stellar core.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PSR J0348+0432.jpg",
        "credit": "ESO/L. Cal\u00e7ada",
        "license": "CC BY 4.0",
