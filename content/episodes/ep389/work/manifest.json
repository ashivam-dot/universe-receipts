  "beats": [
    {
      "start": 0.08,
      "end": 2.64,
      "text": "The brightest star in the night sky is wobbling.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The Dog Star, Sirius, and its Tiny Companion (2005-36-1820).jpg",
        "credit": "NASA, H.E. Bond and E. Nelan (Space Telescope Science Institute, Baltimore, Md.); M. Barstow and M. Burleigh (University of Leicester, U.K.); and J.B. Holberg (University of Arizona)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:The_Dog_Star,_Sirius,_and_its_Tiny_Companion_(2005-36-1820).jpg"
      },
      "shots": [
        {
          "start": 0.0,
