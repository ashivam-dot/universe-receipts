          "motion": "camera"
        }
      ]
    },
    {
      "start": 5.4,
      "end": 8.4,
      "text": "Astronomer Friedrich Bessel first deduced this ghost star.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Friedrich Wilhelm Bessel.jpeg",
        "credit": "Johann Eduard Wolff",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Friedrich_Wilhelm_Bessel.jpeg"
      },
      "shots": [
        {
          "start": 5.4,
