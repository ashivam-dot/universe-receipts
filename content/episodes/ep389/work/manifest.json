      },
      "shots": [
        {
          "start": 11.367,
          "end": 13.367,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 13.367,
          "end": 14.467,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.48,
      "end": 17.24,
      "text": "Walter Adams analyzed its light in 1915.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Walter Sydney Adams.jpg",
        "credit": "Smithsonian Institution",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Walter_Sydney_Adams.jpg"
      },
      "shots": [
        {
          "start": 14.467,
          "end": 17.233,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.24,
      "end": 20.32,
      "text": "Sirius B packs the Sun's entire mass into Earth's volume.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist's impression of the sizes of Sirius B and the Earth.jpg",
        "credit": "NASA/ESA",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%27s_impression_of_the_sizes_of_Sirius_B_and_the_Earth.jpg"
      },
      "shots": [
        {
          "start": 17.233,
          "end": 20.333,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.32,
      "end": 22.92,
      "text": "One cubic inch of this material weighs over a ton.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 20.333,
          "end": 22.933,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.92,
      "end": 24.87,
