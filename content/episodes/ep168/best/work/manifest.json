  "beats": [
    {
      "start": 0.08,
      "end": 4.521,
      "text": "The longest phantom planet hunt in history lasted over fifty years.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Planet-Vulcan 1846 003790.jpg",
        "credit": "Lith. of E. Jones & G.W. Newman",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Planet-Vulcan_1846_003790.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.267,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 2.267,
          "end": 4.533,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.521,
      "end": 14.216,
      "text": "In 1859, mathematician Urbain Le Verrier noticed Mercury straying from its Newtonian path by 43 arcseconds per century.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mercury in color - Prockter07 centered.jpg",
        "credit": "NASA/Johns Hopkins University Applied Physics Laboratory/Carnegie Institution of Washington. Edited version of Image:Mercury in color - Prockter07.jpg by Papa Lima Whiskey.",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Mercury_in_color_-_Prockter07_centered.jpg"
      },
      "shots": [
        {
          "start": 4.533,
          "end": 9.367,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 9.367,
          "end": 14.2,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.216,
      "end": 22.486,
      "text": "Having already predicted Neptune through gravitational math, he deduced an unseen world inside Mercury's orbit was tugging it.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Urbain Le Verrier.jpg",
        "credit": "User Magnus Manske on en.wikipedia",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Urbain_Le_Verrier.jpg"
      },
      "shots": [
        {
          "start": 14.2,
          "end": 22.5,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.486,
      "end": 29.731,
      "text": "Soon, an amateur observer reported its transit across the Sun, earning the Legion of Honor for discovering Vulcan.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mercury Solar Transit (NHQ201911110001).jpg",
        "credit": "Bill Ingalls",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Mercury_Solar_Transit_(NHQ201911110001).jpg"
      },
      "shots": [
        {
          "start": 22.5,
          "end": 29.733,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 29.731,
      "end": 37.251,
      "text": "Expeditions chased total solar eclipses, and professional astronomers even reported spotting the blazing world.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Trouvelot - Total eclipse of the sun - 1878.jpg",
        "credit": "\u00c9tienne L\u00e9opold Trouvelot",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Trouvelot_-_Total_eclipse_of_the_sun_-_1878.jpg"
      },
      "shots": [
        {
          "start": 29.733,
          "end": 33.5,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 33.5,
          "end": 37.267,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 37.251,
      "end": 44.546,
      "text": "Then in 1915, Albert Einstein plugged Mercury into his brand-new theory of general relativity.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Einstein 1921 by F Schmutzer - restoration.jpg",
        "credit": "Ferdinand Schmutzer / Adam Cuerden",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Einstein_1921_by_F_Schmutzer_-_restoration.jpg"
      },
      "shots": [
        {
          "start": 37.267,
          "end": 40.9,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 40.9,
          "end": 44.533,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 44.546,
      "end": 53.871,
      "text": "The Sun's mass was warping spacetime itself, giving Einstein heart palpitations when his math matched Mercury without any extra planet.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "GPB circling earth.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:GPB_circling_earth.jpg"
      },
      "shots": [
        {
          "start": 44.533,
          "end": 53.867,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 53.871,
      "end": 58.561,
      "text": "Space was bending, proving mankind had spent half a century chasing a ghost.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Planet-Vulcan 1846 003790.jpg",
        "credit": "Lith. of E. Jones & G.W. Newman",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Planet-Vulcan_1846_003790.jpg"
      },
      "shots": [
        {
          "start": 53.867,
          "end": 58.9,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
