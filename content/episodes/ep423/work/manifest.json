  "beats": [
    {
      "start": 0.08,
      "end": 4.0,
      "text": "A four-million-sun black hole fits inside Mercury's orbit.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Comparison of the sizes of two black holes- M87* and Sagittarius A* (eso2208-eht-mwe).jpg",
        "credit": "EHT collaboration (acknowledgment: Lia Medeiros, xkcd)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Comparison_of_the_sizes_of_two_black_holes-_M87*_and_Sagittarius_A*_(eso2208-eht-mwe).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.0,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 2.0,
          "end": 4.0,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.0,
      "end": 6.66,
      "text": "This invisible monster sits at the heart of our Milky Way.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Up high (potw1713a).tiff",
        "credit": "ESO/B. Tafreshi (twanight.org)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Up_high_(potw1713a).tiff"
      },
      "shots": [
        {
          "start": 4.0,
          "end": 6.667,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.66,
      "end": 10.04,
      "text": "Astronomers watched nearby stars whip around its gravity for decades.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "VLT images of S301 and other S-stars orbiting Sagittarius A* (eso2612c).tiff",
        "credit": "ESO/GRAVITY collaboration",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:VLT_images_of_S301_and_other_S-stars_orbiting_Sagittarius_A*_(eso2612c).tiff"
      },
      "shots": [
        {
          "start": 6.667,
          "end": 10.033,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.04,
      "end": 13.46,
      "text": "Eight radio telescopes then joined to form a virtual Earth-sized eye.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Locations of the telescopes that make up the EHT array (eso2208-eht-mwi).jpg",
        "credit": "ESO/M. Kornmesser",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Locations_of_the_telescopes_that_make_up_the_EHT_array_(eso2208-eht-mwi).jpg"
      },
      "shots": [
        {
          "start": 10.033,
          "end": 13.467,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.46,
      "end": 16.92,
      "text": "Gas orbits the hole so fast its appearance changes every few minutes.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Simulation of Material Orbiting close to a Black Hole.jpg",
        "credit": "ESO/Gravity Consortium/L. Cal\u00e7ada",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Simulation_of_Material_Orbiting_close_to_a_Black_Hole.jpg"
      },
      "shots": [
        {
          "start": 13.467,
          "end": 16.933,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.92,
      "end": 20.26,
      "text": "Scientists say imaging it was like photographing a dog chasing its tail.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 16.933,
          "end": 20.267,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.26,
      "end": 24.44,
      "text": "Five years of supercomputer work finally revealed its glowing orange shadow.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "First image of our black hole (eso2208-eht-mwa).jpg",
        "credit": "EHT Collaboration",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:First_image_of_our_black_hole_(eso2208-eht-mwa).jpg"
      },
      "shots": [
        {
          "start": 20.267,
          "end": 24.433,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.44,
      "end": 28.558,
      "text": "This massive anchor fits entirely inside the orbit of a single planet.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Comparison of the sizes of two black holes- M87* and Sagittarius A* (eso2208-eht-mwe).jpg",
