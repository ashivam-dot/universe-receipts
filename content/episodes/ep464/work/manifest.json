{
  "id": "ep464",
  "duration": 30.812,
  "beats": [
    {
      "start": 0.08,
      "end": 3.2,
      "text": "NASA used a spy satellite to check for launch damage.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "KH 12 const aug09.png",
        "credit": "<image Marco Langbroek, software Tricarico, orbits McCants>",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:KH_12_const_aug09.png"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.2,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.2,
      "end": 5.58,
      "text": "A shuttle launch is actually a controlled explosion.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Space Shuttle Columbia launching.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Space_Shuttle_Columbia_launching.jpg"
      },
      "shots": [
        {
          "start": 3.2,
          "end": 5.567,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 5.58,
      "end": 8.36,
      "text": "The noise vibrates your bones from three miles away.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "09 04075 Robert Gross Collection Photo - Robert E Gross Collection Image (54283361363).jpg",
        "credit": "San Diego Air & Space Museum Archives",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:09_04075_Robert_Gross_Collection_Photo_-_Robert_E_Gross_Collection_Image_(54283361363).jpg"
      },
      "shots": [
        {
          "start": 5.567,
          "end": 8.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.36,
      "end": 11.78,
      "text": "But at ignition, that sound became a physical wall.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Challenger explosion.jpg",
        "credit": "Kennedy Space Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Challenger_explosion.jpg"
      },
      "shots": [
        {
          "start": 8.367,
          "end": 11.767,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.78,
      "end": 14.64,
      "text": "This shockwave slammed into Columbia like a massive hammer.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "STS 80 - Columbia - Launch - KSC-96pc1287.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:STS_80_-_Columbia_-_Launch_-_KSC-96pc1287.jpg"
      },
      "shots": [
        {
          "start": 11.767,
          "end": 14.633,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.64,
      "end": 18.08,
      "text": "It instantly ripped sixteen heat tiles off the ship's belly.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "S118E06380 - STS-118 - IDC Survey Test of Tile Damage taken during STS-118 Mission - DPLA - eb6f06eb618cd10233e288d0d137155a.jpg",
        "credit": "National Aeronautics and Space Administration. Lyndon B. Johnson Space Center. 2/17/1973",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:S118E06380_-_STS-118_-_IDC_Survey_Test_of_Tile_Damage_taken_during_STS-118_Mission_-_DPLA_-_eb6f06eb618cd10233e288d0d137155a.jpg"
      },
      "shots": [
        {
          "start": 14.633,
          "end": 18.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.08,
      "end": 20.18,
      "text": "NASA feared the crew would burn up during reentry.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "STS-1 control room.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:STS-1_control_room.jpg"
      },
      "shots": [
        {
          "start": 18.067,
          "end": 20.167,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.18,
      "end": 23.42,
      "text": "They secretly used a Top Secret spy satellite for pictures.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Underwater Ice Station Zebra, 4 - Flickr - The Central Intelligence Agency.jpg",
        "credit": "The Central Intelligence Agency",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Underwater_Ice_Station_Zebra,_4_-_Flickr_-_The_Central_Intelligence_Agency.jpg"
      },
      "shots": [
        {
          "start": 20.167,
          "end": 23.433,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.42,
      "end": 26.4,
      "text": "Commander John Young actually saw the secret bird from orbit.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "John Young (STS-1).jpg",
        "credit": "Unknown authorUnknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:John_Young_(STS-1).jpg"
      },
      "shots": [
        {
          "start": 23.433,
          "end": 24.933,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 24.933,
          "end": 26.4,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 26.4,
      "end": 30.462,
      "text": "NASA's first shuttle launch required a spy to ensure it survived.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "KH 12 const aug09.png",
        "credit": "<image Marco Langbroek, software Tricarico, orbits McCants>",
