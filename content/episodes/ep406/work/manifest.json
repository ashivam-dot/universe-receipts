{
  "id": "ep406",
  "duration": 25.237,
  "beats": [
    {
      "start": 0.08,
      "end": 2.78,
      "text": "Jupiter and Saturn could survive the death of our Sun.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist's impression of an ultra-short-period planet.jpg",
        "credit": "NASA, ESA and A. Schaller",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%27s_impression_of_an_ultra-short-period_planet.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.767,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 2.78,
      "end": 6.06,
      "text": "Most people assume the whole solar system gets destroyed together.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Solar System graphic by NASA.png",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Solar_System_graphic_by_NASA.png"
      },
      "shots": [
        {
          "start": 2.767,
          "end": 6.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.06,
      "end": 9.38,
      "text": "Our Sun will eventually exhaust its core hydrogen fuel.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Active region NOAA 0484 (noao-04744).tiff",
        "credit": "NOIRLab/NSF/AURA",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Active_region_NOAA_0484_(noao-04744).tiff"
      },
      "shots": [
        {
          "start": 6.067,
          "end": 9.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.38,
      "end": 12.06,
      "text": "The star will expand into a massive red giant.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Red giant simulation 4 (cropped).jpg",
        "credit": "A. Chiavassa, R. Kudritzki, B. Davies, B. Freytag and S. E. de Mink",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Red_giant_simulation_4_(cropped).jpg"
      },
      "shots": [
        {
          "start": 9.367,
          "end": 12.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.06,
      "end": 14.68,
      "text": "It'll swallow inner worlds like Mercury and Venus.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Comparison of the Sun as it transforms into a red giant.png",
        "credit": "TTaaKKa 2200",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Comparison_of_the_Sun_as_it_transforms_into_a_red_giant.png"
      },
      "shots": [
        {
          "start": 12.067,
          "end": 14.667,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.68,
      "end": 17.9,
      "text": "But outer gas giants sit far enough away to escape.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist- unknown (JPL) Saturn Voyager Mission Artwork depicts the spacecraft's path on it's journey to Saturn as it passed above the orbits of Mercury, Venus, Earth, Mars and around Jupiter (ARC-1977-AC77-0849).jpg",
        "credit": "NASA Ames Research Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Artist-_unknown_(JPL)_Saturn_Voyager_Mission_Artwork_depicts_the_spacecraft%27s_path_on_it%27s_journey_to_Saturn_as_it_passed_above_the_orbits_of_Mercury,_Venus,_Earth,_Mars_and_around_Jupiter_(ARC-1977-AC77-0849).jpg"
      },
      "shots": [
        {
          "start": 14.667,
          "end": 16.267,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 16.267,
          "end": 17.9,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.9,
      "end": 20.78,
      "text": "The Sun will then shrink into a dense white dwarf.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Illustration of Rocky Debris around a White Dwarf.jpg",
        "credit": "NOIRLab/NSF/AURA/J. da Silva \n\nImage processing: M. Zamani and M. Kosari (NSF's NOIRLab)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Illustration_of_Rocky_Debris_around_a_White_Dwarf.jpg"
      },
      "shots": [
        {
          "start": 17.9,
          "end": 20.767,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.78,
      "end": 24.887,
      "text": "While the inner worlds vanish, these giants will orbit the sun's cold corpse.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist's impression of an ultra-short-period planet.jpg",
        "credit": "NASA, ESA and A. Schaller",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%27s_impression_of_an_ultra-short-period_planet.jpg"
      },
      "shots": [
        {
          "start": 20.767,
          "end": 25.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
