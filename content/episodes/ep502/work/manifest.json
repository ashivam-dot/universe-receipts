{
  "id": "ep502",
  "duration": 28.444,
  "beats": [
    {
      "start": 0.08,
      "end": 2.82,
      "text": "NASA flew to Jupiter just to look at the Sun.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Ulysses at Jupiter H1.jpg",
        "credit": "NASA/ESA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Ulysses_at_Jupiter_H1.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.833,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 2.82,
      "end": 5.72,
      "text": "Standard rockets couldn't push a probe out of Earth's flat orbit.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Dialogue-day3- yearly motion.png",
        "credit": "Galileo Galilei",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Dialogue-day3-_yearly_motion.png"
      },
      "shots": [
        {
          "start": 2.833,
          "end": 5.733,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 5.72,
      "end": 9.74,
      "text": "So Ulysses used Jupiter's gravity to loop over the Sun's poles.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Space probe trajectory example.png",
        "credit": "Orion 8",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Space_probe_trajectory_example.png"
      },
      "shots": [
        {
          "start": 5.733,
          "end": 9.733,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.74,
      "end": 12.94,
      "text": "It launched in 1990 and hit record-shattering speeds.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "STS-41 launch.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:STS-41_launch.jpg"
      },
      "shots": [
        {
          "start": 9.733,
          "end": 12.933,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.94,
      "end": 15.38,
      "text": "But the mission found far more than just a view.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "RTG radiation measurement.jpg",
        "credit": "Unknown authorUnknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:RTG_radiation_measurement.jpg"
      },
      "shots": [
        {
          "start": 12.933,
          "end": 15.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.38,
      "end": 19.06,
      "text": "Interstellar dust was thirty times more abundant than scientists expected.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Porous chondriteIDP.jpg",
        "credit": "The original uploader was Amara at English Wikipedia.",
        "license": "CC BY 1.0",
        "url": "https://commons.wikimedia.org/wiki/File:Porous_chondriteIDP.jpg"
      },
      "shots": [
        {
          "start": 15.367,
          "end": 19.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.06,
      "end": 22.7,
      "text": "The probe even unexpectedly sailed through three separate comet tails.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Comet Hyakutake by Bill Ingalls.jpg",
        "credit": "Bill Ingalls",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Comet_Hyakutake_by_Bill_Ingalls.jpg"
      },
      "shots": [
        {
          "start": 19.067,
          "end": 22.7,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.7,
      "end": 25.88,
      "text": "It revealed solar winds moving twice as fast at the poles.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Solar wind Speed interplanetary magnetic field.jpg",
        "credit": "NASA \u2013 Marshall Space Flight Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Solar_wind_Speed_interplanetary_magnetic_field.jpg"
      },
      "shots": [
        {
          "start": 22.7,
          "end": 25.867,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.88,
      "end": 28.094,
      "text": "To see the Sun from the top, you have to leave home.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Ulysses at Jupiter H1.jpg",
        "credit": "NASA/ESA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Ulysses_at_Jupiter_H1.jpg"
      },
      "shots": [
        {
          "start": 25.867,
          "end": 28.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
