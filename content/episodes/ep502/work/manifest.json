{
  "id": "ep502",
  "duration": 27.155,
  "beats": [
    {
      "start": 0.08,
      "end": 2.88,
      "text": "NASA flew to Jupiter just to look at the Sun.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Ulysses at Jupiter H1.jpg",
        "credit": "NASA/ESA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Ulysses_at_Jupiter_H1.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.867,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 2.88,
      "end": 5.8,
      "text": "Leaving the Sun behind was actually the only way to see it.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Parts of Ulysses.jpg",
        "credit": "NASA/ESA (Image modified by PlanetUser)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Parts_of_Ulysses.jpg"
      },
      "shots": [
        {
          "start": 2.867,
          "end": 5.8,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 5.8,
      "end": 8.94,
      "text": "Standard rockets are trapped in the Solar System\u2019s flat plane.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "24. Orbits of planets all in one plane (22125300334).jpg",
        "credit": "Community Archives",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:24._Orbits_of_planets_all_in_one_plane_(22125300334).jpg"
      },
      "shots": [
        {
          "start": 5.8,
          "end": 8.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.94,
      "end": 12.84,
      "text": "Only Jupiter's gravity could slingshot a probe over the Sun's poles.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Space probe trajectory example.png",
        "credit": "Orion 8",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Space_probe_trajectory_example.png"
      },
      "shots": [
        {
          "start": 8.933,
          "end": 12.833,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.84,
      "end": 16.28,
      "text": "Ulysses launched in 1990 to perform that impossible turn.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "STS-41 launch.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:STS-41_launch.jpg"
      },
      "shots": [
        {
          "start": 12.833,
          "end": 14.533,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 14.533,
          "end": 16.267,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.28,
      "end": 19.64,
      "text": "The probe even accidentally sailed through three different comet tails.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Comet Hyakutake by Bill Ingalls.jpg",
        "credit": "Bill Ingalls",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Comet_Hyakutake_by_Bill_Ingalls.jpg"
      },
      "shots": [
        {
          "start": 16.267,
          "end": 19.633,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.64,
      "end": 23.5,
      "text": "Then it revealed polar winds screaming twice as fast as the equator.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Solar wind Speed interplanetary magnetic field.jpg",
        "credit": "NASA \u2013 Marshall Space Flight Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Solar_wind_Speed_interplanetary_magnetic_field.jpg"
      },
      "shots": [
        {
          "start": 19.633,
          "end": 23.5,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.5,
      "end": 26.805,
      "text": "It remains the only mission sent to Jupiter just to look at the Sun.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Ulysses at Jupiter H1.jpg",
        "credit": "NASA/ESA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Ulysses_at_Jupiter_H1.jpg"
      },
      "shots": [
        {
          "start": 23.5,
          "end": 27.167,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
