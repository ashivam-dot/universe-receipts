{
  "id": "ep478",
  "duration": 32.554,
  "beats": [
    {
      "start": 0.08,
      "end": 4.18,
      "text": "Seven Earth-sized planets are crammed inside the orbit of Mercury.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Trappist-1 and its planets, compared to the inner Solar system.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Trappist-1_and_its_planets,_compared_to_the_inner_Solar_system.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.167,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.18,
      "end": 7.62,
      "text": "They circle a red dwarf barely larger than Jupiter.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist impression of ultra fluffy gas giant planet orbiting a red dwarf star.jpg",
        "credit": "NOIRLab/NSF/AURA/J. da Silva/Spaceengine/M. Zamani",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist_impression_of_ultra_fluffy_gas_giant_planet_orbiting_a_red_dwarf_star.jpg"
      },
      "shots": [
        {
          "start": 4.167,
          "end": 7.633,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.62,
      "end": 11.98,
      "text": "On the world TRAPPIST-1e, one year lasts just six days.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Trappist 1dcrop.jpg",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Trappist_1dcrop.jpg"
      },
      "shots": [
        {
          "start": 7.633,
          "end": 11.967,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.98,
      "end": 16.16,
      "text": "It stays permanently locked with one side always facing its sun.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Exoplanet WASP-43b orbits its parent star.jpg",
        "credit": "NASA, ESA, and Z. Levay (STScI)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Exoplanet_WASP-43b_orbits_its_parent_star.jpg"
      },
      "shots": [
        {
          "start": 11.967,
          "end": 16.167,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.16,
      "end": 19.84,
      "text": "One half is scorched desert; the other is frozen night.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA21423 - Surface of TRAPPIST-1f.jpg",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA21423_-_Surface_of_TRAPPIST-1f.jpg"
      },
      "shots": [
        {
          "start": 16.167,
          "end": 19.833,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.84,
      "end": 24.78,
      "text": "Stellar winds drive currents that heat the planet, slowly stripping away its atmosphere.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist impression of a young low-mass star stripping away the atmosphere of an even younger exoplanet.jpg",
        "credit": "X-ray: NASA/CXC/RIT/A. Varga et al.; Illustration: NASA/CXC/SAO/M. Weiss; Image Processing: NASA/CXC/SAO/N. Wolk",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Artist_impression_of_a_young_low-mass_star_stripping_away_the_atmosphere_of_an_even_younger_exoplanet.jpg"
      },
      "shots": [
        {
          "start": 19.833,
          "end": 23.167,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 23.167,
          "end": 24.767,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.78,
      "end": 28.16,
      "text": "It remains caught between a paradise and an airless rock.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "TRAPPIST-1e Artist's Impression.png",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:TRAPPIST-1e_Artist%27s_Impression.png"
      },
      "shots": [
        {
          "start": 24.767,
          "end": 28.167,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 28.16,
      "end": 32.204,
      "text": "Yet all seven worlds still fit inside Mercury's orbit.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Trappist-1 and its planets, compared to the inner Solar system.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Trappist-1_and_its_planets,_compared_to_the_inner_Solar_system.jpg"
      },
      "shots": [
        {
          "start": 28.167,
          "end": 32.567,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
