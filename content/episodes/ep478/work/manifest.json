          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.96,
      "end": 6.98,
      "text": "They circle a red dwarf star barely larger than Jupiter.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA21429 - Transit Illustration of TRAPPIST-1 (cropped).jpg",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA21429_-_Transit_Illustration_of_TRAPPIST-1_(cropped).jpg"
      },
      "shots": [
        {
          "start": 3.967,
          "end": 5.533,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 5.533,
