{
  "id": "ep478",
  "duration": 31.139,
  "beats": [
    {
      "start": 0.08,
      "end": 4.1,
      "text": "Seven Earth-sized planets are crammed inside the orbit of Mercury.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Trappist-1 and its planets, compared to the inner Solar system.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Trappist-1_and_its_planets,_compared_to_the_inner_Solar_system.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.1,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.1,
      "end": 6.96,
      "text": "They circle a red dwarf barely larger than the planet Jupiter.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "96235main compjpg.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:96235main_compjpg.jpg"
      },
      "shots": [
        {
          "start": 4.1,
          "end": 6.967,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.96,
      "end": 10.98,
      "text": "On the world TRAPPIST-1e, one year lasts just six days.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Trappist 1dcrop.jpg",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Trappist_1dcrop.jpg"
      },
      "shots": [
        {
          "start": 6.967,
          "end": 10.967,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.98,
      "end": 13.86,
      "text": "It stays permanently locked with one side always facing its sun.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Exoplanet WASP-43b orbits its parent star.jpg",
        "credit": "NASA, ESA, and Z. Levay (STScI)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Exoplanet_WASP-43b_orbits_its_parent_star.jpg"
      },
      "shots": [
        {
          "start": 10.967,
          "end": 13.867,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.86,
      "end": 16.98,
      "text": "One half is scorched desert; the other is frozen night.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA21423 - Surface of TRAPPIST-1f.jpg",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA21423_-_Surface_of_TRAPPIST-1f.jpg"
      },
      "shots": [
        {
          "start": 13.867,
          "end": 16.967,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.98,
      "end": 21.0,
      "text": "This rapid orbit through stellar winds creates massive electric currents.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 16.967,
          "end": 21.0,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.0,
      "end": 23.94,
      "text": "These currents act like a heater, potentially stripping the atmosphere.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist impression of a young low-mass star stripping away the atmosphere of an even younger exoplanet.jpg",
        "credit": "X-ray: NASA/CXC/RIT/A. Varga et al.; Illustration: NASA/CXC/SAO/M. Weiss; Image Processing: NASA/CXC/SAO/N. Wolk",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Artist_impression_of_a_young_low-mass_star_stripping_away_the_atmosphere_of_an_even_younger_exoplanet.jpg"
      },
      "shots": [
        {
          "start": 21.0,
          "end": 22.033,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 22.033,
          "end": 23.933,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.94,
      "end": 26.78,
      "text": "It is a world caught between paradise and airless rock.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NASA's Webb Hints at Possible Atmosphere Surrounding Rocky Exoplanet (Artist Concept) - 53706147943.jpg",
        "credit": "James Webb Space Telescope",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:NASA%27s_Webb_Hints_at_Possible_Atmosphere_Surrounding_Rocky_Exoplanet_(Artist_Concept)_-_53706147943.jpg"
      },
      "shots": [
        {
          "start": 23.933,
          "end": 26.767,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 26.78,
      "end": 30.789,
      "text": "A whole solar system still huddles around this tiny, red star.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Trappist-1 and its planets, compared to the inner Solar system.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Trappist-1_and_its_planets,_compared_to_the_inner_Solar_system.jpg"
      },
      "shots": [
        {
          "start": 26.767,
          "end": 31.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
