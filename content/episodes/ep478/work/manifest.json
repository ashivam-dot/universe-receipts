          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.98,
      "end": 10.6,
      "text": "On the world TRAPPIST-1e, one full year lasts just six days.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "TRAPPIST-1e artist impression 2018.png",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:TRAPPIST-1e_artist_impression_2018.png"
      },
      "shots": [
        {
          "start": 6.967,
          "end": 10.6,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.6,
      "end": 13.78,
      "text": "It stays permanently locked with one side always facing its sun.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Exoplanet WASP-43b orbits its parent star.jpg",
        "credit": "NASA, ESA, and Z. Levay (STScI)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Exoplanet_WASP-43b_orbits_its_parent_star.jpg"
      },
      "shots": [
        {
          "start": 10.6,
          "end": 13.767,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.78,
      "end": 17.04,
      "text": "One half is scorched desert; the other is frozen night.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist\u2019s impression of view from one of the middle planets in the TRAPPIST-1 system.jpg",
        "credit": "ESO/N. Bartmann/spaceengine.org",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%E2%80%99s_impression_of_view_from_one_of_the_middle_planets_in_the_TRAPPIST-1_system.jpg"
      },
      "shots": [
        {
          "start": 13.767,
          "end": 17.033,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.04,
      "end": 20.06,
      "text": "Electric currents from intense stellar winds may be stripping its air.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist's concept of exoplanet with comet-like tail (opo1021a).tiff",
        "credit": "Artwork Credit: NASA, ESA, and G. Bacon (STScI). Science Credit: J. Linsky (University of Colorado, Boulder, Colo., USA)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%27s_concept_of_exoplanet_with_comet-like_tail_(opo1021a).tiff"
      },
      "shots": [
        {
          "start": 17.033,
          "end": 20.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.06,
      "end": 24.38,
      "text": "This world hangs between a lush paradise and a barren, airless stone.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NASA's Webb Hints at Possible Atmosphere Surrounding Rocky Exoplanet (Artist Concept) - 53706147943.jpg",
