  "beats": [
    {
      "start": 0.08,
      "end": 3.92,
      "text": "Two speeding space probes drifted off course for thirty years.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Date- Dec 1972 Pioneer 10 Artwork Spacecraft shown above Jupiter's surface (used in NASA SP-349) (ARC-1969-AC72-1351).jpg",
        "credit": "NASA Ames Research Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Date-_Dec_1972_Pioneer_10_Artwork_Spacecraft_shown_above_Jupiter%27s_surface_(used_in_NASA_SP-349)_(ARC-1969-AC72-1351).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 1.6,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 1.6,
          "end": 3.933,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.92,
      "end": 11.515,
      "text": "In 1972 and 1973, NASA launched Pioneer 10 and 11 to the outer solar system.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Pioneer 11 prior to launch.jpg",
        "credit": "NASA Kennedy Space Center (NASA-KSC)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Pioneer_11_prior_to_launch.jpg"
      },
      "shots": [
        {
          "start": 3.933,
          "end": 7.833,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 7.833,
          "end": 11.5,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.515,
      "end": 16.91,
      "text": "Because they were spin-stabilized, they were the most precisely tracked spacecraft in history.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Goldstone DSN antenna.jpg",
        "credit": "Unknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Goldstone_DSN_antenna.jpg"
      },
      "shots": [
        {
          "start": 11.5,
          "end": 14.067,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 14.067,
          "end": 16.9,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.91,
      "end": 23.455,
      "text": "By 1980, scientists noticed both probes were experiencing an unexpected deceleration.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 16.9,
          "end": 23.467,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.455,
      "end": 29.575,
      "text": "Some physicists speculated the anomaly might indicate a breakdown in general relativity.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "A 1960s advert for working at NASA's Jet Propulsion Laboratories (JPL).jpeg",
        "credit": "fdecomite",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:A_1960s_advert_for_working_at_NASA%27s_Jet_Propulsion_Laboratories_(JPL).jpeg"
      },
      "shots": [
        {
          "start": 23.467,
          "end": 29.567,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 29.575,
      "end": 36.52,
      "text": "Researchers found old magnetic tracking tapes stored under a staircase at the Jet Propulsion Laboratory.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyager spacecraft structure-fr.png",
        "credit": "Voyager_spacecraft_structure.jpg: NASA\nderivative work: Pline (talk)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Voyager_spacecraft_structure-fr.png"
      },
      "shots": [
        {
          "start": 29.567,
          "end": 36.533,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 36.52,
      "end": 43.97,
      "text": "In 2012, scientists proved the probes were simply shining infrared waste heat out of their own instruments.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Pioneer plaque P10 Closeup.png",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Pioneer_plaque_P10_Closeup.png"
      },
      "shots": [
        {
          "start": 36.533,
          "end": 40.433,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 40.433,
          "end": 43.967,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 43.97,
      "end": 53.557,
      "text": "Waste heat from electrical instruments pushed them backward like a microscopic headlight, proving why two speeding space probes drifted off course for thirty years.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Date- Dec 1972 Pioneer 10 Artwork Spacecraft shown above Jupiter's surface (used in NASA SP-349) (ARC-1969-AC72-1351).jpg",
        "credit": "NASA Ames Research Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Date-_Dec_1972_Pioneer_10_Artwork_Spacecraft_shown_above_Jupiter%27s_surface_(used_in_NASA_SP-349)_(ARC-1969-AC72-1351).jpg"
      },
      "shots": [
        {
          "start": 43.967,
          "end": 53.9,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
