  "beats": [
    {
      "start": 0.08,
      "end": 16.88,
      "text": "Every single day since November 2000, humans have lived in space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Earth and international space station.jpg",
        "credit": "NASA\u2009/\u2009pingnews.com",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Earth_and_international_space_station.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 8.433,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 8.433,
          "end": 16.867,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.88,
      "end": 20.46,
      "text": "Many people assume space stations are only occupied during brief astronaut visits.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "STS079-789-096.jpg",
        "credit": "Earth Science and Remote Sensing Unit, NASA Johnson Space Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:STS079-789-096.jpg"
      },
      "shots": [
        {
          "start": 16.867,
          "end": 20.467,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.46,
      "end": 24.82,
      "text": "On October 31, 2000, three men launched aboard a Soyuz rocket from Kazakhstan.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Soyuz TM-31 launch.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Soyuz_TM-31_launch.jpg"
      },
      "shots": [
        {
          "start": 20.467,
          "end": 24.833,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.82,
      "end": 30.52,
      "text": "Former U.S. Navy SEAL William Shepherd and cosmonauts Yuri Gidzenko and Sergei Krikalev docked two days later.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "ISS-Expedition 1-crew.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:ISS-Expedition_1-crew.jpg"
      },
      "shots": [
        {
          "start": 24.833,
          "end": 27.667,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 27.667,
          "end": 30.533,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 30.52,
      "end": 34.56,
      "text": "Shepherd invoked naval tradition to give their new orbital outpost the call sign Alpha.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "STS097-315-025 - STS-097 - Gidzenko videotapes activities in Zvezda during STS-97's ISS visit - DPLA - a124d9f7df9fe0e35fec040b79400e83.jpg",
        "credit": "National Aeronautics and Space Administration. Lyndon B. Johnson Space Center. 2/17/1973",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:STS097-315-025_-_STS-097_-_Gidzenko_videotapes_activities_in_Zvezda_during_STS-97%27s_ISS_visit_-_DPLA_-_a124d9f7df9fe0e35fec040b79400e83.jpg"
      },
      "shots": [
        {
          "start": 30.533,
          "end": 34.567,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 34.56,
      "end": 39.88,
      "text": "Over 136 days, the crew activated basic life support systems and received massive solar arrays.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "STS-97 International Space Station seen from Space Shuttle Endeavour.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:STS-97_International_Space_Station_seen_from_Space_Shuttle_Endeavour.jpg"
      },
      "shots": [
        {
          "start": 34.567,
          "end": 37.2,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 37.2,
          "end": 39.867,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 39.88,
      "end": 45.36,
      "text": "In February 2001, Space Shuttle Atlantis delivered the 1.4 billion dollar Destiny research module.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "ISS Destiny Lab.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:ISS_Destiny_Lab.jpg"
      },
      "shots": [
        {
          "start": 39.867,
          "end": 42.6,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 42.6,
          "end": 45.367,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 45.36,
      "end": 50.2,
      "text": "When Expedition 1 handed over control in March 2001, they secured continuous orbital living.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Expedition 1 and 2 Crews Pose for a Photo (iss01e6886-c9cac4).jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Expedition_1_and_2_Crews_Pose_for_a_Photo_(iss01e6886-c9cac4).jpg"
      },
      "shots": [
        {
          "start": 45.367,
          "end": 47.8,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 47.8,
          "end": 50.2,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 50.2,
      "end": 54.089,
      "text": "That unbroken chain ensures someone is always residing above the atmosphere.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Earth and international space station.jpg",
        "credit": "NASA\u2009/\u2009pingnews.com",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Earth_and_international_space_station.jpg"
      },
      "shots": [
        {
          "start": 50.2,
          "end": 54.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
