          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.42,
      "end": 7.3,
      "text": "William Herschel spotted NGC 4449 and saw a total mess.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "William Herschel01.jpg",
        "credit": "Lemuel Francis Abbott",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:William_Herschel01.jpg"
      },
      "shots": [
        {
          "start": 3.433,
          "end": 5.367,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 5.367,
          "end": 7.3,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.3,
      "end": 10.5,
      "text": "It has no spiral arms, just a chaotic, irregular shape.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NGC 4449 (Hubble image) (potm2405e).tiff",
        "credit": "NASA, ESA, A. Aloisi (ESA/STScI) and The Hubble Heritage (STScI/AURA)-ESA/Hubble Collaboration",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:NGC_4449_(Hubble_image)_(potm2405e).tiff"
      },
      "shots": [
        {
          "start": 7.3,
          "end": 10.5,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.5,
      "end": 14.1,
      "text": "But astronomers also found vibrant pink clouds of glowing gas.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NGC 4449 (15680665832).png",
        "credit": "geckzilla",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:NGC_4449_(15680665832).png"
      },
      "shots": [
        {
          "start": 10.5,
          "end": 14.1,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.1,
      "end": 17.8,
      "text": "These clouds are intense nurseries creating massive waves of stars.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Lynx Arc Star-Formation Region (Illustration) (01FN9896CTRPAY59FXCV95V89Q).png",
        "credit": "ARTWORK: ESA, NASA, Robert A.E. Fosbury (ST-ECF)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Lynx_Arc_Star-Formation_Region_(Illustration)_(01FN9896CTRPAY59FXCV95V89Q).png"
      },
      "shots": [
        {
          "start": 14.1,
          "end": 17.8,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.8,
      "end": 20.54,
      "text": "They even spotted huge clusters of young, blue-white stars.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NGC 4449 (NIRCam image - cropped) (potm2405d).jpg",
        "credit": "ESA/Webb, NASA & CSA, A. Adamo (Stockholm University) and the FEAST JWST team",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:NGC_4449_(NIRCam_image_-_cropped)_(potm2405d).jpg"
      },
      "shots": [
        {
          "start": 17.8,
          "end": 20.533,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.54,
      "end": 23.04,
      "text": "The clue to this chaos was hiding in the neighbors.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Canes Venatici charta.png",
        "credit": "Roberto Mura",
        "license": "CC BY 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:Canes_Venatici_charta.png"
      },
      "shots": [
        {
          "start": 20.533,
          "end": 23.033,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.04,
      "end": 26.88,
      "text": "A gravitational tug-of-war with nearby galaxies ignited this starburst.",
