{
  "id": "ep089",
  "duration": 50.128,
  "beats": [
    {
      "start": 0.08,
      "end": 4.379,
      "text": "A billion-light-year hole in space could be a scar from another universe.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Multiverse.jpg",
        "credit": "KronicTOOL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Multiverse.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.379,
      "end": 12.024,
      "text": "In 2004, astronomers scanning the cosmic background radiation discovered an unexpected anomaly.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "WMAP 2012.png",
        "credit": "NASA / WMAP Science Team",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:WMAP_2012.png"
      },
      "shots": [
        {
          "start": 4.367,
          "end": 8.2,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 8.2,
          "end": 12.033,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.024,
      "end": 18.719,
      "text": "This massive Cold Spot in the constellation Eridanus is seventy microkelvin cooler than average.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Location of AT2019qiz in the constellation of Eridanus (eso2018b).jpg",
        "credit": "ESO, IAU and Sky & Telescope",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Location_of_AT2019qiz_in_the_constellation_of_Eridanus_(eso2018b).jpg"
      },
      "shots": [
        {
          "start": 12.033,
          "end": 15.7,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 15.7,
          "end": 18.733,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.719,
      "end": 24.589,
      "text": "The anomaly spans up to two billion light-years and is largely devoid of stars and gas.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Simulation of large scale structure (eso1438b).jpg",
        "credit": "Illustris Collaboration",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Simulation_of_large_scale_structure_(eso1438b).jpg"
      },
      "shots": [
        {
          "start": 18.733,
          "end": 20.867,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 20.867,
          "end": 24.6,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.589,
      "end": 32.409,
      "text": "As ancient photons cross this vacuum, the universe's expansion stretches the region, causing light to lose energy.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Fundamental Interactions.png",
        "credit": "ParticlesAndMath",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Fundamental_Interactions.png"
      },
      "shots": [
        {
          "start": 24.6,
          "end": 32.4,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 32.409,
      "end": 38.879,
      "text": "The European Space Agency's Planck satellite confirmed this bizarre emptiness in 2013.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "202029-New-History v3 3200.png",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:202029-New-History_v3_3200.png"
      },
      "shots": [
        {
          "start": 32.4,
          "end": 34.8,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 34.8,
          "end": 38.867,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 38.879,
      "end": 45.179,
      "text": "Some researchers theorize the Cold Spot is an imprint of a collision with a parallel universe.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "202029-New-History v3 3200.png",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:202029-New-History_v3_3200.png"
      },
      "shots": [
        {
          "start": 38.867,
          "end": 45.167,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 45.179,
      "end": 49.778,
      "text": "That cosmic bruise remains carved across the sky by a parallel universe.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Multiverse.jpg",
        "credit": "KronicTOOL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Multiverse.jpg"
      },
      "shots": [
        {
          "start": 45.167,
          "end": 50.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
