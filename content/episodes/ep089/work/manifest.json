{
  "id": "ep089",
  "duration": 49.09,
  "beats": [
    {
      "start": 0.08,
      "end": 3.852,
      "text": "A billion-light-year hole in space might be a cosmic bruise.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Multiverse.jpg",
        "credit": "KronicTOOL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Multiverse.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.867,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.852,
      "end": 11.497,
      "text": "In 2004, astronomers scanning the Big Bang's ancient afterglow found a massive, unexpected anomaly.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "WMAP 2012.png",
        "credit": "NASA / WMAP Science Team",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:WMAP_2012.png"
      },
      "shots": [
        {
          "start": 3.867,
          "end": 7.3,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 7.3,
          "end": 11.5,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.497,
      "end": 19.292,
      "text": "NASA's WMAP satellite detected a distinct Cold Spot in the constellation Eridanus that shouldn't exist.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Eridanus-Fieldbook of Stars-133.png",
        "credit": "William Tyler Olcott",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Eridanus-Fieldbook_of_Stars-133.png"
      },
      "shots": [
        {
          "start": 11.5,
          "end": 15.167,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 15.167,
          "end": 19.3,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.292,
      "end": 26.162,
      "text": "This supervoid spans nearly two billion light-years and is almost entirely empty of all normal matter.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Simulation of large scale structure (eso1438b).jpg",
        "credit": "Illustris Collaboration",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Simulation_of_large_scale_structure_(eso1438b).jpg"
      },
      "shots": [
        {
          "start": 19.3,
          "end": 23.867,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 23.867,
          "end": 26.167,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 26.162,
      "end": 33.107,
      "text": "Ancient light photons lose energy as they cross this wasteland through the Integrated Sachs-Wolfe effect.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Redshifted Light From Distant Galaxies (4195-Image).png",
        "credit": "and A. Feild ()",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Redshifted_Light_From_Distant_Galaxies_(4195-Image).png"
      },
      "shots": [
        {
          "start": 26.167,
          "end": 30.933,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 30.933,
          "end": 33.1,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 33.107,
      "end": 38.702,
      "text": "The feature was so unexpected that some researchers nicknamed it the Axis of Evil.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Axis od evil.png",
        "credit": "ESA-Planck collaboration",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Axis_od_evil.png"
      },
      "shots": [
        {
          "start": 33.1,
          "end": 38.7,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 38.702,
      "end": 45.627,
      "text": "One mind-bending theory suggests this massive gap is where our universe collided with a parallel one.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Omega-Point-Multiverse.png",
        "credit": "Jamiemichelle at English Wikipedia",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Omega-Point-Multiverse.png"
      },
      "shots": [
        {
          "start": 38.7,
          "end": 43.3,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 43.3,
          "end": 45.633,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 45.627,
      "end": 48.74,
      "text": "Such an ancient impact would leave a permanent scar.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Multiverse.jpg",
        "credit": "KronicTOOL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Multiverse.jpg"
      },
      "shots": [
        {
          "start": 45.633,
          "end": 49.1,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
