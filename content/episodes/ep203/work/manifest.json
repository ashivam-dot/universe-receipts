{
  "id": "ep203",
  "duration": 51.181,
  "beats": [
    {
      "start": 0.08,
      "end": 5.822,
      "text": "An asteroid zipped 1,830 miles above Earth, yet nobody saw it coming.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA24038-Asteroid2020QG-20200816.jpg",
        "credit": "ZTF/Caltech Optical Observatories (funded by NASA and the National Science Foundation-NSF)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA24038-Asteroid2020QG-20200816.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.567,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 2.567,
          "end": 5.833,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 5.822,
      "end": 13.192,
      "text": "In August 2020, this SUV-sized space rock approached from the hidden, blinding direction of the bright Sun.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 5.833,
          "end": 13.2,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.192,
      "end": 22.412,
      "text": "Traveling at a blistering 27,600 miles per hour, it remained entirely invisible to all our ground-based observatories.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 13.2,
          "end": 22.4,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.412,
      "end": 29.632,
      "text": "Earth's massive gravity then violently bent the trajectory of this rock by roughly 45 degrees of arc.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA24038-Asteroid2020QG-20200816.jpg",
        "credit": "ZTF/Caltech Optical Observatories (funded by NASA and the National Science Foundation-NSF)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA24038-Asteroid2020QG-20200816.jpg"
      },
      "shots": [
        {
          "start": 22.4,
          "end": 29.633,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 29.632,
      "end": 37.482,
      "text": "The Zwicky Transient Facility finally spotted the tiny object six hours after its closest, most terrifying approach.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 29.633,
          "end": 37.467,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 37.482,
      "end": 45.907,
      "text": "This event remains the absolute closest non-impacting asteroid flyby ever recorded by our modern global science.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 37.467,
          "end": 45.9,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 45.907,
      "end": 50.831,
      "text": "The massive blind spot created by the Sun is why we never saw that asteroid.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA24038-Asteroid2020QG-20200816.jpg",
        "credit": "ZTF/Caltech Optical Observatories (funded by NASA and the National Science Foundation-NSF)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA24038-Asteroid2020QG-20200816.jpg"
      },
      "shots": [
        {
          "start": 45.9,
          "end": 51.167,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
