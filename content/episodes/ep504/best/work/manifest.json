{
  "id": "ep504",
  "duration": 26.601,
  "beats": [
    {
      "start": 0.08,
      "end": 2.58,
      "text": "The Sun and Moon look identical in our sky.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Eclipse (40525545663).jpg",
        "credit": "Agnes Happen",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Eclipse_(40525545663).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.567,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 2.58,
      "end": 5.3,
      "text": "Most people assume they are naturally similar in size.",
      "asset": {
        "source": "Wellcome Collection",
        "title": "Astronomy: eclipses (top), and the Moon's passage around the Earth. Coloured engraving by J. Emslie, 1851, after himself",
        "credit": "Wellcome Collection",
        "license": "Public domain",
        "url": "https://wellcomecollection.org/works/dmzeqfcb"
      },
      "shots": [
        {
          "start": 2.567,
          "end": 5.3,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 5.3,
      "end": 9.08,
      "text": "But the Sun is roughly 400 times wider than the Moon.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The Sun by the Atmospheric Imaging Assembly of NASA's Solar Dynamics Observatory - 20100819.jpg",
        "credit": "NASA/SDO (AIA)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:The_Sun_by_the_Atmospheric_Imaging_Assembly_of_NASA%27s_Solar_Dynamics_Observatory_-_20100819.jpg"
      },
      "shots": [
        {
          "start": 5.3,
          "end": 9.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.08,
      "end": 12.14,
      "text": "It is also 400 times farther away from Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Earth to Sun.png",
        "credit": "Lucas Vieira",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Earth_to_Sun.png"
      },
      "shots": [
        {
          "start": 9.067,
          "end": 12.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.14,
      "end": 15.7,
      "text": "That matching ratio makes both objects span half a degree.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Moon - 24 9 2026 (55548152177).jpg",
        "credit": "Dixe",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Moon_-_24_9_2026_(55548152177).jpg"
      },
      "shots": [
        {
          "start": 12.133,
          "end": 14.533,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 14.533,
          "end": 15.7,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.7,
      "end": 19.2,
      "text": "During totality, the Moon covers the Sun's disk completely.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The Sun\u2019s corona shining brightly during a total solar eclipse (noirlab1902a).tiff",
        "credit": "2009 Miloslav Druckm\u00fcller, Peter Aniol, Vojtech Ru\u0161in, \u013dubom\u00edr Klocok, Karel Marti\u0161ek, Martin Dietzel",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:The_Sun%E2%80%99s_corona_shining_brightly_during_a_total_solar_eclipse_(noirlab1902a).tiff"
      },
      "shots": [
        {
          "start": 15.7,
          "end": 19.2,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.2,
      "end": 22.92,
      "text": "Artemis astronauts will even watch a 57-minute eclipse in space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Orion LunarFLyby 4k (656314676363).jpg",
        "credit": "Uploaded by Patricia Moore",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Orion_LunarFLyby_4k_(656314676363).jpg"
      },
      "shots": [
        {
          "start": 19.2,
          "end": 22.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.92,
      "end": 26.251,
      "text": "That is why both distant worlds look identical in our sky.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Eclipse (40525545663).jpg",
        "credit": "Agnes Happen",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Eclipse_(40525545663).jpg"
      },
      "shots": [
        {
          "start": 22.933,
          "end": 26.6,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    }
  ],
