  "beats": [
    {
      "start": 0.08,
      "end": 4.097,
      "text": "An orange dwarf star is hurtling straight toward our solar system.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist Illustration NASA\u2019s Webb Measures the Temperature of a Rocky Exoplanet (52775409328).jpg",
        "credit": "NASA's James Webb Space Telescope from Greenbelt, MD, USA",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist_Illustration_NASA%E2%80%99s_Webb_Measures_the_Temperature_of_a_Rocky_Exoplanet_(52775409328).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 1.6,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 1.6,
          "end": 4.1,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.097,
      "end": 11.792,
      "text": "Sitting 62.3 light-years away in Serpens, precision data from the Gaia spacecraft reveals a shocking path.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Pinpointing Gaia to Map the Milky Way (Annotated) (eso1908b).tiff",
        "credit": "ESO",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Pinpointing_Gaia_to_Map_the_Milky_Way_(Annotated)_(eso1908b).tiff"
      },
      "shots": [
        {
          "start": 4.1,
          "end": 11.8,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.792,
      "end": 19.362,
      "text": "Astronomers tracked Gliese 710 heading toward us at roughly 14.5 kilometers per second.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Crop on Gliese 710.jpg",
        "credit": "Original author: Hypatia Alexandria from Santa Fe, File:The Serpent's Tail - Flickr - HypatiaPhoto.jpg\nderivative work:Harlock81",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Crop_on_Gliese_710.jpg"
      },
      "shots": [
        {
          "start": 11.8,
          "end": 19.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.362,
      "end": 25.832,
      "text": "In about 1.29 million years, it will plow directly into our solar system's Oort cloud.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Oort cloud lrg.en.png",
        "credit": "Nasa.gov",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Oort_cloud_lrg.en.png"
      },
      "shots": [
        {
          "start": 19.367,
          "end": 25.833,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.832,
      "end": 36.307,
      "text": "At a closest approach of 10,520 astronomical units, it becomes the brightest object in our night sky besides the Sun, Moon, and Venus.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 25.833,
          "end": 36.3,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 36.307,
      "end": 42.452,
      "text": "While major planets remain safe, its immense gravity will dislodge millions of icy comets.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Illustration- Path of comet C-2025 K1 (ATLAS) (heic2606c).tiff",
        "credit": "NASA, ESA, R. Crawford (STScI)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Illustration-_Path_of_comet_C-2025_K1_(ATLAS)_(heic2606c).tiff"
      },
      "shots": [
        {
          "start": 36.3,
          "end": 39.833,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 39.833,
          "end": 42.467,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 42.452,
      "end": 51.107,
      "text": "This gravitational disturbance triggers ten naked-eye comets per year, proving an orange dwarf star is hurtling straight toward our solar system.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist Illustration NASA\u2019s Webb Measures the Temperature of a Rocky Exoplanet (52775409328).jpg",
        "credit": "NASA's James Webb Space Telescope from Greenbelt, MD, USA",
