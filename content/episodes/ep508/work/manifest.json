{
  "id": "ep508",
  "duration": 29.565,
  "beats": [
    {
      "start": 0.08,
      "end": 3.38,
      "text": "A Soviet lander touched Mars and died in seconds.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.367,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.38,
      "end": 6.98,
      "text": "It made history as the first successful soft landing.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "FP2A3620 (23497688248) (cropped).jpg",
        "credit": "\u041c\u0443\u0437\u0435\u0439 \u041a\u043e\u0441\u043c\u043e\u043d\u0430\u0432\u0442\u0438\u043a\u0438 from \u0420\u043e\u0441\u0441\u0438\u044f",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:FP2A3620_(23497688248)_(cropped).jpg"
      },
      "shots": [
        {
          "start": 3.367,
          "end": 6.967,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.98,
      "end": 10.56,
      "text": "Then the probe transmitted data for only fourteen seconds.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 6.967,
          "end": 10.567,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.56,
      "end": 14.16,
      "text": "It returned only a partial gray image with no details.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Delta on Mars.jpg",
        "credit": "NASA/JPL/Malin Space Science Systems",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Delta_on_Mars.jpg"
      },
      "shots": [
        {
          "start": 10.567,
          "end": 14.167,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.16,
      "end": 17.68,
      "text": "A massive planet-wide dust storm raged below.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Ascraeus Mons M9 PIA02999.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Ascraeus_Mons_M9_PIA02999.jpg"
      },
      "shots": [
        {
          "start": 14.167,
          "end": 17.667,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.68,
      "end": 19.7,
      "text": "Nobody knew what happened to the lost hardware.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mars Reconnaissance Orbiter spacecraft model.png",
        "credit": "National Aeronautics and Space Administration (NASA)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Mars_Reconnaissance_Orbiter_spacecraft_model.png"
      },
      "shots": [
        {
          "start": 17.667,
          "end": 19.7,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.7,
      "end": 22.88,
      "text": "Decades later, citizen scientists searched NASA photos.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 19.7,
          "end": 22.867,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.88,
      "end": 25.7,
      "text": "They found the parachute sitting on the surface.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mars Reconnaissance Orbiter spacecraft model.png",
        "credit": "National Aeronautics and Space Administration (NASA)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Mars_Reconnaissance_Orbiter_spacecraft_model.png"
      },
      "shots": [
        {
          "start": 22.867,
          "end": 25.7,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.7,
      "end": 29.215,
      "text": "Amateur sleuths spotted a Soviet lander on Mars.",
