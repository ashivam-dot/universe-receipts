{
  "id": "ep112",
  "duration": 52.246,
  "beats": [
    {
      "start": 0.08,
      "end": 4.572,
      "text": "A city-killer asteroid hid in plain sight until just before impact.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Asteroidsscale.jpg",
        "credit": "NASA/JPL-Caltech/JAXA/ESA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Asteroidsscale.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.567,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.572,
      "end": 11.942,
      "text": "In July 2019, 2019 OK screamed past us at nearly 55,000 miles per hour.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 4.567,
          "end": 11.933,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.942,
      "end": 17.262,
      "text": "The football-field-sized rock missed our planet by about 45,000 miles.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 11.933,
          "end": 17.267,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.262,
      "end": 20.607,
      "text": "That is less than one-fifth of the distance to the Moon.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Moon Phase and Libration, 2026 (SVS5587 - fancy).jpg",
        "credit": "NASA's Scientific Visualization Studio - USRA/Ernie Wright, NASA/GSFC/Noah Petro, eMITS/James Tralie",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Moon_Phase_and_Libration,_2026_(SVS5587_-_fancy).jpg"
      },
      "shots": [
        {
          "start": 17.267,
          "end": 20.6,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.607,
      "end": 25.827,
      "text": "An impact would have released over thirty times the energy of the Hiroshima bomb.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Little Boy bomb.jpg",
        "credit": "US Atomic Energy Commission (now US Department of Energy)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Little_Boy_bomb.jpg"
      },
      "shots": [
        {
          "start": 20.6,
          "end": 22.5,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 22.5,
          "end": 25.833,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.827,
      "end": 32.697,
      "text": "Survey telescopes like Pan-STARRS had actually photographed it earlier, but it went unrecognized.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Starr-141106-2755-Dubautia menziesii-habitat view Pan Starrs telescopes-Science City-Maui (25130256292).jpg",
        "credit": "Forest and Kim Starr",
        "license": "CC BY 3.0 us",
        "url": "https://commons.wikimedia.org/wiki/File:Starr-141106-2755-Dubautia_menziesii-habitat_view_Pan_Starrs_telescopes-Science_City-Maui_(25130256292).jpg"
      },
      "shots": [
        {
          "start": 25.833,
          "end": 29.267,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 29.267,
          "end": 32.7,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 32.697,
      "end": 38.192,
      "text": "Because the asteroid was heading directly toward us, it appeared completely stationary.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist's impression of a white dwarf devouring a minor planet.jpg",
        "credit": "CfA/Mark A. Garlick",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%27s_impression_of_a_white_dwarf_devouring_a_minor_planet.jpg"
      },
      "shots": [
        {
          "start": 32.7,
          "end": 34.967,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 34.967,
          "end": 38.2,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 38.192,
      "end": 44.817,
      "text": "Amateur astronomers Jacques, Pimentel, and Ribeiro finally spotted the threat before its approach.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Yepun and the Milky Way.jpg",
        "credit": "ESO/J. Colosimo",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Yepun_and_the_Milky_Way.jpg"
      },
      "shots": [
        {
          "start": 38.2,
          "end": 40.7,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 40.7,
          "end": 44.833,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 44.817,
      "end": 51.896,
      "text": "This Apollo-class rock won't return for 200 years, but it proved how a city-killer asteroid hid in plain sight.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Asteroidsscale.jpg",
        "credit": "NASA/JPL-Caltech/JAXA/ESA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Asteroidsscale.jpg"
      },
      "shots": [
        {
          "start": 44.833,
          "end": 52.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
