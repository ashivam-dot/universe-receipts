  "beats": [
    {
      "start": 0.08,
      "end": 4.247,
      "text": "A city-killer asteroid hid in plain sight before missing our planet.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA21259 - Celestial Object 2016 WF9, a NEOWISE Discovery (Artist Concept).jpg",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA21259_-_Celestial_Object_2016_WF9,_a_NEOWISE_Discovery_(Artist_Concept).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 1.733,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 1.733,
          "end": 4.233,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.247,
      "end": 11.617,
      "text": "In July 2019, 2019 OK screamed past us at nearly 55,000 miles per hour.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 4.233,
          "end": 11.6,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.617,
      "end": 16.937,
      "text": "The football-field-sized rock missed our planet by about 45,000 miles.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 11.6,
          "end": 16.933,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.937,
      "end": 20.282,
      "text": "That is less than one-fifth of the distance to the Moon.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Moon Phase and Libration, 2026 South Up (SVS5588 - distance).jpg",
        "credit": "NASA's Scientific Visualization Studio - USRA/Ernie Wright, NASA/GSFC/Noah Petro, eMITS/James Tralie",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Moon_Phase_and_Libration,_2026_South_Up_(SVS5588_-_distance).jpg"
      },
      "shots": [
        {
          "start": 16.933,
          "end": 20.267,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.282,
      "end": 25.502,
      "text": "An impact would have released over thirty times the energy of the Hiroshima bomb.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Little Boy bomb.jpg",
        "credit": "US Atomic Energy Commission (now US Department of Energy)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Little_Boy_bomb.jpg"
      },
      "shots": [
        {
          "start": 20.267,
          "end": 22.167,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 22.167,
          "end": 25.5,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.502,
      "end": 32.372,
      "text": "Survey telescopes like Pan-STARRS had actually photographed it earlier, but it went unrecognized.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Starr-141106-2755-Dubautia menziesii-habitat view Pan Starrs telescopes-Science City-Maui (25130256292).jpg",
        "credit": "Forest and Kim Starr",
        "license": "CC BY 3.0 us",
        "url": "https://commons.wikimedia.org/wiki/File:Starr-141106-2755-Dubautia_menziesii-habitat_view_Pan_Starrs_telescopes-Science_City-Maui_(25130256292).jpg"
      },
      "shots": [
        {
          "start": 25.5,
          "end": 28.933,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 28.933,
          "end": 32.367,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 32.372,
      "end": 37.867,
      "text": "Because the asteroid was heading directly toward us, it appeared completely stationary.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist's impression of a white dwarf devouring a minor planet.jpg",
        "credit": "CfA/Mark A. Garlick",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%27s_impression_of_a_white_dwarf_devouring_a_minor_planet.jpg"
      },
      "shots": [
        {
          "start": 32.367,
          "end": 34.633,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 34.633,
          "end": 37.867,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 37.867,
      "end": 44.492,
      "text": "Amateur astronomers Jacques, Pimentel, and Ribeiro finally spotted the threat before its approach.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Yepun and the Milky Way.jpg",
        "credit": "ESO/J. Colosimo",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Yepun_and_the_Milky_Way.jpg"
      },
      "shots": [
        {
          "start": 37.867,
          "end": 40.367,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 40.367,
          "end": 44.5,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 44.492,
      "end": 51.709,
      "text": "This Apollo-class rock won't return for 200 years, but it proved how easily a giant asteroid can sneak up on us.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA21259 - Celestial Object 2016 WF9, a NEOWISE Discovery (Artist Concept).jpg",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA21259_-_Celestial_Object_2016_WF9,_a_NEOWISE_Discovery_(Artist_Concept).jpg"
      },
      "shots": [
        {
          "start": 44.5,
          "end": 52.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
