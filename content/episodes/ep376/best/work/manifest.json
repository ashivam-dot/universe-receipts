{
  "id": "ep376",
  "duration": 33.612,
  "beats": [
    {
      "start": 0.08,
      "end": 3.36,
      "text": "A black hole shoots plasma jets at half light speed.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist's impression of Cygnus X-1.jpg",
        "credit": "NASA, ESA, Martin Kornmesser (ESA/Hubble)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%27s_impression_of_Cygnus_X-1.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.36,
      "end": 8.32,
      "text": "Discovered in nineteen sixty-four, Cygnus X-one is history's first confirmed black hole.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 3.367,
          "end": 8.333,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.32,
      "end": 11.94,
      "text": "It sits seven thousand light-years away in the constellation Cygnus.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Cygnus (cyg).jpg",
        "credit": "IAU and Sky & Telescope",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Cygnus_(cyg).jpg"
      },
      "shots": [
        {
          "start": 8.333,
          "end": 11.933,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.94,
      "end": 16.62,
      "text": "The beast pairs with a blue supergiant star named HDE 226868.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Noao-cyg x1.jpg",
        "credit": "T.A. Rector (University of Alaska Anchorage) and H. Schweiker (WIYN and NOIRLab/NSF/AURA)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Noao-cyg_x1.jpg"
      },
      "shots": [
        {
          "start": 11.933,
          "end": 14.267,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 14.267,
          "end": 16.633,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.62,
      "end": 19.28,
      "text": "They orbit each other every five point six days.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Accretion Disk Binary System.jpg",
        "credit": "Unknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Accretion_Disk_Binary_System.jpg"
      },
      "shots": [
        {
          "start": 16.633,
          "end": 19.267,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.28,
      "end": 22.8,
      "text": "The black hole continuously strips material into an accretion disk.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Black hole jet diagram.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Black_hole_jet_diagram.jpg"
      },
      "shots": [
        {
          "start": 19.267,
          "end": 22.8,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.8,
      "end": 26.66,
      "text": "These jets shine with the energy of ten thousand suns.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Illustration of Active Galactic Nucleus (2007-agns - accretiondisk torus).jpg",
        "credit": "NASA/CXC/Ohio State Univ./J.Eastman et al",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Illustration_of_Active_Galactic_Nucleus_(2007-agns_-_accretiondisk_torus).jpg"
      },
      "shots": [
        {
          "start": 22.8,
          "end": 26.667,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 26.66,
      "end": 29.92,
      "text": "Stellar winds make the plasma jets visibly dance and wobble.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "RS Ophiuchi.jpg",
        "credit": "ESO",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:RS_Ophiuchi.jpg"
      },
      "shots": [
        {
          "start": 26.667,
          "end": 29.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 29.92,
      "end": 33.262,
      "text": "That explains why a black hole shoots plasma jets at half light speed.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist's impression of Cygnus X-1.jpg",
        "credit": "NASA, ESA, Martin Kornmesser (ESA/Hubble)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%27s_impression_of_Cygnus_X-1.jpg"
      },
      "shots": [
        {
          "start": 29.933,
          "end": 33.6,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
