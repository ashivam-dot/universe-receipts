{
  "id": "ep376",
  "duration": 27.115,
  "beats": [
    {
      "start": 0.08,
      "end": 2.32,
      "text": "A black hole has jets that dance.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Cygnus X-1.png",
        "credit": "ESA, Hubble",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Cygnus_X-1.png"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.333,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 2.32,
      "end": 5.1,
      "text": "These plasma beams blast out at half the speed of light.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Black hole jet diagram.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Black_hole_jet_diagram.jpg"
      },
      "shots": [
        {
          "start": 2.333,
          "end": 5.1,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 5.1,
      "end": 9.0,
      "text": "Sounding rockets first spotted this strange X-ray source in 1964.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 5.1,
          "end": 9.0,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.0,
      "end": 11.68,
      "text": "It was history's first confirmed black hole.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Chandra X-ray Image with Scale Bar (2000-0216-more-1).tiff",
        "credit": "(Credit: NASA/UMD/A. Wilson et al.)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Chandra_X-ray_Image_with_Scale_Bar_(2000-0216-more-1).tiff"
      },
      "shots": [
        {
          "start": 9.0,
          "end": 11.667,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.68,
      "end": 14.84,
      "text": "Cygnus X-1 is locked in a tight orbit with a supergiant star.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Binary system Cygnus X-1.jpg",
        "credit": "NASA / Honeywell Max-Q Digital Group / Dana Berry",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Binary_system_Cygnus_X-1.jpg"
      },
      "shots": [
        {
          "start": 11.667,
          "end": 14.833,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.84,
      "end": 18.22,
      "text": "It's actively tearing superheated gas away from its companion.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "XRISM Spots Iron Fingerprints in Nearby Active Galaxy (SVS14584 - Labeled Black Hole v9).jpg",
        "credit": "NASA's Scientific Visualization Studio - null",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:XRISM_Spots_Iron_Fingerprints_in_Nearby_Active_Galaxy_(SVS14584_-_Labeled_Black_Hole_v9).jpg"
      },
      "shots": [
        {
          "start": 14.833,
          "end": 16.6,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 16.6,
          "end": 18.233,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.22,
      "end": 20.88,
      "text": "Stephen Hawking even bet against it being a black hole.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Stephen Hawking 050506.jpg",
        "credit": "\u00b2\u00b0\u00b9\u00b0\u00b0",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Stephen_Hawking_050506.jpg"
      },
      "shots": [
        {
          "start": 18.233,
          "end": 20.867,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.88,
      "end": 23.82,
      "text": "Massive stellar winds batter the jets into a wobble.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "High Mass X-ray binary System with Jets (2002-0214-more-1).tiff",
        "credit": "(Illustration: NASA/CXC/M.Weiss)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:High_Mass_X-ray_binary_System_with_Jets_(2002-0214-more-1).tiff"
      },
      "shots": [
        {
          "start": 20.867,
          "end": 22.333,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 22.333,
          "end": 23.833,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.82,
      "end": 26.765,
      "text": "That's why a black hole has jets that dance.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Cygnus X-1.png",
        "credit": "ESA, Hubble",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Cygnus_X-1.png"
      },
      "shots": [
        {
          "start": 23.833,
          "end": 27.1,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
