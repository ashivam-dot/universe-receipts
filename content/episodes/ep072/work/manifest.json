{
  "id": "ep072",
  "duration": 49.298,
  "beats": [
    {
      "start": 0.08,
      "end": 4.747,
      "text": "A monster solar storm missed erasing our modern world by nine days.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Magnificent CME Erupts on the Sun - August 31.jpg",
        "credit": "NASA Goddard Space Flight Center",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Magnificent_CME_Erupts_on_the_Sun_-_August_31.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.733,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.747,
      "end": 11.242,
      "text": "On July 23, 2012, the Sun launched a massive Carrington-class plasma eruption.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "CME Cornucopia (May 11, 2012) (hd video) (7203919450).jpg",
        "credit": "NASA Goddard Space Flight Center from Greenbelt, MD, USA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:CME_Cornucopia_(May_11,_2012)_(hd_video)_(7203919450).jpg"
      },
      "shots": [
        {
          "start": 4.733,
          "end": 11.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.242,
      "end": 17.287,
      "text": "This blast traveled at over two thousand kilometers per second, four times faster than normal.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 11.233,
          "end": 17.3,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.287,
      "end": 23.607,
      "text": "It achieved this record speed because an eruption four days earlier had cleared its cosmic path.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The Sun Flares with Activity.jpg",
        "credit": "NASA's Earth Observatory",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:The_Sun_Flares_with_Activity.jpg"
      },
      "shots": [
        {
          "start": 17.3,
          "end": 23.6,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.607,
      "end": 29.952,
      "text": "A direct hit would have crippled global power grids and water pumps, costing over two trillion dollars.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 23.6,
          "end": 29.967,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 29.952,
      "end": 36.402,
      "text": "Instead, NASA's STEREO-A spacecraft in deep space safely recorded the entire blow.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The two STEREO spacecrafts sits on a test stand.jpg",
        "credit": "NASA/George Shelton",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:The_two_STEREO_spacecrafts_sits_on_a_test_stand.jpg"
      },
      "shots": [
        {
          "start": 29.967,
          "end": 33.633,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 33.633,
          "end": 36.4,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 36.402,
      "end": 43.172,
      "text": "Physicist Pete Riley calculated a twelve percent chance a similar disaster strikes Earth each decade.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The Mauli & Polyblank photograph of Richard C Carrington.jpg",
        "credit": "Halojones",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:The_Mauli_%26_Polyblank_photograph_of_Richard_C_Carrington.jpg"
      },
      "shots": [
        {
          "start": 36.4,
          "end": 43.167,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 43.172,
      "end": 48.948,
      "text": "We survived only because the erupting region of the Sun was no longer pointed directly at us.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Magnificent CME Erupts on the Sun - August 31.jpg",
        "credit": "NASA Goddard Space Flight Center",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Magnificent_CME_Erupts_on_the_Sun_-_August_31.jpg"
      },
      "shots": [
        {
          "start": 43.167,
          "end": 49.3,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
