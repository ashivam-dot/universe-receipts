      "shots": [
        {
          "start": 11.3,
          "end": 15.5,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.5,
      "end": 18.44,
      "text": "They're all traveling together toward the constellation Sagittarius.",
      "asset": {
        "source": "Wikimedia Commons",
