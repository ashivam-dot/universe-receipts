    {
      "start": 0.08,
      "end": 3.8,
      "text": "The Big Dipper\u2019s stars are drifting apart in opposite directions.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Big Dipper (ann22042ah).jpg",
        "credit": "Arya Anthony/IAU OAE",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Big_Dipper_(ann22042ah).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.8,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.8,
      "end": 7.2,
      "text": "We usually see this spoon as a permanent cosmic landmark.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Ursa Major (Annotated) (ursa-major-ann).jpg",
        "credit": "E. Slawik/NOIRLab/NSF/AURA/M. Zamani",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Ursa_Major_(Annotated)_(ursa-major-ann).jpg"
      },
      "shots": [
        {
          "start": 3.8,
          "end": 5.567,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 5.567,
          "end": 7.2,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.2,
      "end": 12.0,
      "text": "Astronomer Richard Proctor found a secret drifting family in 1869.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Richard Anthony Proctor2.jpg",
        "credit": "William Shaw Warren",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Richard_Anthony_Proctor2.jpg"
      },
      "shots": [
        {
          "start": 7.2,
          "end": 9.233,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 9.233,
          "end": 12.0,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.0,
      "end": 15.92,
      "text": "Merak, Phecda, Megrez, Alioth, and Mizar are stellar siblings.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Big Dipper (14436403977).jpg",
        "credit": "Kevin M. Gill",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Big_Dipper_(14436403977).jpg"
      },
      "shots": [
        {
          "start": 12.0,
          "end": 15.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.92,
      "end": 18.98,
      "text": "They're all traveling together toward the constellation Sagittarius.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The constellation Sagittarius (Annotated ground-based view) (heic0107d).tiff",
        "credit": "ESA, NASA & Akira Fujii",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:The_constellation_Sagittarius_(Annotated_ground-based_view)_(heic0107d).tiff"
      },
      "shots": [
        {
          "start": 15.933,
          "end": 17.467,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 17.467,
          "end": 18.967,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.98,
      "end": 21.66,
      "text": "But the stars at the ends are total strangers.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "International Space Station (ISS) over Italy.jpg",
        "credit": "gjdonatiello",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:International_Space_Station_(ISS)_over_Italy.jpg"
      },
      "shots": [
        {
          "start": 18.967,
          "end": 21.667,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.66,
      "end": 24.06,
      "text": "Dubhe and Alkaid are actually zooming the other way.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Flammarion - Curiosit\u00e9s du ciel - fig-077p.png",
        "credit": "F0x1",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Flammarion_-_Curiosit%C3%A9s_du_ciel_-_fig-077p.png"
      },
      "shots": [
        {
          "start": 21.667,
          "end": 24.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.06,
      "end": 28.2,
      "text": "This tug-of-war will bend the handle until the spoon dissolves in 100,000 years.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Ursa Major, Otto's Encyclopedia.jpg",
        "credit": "Unknown authorUnknown author. The author of the picture is not given, the author of the encyclopedia entry is V\u00e1clav Rosick\u00fd.",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Ursa_Major,_Otto%27s_Encyclopedia.jpg"
      },
      "shots": [
        {
          "start": 24.067,
          "end": 26.367,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 26.367,
          "end": 28.2,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 28.2,
      "end": 31.453,
      "text": "The famous spoon is slowly breaking into pieces.",
