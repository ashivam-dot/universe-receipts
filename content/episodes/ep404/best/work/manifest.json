{
  "id": "ep404",
  "duration": 33.44,
  "beats": [
    {
      "start": 0.08,
      "end": 3.52,
      "text": "A dead star can hide inside a living giant star.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Betelgeuse and Siwarha.png",
        "credit": "WhirligigGirl",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Betelgeuse_and_Siwarha.png"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.533,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.52,
      "end": 7.06,
      "text": "To our telescopes, the host looks like an ordinary red supergiant.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Image of Betelgeuse\u2019s surface taken in January 2019 (eso2109f).jpg",
        "credit": "ESO/M. Montarg\u00e8s et al.",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Image_of_Betelgeuse%E2%80%99s_surface_taken_in_January_2019_(eso2109f).jpg"
      },
      "shots": [
        {
          "start": 3.533,
          "end": 7.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.06,
      "end": 10.86,
      "text": "But gas friction drags a swallowed neutron star toward the center.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Betelgeuse and wake of its companion star (artist's concept) (opo2602).tiff",
        "credit": "NASA, ESA, E. Wheatley (STScI), Science: A. Dupree (CfA)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Betelgeuse_and_wake_of_its_companion_star_(artist%27s_concept)_(opo2602).tiff"
      },
      "shots": [
        {
          "start": 7.067,
          "end": 10.867,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.86,
      "end": 14.02,
      "text": "Falling gas heats up to nearly one billion Kelvin.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Swift J1749.4-2807.jpg",
        "credit": "NASA/GSFC",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Swift_J1749.4-2807.jpg"
      },
      "shots": [
        {
          "start": 10.867,
          "end": 14.033,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.02,
      "end": 18.96,
      "text": "This extreme heat forces rapid proton capture inside the stellar belly.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Light nuclide abundance and origins hi res.png",
        "credit": "Urayness",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Light_nuclide_abundance_and_origins_hi_res.png"
      },
      "shots": [
        {
          "start": 14.033,
          "end": 16.5,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 16.5,
          "end": 18.967,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.96,
      "end": 22.6,
      "text": "Violent convection churns rare rubidium and molybdenum toward the surface.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "SMC inset.jpg",
        "credit": "ESA/Hubble and Digitized Sky Survey 2",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:SMC_inset.jpg"
      },
      "shots": [
        {
          "start": 18.967,
          "end": 22.6,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.6,
      "end": 25.9,
      "text": "The ravenous core keeps devouring gas and growing heavier.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "IGR J17062-6143 binary still.jpg",
        "credit": "NASA/Goddard Space Flight Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:IGR_J17062-6143_binary_still.jpg"
      },
      "shots": [
        {
          "start": 22.6,
          "end": 25.9,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.9,
      "end": 29.86,
      "text": "Eventually, that hidden dead core collapses into a black hole.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Illustration of Black Hole System (2020-19-4641).png",
        "credit": ", , and D. Player ()",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Illustration_of_Black_Hole_System_(2020-19-4641).png"
      },
      "shots": [
        {
          "start": 25.9,
          "end": 29.867,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 29.86,
      "end": 33.09,
      "text": "Nothing survives once a dead star burrows deep inside.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Betelgeuse and Siwarha.png",
        "credit": "WhirligigGirl",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Betelgeuse_and_Siwarha.png"
      },
      "shots": [
        {
          "start": 29.867,
          "end": 33.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
