    {
      "start": 4.577,
      "end": 13.897,
      "text": "In 1988, astronomers discovered PSR B1957+20, a rapidly spinning neutron star in our galaxy.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Pti aerial photo B.jpg",
        "credit": "Gerard T. van Belle",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Pti_aerial_photo_B.jpg"
      },
      "shots": [
        {
          "start": 4.567,
          "end": 13.9,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.897,
      "end": 22.217,
      "text": "It rotates once every 1.6 milliseconds, while its small companion completes a tight orbit every 9.2 hours.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Millisecond Pulsar.jpg",
        "credit": "B. Saxton, NRAO/AUI/NSF",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Millisecond_Pulsar.jpg"
      },
      "shots": [
        {
          "start": 13.9,
          "end": 18.067,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 18.067,
          "end": 22.233,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.217,
      "end": 28.912,
      "text": "As the pulsar races through space at one million kilometers per hour, it generates a bright bow shock.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Illustration of the Mouse System (2004-mouse-more-2 - mouse ill labeled).tiff",
        "credit": "(Illustration: CXC/M. Weiss)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Illustration_of_the_Mouse_System_(2004-mouse-more-2_-_mouse_ill_labeled).tiff"
      },
      "shots": [
        {
          "start": 22.233,
          "end": 24.733,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 24.733,
          "end": 28.9,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 28.912,
      "end": 36.232,
      "text": "The pulsar blasts this partner with radiation, stripping away its surface material until the star becomes nothing.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "B1957 comp.tif",
        "credit": "X-ray: NASA/CXC/ASTRON/B.Stappers et al.; Optical: AAO/J.Bland-Hawthorn & H.Jones",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:B1957_comp.tif"
      },
      "shots": [
        {
          "start": 28.9,
          "end": 32.133,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 32.133,
          "end": 36.233,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 36.232,
      "end": 43.257,
      "text": "Fermi data confirms this 1.8 solar mass beast grew by consuming its partner's material.",
