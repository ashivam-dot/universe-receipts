    {
      "start": 4.577,
      "end": 13.897,
      "text": "In 1988, astronomers discovered PSR B1957+20, a rapidly spinning neutron star in our galaxy.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Pti aerial photo B.jpg",
        "credit": "Gerard T. van Belle",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Pti_aerial_photo_B.jpg"
      },
      "shots": [
        {
          "start": 4.567,
          "end": 13.9,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.897,
      "end": 22.217,
      "text": "It rotates once every 1.6 milliseconds, while its small companion completes a tight orbit every 9.2 hours.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Main dwarf collage lg landscape.png",
        "credit": "Dana Berry",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Main_dwarf_collage_lg_landscape.png"
      },
      "shots": [
        {
          "start": 13.9,
          "end": 22.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.217,
      "end": 28.912,
      "text": "As the pulsar races through space at one million kilometers per hour, it generates a bright bow shock.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Illustration of the Mouse System (2004-mouse-more-2 - mouse ill labeled).tiff",
        "credit": "(Illustration: CXC/M. Weiss)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Illustration_of_the_Mouse_System_(2004-mouse-more-2_-_mouse_ill_labeled).tiff"
      },
      "shots": [
        {
          "start": 22.233,
          "end": 24.733,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 24.733,
          "end": 28.9,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 28.912,
      "end": 36.232,
      "text": "The pulsar blasts this partner with radiation, stripping away its surface material until the star becomes nothing.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Celebrating Chandra (illustrations-montage-index-Celebrating Chandra - 300dpi).jpg",
        "credit": "NASA/SAO",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Celebrating_Chandra_(illustrations-montage-index-Celebrating_Chandra_-_300dpi).jpg"
      },
      "shots": [
        {
          "start": 28.9,
          "end": 32.133,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 32.133,
          "end": 36.233,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 36.232,
      "end": 44.257,
      "text": "Fermi data updated its mass to 1.8 solar masses, finally proving the star is a cold cosmic cannibal.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Fermi in rocket fairing, labelled.jpg",
        "credit": "NASA/Jim Grossmann",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Fermi_in_rocket_fairing,_labelled.jpg"
      },
      "shots": [
        {
