{
  "id": "ep263",
  "duration": 27.437,
  "beats": [
    {
      "start": 0.08,
      "end": 3.1,
      "text": "Black holes do not act like giant vacuum cleaners.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "A view of the M87 supermassive black hole in polarised light (eso2105a).jpg",
        "credit": "EHT Collaboration",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:A_view_of_the_M87_supermassive_black_hole_in_polarised_light_(eso2105a).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.1,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.1,
      "end": 6.22,
      "text": "At a distance, their gravity is identical to any normal star.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 3.1,
          "end": 6.233,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.22,
      "end": 9.74,
      "text": "Replacing our Sun with an equal-mass black hole wouldn't pull Earth in.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "City Lights of Asia and Middle East 2016.png",
        "credit": "NASA Earth Observatory",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:City_Lights_of_Asia_and_Middle_East_2016.png"
      },
      "shots": [
        {
          "start": 6.233,
          "end": 9.733,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.74,
      "end": 12.94,
      "text": "Stellar black holes form when massive stars collapse in supernovae.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist's illustration of Supernova 1987A (eso1401b).jpg",
        "credit": "ALMA (ESO/NAOJ/NRAO)/Alexandra Angelich (NRAO/AUI/NSF)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%27s_illustration_of_Supernova_1987A_(eso1401b).jpg"
      },
      "shots": [
        {
          "start": 9.733,
          "end": 12.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.94,
      "end": 16.66,
      "text": "They all spin, with one rotating over 1,000 times per second.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Illustrations- The Cause of the \"Heartbeat\" Variation (2011-g1915-more-3 - C).tiff",
        "credit": "(Credit: NASA/CXC/M.Weiss)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Illustrations-_The_Cause_of_the_%22Heartbeat%22_Variation_(2011-g1915-more-3_-_C).tiff"
      },
      "shots": [
        {
          "start": 12.933,
          "end": 16.667,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.66,
      "end": 19.72,
      "text": "At our Milky Way center sits Sagittarius A*.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "EHT Sagittarius A black hole.tif",
        "credit": "EHT Collaboration",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:EHT_Sagittarius_A_black_hole.tif"
      },
      "shots": [
        {
          "start": 16.667,
          "end": 19.733,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.72,
      "end": 23.8,
      "text": "Astronomers proved it holds four million solar masses by tracking orbiting stars.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The daily motion of the S2 star as seen with GRAVITY (eso1825e).jpg",
        "credit": "Unknown author",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:The_daily_motion_of_the_S2_star_as_seen_with_GRAVITY_(eso1825e).jpg"
      },
      "shots": [
        {
          "start": 19.733,
          "end": 21.767,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 21.767,
          "end": 23.8,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.8,
      "end": 27.087,
      "text": "Yet even that galactic giant won't suck space in.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "A view of the M87 supermassive black hole in polarised light (eso2105a).jpg",
        "credit": "EHT Collaboration",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:A_view_of_the_M87_supermassive_black_hole_in_polarised_light_(eso2105a).jpg"
      },
      "shots": [
        {
          "start": 23.8,
          "end": 27.433,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    }
  ],
