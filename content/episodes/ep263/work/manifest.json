{
  "id": "ep263",
  "duration": 24.834,
  "beats": [
    {
      "start": 0.08,
      "end": 2.86,
      "text": "Black holes are not actually cosmic vacuum cleaners.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Flaring Disk Around Milky Way's Black Hole (Artist's Concept) (2025-110).tiff",
        "credit": "Illustration NASA, ESA, CSA, Ralf Crawford (STScI)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Flaring_Disk_Around_Milky_Way%27s_Black_Hole_(Artist%27s_Concept)_(2025-110).tiff"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.867,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 2.86,
      "end": 5.72,
      "text": "Swapping the Sun for a black hole wouldn't swallow Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The Sun by the Atmospheric Imaging Assembly of NASA's Solar Dynamics Observatory - 20100819.jpg",
        "credit": "NASA/SDO (AIA)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:The_Sun_by_the_Atmospheric_Imaging_Assembly_of_NASA%27s_Solar_Dynamics_Observatory_-_20100819.jpg"
      },
      "shots": [
        {
          "start": 2.867,
          "end": 5.733,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 5.72,
      "end": 8.92,
      "text": "Our planet would simply keep orbiting the dark, empty space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Heliocentric orbit.jpg",
        "credit": "Talifero",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Heliocentric_orbit.jpg"
      },
      "shots": [
        {
          "start": 5.733,
          "end": 8.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.92,
      "end": 11.94,
      "text": "Matter only falls in after crossing the event horizon.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Black hole with thick, hot accretion disk.png",
        "credit": "Shocksingularity",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Black_hole_with_thick,_hot_accretion_disk.png"
      },
      "shots": [
        {
          "start": 8.933,
          "end": 11.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.94,
      "end": 15.38,
      "text": "The Milky Way's central black hole weighs four million Suns.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "EHT Sagittarius A black hole.tif",
        "credit": "EHT Collaboration",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:EHT_Sagittarius_A_black_hole.tif"
      },
      "shots": [
        {
          "start": 11.933,
          "end": 15.367,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.38,
      "end": 18.32,
      "text": "Astronomers proved its mass by watching nearby stars orbit it.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Image of the binary star D9 close to Sagittarius A* (annotated) (eso2418b).jpg",
        "credit": "ESO/F. Pei\u00dfker et al.",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Image_of_the_binary_star_D9_close_to_Sagittarius_A*_(annotated)_(eso2418b).jpg"
      },
      "shots": [
        {
          "start": 15.367,
          "end": 18.333,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.32,
      "end": 22.3,
      "text": "One specific black hole spins one thousand times every second.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Illustrations- The Cause of the \"Heartbeat\" Variation (2011-g1915-more-3 - C).tiff",
        "credit": "(Credit: NASA/CXC/M.Weiss)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Illustrations-_The_Cause_of_the_%22Heartbeat%22_Variation_(2011-g1915-more-3_-_C).tiff"
      },
      "shots": [
        {
          "start": 18.333,
          "end": 22.3,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.3,
      "end": 24.484,
      "text": "Even that monster doesn't act like a giant vacuum.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Flaring Disk Around Milky Way's Black Hole (Artist's Concept) (2025-110).tiff",
        "credit": "Illustration NASA, ESA, CSA, Ralf Crawford (STScI)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Flaring_Disk_Around_Milky_Way%27s_Black_Hole_(Artist%27s_Concept)_(2025-110).tiff"
      },
      "shots": [
        {
          "start": 22.3,
          "end": 24.833,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
