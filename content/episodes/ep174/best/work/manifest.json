  "beats": [
    {
      "start": 0.08,
      "end": 4.073,
      "text": "The first photograph of Earth from space was taken by a weapon.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "First photo from space.jpg",
        "credit": "U.S. Army",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:First_photo_from_space.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.073,
      "end": 12.568,
      "text": "On October 24, 1946, researchers launched a captured German V-2 rocket from White Sands, New Mexico.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "A V-2 Rocket Launch (2277-51).jpg",
        "credit": "NOAA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:A_V-2_Rocket_Launch_(2277-51).jpg"
      },
      "shots": [
        {
          "start": 4.067,
          "end": 12.567,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.568,
      "end": 20.888,
      "text": "Clyde Holliday of the Johns Hopkins Applied Physics Laboratory secured a modified 35-millimeter movie camera inside.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "DeVry - 35mm Cine Camera - Kolkata 2012-09-29 1341.JPG",
        "credit": "Biswarup Ganguly",
        "license": "CC BY 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:DeVry_-_35mm_Cine_Camera_-_Kolkata_2012-09-29_1341.JPG"
      },
      "shots": [
        {
          "start": 12.567,
          "end": 17.733,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 17.733,
          "end": 20.9,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.888,
      "end": 28.208,
      "text": "V-2 number 13 soared roughly 65 miles high, crossing the 100-kilometer edge of space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "V2 in White Sands.jpg",
        "credit": "Unknown authorUnknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:V2_in_White_Sands.jpg"
      },
      "shots": [
        {
          "start": 20.9,
          "end": 23.5,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 23.5,
          "end": 28.2,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 28.208,
      "end": 35.078,
      "text": "That reached roughly five times the altitude of the previous record photo from a 1935 balloon.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Historic weather balloon \"Explorer II.\" Lake Andes NWR, South Dakota. - NARA - 283836.jpg",
        "credit": "Unknown authorUnknown author or not provided",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Historic_weather_balloon_%22Explorer_II.%22_Lake_Andes_NWR,_South_Dakota._-_NARA_-_283836.jpg"
      },
      "shots": [
        {
          "start": 28.2,
          "end": 32.9,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 32.9,
          "end": 35.067,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 35.078,
      "end": 40.403,
      "text": "The lens captured Earth's curved horizon set against the blackness of space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Small Steps Panorama.jpg",
        "credit": "Johns Hopkins Applied Physics Laboratory",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Small_Steps_Panorama.jpg"
      },
      "shots": [
        {
          "start": 35.067,
          "end": 40.4,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 40.403,
      "end": 46.523,
      "text": "Plunging back down, the rocket slammed into the desert at high speed, obliterating its airframe.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Small Steps Panorama.jpg",
        "credit": "Johns Hopkins Applied Physics Laboratory",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Small_Steps_Panorama.jpg"
      },
      "shots": [
        {
          "start": 40.4,
          "end": 46.533,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 46.523,
      "end": 52.598,
      "text": "Yet the exposed film negative survived intact inside a protective steel cassette.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 46.533,
          "end": 52.6,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 52.598,
      "end": 57.956,
      "text": "More than a decade before Sputnik, our first view of the planet came from a repurposed missile.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "First photo from space.jpg",
        "credit": "U.S. Army",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:First_photo_from_space.jpg"
      },
      "shots": [
        {
          "start": 52.6,
          "end": 58.3,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
