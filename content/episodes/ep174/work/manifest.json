  "duration": 56.008,
  "beats": [
    {
      "start": 0.08,
      "end": 4.076,
      "text": "The first photograph of Earth from space was taken by a weapon.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "First photo from space.jpg",
        "credit": "U.S. Army",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:First_photo_from_space.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.076,
      "end": 12.571,
      "text": "On October 24, 1946, researchers launched a captured German V-2 rocket from White Sands, New Mexico.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "A V-2 Rocket Launch (2277-51).jpg",
        "credit": "NOAA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:A_V-2_Rocket_Launch_(2277-51).jpg"
      },
      "shots": [
        {
          "start": 4.067,
          "end": 12.567,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.571,
      "end": 20.591,
      "text": "Clyde Holliday of the Johns Hopkins Applied Physics Laboratory secured a modified 35-millimeter camera inside.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "DeVry - 35mm Cine Camera - Kolkata 2012-09-29 1339.JPG",
        "credit": "Biswarup Ganguly",
        "license": "CC BY 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:DeVry_-_35mm_Cine_Camera_-_Kolkata_2012-09-29_1339.JPG"
      },
      "shots": [
        {
          "start": 12.567,
          "end": 17.733,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 17.733,
          "end": 20.6,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.591,
      "end": 27.911,
      "text": "V-2 number 13 soared roughly 65 miles high, crossing the 100-kilometer edge of space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "V2 in White Sands.jpg",
        "credit": "Unknown authorUnknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:V2_in_White_Sands.jpg"
      },
      "shots": [
        {
          "start": 20.6,
          "end": 23.2,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 23.2,
          "end": 27.9,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 27.911,
      "end": 32.781,
      "text": "That reached five times the altitude of a 1935 balloon record.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "\"Explorer II\" Gondola - DPLA - df0c0fb6e8bc914665132780e5727ce1 (page 6).jpg",
        "credit": "Unknown author",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:%22Explorer_II%22_Gondola_-_DPLA_-_df0c0fb6e8bc914665132780e5727ce1_(page_6).jpg"
      },
      "shots": [
        {
          "start": 27.9,
          "end": 32.767,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 32.781,
      "end": 38.106,
      "text": "The lens captured Earth's curved horizon set against the blackness of space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Small Steps Panorama.jpg",
        "credit": "Johns Hopkins Applied Physics Laboratory",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Small_Steps_Panorama.jpg"
      },
      "shots": [
        {
          "start": 32.767,
          "end": 38.1,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 38.106,
      "end": 44.226,
      "text": "Plunging back down, the rocket slammed into the desert at high speed, obliterating its airframe.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Small Steps Panorama.jpg",
        "credit": "Johns Hopkins Applied Physics Laboratory",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Small_Steps_Panorama.jpg"
      },
      "shots": [
        {
          "start": 38.1,
          "end": 44.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 44.226,
      "end": 50.301,
      "text": "Yet the exposed film negative survived intact inside a protective steel cassette.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 44.233,
          "end": 50.3,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 50.301,
      "end": 55.658,
      "text": "More than a decade before Sputnik, our first view of the planet came from a repurposed missile.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "First photo from space.jpg",
        "credit": "U.S. Army",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:First_photo_from_space.jpg"
      },
      "shots": [
        {
          "start": 50.3,
          "end": 56.0,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
