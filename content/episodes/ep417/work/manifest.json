{
  "id": "ep417",
  "duration": 29.117,
  "beats": [
    {
      "start": 0.08,
      "end": 3.02,
      "text": "Columbia's twenty-eighth mission revealed a deadly flaw.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Sts107 flight insignia.jpg",
        "credit": "Unknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Sts107_flight_insignia.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.033,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.02,
      "end": 5.0,
      "text": "It was the world's first shuttle to reach space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "S81-30459.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:S81-30459.jpg"
      },
      "shots": [
        {
          "start": 3.033,
          "end": 5.0,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 5.0,
      "end": 8.38,
      "text": "Just eighty-two seconds after liftoff, a foam piece struck.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 5.0,
          "end": 8.367,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.38,
      "end": 10.86,
      "text": "This impact punched a hole in the wing's armor.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Impact-test.jpg",
        "credit": "Rick Stiles",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Impact-test.jpg"
      },
      "shots": [
        {
          "start": 8.367,
          "end": 10.867,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.86,
      "end": 14.38,
      "text": "Superheated gases melted the wing's internal structure during reentry.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Space Shuttle re-entry art (ARC-1975-AC75-1919).jpg",
        "credit": "NASA Ames Research Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Space_Shuttle_re-entry_art_(ARC-1975-AC75-1919).jpg"
      },
      "shots": [
        {
          "start": 10.867,
          "end": 14.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.38,
      "end": 17.4,
      "text": "Columbia disintegrated at fifteen times the speed of sound.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "ColumbiaFLIR2003.png",
        "credit": "Unknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:ColumbiaFLIR2003.png"
      },
      "shots": [
        {
          "start": 14.367,
          "end": 17.4,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.4,
      "end": 19.52,
      "text": "All seven crew members were lost in the breakup.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Crew of STS-107, official photo.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Crew_of_STS-107,_official_photo.jpg"
      },
      "shots": [
        {
          "start": 17.4,
          "end": 19.533,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.52,
      "end": 23.02,
      "text": "Investigators found NASA could've launched a rescue using Atlantis.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Space Shuttle Atlantis on Launch Pad (28026561445).jpg",
        "credit": "NASA Hubble Space Telescope",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Space_Shuttle_Atlantis_on_Launch_Pad_(28026561445).jpg"
      },
      "shots": [
        {
          "start": 19.533,
          "end": 21.767,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 21.767,
          "end": 23.033,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.02,
      "end": 26.44,
      "text": "Amazingly, a canister of live roundworms survived the fall.",
      "asset": {
        "source": "iNaturalist",
        "title": "Caenorhabditis elegans (Caenorhabditis elegans)",
        "credit": "(c) Casey H. Richart, some rights reserved (CC BY)",
        "license": "CC BY 4.0",
        "url": "https://www.inaturalist.org/observations/18438333"
      },
      "shots": [
        {
          "start": 23.033,
          "end": 26.433,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 26.44,
      "end": 28.767,
      "text": "These survivors were the legacy of that twenty-eighth mission.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Sts107 flight insignia.jpg",
        "credit": "Unknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Sts107_flight_insignia.jpg"
      },
      "shots": [
        {
          "start": 26.433,
          "end": 29.133,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    }
  ],
