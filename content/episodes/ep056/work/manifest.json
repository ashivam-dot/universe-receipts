{
  "id": "ep056",
  "duration": 50.836,
  "beats": [
    {
      "start": 0.08,
      "end": 4.948,
      "text": "Undocking to escape a violent spin made Armstrong's capsule spin faster.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Gemini 8 docking.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Gemini_8_docking.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.467,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 2.467,
          "end": 4.933,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.948,
      "end": 11.193,
      "text": "Most people assume separating from a target vehicle instantly solves a docking emergency.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Profile of Agena Docking Target - GPN-2000-001345 (cropped).jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Profile_of_Agena_Docking_Target_-_GPN-2000-001345_(cropped).jpg"
      },
      "shots": [
        {
          "start": 4.933,
          "end": 11.2,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.193,
      "end": 18.963,
      "text": "On March 16, 1966, astronauts Neil Armstrong and David Scott launched on the Gemini 8 mission.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Gemini 8 launch.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Gemini_8_launch.jpg"
      },
      "shots": [
        {
          "start": 11.2,
          "end": 18.967,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.963,
      "end": 25.233,
      "text": "After completing the first United States space docking, a thruster short-circuited and stuck open.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Gemini1.png",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Gemini1.png"
      },
      "shots": [
        {
          "start": 18.967,
          "end": 25.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.233,
      "end": 32.103,
      "text": "The combined spacecraft entered an uncontrolled rotation reaching nearly one revolution per second.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Gemini spacecraft.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Gemini_spacecraft.jpg"
      },
      "shots": [
        {
          "start": 25.233,
          "end": 28.267,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 28.267,
          "end": 32.1,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 32.103,
      "end": 38.898,
      "text": "Threatened with blacking out, Armstrong shut down the orbital thrusters and fired the reentry control system.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "KSC-66C-1846 Gemini-8 Astronauts Neil A Armstrong, Command Pilot, and David R Scott, Pilot, during a Photo Session for the Press outside Mission Control Center, Cape Kennedy, FLA (104-KSC-66C-1846).jpg",
        "credit": "NASA Kennedy Space Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:KSC-66C-1846_Gemini-8_Astronauts_Neil_A_Armstrong,_Command_Pilot,_and_David_R_Scott,_Pilot,_during_a_Photo_Session_for_the_Press_outside_Mission_Control_Center,_Cape_Kennedy,_FLA_(104-KSC-66C-1846).jpg"
      },
      "shots": [
        {
          "start": 32.1,
          "end": 38.9,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 38.898,
      "end": 45.748,
      "text": "That emergency maneuver used seventy-five percent of their emergency fuel to stabilize the ship.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 38.9,
          "end": 45.733,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
