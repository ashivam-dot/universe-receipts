  "beats": [
    {
      "start": 0.08,
      "end": 4.948,
      "text": "Undocking to escape a violent spin made Armstrong's capsule spin faster.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Gemini 8 docking.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Gemini_8_docking.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.467,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 2.467,
          "end": 4.933,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.948,
      "end": 11.193,
      "text": "Most people assume separating from a target vehicle instantly solves a docking emergency.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Profile of Agena Docking Target - GPN-2000-001345 (cropped).jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Profile_of_Agena_Docking_Target_-_GPN-2000-001345_(cropped).jpg"
      },
      "shots": [
        {
          "start": 4.933,
          "end": 11.2,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.193,
      "end": 18.963,
      "text": "On March 16, 1966, astronauts Neil Armstrong and David Scott launched on the Gemini 8 mission.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Gemini 8 launch.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Gemini_8_launch.jpg"
      },
      "shots": [
        {
          "start": 11.2,
          "end": 18.967,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.963,
      "end": 25.233,
      "text": "After completing the first United States space docking, a thruster short-circuited and stuck open.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Rcs-gemini.jpg",
        "credit": "NASA/McDonnell",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Rcs-gemini.jpg"
      },
      "shots": [
        {
          "start": 18.967,
          "end": 25.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.233,
      "end": 31.428,
      "text": "Thinking the target caused the spin, they undocked, which made the lighter capsule spin even faster.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "S65-63221 - Gemini 6 Views Gemini 7 (Raw scan).tif",
        "credit": "NASA/JSC/Arizona State University",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:S65-63221_-_Gemini_6_Views_Gemini_7_(Raw_scan).tif"
      },
      "shots": [
        {
          "start": 25.233,
          "end": 28.867,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 28.867,
          "end": 31.433,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 31.428,
      "end": 38.448,
      "text": "The uncontrolled rotation accelerated, reaching nearly one revolution per second and threatening a blackout.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "KSC-66C-1846 Gemini-8 Astronauts Neil A Armstrong, Command Pilot, and David R Scott, Pilot, during a Photo Session for the Press outside Mission Control Center, Cape Kennedy, FLA (104-KSC-66C-1846).jpg",
        "credit": "NASA Kennedy Space Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:KSC-66C-1846_Gemini-8_Astronauts_Neil_A_Armstrong,_Command_Pilot,_and_David_R_Scott,_Pilot,_during_a_Photo_Session_for_the_Press_outside_Mission_Control_Center,_Cape_Kennedy,_FLA_(104-KSC-66C-1846).jpg"
      },
      "shots": [
        {
          "start": 31.433,
          "end": 38.433,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 38.448,
      "end": 45.298,
      "text": "Using seventy-five percent of their emergency fuel, Armstrong stabilized the ship for immediate abort.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "S66-26037 (25537748480).jpg",
        "credit": "National Museum of the U.S. Navy",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:S66-26037_(25537748480).jpg"
      },
      "shots": [
        {
          "start": 38.433,
          "end": 42.233,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 42.233,
          "end": 45.3,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 45.298,
      "end": 48.086,
      "text": "They only survived because they realized why.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Gemini 8 docking.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Gemini_8_docking.jpg"
      },
      "shots": [
        {
          "start": 45.3,
          "end": 48.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
