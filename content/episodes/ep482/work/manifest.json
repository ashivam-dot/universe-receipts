{
  "id": "ep482",
  "duration": 32.13,
  "beats": [
    {
      "start": 0.08,
      "end": 4.52,
      "text": "Our Sun and entire galaxy are being pulled across space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist\u2019s impression of the Milky Way.jpg",
        "credit": "NASA/JPL-Caltech/ESO/R. Hurt",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%E2%80%99s_impression_of_the_Milky_Way.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.633,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 2.633,
          "end": 4.533,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.52,
      "end": 7.84,
      "text": "Astronomers thought a local pull called the Great Attractor was responsible.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "View towards the Great Attractor (eso9954c).tiff",
        "credit": "ESO",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:View_towards_the_Great_Attractor_(eso9954c).tiff"
      },
      "shots": [
        {
          "start": 4.533,
          "end": 7.833,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.84,
      "end": 11.18,
      "text": "But that mysterious cosmic anchor's getting dragged along with us.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Detail of a view towards the Great Attractor (eso9954d).tiff",
        "credit": "European Southern Observatory (ESO)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Detail_of_a_view_towards_the_Great_Attractor_(eso9954d).tiff"
      },
      "shots": [
        {
          "start": 7.833,
          "end": 11.167,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.18,
      "end": 15.6,
      "text": "The real titan sits 650 million light-years away in Centaurus.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Eso2118d.jpg",
        "credit": "ESO, IAU and Sky & Telescope",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Eso2118d.jpg"
      },
      "shots": [
        {
          "start": 11.167,
          "end": 13.4,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 13.4,
          "end": 15.6,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.6,
      "end": 20.3,
      "text": "The Shapley Supercluster packs over 8,000 whole galaxies together.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "More Galaxies of the Shapley Supercluster (28330672719).png",
        "credit": "geckzilla",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:More_Galaxies_of_the_Shapley_Supercluster_(28330672719).png"
      },
      "shots": [
        {
          "start": 15.6,
          "end": 20.3,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.3,
      "end": 24.34,
      "text": "Its total mass exceeds ten million billion Suns combined.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hubble Space Telescope image of galaxy NGC 3558 in the lower left, and galaxy LEDA 83465 in the upper right.jpg",
        "credit": "ESA/Hubble & NASA, M. West",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Hubble_Space_Telescope_image_of_galaxy_NGC_3558_in_the_lower_left,_and_galaxy_LEDA_83465_in_the_upper_right.jpg"
      },
      "shots": [
        {
          "start": 20.3,
          "end": 22.067,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 22.067,
          "end": 24.333,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.34,
      "end": 27.54,
      "text": "It is the most massive structure within a billion light-years.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The effects of the Universe\u2019s large-scale structure on the light from distant galaxies (noirlab2327b).tiff",
        "credit": "Rubin Observatory/NSF/AURA/J. Pinto",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:The_effects_of_the_Universe%E2%80%99s_large-scale_structure_on_the_light_from_distant_galaxies_(noirlab2327b).tiff"
      },
      "shots": [
        {
          "start": 24.333,
          "end": 27.533,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 27.54,
      "end": 31.78,
      "text": "Because right now, this monster is reeling our world across the dark.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist\u2019s impression of the Milky Way.jpg",
        "credit": "NASA/JPL-Caltech/ESO/R. Hurt",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%E2%80%99s_impression_of_the_Milky_Way.jpg"
      },
      "shots": [
        {
          "start": 27.533,
          "end": 32.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
