{
  "id": "ep159",
  "duration": 51.781,
  "beats": [
    {
      "start": 0.08,
      "end": 3.6,
      "text": "Astronauts in orbit cannot see the Great Wall of China.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Asian Dust, NASA aerospace photography.jpg",
        "credit": "Image courtesy the SeaWiFS Project, NASA/Goddard Space Flight Center, and ORBIMAGE",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Asian_Dust,_NASA_aerospace_photography.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.6,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.6,
      "end": 8.995,
      "text": "From 400 kilometers up on the space station, city lights glow brightly at night.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "ISS-65 Europe, city lights from space.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:ISS-65_Europe,_city_lights_from_space.jpg"
      },
      "shots": [
        {
          "start": 3.6,
          "end": 6.633,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 6.633,
          "end": 9.0,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.995,
      "end": 15.915,
      "text": "By day, astronauts easily spot the Pyramids of Giza and the 2.3-kilometer Three Gorges Dam.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "ISS019-E-7724 - View of China.jpg",
        "credit": "Earth Science and Remote Sensing Unit, Lyndon B. Johnson Space Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:ISS019-E-7724_-_View_of_China.jpg"
      },
      "shots": [
        {
          "start": 9.0,
          "end": 11.867,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 11.867,
          "end": 15.9,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.915,
      "end": 21.435,
      "text": "But the Great Wall's widest sections measure only about 9 to 10 meters across.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Great Wall of China at Mutianyu in april 2010 (4562755409).jpg",
        "credit": "thierrytutin",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Great_Wall_of_China_at_Mutianyu_in_april_2010_(4562755409).jpg"
      },
      "shots": [
        {
          "start": 15.9,
          "end": 19.267,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 19.267,
          "end": 21.433,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.435,
      "end": 28.23,
      "text": "At that altitude, it is roughly ten times narrower than the human eye's one-arcminute resolving limit.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Ives visual acuity test object.jpg",
        "credit": "Herbert E. Ives",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Ives_visual_acuity_test_object.jpg"
      },
      "shots": [
        {
          "start": 21.433,
          "end": 24.0,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 24.0,
          "end": 28.233,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 28.23,
      "end": 33.275,
      "text": "Because it was built from local dirt and stone, it blends into the rugged mountains.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Jingshaling to Simatai 23 (4781558771).jpg",
        "credit": "Ronnie Macdonald from Chelmsford, United Kingdom",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Jingshaling_to_Simatai_23_(4781558771).jpg"
      },
      "shots": [
        {
          "start": 28.233,
          "end": 30.033,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 30.033,
          "end": 33.267,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 33.275,
      "end": 37.995,
      "text": "China's first astronaut, Yang Liwei, confirmed he could not spot it at all.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Shenzhou 5 in space Yang Liwei.png",
        "credit": "\u4e2d\u56fd\u65b0\u95fb\u793e",
        "license": "CC BY 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:Shenzhou_5_in_space_Yang_Liwei.png"
      },
      "shots": [
        {
          "start": 33.267,
          "end": 38.0,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 37.995,
      "end": 44.695,
      "text": "Astronaut Leroy [Chiao](/\u02a7\u02c8W/) photographed sections through a telephoto lens, but his naked eye saw nothing.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 38.0,
          "end": 44.7,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 44.695,
      "end": 51.431,
      "text": "A 1754 legend claimed it was visible from the Moon, but orbital reality proved far different.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Asian Dust, NASA aerospace photography.jpg",
        "credit": "Image courtesy the SeaWiFS Project, NASA/Goddard Space Flight Center, and ORBIMAGE",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Asian_Dust,_NASA_aerospace_photography.jpg"
      },
      "shots": [
        {
          "start": 44.7,
          "end": 51.767,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
