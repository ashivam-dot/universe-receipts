{
  "id": "ep378",
  "duration": 27.054,
  "beats": [
    {
      "start": 0.08,
      "end": 3.22,
      "text": "One day on Venus actually lasts longer than its year.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Global view uvi Venus (Akatsuki).jpg",
        "credit": "Meli thev",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Global_view_uvi_Venus_(Akatsuki).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.22,
      "end": 6.92,
      "text": "A single rotation on its axis takes 243 Earth days.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA23791-Venus-NewlyProcessedView-20200608 (cropped).jpg",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA23791-Venus-NewlyProcessedView-20200608_(cropped).jpg"
      },
      "shots": [
        {
          "start": 3.233,
          "end": 6.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.92,
      "end": 9.46,
      "text": "It holds the record for the solar system's slowest spin.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Maat Mons on Venus.jpg",
        "credit": "NASA - Jet Propulsion Laboratory",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Maat_Mons_on_Venus.jpg"
      },
      "shots": [
        {
          "start": 6.933,
          "end": 9.467,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.46,
      "end": 12.5,
      "text": "Most other planets finish a full rotation in just hours.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Solar System graphic by NASA.png",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Solar_System_graphic_by_NASA.png"
      },
      "shots": [
        {
          "start": 9.467,
          "end": 12.5,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.5,
      "end": 15.92,
      "text": "There's a catch: Venus actually spins in the opposite direction.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Venus globe - transparent background.png",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Venus_globe_-_transparent_background.png"
      },
      "shots": [
        {
          "start": 12.5,
          "end": 15.933,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.92,
      "end": 19.02,
      "text": "Because of this backward rotation, the Sun rises in the west.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "SDO's Ultra-high Definition View of 2012 Venus Transit -- Path Sequence.jpg",
        "credit": "NASA/SDO, AIA",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:SDO%27s_Ultra-high_Definition_View_of_2012_Venus_Transit_--_Path_Sequence.jpg"
      },
      "shots": [
        {
          "start": 15.933,
          "end": 19.033,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.02,
      "end": 23.14,
      "text": "Even weirder, the atmosphere super-rotates around the planet every four days.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Venus - May 6 2016.png",
        "credit": "Kevin M. Gill",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Venus_-_May_6_2016.png"
      },
      "shots": [
        {
          "start": 19.033,
          "end": 23.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.14,
      "end": 26.704,
      "text": "It's a bizarre world where a day lasts longer than its year.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Global view uvi Venus (Akatsuki).jpg",
        "credit": "Meli thev",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Global_view_uvi_Venus_(Akatsuki).jpg"
      },
      "shots": [
        {
          "start": 23.133,
          "end": 27.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
