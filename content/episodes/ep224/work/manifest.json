  "beats": [
    {
      "start": 0.08,
      "end": 3.688,
      "text": "Black holes usually kill stars, but this one births them.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Anatomy of a Black Hole.jpg",
        "credit": "European Southern Observatory - ESO",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Anatomy_of_a_Black_Hole.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 1.333,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 1.333,
          "end": 3.7,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.688,
      "end": 9.533,
      "text": "Discovered in 2010, the Phoenix Cluster lies in the southern constellation of Phoenix.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Amundsen\u2013Scott South Pole Station 07.jpg",
        "credit": "Christopher Michel",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Amundsen%E2%80%93Scott_South_Pole_Station_07.jpg"
      },
      "shots": [
        {
          "start": 3.7,
          "end": 6.1,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 6.1,
          "end": 9.533,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.533,
      "end": 14.153,
      "text": "The cluster creates new stars at a rate of more than seven hundred per year.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "SPT-CLJ2344\u20134243 (Phoenix Cluster) Chandra.jpg",
        "credit": "X-ray: NASA/CXC/MIT/M.McDonald et al; Optical: NASA/STScI",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:SPT-CLJ2344%E2%80%934243_(Phoenix_Cluster)_Chandra.jpg"
      },
      "shots": [
        {
          "start": 9.533,
          "end": 12.533,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 12.533,
          "end": 14.167,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.153,
      "end": 18.898,
      "text": "In comparison, the Milky Way forms roughly one or two stars per year.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Milky Way Anatomy (SVS14935).jpg",
        "credit": "NASA's Scientific Visualization Studio - eMITS/Scott Wiessinger, eMITS/Adriana Manrique Gutierrez, eMITS/Ashley Balzer",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Milky_Way_Anatomy_(SVS14935).jpg"
      },
      "shots": [
        {
          "start": 14.167,
          "end": 17.0,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 17.0,
          "end": 18.9,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.898,
      "end": 24.943,
      "text": "NASA's Chandra X-ray Observatory detected giant holes in the surrounding hot gas.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "1st Anniversary Montage (illustrations-montage-index-1st Anniversary Montage - text).tiff",
        "credit": "NASA/SAO",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:1st_Anniversary_Montage_(illustrations-montage-index-1st_Anniversary_Montage_-_text).tiff"
      },
      "shots": [
        {
          "start": 18.9,
          "end": 24.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.943,
      "end": 29.038,
      "text": "Hubble revealed filaments of cooler gas where new stars form.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The Hubble eXtreme Deep Field (eso1633c).tiff",
        "credit": "NASA, ESA, G. Illingworth, D. Magee, and P. Oesch (University of California, Santa Cruz), R. Bouwens (Leiden University), and the HUDF09 Team",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:The_Hubble_eXtreme_Deep_Field_(eso1633c).tiff"
      },
      "shots": [
        {
          "start": 24.933,
          "end": 29.033,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 29.038,
      "end": 34.283,
      "text": "Its ten billion solar mass black hole fails to act as a normal thermostat.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Phoenix Cluster center, artist's depiction.jpg",
        "credit": "Bill Saxton (NRAO/AUI/NSF)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Phoenix_Cluster_center,_artist%27s_depiction.jpg"
      },
      "shots": [
        {
          "start": 29.033,
          "end": 34.267,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 34.283,
      "end": 38.908,
      "text": "This growth spurt cannot last longer than a hundred million years.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Phoenix Cluster center, artist's depiction.jpg",
        "credit": "Bill Saxton (NRAO/AUI/NSF)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Phoenix_Cluster_center,_artist%27s_depiction.jpg"
      },
      "shots": [
        {
          "start": 34.267,
          "end": 38.9,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 38.908,
      "end": 43.115,
      "text": "That is why black holes usually kill stars, but this one births them.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Anatomy of a Black Hole.jpg",
        "credit": "European Southern Observatory - ESO",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Anatomy_of_a_Black_Hole.jpg"
      },
      "shots": [
        {
          "start": 38.9,
          "end": 43.467,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
