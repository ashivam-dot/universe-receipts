{
  "id": "ep233",
  "duration": 51.477,
  "beats": [
    {
      "start": 0.08,
      "end": 4.7,
      "text": "Millions of invisible black holes are silently prowling our galaxy.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Black Hole Desktop & Phone Wallpapers (SVS14146 - runaway black hole desktop).png",
        "credit": "NASA's Scientific Visualization Studio - KBR Wyle Services, LLC/Scott Wiessinger, University of Maryland College Park/Barb Mattson, University of Maryland College Park/Francis Reddy, University of Mar",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Black_Hole_Desktop_%26_Phone_Wallpapers_(SVS14146_-_runaway_black_hole_desktop).png"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.7,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.7,
      "end": 12.395,
      "text": "Astronomers recently detected the first confirmed rogue stellar-mass black hole wandering entirely alone through space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Galactic Bulge Pull-out (2020-56-4763).tif",
        "credit": "Milky Way photo: Akira Fujii; Inset photo: CTIO/NOIRLab/NSF/AURA/, W. Clarkson (UM-Dearborn), C. Johnson (STScI), and M. Rich (UCLA)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Galactic_Bulge_Pull-out_(2020-56-4763).tif"
      },
      "shots": [
        {
          "start": 4.7,
          "end": 7.733,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 7.733,
          "end": 12.4,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.395,
      "end": 18.365,
      "text": "Astronomers spotted it when its intense gravity magnified and bent a distant star's light.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Gravitational microlensing by black hole (Illustration) (opo0003f).jpg",
        "credit": "NASA/ESA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Gravitational_microlensing_by_black_hole_(Illustration)_(opo0003f).jpg"
      },
      "shots": [
        {
          "start": 12.4,
          "end": 18.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.365,
      "end": 23.935,
      "text": "Hubble tracked the shifting starlight over six years to pinpoint the invisible traveler.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hubble telescope 2009.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Hubble_telescope_2009.jpg"
      },
      "shots": [
        {
          "start": 18.367,
          "end": 20.5,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 20.5,
          "end": 23.933,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.935,
      "end": 31.73,
      "text": "Data from sixteen different ground-based telescopes helped confirm the phantom weighs 7.15 solar masses.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 23.933,
          "end": 31.733,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 31.73,
      "end": 38.305,
      "text": "This dark remnant is approximately 5,000 light-years away and emits zero detectable light.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Microlensing-black-hole MOA-2011-BLG-191.jpg",
        "credit": "Hubble",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Microlensing-black-hole_MOA-2011-BLG-191.jpg"
      },
      "shots": [
        {
          "start": 31.733,
          "end": 38.3,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 38.305,
      "end": 45.155,
      "text": "It was hurled through space at 51.1 kilometers per second by a massive supernova kick.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 38.3,
          "end": 45.167,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 45.155,
      "end": 51.127,
      "text": "The confirmed existence of this phantom suggests that a terrifying number of them remain unseen.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Black Hole Desktop & Phone Wallpapers (SVS14146 - runaway black hole desktop).png",
        "credit": "NASA's Scientific Visualization Studio - KBR Wyle Services, LLC/Scott Wiessinger, University of Maryland College Park/Barb Mattson, University of Maryland College Park/Francis Reddy, University of Mar",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Black_Hole_Desktop_%26_Phone_Wallpapers_(SVS14146_-_runaway_black_hole_desktop).png"
      },
      "shots": [
