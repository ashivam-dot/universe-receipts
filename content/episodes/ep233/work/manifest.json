          "end": 4.7,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.699,
      "end": 11.219,
      "text": "Astronomers detected the first confirmed rogue stellar-mass black hole wandering entirely alone.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Galactic Bulge Pull-out (2020-56-4763).tif",
        "credit": "Milky Way photo: Akira Fujii; Inset photo: CTIO/NOIRLab/NSF/AURA/, W. Clarkson (UM-Dearborn), C. Johnson (STScI), and M. Rich (UCLA)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Galactic_Bulge_Pull-out_(2020-56-4763).tif"
      },
      "shots": [
        {
          "start": 4.7,
          "end": 7.133,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 7.133,
          "end": 11.233,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.219,
      "end": 17.989,
      "text": "This dark remnant was found via gravitational microlensing in the direction of the Galactic bulge.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Gravitational microlensing by black hole (Illustration) (opo0003e).jpg",
        "credit": "NASA/ESA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Gravitational_microlensing_by_black_hole_(Illustration)_(opo0003e).jpg"
      },
      "shots": [
        {
          "start": 11.233,
          "end": 18.0,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.989,
      "end": 24.884,
      "text": "The Hubble Space Telescope measured the tiny astrometric deflection of background starlight over six years.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hubble telescope 2009.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Hubble_telescope_2009.jpg"
      },
      "shots": [
        {
          "start": 18.0,
          "end": 21.467,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 21.467,
          "end": 24.9,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.884,
      "end": 30.204,
      "text": "Data from sixteen different ground-based telescopes helped confirm the anomaly.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 24.9,
          "end": 30.2,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 30.204,
      "end": 37.354,
      "text": "The latest analysis determined the mass of the black hole lens to be 7.15 solar masses.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Gravitational Microlensing Resulting from Planetary-Mass Objects in a Globular Cluster (2001-20-1079).jpg",
        "credit": "Illustration Credit: Ann Feild (STScI)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Gravitational_Microlensing_Resulting_from_Planetary-Mass_Objects_in_a_Globular_Cluster_(2001-20-1079).jpg"
      },
      "shots": [
        {
          "start": 30.2,
          "end": 37.367,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 37.354,
      "end": 45.174,
      "text": "Hurled through space at 51.1 kilometers per second by a supernova kick, it emits zero detectable light.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "GRB 020813- Cosmic Forensics Confirms Gamma-ray Burst-Supernova Connection (2003-grb020813 - grb020813 comp sized).tiff",
        "credit": "Illustration: CXC/M.Weiss; Spectrum: NASA/CXC/N.Butler et al.",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:GRB_020813-_Cosmic_Forensics_Confirms_Gamma-ray_Burst-Supernova_Connection_(2003-grb020813_-_grb020813_comp_sized).tiff"
      },
      "shots": [
        {
          "start": 37.367,
