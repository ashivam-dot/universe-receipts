{
  "id": "ep434",
  "duration": 31.639,
  "beats": [
    {
      "start": 0.08,
      "end": 3.12,
      "text": "One planet in our solar system orbits completely sideways.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hubble Captures Full View of Uranus's Rings on Edge- Unannotated (2007-32-2178).jpg",
        "credit": "NASA, ESA, and M. Showalter (SETI Institute)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Hubble_Captures_Full_View_of_Uranus%27s_Rings_on_Edge-_Unannotated_(2007-32-2178).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.12,
      "end": 5.68,
      "text": "This ice giant sits on the edge of the solar system.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Uranus from Voyager 2.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Uranus_from_Voyager_2.jpg"
      },
      "shots": [
        {
          "start": 3.133,
          "end": 5.667,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 5.68,
      "end": 8.8,
      "text": "It takes 84 Earth years to orbit the Sun once.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 5.667,
          "end": 8.8,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.8,
      "end": 11.98,
      "text": "Most worlds spin like tops, but Uranus rolls like a ball.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Exploring Planet Uranus Resource Page (SVS20390 - Shot6 4kProRes 00001 print).jpg",
        "credit": "NASA's Scientific Visualization Studio - KBR Wyle Services, LLC/Walt Feimer, Advocates in Manpower Management, Inc./Jenny McElligott, KBR Wyle Services, LLC/Kim Dongjae, ADNET Systems, Inc./Aaron E. L",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Exploring_Planet_Uranus_Resource_Page_(SVS20390_-_Shot6_4kProRes_00001_print).jpg"
      },
      "shots": [
        {
          "start": 8.8,
          "end": 11.967,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.98,
      "end": 15.24,
      "text": "Its extreme tilt creates seasons that last for decades.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hubble takes a grand tour of the Solar System (51688936521).jpg",
        "credit": "European Space Agency",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Hubble_takes_a_grand_tour_of_the_Solar_System_(51688936521).jpg"
      },
      "shots": [
        {
          "start": 11.967,
          "end": 13.767,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 13.767,
          "end": 15.233,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.24,
      "end": 18.28,
      "text": "One pole gets 42 years of nonstop daylight.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Uranus aurorae (October 2022) (heic2503a).jpg",
        "credit": "ESA/Hubble, NASA, L. Lamy, L. Sromovsky",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Uranus_aurorae_(October_2022)_(heic2503a).jpg"
      },
      "shots": [
        {
          "start": 15.233,
          "end": 18.267,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.28,
      "end": 21.64,
      "text": "The other side freezes in 42 years of pitch darkness.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Uranus Final Image.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Uranus_Final_Image.jpg"
      },
      "shots": [
        {
          "start": 18.267,
          "end": 21.633,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.64,
      "end": 24.9,
      "text": "Voyager 2 visited in 1986 and found the coldest world.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyager spacecraft.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Voyager_spacecraft.jpg"
      },
      "shots": [
        {
          "start": 21.633,
          "end": 24.9,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.9,
      "end": 28.58,
      "text": "This unique orientation makes it the most lopsided world known.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA00032 Uranus in True and False Color.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA00032_Uranus_in_True_and_False_Color.jpg"
      },
      "shots": [
        {
          "start": 24.9,
          "end": 28.567,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 28.58,
      "end": 31.289,
      "text": "That frozen world still orbits completely sideways.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hubble Captures Full View of Uranus's Rings on Edge- Unannotated (2007-32-2178).jpg",
        "credit": "NASA, ESA, and M. Showalter (SETI Institute)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Hubble_Captures_Full_View_of_Uranus%27s_Rings_on_Edge-_Unannotated_(2007-32-2178).jpg"
      },
      "shots": [
        {
          "start": 28.567,
          "end": 31.633,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
