{
  "id": "ep226",
  "duration": 47.337,
  "beats": [
    {
      "start": 0.08,
      "end": 3.33,
      "text": "A dead star missed a single heartbeat in deep space.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.333,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.33,
      "end": 9.175,
      "text": "This is the Vela Pulsar, formed in a massive supernova about ten thousand years ago.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "SuperCOSMOS H-alpha Survey (SHS) Image of Vela Supernova Remnant (opo0316c).jpg",
        "credit": "Royal Observatory, Edinburgh",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:SuperCOSMOS_H-alpha_Survey_(SHS)_Image_of_Vela_Supernova_Remnant_(opo0316c).jpg"
      },
      "shots": [
        {
          "start": 3.333,
          "end": 9.167,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.175,
      "end": 14.82,
      "text": "Roughly 1,000 light-years away, it rotates 11 times every single second.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Neutron star cross section.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Neutron_star_cross_section.jpg"
      },
      "shots": [
        {
          "start": 9.167,
          "end": 14.833,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.82,
      "end": 20.715,
      "text": "In 2016, astronomers caught a terrifying anomaly live for the very first time.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mt Pleasant Radio Telescope - 52665715656 2023.jpg",
        "credit": "Paris Buttfield-Addison",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Mt_Pleasant_Radio_Telescope_-_52665715656_2023.jpg"
      },
      "shots": [
        {
          "start": 14.833,
          "end": 18.033,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 18.033,
          "end": 20.7,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.715,
      "end": 26.01,
      "text": "Right as the star glitched, it skipped a pulse entirely, going completely silent.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 20.7,
          "end": 26.0,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 26.01,
      "end": 31.26,
      "text": "This violent hiccup took five seconds to accelerate the star\u2019s rotation.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mt Pleasant Radio Telescope - 52665715656 2023.jpg",
        "credit": "Paris Buttfield-Addison",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Mt_Pleasant_Radio_Telescope_-_52665715656_2023.jpg"
      },
      "shots": [
        {
          "start": 26.0,
          "end": 31.267,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 31.26,
      "end": 37.005,
      "text": "The pulsar\u2019s faster liquid core suddenly gripped its outer crust, transferring energy.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "1Superfluid in nuetro star.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:1Superfluid_in_nuetro_star.jpg"
      },
      "shots": [
        {
          "start": 31.267,
          "end": 37.0,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 37.005,
      "end": 43.205,
      "text": "This engine emits radiation jets reaching 20 teraelectronvolts of extreme energy.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Vela Pulsar (14039782592).png",
        "credit": "geckzilla",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Vela_Pulsar_(14039782592).png"
      },
      "shots": [
        {
          "start": 37.0,
          "end": 39.933,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 39.933,
          "end": 43.2,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 43.205,
      "end": 46.987,
      "text": "This cosmic glitch is why a dead star just missed a heartbeat.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 43.2,
          "end": 47.333,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    }
  ],
