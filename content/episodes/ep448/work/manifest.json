          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 5.0,
      "end": 10.46,
      "text": "Earlier rovers survived landing by bouncing inside giant inflatable airbags.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NASA Mars Rover.jpg",
        "credit": "NASA/JPL/Cornell University, Maas Digital LLC",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:NASA_Mars_Rover.jpg"
      },
      "shots": [
        {
          "start": 5.0,
          "end": 7.333,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 7.333,
          "end": 10.467,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.46,
      "end": 14.6,
      "text": "But at nearly one ton, Curiosity was far too heavy.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "MSLRoverConfig2 vs MER.jpg",
        "credit": "Unknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:MSLRoverConfig2_vs_MER.jpg"
      },
      "shots": [
        {
          "start": 10.467,
          "end": 14.6,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.6,
      "end": 18.76,
      "text": "A heat shield and giant parachute slowed its supersonic fall.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "593509main pia14836-full Mars Science Laboratory Parachute, Artist's Concept.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:593509main_pia14836-full_Mars_Science_Laboratory_Parachute,_Artist%27s_Concept.jpg"
      },
      "shots": [
        {
          "start": 14.6,
          "end": 18.767,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.76,
      "end": 23.96,
      "text": "Then a rocket-powered sky crane ignited thrusters and hovered above Mars.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "593484main pia14839 full Curiosity's Sky Crane Maneuver, Artist's Concept.jpg",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:593484main_pia14839_full_Curiosity%27s_Sky_Crane_Maneuver,_Artist%27s_Concept.jpg"
      },
      "shots": [
        {
          "start": 18.767,
          "end": 20.667,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 20.667,
