  "beats": [
    {
      "start": 0.08,
      "end": 4.98,
      "text": "NASA lowered a car-sized rover onto Mars using hovering rockets.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Curiosity Touching Down, Artist's Concept.jpg",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Curiosity_Touching_Down,_Artist%27s_Concept.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 1.867,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 1.867,
          "end": 4.967,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.98,
      "end": 8.74,
      "text": "Earlier rovers survived landing by bouncing inside giant inflatable airbags.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA05229 label.jpg",
        "credit": "NASA/JPL/Malin Space Science Systems",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA05229_label.jpg"
      },
      "shots": [
        {
          "start": 4.967,
          "end": 6.533,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 6.533,
          "end": 8.733,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.74,
      "end": 12.62,
      "text": "But at nearly one ton, Curiosity was far too heavy.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "MSLRoverConfig2 vs MER.jpg",
        "credit": "Unknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:MSLRoverConfig2_vs_MER.jpg"
      },
      "shots": [
        {
          "start": 8.733,
          "end": 12.633,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.62,
      "end": 15.82,
      "text": "A heat shield and giant parachute slowed its supersonic fall.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "593509main pia14836-full Mars Science Laboratory Parachute, Artist's Concept.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:593509main_pia14836-full_Mars_Science_Laboratory_Parachute,_Artist%27s_Concept.jpg"
      },
      "shots": [
        {
          "start": 12.633,
          "end": 15.833,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.82,
      "end": 20.7,
      "text": "Then a rocket-powered sky crane ignited thrusters and hovered above Mars.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "593484main pia14839 full Curiosity's Sky Crane Maneuver, Artist's Concept.jpg",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:593484main_pia14839_full_Curiosity%27s_Sky_Crane_Maneuver,_Artist%27s_Concept.jpg"
      },
      "shots": [
        {
          "start": 15.833,
          "end": 17.7,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 17.7,
          "end": 20.7,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.7,
      "end": 24.16,
      "text": "Tether cables lowered the rover directly onto its six wheels.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "MSL Sol 1943 - MAHLI (25006096107).jpg",
        "credit": "Kevin M. Gill",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:MSL_Sol_1943_-_MAHLI_(25006096107).jpg"
      },
      "shots": [
        {
          "start": 20.7,
          "end": 24.167,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.16,
      "end": 27.84,
      "text": "Explosive cutters severed the lines, letting the crane fly away.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "20090428MSLEntry2.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:20090428MSLEntry2.jpg"
      },
      "shots": [
        {
          "start": 24.167,
          "end": 27.833,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 27.84,
      "end": 31.098,
      "text": "No simpler method could safely land a vehicle that heavy.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Curiosity Touching Down, Artist's Concept.jpg",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Curiosity_Touching_Down,_Artist%27s_Concept.jpg"
      },
      "shots": [
        {
          "start": 27.833,
          "end": 31.433,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    }
  ],
