          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.96,
      "end": 28.3,
      "text": "Tether cables lowered the rover directly onto its six wheels.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "MSL Sol 1943 - MAHLI (25006096107).jpg",
        "credit": "Kevin M. Gill",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:MSL_Sol_1943_-_MAHLI_(25006096107).jpg"
      },
      "shots": [
        {
          "start": 23.967,
