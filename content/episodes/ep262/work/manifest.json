  "beats": [
    {
      "start": 0.08,
      "end": 2.82,
      "text": "A nuclear drone will fly across a frozen moon.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Df-aerial.jpg",
        "credit": "NASA/JOHNS HOPKINS APPLIED PHYSICS LAB",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Df-aerial.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.833,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 2.82,
      "end": 6.28,
      "text": "We usually think of space explorers as slow, rolling robots.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA16239 High-Resolution Self-Portrait by Curiosity Rover Arm Camera.jpg",
        "credit": "NASA/JPL-Caltech/Malin Space Science Systems\nDerivative work including grading, distortion correction, minor local adjustments and rendering from tiff-file:\u00a0Julian Herzog",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA16239_High-Resolution_Self-Portrait_by_Curiosity_Rover_Arm_Camera.jpg"
      },
      "shots": [
        {
          "start": 2.833,
          "end": 5.067,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 5.067,
          "end": 6.267,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.28,
      "end": 9.4,
      "text": "Mars rovers take twelve years to crawl twenty miles.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "MSL Sol 3070 - MAHLI.jpg",
        "credit": "Kevin Gill",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:MSL_Sol_3070_-_MAHLI.jpg"
      },
      "shots": [
        {
          "start": 6.267,
          "end": 9.4,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.4,
      "end": 12.2,
      "text": "But the air on Titan is four times thicker than Earth\u2019s.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Orange and Blue Hazes Close-up.jpg",
        "credit": "Produced By: Cassini Imaging Team, Image Credit:  NASA/JPL-Caltech/Space Science Institute",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Orange_and_Blue_Hazes_Close-up.jpg"
      },
      "shots": [
        {
          "start": 9.4,
          "end": 12.2,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.2,
      "end": 16.06,
      "text": "With gravity one-seventh of Earth's, flight is forty times easier.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 12.2,
          "end": 16.067,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.06,
      "end": 18.54,
      "text": "NASA\u2019s Dragonfly will skip across the landscape.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Df-landing.jpg",
        "credit": "NASA/JOHNS HOPKINS APPLIED PHYSICS LAB",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Df-landing.jpg"
      },
      "shots": [
        {
          "start": 16.067,
          "end": 18.533,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.54,
      "end": 22.14,
      "text": "This car-sized octocopter is powered by decaying plutonium.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "EMMRTG-Exploded.png",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:EMMRTG-Exploded.png"
      },
      "shots": [
        {
          "start": 18.533,
          "end": 22.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.14,
      "end": 25.18,
      "text": "One flight covers more ground than Curiosity has in a decade.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 22.133,
          "end": 25.167,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.18,
      "end": 27.76,
      "text": "This machine is the ultimate alien aviator.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Df-flight.png",
        "credit": "NASA/JOHNS HOPKINS APPLIED PHYSICS LAB",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Df-flight.png"
      },
      "shots": [
        {
          "start": 25.167,
          "end": 27.767,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 27.76,
      "end": 30.254,
      "text": "Our next great explorer won\u2019t crawl; it\u2019ll fly.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Df-aerial.jpg",
        "credit": "NASA/JOHNS HOPKINS APPLIED PHYSICS LAB",
