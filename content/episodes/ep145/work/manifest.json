{
  "id": "ep145",
  "duration": 52.728,
  "beats": [
    {
      "start": 0.08,
      "end": 4.03,
      "text": "Out of a trillion photons, only one makes it through this cloud.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "All Quiet in the Nursery?.jpg",
        "credit": "ESO",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:All_Quiet_in_the_Nursery%3F.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 1.767,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 1.767,
          "end": 4.033,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.03,
      "end": 13.475,
      "text": "In 1919, American astronomer Edward Emerson Barnard first cataloged this mysterious, ink-black, gaping void in the night sky.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The story of the sun, moon, and stars (1898) (14778585372).jpg",
        "credit": "Internet Archive Book Images",
        "license": "No restrictions",
        "url": "https://commons.wikimedia.org/wiki/File:The_story_of_the_sun,_moon,_and_stars_(1898)_(14778585372).jpg"
      },
      "shots": [
        {
          "start": 4.033,
          "end": 7.7,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 7.7,
          "end": 13.467,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.475,
      "end": 20.47,
      "text": "Floating deep in the southern constellation Ophiuchus, this dense Bok globule spans fully half a light-year across.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Ophiuchus (Annotated) (ophiuchus-ann).jpg",
        "credit": "E. Slawik/NOIRLab/NSF/AURA/M. Zamani",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Ophiuchus_(Annotated)_(ophiuchus-ann).jpg"
      },
      "shots": [
        {
          "start": 13.467,
          "end": 17.233,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 17.233,
          "end": 20.467,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.47,
      "end": 28.715,
      "text": "It sits roughly 400 light-years away from Earth, and not a single foreground star pierces its absolute, ink-black darkness.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "A Hole in the Sky.jpg",
        "credit": "ESO",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:A_Hole_in_the_Sky.jpg"
      },
      "shots": [
        {
          "start": 20.467,
          "end": 24.6,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 24.6,
          "end": 28.7,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 28.715,
      "end": 37.76,
      "text": "Inside, temperatures plummet to approximately 10 Kelvin, colder than Pluto, causing gases to freeze solid onto floating dust grains.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Dark Energy Camera Captures Circinus West Molecular Cloud (noirlab2515a).jpg",
        "credit": "CTIO/NOIRLab/DOE/NSF/AURA Image Processing: T.A. Rector (University of Alaska Anchorage/NSF NOIRLab), D. de Martin & M. Kosari (NSF NOIRLab)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Dark_Energy_Camera_Captures_Circinus_West_Molecular_Cloud_(noirlab2515a).jpg"
      },
      "shots": [
        {
          "start": 28.7,
          "end": 35.0,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 35.0,
          "end": 37.767,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 37.76,
      "end": 46.81,
      "text": "Astronomers discovered this starless stellar nursery is currently vibrating like Jell-O, preparing to collapse and birth a brand new star.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The Becklin-Neugebauer object (eso0137g).jpg",
        "credit": "ESO",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:The_Becklin-Neugebauer_object_(eso0137g).jpg"
      },
      "shots": [
        {
          "start": 37.767,
          "end": 46.8,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 46.81,
      "end": 52.378,
      "text": "It creates a perfect hole in the sky, but this shadow is made of solid cold cosmic dust.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "All Quiet in the Nursery?.jpg",
        "credit": "ESO",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:All_Quiet_in_the_Nursery%3F.jpg"
      },
      "shots": [
        {
          "start": 46.8,
          "end": 52.733,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
