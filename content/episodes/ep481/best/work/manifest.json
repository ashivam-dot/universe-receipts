  "beats": [
    {
      "start": 0.08,
      "end": 3.88,
      "text": "A 1,100-mile cloud appears over a Martian volcano every morning.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mars - Cloudy Arsia Mons - ESA Mars Express (54559293995).jpg",
        "credit": "Andrea Luck",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Mars_-_Cloudy_Arsia_Mons_-_ESA_Mars_Express_(54559293995).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.467,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 2.467,
          "end": 3.867,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.88,
      "end": 8.38,
      "text": "It races westward at 380 miles per hour, then vanishes before noon.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mars - February 13 2014 (32620724830).jpg",
        "credit": "Kevin Gill from Los Angeles, CA, United States",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Mars_-_February_13_2014_(32620724830).jpg"
      },
      "shots": [
        {
          "start": 3.867,
          "end": 8.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.38,
      "end": 12.3,
      "text": "The cloud grows high above Arsia Mons, a volcano 12 miles tall.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "MOLA arsia mons.jpg",
        "credit": "Martin Pauer (Power)",
        "license": "CC BY 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:MOLA_arsia_mons.jpg"
      },
      "shots": [
        {
          "start": 8.367,
          "end": 9.9,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 9.9,
          "end": 12.3,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.3,
      "end": 16.48,
      "text": "ESA tracked this daily lifecycle using an ordinary webcam on Mars Express.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mars Express over Tharsis volcanoes.jpg",
        "credit": "NASA/JPL/ESA, Corby Waste",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Mars_Express_over_Tharsis_volcanoes.jpg"
      },
      "shots": [
        {
          "start": 12.3,
          "end": 16.467,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.48,
      "end": 19.42,
      "text": "Earth clouds need dust or pollen particles to freeze around.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Representation of the direct and first indirect effect of aerosols on the albedo of clouds.png",
        "credit": "Goosse H., P.Y. Barriat, W. Lefebvre, M.F. Loutre and V. Zunz, (2008-2010). Introduction to climate dynamics and climate modeling. Online textbook available at http://www.climate.be/textbook.",
        "license": "CC BY 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:Representation_of_the_direct_and_first_indirect_effect_of_aerosols_on_the_albedo_of_clouds.png"
      },
      "shots": [
        {
          "start": 16.467,
          "end": 19.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.42,
      "end": 24.6,
      "text": "But Arsia Mons forces air upward, dropping temperatures 54 degrees in ten minutes.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 19.433,
          "end": 24.6,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.6,
      "end": 27.28,
      "text": "Water vapor freezes spontaneously straight out of clean air.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 24.6,
          "end": 27.267,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 27.28,
      "end": 31.128,
      "text": "This spontaneous freezing creates a massive spectacle every sunrise.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mars - Cloudy Arsia Mons - ESA Mars Express (54559293995).jpg",
