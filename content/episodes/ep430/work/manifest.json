          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.94,
      "end": 10.66,
      "text": "It appeared as a very large nebulosity.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 7.933,
          "end": 10.667,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.66,
      "end": 12.5,
      "text": "It did not look like a tiny point of light.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Star forming region, NGC 206 (noao-ngc206).jpg",
        "credit": "T.A. Rector and A. Strom (University of Alaska Anchorage) and WIYN",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Star_forming_region,_NGC_206_(noao-ngc206).jpg"
      },
      "shots": [
        {
          "start": 10.667,
          "end": 12.5,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.5,
      "end": 14.9,
      "text": "John Herschel mapped its massive scale later on.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Sir John Frederick William Herschel (1872) (14580147588).jpg",
        "credit": "Internet Archive Book Images",
        "license": "No restrictions",
        "url": "https://commons.wikimedia.org/wiki/File:Sir_John_Frederick_William_Herschel_(1872)_(14580147588).jpg"
      },
      "shots": [
        {
          "start": 12.5,
          "end": 14.9,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.9,
      "end": 18.58,
      "text": "This colossal nursery sits right inside our neighbor galaxy.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Potw1512a.tif",
