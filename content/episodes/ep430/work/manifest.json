    {
      "start": 4.08,
      "end": 7.94,
      "text": "Astronomer William Herschel first spotted this strange hazy patch through his telescope.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "William Herschel01 hires.jpg",
        "credit": "Lemuel Francis Abbott",
