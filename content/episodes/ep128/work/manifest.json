  "beats": [
    {
      "start": 0.08,
      "end": 3.953,
      "text": "One star is sprinting across our night sky faster than any other.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Widefield image of the sky around Barnard\u2019s Star showing its motion (eso1837d).tiff",
        "credit": "ESO/Digitized Sky Survey 2 Acknowledgement: Davide De Martin E \u2014 Red Dots",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Widefield_image_of_the_sky_around_Barnard%E2%80%99s_Star_showing_its_motion_(eso1837d).tiff"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.967,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.953,
      "end": 10.123,
      "text": "Barnard's Star travels the apparent width of the full Moon roughly every 180 years.",
      "asset": {
        "source": "Art Institute of Chicago (CC0)",
        "title": "Star-Shaped Tile",
        "credit": "Iran\nKashan",
        "license": "CC0",
        "url": "https://www.artic.edu/artworks/106111"
      },
      "shots": [
        {
          "start": 3.967,
          "end": 6.667,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 6.667,
          "end": 10.133,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.123,
      "end": 16.393,
      "text": "Located roughly six light-years away, it is our closest neighbor after the Alpha Centauri system.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Orbital plot of Proxima Centauri.jpg",
        "credit": "P. Kervella (CNRS/U. of Chile/Observatoire de Paris/LESIA), ESO/Digitized Sky Survey 2, D. De Martin/M. Zamani",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Orbital_plot_of_Proxima_Centauri.jpg"
      },
      "shots": [
        {
          "start": 10.133,
          "end": 16.4,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.393,
      "end": 21.763,
      "text": "Yet despite its proximity, this red dwarf is too dim to see with the unaided eye.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "AU MIc M-dwarf artist's conception.jpg",
        "credit": "NASA's Goddard Space Flight Center. Chris Smith (USRA): Lead Producer",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:AU_MIc_M-dwarf_artist%27s_conception.jpg"
      },
      "shots": [
        {
          "start": 16.4,
          "end": 21.767,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.763,
      "end": 28.033,
      "text": "It is blueshifted and racing straight toward our Sun at roughly 110 kilometers per second.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist\u2019s impression of super-Earth orbiting Barnard\u2019s Star (eso1837b).tiff",
        "credit": "ESO/M. Kornmesser",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%E2%80%99s_impression_of_super-Earth_orbiting_Barnard%E2%80%99s_Star_(eso1837b).tiff"
      },
      "shots": [
        {
          "start": 21.767,
          "end": 25.5,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 25.5,
          "end": 28.033,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 28.033,
      "end": 35.578,
      "text": "For over half a century, astronomers announced giant planets around it, only to debunk them as telescope errors.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Swarthmore College Observatory.jpg",
        "credit": "Smallbones",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Swarthmore_College_Observatory.jpg"
      },
      "shots": [
        {
          "start": 28.033,
          "end": 32.967,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 32.967,
          "end": 35.567,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 35.578,
      "end": 43.503,
      "text": "Astronomers finally confirmed genuine exoplanets orbiting the star in 2024 and 2025.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist\u2019s impression of the planet Ross 128 b (eso1736a).tiff",
        "credit": "ESO/M. Kornmesser",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%E2%80%99s_impression_of_the_planet_Ross_128_b_(eso1736a).tiff"
      },
      "shots": [
        {
          "start": 35.567,
          "end": 39.533,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 39.533,
          "end": 43.5,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 43.503,
      "end": 48.443,
      "text": "Those worlds are locked into a cosmic journey that leaves every other star behind.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Widefield image of the sky around Barnard\u2019s Star showing its motion (eso1837d).tiff",
        "credit": "ESO/Digitized Sky Survey 2 Acknowledgement: Davide De Martin E \u2014 Red Dots",
