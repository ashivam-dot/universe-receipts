{
  "id": "ep501",
  "duration": 30.774,
  "beats": [
    {
      "start": 0.08,
      "end": 3.46,
      "text": "An icy moon near Uranus once erupted liquid water.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Ariel Closest Approach.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Ariel_Closest_Approach.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.467,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.46,
      "end": 6.42,
      "text": "Astronomer William Lassell discovered Ariel in 1851.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 3.467,
          "end": 6.433,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.42,
      "end": 10.3,
      "text": "Ariel has the youngest, most reflective surface of Uranus's major moons.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Uranus as Viewed from Earth - 1994, 1997, 2006 (opo0642c).tiff",
        "credit": "NASA, ESA, L. Sromovsky (University of Wisconsin, Madison), H. Hammel (Space Science Institute), and K. Rages (SETI)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Uranus_as_Viewed_from_Earth_-_1994,_1997,_2006_(opo0642c).tiff"
      },
      "shots": [
        {
          "start": 6.433,
          "end": 7.867,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 7.867,
          "end": 10.3,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.3,
      "end": 13.38,
      "text": "NASA's Voyager 2 flew past up close in 1986.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Uranus and Voyager (24660826102).png",
        "credit": "Kevin M. Gill",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Uranus_and_Voyager_(24660826102).png"
      },
      "shots": [
        {
          "start": 10.3,
          "end": 13.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.38,
      "end": 16.86,
      "text": "Photos revealed deep fault valleys slicing across smooth plains.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Ariel HiRes.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Ariel_HiRes.jpg"
      },
      "shots": [
        {
          "start": 13.367,
          "end": 16.867,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.86,
      "end": 20.64,
      "text": "Those smooth plains formed when molten ice erupted across its crust.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Enceladus - nIR+UV - August 13 2010 (54232767304).png",
        "credit": "Kevin M. Gill",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Enceladus_-_nIR%2BUV_-_August_13_2010_(54232767304).png"
      },
      "shots": [
        {
          "start": 16.867,
          "end": 20.633,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.64,
      "end": 23.76,
      "text": "Scientists even detected carbon dioxide frozen on the surface.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Enceladus - nIR+UV - August 13 2010 (54232767304).png",
        "credit": "Kevin M. Gill",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Enceladus_-_nIR%2BUV_-_August_13_2010_(54232767304).png"
      },
      "shots": [
        {
          "start": 20.633,
          "end": 23.767,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.76,
      "end": 27.1,
      "text": "Recent studies suggest a liquid ocean hides beneath its icy shell.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 23.767,
          "end": 27.1,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 27.1,
      "end": 30.424,
      "text": "That hidden warmth keeps Ariel active far longer than expected.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Ariel Closest Approach.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Ariel_Closest_Approach.jpg"
      },
      "shots": [
        {
          "start": 27.1,
          "end": 30.767,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
