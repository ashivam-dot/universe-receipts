{
  "id": "ep503",
  "duration": 29.187,
  "beats": [
    {
      "start": 0.08,
      "end": 3.34,
      "text": "An exposed astronaut will not freeze instantly in space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "STS-129 EVA3 Robert Satcher 3.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:STS-129_EVA3_Robert_Satcher_3.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 1.4,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 1.4,
          "end": 3.333,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.34,
      "end": 7.12,
      "text": "Movies show human bodies freezing solid or exploding in a vacuum.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 3.333,
          "end": 7.133,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.12,
      "end": 11.56,
      "text": "But space is a giant insulator, so heat leaves very slowly.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "ISS056-E-79067 - View of Earth.jpg",
        "credit": "Earth Science and Remote Sensing Unit, NASA Johnson Space Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:ISS056-E-79067_-_View_of_Earth.jpg"
      },
      "shots": [
        {
          "start": 7.133,
          "end": 10.033,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 10.033,
          "end": 11.567,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.56,
      "end": 14.64,
      "text": "Your elastic skin easily keeps your body from bursting.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Anatomy The Skin - NCI Visuals Online.jpg",
        "credit": "Don Bliss (artist)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Anatomy_The_Skin_-_NCI_Visuals_Online.jpg"
      },
      "shots": [
        {
          "start": 11.567,
          "end": 14.633,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.64,
      "end": 18.94,
      "text": "Instead, your lungs instantly reverse and pull oxygen from your blood.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "XBio illustration \u2013 Gas Exchange.png",
        "credit": "explorebiology",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:XBio_illustration_%E2%80%93_Gas_Exchange.png"
      },
      "shots": [
        {
          "start": 14.633,
          "end": 18.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.94,
      "end": 22.76,
      "text": "In a NASA vacuum test, engineer Jim LeBlanc lost suit pressure.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Thermal Vacuum Test Chamber A with Door Closed.jpg",
        "credit": "NASA Johnson Space Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Thermal_Vacuum_Test_Chamber_A_with_Door_Closed.jpg"
      },
      "shots": [
        {
          "start": 18.933,
          "end": 22.767,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.76,
      "end": 26.6,
      "text": "He felt the saliva on his tongue boil right before blacking out.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "APOLLO SPACESUIT - A-3H-024 - LUNAR EXCURSION MODULE (LEM) ASTRONAUT RESTRAINT HARNESS (S64-21568).jpg",
        "credit": "NASA Johnson Space Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:APOLLO_SPACESUIT_-_A-3H-024_-_LUNAR_EXCURSION_MODULE_(LEM)_ASTRONAUT_RESTRAINT_HARNESS_(S64-21568).jpg"
      },
      "shots": [
        {
          "start": 22.767,
          "end": 24.467,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 24.467,
          "end": 26.6,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 26.6,
      "end": 28.837,
      "text": "Cold never gets the chance to kill you first.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "STS-129 EVA3 Robert Satcher 3.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:STS-129_EVA3_Robert_Satcher_3.jpg"
      },
      "shots": [
        {
          "start": 26.6,
          "end": 29.2,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    }
  ],
