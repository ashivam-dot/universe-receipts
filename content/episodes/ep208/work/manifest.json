{
  "id": "ep208",
  "duration": 50.065,
  "beats": [
    {
      "start": 0.08,
      "end": 4.78,
      "text": "A five-kilometer mountain swept past Earth while tumbling out of control.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "4179 Toutatis HQ.png",
        "credit": "Yun Jiang, Jianghui Ji, Jiangchuan Huang, Simone Marchi, Yuan Li & Wing-Huen Ip",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:4179_Toutatis_HQ.png"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.767,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.78,
      "end": 11.3,
      "text": "On September 29, 2004, the asteroid Toutatis made a startlingly close approach.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Asteroid (4179) Toutatis passes the Earth (eso0430d).jpg",
        "credit": "ESO",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Asteroid_(4179)_Toutatis_passes_the_Earth_(eso0430d).jpg"
      },
      "shots": [
        {
          "start": 4.767,
          "end": 11.3,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.3,
      "end": 17.295,
      "text": "It swept within four lunar distances, or roughly 1.5 million kilometers of Earth.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 11.3,
          "end": 17.3,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.295,
      "end": 23.365,
      "text": "Measuring roughly five kilometers in length, it was the closest flyby of its size this century.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Goldstone Deep Space Network - Deep Space Station 14.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Goldstone_Deep_Space_Network_-_Deep_Space_Station_14.jpg"
      },
      "shots": [
        {
          "start": 17.3,
          "end": 23.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.365,
      "end": 30.46,
      "text": "Online chain emails predicted doom, but radar dishes at Goldstone and Arecibo mapped its true face.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Arecibo Observatory Aerial View.jpg",
        "credit": "H. Schweiker/WIYN and NOAO/AURA/NSF",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Arecibo_Observatory_Aerial_View.jpg"
      },
      "shots": [
        {
          "start": 23.367,
          "end": 30.467,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 30.46,
      "end": 36.855,
      "text": "Toutatis was a contact binary of two distinct lobes, shaped remarkably like a ginger root.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Asteroid 4179 Toutatis.jpg",
        "credit": "Yun Jiang, Jianghui Ji, Jiangchuan Huang, Simone Marchi, Yuan Li & Wing-Huen Ip",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Asteroid_4179_Toutatis.jpg"
      },
      "shots": [
        {
          "start": 30.467,
          "end": 32.767,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 32.767,
          "end": 36.867,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 36.855,
      "end": 44.505,
      "text": "Stranger still, it never spins cleanly, tumbling through space like a flubbed pass across two independent cycles.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Asteroid 4179 Toutatis.faces model.jpg",
        "credit": "Rendered by Eric DeJong and Shigeru Suzuki",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Asteroid_4179_Toutatis.faces_model.jpg"
      },
      "shots": [
        {
          "start": 36.867,
          "end": 44.5,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 44.505,
      "end": 49.715,
      "text": "Calculations prove Earth is safe for six centuries from this five-kilometer mountain.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "4179 Toutatis HQ.png",
        "credit": "Yun Jiang, Jianghui Ji, Jiangchuan Huang, Simone Marchi, Yuan Li & Wing-Huen Ip",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:4179_Toutatis_HQ.png"
      },
      "shots": [
        {
          "start": 44.5,
          "end": 50.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
