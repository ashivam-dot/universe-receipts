  "beats": [
    {
      "start": 0.08,
      "end": 4.934,
      "text": "No human-made object had ever crossed the asteroid belt or reached Jupiter.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Pioneer 10 Artwork Spacecraft shown during encounter above Jupiter's surface (used in NASA SP-349) (ARC-1972-AC72-1354).jpg",
        "credit": "NASA Ames Research Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Pioneer_10_Artwork_Spacecraft_shown_during_encounter_above_Jupiter%27s_surface_(used_in_NASA_SP-349)_(ARC-1972-AC72-1354).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.367,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 2.367,
          "end": 4.933,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.934,
      "end": 12.079,
      "text": "In 1972, NASA's Pioneer 10 became the first nuclear-powered probe to attempt the journey.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Atlas Centaur 27 with Pioneer 10 on launch pad.jpg",
        "credit": "NASA/Ames Research Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Atlas_Centaur_27_with_Pioneer_10_on_launch_pad.jpg"
      },
      "shots": [
        {
          "start": 4.933,
          "end": 8.633,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 8.633,
          "end": 12.067,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.079,
      "end": 19.674,
      "text": "It survived intense radiation that triggered false commands while passing within 82,000 miles of Jupiter.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Photograph take Pioneer 10 spacecraft managed by the NASA Ames Research Center, Moffett Field, California Jupiter's Red Spot and a showdow of the Moon, Io are seen in this image taken at a range of 2527063km (ARC-1973-AC73-9175).jpg",
        "credit": "NASA Ames Research Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Photograph_take_Pioneer_10_spacecraft_managed_by_the_NASA_Ames_Research_Center,_Moffett_Field,_California_Jupiter%27s_Red_Spot_and_a_showdow_of_the_Moon,_Io_are_seen_in_this_image_taken_at_a_range_of_2527063km_(ARC-1973-AC73-9175).jpg"
      },
      "shots": [
        {
          "start": 12.067,
          "end": 17.1,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 17.1,
          "end": 19.667,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.674,
      "end": 26.044,
      "text": "On its hull, a gold-anodized plaque showed two human figures and a map of 14 pulsars.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Pioneer F-G Plaque- Pioneer 10 the first spacecraft to leave our solar system carries a message to other worlds (ARC-1972-AC72-1338).jpg",
        "credit": "NASA Ames Research Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Pioneer_F-G_Plaque-_Pioneer_10_the_first_spacecraft_to_leave_our_solar_system_carries_a_message_to_other_worlds_(ARC-1972-AC72-1338).jpg"
      },
      "shots": [
        {
          "start": 19.667,
          "end": 22.567,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 22.567,
          "end": 26.033,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 26.044,
      "end": 32.814,
      "text": "After passing Neptune's orbit in 1983, it became the first craft to head for interstellar space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Pioneer 10 Trajectory.jpg",
        "credit": "NASA Ames Resarch Center (NASA-ARC)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Pioneer_10_Trajectory.jpg"
      },
      "shots": [
        {
          "start": 26.033,
          "end": 32.8,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 32.814,
      "end": 38.759,
      "text": "But navigators noticed a mysterious, tiny drag on its signal called the Pioneer Anomaly.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Goldstone DSN antenna.jpg",
        "credit": "Unknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Goldstone_DSN_antenna.jpg"
      },
      "shots": [
        {
          "start": 32.8,
          "end": 38.767,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 38.759,
      "end": 45.559,
      "text": "Later analysis revealed it wasn't new physics, but just heat escaping unevenly from the probe.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Insturment package, Satellite, Pioneer IV - DPLA - 9877062998b3d811d07de69be7a4b26f (page 3).jpg",
        "credit": "Space Technology Laboratories (STL)",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Insturment_package,_Satellite,_Pioneer_IV_-_DPLA_-_9877062998b3d811d07de69be7a4b26f_(page_3).jpg"
      },
      "shots": [
        {
          "start": 38.767,
          "end": 45.567,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 45.559,
      "end": 50.628,
      "text": "Now drifting toward Aldebaran, it opened the outer solar system before crossing where",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Pioneer 10 Artwork Spacecraft shown during encounter above Jupiter's surface (used in NASA SP-349) (ARC-1972-AC72-1354).jpg",
