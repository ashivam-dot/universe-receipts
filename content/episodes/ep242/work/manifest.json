  "beats": [
    {
      "start": 0.08,
      "end": 4.934,
      "text": "No human-made object had ever crossed the asteroid belt or reached Jupiter.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Pioneer 10 Artwork Spacecraft shown during encounter above Jupiter's surface (used in NASA SP-349) (ARC-1972-AC72-1354).jpg",
        "credit": "NASA Ames Research Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Pioneer_10_Artwork_Spacecraft_shown_during_encounter_above_Jupiter%27s_surface_(used_in_NASA_SP-349)_(ARC-1972-AC72-1354).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.367,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 2.367,
          "end": 4.933,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.934,
      "end": 12.929,
      "text": "In 1972, Pioneer 10 launched aboard an Atlas-Centaur rocket, powered entirely by nuclear generators.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Launch of Pioneer 10-2.jpg",
        "credit": "Launch_of_Pioneer_10.jpg: NASA Ames Resarch Center (NASA-ARC)\nderivative work: Nova13 (talk)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Launch_of_Pioneer_10-2.jpg"
      },
      "shots": [
        {
          "start": 4.933,
          "end": 8.367,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 8.367,
          "end": 12.933,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.929,
      "end": 20.474,
      "text": "It safely navigated the asteroid belt and flew within 82,000 miles of Jupiter in 1973.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Pioneer10 Image a51.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Pioneer10_Image_a51.jpg"
      },
      "shots": [
        {
          "start": 12.933,
          "end": 20.467,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.474,
      "end": 27.494,
      "text": "Intense Jovian radiation triggered false commands in the probe, yet it returned over 500 images.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Pioneer-10 encounter photos from T V (ARC-1973-AC73-9278).jpg",
        "credit": "NASA Ames Research Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Pioneer-10_encounter_photos_from_T_V_(ARC-1973-AC73-9278).jpg"
      },
      "shots": [
        {
          "start": 20.467,
          "end": 27.5,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 27.494,
      "end": 34.014,
      "text": "Its hull carried a gold plaque designed by Carl Sagan, depicting two humans and 14 pulsars.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Pioneer F-G Plaque- Pioneer 10 the first spacecraft to leave our solar system carries a message to other worlds (ARC-1972-AC72-1338).jpg",
        "credit": "NASA Ames Research Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Pioneer_F-G_Plaque-_Pioneer_10_the_first_spacecraft_to_leave_our_solar_system_carries_a_message_to_other_worlds_(ARC-1972-AC72-1338).jpg"
      },
      "shots": [
        {
          "start": 27.5,
          "end": 30.733,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 30.733,
          "end": 34.0,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 34.014,
      "end": 41.909,
      "text": "In 1983, it passed Neptune's orbit, but navigators soon noticed a tiny, unexplained drift in its signal.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "72413main ACD97-0036-3.jpg",
        "credit": "Nasa/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:72413main_ACD97-0036-3.jpg"
      },
      "shots": [
        {
          "start": 34.0,
          "end": 37.933,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 37.933,
          "end": 41.9,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 41.909,
      "end": 49.884,
      "text": "This famous Pioneer Anomaly was eventually solved: the recoil of uneven heat radiation was gently tugging it.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 41.9,
          "end": 49.9,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 49.884,
      "end": 57.401,
      "text": "Silent since 2003, the spacecraft drifts toward the star Aldebaran after proving what deep-space probes could survive.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Pioneer 10 Artwork Spacecraft shown during encounter above Jupiter's surface (used in NASA SP-349) (ARC-1972-AC72-1354).jpg",
        "credit": "NASA Ames Research Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Pioneer_10_Artwork_Spacecraft_shown_during_encounter_above_Jupiter%27s_surface_(used_in_NASA_SP-349)_(ARC-1972-AC72-1354).jpg"
      },
      "shots": [
        {
          "start": 49.9,
          "end": 57.767,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
