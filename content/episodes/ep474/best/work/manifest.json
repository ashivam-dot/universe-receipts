  "beats": [
    {
      "start": 0.08,
      "end": 4.04,
      "text": "Saturn's giant rings completely vanish every fifteen years.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Saturn ring-plane crossing (opo9525a).jpg",
        "credit": "Reta Beebe (New Mexico State University), D. Gilmore, L. Bergeron (STScI), NASA/ESA, Amanda S. Bosh (Lowell Observatory), Andrew S. Rivkin (Univ. of Arizona/LPL), the HST High Speed Photometer Instrum",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Saturn_ring-plane_crossing_(opo9525a).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.033,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.04,
      "end": 8.22,
      "text": "They span tens of thousands of miles, yet disappear from view.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Saturn eclipse crop.jpg",
        "credit": "Saturn_eclipse.jpg: NASA/JPL/Space Science Institute\nderivative work: The High Fin Sperm Whale",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Saturn_eclipse_crop.jpg"
      },
      "shots": [
        {
          "start": 4.033,
          "end": 8.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.22,
      "end": 12.2,
      "text": "Galileo Galilei first spotted mysterious bulges that looked like ears.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Galileo by leoni.jpg",
        "credit": "Ottavio Leoni",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Galileo_by_leoni.jpg"
      },
      "shots": [
        {
          "start": 8.233,
          "end": 12.2,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.2,
      "end": 15.36,
      "text": "When they disappeared, he admitted he was completely baffled.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Justus Sustermans - Portrait of Galileo Galilei, 1636.jpg",
        "credit": "Justus Sustermans",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Justus_Sustermans_-_Portrait_of_Galileo_Galilei,_1636.jpg"
      },
      "shots": [
        {
          "start": 12.2,
          "end": 15.367,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.36,
      "end": 19.06,
      "text": "Astronomer Christiaan Huygens finally solved the mystery in 1659.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Illustrations de Systema Saturnium, sive de causis mirandorum Saturni phaenomenon... - (Non identifi\u00e9) ; Christian Huygens, aut. de texte - btv1b2600196j (09 of 10).jpg",
        "credit": "Huygens, Christiaan (1629-1695). Auteur du texte",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Illustrations_de_Systema_Saturnium,_sive_de_causis_mirandorum_Saturni_phaenomenon..._-_(Non_identifi%C3%A9)_;_Christian_Huygens,_aut._de_texte_-_btv1b2600196j_(09_of_10).jpg"
      },
      "shots": [
        {
          "start": 15.367,
          "end": 19.067,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.06,
      "end": 22.68,
      "text": "He realized a flat, detached ring surrounded the planet.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Ringed Planet Comparisons (4089960304).jpg",
        "credit": "Lunar and Planetary Institute from Houston, TX, USA",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Ringed_Planet_Comparisons_(4089960304).jpg"
      },
      "shots": [
        {
          "start": 19.067,
          "end": 20.567,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 20.567,
          "end": 22.667,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.68,
      "end": 25.8,
      "text": "Spacecraft later measured the rings at just tens of meters thick.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA11668 The Tallest Peaks.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA11668_The_Tallest_Peaks.jpg"
      },
      "shots": [
        {
          "start": 22.667,
          "end": 25.8,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.8,
      "end": 29.642,
      "text": "This exact alignment creates the illusion that the disk disappears.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Saturn ring-plane crossing (opo9525a).jpg",
        "credit": "Reta Beebe (New Mexico State University), D. Gilmore, L. Bergeron (STScI), NASA/ESA, Amanda S. Bosh (Lowell Observatory), Andrew S. Rivkin (Univ. of Arizona/LPL), the HST High Speed Photometer Instrum",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Saturn_ring-plane_crossing_(opo9525a).jpg"
      },
      "shots": [
        {
          "start": 25.8,
          "end": 30.0,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
