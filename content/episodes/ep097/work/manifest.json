{
  "id": "ep097",
  "duration": 49.254,
  "beats": [
    {
      "start": 0.08,
      "end": 3.556,
      "text": "A giant black hole hurled a star out of our galaxy.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hypervelocity star trajectory.jpg",
        "credit": "CfA/Melissa Weiss",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Hypervelocity_star_trajectory.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.567,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.556,
      "end": 11.801,
      "text": "Astronomers tracked this stellar runaway, known as S5-HVS1, roughly 29,000 light-years away from Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Grus (Annotated) (grus-ann).jpg",
        "credit": "E. Slawik/NOIRLab/NSF/AURA/M. Zamani",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Grus_(Annotated)_(grus-ann).jpg"
      },
      "shots": [
        {
          "start": 3.567,
          "end": 8.967,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 8.967,
          "end": 11.8,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.801,
      "end": 18.246,
      "text": "Sergey [Koposov](/k\u02c8Op\u02c8\u028cs\u02c8\u0251f/) and a team of researchers used Gaia spacecraft data to trace its direct path.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The Gaia Spacecraft (eso1908d).tiff",
        "credit": "ESA/ATG medialab; background image: ESO/S. Brunier",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:The_Gaia_Spacecraft_(eso1908d).tiff"
      },
      "shots": [
        {
          "start": 11.8,
          "end": 14.967,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 14.967,
          "end": 18.233,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.246,
      "end": 25.991,
      "text": "The star travels at an extraordinary velocity of approximately 1,755 kilometers per second.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 18.233,
          "end": 26.0,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.991,
      "end": 31.311,
      "text": "This speed is more than triple what is required to break free from our home galaxy.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 26.0,
          "end": 31.3,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 31.311,
      "end": 36.331,
      "text": "It was kicked out of the galactic center approximately five million years ago.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Galactic Cntr full cropped.jpg",
        "credit": "2MASS/G. Kopan, R. Hurt",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Galactic_Cntr_full_cropped.jpg"
      },
      "shots": [
        {
          "start": 31.3,
          "end": 36.333,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 36.331,
      "end": 43.406,
      "text": "Our central black hole, Sagittarius A*, captured its partner star and violently slung this one away.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Gcle.jpg",
        "credit": "Original uploader was Serendipodous at en.wikipedia",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Gcle.jpg"
      },
      "shots": [
        {
          "start": 36.333,
          "end": 39.867,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 39.867,
          "end": 43.4,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 43.406,
      "end": 48.904,
      "text": "Now, this lonely outcast is fleeing the Milky Way at nearly four million miles per hour.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hypervelocity star trajectory.jpg",
        "credit": "CfA/Melissa Weiss",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Hypervelocity_star_trajectory.jpg"
      },
      "shots": [
        {
          "start": 43.4,
          "end": 49.267,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
