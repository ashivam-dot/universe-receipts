{
  "id": "ep178",
  "duration": 51.396,
  "beats": [
    {
      "start": 0.08,
      "end": 3.246,
      "text": "Only three people in history have died in space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "View of Soyuz spacecraft which was part of exhibit (S73-27666).jpg",
        "credit": "NASA Johnson Space Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:View_of_Soyuz_spacecraft_which_was_part_of_exhibit_(S73-27666).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.233,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.246,
      "end": 10.916,
      "text": "In June 1971, three Soviet cosmonauts docked with Salyut 1, the world's first crewed space station.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "1972 CPA 4112.jpg",
        "credit": "USSR Post",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:1972_CPA_4112.jpg"
      },
      "shots": [
        {
          "start": 3.233,
          "end": 10.9,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.916,
      "end": 17.986,
      "text": "After more than three weeks of orbital experiments, their Soyuz 11 spacecraft undocked to return to Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Soyuz MS-11 crew and backup crew at the Soyuz rocket monument behind the Cosmonaut Hotel.jpg",
        "credit": "NASA/Victor Zelentsov",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Soyuz_MS-11_crew_and_backup_crew_at_the_Soyuz_rocket_monument_behind_the_Cosmonaut_Hotel.jpg"
      },
      "shots": [
        {
          "start": 10.9,
          "end": 14.133,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 14.133,
          "end": 18.0,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.986,
      "end": 26.031,
      "text": "Roughly 80 to 100 miles above Earth, capsule separation accidentally jarred open an air equalization valve.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Diagram of Soyuz ASTP spacecraft (MSFC-0101493).jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Diagram_of_Soyuz_ASTP_spacecraft_(MSFC-0101493).jpg"
      },
      "shots": [
        {
          "start": 18.0,
          "end": 22.0,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 22.0,
          "end": 26.033,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 26.031,
      "end": 32.651,
      "text": "The cabin depressurized into space in less than one minute, with the crew wearing no pressurized spacesuits.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "STS086-350-028 - STS-086 - View of the interior of the Soyuz spacecraft - DPLA - 05bb6b4c0b693b09fab0f410336620b9.jpg",
        "credit": "National Aeronautics and Space Administration. Lyndon B. Johnson Space Center. 2/17/1973",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:STS086-350-028_-_STS-086_-_View_of_the_interior_of_the_Soyuz_spacecraft_-_DPLA_-_05bb6b4c0b693b09fab0f410336620b9.jpg"
      },
      "shots": [
        {
          "start": 26.033,
          "end": 28.5,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 28.5,
          "end": 32.667,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 32.651,
      "end": 39.646,
      "text": "Yet the automated ship guided itself home, surviving re-entry and touching down on parachutes in Kazakhstan.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Expedition 59 Soyuz MS-11 Landing (NHQ201906250017).jpg",
        "credit": "Bill Ingalls",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Expedition_59_Soyuz_MS-11_Landing_(NHQ201906250017).jpg"
      },
      "shots": [
        {
          "start": 32.667,
          "end": 36.133,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 36.133,
          "end": 39.633,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 39.646,
      "end": 47.146,
      "text": "Rescuers opened the hatch expecting triumphant record-breakers, but found all three cosmonauts dead in their seats.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Jsc2006e42731.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Jsc2006e42731.jpg"
      },
      "shots": [
        {
          "start": 39.633,
          "end": 42.333,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 42.333,
          "end": 47.133,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 47.146,
      "end": 51.046,
      "text": "A single open valve had sealed their tragic place in history.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "View of Soyuz spacecraft which was part of exhibit (S73-27666).jpg",
        "credit": "NASA Johnson Space Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:View_of_Soyuz_spacecraft_which_was_part_of_exhibit_(S73-27666).jpg"
      },
      "shots": [
        {
          "start": 47.133,
          "end": 51.4,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    }
  ],
