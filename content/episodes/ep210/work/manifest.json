{
  "id": "ep210",
  "duration": 49.845,
  "beats": [
    {
      "start": 0.08,
      "end": 4.103,
      "text": "A spacecraft grabbed so much asteroid it couldn't close its lid.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "OSIRIS-REx Artist\u2019s conception.png",
        "credit": "NASA/GSFC",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:OSIRIS-REx_Artist%E2%80%99s_conception.png"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.1,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.103,
      "end": 10.498,
      "text": "On October 20, 2020, NASA touched down on the carbon-rich near-Earth asteroid Bennu.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Bird-like boulder on Bennu (ann19053a).jpg",
        "credit": "NASA/Goddard/University of Arizona",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Bird-like_boulder_on_Bennu_(ann19053a).jpg"
      },
      "shots": [
        {
          "start": 4.1,
          "end": 7.3,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 7.3,
          "end": 10.5,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.498,
      "end": 16.618,
      "text": "The probe used a burst of nitrogen gas to blow surface dust directly into the sampler head.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "OSIRIS-REx Touch-And-Go Sample Acquisition Mechanism (Schematic).png",
        "credit": "National Aeronautics and Space Administration (NASA) / University of Arizona",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:OSIRIS-REx_Touch-And-Go_Sample_Acquisition_Mechanism_(Schematic).png"
      },
      "shots": [
        {
          "start": 10.5,
          "end": 16.633,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.618,
      "end": 21.268,
      "text": "Large rocks immediately jammed the mylar seal flap wide open.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 16.633,
          "end": 21.267,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.268,
      "end": 27.913,
      "text": "Onboard cameras watched in horror as precious flakes of the asteroid drifted into the vacuum of space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "OSIRIS-REx Touch-And-Go Sample Acquisition Mechanism (Schematic).png",
        "credit": "National Aeronautics and Space Administration (NASA) / University of Arizona",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:OSIRIS-REx_Touch-And-Go_Sample_Acquisition_Mechanism_(Schematic).png"
      },
      "shots": [
        {
          "start": 21.267,
          "end": 27.9,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 27.913,
      "end": 33.083,
      "text": "Fearing a total loss, mission control rushed to stow the container days early.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mission Control center of NASA.png",
        "credit": "SpaceX",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Mission_Control_center_of_NASA.png"
      },
      "shots": [
        {
          "start": 27.9,
          "end": 33.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 33.083,
      "end": 41.908,
      "text": "When the capsule finally landed in Utah in 2023, scientists recovered 121.6 grams of material.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "OSIRIS-REx Sample Return - Flickr - NASA Goddard Photo and Video.jpg",
        "credit": "NASA/Keegan Barber",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:OSIRIS-REx_Sample_Return_-_Flickr_-_NASA_Goddard_Photo_and_Video.jpg"
      },
      "shots": [
        {
          "start": 33.067,
          "end": 38.333,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 38.333,
          "end": 41.9,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 41.908,
      "end": 49.495,
      "text": "That accidental excess held the essential chemical building blocks of life, proving a spacecraft grabbed so much asteroid.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "OSIRIS-REx Artist\u2019s conception.png",
        "credit": "NASA/GSFC",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:OSIRIS-REx_Artist%E2%80%99s_conception.png"
      },
      "shots": [
        {
          "start": 41.9,
          "end": 49.833,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
