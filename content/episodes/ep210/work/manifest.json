  "beats": [
    {
      "start": 0.08,
      "end": 4.103,
      "text": "A spacecraft grabbed so much asteroid it couldn't close its lid.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "OSIRIS-REx Artist\u2019s conception.png",
        "credit": "NASA/GSFC",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:OSIRIS-REx_Artist%E2%80%99s_conception.png"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.1,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.103,
      "end": 12.048,
      "text": "In 2020, NASA cameras captured a terrifying sight: the mission\u2019s prehistoric sample was escaping into space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Significant Mission Milestones in OSIRIS-REx Journey to Bennu and Back (SVS14724 - OREX LANDING 5x3HYPERWALL 00031 print).jpg",
        "credit": "NASA's Scientific Visualization Studio - eMITS/Emme Watkins, ADNET Systems, Inc./Aaron E. Lepsch, NASA/GSFC/Rani Gran, eMITS/Jonathan North",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Significant_Mission_Milestones_in_OSIRIS-REx_Journey_to_Bennu_and_Back_(SVS14724_-_OREX_LANDING_5x3HYPERWALL_00031_print).jpg"
      },
      "shots": [
        {
          "start": 4.1,
          "end": 12.033,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.048,
      "end": 17.043,
      "text": "To understand the leak, we must look at the collection attempt on asteroid Bennu.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Bennu global mosaic reduced size.png",
        "credit": "NASA/Goddard/University of Arizona",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Bennu_global_mosaic_reduced_size.png"
      },
      "shots": [
        {
          "start": 12.033,
          "end": 17.033,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.043,
      "end": 22.838,
      "text": "OSIRIS-REx used a burst of nitrogen gas to stir up surface rocks for collection.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist's concept of the OSIRIS-REx sample collector.jpg",
        "credit": "NASA Goddard Space Flight Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%27s_concept_of_the_OSIRIS-REx_sample_collector.jpg"
      },
      "shots": [
        {
          "start": 17.033,
          "end": 22.833,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.838,
      "end": 28.308,
      "text": "But the collector worked too well, pulling in large pebbles that jammed the seal wide open.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "OSIRIS-REx TAGSAM head pre-stow.png",
        "credit": "NASA/Goddard/University of Arizona/Lockheed Martin",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:OSIRIS-REx_TAGSAM_head_pre-stow.png"
      },
      "shots": [
        {
          "start": 22.833,
          "end": 25.333,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 25.333,
          "end": 28.3,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 28.308,
      "end": 34.453,
      "text": "Fearing a total loss, engineers scrapped mass measurements and rushed to lock the sample away.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mission Control center of NASA.png",
        "credit": "SpaceX",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Mission_Control_center_of_NASA.png"
      },
      "shots": [
        {
          "start": 28.3,
          "end": 34.467,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 34.453,
      "end": 42.528,
      "text": "When the capsule landed in Utah in 2023, the team recovered 121.6 grams of material.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "OSIRIS-REx Sample Return - Flickr - NASA Goddard Photo and Video.jpg",
        "credit": "NASA/Keegan Barber",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:OSIRIS-REx_Sample_Return_-_Flickr_-_NASA_Goddard_Photo_and_Video.jpg"
      },
      "shots": [
        {
          "start": 34.467,
          "end": 38.967,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 38.967,
          "end": 42.533,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 42.528,
      "end": 49.57,
      "text": "This accidental bounty held the building blocks of life, which is why the spacecraft grabbed so much asteroid.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "OSIRIS-REx Artist\u2019s conception.png",
        "credit": "NASA/GSFC",
        "license": "Public domain",
