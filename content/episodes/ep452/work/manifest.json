  "beats": [
    {
      "start": 0.08,
      "end": 3.62,
      "text": "Uranus was the first new planet discovered since antiquity.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Uranus as seen by NASA's Voyager 2 (remastered) - JPEG converted.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Uranus_as_seen_by_NASA%27s_Voyager_2_(remastered)_-_JPEG_converted.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 1.567,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 1.567,
          "end": 3.633,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.62,
      "end": 7.46,
      "text": "Astronomer William Herschel spotted the faint world using a homemade telescope.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "William Herschel01.jpg",
        "credit": "Lemuel Francis Abbott",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:William_Herschel01.jpg"
      },
      "shots": [
        {
          "start": 3.633,
          "end": 5.533,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 5.533,
          "end": 7.467,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.46,
      "end": 11.36,
      "text": "To gain royal favor, Herschel officially named it after King George.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Allan Ramsay (1713-84) - George III (1738-1820) - RCIN 405307 - Royal Collection.jpg",
        "credit": "Allan Ramsay",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Allan_Ramsay_(1713-84)_-_George_III_(1738-1820)_-_RCIN_405307_-_Royal_Collection.jpg"
      },
      "shots": [
        {
          "start": 7.467,
          "end": 11.367,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.36,
      "end": 15.12,
      "text": "King George Third was thrilled and appointed Herschel as his royal astronomer.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Herschel 40 foot.jpg",
        "credit": "Unknown authorUnknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Herschel_40_foot.jpg"
      },
      "shots": [
        {
          "start": 11.367,
          "end": 15.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.12,
      "end": 19.02,
      "text": "The king even funded a giant telescope and paid Herschel's sister.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Sir William Herschel and Caroline Herschel. Wellcome V0002731 (cropped).jpg",
        "credit": "Unknown author",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Sir_William_Herschel_and_Caroline_Herschel._Wellcome_V0002731_(cropped).jpg"
      },
      "shots": [
        {
          "start": 15.133,
          "end": 19.033,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.02,
      "end": 22.62,
      "text": "Caroline Herschel became the first woman in England to earn a scientific salary.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "ETH-BIB-Herschel, Caroline (1750-1848)-Portrait-Portr 11026-092-SF.tif",
        "credit": "nicht anwendbar",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:ETH-BIB-Herschel,_Caroline_(1750-1848)-Portrait-Portr_11026-092-SF.tif"
      },
      "shots": [
        {
          "start": 19.033,
          "end": 20.367,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 20.367,
          "end": 22.633,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.62,
      "end": 27.06,
      "text": "But astronomers across the globe flatly rejected putting monarchs into space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Elements of astronomy- accompanied with numerous illustrations, a colored representation of the solar, stellar, and nebular spectra, and celestial charts of the northern and the southern hemisphere (14598186298).jpg",
        "credit": "Internet Archive Book Images",
        "license": "No restrictions",
        "url": "https://commons.wikimedia.org/wiki/File:Elements_of_astronomy-_accompanied_with_numerous_illustrations,_a_colored_representation_of_the_solar,_stellar,_and_nebular_spectra,_and_celestial_charts_of_the_northern_and_the_southern_hemisphere_(14598186298).jpg"
      },
      "shots": [
        {
          "start": 22.633,
          "end": 27.067,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 27.06,
      "end": 30.379,
      "text": "They chose the god Uranus over a living British king.",
      "asset": {
