{
  "id": "ep012",
  "duration": 45.071,
  "beats": [
    {
      "start": 0.08,
      "end": 2.939,
      "text": "You cannot see the Great Wall of China from the Moon.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NASA-Apollo8-Dec24-Earthrise.jpg",
        "credit": "NASA/Bill Anders",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:NASA-Apollo8-Dec24-Earthrise.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 2.939,
      "end": 10.484,
      "text": "For generations, people believed this architectural marvel was the only human-made structure visible across the void.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "William Stukeley. Line engraving by P. Audinet, 1817, after Wellcome V0005650.jpg",
        "credit": "Unknown author",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:William_Stukeley._Line_engraving_by_P._Audinet,_1817,_after_Wellcome_V0005650.jpg"
      },
      "shots": [
        {
          "start": 2.933,
          "end": 10.5,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.484,
      "end": 15.629,
      "text": "According to NASA and optics experts, that famous claim is a complete myth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NASA HQ Building 2.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:NASA_HQ_Building_2.jpg"
      },
      "shots": [
        {
          "start": 10.5,
          "end": 13.067,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 13.067,
          "end": 15.633,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.629,
      "end": 20.499,
      "text": "Astronauts actually struggle to spot the wall even from low Earth orbit.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "STS-134 International Space Station after undocking.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:STS-134_International_Space_Station_after_undocking.jpg"
      },
      "shots": [
        {
          "start": 15.633,
          "end": 17.567,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 17.567,
          "end": 20.5,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.499,
      "end": 27.219,
      "text": "The structure is roughly ten times too narrow for the human eye to resolve from 400 kilometers up.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Great Wall of China July 2006.JPG",
        "credit": "Velatrix",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Great_Wall_of_China_July_2006.JPG"
      },
      "shots": [
        {
          "start": 20.5,
          "end": 23.867,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 23.867,
          "end": 27.233,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 27.219,
      "end": 35.114,
      "text": "Builders used local stone and rammed earth, creating a natural camouflage effect that blends into the surrounding terrain.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Earth Observation (iss071e003218).jpg",
        "credit": "NASA Johnson Space Center / CRONUS",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Earth_Observation_(iss071e003218).jpg"
      },
      "shots": [
        {
          "start": 27.233,
          "end": 30.967,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 30.967,
          "end": 35.1,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 35.114,
      "end": 40.434,
      "text": "Even China's first astronaut, Yang Liwei, admitted he could not see it from space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Shenzhou 5 in space Yang Liwei.png",
        "credit": "\u4e2d\u56fd\u65b0\u95fb\u793e",
        "license": "CC BY 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:Shenzhou_5_in_space_Yang_Liwei.png"
      },
      "shots": [
        {
          "start": 35.1,
          "end": 40.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 40.434,
      "end": 44.721,
      "text": "Which confirms once and for all that the famous lunar legend is dead.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NASA-Apollo8-Dec24-Earthrise.jpg",
        "credit": "NASA/Bill Anders",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:NASA-Apollo8-Dec24-Earthrise.jpg"
      },
      "shots": [
        {
          "start": 40.433,
          "end": 45.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
