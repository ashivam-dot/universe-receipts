  "duration": 52.188,
  "beats": [
    {
      "start": 0.08,
      "end": 3.764,
      "text": "There is a planet where the atmosphere is made of iron gas.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist\u2019s impression of an ultra-hot Jupiter transiting its star (eso2213a).tiff",
        "credit": "ESO/M. Kornmesser",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%E2%80%99s_impression_of_an_ultra-hot_Jupiter_transiting_its_star_(eso2213a).tiff"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.433,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 2.433,
          "end": 3.767,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.764,
      "end": 10.884,
      "text": "640 light-years away in Pisces, gas giant WASP-76b orbits its star in 1.8 days.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Pisces (psc).tiff",
        "credit": "IAU and Sky & Telescope",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Pisces_(psc).tiff"
      },
      "shots": [
        {
          "start": 3.767,
          "end": 7.333,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 7.333,
          "end": 10.9,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.884,
      "end": 16.879,
      "text": "Blasted by intense radiation, the planet has inflated to twice Jupiter's diameter.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist impression of planet WASP-103b and its host star.png",
        "credit": "ESA",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist_impression_of_planet_WASP-103b_and_its_host_star.png"
      },
      "shots": [
        {
          "start": 10.9,
          "end": 14.733,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 14.733,
          "end": 16.867,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.879,
      "end": 22.574,
      "text": "One side is trapped in eternal daylight, soaring to 2,400 degrees Celsius.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 16.867,
          "end": 22.567,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.574,
      "end": 27.344,
      "text": "That furnace rips molecules apart and boils solid iron into a gas.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Planet with superstorm (artist's impression) 01.jpg",
        "credit": "ESO/L. Cal\u00e7ada",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Planet_with_superstorm_(artist%27s_impression)_01.jpg"
      },
      "shots": [
        {
          "start": 22.567,
          "end": 25.333,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 25.333,
          "end": 27.333,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 27.344,
      "end": 33.714,
      "text": "Ferocious winds sweep that vapor to the nightside, where it cools to 1,500 degrees.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist\u2019s impression of supersonic winds on WASP-127b (eso2502a).jpg",
        "credit": "ESO/L. Cal\u00e7ada",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%E2%80%99s_impression_of_supersonic_winds_on_WASP-127b_(eso2502a).jpg"
      },
      "shots": [
        {
          "start": 27.333,
          "end": 31.533,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 31.533,
          "end": 33.7,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 33.714,
      "end": 39.459,
      "text": "Astronomers using the Very Large Telescope tracked iron at dusk but nothing at dawn.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Sundown on the VLT (vlt atudorica014-cc).tiff",
        "credit": "A. Tudorica/ESO",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Sundown_on_the_VLT_(vlt_atudorica014-cc).tiff"
      },
      "shots": [
        {
          "start": 33.7,
          "end": 36.367,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 36.367,
          "end": 39.467,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 39.459,
      "end": 47.084,
      "text": "Researchers found that as the nightside cools, it condenses this vapor into torrential showers of liquid iron.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Forecasting Weather on Distant Worlds.jpg",
        "credit": "NASA/JPL-Caltech/R. Hurt (SSC)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Forecasting_Weather_on_Distant_Worlds.jpg"
      },
      "shots": [
        {
          "start": 39.467,
          "end": 42.667,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 42.667,
          "end": 47.1,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 47.084,
      "end": 51.838,
      "text": "After tracking these metallic winds, astronomers reached a surreal conclusion.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist\u2019s impression of an ultra-hot Jupiter transiting its star (eso2213a).tiff",
        "credit": "ESO/M. Kornmesser",
