  "duration": 51.987,
  "beats": [
    {
      "start": 0.08,
      "end": 3.764,
      "text": "There is a planet where the atmosphere is made of iron gas.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist\u2019s impression of an ultra-hot Jupiter transiting its star (eso2213a).tiff",
        "credit": "ESO/M. Kornmesser",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%E2%80%99s_impression_of_an_ultra-hot_Jupiter_transiting_its_star_(eso2213a).tiff"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.433,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 2.433,
          "end": 3.767,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.764,
      "end": 10.884,
      "text": "640 light-years away in Pisces, gas giant WASP-76b orbits its star in 1.8 days.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Pisces (psc).tiff",
        "credit": "IAU and Sky & Telescope",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Pisces_(psc).tiff"
      },
      "shots": [
        {
          "start": 3.767,
          "end": 7.333,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 7.333,
          "end": 10.9,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.884,
      "end": 16.904,
      "text": "Blasted by radiation, this world has inflated to nearly twice the diameter of Jupiter.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Another artist\u2019s impression of WASP-76b (eso2005b).jpg",
        "credit": "Frederik Peeters (https://frederikpeeters.tumblr.com/)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Another_artist%E2%80%99s_impression_of_WASP-76b_(eso2005b).jpg"
      },
      "shots": [
        {
          "start": 10.9,
          "end": 16.9,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.904,
      "end": 22.724,
      "text": "One side is trapped in eternal daylight, soaring past 2,400 degrees Celsius.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist\u2019s impression of the night side of WASP-76b.jpg",
        "credit": "ESO/M. Kornmesser",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%E2%80%99s_impression_of_the_night_side_of_WASP-76b.jpg"
      },
      "shots": [
        {
          "start": 16.9,
          "end": 20.267,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 20.267,
          "end": 22.733,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.724,
      "end": 27.944,
      "text": "This inferno is hot enough to rip molecules apart and vaporize solid iron.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist Impression of the exoplanet WASP-76b (noirlab2318a).tiff",
        "credit": "International Gemini Observatory/NOIRLab/NSF/AURA/J. da Silva/Spaceengine/M. Zamani",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist_Impression_of_the_exoplanet_WASP-76b_(noirlab2318a).tiff"
      },
      "shots": [
        {
          "start": 22.733,
          "end": 26.0,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 26.0,
          "end": 27.933,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 27.944,
      "end": 34.839,
      "text": "Ferocious winds sweep that metallic gas to the nightside, where it cools to 1,500 degrees.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 27.933,
          "end": 34.833,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 34.839,
      "end": 40.734,
      "text": "Researchers using the Very Large Telescope detected iron at dusk but nothing at dawn.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Sundown on the VLT (vlt atudorica014-cc).tiff",
        "credit": "A. Tudorica/ESO",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Sundown_on_the_VLT_(vlt_atudorica014-cc).tiff"
      },
      "shots": [
        {
          "start": 34.833,
          "end": 38.333,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 38.333,
          "end": 40.733,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 40.734,
      "end": 47.134,
      "text": "They concluded that as the gas cools, it condenses into torrential rains of liquid iron.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Sundown on the VLT (vlt atudorica014-cc).tiff",
        "credit": "A. Tudorica/ESO",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Sundown_on_the_VLT_(vlt_atudorica014-cc).tiff"
      },
      "shots": [
        {
          "start": 40.733,
          "end": 47.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 47.134,
      "end": 51.637,
      "text": "These metallic winds confirmed a cycle that never ends on this world:",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist\u2019s impression of an ultra-hot Jupiter transiting its star (eso2213a).tiff",
        "credit": "ESO/M. Kornmesser",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%E2%80%99s_impression_of_an_ultra-hot_Jupiter_transiting_its_star_(eso2213a).tiff"
      },
      "shots": [
        {
          "start": 47.133,
          "end": 52.0,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
