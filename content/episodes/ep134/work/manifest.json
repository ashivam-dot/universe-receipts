          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.248,
      "end": 12.543,
      "text": "On October nineteenth, 2017, the Pan-STARRS telescope in Hawaii discovered the object named \u02bbOumuamua.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 4.233,
          "end": 12.533,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.543,
      "end": 19.713,
      "text": "Astronomers found a reddish, highly elongated body with an estimated length of roughly 400 meters.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 12.533,
          "end": 19.7,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.713,
      "end": 27.833,
      "text": "Observations revealed a length-to-width ratio of approximately 10 to 1 as its brightness varied by a factor of 10.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Confirmed Interstellar Object Paths (noirlab2322c).jpg",
        "credit": "Rubin Observatory/NSF/AURA/J. Pinto",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Confirmed_Interstellar_Object_Paths_(noirlab2322c).jpg"
      },
      "shots": [
        {
          "start": 19.7,
          "end": 23.0,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 23.0,
          "end": 27.833,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 27.833,
      "end": 33.453,
      "text": "Even when closest to the Sun, it showed zero signs of a coma, dust cloud, or tail.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "C2020F3 (NEOWISE) from Estonia 2.jpg",
        "credit": "Taavi Niittee",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:C2020F3_(NEOWISE)_from_Estonia_2.jpg"
      },
      "shots": [
        {
          "start": 27.833,
          "end": 30.167,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 30.167,
          "end": 33.467,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 33.453,
      "end": 40.103,
      "text": "Harvard astrophysicist Avi Loeb proposed the tumbling object could be an artificial light sail.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Solar sail artist conception.jpg",
        "credit": "NASA/Marshall Space Flight Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Solar_sail_artist_conception.jpg"
      },
      "shots": [
        {
          "start": 33.467,
          "end": 40.1,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 40.103,
      "end": 48.453,
      "text": "While a 2023 theory points to invisible hydrogen gas venting from water ice, an interstellar visitor left without a tail.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Eso1737a-shorter.jpg",
        "credit": "Original ESO/M. Kornmesser  (+ background position from original change by Nagualdesign)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Eso1737a-shorter.jpg"
      },
      "shots": [
        {
          "start": 40.1,
          "end": 48.8,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
