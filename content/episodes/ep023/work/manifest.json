  "beats": [
    {
      "start": 0.08,
      "end": 4.92,
      "text": "An amateur telescope can spot a quasar 2.4 billion light-years away.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Skywatcher telescope 16 inch and the Milky Way galaxy in Brod, Dragash - Kosovo.jpg",
        "credit": "Astroclubkosova",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Skywatcher_telescope_16_inch_and_the_Milky_Way_galaxy_in_Brod,_Dragash_-_Kosovo.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.933,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.92,
      "end": 13.64,
      "text": "Cataloged in the Third Cambridge Catalog as 3C 273, this enigmatic object baffled astronomers for years.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Palomar Observatory 2.jpg",
        "credit": "User:Tylerfinvold",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Palomar_Observatory_2.jpg"
      },
      "shots": [
        {
          "start": 4.933,
          "end": 13.633,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.64,
      "end": 21.135,
      "text": "In 1963, astronomer Maarten Schmidt calculated its massive redshift and revealed its true distance.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Maarten Schmidt 1978 (cropped).png",
        "credit": "Unknown authorUnknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Maarten_Schmidt_1978_(cropped).png"
      },
      "shots": [
        {
          "start": 13.633,
          "end": 16.533,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 16.533,
          "end": 21.133,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.135,
      "end": 26.355,
      "text": "It was identified as the very first quasar ever discovered in the universe.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "QuasarStarburst.jpg",
        "credit": "Unknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:QuasarStarburst.jpg"
      },
      "shots": [
        {
          "start": 21.133,
          "end": 26.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 26.355,
      "end": 34.905,
      "text": "Powered by a supermassive black hole at the center of an elliptical galaxy in Virgo, it shoots out a 200,000-light-year jet.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 26.367,
          "end": 34.9,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 34.905,
      "end": 40.78,
      "text": "At visible wavelengths, it shines over 4 trillion times more luminous than the Sun.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 34.9,
          "end": 40.767,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 40.78,
      "end": 47.766,
      "text": "And that mind-boggling power is why an amateur telescope can spot a quasar 2.4 billion light-years away.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Skywatcher telescope 16 inch and the Milky Way galaxy in Brod, Dragash - Kosovo.jpg",
        "credit": "Astroclubkosova",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Skywatcher_telescope_16_inch_and_the_Milky_Way_galaxy_in_Brod,_Dragash_-_Kosovo.jpg"
      },
      "shots": [
        {
          "start": 40.767,
          "end": 48.1,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    }
  ],
