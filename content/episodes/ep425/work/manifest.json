          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.7,
      "end": 28.0,
      "text": "Astronomer Reinhard Genzel won the 2020 Nobel Prize for proving this anchor exists.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Roger Penrose Reinhard Genzel.jpg",
        "credit": "Left: From User:Gangulybiswarup\n\nRight: From User:HHgarching",
        "license": "CC BY 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:Roger_Penrose_Reinhard_Genzel.jpg"
      },
      "shots": [
        {
          "start": 23.7,
          "end": 25.667,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 25.667,
          "end": 28.0,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 28.0,
      "end": 31.459,
      "text": "It's the only thing keeping our galaxy's heart a magnetic monster.",
