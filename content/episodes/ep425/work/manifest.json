{
  "id": "ep425",
  "duration": 31.809,
  "beats": [
    {
      "start": 0.08,
      "end": 4.14,
      "text": "A magnetic monster at our galaxy's heart is whipping gas.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "EHT Sagittarius A black hole.tif",
        "credit": "EHT Collaboration",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:EHT_Sagittarius_A_black_hole.tif"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.133,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.14,
      "end": 8.5,
      "text": "Sagittarius A* is a black hole four million times heavier than the Sun.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist\u2019s impression of S2 passing supermassive black hole at centre of Milky Way - annotated.jpg",
        "credit": "ESO/M. Kornmesser",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%E2%80%99s_impression_of_S2_passing_supermassive_black_hole_at_centre_of_Milky_Way_-_annotated.jpg"
      },
      "shots": [
        {
          "start": 4.133,
          "end": 6.167,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 6.167,
          "end": 8.5,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.5,
      "end": 12.14,
      "text": "Astronomers found it by watching stars screaming around an invisible point.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Silent night over Paranal (potw1811a).tiff",
        "credit": "ESO/A. Tudoric\u0103",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Silent_night_over_Paranal_(potw1811a).tiff"
      },
      "shots": [
        {
          "start": 8.5,
          "end": 12.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.14,
      "end": 16.24,
      "text": "They finally snapped its photo in 2022 using telescopes across Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Making of the image of the black hole at the centre of the Milky Way (eso2208-eht-mwb).jpg",
        "credit": "EHT Collaboration",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Making_of_the_image_of_the_black_hole_at_the_centre_of_the_Milky_Way_(eso2208-eht-mwb).jpg"
      },
      "shots": [
        {
          "start": 12.133,
          "end": 16.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.24,
      "end": 19.94,
      "text": "That glowing ring hides magnetic fields that snap with violent force.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "M87* and Sgr A* side-by-side in polarised light (eso2406b).tiff",
        "credit": "EHT Collaboration",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:M87*_and_Sgr_A*_side-by-side_in_polarised_light_(eso2406b).tiff"
      },
      "shots": [
        {
          "start": 16.233,
          "end": 17.867,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 17.867,
          "end": 19.933,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.94,
      "end": 23.7,
      "text": "These explosions launch gas clumps at 30 percent the speed of light.",
      "asset": {
        "source": "Wikimedia Commons",
