{
  "id": "ep368",
  "duration": 26.974,
  "beats": [
    {
      "start": 0.08,
      "end": 3.66,
      "text": "Astronomers tracked a deep-space object heading straight for Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "C2025 A6 (Lemmon) (54941532370).jpg",
        "credit": "sam1965uk",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:C2025_A6_(Lemmon)_(54941532370).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.567,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 2.567,
          "end": 3.667,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.66,
      "end": 5.86,
      "text": "The body measured approximately three feet across.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Smallest Kuiper Belt Object.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Smallest_Kuiper_Belt_Object.jpg"
      },
      "shots": [
        {
          "start": 3.667,
          "end": 5.867,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 5.86,
      "end": 8.22,
      "text": "It swung past the Moon every 23 days.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 5.867,
          "end": 8.233,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.22,
      "end": 10.84,
      "text": "Density estimates showed it was lighter than solid rock.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 8.233,
          "end": 10.833,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.84,
      "end": 13.7,
      "text": "Scientists realized it was a hollow, discarded rocket tank.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Dynamic Test Stand Artist's Concept of Configuration One.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Dynamic_Test_Stand_Artist%27s_Concept_of_Configuration_One.jpg"
      },
      "shots": [
        {
          "start": 10.833,
          "end": 13.7,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.7,
      "end": 17.32,
      "text": "It struck the atmosphere at nearly 25,000 miles per hour.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Re-entry of Progress Spacecraft 42P - NASA Earth Observatory.jpg",
        "credit": "NASA's Earth Observatory",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Re-entry_of_Progress_Spacecraft_42P_-_NASA_Earth_Observatory.jpg"
      },
      "shots": [
        {
          "start": 13.7,
          "end": 17.333,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.32,
      "end": 19.28,
      "text": "Clouds in Sri Lanka blocked the daytime fireball.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Ella Valley in clouds, Sri Lanka.jpg",
        "credit": "Vyacheslav Argenberg",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Ella_Valley_in_clouds,_Sri_Lanka.jpg"
      },
      "shots": [
        {
          "start": 17.333,
          "end": 19.267,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.28,
      "end": 22.26,
      "text": "So researchers flew in a chartered jet to record the burn.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Gulfstream G-400.jpg",
        "credit": "Planephotoman",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Gulfstream_G-400.jpg"
      },
      "shots": [
        {
          "start": 19.267,
          "end": 20.6,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 20.6,
          "end": 22.267,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.26,
      "end": 26.624,
      "text": "They turned forgotten trash into a drill for an object heading straight for Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "C2025 A6 (Lemmon) (54941532370).jpg",
        "credit": "sam1965uk",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:C2025_A6_(Lemmon)_(54941532370).jpg"
      },
      "shots": [
        {
          "start": 22.267,
          "end": 26.967,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    }
  ],
