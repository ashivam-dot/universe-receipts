{
  "id": "ep368",
  "duration": 28.907,
  "beats": [
    {
      "start": 0.08,
      "end": 3.68,
      "text": "A mystery object from deep space was falling toward Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Lunar Prospector (4857947689).jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Lunar_Prospector_(4857947689).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.667,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.68,
      "end": 5.76,
      "text": "This body was only about three feet wide.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Smallest Kuiper Belt Object.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Smallest_Kuiper_Belt_Object.jpg"
      },
      "shots": [
        {
          "start": 3.667,
          "end": 5.767,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 5.76,
      "end": 8.72,
      "text": "It traveled in a wide orbit stretching past the Moon.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 5.767,
          "end": 8.733,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.72,
      "end": 12.08,
      "text": "But density tests showed it wasn't solid rock.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 8.733,
          "end": 12.067,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.08,
      "end": 15.08,
      "text": "It was a hollow, discarded tank from a lunar mission.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "LPnosunm.jpeg",
        "credit": "NASA Ames/Boris Rabin",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:LPnosunm.jpeg"
      },
      "shots": [
        {
          "start": 12.067,
          "end": 13.267,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 13.267,
          "end": 15.067,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.08,
      "end": 19.06,
      "text": "The junk hit the atmosphere at nearly 25,000 miles per hour.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Soyuz TMA-02M reentry.jpg",
        "credit": "NASA/Dan Burbank",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Soyuz_TMA-02M_reentry.jpg"
      },
      "shots": [
        {
          "start": 15.067,
          "end": 19.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.06,
      "end": 21.32,
      "text": "Clouds blocked the view of the fireball over the ocean.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Ella Valley in clouds, Sri Lanka.jpg",
        "credit": "Vyacheslav Argenberg",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Ella_Valley_in_clouds,_Sri_Lanka.jpg"
      },
      "shots": [
        {
          "start": 19.067,
          "end": 21.333,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.32,
      "end": 24.34,
      "text": "So researchers chartered a business jet to watch it burn.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Gulfstream G-400.jpg",
        "credit": "Planephotoman",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Gulfstream_G-400.jpg"
      },
      "shots": [
        {
          "start": 21.333,
          "end": 22.567,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 22.567,
          "end": 24.333,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.34,
      "end": 28.557,
      "text": "They practiced for real asteroids with this mystery object falling toward Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Lunar Prospector (4857947689).jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Lunar_Prospector_(4857947689).jpg"
      },
      "shots": [
        {
          "start": 24.333,
          "end": 28.9,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    }
  ],
