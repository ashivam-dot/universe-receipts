{
  "id": "ep500",
  "duration": 28.158,
  "beats": [
    {
      "start": 0.08,
      "end": 3.22,
      "text": "Every star in the universe will eventually go out forever.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NASA-HS201427a-HubbleUltraDeepField2014-20140603.jpg",
        "credit": "NASA, ESA, H. Teplitz and M. Rafelski (IPAC/Caltech), A. Koekemoer (STScI), R. Windhorst (Arizona State University), and Z. Levay (STScI)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:NASA-HS201427a-HubbleUltraDeepField2014-20140603.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.22,
      "end": 6.16,
      "text": "All interstellar gas will run dry in about 100 trillion years.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NASA-RedDwarfPlanet-ArtistConception-20130728.jpg",
        "credit": "David A. Aguilar, Harvard-Smithsonian Center for Astrophysics",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:NASA-RedDwarfPlanet-ArtistConception-20130728.jpg"
      },
      "shots": [
        {
          "start": 3.233,
          "end": 4.967,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 4.967,
          "end": 6.167,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.16,
      "end": 10.18,
      "text": "The last remaining red dwarfs will slowly fade into dark black dwarfs.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hubble image of the Ring Nebula (Messier 57).jpg",
        "credit": "NASA, ESA, and C. Robert O\u2019Dell (Vanderbilt University)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Hubble_image_of_the_Ring_Nebula_(Messier_57).jpg"
      },
      "shots": [
        {
          "start": 6.167,
          "end": 10.167,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.18,
      "end": 13.84,
      "text": "Gravitational encounters will then fling most dead stars into deep space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Antennae galaxies xl.jpg",
        "credit": "NASA, ESA, and the Hubble Heritage Team (STScI/AURA)-ESA/Hubble Collaboration",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Antennae_galaxies_xl.jpg"
      },
      "shots": [
        {
          "start": 10.167,
          "end": 13.833,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.84,
      "end": 16.96,
      "text": "Only supermassive black holes will remain in the empty void.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Black hole - Messier 87 crop max res.jpg",
        "credit": "Event Horizon Telescope, uploader cropped and converted TIF to JPG",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Black_hole_-_Messier_87_crop_max_res.jpg"
      },
      "shots": [
        {
          "start": 13.833,
          "end": 16.967,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.96,
      "end": 20.34,
      "text": "Yet even black holes lose mass through quantum Hawking radiation.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Black hole (NASA).jpg",
        "credit": "NASA/D. Berry",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Black_hole_(NASA).jpg"
      },
      "shots": [
        {
          "start": 16.967,
          "end": 20.333,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.34,
      "end": 23.8,
      "text": "The very last black holes will evaporate after one googol years.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 20.333,
          "end": 23.8,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.8,
      "end": 27.808,
      "text": "That leaves behind a frozen cosmos where no new light can ever ignite.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NASA-HS201427a-HubbleUltraDeepField2014-20140603.jpg",
        "credit": "NASA, ESA, H. Teplitz and M. Rafelski (IPAC/Caltech), A. Koekemoer (STScI), R. Windhorst (Arizona State University), and Z. Levay (STScI)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:NASA-HS201427a-HubbleUltraDeepField2014-20140603.jpg"
      },
      "shots": [
        {
          "start": 23.8,
          "end": 28.167,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
