  "beats": [
    {
      "start": 0.08,
      "end": 3.597,
      "text": "A blue asteroid is currently fizzing like sodium in water.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA22185.tif",
        "credit": "Arecibo Observatory/NASA/NSF",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA22185.tif"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.6,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.597,
      "end": 10.917,
      "text": "In 1983, astronomers linked asteroid 3200 Phaethon to the Geminid meteor shower.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Meteor showers, First Place (ann21047j).jpg",
        "credit": "Dai Jianfeng/IAU OAE",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Meteor_showers,_First_Place_(ann21047j).jpg"
      },
      "shots": [
        {
          "start": 3.6,
          "end": 7.267,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 7.267,
          "end": 10.933,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.917,
      "end": 16.037,
      "text": "Astronomers long believed this rock comet was a dead husk shedding dust.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist's Concept of Comet 238P-Read (2023-123).jpg",
        "credit": "ILLUSTRATION: NASA, ESA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%27s_Concept_of_Comet_238P-Read_(2023-123).jpg"
      },
      "shots": [
        {
          "start": 10.933,
          "end": 14.033,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 14.033,
          "end": 16.033,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.037,
      "end": 21.057,
      "text": "Its extreme orbit crosses the paths of Mercury, Venus, Earth, and Mars.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "\u041e\u0440\u0431\u0438\u0442\u0430 \u0430\u0441\u0442\u0435\u0440\u043e\u0438\u0434\u0430 3200.png",
        "credit": "Jet Propulsion Laboratory. California Institute of Technology",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:%D0%9E%D1%80%D0%B1%D0%B8%D1%82%D0%B0_%D0%B0%D1%81%D1%82%D0%B5%D1%80%D0%BE%D0%B8%D0%B4%D0%B0_3200.png"
      },
      "shots": [
        {
          "start": 16.033,
          "end": 21.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.057,
      "end": 26.877,
      "text": "It dives within 13 million miles of the Sun, hitting 1,400 degrees.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 21.067,
          "end": 26.867,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 26.877,
      "end": 31.672,
      "text": "But data from the SOHO spacecraft proved its tail contains no dust.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Phaeton-trail-copy.jpg",
        "credit": "NASA/Brendan Gallagher/Karl Battams/NRL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Phaeton-trail-copy.jpg"
      },
      "shots": [
        {
          "start": 26.867,
          "end": 31.667,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 31.672,
      "end": 37.047,
      "text": "The solid rock is actually outgassing sodium vapor like a boiling kettle.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 31.667,
          "end": 37.033,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 37.047,
      "end": 42.942,
      "text": "Sodium gas alone cannot explain the massive debris cloud Earth hits every December.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The Geminid Fireball (ann23043v).jpg",
        "credit": "Jianfeng Dai/IAU OAE (CC BY 4.0)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:The_Geminid_Fireball_(ann23043v).jpg"
      },
      "shots": [
        {
          "start": 37.033,
          "end": 40.067,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 40.067,
          "end": 42.933,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 42.942,
      "end": 47.272,
      "text": "This bizarre mystery is why scientists keep chasing this giant blue rock.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA22185.tif",
        "credit": "Arecibo Observatory/NASA/NSF",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA22185.tif"
      },
      "shots": [
        {
          "start": 42.933,
          "end": 47.633,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
