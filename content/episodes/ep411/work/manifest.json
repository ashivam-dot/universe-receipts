{
  "id": "ep411",
  "duration": 26.794,
  "beats": [
    {
      "start": 0.08,
      "end": 2.8,
      "text": "NASA pointed Voyager 1 right back at the Sun.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyager.jpg",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Voyager.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.8,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 2.8,
      "end": 6.8,
      "text": "Blinding sunlight risked destroying its cameras nearly four billion miles out.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyager Portrait Family diagram.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Voyager_Portrait_Family_diagram.jpg"
      },
      "shots": [
        {
          "start": 2.8,
          "end": 6.8,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.8,
      "end": 9.96,
      "text": "Astronomer Carl Sagan had spent years begging NASA to turn around.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Planetary society2.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Planetary_society2.jpg"
      },
      "shots": [
        {
          "start": 6.8,
          "end": 8.4,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 8.4,
          "end": 9.967,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.96,
      "end": 13.1,
      "text": "Voyager 1 was tilted about 32 degrees above the planets' plane.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Family portrait (Voyager 1).png",
        "credit": "NASA, Voyager 1",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Family_portrait_(Voyager_1).png"
      },
      "shots": [
        {
          "start": 9.967,
          "end": 13.1,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.1,
      "end": 16.6,
      "text": "Engineers snapped 60 frames using their darkest filter and fastest shutter.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "View of the Sun, Earth and Venus from Voyager 1.png",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:View_of_the_Sun,_Earth_and_Venus_from_Voyager_1.png"
      },
      "shots": [
        {
          "start": 13.1,
          "end": 15.033,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 15.033,
          "end": 16.6,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.6,
      "end": 20.02,
      "text": "Mercury and Mars were lost, but six distant planets appeared.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Solar System Group.jpg",
        "credit": "NASA / Voyager 1 probe",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Solar_System_Group.jpg"
      },
      "shots": [
        {
          "start": 16.6,
          "end": 20.033,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.02,
      "end": 24.2,
      "text": "Those final photographs became our first family portrait from the outside.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PaleBlueDot.jpg",
        "credit": "Unknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PaleBlueDot.jpg"
      },
      "shots": [
        {
          "start": 20.033,
          "end": 24.2,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.2,
      "end": 26.444,
      "text": "No camera had ever looked back toward home.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyager.jpg",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Voyager.jpg"
      },
      "shots": [
        {
          "start": 24.2,
          "end": 26.8,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
