  "beats": [
    {
      "start": 0.08,
      "end": 3.68,
      "text": "A comet's poisonous tail nearly sparked a global panic.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "EB1911 - Comet Fig. 4.\u2014Halley\u2019s Comet, 1910.jpg",
        "credit": "Edward Emerson Barnard",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:EB1911_-_Comet_Fig._4.%E2%80%94Halley%E2%80%99s_Comet,_1910.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.667,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.68,
      "end": 7.48,
      "text": "Astronomers detected cyanogen gas hiding inside the glowing tail.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PSM V60 D306 The forty inch telescope of the yerkes observatory.png",
        "credit": "Unknown authorUnknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PSM_V60_D306_The_forty_inch_telescope_of_the_yerkes_observatory.png"
      },
      "shots": [
        {
          "start": 3.667,
          "end": 7.467,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.48,
      "end": 10.86,
      "text": "Newspapers warned the poison gas would snuff out all life.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mark Twain called by death.jpg",
        "credit": "The San Francisco call (San Francisco [Calif.]), April 22, 1910",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Mark_Twain_called_by_death.jpg"
      },
      "shots": [
        {
          "start": 7.467,
          "end": 10.867,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.86,
      "end": 14.2,
      "text": "Hucksters quickly sold fake comet pills and gas masks.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 10.867,
          "end": 14.2,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.2,
      "end": 16.86,
      "text": "Families sealed their windows and doors with wet towels.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "View on the back of the exterior of the Old Observatory Leiden at the Sterrewachtlaan 11 in Leiden, AHM-F-6059-1786.tiff",
        "credit": "AnonymousUnknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:View_on_the_back_of_the_exterior_of_the_Old_Observatory_Leiden_at_the_Sterrewachtlaan_11_in_Leiden,_AHM-F-6059-1786.tiff"
      },
      "shots": [
        {
          "start": 14.2,
          "end": 16.867,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.86,
      "end": 20.52,
      "text": "Earth glided right through the tail with zero harmful effects.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 16.867,
          "end": 20.533,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.52,
      "end": 25.607,
      "text": "That is how a celestial visitor nearly triggered widespread worldwide panic.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "EB1911 - Comet Fig. 4.\u2014Halley\u2019s Comet, 1910.jpg",
