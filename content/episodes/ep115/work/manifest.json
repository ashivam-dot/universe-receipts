  "beats": [
    {
      "start": 0.08,
      "end": 4.604,
      "text": "Scientists once feared the Moon was covered in bottomless, killer quicksand.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist Concepts - Apollo - MSC (s66-11014).jpg",
        "credit": "NASA Johnson Space Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Artist_Concepts_-_Apollo_-_MSC_(s66-11014).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.1,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 2.1,
          "end": 4.6,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.604,
      "end": 12.449,
      "text": "In the 1960s, Cornell astronomer Thomas Gold warned that lunar dust was deep enough to swallow any spacecraft.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Admiral Byrd admires medal awarded to aide on Antarctic expedition. Washington, D.C., April 27. Rear Admiral Richard E. Byrd admires the gold medal of the National Geographic Society which LCCN2016877888 (Poulter crop).jpg",
        "credit": "Harris & Ewing, photographer",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Admiral_Byrd_admires_medal_awarded_to_aide_on_Antarctic_expedition._Washington,_D.C.,_April_27._Rear_Admiral_Richard_E._Byrd_admires_the_gold_medal_of_the_National_Geographic_Society_which_LCCN2016877888_(Poulter_crop).jpg"
      },
      "shots": [
        {
          "start": 4.6,
          "end": 12.433,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.449,
      "end": 18.644,
      "text": "To solve the mystery, NASA launched the Surveyor program to touch the surface before humans did.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Lunar Lander, Surveyor - DPLA - d6accc3d89e8efa6f2e88962941bf43a (page 8).jpg",
        "credit": "Hughes Aircraft Co",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Lunar_Lander,_Surveyor_-_DPLA_-_d6accc3d89e8efa6f2e88962941bf43a_(page_8).jpg"
      },
      "shots": [
        {
          "start": 12.433,
          "end": 18.633,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.644,
      "end": 27.669,
      "text": "In June 1966, Surveyor 1 touched down on firm basaltic rock, proving the bottomless quicksand was a total myth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "First Photo from the Surface of the Moon.jpg",
        "credit": "\"Image Credit: National Space Science Data Center\" (NASA, USA); original image from Luna 9 (USSR)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:First_Photo_from_the_Surface_of_the_Moon.jpg"
      },
      "shots": [
        {
          "start": 18.633,
          "end": 27.667,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 27.669,
      "end": 33.239,
      "text": "But when the sun set, robotic cameras caught a ghostly glow hovering over the horizon.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Stamp of Manama 1968 Space-Research-Probes.jpg",
        "credit": "Unknown authorUnknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Stamp_of_Manama_1968_Space-Research-Probes.jpg"
      },
      "shots": [
        {
          "start": 27.667,
          "end": 33.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 33.239,
      "end": 41.634,
      "text": "Solar radiation strips electrons from the soil, creating electrostatic charges that launch dust kilometers into the sky.",
      "asset": {
        "source": "Art Institute of Chicago (CC0)",
        "title": "Lunar Law, No. 1",
        "credit": "Charles Meryon\nFrench, 1821-1868",
        "license": "CC0",
        "url": "https://www.artic.edu/artworks/74058"
      },
      "shots": [
        {
          "start": 33.233,
          "end": 37.167,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 37.167,
          "end": 41.633,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 41.634,
      "end": 49.054,
      "text": "Apollo 17 astronauts even sketched these towering rays of levitating glass shards during their final mission.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Apollo 17 twilight ray sketch.jpg",
        "credit": "Apollo 17 astronauts",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Apollo_17_twilight_ray_sketch.jpg"
      },
      "shots": [
        {
          "start": 41.633,
          "end": 49.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 49.054,
      "end": 55.404,
      "text": "This electrifying fountain proves the Moon isn't actually covered in bottomless, killer quicksand.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist Concepts - Apollo - MSC (s66-11014).jpg",
        "credit": "NASA Johnson Space Center",
