  "beats": [
    {
      "start": 0.08,
      "end": 3.96,
      "text": "A massive city of galaxies was flying apart too fast.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Coma Cluster (noirlab2420a).tiff",
        "credit": "CTIO/NOIRLab/DOE/NSF/AURA Image Processing: D. de Martin & M. Zamani (NSF NOIRLab)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Coma_Cluster_(noirlab2420a).tiff"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.967,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.96,
      "end": 8.46,
      "text": "Over a thousand galaxies sit 321 million light-years away.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Coma Berenices (Annotated) (coma-berenices-ann).tiff",
        "credit": "E. Slawik/NOIRLab/NSF/AURA/M. Zamani",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Coma_Berenices_(Annotated)_(coma-berenices-ann).tiff"
      },
      "shots": [
        {
          "start": 3.967,
          "end": 8.467,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.46,
      "end": 11.94,
      "text": "Swiss astronomer Fritz Zwicky calculated their wild speeds.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "ETH-BIB-Zwicky, Fritz (1898-1974)-Portr 01030 (cropped).tif",
        "credit": "Unbekannt",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:ETH-BIB-Zwicky,_Fritz_(1898-1974)-Portr_01030_(cropped).tif"
      },
      "shots": [
        {
          "start": 8.467,
          "end": 11.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.94,
      "end": 14.4,
      "text": "Visible starlight was far too weak to hold them.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NGC 4874 HST.jpg",
        "credit": "ESA/Hubble & NASA",
        "license": "CC BY 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:NGC_4874_HST.jpg"
      },
      "shots": [
        {
          "start": 11.933,
          "end": 14.4,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.4,
      "end": 18.16,
      "text": "He realized an invisible substance must glue the cluster.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 14.4,
          "end": 18.167,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.16,
      "end": 21.86,
      "text": "That hidden dark matter outweighs all visible stars combined.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The sleeping giant NGC 4889 (24415737923).jpg",
        "credit": "Hubble ESA",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:The_sleeping_giant_NGC_4889_(24415737923).jpg"
      },
      "shots": [
        {
          "start": 18.167,
          "end": 21.867,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.86,
      "end": 25.68,
      "text": "Yet astronomers ignored his shocking math for fifty years.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Throop Hall at Caltech, in Pasadena (00035486).jpg",
        "credit": "Parker, Harold A., 1878-1930.",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Throop_Hall_at_Caltech,_in_Pasadena_(00035486).jpg"
      },
      "shots": [
        {
          "start": 21.867,
          "end": 25.667,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.68,
      "end": 29.482,
      "text": "No visible force explains why those stellar systems stayed bound.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Coma Cluster (noirlab2420a).tiff",
        "credit": "CTIO/NOIRLab/DOE/NSF/AURA Image Processing: D. de Martin & M. Zamani (NSF NOIRLab)",
