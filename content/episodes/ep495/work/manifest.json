  "beats": [
    {
      "start": 0.08,
      "end": 3.4,
      "text": "A meteorite hit a sleeping woman in her own home.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Ann Elizabeth Fowler Hodges holding the meteorite (cropped).jpg",
        "credit": "Associated Press",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Ann_Elizabeth_Fowler_Hodges_holding_the_meteorite_(cropped).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.4,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.4,
      "end": 5.6,
      "text": "It bounced off a radio, bruising Ann Hodges.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Ann Elizabeth Fowler Hodges holding the meteorite (cropped).jpg",
        "credit": "Associated Press",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Ann_Elizabeth_Fowler_Hodges_holding_the_meteorite_(cropped).jpg"
      },
      "shots": [
        {
          "start": 3.4,
          "end": 5.6,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 5.6,
      "end": 8.98,
      "text": "The Air Force seized it, but her landlord claimed ownership.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Vrachtvliegtuig van de US Air Force, NG-2009-136-48.jpg",
        "credit": "Rijksmuseum",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Vrachtvliegtuig_van_de_US_Air_Force,_NG-2009-136-48.jpg"
      },
      "shots": [
        {
          "start": 5.6,
          "end": 7.4,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 7.4,
          "end": 8.967,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.98,
      "end": 11.64,
      "text": "Mrs. Guy argued property rights over the space rock.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Ann Elizabeth Fowler Hodges points to the hole caused by the meteorite.jpg",
        "credit": "United Press International",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Ann_Elizabeth_Fowler_Hodges_points_to_the_hole_caused_by_the_meteorite.jpg"
      },
      "shots": [
        {
          "start": 8.967,
          "end": 11.633,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.64,
      "end": 14.72,
      "text": "The family paid five hundred dollars to keep and sell it.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Sahara 97210, Gewohnlicher Chondrit (L-LL3), falled December 1997 in Sahara - meteorites - Museum fur Naturkunde, Berlin - DSC00099.JPG",
        "credit": "Daderot",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Sahara_97210,_Gewohnlicher_Chondrit_(L-LL3),_falled_December_1997_in_Sahara_-_meteorites_-_Museum_fur_Naturkunde,_Berlin_-_DSC00099.JPG"
      },
      "shots": [
        {
          "start": 11.633,
          "end": 14.733,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.72,
      "end": 17.94,
      "text": "Public interest vanished, forcing them to donate the rock.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "2024-10-21 - Tuscaloosa, AL, USA - Hodges (Sylacauga) Meteorite.jpg",
        "credit": "Kai NeSmith",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:2024-10-21_-_Tuscaloosa,_AL,_USA_-_Hodges_(Sylacauga)_Meteorite.jpg"
      },
      "shots": [
        {
          "start": 14.733,
          "end": 16.333,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 16.333,
          "end": 17.933,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.94,
      "end": 21.02,
      "text": "Meanwhile, farmer Julius McKinney found a second meteorite fragment.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Ordinary chondrite (New Concord Meteorite) 8.jpg",
        "credit": "James St. John",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Ordinary_chondrite_(New_Concord_Meteorite)_8.jpg"
      },
      "shots": [
        {
          "start": 17.933,
          "end": 21.033,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.02,
      "end": 23.6,
      "text": "He sold it to the Smithsonian, buying a house and car.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 21.033,
          "end": 23.6,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.6,
      "end": 26.598,
      "text": "Not everyone profits when a meteorite hits a sleeping woman.",
