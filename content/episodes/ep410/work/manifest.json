      },
      "shots": [
        {
          "start": 2.6,
          "end": 4.1,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 4.1,
          "end": 6.2,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.2,
      "end": 9.4,
      "text": "Many police and doctors still swear it causes madness.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Police car on Island of Cozumel.jpg",
        "credit": "christopdesoto",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Police_car_on_Island_of_Cozumel.jpg"
      },
      "shots": [
        {
          "start": 6.2,
          "end": 7.733,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 7.733,
