          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 2.6,
      "end": 6.2,
      "text": "We\u2019ve blamed lunar cycles for hospital chaos for centuries.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Greenville - Greenville General Hospital, night time scene.jpg",
        "credit": "Asheville Post Card Co.",
        "license": "Public domain",
