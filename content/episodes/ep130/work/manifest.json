{
  "id": "ep130",
  "duration": 53.78,
  "beats": [
    {
      "start": 0.08,
      "end": 4.754,
      "text": "A dormant supermassive black hole fired a particle jet directly at Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Swift J1644+57 black hole illustration.jpg",
        "credit": "NASA Goddard Space Flight Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Swift_J1644%2B57_black_hole_illustration.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.2,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 3.2,
          "end": 4.767,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.754,
      "end": 14.024,
      "text": "Most cosmic blasts fade within seconds, but NASA's Swift satellite detected a source that flared repeatedly with intense X-rays for days.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Swift - a first-of-its-kind multi-wavelength observatory.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Swift_-_a_first-of-its-kind_multi-wavelength_observatory.jpg"
      },
      "shots": [
        {
          "start": 4.767,
          "end": 9.4,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 9.4,
          "end": 14.033,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.024,
      "end": 20.644,
      "text": "In the northern constellation Draco, an approaching star was gravitationally ripped completely to shreds.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist\u2019s impression of star being tidally disrupted by a supermassive black hole (eso2018a).jpg",
        "credit": "ESO/M. Kornmesser",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%E2%80%99s_impression_of_star_being_tidally_disrupted_by_a_supermassive_black_hole_(eso2018a).jpg"
      },
      "shots": [
        {
          "start": 14.033,
          "end": 18.6,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 18.6,
          "end": 20.633,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.644,
      "end": 26.764,
      "text": "The shredder was a dormant supermassive black hole lurking inside the core of a distant galaxy.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Core of elliptical galaxy NGC 4150 (opo1038c).jpg",
        "credit": "NASA, ESA, R.M. Crockett (University of Oxford, U.K.), S. Kaviraj (Imperial College London and University of Oxford, U.K.), J. Silk (University of Oxford), M. Mutchler (Space Telescope Science Institu",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Core_of_elliptical_galaxy_NGC_4150_(opo1038c).jpg"
      },
      "shots": [
        {
          "start": 20.633,
          "end": 26.767,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 26.764,
      "end": 33.234,
      "text": "As stellar debris fell into an accretion disk, it launched a particle jet traveling near the speed of light.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Illustrations of Disks around Black Holes (2005-bhlock-more-2 - bhdisk thin ill).tiff",
        "credit": "(Credit: NASA/CXC/M.Weiss)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Illustrations_of_Disks_around_Black_Holes_(2005-bhlock-more-2_-_bhdisk_thin_ill).tiff"
      },
      "shots": [
        {
          "start": 26.767,
          "end": 33.233,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 33.234,
      "end": 40.354,
      "text": "That relativistic jet crossed 3.8 billion light-years with its narrow beam aimed directly toward Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NASA Telescopes Join Forces To Observe Unprecedented Explosion (5595572601).jpg",
        "credit": "NASA Goddard Space Flight Center from Greenbelt, MD, USA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:NASA_Telescopes_Join_Forces_To_Observe_Unprecedented_Explosion_(5595572601).jpg"
      },
      "shots": [
        {
          "start": 33.233,
          "end": 35.933,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 35.933,
          "end": 40.367,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 40.354,
      "end": 49.004,
      "text": "This head-on alignment significantly amplified its brightness, generating extraordinarily luminous and long-lived X-ray emissions.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist's concept of Tidal Disruption Event (PIA22355).jpg",
        "credit": "NRAO/AUI/NSF/NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%27s_concept_of_Tidal_Disruption_Event_(PIA22355).jpg"
      },
      "shots": [
        {
          "start": 40.367,
          "end": 44.867,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 44.867,
          "end": 49.0,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 49.004,
      "end": 53.43,
      "text": "Astronomers were staring straight down the barrel of a monstrous cosmic shredder.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Swift J1644+57 black hole illustration.jpg",
        "credit": "NASA Goddard Space Flight Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Swift_J1644%2B57_black_hole_illustration.jpg"
      },
      "shots": [
        {
          "start": 49.0,
          "end": 53.767,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
