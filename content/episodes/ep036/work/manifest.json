{
  "id": "ep036",
  "duration": 52.71,
  "beats": [
    {
      "start": 0.08,
      "end": 5.023,
      "text": "NASA is dropping a titanium beach ball into a 900-degree hellscape.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "DAVINCI Venus mission atmospheric probe.jpg",
        "credit": "NASA's Goddard Space Flight Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:DAVINCI_Venus_mission_atmospheric_probe.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 1.767,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 1.767,
          "end": 5.033,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 5.023,
      "end": 11.318,
      "text": "Venus features a surface hot enough to melt lead and crushing pressure ninety times greater than Earth's.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Surfaces of Venus, Venere 13 and Venera14.jpg",
        "credit": "Lunar and Planetary Institute from Houston, TX, USA",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Surfaces_of_Venus,_Venere_13_and_Venera14.jpg"
      },
      "shots": [
        {
          "start": 5.033,
          "end": 11.333,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.318,
      "end": 19.388,
      "text": "In 2021, NASA selected the DAVINCI mission to pierce the planet's toxic clouds of sulfuric acid.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 11.333,
          "end": 19.4,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.388,
      "end": 25.733,
      "text": "The heart of the mission is a titanium sphere built to survive a one-hour plunge through the crushing air.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "DAVINCI Drop Testing at UTTR (SVS14582).jpg",
        "credit": "NASA's Scientific Visualization Studio - ADNET Systems, Inc./James Tralie, NASA, Chief Scientist Goddard/James Garvin",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:DAVINCI_Drop_Testing_at_UTTR_(SVS14582).jpg"
      },
      "shots": [
        {
          "start": 19.4,
          "end": 25.733,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.733,
      "end": 32.528,
      "text": "This descent probe will sniff noble gases to discover if Earth's twin once held vast water oceans.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 25.733,
          "end": 32.533,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 32.528,
      "end": 40.248,
      "text": "Before crashing, the sphere will capture the first high-resolution views of Venus's rugged mountains since 1982.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Maxwell Montes on Venus2.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Maxwell_Montes_on_Venus2.jpg"
      },
      "shots": [
        {
          "start": 32.533,
          "end": 37.267,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 37.267,
          "end": 40.233,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 40.248,
      "end": 48.173,
      "text": "Named after Leonardo da Vinci, this is NASA's first atmospheric entry into Venus since the 1970s.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Leonardo da Vinci - 19-540156.jpg",
        "credit": "Leonardo da Vinci",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Leonardo_da_Vinci_-_19-540156.jpg"
      },
      "shots": [
        {
          "start": 40.233,
          "end": 48.167,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 48.173,
      "end": 52.36,
      "text": "It is a daring, high-stakes journey into a 900-degree hellscape.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "DAVINCI Venus mission atmospheric probe.jpg",
        "credit": "NASA's Goddard Space Flight Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:DAVINCI_Venus_mission_atmospheric_probe.jpg"
      },
      "shots": [
        {
          "start": 48.167,
          "end": 52.7,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    }
