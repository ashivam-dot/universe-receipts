{
  "id": "ep413",
  "duration": 31.828,
  "beats": [
    {
      "start": 0.08,
      "end": 3.56,
      "text": "NASA paid Russia to launch an empty space station module.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Zarya from STS-88.jpg",
        "credit": "Unknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Zarya_from_STS-88.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.567,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.56,
      "end": 7.02,
      "text": "A Russian Proton rocket carried Zarya into orbit in 1998.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Proton-K-Zarya.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Proton-K-Zarya.jpg"
      },
      "shots": [
        {
          "start": 3.567,
          "end": 7.033,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.02,
      "end": 11.72,
      "text": "The solar-powered cylinder steered itself through space completely uncrewed.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Zarya approach.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Zarya_approach.jpg"
      },
      "shots": [
        {
          "start": 7.033,
          "end": 9.0,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 9.0,
          "end": 11.733,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.72,
      "end": 15.06,
      "text": "Two weeks later, Space Shuttle Endeavour caught Zarya in space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "S99 03776.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:S99_03776.jpg"
      },
      "shots": [
        {
          "start": 11.733,
          "end": 15.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.06,
      "end": 18.04,
      "text": "Astronauts plugged in cables to join it with an American module.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Zarya FGB control module .Russian-built.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Zarya_FGB_control_module_.Russian-built.jpg"
      },
      "shots": [
        {
          "start": 15.067,
          "end": 18.033,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.04,
      "end": 21.64,
      "text": "Then the shuttle crew went home, leaving both modules behind.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "STS088-369-009 - STS-088 - View of the free-flying ISS stack taken during fly-around by STS-96 - DPLA - eb7eba509483551fe4dc06b16544f8e2.jpg",
        "credit": "National Aeronautics and Space Administration. Lyndon B. Johnson Space Center. 2/17/1973",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:STS088-369-009_-_STS-088_-_View_of_the_free-flying_ISS_stack_taken_during_fly-around_by_STS-96_-_DPLA_-_eb7eba509483551fe4dc06b16544f8e2.jpg"
      },
      "shots": [
        {
          "start": 18.033,
          "end": 21.633,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.64,
      "end": 25.4,
      "text": "This robotic outpost orbited Earth empty for over eighteen months.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Unity-Zarya Meet on Orbit (49177404063).jpg",
        "credit": "NASA on The Commons",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Unity-Zarya_Meet_on_Orbit_(49177404063).jpg"
      },
      "shots": [
        {
          "start": 21.633,
          "end": 25.4,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.4,
      "end": 28.34,
      "text": "A Russian living module docked in July 2000 to add life support.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "ISS Zvezda module.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:ISS_Zvezda_module.jpg"
      },
      "shots": [
        {
          "start": 25.4,
          "end": 28.333,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 28.34,
      "end": 31.478,
      "text": "Only then could humans step inside the original foundation.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Zarya from STS-88.jpg",
        "credit": "Unknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Zarya_from_STS-88.jpg"
      },
      "shots": [
        {
          "start": 28.333,
          "end": 31.833,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    }
  ],
