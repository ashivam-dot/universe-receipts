        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Reel_309-53,_1953_-_DPLA_-_2f11047e08a5c707e5667621bd9b9d1b_(page_1084).jpg"
      },
      "shots": [
        {
          "start": 42.333,
          "end": 45.3,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 45.3,
          "end": 48.733,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 48.748,
      "end": 52.74,
      "text": "A public search continues to locate these forgotten living monuments.",
