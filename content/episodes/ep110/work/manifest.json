  "beats": [
    {
      "start": 0.08,
      "end": 4.628,
      "text": "NASA completely forgot about hundreds of trees grown from space seeds.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Sycamore Moon Tree at Core Creek State Park, Bucks County PA.jpg",
        "credit": "Plefkag",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Sycamore_Moon_Tree_at_Core_Creek_State_Park,_Bucks_County_PA.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.633,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.628,
      "end": 11.448,
      "text": "In 1971, Apollo 14 astronaut Stuart Roosa carried the seeds while orbiting the Moon.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Apollo 14 Command and Service Modules (CSM) (cropped).jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Apollo_14_Command_and_Service_Modules_(CSM)_(cropped).jpg"
      },
      "shots": [
        {
          "start": 4.633,
          "end": 11.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.448,
      "end": 17.968,
      "text": "Despite a vacuum chamber accident on Earth, the US Forest Service successfully grew the seedlings.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Apollo 14 Command and Service Modules (CSM) (cropped).jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Apollo_14_Command_and_Service_Modules_(CSM)_(cropped).jpg"
      },
      "shots": [
        {
          "start": 11.433,
          "end": 17.967,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.968,
      "end": 25.138,
      "text": "Around 1976, these saplings were planted worldwide to celebrate the American bicentennial.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 17.967,
          "end": 25.133,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.138,
      "end": 29.983,
      "text": "However, NASA failed to keep any official records tracking their locations.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NASA Headquarters.jpg",
        "credit": "DCAllStar",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:NASA_Headquarters.jpg"
      },
      "shots": [
        {
          "start": 25.133,
          "end": 26.867,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 26.867,
          "end": 29.967,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 29.983,
      "end": 36.303,
      "text": "In 1996, a third-grade teacher named Joan [Goble](/\u0261\u02ccOb\u02c8\u028al/) found one at an Indiana camp.",
      "asset": {
        "source": "iNaturalist",
        "title": "American sycamore (Platanus occidentalis)",
        "credit": "(c) Tom Norton, some rights reserved (CC BY)",
        "license": "CC BY 4.0",
        "url": "https://www.inaturalist.org/observations/53514537"
      },
      "shots": [
        {
          "start": 29.967,
          "end": 36.3,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 36.303,
      "end": 42.503,
      "text": "When she emailed NASA, shocked scientists realized they didn't even know the program existed.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NASA Goddard Space Flight Center Aerial view 2010 facing south.jpg",
        "credit": "NASA Goddard/Bill Hrybyk",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:NASA_Goddard_Space_Flight_Center_Aerial_view_2010_facing_south.jpg"
      },
      "shots": [
        {
          "start": 36.3,
          "end": 39.833,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 39.833,
          "end": 42.5,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 42.503,
      "end": 48.923,
      "text": "Planetary scientist Dave Williams dug through old archives to rebuild the history from scratch.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "National Archives. Washington, D.C., Nov. 22. After leaving the humidifying chamber, the documents are brought to the special ironers to take all remaining wrinkles out LCCN2016876649.jpg",
        "credit": "Harris & Ewing, photographer",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:National_Archives._Washington,_D.C.,_Nov._22._After_leaving_the_humidifying_chamber,_the_documents_are_brought_to_the_special_ironers_to_take_all_remaining_wrinkles_out_LCCN2016876649.jpg"
      },
      "shots": [
        {
          "start": 42.5,
          "end": 45.467,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 45.467,
          "end": 48.933,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 48.923,
      "end": 52.915,
      "text": "A public search continues to locate these forgotten living monuments.",
