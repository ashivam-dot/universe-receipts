{
  "id": "ep443",
  "duration": 28.931,
  "beats": [
    {
      "start": 0.08,
      "end": 3.32,
      "text": "NASA's first Mars rover was the size of a microwave.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Sojourner on Mars PIA01122.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Sojourner_on_Mars_PIA01122.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 1.867,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 1.867,
          "end": 3.333,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.32,
      "end": 7.44,
      "text": "This twenty-three-pound microrover reached the surface wrapped in giant airbags.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Pathfinder on Mars (apod).jpg",
        "credit": "Mars Pathfinder, JPL, NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Pathfinder_on_Mars_(apod).jpg"
      },
      "shots": [
        {
          "start": 3.333,
          "end": 7.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.44,
      "end": 10.36,
      "text": "The craft didn't land; it bounced across a Martian flood plain.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA02405.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA02405.jpg"
      },
      "shots": [
        {
          "start": 7.433,
          "end": 10.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.36,
      "end": 14.18,
      "text": "Sojourner arrived in 1997, named for civil rights activist Sojourner Truth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Sojourner Truth 01.jpg",
        "credit": "Sojourner Truth",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Sojourner_Truth_01.jpg"
      },
      "shots": [
        {
          "start": 10.367,
          "end": 14.167,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.18,
      "end": 17.46,
      "text": "Engineers only expected the tiny robot to survive seven days.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA01551.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA01551.jpg"
      },
      "shots": [
        {
          "start": 14.167,
          "end": 17.467,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.46,
      "end": 21.52,
      "text": "It lasted eighty-five days, proving Mars was once warm and wet.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Pathfinder01.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Pathfinder01.jpg"
      },
      "shots": [
        {
          "start": 17.467,
          "end": 21.533,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.52,
      "end": 24.96,
      "text": "Today, its silhouette is etched onto the deck of the Perseverance rover.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NASA\u2019s Perseverance Rover Completes Mars Sample Depot (SVS31217).tiff",
        "credit": "NASA's Scientific Visualization Studio - Karen Fox, Amy Moran",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:NASA%E2%80%99s_Perseverance_Rover_Completes_Mars_Sample_Depot_(SVS31217).tiff"
      },
      "shots": [
        {
          "start": 21.533,
          "end": 23.267,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 23.267,
          "end": 24.967,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.96,
      "end": 28.581,
      "text": "It\u2019s a permanent tribute to the robot built like a microwave.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Sojourner on Mars PIA01122.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Sojourner_on_Mars_PIA01122.jpg"
      },
      "shots": [
        {
          "start": 24.967,
          "end": 28.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
