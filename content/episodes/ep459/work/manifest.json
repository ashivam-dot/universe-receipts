{
  "id": "ep459",
  "duration": 28.453,
  "beats": [
    {
      "start": 0.08,
      "end": 4.02,
      "text": "An astronaut ruined NASA's first lunar color camera within minutes.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Apollo 12 TV Camera.jpg",
        "credit": "NASA/Pete Conrad",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Apollo_12_TV_Camera.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 1.8,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 1.8,
          "end": 4.033,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.02,
      "end": 8.04,
      "text": "Millions watched expecting live color footage of the Apollo 12 moonwalk.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "AS12-46-6749 (21688668102) (cropped).jpg",
        "credit": "Project Apollo Archive",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:AS12-46-6749_(21688668102)_(cropped).jpg"
      },
      "shots": [
        {
          "start": 4.033,
          "end": 8.033,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.04,
      "end": 12.02,
      "text": "Astronaut Alan Bean accidentally pointed the camera lens directly into the Sun.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Alan Bean deploys ALSEP during first Apollo 12 EVA on moon.jpg",
        "credit": "Pete Conrad",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Alan_Bean_deploys_ALSEP_during_first_Apollo_12_EVA_on_moon.jpg"
      },
      "shots": [
        {
          "start": 8.033,
          "end": 9.9,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 9.9,
          "end": 12.033,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.02,
      "end": 15.22,
      "text": "Intense solar light burned out the camera's sensitive tube instantly.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Alan Bean deploys ALSEP during first Apollo 12 EVA on moon.jpg",
        "credit": "Pete Conrad",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Alan_Bean_deploys_ALSEP_during_first_Apollo_12_EVA_on_moon.jpg"
      },
      "shots": [
        {
          "start": 12.033,
          "end": 15.233,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.22,
      "end": 18.4,
      "text": "The live video feed to Earth went black almost immediately.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 15.233,
          "end": 18.4,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.4,
      "end": 21.74,
      "text": "Bean tried fixing the space-age camera by hitting it with his hammer.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "John Young stands on the rim of Plum Crater while collecting lunar samples.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:John_Young_stands_on_the_rim_of_Plum_Crater_while_collecting_lunar_samples.jpg"
      },
      "shots": [
        {
          "start": 18.4,
          "end": 20.267,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 20.267,
          "end": 21.733,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.74,
      "end": 25.52,
      "text": "The low-tech repair failed, leaving NASA with only still photographs.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Astronaut Pete Conrad on the Moon (AS12-48-7071).jpg",
        "credit": "Apollo astronaut Alan Bean",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Astronaut_Pete_Conrad_on_the_Moon_(AS12-48-7071).jpg"
      },
      "shots": [
        {
          "start": 21.733,
          "end": 25.533,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.52,
      "end": 28.103,
      "text": "The space-age camera never broadcast another frame.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Apollo 12 TV Camera.jpg",
        "credit": "NASA/Pete Conrad",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Apollo_12_TV_Camera.jpg"
      },
      "shots": [
        {
          "start": 25.533,
          "end": 28.467,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    }
  ],
