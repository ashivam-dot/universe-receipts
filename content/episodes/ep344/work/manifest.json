  "beats": [
    {
      "start": 0.08,
      "end": 3.02,
      "text": "A cosmic wall of galaxies stretches across the sky.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Simulation of large scale structure (eso1438b).jpg",
        "credit": "Illustris Collaboration",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Simulation_of_large_scale_structure_(eso1438b).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.033,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.02,
      "end": 6.46,
      "text": "If our home galaxy were a pebble, this is a mountain.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Simulation of large scale structure (eso1438b).tiff",
        "credit": "Illustris Collaboration",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Simulation_of_large_scale_structure_(eso1438b).tiff"
      },
      "shots": [
        {
          "start": 3.033,
          "end": 6.467,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.46,
      "end": 10.62,
      "text": "It contains thousands of galaxies across 500 million light-years.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Coma Cluster Full Mosaic (2018-44-4268).tif",
        "credit": "NASA, ESA, J. Mack (STScI), and J. Madrid (Australian Telescope National Facility)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Coma_Cluster_Full_Mosaic_(2018-44-4268).tif"
      },
      "shots": [
        {
          "start": 6.467,
          "end": 10.633,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.62,
      "end": 13.22,
      "text": "Astronomers Margaret Geller and John Huchra mapped this sheet.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Large-scale structure of light distribution in the universe.jpg",
        "credit": "Andrew Pontzen and Fabio Governato",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Large-scale_structure_of_light_distribution_in_the_universe.jpg"
      },
      "shots": [
        {
          "start": 10.633,
          "end": 13.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.22,
      "end": 16.76,
      "text": "They used a 60-inch telescope in Arizona in 1989.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 13.233,
          "end": 16.767,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.76,
      "end": 20.92,
      "text": "Gravity alone is far too slow to weave together such a massive structure.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "CMB Timeline300 no WMAP.jpg",
        "credit": "NASA/WMAP Science Team",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:CMB_Timeline300_no_WMAP.jpg"
      },
      "shots": [
        {
          "start": 16.767,
          "end": 20.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.92,
      "end": 24.14,
      "text": "It proves a hidden web of dark matter must be pulling the strings.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Cosmic Web and Slime Mold (2020-11-4635).tif",
        "credit": ", , and J. Burchett and O. Elek (UC Santa Cruz)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Cosmic_Web_and_Slime_Mold_(2020-11-4635).tif"
      },
      "shots": [
        {
          "start": 20.933,
          "end": 24.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.14,
      "end": 26.66,
      "text": "Our own Milky Way still hides where it ends.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "VISTA gigapixel mosaic of the central parts of the Milky Way-Eso1242a.tif",
        "credit": "ESO/VVV Survey/D. MinnitiAcknowledgement: Ignacio Toledo, Martin Kornmesser",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:VISTA_gigapixel_mosaic_of_the_central_parts_of_the_Milky_Way-Eso1242a.tif"
      },
      "shots": [
        {
          "start": 24.133,
          "end": 26.667,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 26.66,
      "end": 29.216,
      "text": "A hidden giant still stretches across the sky.",
