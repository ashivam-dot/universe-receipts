{
  "id": "ep344",
  "duration": 27.503,
  "beats": [
    {
      "start": 0.08,
      "end": 2.84,
      "text": "A wall of galaxies stretches across the deep sky.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Large-scale structure of light distribution in the universe.jpg",
        "credit": "Andrew Pontzen and Fabio Governato",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Large-scale_structure_of_light_distribution_in_the_universe.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.833,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 2.84,
      "end": 6.22,
      "text": "If our home galaxy were a single pebble, this wall is a mountain.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Simulation of large scale structure (eso1438b).jpg",
        "credit": "Illustris Collaboration",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Simulation_of_large_scale_structure_(eso1438b).jpg"
      },
      "shots": [
        {
          "start": 2.833,
          "end": 6.233,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.22,
      "end": 6.76,
      "text": "It contains thousands of galaxies, like the massive Coma Cluster.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Coma Cluster Full Mosaic (2018-44-4268).tif",
        "credit": "NASA, ESA, J. Mack (STScI), and J. Madrid (Australian Telescope National Facility)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Coma_Cluster_Full_Mosaic_(2018-44-4268).tif"
      },
      "shots": [
        {
          "start": 6.233,
          "end": 6.767,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.76,
      "end": 10.46,
      "text": "Astronomers Margaret Geller and John Huchra mapped this sheet in 1989.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 6.767,
          "end": 10.467,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.46,
      "end": 14.86,
      "text": "The structure is a staggering 500 million light-years long.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "2MASS LSS chart-NEW Nasa rus.jpg",
        "credit": "2MASS_LSS_chart-NEW_Nasa.jpg: IPAC/Caltech, by Thomas Jarrett\nderivative work: antropia (talk)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:2MASS_LSS_chart-NEW_Nasa_rus.jpg"
      },
      "shots": [
        {
          "start": 10.467,
          "end": 14.867,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.86,
      "end": 17.48,
      "text": "Gravity shouldn't have had enough time to build something this big.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "CMB Timeline300 no WMAP.jpg",
        "credit": "NASA/WMAP Science Team",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:CMB_Timeline300_no_WMAP.jpg"
      },
      "shots": [
        {
          "start": 14.867,
          "end": 17.467,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.48,
      "end": 20.64,
      "text": "Only an invisible web of dark matter makes its scale possible.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Probing the cosmic web (opo0820b).tiff",
        "credit": "NASA, ESA, and E. Hallman (University of Colorado, Boulder)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Probing_the_cosmic_web_(opo0820b).tiff"
      },
      "shots": [
        {
          "start": 17.467,
          "end": 20.633,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.64,
      "end": 23.54,
      "text": "Our own Milky Way still hides the wall's true end.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "VISTA gigapixel mosaic of the central parts of the Milky Way-Eso1242a.tif",
        "credit": "ESO/VVV Survey/D. MinnitiAcknowledgement: Ignacio Toledo, Martin Kornmesser",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:VISTA_gigapixel_mosaic_of_the_central_parts_of_the_Milky_Way-Eso1242a.tif"
      },
      "shots": [
        {
          "start": 20.633,
          "end": 23.533,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.54,
      "end": 27.153,
      "text": "A hidden giant remains draped across the entire sky.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Large-scale structure of light distribution in the universe.jpg",
        "credit": "Andrew Pontzen and Fabio Governato",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Large-scale_structure_of_light_distribution_in_the_universe.jpg"
      },
      "shots": [
        {
          "start": 23.533,
          "end": 27.5,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
