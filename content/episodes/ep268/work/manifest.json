{
  "id": "ep268",
  "duration": 28.578,
  "beats": [
    {
      "start": 0.08,
      "end": 3.24,
      "text": "The planet Uranus was almost named after King George.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Uranus Voyager2 color calibrated.png",
        "credit": "Ardenau4",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Uranus_Voyager2_color_calibrated.png"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.24,
      "end": 6.38,
      "text": "A musician named William Herschel spotted the faint object first.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "William Herschel01.jpg",
        "credit": "Lemuel Francis Abbott",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:William_Herschel01.jpg"
      },
      "shots": [
        {
          "start": 3.233,
          "end": 4.467,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 4.467,
          "end": 6.367,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.38,
      "end": 9.3,
      "text": "He found it using a telescope he built himself.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Medium SMG00043907.jpg",
        "credit": "Wellcome Collection",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Medium_SMG00043907.jpg"
      },
      "shots": [
        {
          "start": 6.367,
          "end": 9.3,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.3,
      "end": 12.28,
      "text": "Herschel initially thought he had found a fuzzy comet.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "VLT Tracks Rosetta's Comet.jpg",
        "credit": "Colin Snodgrass/ESO/ESA",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:VLT_Tracks_Rosetta%27s_Comet.jpg"
      },
      "shots": [
        {
          "start": 9.3,
          "end": 12.267,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.28,
      "end": 15.42,
      "text": "But the circular orbit proved it was a massive planet.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "(589683) 2010 RF43 orbit diagram jpl.png",
        "credit": "Public domainPublic domainfalsefalse\n\n\n\n\n\nThis file is in the public domain in the United States because it was solely created by NASA. NASA copyright policy states that \"NASA material is not protecte",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:(589683)_2010_RF43_orbit_diagram_jpl.png"
      },
      "shots": [
        {
          "start": 12.267,
          "end": 14.233,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 14.233,
          "end": 15.433,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.42,
      "end": 19.36,
      "text": "This discovery instantly doubled the known size of our solar system.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Graph of Planetary Mass Versus Distance From the Sun.png",
        "credit": "Emily Lakdawalla for The Planetary Society using image data from NASA/JPL-Caltech/SSI/SwRI/CIW/ISRO/Daniel Chang, processed by Bj\u00f6rn J\u00f3nsson, Emily Lakdawalla, Daniel Mach\u00e1\u010dek, Mattias Malmer, Alex Pa",
        "license": "CC BY 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:Graph_of_Planetary_Mass_Versus_Distance_From_the_Sun.png"
      },
      "shots": [
        {
          "start": 15.433,
          "end": 17.133,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 17.133,
          "end": 19.367,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.36,
      "end": 22.72,
      "text": "International astronomers refused to name a world after a monarch.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Allan Ramsay (1713-84) - George III (1738-1820) - RCIN 405307 - Royal Collection.jpg",
        "credit": "Allan Ramsay",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Allan_Ramsay_(1713-84)_-_George_III_(1738-1820)_-_RCIN_405307_-_Royal_Collection.jpg"
      },
      "shots": [
        {
          "start": 19.367,
          "end": 21.067,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 21.067,
          "end": 22.733,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.72,
      "end": 25.2,
      "text": "They chose Uranus to match the ancient gods instead.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PPN663944449 J. Bode (1824).tif",
        "credit": "Karl Friedrich Gustav L\u00fcderitz; Emil Krafft",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PPN663944449_J._Bode_(1824).tif"
      },
      "shots": [
        {
          "start": 22.733,
          "end": 25.2,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.2,
      "end": 28.228,
      "text": "It remains the only world that nearly became a king.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Uranus Voyager2 color calibrated.png",
        "credit": "Ardenau4",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Uranus_Voyager2_color_calibrated.png"
      },
      "shots": [
        {
          "start": 25.2,
          "end": 28.567,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
