  "beats": [
    {
      "start": 0.08,
      "end": 6.022,
      "text": "A city-bus-sized asteroid snuck halfway inside our Moon's protective orbit without warning.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA21259 - Celestial Object 2016 WF9, a NEOWISE Discovery (Artist Concept).jpg",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA21259_-_Celestial_Object_2016_WF9,_a_NEOWISE_Discovery_(Artist_Concept).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.2,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 2.2,
          "end": 6.033,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.022,
      "end": 14.142,
      "text": "In February 2023, astronomers using a Canary Islands telescope spotted the unexpected cosmic visitor.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 6.033,
          "end": 14.133,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.142,
      "end": 20.462,
      "text": "Detailed measurements revealed the rocky visitor was between forty and ninety meters across.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 14.133,
          "end": 20.467,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.462,
      "end": 26.707,
      "text": "Worse still, early math briefly listed it as a virtual impactor for March 2026.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Sentry box Evzone Parliament Athens Greece.jpg",
        "credit": "Jebulon",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Sentry_box_Evzone_Parliament_Athens_Greece.jpg"
      },
      "shots": [
        {
          "start": 20.467,
          "end": 26.7,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 26.707,
      "end": 32.852,
      "text": "Further tracking thankfully ruled out the collision, dropping the rock from the risk table completely.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Goldstone DSN antenna.jpg",
        "credit": "Unknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Goldstone_DSN_antenna.jpg"
      },
      "shots": [
        {
          "start": 26.7,
          "end": 32.867,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 32.852,
      "end": 39.847,
      "text": "On March 25, the asteroid roared past at a distance of one hundred seventy-five thousand kilometers.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Released to Public Earth by NASA (NASA, GPN-2000-001437) (241635550).jpg",
        "credit": "pingnews.com",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Released_to_Public_Earth_by_NASA_(NASA,_GPN-2000-001437)_(241635550).jpg"
      },
      "shots": [
        {
          "start": 32.867,
          "end": 39.833,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 39.847,
      "end": 46.292,
      "text": "Amateur stargazers easily spotted the fast cosmic visitor using small backyard telescopes.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Young astronomy enthusiast looking at the moon through the SkyWatcher telescope.jpg",
        "credit": "Astroclubkosova",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Young_astronomy_enthusiast_looking_at_the_moon_through_the_SkyWatcher_telescope.jpg"
      },
      "shots": [
        {
          "start": 39.833,
          "end": 46.3,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
