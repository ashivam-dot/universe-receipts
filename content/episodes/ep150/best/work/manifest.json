{
  "id": "ep150",
  "duration": 58.222,
  "beats": [
    {
      "start": 0.08,
      "end": 5.329,
      "text": "Astronomers catalogued a faint violet speck, assuming it was an ordinary star.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Camara schmidt tonantzintla.jpg",
        "credit": "Gsrdzl",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Camara_schmidt_tonantzintla.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 5.333,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 5.329,
      "end": 13.724,
      "text": "In reality, TON 618 was an ultramassive black hole powered by a quasar 10.8 billion light-years away.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 5.333,
          "end": 13.733,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.724,
      "end": 22.544,
      "text": "Its event horizon radius spans approximately 1,300 astronomical units, swallowing the scale of our solar system.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 13.733,
          "end": 22.533,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.544,
      "end": 28.614,
      "text": "Gas whipping around its core exceeds orbital speeds of 10,000 kilometers per second.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Beyond the Brink- Tracking a Simulated Plunge into a Black Hole (SVS14585 - 5 BH Viz 41rg 069c).jpg",
        "credit": "NASA's Scientific Visualization Studio - null",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Beyond_the_Brink-_Tracking_a_Simulated_Plunge_into_a_Black_Hole_(SVS14585_-_5_BH_Viz_41rg_069c).jpg"
      },
      "shots": [
        {
          "start": 22.533,
          "end": 26.133,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 26.133,
          "end": 28.6,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 28.614,
      "end": 37.134,
      "text": "That infalling material unleashes a brilliance equal to 140 trillion Suns, completely drowning out its host galaxy.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NASA\u2019s Webb Will Use Quasars to Unlock the Secrets of the Early Universe (51656393132).png",
        "credit": "NASA's James Webb Space Telescope from Greenbelt, MD, USA",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:NASA%E2%80%99s_Webb_Will_Use_Quasars_to_Unlock_the_Secrets_of_the_Early_Universe_(51656393132).png"
      },
      "shots": [
        {
          "start": 28.6,
          "end": 32.2,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 32.2,
          "end": 37.133,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 37.134,
      "end": 45.154,
      "text": "Early measurements estimated 66 billion solar masses, later revised to roughly 40.7 billion Suns.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Fingerprinting the distant Universe using the light from quasar PKS 0405-123 (heic0910l).tiff",
        "credit": "NASA, ESA and the Hubble SM4 ERO Team and DSS",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Fingerprinting_the_distant_Universe_using_the_light_from_quasar_PKS_0405-123_(heic0910l).tiff"
      },
      "shots": [
        {
          "start": 37.133,
          "end": 42.733,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 42.733,
          "end": 45.167,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 45.154,
      "end": 52.554,
      "text": "Surrounding it all is an enormous Lyman-alpha gas nebula spanning at least 100 kiloparsecs across.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 45.167,
          "end": 52.567,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 52.554,
      "end": 57.872,
      "text": "No singular monster in the cosmos has ever hidden behind such a quiet disguise.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Camara schmidt tonantzintla.jpg",
        "credit": "Gsrdzl",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Camara_schmidt_tonantzintla.jpg"
      },
      "shots": [
        {
          "start": 52.567,
          "end": 58.233,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    }
  ],
