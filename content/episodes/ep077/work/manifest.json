{
  "id": "ep077",
  "duration": 53.633,
  "beats": [
    {
      "start": 0.08,
      "end": 4.546,
      "text": "A human spacecraft intentionally slammed into a distant asteroid.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Dart-poster3.jpg",
        "credit": "Credits: NASA/Johns Hopkins Applied Physics Lab",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Dart-poster3.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.967,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 2.967,
          "end": 4.533,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.546,
      "end": 12.366,
      "text": "Launched in November 2021, the Double Asteroid Redirection Test mission targeted a small binary system.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "DART Launch (51710374039).jpg",
        "credit": "Glenn Beltz from Goleta, CA, USA",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:DART_Launch_(51710374039).jpg"
      },
      "shots": [
        {
          "start": 4.533,
          "end": 8.467,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 8.467,
          "end": 12.367,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.366,
      "end": 20.036,
      "text": "Its target was Dimorphos, a tiny moonlet measuring roughly one hundred sixty to one hundred seventy meters wide.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Schematic of the DART impact geometry on Dimorphos.webp",
        "credit": "Authors of the study: Andrew F. Cheng, Harrison F. Agrusa, Brent W. Barbee, Alex J. Meyer, Tony L. Farnham, Sabina D. Raducan, Derek C. Richardson, Elisabetta Dotto, Angelo Zinzi, Vincenzo Della Corte",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Schematic_of_the_DART_impact_geometry_on_Dimorphos.webp"
      },
      "shots": [
        {
          "start": 12.367,
          "end": 20.033,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.036,
      "end": 24.956,
      "text": "Neither Didymos nor Dimorphos posed any actual impact threat to Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Schematic of the DART impact geometry on Dimorphos.webp",
        "credit": "Authors of the study: Andrew F. Cheng, Harrison F. Agrusa, Brent W. Barbee, Alex J. Meyer, Tony L. Farnham, Sabina D. Raducan, Derek C. Richardson, Elisabetta Dotto, Angelo Zinzi, Vincenzo Della Corte",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Schematic_of_the_DART_impact_geometry_on_Dimorphos.webp"
      },
      "shots": [
        {
          "start": 20.033,
          "end": 24.967,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.956,
      "end": 32.351,
      "text": "Traveling at approximately fourteen thousand miles per hour, the probe relied entirely on autonomous navigation.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Webb, Hubble Capture Detailed Views of DART Impact - 52405448284.jpg",
        "credit": "Science: NASA, ESA, CSA, Jian-Yang Li (PSI), Cristina Thomas (Northern Arizona University), Ian Wong (NASA-GSFC); image processing: Joseph DePasquale (STScI), Alyssa Pagan (STScI); DART: NASA/Johns Ho",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Webb,_Hubble_Capture_Detailed_Views_of_DART_Impact_-_52405448284.jpg"
      },
      "shots": [
        {
          "start": 24.967,
          "end": 32.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 32.351,
      "end": 40.071,
      "text": "On September 26, 2022, it struck the moonlet while flying about six point eight million miles from Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "20211123 213015 dart prelaunch 02.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:20211123_213015_dart_prelaunch_02.jpg"
      },
      "shots": [
        {
          "start": 32.367,
          "end": 40.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 40.071,
      "end": 46.796,
      "text": "The massive kinetic collision shortened Dimorphos's orbit around Didymos by thirty-two minutes.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "This chart offers insight into data the DART team used to determine the orbit of Dimorphos after impact.jpg",
        "credit": "NASA/Johns Hopkins APL/Astronomical Institute of the Academy of Sciences of the Czech Republic/Lowell Observatory/JPL/Las Cumbres Observatory/Las Campanas Observatory/European Southern Observatory Dan",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:This_chart_offers_insight_into_data_the_DART_team_used_to_determine_the_orbit_of_Dimorphos_after_impact.jpg"
      },
      "shots": [
        {
          "start": 40.067,
          "end": 46.8,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 46.796,
      "end": 53.283,
      "text": "That astonishing success proved a human spacecraft could intentionally slam into a distant asteroid.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Dart-poster3.jpg",
        "credit": "Credits: NASA/Johns Hopkins Applied Physics Lab",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Dart-poster3.jpg"
      },
      "shots": [
        {
          "start": 46.8,
          "end": 53.633,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
