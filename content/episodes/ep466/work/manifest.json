{
  "id": "ep466",
  "duration": 27.275,
  "beats": [
    {
      "start": 0.08,
      "end": 2.92,
      "text": "Deep space is vibrating with an eerie hum.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA22566-VoyagerProgram&Heliosphere-Chart-20181003.jpg",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA22566-VoyagerProgram%26Heliosphere-Chart-20181003.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 2.92,
      "end": 5.56,
      "text": "Voyager 1 heard it after crossing the border in 2012.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyager.jpg",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Voyager.jpg"
      },
      "shots": [
        {
          "start": 2.933,
          "end": 5.567,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 5.56,
      "end": 8.34,
      "text": "But space is supposed to be a silent vacuum.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Interstellar medium annotated.webp",
        "credit": "Credit: Charles Carter/Keck Institute for Space Studies",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Interstellar_medium_annotated.webp"
      },
      "shots": [
        {
          "start": 5.567,
          "end": 8.333,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.34,
      "end": 11.24,
      "text": "The probe\u2019s main sensor had been dead since 1980.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyager spacecraft structurePWSred.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Voyager_spacecraft_structurePWSred.jpg"
      },
      "shots": [
        {
          "start": 8.333,
          "end": 9.867,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 9.867,
          "end": 11.233,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.24,
      "end": 13.84,
      "text": "Scientists had to wait for a solar eruption to hit.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NASA-SDO - solar flare November 5, 2013, X3,3 class.jpg",
        "credit": "Zarateman",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:NASA-SDO_-_solar_flare_November_5,_2013,_X3,3_class.jpg"
      },
      "shots": [
        {
          "start": 11.233,
          "end": 13.833,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.84,
      "end": 16.42,
      "text": "The blast shook the plasma surrounding the ship.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Solar System Bubble.jpg",
        "credit": "NASA/JPL/JHUAPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Solar_System_Bubble.jpg"
      },
      "shots": [
        {
          "start": 13.833,
          "end": 16.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.42,
      "end": 19.4,
      "text": "It revealed gas much denser than inside our solar system.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NewHeliopause 558121.jpg",
        "credit": "NASA/Goddard Space Flight Center/CI Lab",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:NewHeliopause_558121.jpg"
      },
      "shots": [
        {
          "start": 16.433,
          "end": 19.4,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.4,
      "end": 22.64,
      "text": "This hum is the sound of interstellar gas vibrating.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyager-gold-record-display-10-5-1977 30214218763 o.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Voyager-gold-record-display-10-5-1977_30214218763_o.jpg"
      },
      "shots": [
        {
          "start": 19.4,
          "end": 22.633,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.64,
      "end": 24.76,
      "text": "It confirms that space is never truly empty.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "VISTA gigapixel mosaic of the central parts of the Milky Way-Eso1242a.tif",
        "credit": "ESO/VVV Survey/D. MinnitiAcknowledgement: Ignacio Toledo, Martin Kornmesser",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:VISTA_gigapixel_mosaic_of_the_central_parts_of_the_Milky_Way-Eso1242a.tif"
      },
      "shots": [
        {
          "start": 22.633,
          "end": 24.767,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.76,
      "end": 26.925,
      "text": "Even in the dark, deep space is vibrating.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA22566-VoyagerProgram&Heliosphere-Chart-20181003.jpg",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA22566-VoyagerProgram%26Heliosphere-Chart-20181003.jpg"
      },
      "shots": [
        {
