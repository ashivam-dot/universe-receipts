{
  "id": "ep466",
  "duration": 30.863,
  "beats": [
    {
      "start": 0.08,
      "end": 3.18,
      "text": "Deep space is vibrating with an eerie hum.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyager spacecraft (cropped2).jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Voyager_spacecraft_(cropped2).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.033,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 2.033,
          "end": 3.167,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.18,
      "end": 6.32,
      "text": "Voyager 1 heard it after crossing the border in 2012.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyager.jpg",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Voyager.jpg"
      },
      "shots": [
        {
          "start": 3.167,
          "end": 6.333,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.32,
      "end": 8.86,
      "text": "But space is supposed to be a silent vacuum.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hubble ultra deep field.jpg",
        "credit": "NASA and the European Space Agency.",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Hubble_ultra_deep_field.jpg"
      },
      "shots": [
        {
          "start": 6.333,
          "end": 8.867,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.86,
      "end": 12.04,
      "text": "The probe\u2019s main sensor had been dead since 1980.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyager spacecraft structurePWSred.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Voyager_spacecraft_structurePWSred.jpg"
      },
      "shots": [
        {
          "start": 8.867,
          "end": 10.6,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 10.6,
          "end": 12.033,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.04,
      "end": 14.34,
      "text": "Scientists waited for a solar eruption to hit.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NASA-SDO - solar flare October 29, 2013, X2,3 class.jpg",
        "credit": "NASA/SDO",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:NASA-SDO_-_solar_flare_October_29,_2013,_X2,3_class.jpg"
      },
      "shots": [
        {
          "start": 12.033,
          "end": 14.333,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.34,
      "end": 17.0,
      "text": "The blast shook the plasma surrounding the ship.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Solar System Bubble.jpg",
        "credit": "NASA/JPL/JHUAPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Solar_System_Bubble.jpg"
      },
      "shots": [
        {
          "start": 14.333,
          "end": 17.0,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.0,
      "end": 20.38,
      "text": "The blast revealed gas much thicker than anyone expected.",
      "asset": {
        "source": "Flickr via Openverse",
        "title": "Voyager 1 Encounters Stagnation Region",
        "credit": "NASA Universe",
        "license": "CC BY 2.0",
        "url": "https://www.flickr.com/photos/50306086@N07/6474236799"
      },
      "shots": [
        {
          "start": 17.0,
          "end": 20.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.38,
      "end": 24.38,
      "text": "This hum is the constant, ghostly music of the galaxy itself.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The Sounds of Earth Record Cover - GPN-2000-001978.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:The_Sounds_of_Earth_Record_Cover_-_GPN-2000-001978.jpg"
      },
      "shots": [
        {
          "start": 20.367,
          "end": 24.367,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.38,
      "end": 27.8,
      "text": "It proves the 'empty' void is actually a thick soup of gas.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The Galactic Center.jpg",
        "credit": "2MASS/G. Kopan, R. Hurt",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:The_Galactic_Center.jpg"
      },
      "shots": [
        {
          "start": 24.367,
          "end": 27.8,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 27.8,
      "end": 30.513,
      "text": "Even in the dark, deep space is vibrating.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyager spacecraft (cropped2).jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Voyager_spacecraft_(cropped2).jpg"
      },
      "shots": [
        {
          "start": 27.8,
          "end": 30.867,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
