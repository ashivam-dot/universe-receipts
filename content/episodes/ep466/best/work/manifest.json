{
  "id": "ep466",
  "duration": 26.132,
  "beats": [
    {
      "start": 0.08,
      "end": 3.06,
      "text": "Deep space is vibrating with an eerie hum.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA22566-VoyagerProgram&Heliosphere-Chart-20181003.jpg",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA22566-VoyagerProgram%26Heliosphere-Chart-20181003.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.06,
      "end": 5.5,
      "text": "Voyager 1 heard it after crossing the border in 2012.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyager.jpg",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Voyager.jpg"
      },
      "shots": [
        {
          "start": 3.067,
          "end": 5.5,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 5.5,
      "end": 8.0,
      "text": "But space is supposed to be a silent vacuum.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyager.jpg",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Voyager.jpg"
      },
      "shots": [
        {
          "start": 5.5,
          "end": 8.0,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.0,
      "end": 10.52,
      "text": "The probe\u2019s main sensor had been dead since 1980.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyager spacecraft structurePWSred.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Voyager_spacecraft_structurePWSred.jpg"
      },
      "shots": [
        {
          "start": 8.0,
          "end": 10.533,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.52,
      "end": 13.08,
      "text": "Scientists had to wait for a solar eruption to hit.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NASA-SDO - solar flare November 5, 2013, X3,3 class.jpg",
        "credit": "Zarateman",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:NASA-SDO_-_solar_flare_November_5,_2013,_X3,3_class.jpg"
      },
      "shots": [
        {
          "start": 10.533,
          "end": 13.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.08,
      "end": 15.34,
      "text": "The blast shook the plasma surrounding the ship.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Solar System Bubble.jpg",
        "credit": "NASA/JPL/JHUAPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Solar_System_Bubble.jpg"
      },
      "shots": [
        {
          "start": 13.067,
          "end": 15.333,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.34,
      "end": 18.22,
      "text": "It revealed gas much denser than inside our solar system.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NewHeliopause 558121.jpg",
        "credit": "NASA/Goddard Space Flight Center/CI Lab",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:NewHeliopause_558121.jpg"
      },
      "shots": [
        {
          "start": 15.333,
          "end": 18.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.22,
      "end": 20.94,
      "text": "Now we know the void has its own persistent soundtrack.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The Sounds of Earth Record Cover - GPN-2000-001978.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:The_Sounds_of_Earth_Record_Cover_-_GPN-2000-001978.jpg"
      },
      "shots": [
        {
          "start": 18.233,
          "end": 20.933,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.94,
      "end": 23.48,
      "text": "It\u2019s the constant buzzing of our entire galaxy.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "5 panel mosaic of the northern summer Milky Way.jpg",
        "credit": "Brainandforce",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:5_panel_mosaic_of_the_northern_summer_Milky_Way.jpg"
      },
      "shots": [
        {
          "start": 20.933,
          "end": 23.467,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.48,
      "end": 25.782,
      "text": "Even in the dark, deep space is vibrating.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA22566-VoyagerProgram&Heliosphere-Chart-20181003.jpg",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA22566-VoyagerProgram%26Heliosphere-Chart-20181003.jpg"
      },
      "shots": [
        {
          "start": 23.467,
          "end": 26.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
