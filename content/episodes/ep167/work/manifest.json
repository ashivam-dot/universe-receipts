{
  "id": "ep167",
  "duration": 43.598,
  "beats": [
    {
      "start": 0.08,
      "end": 3.996,
      "text": "The Moon formed in hours, but part of its maker never left.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artistic representation or simulation of the formation of the moon.png",
        "credit": "Mp152",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artistic_representation_or_simulation_of_the_formation_of_the_moon.png"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.0,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.996,
      "end": 9.291,
      "text": "Many believe the Moon slowly formed from orbiting debris over millions of years.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Moon formation from ring around early earth 1 r 1 1 1 1.png",
        "credit": "Merikanto",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Moon_formation_from_ring_around_early_earth_1_r_1_1_1_1.png"
      },
      "shots": [
        {
          "start": 4.0,
          "end": 9.3,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.291,
      "end": 15.786,
      "text": "Four point five billion years ago, a Mars-sized world named Theia smashed into our infant Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Giant impact.jpg",
        "credit": "H.Seldon",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Giant_impact.jpg"
      },
      "shots": [
        {
          "start": 9.3,
          "end": 15.8,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.786,
      "end": 22.206,
      "text": "High-resolution simulations now show this collision could have formed the Moon in just a few hours.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 15.8,
          "end": 22.2,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.206,
      "end": 27.076,
      "text": "But Theia did not just break apart; our own planet swallowed the intruder whole.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Giant impact.jpg",
        "credit": "H.Seldon",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Giant_impact.jpg"
      },
      "shots": [
        {
          "start": 22.2,
          "end": 27.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 27.076,
      "end": 33.896,
      "text": "Massive iron-rich structures sit eighteen hundred miles deep beneath Africa and the Pacific Ocean.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 27.067,
          "end": 33.9,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 33.896,
      "end": 39.221,
      "text": "Two continent-sized blobs inside Earth are the ancient relics of Theia.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Moon formation from ring around early earth 1 r 1 1 1 1.png",
        "credit": "Merikanto",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Moon_formation_from_ring_around_early_earth_1_r_1_1_1_1.png"
      },
      "shots": [
        {
          "start": 33.9,
          "end": 39.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 39.221,
      "end": 43.248,
      "text": "Deep underground lies the heart of the intruder that never left.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artistic representation or simulation of the formation of the moon.png",
        "credit": "Mp152",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artistic_representation_or_simulation_of_the_formation_of_the_moon.png"
      },
      "shots": [
        {
          "start": 39.233,
          "end": 43.6,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
