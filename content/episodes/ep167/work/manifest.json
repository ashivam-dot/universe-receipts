{
  "id": "ep167",
  "duration": 46.617,
  "beats": [
    {
      "start": 0.08,
      "end": 5.092,
      "text": "Two continent-sized blobs of an alien planet are buried deep inside Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Africa and Europe from a Million Miles Away.png",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Africa_and_Europe_from_a_Million_Miles_Away.png"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 5.1,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 5.092,
      "end": 10.837,
      "text": "Most people believe the Moon slowly formed from orbiting debris over millions of years.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Moon formation from ring around early earth 1 r 1 1 1 1.png",
        "credit": "Merikanto",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Moon_formation_from_ring_around_early_earth_1_r_1_1_1_1.png"
      },
      "shots": [
        {
          "start": 5.1,
          "end": 10.833,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.837,
      "end": 17.332,
      "text": "Four point five billion years ago, a Mars-sized world named Theia smashed into our infant Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist's concept of collision at HD 172555.jpg",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%27s_concept_of_collision_at_HD_172555.jpg"
      },
      "shots": [
        {
          "start": 10.833,
          "end": 13.333,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 13.333,
          "end": 17.333,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.332,
      "end": 25.127,
      "text": "Recent high-resolution simulations reveal this cataclysmic impact could have formed the Moon in just a few hours.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Evolution of the Moon (hd video) (6982281547).jpg",
        "credit": "NASA Goddard Space Flight Center from Greenbelt, MD, USA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Evolution_of_the_Moon_(hd_video)_(6982281547).jpg"
      },
      "shots": [
        {
          "start": 17.333,
          "end": 25.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.127,
      "end": 28.347,
      "text": "But Theia did not vanish entirely into space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Structure planetes telliuriques.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Structure_planetes_telliuriques.jpg"
      },
      "shots": [
        {
          "start": 25.133,
          "end": 28.333,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 28.347,
      "end": 35.392,
      "text": "Two massive iron-rich anomalies sit eighteen hundred miles deep beneath Africa and the Pacific Ocean.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 28.333,
          "end": 35.4,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 35.392,
      "end": 41.217,
      "text": "Scientists identify these dense structures as the ancient mantle relics of Theia.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Structure planetes telliuriques.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Structure_planetes_telliuriques.jpg"
      },
      "shots": [
        {
          "start": 35.4,
          "end": 41.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 41.217,
      "end": 46.267,
      "text": "Two continent-sized blobs of that ancient world are still buried deep inside Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Africa and Europe from a Million Miles Away.png",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Africa_and_Europe_from_a_Million_Miles_Away.png"
      },
      "shots": [
        {
          "start": 41.233,
          "end": 46.633,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
