{
  "id": "ep515",
  "duration": 30.545,
  "beats": [
    {
      "start": 0.08,
      "end": 3.52,
      "text": "A NASA spacecraft cut its engines 40 meters above Mars.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mars Polar Lander parachute descent illustration.jpg",
        "credit": "NASA/JPL/Corby Waste",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Mars_Polar_Lander_parachute_descent_illustration.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 1.267,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 1.267,
          "end": 3.533,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.52,
      "end": 7.06,
      "text": "Mars Polar Lander carried the first microphone meant to record another planet.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "98lander-top2.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:98lander-top2.jpg"
      },
      "shots": [
        {
          "start": 3.533,
          "end": 7.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.06,
      "end": 10.62,
      "text": "To cut mission costs, managers opted to send zero landing telemetry.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 7.067,
          "end": 10.633,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.62,
      "end": 15.06,
      "text": "On atmospheric entry, heat shield temperatures topped 1,650 degrees Celsius.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 10.633,
          "end": 15.067,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.06,
      "end": 18.2,
      "text": "During descent, the lander snapped its landing legs into position.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mars Polar Lander - cruise configuration.png",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Mars_Polar_Lander_-_cruise_configuration.png"
      },
      "shots": [
        {
          "start": 15.067,
          "end": 18.2,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.2,
      "end": 21.64,
      "text": "That sudden mechanical leg vibration triggered a false sensor signal.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mars Polar Lander - artist depiction.png",
        "credit": "NASA / JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Mars_Polar_Lander_-_artist_depiction.png"
      },
      "shots": [
        {
          "start": 18.2,
          "end": 21.633,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.64,
      "end": 24.62,
      "text": "Flight software latched the fake pulse as an actual surface touchdown.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mars Polar Lander - artist depiction.png",
        "credit": "NASA / JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Mars_Polar_Lander_-_artist_depiction.png"
      },
      "shots": [
        {
          "start": 21.633,
          "end": 24.633,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.62,
      "end": 30.195,
      "text": "The $165 million probe free-fell to its destruction in total silence.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mars Polar Lander parachute descent illustration.jpg",
        "credit": "NASA/JPL/Corby Waste",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Mars_Polar_Lander_parachute_descent_illustration.jpg"
      },
      "shots": [
        {
          "start": 24.633,
          "end": 30.533,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
