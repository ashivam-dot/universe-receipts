{
  "id": "ep397",
  "duration": 26.046,
  "beats": [
    {
      "start": 0.08,
      "end": 2.66,
      "text": "You cannot see the most common star in the sky.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Red dwarf star CHXR 73 and companion object (artist's concept).tif",
        "credit": "NASA, ESA and G. Bacon",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Red_dwarf_star_CHXR_73_and_companion_object_(artist%27s_concept).tif"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.667,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 2.66,
      "end": 5.88,
      "text": "These dim embers make up 80 percent of our galaxy.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 2.667,
          "end": 5.867,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 5.88,
      "end": 9.0,
      "text": "Even our closest neighbor, Proxima Centauri, is hidden in the dark.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "New shot of Proxima Centauri, our nearest neighbour.jpg",
        "credit": "ESA/Hubble & NASA",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:New_shot_of_Proxima_Centauri,_our_nearest_neighbour.jpg"
      },
      "shots": [
        {
          "start": 5.867,
          "end": 9.0,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.0,
      "end": 13.52,
      "text": "These are red dwarfs, small stars that act like cosmic marathon runners.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Comparison between the Sun and the ultracool dwarf star TRAPPIST-1.jpg",
        "credit": "ESO",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Comparison_between_the_Sun_and_the_ultracool_dwarf_star_TRAPPIST-1.jpg"
      },
      "shots": [
        {
          "start": 9.0,
          "end": 11.267,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 11.267,
          "end": 13.533,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.52,
      "end": 17.82,
      "text": "While our Sun is a rare giant, these stars burn for trillions of years.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "AU MIc M-dwarf artist's conception.jpg",
        "credit": "NASA's Goddard Space Flight Center. Chris Smith (USRA): Lead Producer",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:AU_MIc_M-dwarf_artist%27s_conception.jpg"
      },
      "shots": [
        {
          "start": 13.533,
          "end": 17.833,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.82,
      "end": 20.62,
      "text": "In fact, not a single one has ever died yet.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Red Dwarf Flare Star (Artist's Illustration) (2018-46-4241).png",
        "credit": "NASA, ESA, and D. Player (STScI)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Red_Dwarf_Flare_Star_(Artist%27s_Illustration)_(2018-46-4241).png"
      },
      "shots": [
        {
          "start": 17.833,
          "end": 19.733,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 19.733,
          "end": 20.633,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.62,
      "end": 23.0,
      "text": "The universe is simply too young for them to burn out.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "CMB universe expansion.png",
        "credit": "NASA/WMAP Science Team/ Art by Dana Berry",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:CMB_universe_expansion.png"
      },
      "shots": [
        {
          "start": 20.633,
          "end": 23.0,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.0,
      "end": 25.696,
      "text": "They are the ultimate survivors you will never see.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Red dwarf star CHXR 73 and companion object (artist's concept).tif",
        "credit": "NASA, ESA and G. Bacon",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Red_dwarf_star_CHXR_73_and_companion_object_(artist%27s_concept).tif"
      },
      "shots": [
        {
          "start": 23.0,
          "end": 26.033,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
