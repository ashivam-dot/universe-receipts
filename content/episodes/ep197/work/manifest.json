{
  "id": "ep197",
  "duration": 53.519,
  "beats": [
    {
      "start": 0.08,
      "end": 3.925,
      "text": "A single day on Mercury outlasts two of its entire years.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "False Color View of Mercury (8497942353).png",
        "credit": "NASA Goddard Space Flight Center from Greenbelt, MD, USA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:False_Color_View_of_Mercury_(8497942353).png"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.925,
      "end": 11.395,
      "text": "Astronomers long believed the planet was tidally locked, matching an 88-day orbit with an 88-day spin.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mercury - MESSENGER (30012322436).png",
        "credit": "Justin Cowart",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Mercury_-_MESSENGER_(30012322436).png"
      },
      "shots": [
        {
          "start": 3.933,
          "end": 11.4,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.395,
      "end": 18.29,
      "text": "Under that permanent lock, one roasted hemisphere reached extreme temperatures exceeding 700 Kelvin.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NASA's MESSENGER Finds New Evidence for Water Ice at Mercury's Poles (8230852190).jpg",
        "credit": "NASA Goddard Space Flight Center from Greenbelt, MD, USA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:NASA%27s_MESSENGER_Finds_New_Evidence_for_Water_Ice_at_Mercury%27s_Poles_(8230852190).jpg"
      },
      "shots": [
        {
          "start": 11.4,
          "end": 16.067,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 16.067,
          "end": 18.3,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.29,
      "end": 25.685,
      "text": "In 1965, scientists bounced radar beams off Mercury to measure its actual spin rate from Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Arecibo Observatory Black and White.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Arecibo_Observatory_Black_and_White.jpg"
      },
      "shots": [
        {
          "start": 18.3,
          "end": 25.7,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.685,
      "end": 34.455,
      "text": "Italian celestial mechanics specialist Giuseppe Colombo proposed the planet actually rotates once every 59 Earth days.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 25.7,
          "end": 34.467,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 34.455,
      "end": 41.355,
      "text": "Mercury is not locked 1-to-1, but instead rotates three times for every two orbits around the Sun.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Unmasking the Secrets of Mercury.jpg",
        "credit": "NASA/Johns Hopkins University Applied Physics Laboratory/Carnegie Institution of Washington",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Unmasking_the_Secrets_of_Mercury.jpg"
      },
      "shots": [
        {
          "start": 34.467,
          "end": 38.0,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 38.0,
          "end": 41.367,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 41.355,
      "end": 49.705,
      "text": "Because orbital motion combines with that spin, a single solar day lasts approximately 176 Earth days.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "MESSENGER mosaic of the Caloris basin.png",
        "credit": "NASA/Johns Hopkins University Applied Physics Laboratory/Carnegie Institution of Washington",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:MESSENGER_mosaic_of_the_Caloris_basin.png"
      },
      "shots": [
        {
          "start": 41.367,
          "end": 47.0,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 47.0,
          "end": 49.7,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 49.705,
      "end": 53.169,
      "text": "Every morning there takes two full planetary years to arrive.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "False Color View of Mercury (8497942353).png",
        "credit": "NASA Goddard Space Flight Center from Greenbelt, MD, USA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:False_Color_View_of_Mercury_(8497942353).png"
      },
      "shots": [
        {
          "start": 49.7,
          "end": 53.533,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
