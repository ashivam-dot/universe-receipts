  "beats": [
    {
      "start": 0.15,
      "end": 5.922,
      "text": "Astronomers mailed physical hard drives to photograph our galaxy's terrifying center.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "EHT Saggitarius A black hole.tif",
        "credit": "EHT Collaboration",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:EHT_Saggitarius_A_black_hole.tif"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.3,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 2.3,
          "end": 5.933,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 5.922,
      "end": 13.192,
      "text": "Discovered in 1974, Sagittarius A* is a supermassive black hole at our galactic center.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Sagittarius A (Chandra).jpg",
        "credit": "Credit: NASA/CXC/MIT/F.K.Baganoff et al.",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Sagittarius_A_(Chandra).jpg"
      },
      "shots": [
        {
          "start": 5.933,
          "end": 13.2,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.192,
      "end": 18.562,
      "text": "It has a mass about four million times our Sun, hidden behind thick cosmic dust.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Galactic Center in Near-infrared (Hubble) (2021-053-01FJHRD1AK27XBK157T4N7DGM4).png",
        "credit": "SCIENCE: NASA, ESA, STScI, Q.D. Wang (UMass)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Galactic_Center_in_Near-infrared_(Hubble)_(2021-053-01FJHRD1AK27XBK157T4N7DGM4).png"
      },
      "shots": [
        {
          "start": 13.2,
          "end": 15.867,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 15.867,
          "end": 18.567,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.562,
      "end": 24.882,
      "text": "About 350 years ago, this quiet beast released a million times more energy than today.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Scenario for Mysterious Light Beams from Active Galaxy (2020-58-4781).tif",
        "credit": ", , and Z. Levy ()",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Scenario_for_Mysterious_Light_Beams_from_Active_Galaxy_(2020-58-4781).tif"
      },
      "shots": [
        {
          "start": 18.567,
          "end": 21.733,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 21.733,
          "end": 24.867,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.882,
      "end": 31.377,
      "text": "In 2017, the global Event Horizon Telescope captured the glowing ring around its shadow.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "ALMA antennas (uhd beletsky alma 07).tiff",
        "credit": "ESO/Y. Beletsky",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:ALMA_antennas_(uhd_beletsky_alma_07).tiff"
      },
      "shots": [
        {
          "start": 24.867,
          "end": 29.233,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 29.233,
          "end": 31.367,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 31.377,
      "end": 36.772,
      "text": "But gas orbits this small target so fast that its appearance changed in mere minutes.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NASA Black Hole Visualization Takes Viewers Beyond the Brink (SVS14576 - FlyBy Mollweide Still 01830).jpg",
        "credit": "NASA's Scientific Visualization Studio - null",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:NASA_Black_Hole_Visualization_Takes_Viewers_Beyond_the_Brink_(SVS14576_-_FlyBy_Mollweide_Still_01830).jpg"
      },
      "shots": [
        {
          "start": 31.367,
          "end": 34.067,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 34.067,
          "end": 36.767,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 36.772,
      "end": 42.447,
      "text": "The resulting flood of scientific data was too massive to send over the internet.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 36.767,
          "end": 42.433,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 42.447,
      "end": 49.467,
      "text": "Instead, five years of complex processing finally revealed the direct image in May 2022.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Sagittarius A* in Different Light (Sagittarius Support Event Horizon Telescope).tiff",
        "credit": "X-ray: NASA/CXC/SAO; IR: NASA/HST/STScI. Inset: Radio (EHT Collaboration)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Sagittarius_A*_in_Different_Light_(Sagittarius_Support_Event_Horizon_Telescope).tiff"
      },
      "shots": [
        {
          "start": 42.433,
          "end": 45.933,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 45.933,
          "end": 49.467,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 49.467,
      "end": 54.815,
      "text": "No network on Earth could easily transmit the secrets of our galaxy's lurking beast.",
      "asset": {
        "source": "Wikimedia Commons",
