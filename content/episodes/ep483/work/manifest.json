  "beats": [
    {
      "start": 0.08,
      "end": 3.54,
      "text": "If Betelgeuse exploded today, it would cast shadows at night.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Digitized Sky Survey Image of Betelgeuse.jpg",
        "credit": "ESO/Digitized Sky Survey 2. Acknowledgment: Davide De Martin.",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Digitized_Sky_Survey_Image_of_Betelgeuse.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.533,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.54,
      "end": 7.06,
      "text": "The monster star suddenly began to fade rapidly in late 2019.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Betelgeuse\u2019s surface before and during its 2019\u20132020 Great Dimming (eso2109a).jpg",
        "credit": "ESO/M. Montarg\u00e8s et al.",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Betelgeuse%E2%80%99s_surface_before_and_during_its_2019%E2%80%932020_Great_Dimming_(eso2109a).jpg"
      },
      "shots": [
        {
          "start": 3.533,
          "end": 7.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.06,
      "end": 10.18,
      "text": "It plunged from top ten brightest down past top twenty.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Orion tjt.jpg",
        "credit": "TheStarmon",
        "license": "CC BY 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:Orion_tjt.jpg"
      },
      "shots": [
        {
          "start": 7.067,
          "end": 10.167,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.18,
      "end": 14.1,
      "text": "Astronomers panicked because this supergiant swallows the orbit of Mars.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Betelgeuse Plume eso0927d.jpg",
        "credit": "ESO/L. Cal\u00e7ada",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Betelgeuse_Plume_eso0927d.jpg"
      },
      "shots": [
        {
          "start": 10.167,
          "end": 14.1,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.1,
      "end": 17.4,
      "text": "Many feared its fatal blast was happening hundreds of years early.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Disruption of the Red Supergiant Star Betelgeuse (2022-037).tiff",
        "credit": "ILLUSTRATION: NASA, ESA, Elizabeth Wheatley (STScI)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Disruption_of_the_Red_Supergiant_Star_Betelgeuse_(2022-037).tiff"
      },
      "shots": [
        {
          "start": 14.1,
          "end": 15.733,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 15.733,
          "end": 17.4,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.4,
      "end": 20.86,
      "text": "Hubble found the star burped a massive gas cloud that cooled into dust.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hubble and ALMA image of MACS J1149 5+2223 (eso1815a).tiff",
        "credit": "ALMA (ESO/NAOJ/NRAO), NASA/ESA Hubble Space Telescope, W. Zheng (JHU), M. Postman (STScI), the CLASH Team, Hashimoto et al.",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Hubble_and_ALMA_image_of_MACS_J1149_5%2B2223_(eso1815a).tiff"
      },
      "shots": [
        {
          "start": 17.4,
          "end": 20.867,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.86,
      "end": 24.28,
      "text": "When it really detonates, Earth will stay completely unharmed.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA13478 - Giant Star Goes Supernova, Smothered by its own Dust.tif",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA13478_-_Giant_Star_Goes_Supernova,_Smothered_by_its_own_Dust.tif"
      },
      "shots": [
        {
          "start": 20.867,
          "end": 24.267,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.28,
      "end": 26.962,
      "text": "Orion hides the star that will cast shadows at night.",
