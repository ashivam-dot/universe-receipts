{
  "id": "ep403",
  "duration": 25.072,
  "beats": [
    {
      "start": 0.08,
      "end": 2.56,
      "text": "A dwarf planet is spinning into a football shape.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Haumea with rings (37641832331).jpg",
        "credit": "Kevin Gill from Los Angeles, CA, United States",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Haumea_with_rings_(37641832331).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.567,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 2.56,
      "end": 6.14,
      "text": "While Earth takes 24 hours to rotate, big Jupiter takes 10.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Kepler-51 planetary system.jpg",
        "credit": "21.Andromedae",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Kepler-51_planetary_system.jpg"
      },
      "shots": [
        {
          "start": 2.567,
          "end": 5.033,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 5.033,
          "end": 6.133,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.14,
      "end": 9.5,
      "text": "But the frozen world Haumea completes a day in under 4 hours.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Haumea - NASA 2015 What is a dwarf planet?.jpg",
        "credit": "JPL/NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Haumea_-_NASA_2015_What_is_a_dwarf_planet%3F.jpg"
      },
      "shots": [
        {
          "start": 6.133,
          "end": 9.5,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.5,
      "end": 11.98,
      "text": "That is one of the fastest spins in the solar system.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Graph of Planetary Mass Versus Distance From the Sun.png",
        "credit": "Emily Lakdawalla for The Planetary Society using image data from NASA/JPL-Caltech/SSI/SwRI/CIW/ISRO/Daniel Chang, processed by Bj\u00f6rn J\u00f3nsson, Emily Lakdawalla, Daniel Mach\u00e1\u010dek, Mattias Malmer, Alex Pa",
        "license": "CC BY 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:Graph_of_Planetary_Mass_Versus_Distance_From_the_Sun.png"
      },
      "shots": [
        {
          "start": 9.5,
          "end": 11.967,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.98,
      "end": 15.7,
      "text": "Centrifugal force has stretched its rock and ice into a lopsided egg.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Graph of Planetary Mass Versus Distance From the Sun.png",
        "credit": "Emily Lakdawalla for The Planetary Society using image data from NASA/JPL-Caltech/SSI/SwRI/CIW/ISRO/Daniel Chang, processed by Bj\u00f6rn J\u00f3nsson, Emily Lakdawalla, Daniel Mach\u00e1\u010dek, Mattias Malmer, Alex Pa",
        "license": "CC BY 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:Graph_of_Planetary_Mass_Versus_Distance_From_the_Sun.png"
      },
      "shots": [
        {
          "start": 11.967,
          "end": 15.7,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.7,
      "end": 18.84,
      "text": "Astronomers found something even more bizarre near the object in 2017.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Charon's occultation on July 11, 2005 (eso0602c).jpg",
        "credit": "ESO",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Charon%27s_occultation_on_July_11,_2005_(eso0602c).jpg"
      },
      "shots": [
        {
          "start": 15.7,
          "end": 18.833,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.84,
      "end": 21.78,
      "text": "Haumea is the first of its kind found with its own ring system.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Rings of Quaoar (Portrait 3Rings).jpg",
        "credit": "Alexandre Crispim/UTFPR",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Rings_of_Quaoar_(Portrait_3Rings).jpg"
      },
      "shots": [
        {
          "start": 18.833,
          "end": 21.767,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.78,
      "end": 24.722,
      "text": "It really is a dwarf planet spinning into a football shape.",
      "asset": {
