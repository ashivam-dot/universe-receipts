    },
    {
      "start": 44.74,
      "end": 50.04,
      "text": "The empty spacecraft completed 2,570 orbits before burning up in Earth's atmosphere.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Posta Romana - 1959 - Laika 120 B.jpg",
        "credit": "Colectivul Dumitrana",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Posta_Romana_-_1959_-_Laika_120_B.jpg"
      },
      "shots": [
        {
          "start": 44.733,
          "end": 50.033,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 50.04,
      "end": 53.881,
      "text": "For forty-five years, the world believed a carefully scripted myth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Laika in 1957.jpg",
        "credit": "\u041c\u0443\u0437\u0435\u0439 \u043a\u043e\u0441\u043c\u043e\u043d\u0430\u0432\u0442\u0438\u043a\u0438 / \u0413\u043b\u0430\u0432\u0430\u0440\u0445\u0438\u0432 \u041c\u043e\u0441\u043a\u0432\u044b",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Laika_in_1957.jpg"
      },
