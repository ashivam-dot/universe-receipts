    },
    {
      "start": 35.78,
      "end": 40.3,
      "text": "In 2002, mission scientist Dimitri Malashenkov finally revealed the truth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Moscow, monument to the conquerors of space (5193458657).jpg",
        "credit": "Sylvain Kalache from San Francisco, USA",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Moscow,_monument_to_the_conquerors_of_space_(5193458657).jpg"
      },
      "shots": [
        {
          "start": 35.767,
          "end": 40.3,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 40.3,
      "end": 44.74,
      "text": "Thermal control failed, and Laika died from overheating and stress within seven hours.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "\u0421\u043f\u0443\u0442\u043d\u0438\u043a-2 \u043d\u0430 \u0438\u0441\u043f\u044b\u0442\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u043c \u043f\u043e\u043b\u0438\u0433\u043e\u043d\u0435 \u041a\u0430\u043f\u0443\u0441\u0442\u0438\u043d \u042f\u0440.jpg",
        "credit": "Ministry of Defence of the Russian Federation",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:%D0%A1%D0%BF%D1%83%D1%82%D0%BD%D0%B8%D0%BA-2_%D0%BD%D0%B0_%D0%B8%D1%81%D0%BF%D1%8B%D1%82%D0%B0%D1%82%D0%B5%D0%BB%D1%8C%D0%BD%D0%BE%D0%BC_%D0%BF%D0%BE%D0%BB%D0%B8%D0%B3%D0%BE%D0%BD%D0%B5_%D0%9A%D0%B0%D0%BF%D1%83%D1%81%D1%82%D0%B8%D0%BD_%D0%AF%D1%80.jpg"
      },
      "shots": [
