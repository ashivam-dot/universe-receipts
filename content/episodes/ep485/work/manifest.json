{
  "id": "ep485",
  "duration": 33.288,
  "beats": [
    {
      "start": 0.08,
      "end": 3.28,
      "text": "Saturn has an icy moon shaped like a sponge.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hyperion - September 2005 (16174518896).jpg",
        "credit": "Kevin M. Gill",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Hyperion_-_September_2005_(16174518896).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 1.633,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 1.633,
          "end": 3.267,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.28,
      "end": 7.24,
      "text": "When Cassini arrived in 2005, its craters looked wrong.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Cassini Saturn Orbit Insertion.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Cassini_Saturn_Orbit_Insertion.jpg"
      },
      "shots": [
        {
          "start": 3.267,
          "end": 6.033,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 6.033,
          "end": 7.233,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.24,
      "end": 11.28,
      "text": "Normal impacts blast debris everywhere, but this moon has almost none.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hyperion true.jpg",
        "credit": "NASA / JPL / SSI / Gordan Ugarkovic",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Hyperion_true.jpg"
      },
      "shots": [
        {
          "start": 7.233,
          "end": 11.267,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.28,
      "end": 15.2,
      "text": "The secret: roughly forty percent of Hyperion is empty space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hyperion - 2015-05-30 (18398702135).jpg",
        "credit": "Justin Cowart",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Hyperion_-_2015-05-30_(18398702135).jpg"
      },
      "shots": [
        {
          "start": 11.267,
          "end": 15.2,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.2,
      "end": 18.2,
      "text": "Because it's porous ice, meteors don't blast debris outward.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Bond-Lassell Dorsum on Hyperion.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Bond-Lassell_Dorsum_on_Hyperion.jpg"
      },
      "shots": [
        {
          "start": 15.2,
          "end": 18.2,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.2,
      "end": 21.94,
      "text": "They punch directly inward, compressing the ice like foam.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mendelssohn crater EW0231567383G TwoTerrains.map.jpg",
        "credit": "NASA/Johns Hopkins University Applied Physics Laboratory/Carnegie Institution of Washington",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Mendelssohn_crater_EW0231567383G_TwoTerrains.map.jpg"
      },
      "shots": [
        {
          "start": 18.2,
          "end": 21.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.94,
      "end": 25.8,
      "text": "Gravity from giant Titan also forces the moon into a chaotic tumble.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Titan in front of the ring and Saturn.jpg",
        "credit": "Produced By: Cassini Imaging Team,  Image Credit: NASA/JPL-Caltech/Space Science Institute",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Titan_in_front_of_the_ring_and_Saturn.jpg"
      },
      "shots": [
        {
          "start": 21.933,
          "end": 25.8,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.8,
      "end": 28.58,
      "text": "Its axis wobbles in a spin that's completely unpredictable.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Lunas.jpg",
        "credit": "Originally uploaded from NASA by Bricktop; edited by Deuar, KFP, TotoBaggins, Y\u00e1ser",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Lunas.jpg"
      },
      "shots": [
        {
          "start": 25.8,
          "end": 28.567,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 28.58,
      "end": 32.938,
      "text": "That unpredictable spin is unique to this giant cosmic sponge.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hyperion - September 2005 (16174518896).jpg",
        "credit": "Kevin M. Gill",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Hyperion_-_September_2005_(16174518896).jpg"
      },
      "shots": [
        {
          "start": 28.567,
          "end": 33.3,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
