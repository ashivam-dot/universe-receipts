{
  "id": "ep485",
  "duration": 34.675,
  "beats": [
    {
      "start": 0.08,
      "end": 2.96,
      "text": "Saturn has an icy moon shaped like a sponge.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hyperion - September 2005 (16174518896).jpg",
        "credit": "Kevin M. Gill",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Hyperion_-_September_2005_(16174518896).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 1.467,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 1.467,
          "end": 2.967,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 2.96,
      "end": 7.86,
      "text": "When NASA's Cassini spacecraft arrived in 2005, its craters made no sense.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Cassini Saturn Orbit Insertion.tif",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Cassini_Saturn_Orbit_Insertion.tif"
      },
      "shots": [
        {
          "start": 2.967,
          "end": 5.4,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 5.4,
          "end": 7.867,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.86,
      "end": 11.96,
      "text": "Normal impacts blast debris everywhere, but Hyperion had almost none.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Bond-Lassell Dorsum on Hyperion.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Bond-Lassell_Dorsum_on_Hyperion.jpg"
      },
      "shots": [
        {
          "start": 7.867,
          "end": 11.967,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.96,
      "end": 15.88,
      "text": "The answer is that forty percent of Hyperion is empty space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hyperion - 2015-05-30 (18398702135).jpg",
        "credit": "Justin Cowart",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Hyperion_-_2015-05-30_(18398702135).jpg"
      },
      "shots": [
        {
          "start": 11.967,
          "end": 15.867,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.88,
      "end": 19.1,
      "text": "Because it's porous water ice, meteors don't blast rock outward.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hyperion surface.jpg",
        "credit": "NASA/JPL/Space Science Institute",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Hyperion_surface.jpg"
      },
      "shots": [
        {
          "start": 15.867,
          "end": 19.1,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.1,
      "end": 22.66,
      "text": "They punch directly inward, compressing the ice like foam.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Bench crater AS12-49-7223-7225-7227.jpg",
        "credit": "James Stuby based on NASA images",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Bench_crater_AS12-49-7223-7225-7227.jpg"
      },
      "shots": [
        {
          "start": 19.1,
          "end": 22.667,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.66,
      "end": 27.28,
      "text": "Gravitational tugs from giant Titan also keep Hyperion tumbling chaotically.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Titan and Saturn - May 21 2011 (30456989021).jpg",
        "credit": "Kevin Gill from Los Angeles, CA, United States",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Titan_and_Saturn_-_May_21_2011_(30456989021).jpg"
      },
      "shots": [
        {
          "start": 22.667,
          "end": 25.833,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 25.833,
          "end": 27.267,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 27.28,
      "end": 30.8,
      "text": "Its spin wobbles through space in completely unpredictable directions.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hyperion Augoust 25 2011.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Hyperion_Augoust_25_2011.jpg"
      },
      "shots": [
        {
          "start": 27.267,
          "end": 30.8,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 30.8,
      "end": 34.325,
      "text": "That wild tumble belongs to Saturn's strangest frozen world.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hyperion - September 2005 (16174518896).jpg",
        "credit": "Kevin M. Gill",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Hyperion_-_September_2005_(16174518896).jpg"
      },
      "shots": [
        {
          "start": 30.8,
          "end": 34.667,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
