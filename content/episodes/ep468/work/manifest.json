{
  "id": "ep468",
  "duration": 27.626,
  "beats": [
    {
      "start": 0.08,
      "end": 2.42,
      "text": "The North Star is not the brightest star you see.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Star trails, First Place (ann21047m).tiff",
        "credit": "Fabrizio Melandri/IAU OAE",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Star_trails,_First_Place_(ann21047m).tiff"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 2.42,
      "end": 4.82,
      "text": "It actually ranks around forty-eighth in the night sky.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Bookofstarsbeing00coll 0047 cropped white balanced.png",
        "credit": "Collins, A. Frederick (Archie Frederick)",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Bookofstarsbeing00coll_0047_cropped_white_balanced.png"
      },
      "shots": [
        {
          "start": 2.433,
          "end": 4.833,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.82,
      "end": 7.42,
      "text": "We only follow it because it stands virtually still.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "AxialTiltObliquity.png",
        "credit": "Dna-webmaster",
        "license": "CC BY 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:AxialTiltObliquity.png"
      },
      "shots": [
        {
          "start": 4.833,
          "end": 7.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.42,
      "end": 11.98,
      "text": "But in 1779, William Herschel spotted a strange companion nearby.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "William Herschel01.jpg",
        "credit": "Lemuel Francis Abbott",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:William_Herschel01.jpg"
      },
      "shots": [
        {
          "start": 7.433,
          "end": 10.367,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 10.367,
          "end": 11.967,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.98,
      "end": 15.54,
      "text": "Centuries later, Hubble found another one hiding even closer.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Polaris A and Polaris B (opo0602c).jpg",
        "credit": "NASA, ESA, N. Evans (Harvard-Smithsonian CfA), and H. Bond (STScI)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Polaris_A_and_Polaris_B_(opo0602c).jpg"
      },
      "shots": [
        {
          "start": 11.967,
          "end": 15.533,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.54,
      "end": 18.14,
      "text": "Polaris is actually a triple star system.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Polaris system.jpg",
        "credit": "NASA/ESA/HST, G. Bacon (STScI)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Polaris_system.jpg"
      },
      "shots": [
        {
          "start": 15.533,
          "end": 18.133,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.14,
      "end": 21.64,
      "text": "Its supergiant core is two thousand times brighter than our Sun.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The sizes of stars (eso1030c).tiff",
        "credit": "ESO/M. Kornmesser",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:The_sizes_of_stars_(eso1030c).tiff"
      },
      "shots": [
        {
          "start": 18.133,
          "end": 19.567,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 19.567,
          "end": 21.633,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.64,
      "end": 24.5,
      "text": "By the year 4000, the star Errai will replace it.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The elements of astronomy; a textbook (1919) (14781947122).jpg",
        "credit": "Internet Archive Book Images",
        "license": "No restrictions",
        "url": "https://commons.wikimedia.org/wiki/File:The_elements_of_astronomy;_a_textbook_(1919)_(14781947122).jpg"
      },
      "shots": [
        {
          "start": 21.633,
          "end": 24.5,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.5,
      "end": 27.276,
      "text": "Our current guide is much dimmer than most people think.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Star trails, First Place (ann21047m).tiff",
        "credit": "Fabrizio Melandri/IAU OAE",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Star_trails,_First_Place_(ann21047m).tiff"
      },
      "shots": [
        {
          "start": 24.5,
          "end": 27.633,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
