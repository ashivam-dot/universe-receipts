{
  "id": "ep414",
  "duration": 32.416,
  "beats": [
    {
      "start": 0.08,
      "end": 3.64,
      "text": "The largest structure ever built in space is being destroyed.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "S132E013182 - STS-132 - Flyaround view of ISS after undocking - DPLA - 3c80b2ffce281ca2e7b435524a065b7a.jpg",
        "credit": "National Aeronautics and Space Administration. Lyndon B. Johnson Space Center. 2/17/1973",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:S132E013182_-_STS-132_-_Flyaround_view_of_ISS_after_undocking_-_DPLA_-_3c80b2ffce281ca2e7b435524a065b7a.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 1.8,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 1.8,
          "end": 3.633,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.64,
      "end": 7.68,
      "text": "The International Space Station spans 109 meters, rivaling a football field.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "STS-110 Installation of S0 Truss.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:STS-110_Installation_of_S0_Truss.jpg"
      },
      "shots": [
        {
          "start": 3.633,
          "end": 5.667,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 5.667,
          "end": 7.667,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.68,
      "end": 11.48,
      "text": "Inside, its pressurized volume matches a Boeing 747 airliner.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Leroy Chiao inside Destiny space lab.jpg",
        "credit": "Unknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Leroy_Chiao_inside_Destiny_space_lab.jpg"
      },
      "shots": [
        {
          "start": 7.667,
          "end": 9.833,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 9.833,
          "end": 11.467,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.48,
      "end": 14.68,
      "text": "Fifteen nations partnered together to assemble it piece by piece.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "ISS Unity module.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:ISS_Unity_module.jpg"
      },
      "shots": [
        {
          "start": 11.467,
          "end": 13.067,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 13.067,
          "end": 14.667,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.68,
      "end": 18.26,
      "text": "Humans have lived aboard the station continuously since November 2000.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "ISS-01 Expedition 1 crew members pose with a model of their home.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:ISS-01_Expedition_1_crew_members_pose_with_a_model_of_their_home.jpg"
      },
      "shots": [
        {
          "start": 14.667,
          "end": 16.233,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 16.233,
          "end": 18.267,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.26,
      "end": 22.14,
      "text": "It orbits 250 miles high, circling Earth every 90 minutes.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Cupola ISS open shutters.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Cupola_ISS_open_shutters.jpg"
      },
      "shots": [
        {
          "start": 18.267,
          "end": 22.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.14,
      "end": 24.98,
      "text": "Yet NASA plans to end operations around 2030.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "ISS from the SpaceX Crew Dragon Endeavor during Flyaround (iss066e081130).jpg",
        "credit": "NASA Johnson Space Center / Thomas Pesquet",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:ISS_from_the_SpaceX_Crew_Dragon_Endeavor_during_Flyaround_(iss066e081130).jpg"
      },
      "shots": [
        {
          "start": 22.133,
          "end": 23.933,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 23.933,
          "end": 24.967,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.98,
      "end": 28.7,
      "text": "A dedicated deorbit craft will steer the massive complex into the ocean.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "ISS from the SpaceX Crew Dragon Endeavor during Flyaround (iss066e081130).jpg",
        "credit": "NASA Johnson Space Center / Thomas Pesquet",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:ISS_from_the_SpaceX_Crew_Dragon_Endeavor_during_Flyaround_(iss066e081130).jpg"
      },
      "shots": [
        {
          "start": 24.967,
          "end": 28.7,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 28.7,
      "end": 32.066,
      "text": "No human construction in orbit has ever matched it.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "S132E013182 - STS-132 - Flyaround view of ISS after undocking - DPLA - 3c80b2ffce281ca2e7b435524a065b7a.jpg",
        "credit": "National Aeronautics and Space Administration. Lyndon B. Johnson Space Center. 2/17/1973",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:S132E013182_-_STS-132_-_Flyaround_view_of_ISS_after_undocking_-_DPLA_-_3c80b2ffce281ca2e7b435524a065b7a.jpg"
      },
      "shots": [
        {
          "start": 28.7,
