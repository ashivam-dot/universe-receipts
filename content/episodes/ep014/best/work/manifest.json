{
  "id": "ep014",
  "duration": 55.747,
  "beats": [
    {
      "start": 0.08,
      "end": 6.174,
      "text": "NASA electroplated radioactive uranium onto a golden record heading into deep space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The Sounds of Earth Record Cover - GPN-2000-001978.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:The_Sounds_of_Earth_Record_Cover_-_GPN-2000-001978.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.2,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 2.2,
          "end": 6.167,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.174,
      "end": 13.219,
      "text": "In 1977, the twin Voyager probes launched toward interstellar space carrying human messages.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyager spacecraft.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Voyager_spacecraft.jpg"
      },
      "shots": [
        {
          "start": 6.167,
          "end": 8.833,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 8.833,
          "end": 13.233,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.219,
      "end": 19.714,
      "text": "Led by astronomer Carl Sagan, the team packed 55 languages and whale songs onto disks.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Carl Sagan (5547442771).jpg",
        "credit": "University of Mount Union",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Carl_Sagan_(5547442771).jpg"
      },
      "shots": [
        {
          "start": 13.233,
          "end": 19.7,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.714,
      "end": 25.509,
      "text": "Each record was sealed inside an aluminum cover featuring a map of 14 pulsars.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Pioneer plaque P10 Closeup.png",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Pioneer_plaque_P10_Closeup.png"
      },
      "shots": [
        {
          "start": 19.7,
          "end": 22.1,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 22.1,
          "end": 25.5,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.509,
      "end": 30.604,
      "text": "If an alien civilization intercepts a probe, how will they calculate its age?",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NASA\u2019s Voyager Probe Speeds Through Space (Artist\u2019s Concept) (PIA26353).tiff",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:NASA%E2%80%99s_Voyager_Probe_Speeds_Through_Space_(Artist%E2%80%99s_Concept)_(PIA26353).tiff"
      },
      "shots": [
        {
          "start": 25.5,
          "end": 30.6,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 30.604,
      "end": 37.099,
      "text": "This is why scientists placed a tiny, ultra-pure sample of uranium-238 on the cover.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyager-phonograph-record-5-10-1977 30217463364 o.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Voyager-phonograph-record-5-10-1977_30217463364_o.jpg"
      },
      "shots": [
        {
          "start": 30.6,
          "end": 34.467,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 34.467,
          "end": 37.1,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 37.099,
      "end": 43.594,
      "text": "Because this isotope decays with a half-life of about 4.5 billion years, it acts as a clock.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "\u5d29\u58ca\u7cfb\u5217\uff084n+3\u7cfb\u5217\u3001 \u30a2\u30af\u30c1\u30cb\u30a6\u30e0\u7cfb\u5217\uff09.png",
        "credit": "Tosaka",
        "license": "CC BY 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:%E5%B4%A9%E5%A3%8A%E7%B3%BB%E5%88%97%EF%BC%884n%2B3%E7%B3%BB%E5%88%97%E3%80%81_%E3%82%A2%E3%82%AF%E3%83%81%E3%83%8B%E3%82%A6%E3%83%A0%E7%B3%BB%E5%88%97%EF%BC%89.png"
      },
      "shots": [
        {
          "start": 37.1,
          "end": 43.6,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 43.594,
      "end": 50.369,
      "text": "Measuring remaining uranium and decay products reveals exactly when the spacecraft left Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The Earth seen from Apollo 17.jpg",
        "credit": "NASA/Apollo 17 crew; taken by either Harrison Schmitt or Ron Evans",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:The_Earth_seen_from_Apollo_17.jpg"
      },
      "shots": [
        {
          "start": 43.6,
          "end": 46.033,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 46.033,
          "end": 50.367,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 50.369,
      "end": 55.397,
      "text": "No matter how long it drifts, this silent atomic clock tells the exact age.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The Sounds of Earth Record Cover - GPN-2000-001978.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:The_Sounds_of_Earth_Record_Cover_-_GPN-2000-001978.jpg"
      },
      "shots": [
        {
          "start": 50.367,
          "end": 55.733,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
