{
  "id": "ep419",
  "duration": 29.199,
  "beats": [
    {
      "start": 0.08,
      "end": 2.82,
      "text": "Jupiter was once twice as wide as it is today.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA22690 - Jupiter in the Rearview Mirror.jpg",
        "credit": "NASA/JPL-Caltech/SwRI/MSSS",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA22690_-_Jupiter_in_the_Rearview_Mirror.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.833,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 2.82,
      "end": 6.26,
      "text": "That ancient monster could have swallowed 8,000 Earths.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Jupiter, Earth size comparison.jpg",
        "credit": "NASABrian0918 at English Wikipedia",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Jupiter,_Earth_size_comparison.jpg"
      },
      "shots": [
        {
          "start": 2.833,
          "end": 6.267,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.26,
      "end": 9.5,
      "text": "Even now, every other planet fits inside it twice over.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Graph of Planetary Mass Versus Distance From the Sun.png",
        "credit": "Emily Lakdawalla for The Planetary Society using image data from NASA/JPL-Caltech/SSI/SwRI/CIW/ISRO/Daniel Chang, processed by Bj\u00f6rn J\u00f3nsson, Emily Lakdawalla, Daniel Mach\u00e1\u010dek, Mattias Malmer, Alex Pa",
        "license": "CC BY 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:Graph_of_Planetary_Mass_Versus_Distance_From_the_Sun.png"
      },
      "shots": [
        {
          "start": 6.267,
          "end": 9.5,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.5,
      "end": 13.22,
      "text": "Its gravity was so strong it sculpted our entire solar system.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "ALMA image of the protoplanetary disc around V883 Orionis (annotated) (eso1626e).jpg",
        "credit": "ALMA (ESO/NAOJ/NRAO)/L. Cieza",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:ALMA_image_of_the_protoplanetary_disc_around_V883_Orionis_(annotated)_(eso1626e).jpg"
      },
      "shots": [
        {
          "start": 9.5,
          "end": 13.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.22,
      "end": 16.793,
      "text": "Jupiter rotates so fast a full day lasts ten hours.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Jupiter OPAL 2024 (2024-009).png",
        "credit": "Science Amy Simon (NASA-GSFC) Image NASA, ESA, Joseph DePasquale (STScI)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Jupiter_OPAL_2024_(2024-009).png"
      },
      "shots": [
        {
          "start": 13.233,
          "end": 16.8,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.793,
      "end": 19.62,
      "text": "This speed feeds a storm bigger than the Earth itself.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Jupiter - Great Red Spot - PJ7-60 61 62 - Balanced (49803032983).png",
        "credit": "Kevin Gill from Los Angeles, CA, United States",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Jupiter_-_Great_Red_Spot_-_PJ7-60_61_62_-_Balanced_(49803032983).png"
      },
      "shots": [
        {
          "start": 16.8,
          "end": 19.633,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.62,
      "end": 23.16,
      "text": "The volcanic moon Io is being stretched by that massive pull.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Io Volcanic Eruption Galileo.png",
        "credit": "NASA/JPL/DLR",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Io_Volcanic_Eruption_Galileo.png"
      },
      "shots": [
        {
          "start": 19.633,
          "end": 23.167,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.16,
      "end": 26.42,
      "text": "But modern Jupiter is just a remnant of that former self.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Child of Another Star (gemini-childofanotherstar).jpg",
        "credit": "International Gemini Observatory",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Child_of_Another_Star_(gemini-childofanotherstar).jpg"
      },
      "shots": [
        {
          "start": 23.167,
          "end": 26.433,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 26.42,
      "end": 28.849,
      "text": "The gas giant was once twice as wide.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA22690 - Jupiter in the Rearview Mirror.jpg",
        "credit": "NASA/JPL-Caltech/SwRI/MSSS",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA22690_-_Jupiter_in_the_Rearview_Mirror.jpg"
      },
      "shots": [
        {
          "start": 26.433,
          "end": 29.2,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    }
  ],
