  "duration": 27.035,
  "beats": [
    {
      "start": 0.08,
      "end": 3.92,
      "text": "A rosy meteorite holds altered crust from ancient Mars.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mars rock (Natural History Museum) (6446390751).jpg",
        "credit": "Gerry Smith",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Mars_rock_(Natural_History_Museum)_(6446390751).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.92,
      "end": 7.6,
      "text": "It weighed eight hundred grams after traveling through deep space.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 3.933,
          "end": 7.6,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.6,
      "end": 11.86,
      "text": "Zircon crystals inside dated the rock to four billion years.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Iziko Mineral Zircon (cropped).jpg",
        "credit": "Nkansah Rexford",
        "license": "CC BY 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:Iziko_Mineral_Zircon_(cropped).jpg"
      },
      "shots": [
        {
          "start": 7.6,
          "end": 11.867,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.86,
      "end": 15.34,
      "text": "Volcanic minerals were altered by liquid water on that planet.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Tithonium Chasma (52926058844).jpg",
        "credit": "UAHiRISE (NASA)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Tithonium_Chasma_(52926058844).jpg"
      },
      "shots": [
        {
          "start": 11.867,
          "end": 15.333,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.34,
      "end": 19.2,
      "text": "Scientists identified thirteen possible origin sites for the rock's journey.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "MRO using SHARAD.jpg",
        "credit": "NASA/JPL/Corby Waste",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:MRO_using_SHARAD.jpg"
      },
      "shots": [
        {
          "start": 15.333,
          "end": 19.2,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.2,
      "end": 22.68,
      "text": "A reviewer named this specimen a Rosetta Stone for Mars.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Slice of Martian Meteorite Teghaza 001 (PIA26801 figA).tiff",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Slice_of_Martian_Meteorite_Teghaza_001_(PIA26801_figA).tiff"
      },
      "shots": [
        {
          "start": 19.2,
          "end": 22.667,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.68,
      "end": 26.685,
      "text": "That ancient crust remains safely tucked inside our desert sands.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mars rock (Natural History Museum) (6446390751).jpg",
        "credit": "Gerry Smith",
        "license": "CC BY 2.0",
