{
  "id": "ep367",
  "duration": 27.433,
  "beats": [
    {
      "start": 0.08,
      "end": 3.3,
      "text": "Saturn has two moons locked in a constant orbital dance.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mimas (Mond) (7185488).jpg",
        "credit": "alan taylor from Hudson, MA, usa",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Mimas_(Mond)_(7185488).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.3,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.3,
      "end": 5.88,
      "text": "Their orbital paths differ by only 50 kilometers.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 3.3,
          "end": 5.867,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 5.88,
      "end": 8.44,
      "text": "That tiny gap should cause a violent collision.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Meteors Meet Saturn's Rings.jpg",
        "credit": "NASA/JPL-Caltech/Space Science Institute/Cornell",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Meteors_Meet_Saturn%27s_Rings.jpg"
      },
      "shots": [
        {
          "start": 5.867,
          "end": 8.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.44,
      "end": 11.96,
      "text": "Instead, as the inner moon catches up, gravity forces a swap.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Janus 2006 closeup by Cassinix2.jpg",
        "credit": "Janus_2006_closeup_by_Cassini.jpg: NASA (Cassini-Huygens mission)\nderivative work: WolfmanSF (talk)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Janus_2006_closeup_by_Cassinix2.jpg"
      },
      "shots": [
        {
          "start": 8.433,
          "end": 11.967,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.96,
      "end": 15.12,
      "text": "They pass between 10,000 and 15,000 kilometers apart.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Saturn 2019 June 20 (48106116216).png",
        "credit": "geckzilla",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Saturn_2019_June_20_(48106116216).png"
      },
      "shots": [
        {
          "start": 11.967,
          "end": 15.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.12,
      "end": 18.1,
      "text": "Every four years, they trade inner and outer positions.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA08361 Ring World.png",
        "credit": "NASA/JPL/Space Science Institute",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA08361_Ring_World.png"
      },
      "shots": [
        {
          "start": 15.133,
          "end": 18.1,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.1,
      "end": 21.72,
      "text": "Janus is four times more massive, shifting Epimetheus four times more.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Epimetheus Mosaic.png",
        "credit": "NASA/JPL-Caltech/Space Science Institute",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Epimetheus_Mosaic.png"
      },
      "shots": [
        {
          "start": 18.1,
          "end": 21.733,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.72,
      "end": 24.38,
      "text": "Voyager 1 confirmed this unique dance in 1980.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyager spacecraft.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Voyager_spacecraft.jpg"
      },
      "shots": [
        {
          "start": 21.733,
          "end": 24.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.38,
      "end": 27.083,
      "text": "Making this the solar system's only known orbital swap.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mimas (Mond) (7185488).jpg",
        "credit": "alan taylor from Hudson, MA, usa",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Mimas_(Mond)_(7185488).jpg"
      },
      "shots": [
        {
          "start": 24.367,
          "end": 27.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
