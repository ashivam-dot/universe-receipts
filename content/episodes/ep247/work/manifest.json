  "beats": [
    {
      "start": 0.08,
      "end": 4.823,
      "text": "A multi-ton NASA telescope pivots in seconds without human commands.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Swift Spacecraft Animations- 2025 (SVS14786 - SWIFT S1 v2 4k 60fps proRes 00005 print).jpg",
        "credit": "NASA's Scientific Visualization Studio - eMITS/Adriana Manrique Gutierrez, eMITS/Jonathan North, eMITS/Michael Lentz, eMITS/Scott Wiessinger, eMITS/Sophia Roberts, University of Maryland College Park/",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Swift_Spacecraft_Animations-_2025_(SVS14786_-_SWIFT_S1_v2_4k_60fps_proRes_00005_print).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.833,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.823,
      "end": 11.143,
      "text": "Most missions wait days for human planning, but Swift launched in 2004 to act alone.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Delta 7320-10C launching Swift.jpg",
        "credit": "NASA/KSC",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Delta_7320-10C_launching_Swift.jpg"
      },
      "shots": [
        {
          "start": 4.833,
          "end": 11.133,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.143,
      "end": 16.763,
      "text": "It carries three co-aligned instruments to catch gamma-ray flashes that last mere seconds.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "GRB 151027B in X-ray, UV and visible light.jpg",
        "credit": "NASA/Swift/Phil Evans, Univ. of Leicester",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:GRB_151027B_in_X-ray,_UV_and_visible_light.jpg"
      },
      "shots": [
        {
          "start": 11.133,
          "end": 13.933,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 13.933,
          "end": 16.767,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.763,
      "end": 22.558,
      "text": "The mission was named for the swift bird, which pivots mid-flight to rapidly change direction.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Common Swift 2025 07 18 02 (cropped).jpg",
        "credit": "Alexis Lours",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Common_Swift_2025_07_18_02_(cropped).jpg"
      },
      "shots": [
        {
          "start": 16.767,
          "end": 20.6,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 20.6,
          "end": 22.567,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.558,
      "end": 27.803,
      "text": "A mask of fifty-two thousand lead tiles calculates the coordinates of the blast.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 22.567,
          "end": 27.8,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 27.803,
      "end": 34.448,
      "text": "Within one hundred seconds, the spacecraft autonomously slews its entire body to focus its lens.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 27.8,
          "end": 34.433,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 34.448,
      "end": 41.773,
      "text": "This caught a dying star thirteen billion light-years away, when the universe was six hundred thirty million years old.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "337655main GRB090423 Swift.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:337655main_GRB090423_Swift.jpg"
      },
      "shots": [
        {
          "start": 34.433,
          "end": 41.767,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 41.773,
      "end": 47.029,
      "text": "Built for a two-year mission, the observatory spent two decades hunting these flashes.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Swift Spacecraft Animations- 2025 (SVS14786 - SWIFT S1 v2 4k 60fps proRes 00005 print).jpg",
        "credit": "NASA's Scientific Visualization Studio - eMITS/Adriana Manrique Gutierrez, eMITS/Jonathan North, eMITS/Michael Lentz, eMITS/Scott Wiessinger, eMITS/Sophia Roberts, University of Maryland College Park/",
