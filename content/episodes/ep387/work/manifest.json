{
  "id": "ep387",
  "duration": 29.654,
  "beats": [
    {
      "start": 0.08,
      "end": 3.58,
      "text": "A space probe ended a ten-year chase at walking speed.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Rosetta - comet fly-by.jpg",
        "credit": "DLR, CC-BY 3.0",
        "license": "CC BY 3.0 de",
        "url": "https://commons.wikimedia.org/wiki/File:Rosetta_-_comet_fly-by.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.567,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.58,
      "end": 7.14,
      "text": "The European Space Agency launched Rosetta on a billion-euro mission.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 3.567,
          "end": 7.133,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.14,
      "end": 9.94,
      "text": "It whipped past Earth and Mars to build deep-space speed.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mars - August 30 2021 - Flickr - Kevin M. Gill.png",
        "credit": "Kevin Gill from Los Angeles, CA, United States",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Mars_-_August_30_2021_-_Flickr_-_Kevin_M._Gill.png"
      },
      "shots": [
        {
          "start": 7.133,
          "end": 9.933,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.94,
      "end": 13.2,
      "text": "After ten years, it reached a bizarre duck-shaped comet.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "67P-C-G - March 28 2015 (32370930490).jpg",
        "credit": "ESA / MPS / OSIRIS Team / Kevin M. Gill",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:67P-C-G_-_March_28_2015_(32370930490).jpg"
      },
      "shots": [
        {
          "start": 9.933,
          "end": 13.2,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.2,
      "end": 16.2,
      "text": "Rosetta became the first spacecraft to orbit a comet nucleus.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Comet 67P-CHURYUMOV-GERASIMENKO - ESA Rosetta (53875967301).png",
        "credit": "Andrea Luck",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Comet_67P-CHURYUMOV-GERASIMENKO_-_ESA_Rosetta_(53875967301).png"
      },
      "shots": [
        {
          "start": 13.2,
          "end": 16.2,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.2,
      "end": 19.3,
      "text": "It dropped the lander Philae, which bounced against a cliff.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Philae over a comet.jpg",
        "credit": "DLR, CC-BY 3.0",
        "license": "CC BY 3.0 de",
        "url": "https://commons.wikimedia.org/wiki/File:Philae_over_a_comet.jpg"
      },
      "shots": [
        {
          "start": 16.2,
          "end": 19.3,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.3,
      "end": 22.54,
      "text": "As solar power faded, engineers guided the probe down.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "ESOC hosts CCSDS (22344681734).jpg",
        "credit": "ESA_events",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:ESOC_hosts_CCSDS_(22344681734).jpg"
      },
      "shots": [
        {
          "start": 19.3,
          "end": 22.533,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.54,
      "end": 25.52,
      "text": "Rosetta touched the comet surface at two miles per hour.",
      "asset": {
        "source": "Flickr via Openverse",
        "title": "Landing site in sight",
        "credit": "europeanspaceagency",
        "license": "CC BY 2.0",
        "url": "https://www.flickr.com/photos/37472264@N04/48819324213"
      },
      "shots": [
        {
          "start": 22.533,
          "end": 25.533,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.52,
      "end": 29.304,
      "text": "That is how a space probe ended a ten-year chase at walking speed.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Rosetta - comet fly-by.jpg",
        "credit": "DLR, CC-BY 3.0",
        "license": "CC BY 3.0 de",
        "url": "https://commons.wikimedia.org/wiki/File:Rosetta_-_comet_fly-by.jpg"
      },
      "shots": [
        {
          "start": 25.533,
          "end": 29.667,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
