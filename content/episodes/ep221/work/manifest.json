{
  "id": "ep221",
  "duration": 51.266,
  "beats": [
    {
      "start": 0.08,
      "end": 4.684,
      "text": "Campus outcasts blew up a lab and built NASA's premier space center.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "P1-RocketBoys.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:P1-RocketBoys.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.7,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.684,
      "end": 11.129,
      "text": "In 1936, Frank Malina teamed up with rocketeers Jack Parsons and Edward Forman.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Frank Malina.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Frank_Malina.jpg"
      },
      "shots": [
        {
          "start": 4.7,
          "end": 11.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.129,
      "end": 16.874,
      "text": "Their motor tests caused explosions, earning the group the campus nickname Suicide Squad.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 11.133,
          "end": 16.867,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.874,
      "end": 22.619,
      "text": "After blasting through a wall, the squad was banished to a dry riverbed called Arroyo Seco.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "2010-1101-06-ColoradoStBridge.jpg",
        "credit": "Bobak Ha'Eri",
        "license": "CC BY 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:2010-1101-06-ColoradoStBridge.jpg"
      },
      "shots": [
        {
          "start": 16.867,
          "end": 20.0,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 20.0,
          "end": 22.633,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.619,
      "end": 31.339,
      "text": "Working outdoors, they built takeoff rockets for propeller aircraft, proposing the name Jet Propulsion Laboratory in 1943.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "JATO Flight Test Crew - GPN-2000-001537.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:JATO_Flight_Test_Crew_-_GPN-2000-001537.jpg"
      },
      "shots": [
        {
          "start": 22.633,
          "end": 28.1,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 28.1,
          "end": 31.333,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 31.339,
      "end": 39.984,
      "text": "In 1958, JPL launched America's first satellite, Explorer 1, before transferring to the newly created NASA.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Explorer I launched Jan. 31, 1958 (116-KSC-68P-17).jpg",
        "credit": "NASA Kennedy Space Center / NASA or National Aeronautics and Space Administration Archives",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Explorer_I_launched_Jan._31,_1958_(116-KSC-68P-17).jpg"
      },
      "shots": [
        {
          "start": 31.333,
          "end": 35.8,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 35.8,
          "end": 40.0,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 39.984,
      "end": 47.234,
      "text": "That former riverbed camp went on to manage Voyager 1, the first human craft in interstellar space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Voyager in space (PIA17049).jpg",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Voyager_in_space_(PIA17049).jpg"
      },
      "shots": [
        {
          "start": 40.0,
          "end": 47.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 47.234,
      "end": 50.916,
      "text": "America's space program began with a campus explosion.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "P1-RocketBoys.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:P1-RocketBoys.jpg"
      },
      "shots": [
        {
          "start": 47.233,
          "end": 51.267,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
