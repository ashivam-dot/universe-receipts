{
  "id": "ep441",
  "duration": 28.301,
  "beats": [
    {
      "start": 0.08,
      "end": 2.98,
      "text": "The upper clouds of Uranus smell like rotten eggs.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Uranus as seen by NASA's Voyager 2 (remastered) - JPEG converted.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Uranus_as_seen_by_NASA%27s_Voyager_2_(remastered)_-_JPEG_converted.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.967,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 2.98,
      "end": 6.24,
      "text": "Astronomers long assumed ammonia gas dominated the giant planet.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA01488 Uranus' Upper Atmosphere.jpg",
        "credit": "NASA/JPL/USGS",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA01488_Uranus%27_Upper_Atmosphere.jpg"
      },
      "shots": [
        {
          "start": 2.967,
          "end": 6.233,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.24,
      "end": 9.42,
      "text": "Even NASA's Voyager 2 flyby couldn't identify what was up there.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Uranus and Voyager (24660826102).png",
        "credit": "Kevin M. Gill",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Uranus_and_Voyager_(24660826102).png"
      },
      "shots": [
        {
          "start": 6.233,
          "end": 7.833,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 7.833,
          "end": 9.433,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.42,
      "end": 14.0,
      "text": "Then Hawaii's Gemini North telescope analyzed reflected sunlight off the clouds.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Canada France and Gemini North Telescope. Mauna Kea Summit (503952) (22031500202).jpg",
        "credit": "Robert Linsdell from St. Andrews, Canada",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Canada_France_and_Gemini_North_Telescope._Mauna_Kea_Summit_(503952)_(22031500202).jpg"
      },
      "shots": [
        {
          "start": 9.433,
          "end": 11.733,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 11.733,
          "end": 14.0,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.0,
      "end": 17.98,
      "text": "Instruments detected faint spectral lines of toxic hydrogen sulfide.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hydrogen-sulfide-3D-balls.png",
        "credit": "Ben Mills",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Hydrogen-sulfide-3D-balls.png"
      },
      "shots": [
        {
          "start": 14.0,
          "end": 17.967,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.98,
      "end": 21.92,
      "text": "Unlike Jupiter's ammonia clouds, Uranus formed cold enough to freeze sulfur.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA21776 - Jupiter Storms of the High North.jpg",
        "credit": "NASA/JPL-Caltech/SwRI/MSSS",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA21776_-_Jupiter_Storms_of_the_High_North.jpg"
      },
      "shots": [
        {
          "start": 17.967,
          "end": 19.933,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 19.933,
          "end": 21.933,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.92,
      "end": 24.94,
      "text": "In that minus 200 degree atmosphere, nobody could ever smell it.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Many Bright Clouds on Uranus (opo9835a).jpg",
        "credit": "Erich Karkoschka (University of Arizona) and NASA/ESA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Many_Bright_Clouds_on_Uranus_(opo9835a).jpg"
      },
      "shots": [
        {
          "start": 21.933,
          "end": 24.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.94,
      "end": 27.951,
      "text": "You'd freeze and suffocate long before catching a single whiff.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Uranus as seen by NASA's Voyager 2 (remastered) - JPEG converted.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Uranus_as_seen_by_NASA%27s_Voyager_2_(remastered)_-_JPEG_converted.jpg"
      },
      "shots": [
        {
          "start": 24.933,
          "end": 28.3,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
