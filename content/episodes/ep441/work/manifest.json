{
  "id": "ep441",
  "duration": 29.794,
  "beats": [
    {
      "start": 0.08,
      "end": 3.5,
      "text": "The upper clouds of Uranus smell like rotten eggs.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Uranus as seen by NASA's Voyager 2 (remastered) - JPEG converted.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Uranus_as_seen_by_NASA%27s_Voyager_2_(remastered)_-_JPEG_converted.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.5,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.5,
      "end": 7.14,
      "text": "Astronomers long assumed ammonia gas dominated the giant planet.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Uranus.jpg",
        "credit": "NASA/JPL",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Uranus.jpg"
      },
      "shots": [
        {
          "start": 3.5,
          "end": 7.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.14,
      "end": 9.98,
      "text": "Even NASA's Voyager 2 flyby couldn't identify what was up there.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Uranus and Voyager (24660826102).png",
        "credit": "Kevin M. Gill",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Uranus_and_Voyager_(24660826102).png"
      },
      "shots": [
        {
          "start": 7.133,
          "end": 8.533,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 8.533,
          "end": 9.967,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.98,
      "end": 14.22,
      "text": "Then Hawaii's Gemini North telescope analyzed sunlight reflected off the clouds.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Gemini North, Mauna Kea (noao-02253).jpg",
        "credit": "NOIRLab/NSF/AURA",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Gemini_North,_Mauna_Kea_(noao-02253).jpg"
      },
      "shots": [
        {
          "start": 9.967,
          "end": 12.1,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 12.1,
          "end": 14.233,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.22,
      "end": 18.7,
      "text": "Instruments detected faint spectral lines of toxic hydrogen sulfide.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hydrogen-sulfide-3D-balls.png",
        "credit": "Ben Mills",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Hydrogen-sulfide-3D-balls.png"
      },
      "shots": [
        {
          "start": 14.233,
          "end": 18.7,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.7,
      "end": 22.86,
      "text": "Unlike Jupiter's ammonia clouds, Uranus formed cold enough to freeze sulfur.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA21776 - Jupiter Storms of the High North.jpg",
        "credit": "NASA/JPL-Caltech/SwRI/MSSS",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA21776_-_Jupiter_Storms_of_the_High_North.jpg"
      },
      "shots": [
        {
          "start": 18.7,
          "end": 20.8,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 20.8,
          "end": 22.867,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.86,
      "end": 25.78,
      "text": "You'd freeze and suffocate instantly in that minus 200 degree atmosphere.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Uranus Hubble.jpg",
        "credit": "NASA/ESA and Erich Karkoschka, University of Arizona",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Uranus_Hubble.jpg"
      },
      "shots": [
        {
          "start": 22.867,
          "end": 24.333,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 24.333,
          "end": 25.767,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.78,
      "end": 29.444,
      "text": "But if you could breathe, the upper clouds smell like rotten eggs.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Uranus as seen by NASA's Voyager 2 (remastered) - JPEG converted.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Uranus_as_seen_by_NASA%27s_Voyager_2_(remastered)_-_JPEG_converted.jpg"
      },
      "shots": [
        {
          "start": 25.767,
          "end": 29.8,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
