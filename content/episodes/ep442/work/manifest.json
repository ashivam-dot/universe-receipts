        "source": "Wikimedia Commons",
        "title": "View of Plum crater photographed by Apollo 16 crew during EVA (as16-114-18422).jpg",
        "credit": "NASA Johnson Space Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:View_of_Plum_crater_photographed_by_Apollo_16_crew_during_EVA_(as16-114-18422).jpg"
      },
      "shots": [
        {
          "start": 5.7,
          "end": 7.867,
