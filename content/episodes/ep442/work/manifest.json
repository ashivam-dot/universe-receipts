          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.7,
      "end": 26.36,
      "text": "The alien dust gave every single astronaut lunar hay fever.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Astronaut Harrison Schmitt inside the lunar module on lunar surface after EVA (as17-134-20530).jpg",
        "credit": "NASA Johnson Space Center",
