          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.88,
      "end": 12.44,
      "text": "These razor-sharp particles actually levitate above the ground.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "View of Plum crater photographed by Apollo 16 crew during EVA (as16-114-18422).jpg",
        "credit": "NASA Johnson Space Center",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:View_of_Plum_crater_photographed_by_Apollo_16_crew_during_EVA_(as16-114-18422).jpg"
      },
      "shots": [
        {
          "start": 8.867,
          "end": 12.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.44,
      "end": 15.08,
      "text": "Surface gravity there is only one-sixth of Earth's.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "John W. Young on the Moon.jpg",
        "credit": "Charlie Duke",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:John_W._Young_on_the_Moon.jpg"
      },
      "shots": [
        {
          "start": 12.433,
          "end": 15.067,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.08,
      "end": 17.66,
      "text": "Exactly twelve humans have ever walked on that soil.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Apollo 17 lunar rover AS17-146-22296HR.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Apollo_17_lunar_rover_AS17-146-22296HR.jpg"
      },
      "shots": [
        {
          "start": 15.067,
          "end": 17.667,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.66,
      "end": 20.94,
      "text": "Those twelve explorers smelled it on their suits after returning to the lander.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "AS11-36-5393 - Apollo 11 - Apollo 11 Mission image - Astronaut Edwin E. Aldrin inside the Lunar Module - NARA - 16683247.jpg",
        "credit": "Unknown authorUnknown author or not provided",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:AS11-36-5393_-_Apollo_11_-_Apollo_11_Mission_image_-_Astronaut_Edwin_E._Aldrin_inside_the_Lunar_Module_-_NARA_-_16683247.jpg"
      },
      "shots": [
        {
          "start": 17.667,
          "end": 19.067,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 19.067,
          "end": 20.933,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.94,
      "end": 22.7,
      "text": "They were shocked to discover that...",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "AS12-48-7117 - Apollo 12 - DPLA - 73f68f08b047cb74e2aefe89231a178f.jpg",
        "credit": "National Aeronautics and Space Administration. Lyndon B. Johnson Space Center. 2/17/1973",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:AS12-48-7117_-_Apollo_12_-_DPLA_-_73f68f08b047cb74e2aefe89231a178f.jpg"
      },
      "shots": [
        {
          "start": 20.933,
