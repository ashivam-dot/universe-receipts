        "source": "Wikimedia Commons",
        "title": "AS12-46-6832 (21699989625).jpg",
        "credit": "Project Apollo Archive",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:AS12-46-6832_(21699989625).jpg"
      },
      "shots": [
        {
          "start": 2.833,
