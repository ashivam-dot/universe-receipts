{
  "id": "ep442",
  "duration": 32.495,
  "beats": [
    {
      "start": 0.08,
      "end": 3.28,
      "text": "The Moon's surface dust smells like burnt gunpowder.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Buzz Aldrin's bootprint on the Moon, AS11-40-5877 (21472308758).jpg",
        "credit": "Buzz Aldrin",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Buzz_Aldrin%27s_bootprint_on_the_Moon,_AS11-40-5877_(21472308758).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.033,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 2.033,
          "end": 3.267,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.28,
      "end": 6.78,
      "text": "Solar radiation gives that abrasive dust an electrostatic charge.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Chang'e-6 lunar regolith under stereomicroscope.jpg",
        "credit": "Chunlai Li, Hao Hu, Meng-Fei Yang",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Chang%27e-6_lunar_regolith_under_stereomicroscope.jpg"
      },
      "shots": [
        {
          "start": 3.267,
          "end": 6.767,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.78,
      "end": 10.62,
      "text": "Instead of resting quietly, the particles actually levitate above the ground.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "AS16-118-18972 (21674382106).jpg",
        "credit": "Project Apollo Archive",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:AS16-118-18972_(21674382106).jpg"
      },
      "shots": [
        {
          "start": 6.767,
          "end": 10.633,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.62,
      "end": 15.22,
      "text": "A nearly vacuum exosphere leaves the regolith completely exposed to space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "AS16-112-18220 (21497124699).jpg",
        "credit": "Project Apollo Archive",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:AS16-112-18220_(21497124699).jpg"
      },
      "shots": [
        {
          "start": 10.633,
          "end": 12.933,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 12.933,
          "end": 15.233,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.22,
      "end": 18.56,
      "text": "Down there, surface gravity is only one-sixth of Earth's.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Question Answered! (LROC537 - AS16-113-18339 4web).png",
        "credit": "NASA/Charlie Duke",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Question_Answered!_(LROC537_-_AS16-113-18339_4web).png"
      },
      "shots": [
        {
          "start": 15.233,
          "end": 17.033,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 17.033,
          "end": 18.567,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.56,
      "end": 23.6,
      "text": "NASA's SOFIA airborne observatory detected water across that sunlit surface in October 2020.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "SOFIA in air.jpg",
        "credit": "NASA/Carla Thomas",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:SOFIA_in_air.jpg"
      },
      "shots": [
        {
          "start": 18.567,
          "end": 20.733,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 20.733,
          "end": 23.6,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.6,
      "end": 27.44,
      "text": "Across six Apollo missions, exactly twelve humans walked on that ground.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Apollo 17 Cernan on moon.jpg",
        "credit": "NASA / Harrison H. Schmitt",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Apollo_17_Cernan_on_moon.jpg"
      },
      "shots": [
        {
          "start": 23.6,
          "end": 27.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 27.44,
      "end": 32.145,
      "text": "The only world humans ever visited carries that unmistakable scent.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Buzz Aldrin's bootprint on the Moon, AS11-40-5877 (21472308758).jpg",
        "credit": "Buzz Aldrin",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Buzz_Aldrin%27s_bootprint_on_the_Moon,_AS11-40-5877_(21472308758).jpg"
      },
      "shots": [
        {
          "start": 27.433,
          "end": 32.5,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    }
  ],
