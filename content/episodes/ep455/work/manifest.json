{
  "id": "ep455",
  "duration": 27.837,
  "beats": [
    {
      "start": 0.08,
      "end": 3.48,
      "text": "Saturn's giant rings formed while dinosaurs roamed Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA17172 Saturn eclipse mosaic bright crop.jpg",
        "credit": "NASA / JPL-Caltech / Space Science Institute",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA17172_Saturn_eclipse_mosaic_bright_crop.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.467,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.48,
      "end": 6.84,
      "text": "Astronomers long assumed the solar system's widest rings were ancient.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The celestial worlds discover'd- or, conjectures concerning the inhabitants, plants and productions of the worlds in the planets Fleuron T053996-5.png",
        "credit": "Huygens, Christiaan",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:The_celestial_worlds_discover%27d-_or,_conjectures_concerning_the_inhabitants,_plants_and_productions_of_the_worlds_in_the_planets_Fleuron_T053996-5.png"
      },
      "shots": [
        {
          "start": 3.467,
          "end": 6.833,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 6.84,
      "end": 9.92,
      "text": "Math in the late eighteen fifties proved they were icy particles.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "James Clerk Maxwell profile.jpg",
        "credit": "Unidentified photographer. Smithsonian Institution from United States",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:James_Clerk_Maxwell_profile.jpg"
      },
      "shots": [
        {
          "start": 6.833,
          "end": 8.633,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 8.633,
          "end": 9.933,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.92,
      "end": 13.12,
      "text": "NASA's Cassini spacecraft changed everything during its final dives.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA21439 - Cassini Grand Finale Dive (Illustration).jpg",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA21439_-_Cassini_Grand_Finale_Dive_(Illustration).jpg"
      },
      "shots": [
        {
          "start": 9.933,
          "end": 11.067,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 11.067,
          "end": 13.133,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.12,
      "end": 16.08,
      "text": "It skimmed between Saturn and its rings to measure their gravity.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA21439 - Cassini Grand Finale Dive (Illustration).jpg",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA21439_-_Cassini_Grand_Finale_Dive_(Illustration).jpg"
      },
      "shots": [
        {
          "start": 13.133,
          "end": 16.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.08,
      "end": 18.52,
      "text": "The pull was far too weak for an ancient structure.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Saturn Rings - August 31 2009 - Flickr - Kevin M. Gill.png",
        "credit": "NASA/JPL-Caltech/SSI/CICLOPS/Kevin M. Gill",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Saturn_Rings_-_August_31_2009_-_Flickr_-_Kevin_M._Gill.png"
      },
      "shots": [
        {
          "start": 16.067,
          "end": 18.533,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.52,
      "end": 21.94,
      "text": "Cassini's low mass measurement proved the rings are remarkably young.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA11668 B ring peaks 2x crop.jpg",
        "credit": "NASA / Jet Propulsion Lab / Space Science Institute",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA11668_B_ring_peaks_2x_crop.jpg"
      },
      "shots": [
        {
          "start": 18.533,
          "end": 21.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.94,
      "end": 24.56,
      "text": "A shattered icy moon created them only recently.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 21.933,
          "end": 24.567,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.56,
      "end": 27.487,
      "text": "Early dinosaurs lived under a completely ringless night sky.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "PIA17172 Saturn eclipse mosaic bright crop.jpg",
        "credit": "NASA / JPL-Caltech / Space Science Institute",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:PIA17172_Saturn_eclipse_mosaic_bright_crop.jpg"
      },
      "shots": [
        {
          "start": 24.567,
          "end": 27.833,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
