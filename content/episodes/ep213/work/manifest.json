{
  "id": "ep213",
  "duration": 47.91,
  "beats": [
    {
      "start": 0.08,
      "end": 3.898,
      "text": "The first confirmed black hole shoots jets at half light speed.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist's impression of a black hole system.jpg",
        "credit": "NASA, ESA, Martin Kornmesser (ESA/Hubble)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%27s_impression_of_a_black_hole_system.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.433,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 2.433,
          "end": 3.9,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.898,
      "end": 11.418,
      "text": "Discovered in 1964 during a sounding rocket flight, Cygnus X-1 sits 7,000 light-years away.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Aerobee Launch (KPNO-RocketAerobeeKp310June231965-CC).jpg",
        "credit": "NOIRLab/AURA/NSF",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Aerobee_Launch_(KPNO-RocketAerobeeKp310June231965-CC).jpg"
      },
      "shots": [
        {
          "start": 3.9,
          "end": 7.667,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 7.667,
          "end": 11.433,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.418,
      "end": 17.313,
      "text": "This heavyweight is locked in a tight celestial tango with a massive blue supergiant star.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Binary system Cygnus X-1.jpg",
        "credit": "NASA / Honeywell Max-Q Digital Group / Dana Berry",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Binary_system_Cygnus_X-1.jpg"
      },
      "shots": [
        {
          "start": 11.433,
          "end": 17.3,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.313,
      "end": 23.483,
      "text": "They orbit every 5.6 days at just one-fifth the distance between the Earth and sun.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Heliocentric orbit.jpg",
        "credit": "Talifero",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Heliocentric_orbit.jpg"
      },
      "shots": [
        {
          "start": 17.3,
          "end": 23.467,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.483,
      "end": 30.128,
      "text": "The black hole continuously rips material from its companion, forming a disk that blazes in X-rays.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Explosion de colores.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Explosion_de_colores.jpg"
      },
      "shots": [
        {
          "start": 23.467,
          "end": 26.8,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 26.8,
          "end": 30.133,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 30.128,
      "end": 35.728,
      "text": "But the record-breaking surprise is the twin plasma jets blasting from the center.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist\u2019s Impression of a Black Hole Environment (eso1907m).tiff",
        "credit": "Nicolle R. Fuller/NSF",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%E2%80%99s_Impression_of_a_Black_Hole_Environment_(eso1907m).tiff"
      },
      "shots": [
        {
          "start": 30.133,
          "end": 35.733,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 35.728,
      "end": 42.428,
      "text": "These blazing jets shine with the energy of 10,000 suns while visibly dancing across space.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "High-energy jet in NGC 3862 (eso9206a).jpg",
        "credit": "P. Crane ([../../../../../../ European Southern Observatory]) and NASA/ESA",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:High-energy_jet_in_NGC_3862_(eso9206a).jpg"
      },
      "shots": [
        {
          "start": 35.733,
          "end": 38.4,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 38.4,
          "end": 42.433,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 42.428,
      "end": 47.56,
      "text": "Stellar winds from the supergiant make these beams visibly wobble as they race away.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist's impression of a black hole system.jpg",
        "credit": "NASA, ESA, Martin Kornmesser (ESA/Hubble)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%27s_impression_of_a_black_hole_system.jpg"
      },
      "shots": [
        {
          "start": 42.433,
          "end": 47.9,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
