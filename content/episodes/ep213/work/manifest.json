{
  "id": "ep213",
  "duration": 53.216,
  "beats": [
    {
      "start": 0.08,
      "end": 3.897,
      "text": "The first confirmed black hole shoots jets at half light speed.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Artist's impression of a black hole system.jpg",
        "credit": "NASA, ESA, Martin Kornmesser (ESA/Hubble)",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Artist%27s_impression_of_a_black_hole_system.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.433,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 2.433,
          "end": 3.9,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.897,
      "end": 12.117,
      "text": "Discovered in 1964 during a sounding rocket flight, Cygnus X-1 sits roughly 7,000 light-years away.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Aerobee 02.jpg",
        "credit": "USAF",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Aerobee_02.jpg"
      },
      "shots": [
        {
          "start": 3.9,
          "end": 12.133,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.117,
      "end": 21.987,
      "text": "The system features a black hole with a mass of about 21 suns orbiting a star named HDE 226868.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Cygnus (cyg).jpg",
        "credit": "IAU and Sky & Telescope",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Cygnus_(cyg).jpg"
      },
      "shots": [
        {
          "start": 12.133,
          "end": 15.7,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 15.7,
          "end": 22.0,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.987,
      "end": 29.257,
      "text": "Both objects complete a tight orbit every 5.6 days at a distance of just one-fifth the Earth-Sun gap.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Black hole jet diagram.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Black_hole_jet_diagram.jpg"
      },
      "shots": [
        {
          "start": 22.0,
          "end": 29.267,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 29.257,
      "end": 35.952,
      "text": "As material streams inward, it forms a superheated accretion disk that blazes brightly in X-rays.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Chandra X-ray Observatory spacecraft model.png",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Chandra_X-ray_Observatory_spacecraft_model.png"
      },
      "shots": [
        {
          "start": 29.267,
          "end": 35.967,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 35.952,
      "end": 42.202,
      "text": "Yet the most mind-bending record is its twin plasma jets racing outward at immense speeds.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Jets Spout Far Closer to Black Hole Than Thought, Scientists Say (2004-ss433).tiff",
        "credit": "Credit: NASA/CXC/M.Weiss) JPEG (97 kb), Tiff (24.7 MB), PS (4.8 MB)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Jets_Spout_Far_Closer_to_Black_Hole_Than_Thought,_Scientists_Say_(2004-ss433).tiff"
      },
      "shots": [
        {
          "start": 35.967,
          "end": 42.2,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 42.202,
      "end": 49.202,
      "text": "These blazing jets shine with the energy of 10,000 suns while visibly swaying like dancing beams.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hubble 2009 close-up.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Hubble_2009_close-up.jpg"
      },
      "shots": [
        {
          "start": 42.2,
          "end": 44.833,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 44.833,
          "end": 49.2,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
