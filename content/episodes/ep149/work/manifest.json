{
  "id": "ep149",
  "duration": 40.528,
  "beats": [
    {
      "start": 0.08,
      "end": 3.554,
      "text": "Earth would keep orbiting if the Sun became a black hole.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "SDO's Ultra-high Definition View of 2012 Venus Transit -- Path Sequence.jpg",
        "credit": "NASA/SDO, AIA",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:SDO%27s_Ultra-high_Definition_View_of_2012_Venus_Transit_--_Path_Sequence.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.567,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.554,
      "end": 8.874,
      "text": "Most people assume a stellar collapse creates an instant cosmic vacuum cleaner.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Keplers supernova.jpg",
        "credit": "NASA/ESA/JHU/R.Sankrit & W.Blair",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Keplers_supernova.jpg"
      },
      "shots": [
        {
          "start": 3.567,
          "end": 8.867,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.874,
      "end": 16.744,
      "text": "A black hole is an astronomical body so compact that its gravity prevents anything, including light, from escaping.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Black hole (NASA).jpg",
        "credit": "NASA/D. Berry",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Black_hole_(NASA).jpg"
      },
      "shots": [
        {
          "start": 8.867,
          "end": 11.7,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 11.7,
          "end": 16.733,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.744,
      "end": 21.689,
      "text": "The boundary of no escape around a black hole is called the event horizon.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Black hole - Messier 87 crop max res.png",
        "credit": "Event Horizon Telescope",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Black_hole_-_Messier_87_crop_max_res.png"
      },
      "shots": [
        {
          "start": 16.733,
          "end": 19.2,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 19.2,
          "end": 21.7,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.689,
      "end": 30.114,
      "text": "Yet from far away, the external gravitational field of a black hole is identical to that of any other body of the same mass.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 21.7,
          "end": 30.1,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 30.114,
      "end": 38.159,
      "text": "Our solar system would get much colder because the black hole emits no visible sunlight, but the planets would stay in their orbits.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Illustration of Cygnus X-1 (2011-cygx1-more-1).tiff",
        "credit": "(Credit: NASA/CXC/M.Weiss)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Illustration_of_Cygnus_X-1_(2011-cygx1-more-1).tiff"
      },
      "shots": [
        {
          "start": 30.1,
          "end": 34.133,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 34.133,
          "end": 38.167,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 38.159,
      "end": 40.178,
      "text": "Earth would keep orbiting normally.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "SDO's Ultra-high Definition View of 2012 Venus Transit -- Path Sequence.jpg",
        "credit": "NASA/SDO, AIA",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:SDO%27s_Ultra-high_Definition_View_of_2012_Venus_Transit_--_Path_Sequence.jpg"
      },
      "shots": [
        {
          "start": 38.167,
          "end": 40.533,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
