  "beats": [
    {
      "start": 0.08,
      "end": 4.671,
      "text": "A serene cosmic hat is actually two galaxies stuffed inside one.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "M104 ngc4594 sombrero galaxy hi-res.jpg",
        "credit": "NASA/ESA and The Hubble Heritage Team (STScI/AURA)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:M104_ngc4594_sombrero_galaxy_hi-res.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.167,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 2.167,
          "end": 4.667,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.671,
      "end": 11.941,
      "text": "Discovered in 1781, the Sombrero Galaxy lies twenty-eight to thirty-one million light-years away.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Pierre mechain.jpg",
        "credit": "Hurle",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Pierre_mechain.jpg"
      },
      "shots": [
        {
          "start": 4.667,
          "end": 11.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.941,
      "end": 16.761,
      "text": "It looks like a single, peaceful ring of dust viewed nearly edge-on from Earth.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Sombrero Galaxy\u2013 A Great Observatories View (A spiral galaxy, also known as M104, in the Virgo cluster about 28 million light years away) (Optical) (2940672857).jpg",
        "credit": "Smithsonian Institution from United States",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Sombrero_Galaxy%E2%80%93_A_Great_Observatories_View_(A_spiral_galaxy,_also_known_as_M104,_in_the_Virgo_cluster_about_28_million_light_years_away)_(Optical)_(2940672857).jpg"
      },
      "shots": [
        {
          "start": 11.933,
          "end": 16.767,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.761,
      "end": 21.731,
      "text": "But look closer, and the sheer scale of this cosmic giant begins to emerge.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Spitzer space telescope.jpg",
        "credit": "NASA/JPL-Caltech",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Spitzer_space_telescope.jpg"
      },
      "shots": [
        {
          "start": 16.767,
          "end": 18.6,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 18.6,
          "end": 21.733,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.731,
      "end": 26.376,
      "text": "It packs a massive total weight equal to eight hundred billion suns.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Messier 56 Hubble WikiSky.jpg",
        "credit": "en:NASA, en:STScI, en:WikiSky",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Messier_56_Hubble_WikiSky.jpg"
      },
      "shots": [
        {
          "start": 21.733,
          "end": 24.467,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 24.467,
          "end": 26.367,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 26.376,
      "end": 32.696,
      "text": "Deep inside its core lies a dormant supermassive black hole weighing up to one billion suns.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 26.367,
          "end": 32.7,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 32.696,
      "end": 40.046,
      "text": "Advanced space telescopes revealed this giant is actually a scarred graveyard of galactic cannibalism.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Sombrero Galaxy\u2013 A Great Observatories View (A spiral galaxy, also known as M104, in the Virgo cluster about 28 million light years away) (Composite) (2940672857).jpg",
        "credit": "Smithsonian Institution from United States",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Sombrero_Galaxy%E2%80%93_A_Great_Observatories_View_(A_spiral_galaxy,_also_known_as_M104,_in_the_Virgo_cluster_about_28_million_light_years_away)_(Composite)_(2940672857).jpg"
      },
      "shots": [
        {
          "start": 32.7,
          "end": 36.367,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 36.367,
          "end": 40.033,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 40.046,
      "end": 45.866,
      "text": "It grew by violently devouring and absorbing its smaller cosmic neighbors over eons.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "NGC4676.jpg",
        "credit": "NASA, H. Ford (JHU), G. Illingworth (UCSC/LO), M.Clampin (STScI), G. Hartig (STScI), the ACS Science Team, and ESA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:NGC4676.jpg"
      },
      "shots": [
        {
          "start": 40.033,
          "end": 42.933,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 42.933,
          "end": 45.867,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 45.866,
      "end": 49.553,
      "text": "Astronomers now know this tranquil ring of stars is a mask.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "M104 ngc4594 sombrero galaxy hi-res.jpg",
        "credit": "NASA/ESA and The Hubble Heritage Team (STScI/AURA)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:M104_ngc4594_sombrero_galaxy_hi-res.jpg"
      },
      "shots": [
        {
          "start": 45.867,
          "end": 49.9,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
